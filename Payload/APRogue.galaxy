    if (StringContains(heroType, "Mohandar", c_stringAnywhere, c_stringNoCase)) { return "Mohandar"; }
    if (StringContains(heroType, "Selendis", c_stringAnywhere, c_stringNoCase)) { return "Selendis"; }
    if (StringContains(heroType, "Karax", c_stringAnywhere, c_stringNoCase)) { return "Karax"; }
    if (StringContains(heroType, "Zagara", c_stringAnywhere, c_stringNoCase) || heroType == "ZaGara") { return "Zagara"; }
    if (StringContains(heroType, "Dehaka", c_stringAnywhere, c_stringNoCase)) { return "Dehaka"; }
