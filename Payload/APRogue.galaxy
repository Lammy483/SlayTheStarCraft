        APRG_AddHostileRaiders(created, p, player);
    }
    if (RandomInt(0, 1) == 1 && CatalogEntryIsValid(c_gameCatalogUnit, "Medic")) {
        created = UnitCreate(1, "Medic", c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
        APRG_AddHostileRaiders(created, p, player);
    }
    if (RandomInt(0, 1) == 1 && CatalogEntryIsValid(c_gameCatalogUnit, "Firebat")) {
        created = UnitCreate(1, "Firebat", c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
        APRG_AddHostileRaiders(created, p, player);
    }
}

void APRG_ResolveRaynorRepairDrop(int owner, point p, unit target) {
    unitgroup created;
    unit scv;
    if (owner < 0 || p == null || target == null || !UnitIsAlive(target) || !CatalogEntryIsValid(c_gameCatalogUnit, "SCV")) { return; }
    created = UnitCreate(1, "SCV", c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
    scv = UnitGroupUnitFromEnd(created, 1);
    if (scv == null) { return; }
    UnitSetState(scv, c_unitStateUsingSupply, false);
    AISetUnitScriptControlled(scv, true);
    DataTableSetBool(true, "APRG_RaynorRepair_" + IntToString(UnitGetTag(scv)), true);
    UnitGroupAdd(g_aprgRaynorRepairSCVs, scv);
    UnitIssueOrder(scv, OrderSetAutoCast(AbilityCommand("Repair", 0), true), c_orderQueueReplace);
    UnitIssueOrder(scv, OrderTargetingUnit(AbilityCommand("Repair", 0), target), c_orderQueueReplace);
}

void APRG_TickPendingDropPods(int player, fixed now) {
    int i = 0;
    int kind;
    int owner;
    point p;
    unit visual;
    unit payloadTarget;
    for (; i < APRG_MAX_PENDING_DROP_PODS; i += 1) {
        if (g_aprgPendingDropState[i] == 1 && now >= g_aprgPendingDropImpactTime[i]) {
            kind = g_aprgPendingDropKind[i];
            owner = g_aprgPendingDropOwner[i];
            p = g_aprgPendingDropPoint[i];
            payloadTarget = g_aprgPendingDropTarget[i];
            if (kind == APRG_DROP_KIND_TERRAN_HOSTILE) {
                APRG_ResolveTerranHostileDrop(player, owner, p);
            }
            else if (kind == APRG_DROP_KIND_WARFIELD) {
                APRG_ResolveWarfieldDrop(player, p);
                g_aprgWarfieldNormalDropCount += 1;
                if ((g_aprgWarfieldNormalDropCount % 3) == 0) { APRG_PlayWarfieldVO("054"); }
            }
            else if (kind == APRG_DROP_KIND_WARFIELD_POTION) {
                // The consumable gets exactly one VO line, when activated.
                // Do not add these to the recurring Warfield drop counter.
                APRG_ResolveWarfieldDrop(player, p);
            }
            else if (kind == APRG_DROP_KIND_WARFIELD_OMEGA) {
                APRG_ResolveWarfieldOmegaDrop(player, p);
            }
            else if (kind == APRG_DROP_KIND_ZERG_HOSTILE) {
                APRG_ResolveZergHostileDrop(player, owner, p);
            }
            else if (kind == APRG_DROP_KIND_LEVIATHAN_HOSTILE) {
                APRG_ResolveLeviathanHostileDrop(player, owner, p);
            }
            else if (kind == APRG_DROP_KIND_MINERAL_THIEF) {
                APRG_ResolveMineralThiefDrop(owner, p, payloadTarget);
            }
            else if (kind == APRG_DROP_KIND_RAYNOR_ASSAULT) {
                APRG_ResolveRaynorAssaultDrop(player, owner, p);
            }
            else if (kind == APRG_DROP_KIND_RAYNOR_REPAIR) {
                APRG_ResolveRaynorRepairDrop(owner, p, payloadTarget);
            }
            else if (kind == APRG_DROP_KIND_INFANTRY_REINFORCEMENTS) {
                APRG_ResolveInfantryReinforcementDrop(player, p);
            }
            else if (kind == APRG_DROP_KIND_ACIDIC_LANDING) {
                APRG_ResolvePlayerZergDrop(player, p, false);
            }
            else if (kind == APRG_DROP_KIND_INVASION_FLEET) {
                APRG_ResolvePlayerZergDrop(player, p, true);
            }
            g_aprgPendingDropState[i] = 2;
            g_aprgPendingDropCleanupTime[i] = now + 5.0;
        }
        else if (g_aprgPendingDropState[i] == 2 && now >= g_aprgPendingDropCleanupTime[i]) {
            visual = g_aprgPendingDropVisual[i];
            if (visual != null) { UnitRemove(visual); }
            g_aprgPendingDropState[i] = 0;
            g_aprgPendingDropKind[i] = 0;
            g_aprgPendingDropOwner[i] = -1;
            g_aprgPendingDropPoint[i] = null;
            g_aprgPendingDropVisual[i] = null;
            g_aprgPendingDropTarget[i] = null;
        }
    }
}

unit APRG_NearestPathablePlayerStructureFromGroup(unit mover, int player, unitgroup structures) {
    int i;
    unit candidate;
    unit best = null;
    fixed bestDistance = 999999.0;
    fixed distance;
    if (mover == null) { return null; }
    i = UnitGroupCount(structures, c_unitCountAlive);
    for (; i > 0; i -= 1) {
        candidate = UnitGroupUnitFromEnd(structures, i);
        if (candidate == null) { break; }
        if (UnitTestState(candidate, c_unitStateInvulnerable)) { continue; }
        if (!UnitPathableToPoint(mover, UnitGetPosition(candidate), 3.0, 100000.0)) { continue; }
        distance = DistanceBetweenPoints(UnitGetPosition(mover), UnitGetPosition(candidate));
        if (distance < bestDistance) { bestDistance = distance; best = candidate; }
    }
    if (best == null) {
        for (i = UnitGroupCount(structures, c_unitCountAlive); i > 0; i -= 1) {
            candidate = UnitGroupUnitFromEnd(structures, i);
            if (candidate == null || UnitTestState(candidate, c_unitStateInvulnerable)) { continue; }
            distance = DistanceBetweenPoints(UnitGetPosition(mover), UnitGetPosition(candidate));
            if (distance < bestDistance) { bestDistance = distance; best = candidate; }
        }
    }
    return best;
}

unit APRG_NearestPathablePlayerStructure(unit mover, int player) {
    return APRG_NearestPathablePlayerStructureFromGroup(mover, player, APRG_PlayerStructures(player));
}

unit APRG_NearestPathableEnemyStructureFromGroup(unit mover, int player, unitgroup structures) {
    int i;
    unit candidate;
    unit best = null;
    fixed bestDistance = 999999.0;
    fixed distance;
    if (mover == null) { return null; }
    for (i = UnitGroupCount(structures, c_unitCountAlive); i > 0; i -= 1) {
        candidate = UnitGroupUnitFromEnd(structures, i);
        if (candidate == null || !UnitIsAlive(candidate) || UnitTestState(candidate, c_unitStateInvulnerable)) { continue; }
        if (!UnitPathableToPoint(mover, UnitGetPosition(candidate), 3.0, 100000.0)) { continue; }
        distance = DistanceBetweenPoints(UnitGetPosition(mover), UnitGetPosition(candidate));
        if (distance < bestDistance) { bestDistance = distance; best = candidate; }
    }
    if (best == null) {
        for (i = UnitGroupCount(structures, c_unitCountAlive); i > 0; i -= 1) {
            candidate = UnitGroupUnitFromEnd(structures, i);
            if (candidate == null || UnitTestState(candidate, c_unitStateInvulnerable)) { continue; }
            distance = DistanceBetweenPoints(UnitGetPosition(mover), UnitGetPosition(candidate));
            if (distance < bestDistance) { bestDistance = distance; best = candidate; }
        }
    }
    return best;
}

unit APRG_NearestPathableEnemyStructure(unit mover, int player) {
    return APRG_NearestPathableEnemyStructureFromGroup(mover, player, APRG_EnemyTargetableStructures(player));
}

bool APRG_EnsureAirReachableToPlayer(unit flyer, int player) {
    unit home;
    unit nearestPlayerStructure;
    point homePoint;
    point candidate;
    point originalPoint;
    int attempt;
    if (flyer == null || !UnitIsAlive(flyer)) { return false; }
    originalPoint = UnitGetPosition(flyer);
    home = APRG_FindPlayerHomeStructure(player);
    if (home == null) { return false; }
    homePoint = UnitGetPosition(home);
    if (UnitPathableToPoint(flyer, homePoint, 8.0, 100000.0)) { return true; }

    for (attempt = 0; attempt < 64; attempt += 1) {
        candidate = RegionRandomPoint(RegionPlayableMap());
        if (candidate == null || !APRG_AirSpawnPointAllowed(candidate) || APRG_PointNearRakShirDuel(candidate, 24.0)) { continue; }
        nearestPlayerStructure = APRG_NearestPlayerStructure(candidate, player);
        if (nearestPlayerStructure != null && DistanceBetweenPoints(candidate, UnitGetPosition(nearestPlayerStructure)) < 20.0) { continue; }
        UnitSetPosition(flyer, candidate, true);
        if (UnitPathableToPoint(flyer, homePoint, 8.0, 100000.0)) { return true; }
    }
    UnitSetPosition(flyer, originalPoint, true);
    return false;
}

void APRG_RetargetRaiders(int player) {
    int i;
    unit u;
    unit target;
    unitgroup structures = APRG_PlayerStructures(player);
    i = UnitGroupCount(g_aprgHostileRaiders, c_unitCountAlive);
    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(g_aprgHostileRaiders, i);
        if (u == null) { break; }
        target = APRG_NearestPathablePlayerStructureFromGroup(u, player, structures);
        if (target != null) { APRG_OrderAttackMove(u, UnitGetPosition(target)); }
    }
}

point APRG_FindSiegeModeSpawnPoint(int player, fixed clearance) {
    int attempt;
    unit home;
    point candidate;
    if (!APRG_GroundSpawnsNeedPlayerPathing()) {
        return APRG_FindStaticPatrolGroundPointWithBuildingClearance(player, clearance);
    }
    home = APRG_FindPlayerHomeStructure(player);
    if (home != null && UnitIsAlive(home)) {
        for (attempt = 0; attempt < APRG_MAX_POINT_ATTEMPTS; attempt += 1) {
            candidate = RegionRandomPoint(RegionPlayableMap());
            if (candidate == null || !PointPathingPassable(candidate)) { continue; }
            if (APRG_PointNearPlayerOrAlliedBuilding(candidate, player, clearance)) { continue; }
            if (!PointPathingIsConnected(candidate, UnitGetPosition(home))) { continue; }
            if (APRG_PointNearRakShirDuel(candidate, 24.0)) { continue; }
            return candidate;
        }
    }
    return APRG_FindStaticPatrolGroundPointWithBuildingClearance(player, clearance);
}

void APRG_TrySpawnSiegeMode(int player) {
    point p;
    int owner;
    int targetCount = 10;
    unitgroup created;
    if (APRG_HasExtension4(APRG_EXT4_MUT_SIEGE_MODE_X5)) { targetCount = 50; }
    if (g_aprgSiegeSpawned >= targetCount || g_aprgSiegeRetries >= APRG_STATIC_SPAWN_MAX_RETRIES * 5) { return; }
    g_aprgSiegeRetries += 1;
    p = APRG_FindSiegeModeSpawnPoint(player, 15.0);
    if (p == null) { return; }
    if (APRG_PointNearPlayerOrAlliedBuilding(p, player, 15.0)) { return; }
    owner = APRG_FindHostileOwnerNearPoint(player, p);
    if (owner < 0) { return; }
    created = UnitCreate(1, "SiegeTankSieged", 0, owner, p, libNtve_gf_RandomAngle());
    APRG_RegisterMutationEnemyGroup(created);
    if (UnitGroupCount(created, c_unitCountAlive) > 0) { g_aprgSiegeSpawned += 1; }
}

string APRG_DrillUnitType() {
    if (CatalogEntryIsValid(c_gameCatalogUnit, "DrakkenLaserDrill")) {
        return "DrakkenLaserDrill";
    }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "DrakkenLaserDrillCoop")) {
        return "DrakkenLaserDrillCoop";
    }
    return "";
}

point APRG_FindEnemyDrillPoint(int player) {
    unit base;
    unit anchor;
    point p;
    int attempt;
    base = APRG_FindPlayerHomeStructure(player);
    if (base == null) { return null; }
    for (attempt = 0; attempt < APRG_MAX_POINT_ATTEMPTS; attempt += 1) {
        anchor = APRG_RandomHostileBaseAnchor(player);
        if (anchor == null) { continue; }
        p = APRG_FindGroundPointNear(UnitGetPosition(anchor), 0.0, 14.0);
        if (p == null || !RegionContainsPoint(RegionPlayableMap(), p) || !PointPathingPassable(p)) { continue; }
        if (DistanceBetweenPoints(p, UnitGetPosition(base)) < 30.0) { continue; }
        if (APRG_PointNearPlayerOrAlliedBuilding(p, player, 15.0)) { continue; }
        return p;
    }
    return null;
}

void APRG_TrySpawnEnemyDrill(int player) {
    point p;
    int owner;
    string drillType;
    unitgroup created;
    if (g_aprgDrillSpawned || g_aprgDrillRetries >= APRG_STATIC_SPAWN_MAX_RETRIES) {
        return;
    }
    g_aprgDrillRetries += 1;
    drillType = APRG_DrillUnitType();
    if (drillType == "") {
        g_aprgDrillRetries = APRG_STATIC_SPAWN_MAX_RETRIES;
        return;
    }
    p = APRG_FindEnemyDrillPoint(player);
    if (p == null) {
        return;
    }
    owner = APRG_FindHostileOwnerNearPoint(player, p);
    if (owner < 0) {
        return;
    }
    created = UnitCreate(1, drillType, c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
    APRG_RegisterMutationEnemyGroup(created);
    if (UnitGroupCount(created, c_unitCountAlive) > 0) {
        g_aprgDrillSpawned = true;
        g_aprgEnemyMutationDrill = UnitGroupUnitFromEnd(created, 1);
        g_aprgEnemyDrillNextInterrupt = GameGetMissionTime() + 9.0;
        g_aprgEnemyDrillResumeTime = -1.0;
    }
}

// The hostile drill's sustained beam can leave a Guardian Shell-protected unit
// in a broken invulnerable state if held indefinitely. Force a real break in
// the drill's attack loop at most every nine seconds. Only the Slay-spawned
// hostile drill is cycled; the friendly Drakken blessing is not touched.
void APRG_TickEnemyDrillTargetLimit(fixed now) {
    order stopOrder;
    if (g_aprgEnemyMutationDrill == null || !UnitIsAlive(g_aprgEnemyMutationDrill)) { return; }
    if (g_aprgEnemyDrillResumeTime >= 0.0) {
        if (now < g_aprgEnemyDrillResumeTime) { return; }
        libNtve_gf_PauseUnit(g_aprgEnemyMutationDrill, false);
        g_aprgEnemyDrillResumeTime = -1.0;
        g_aprgEnemyDrillNextInterrupt = now + 9.0;
        return;
    }
    if (g_aprgEnemyDrillNextInterrupt < 0.0 || now < g_aprgEnemyDrillNextInterrupt) { return; }
    stopOrder = Order(AbilityCommand("stop", 0));
    if (UnitOrderIsValid(g_aprgEnemyMutationDrill, stopOrder)) {
        UnitIssueOrder(g_aprgEnemyMutationDrill, stopOrder, c_orderQueueReplace);
    }
    libNtve_gf_PauseUnit(g_aprgEnemyMutationDrill, true);
    g_aprgEnemyDrillResumeTime = now + 2.0;
}

void APRG_TrySpawnDarkArchons(int player) {
    point p;
    int owner;
    int targetCount = 10;
    unitgroup created;
    if (APRG_HasExtension4(APRG_EXT4_MUT_DARK_ARCHONS_X5)) { targetCount = 50; }
    if (!APRG_PlayerMacroBaseReady(player) || g_aprgMacroReadyTime < 0.0 || GameGetMissionTime() < g_aprgMacroReadyTime + 120.0) { return; }
    if (g_aprgDarkArchonsSpawned >= targetCount || g_aprgDarkArchonRetries >= APRG_STATIC_SPAWN_MAX_RETRIES * 5) { return; }
    if (!CatalogEntryIsValid(c_gameCatalogUnit, "Archon")) { g_aprgDarkArchonRetries = APRG_STATIC_SPAWN_MAX_RETRIES * 5; return; }
    g_aprgDarkArchonRetries += 1;
    p = APRG_FindStaticPatrolGroundPointWithBuildingClearance(player, 15.0);
    if (p == null) { return; }
    owner = APRG_FindHostileOwnerNearPoint(player, p);
    if (owner < 0) { return; }
    created = UnitCreate(1, "Archon", c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
    APRG_RegisterMutationEnemyGroup(created);
    if (UnitGroupCount(created, c_unitCountAlive) > 0) {
        g_aprgDarkArchonsSpawned += 1;
        UnitGroupAddUnitGroup(g_aprgHostilePatrollers, created);
        APRG_RetargetHostilePatrollers();
    }
}

void APRG_SpawnDropPodRaid(int player) {
    point p;
    int owner;
    if (!APRG_GroundSpawnsNeedPlayerPathing()) { p = APRG_FindRandomGroundPoint(); }
    else { p = APRG_FindRaidOriginGroundPoint(player); }
    if (p == null) { return; }
    owner = APRG_FindHostileOwnerNearPoint(player, p);
    if (owner < 0) { return; }
    if (!APRG_QueueRealDropPod(APRG_DROP_KIND_TERRAN_HOSTILE, owner, p, null)) {
        APRG_ResolveTerranHostileDrop(player, owner, p);
    }
}

fixed APRG_DropPodRaidNextInterval(fixed now) {
    return RandomFixed(40.0, 80.0);
}

unit APRG_RandomPlayerStructure(int player);

void APRG_SpawnDarkTemplarRaid(int player) {
    point p = APRG_FindRaidOriginGroundPoint(player);
    int owner;
    unitgroup created;
    int i;
    int count;
    unit u;
    unit target;
    if (p == null) { return; }
    owner = APRG_FindHostileOwnerNearPoint(player, p);
    if (owner < 0 || !CatalogEntryIsValid(c_gameCatalogUnit, "DarkTemplar")) { return; }
    count = RandomInt(1, 3 + g_aprgDarkTemplarWaveIndex);
    created = UnitCreate(count, "DarkTemplar", 0, owner, p, libNtve_gf_RandomAngle());
    if (UnitGroupCount(created, c_unitCountAlive) > 0) { g_aprgDarkTemplarWaveIndex += 1; }
    UnitGroupAddUnitGroup(g_aprgDarkTemplarRaiders, created);
    for (i = UnitGroupCount(created, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(created, i);
        target = APRG_RandomPlayerStructure(player);
        if (u != null && target != null) { APRG_OrderAttackMove(u, UnitGetPosition(target)); }
    }
}

void APRG_RetargetDarkTemplarRaiders(int player) {
    int i;
    unit u;
    unit target;
    for (i = UnitGroupCount(g_aprgDarkTemplarRaiders, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(g_aprgDarkTemplarRaiders, i);
        if (u == null || !UnitIsAlive(u)) { continue; }
        target = APRG_RandomPlayerStructure(player);
        if (target != null) { APRG_OrderAttackMove(u, UnitGetPosition(target)); }
    }
}

void APRG_ApplyFragileWorkers(int player) {
    unitgroup workers = APRG_PlayerWorkers(player);
    int i = UnitGroupCount(workers, c_unitCountAlive);
    unit u;
    fixed life;
    fixed shields;
    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(workers, i);
        if (u == null) {
            break;
        }
        UnitSetPropertyFixed(u, c_unitPropLifeMax, 1.0);
        life = UnitGetPropertyFixed(u, c_unitPropLife, c_unitPropCurrent);
        if (life > 1.0) {
            UnitSetPropertyFixed(u, c_unitPropLife, 1.0);
        }
        shields = UnitGetPropertyFixed(u, c_unitPropShieldsMax, c_unitPropCurrent);
        if (shields > 0.0) {
            UnitSetPropertyFixed(u, c_unitPropShieldsMax, 1.0);
            shields = UnitGetPropertyFixed(u, c_unitPropShields, c_unitPropCurrent);
            if (shields > 1.0) {
                UnitSetPropertyFixed(u, c_unitPropShields, 1.0);
            }
        }
    }
}

int APRG_FindDecaySlot(unit u, fixed now) {
    int i;
    int freeSlot = -1;
    unit existing;
    if (u == null) { return -1; }
    for (i = 0; i < APRG_MAX_DECAY_UNITS; i += 1) {
        existing = g_aprgDecayUnits[i];
        if (existing == u) { return i; }
        if (existing != null && !UnitIsAlive(existing)) {
            g_aprgDecayUnits[i] = null;
            g_aprgDecayStacks[i] = 0;
            g_aprgDecayNextStackTime[i] = 0.0;
            g_aprgDecayNextDamageTime[i] = 0.0;
            existing = null;
        }
        if (freeSlot < 0 && existing == null) { freeSlot = i; }
    }
    if (freeSlot >= 0) {
        g_aprgDecayUnits[freeSlot] = u;
        g_aprgDecayStacks[freeSlot] = 0;
        g_aprgDecayNextStackTime[freeSlot] = now + 60.0;
        g_aprgDecayNextDamageTime[freeSlot] = now + 10.0;
    }
    return freeSlot;
}

void APRG_TickDecay(int player, fixed now) {
    unitgroup units;
    int i;
    int slot;
    int stacksDue;
    unit u;
    fixed life;
    fixed damage;
    units = APRG_PlayerMobileUnits(player);
    for (i = UnitGroupCount(units, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null || !UnitIsAlive(u)) { continue; }
        slot = APRG_FindDecaySlot(u, now);
        if (slot < 0) { continue; }
        if (now >= g_aprgDecayNextStackTime[slot]) {
            stacksDue = 1 + MaxI(0, FixedToInt((now - g_aprgDecayNextStackTime[slot]) / 60.0));
            g_aprgDecayStacks[slot] += stacksDue;
            g_aprgDecayNextStackTime[slot] += IntToFixed(stacksDue) * 60.0;
        }
        if (now >= g_aprgDecayNextDamageTime[slot]) {
            damage = IntToFixed(g_aprgDecayStacks[slot]);
            life = UnitGetPropertyFixed(u, c_unitPropLife, c_unitPropCurrent);
            if (damage > 0.0) {
                if (life <= damage) { UnitKill(u); }
                else { UnitSetPropertyFixed(u, c_unitPropLife, life - damage); }
            }
            g_aprgDecayNextDamageTime[slot] += 10.0;
        }
    }
}


void APRG_EnforceLimitedBank(int player) {
    int minerals = PlayerGetPropertyInt(player, c_playerPropMinerals);
    int gas = PlayerGetPropertyInt(player, c_playerPropVespene);
    int excess = minerals + gas - 1500;
    int reduce;
    if (excess <= 0) {
        return;
    }
    if (minerals >= gas) {
        reduce = MinI(minerals, excess);
        minerals -= reduce;
        excess -= reduce;
        gas = MaxI(0, gas - excess);
    }
    else {
        reduce = MinI(gas, excess);
        gas -= reduce;
        excess -= reduce;
        minerals = MaxI(0, minerals - excess);
    }
    PlayerModifyPropertyInt(player, c_playerPropMinerals, c_playerPropOperSetTo, minerals);
    PlayerModifyPropertyInt(player, c_playerPropVespene, c_playerPropOperSetTo, gas);
}

fixed APRG_LeviathanNextInterval(fixed now) {
    fixed elapsed;
    fixed maximum;
    if (g_aprgLeviathanRampStartTime < 0.0) { return 20.0; }
    elapsed = MaxF(0.0, now - g_aprgLeviathanRampStartTime);
    maximum = MaxF(2.0, 20.0 - IntToFixed(FixedToInt(elapsed / 60.0)));
    return maximum;
}

point APRG_FindLeviathanDropPoint(int player) {
    int attempt;
    point p;
    unit home = APRG_FindPlayerHomeStructure(player);
    unit target;
    unitgroup mobile;
    if (!APRG_GroundSpawnsNeedPlayerPathing()) { return APRG_FindRandomGroundPoint(); }
    if (home == null) { return null; }
    if (RandomInt(0, 1) == 1) {
        mobile = APRG_PlayerMobileUnits(player);
        if (UnitGroupCount(mobile, c_unitCountAlive) > 0) {
            target = UnitGroupRandomUnit(mobile, c_unitCountAlive);
            if (target != null) {
                p = APRG_FindGroundPointNear(UnitGetPosition(target), 0.0, 4.0);
                if (p != null && (!APRG_GroundSpawnsNeedPlayerPathing() || PointPathingIsConnected(p, UnitGetPosition(home)))) { return p; }
            }
        }
    }
    for (attempt = 0; attempt < APRG_MAX_POINT_ATTEMPTS; attempt += 1) {
        p = APRG_FindRandomGroundPoint();
        if (p != null && (!APRG_GroundSpawnsNeedPlayerPathing() || PointPathingIsConnected(p, UnitGetPosition(home)))) { return p; }
    }
    return APRG_FindGroundPointNear(UnitGetPosition(home), 18.0, 40.0);
}

void APRG_SpawnLeviathanRaid(int player) {
    point p = APRG_FindLeviathanDropPoint(player);
    int owner;
    if (p == null) { return; }
    owner = APRG_FindHostileOwnerNearPoint(player, p);
    if (owner < 0) { return; }
    if (!APRG_QueueRealDropPod(APRG_DROP_KIND_LEVIATHAN_HOSTILE, owner, p, null)) {
        APRG_ResolveLeviathanHostileDrop(player, owner, p);
    }
}

void APRG_ApplySpeedy(int player) {
    unitgroup units;
    int i;
    unit u;
    string unitType;
    string key;
    fixed speed;
    units = APRG_PlayerMobileUnits(player);
    for (i = UnitGroupCount(units, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null) { continue; }
        unitType = UnitGetType(u);
        key = "APRG_SpeedyCatalog_" + IntToString(player) + "_" + unitType;
        if (DataTableGetBool(true, key)) { continue; }
        speed = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "Speed", player));
        if (speed > 0.0) {
            CatalogFieldValueSet(c_gameCatalogUnit, unitType, "Speed", player, FixedToString(speed * 2.0, c_fixedPrecisionAny));
        }
        DataTableSetBool(true, key, true);
    }
}

void APRG_DisableGeneratedHeroRevive(unit u) {
    int i;
    string behavior;
    if (u == null) { return; }
    for (i = UnitBehaviorCountAll(u); i >= 1; i -= 1) {
        behavior = UnitBehaviorGet(u, i);
        if (behavior == "") { continue; }
        if (
            StringContains(behavior, "revive", c_stringAnywhere, c_stringNoCase) ||
            StringContains(behavior, "incapac", c_stringAnywhere, c_stringNoCase) ||
            StringContains(behavior, "deathprevention", c_stringAnywhere, c_stringNoCase)
        ) {
            UnitBehaviorRemove(u, behavior, c_unitBehaviorCountAll);
        }
    }
}

// Niadra's native births are the nine commands of SwarmQueenTrain, not nine
// separate ability links. Apply the cooldown to each TrainN entry so one
// birth cannot bypass the restriction by selecting another command variant.
void APRG_NormalizeNiadraBirthCooldown(unit hero) {
    int owner;
    int abilityCount;
    int abilityIndex;
    int birthIndex;
    string abilityType;
    string path;
    if (hero == null || !StringContains(UnitGetType(hero), "Niadra", c_stringAnywhere, c_stringNoCase)) { return; }
    owner = UnitGetOwner(hero);
    abilityCount = MinI(64, UnitAbilityCount(hero));
    for (abilityIndex = 1; abilityIndex <= abilityCount; abilityIndex += 1) {
        abilityType = UnitAbilityGet(hero, abilityIndex);
        if (abilityType != "SwarmQueenTrain" && abilityType != "SwarmQueenTrainLarva" &&
            !StringContains(abilityType, "NiadraBirth", c_stringAnywhere, c_stringNoCase)) { continue; }
        if (!CatalogEntryIsValid(c_gameCatalogAbil, abilityType)) { continue; }
        // Do not assign a shared ability-level cooldown: each TrainN birth
        // command should have its own timer rather than locking all births.
        for (birthIndex = 1; birthIndex <= 9; birthIndex += 1) {
            path = "InfoArray[Train" + IntToString(birthIndex) + "]";
            // CAbilTrain's cooldown belongs directly to InfoArray[TrainN].
            // Give each command its own link so Zergling, Roach and Hydra
            // births have independent cooldowns even on the same Niadra.
            CatalogFieldValueSet(c_gameCatalogAbil, abilityType, path + ".Cooldown.Link", owner,
                "APRG_Niadra_" + abilityType + "_" + IntToString(birthIndex));
            CatalogFieldValueSet(c_gameCatalogAbil, abilityType, path + ".Cooldown.TimeUse", owner, "60");
            CatalogFieldValueSet(c_gameCatalogAbil, abilityType, path + ".Cooldown.TimeStart", owner, "60");
        }
    }
}

void APRG_RegisterGeneratedHero(unit u) {
    if (u == null) { return; }
    APRG_DisableGeneratedHeroRevive(u);
    APRG_NormalizeNiadraBirthCooldown(u);
    if (g_aprgGeneratedHeroCount >= APRG_MAX_GENERATED_HEROES) { return; }
    g_aprgGeneratedHeroes[g_aprgGeneratedHeroCount] = u;
    g_aprgGeneratedHeroDied[g_aprgGeneratedHeroCount] = false;
    g_aprgGeneratedHeroCount += 1;
}

void APRG_RegisterGeneratedHeroGroup(unitgroup group) {
    int i;
    unit u;
    if (group == null) { return; }
    i = UnitGroupCount(group, c_unitCountAlive);
    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(group, i);
        if (u == null) { break; }
        APRG_RegisterGeneratedHero(u);
    }
}

unit APRG_NearestPlayerHeroAbilityTarget(unit hero, int player, fixed maxRange) {
    unitgroup units;
    int i;
    unit u;
    unit best = null;
    fixed distance;
    fixed bestDistance = 99999.0;
    point origin;
    if (hero == null) { return null; }
    origin = UnitGetPosition(hero);
    units = APRG_PlayerAllUnits(player);
    for (i = UnitGroupCount(units, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null || !UnitIsAlive(u)) { continue; }
        distance = DistanceBetweenPoints(origin, UnitGetPosition(u));
        if (distance <= maxRange && distance < bestDistance) {
            best = u;
            bestDistance = distance;
        }
    }
    return best;
}

bool APRG_IsCombatHeroAbility(string abilityType) {
    if (abilityType == "") { return false; }
    return
        StringContains(abilityType, "Flaming", c_stringAnywhere, c_stringNoCase) ||
        StringContains(abilityType, "Betty", c_stringAnywhere, c_stringNoCase) ||
        StringContains(abilityType, "Grenade", c_stringAnywhere, c_stringNoCase) ||
        StringContains(abilityType, "Penetrator", c_stringAnywhere, c_stringNoCase) ||
        StringContains(abilityType, "Turret", c_stringAnywhere, c_stringNoCase) ||
        StringContains(abilityType, "Charge", c_stringAnywhere, c_stringNoCase) ||
        StringContains(abilityType, "Destruction", c_stringAnywhere, c_stringNoCase) ||
        StringContains(abilityType, "Wave", c_stringAnywhere, c_stringNoCase) ||
        StringContains(abilityType, "Devour", c_stringAnywhere, c_stringNoCase) ||
        StringContains(abilityType, "Drag", c_stringAnywhere, c_stringNoCase) ||
        StringContains(abilityType, "Leap", c_stringAnywhere, c_stringNoCase) ||
        StringContains(abilityType, "Mend", c_stringAnywhere, c_stringNoCase) ||
        StringContains(abilityType, "Snipe", c_stringAnywhere, c_stringNoCase) ||
        StringContains(abilityType, "Psionic", c_stringAnywhere, c_stringNoCase) ||
        StringContains(abilityType, "Storm", c_stringAnywhere, c_stringNoCase) ||
        StringContains(abilityType, "Blast", c_stringAnywhere, c_stringNoCase) ||
        StringContains(abilityType, "Missile", c_stringAnywhere, c_stringNoCase) ||
        StringContains(abilityType, "Blink", c_stringAnywhere, c_stringNoCase) ||
        StringContains(abilityType, "Stun", c_stringAnywhere, c_stringNoCase) ||
        StringContains(abilityType, "Bomb", c_stringAnywhere, c_stringNoCase) ||
        StringContains(abilityType, "Beam", c_stringAnywhere, c_stringNoCase) ||
        StringContains(abilityType, "Strike", c_stringAnywhere, c_stringNoCase) ||
        StringContains(abilityType, "Heal", c_stringAnywhere, c_stringNoCase) ||
        StringContains(abilityType, "Shield", c_stringAnywhere, c_stringNoCase) ||
        StringContains(abilityType, "Fungal", c_stringAnywhere, c_stringNoCase) ||
        StringContains(abilityType, "EMP", c_stringAnywhere, c_stringNoCase) ||
        StringContains(abilityType, "Vortex", c_stringAnywhere, c_stringNoCase) ||
        StringContains(abilityType, "BlackHole", c_stringAnywhere, c_stringNoCase) ||
        StringContains(abilityType, "LineAttack", c_stringAnywhere, c_stringNoCase) ||
        StringContains(abilityType, "Lightning", c_stringAnywhere, c_stringNoCase) ||
        StringContains(abilityType, "Obliterate", c_stringAnywhere, c_stringNoCase) ||
        StringContains(abilityType, "Ultrasonic", c_stringAnywhere, c_stringNoCase) ||
        StringContains(abilityType, "Seeker", c_stringAnywhere, c_stringNoCase) ||
        StringContains(abilityType, "Irradiate", c_stringAnywhere, c_stringNoCase) ||
        StringContains(abilityType, "Parasitic", c_stringAnywhere, c_stringNoCase) ||
        StringContains(abilityType, "Area", c_stringAnywhere, c_stringNoCase);
}

unit APRG_NearestOwnedInjuredAbilityTarget(unit caster, fixed maxRange) {
    unitgroup units;
    int i;
    unit u;
    unit best = null;
    fixed distance;
    fixed bestDistance = 99999.0;
    fixed life;
    fixed lifeMax;
    fixed shields;
    fixed shieldsMax;
    int owner;
    point origin;
    if (caster == null) { return null; }
    owner = UnitGetOwner(caster);
    origin = UnitGetPosition(caster);
    units = UnitGroup(null, owner, RegionCircle(origin, maxRange), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32))), 0);
    for (i = UnitGroupCount(units, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null || !UnitIsAlive(u)) { continue; }
        distance = DistanceBetweenPoints(origin, UnitGetPosition(u));
        if (distance >= bestDistance) { continue; }
        life = UnitGetPropertyFixed(u, c_unitPropLife, c_unitPropCurrent);
        lifeMax = UnitGetPropertyFixed(u, c_unitPropLifeMax, c_unitPropCurrent);
        shields = UnitGetPropertyFixed(u, c_unitPropShields, c_unitPropCurrent);
        shieldsMax = UnitGetPropertyFixed(u, c_unitPropShieldsMax, c_unitPropCurrent);
        if ((lifeMax > 0.0 && life < lifeMax - 0.5) || (shieldsMax > 0.0 && shields < shieldsMax - 0.5)) {
            best = u;
            bestDistance = distance;
        }
    }
    return best;
}

bool APRG_TryGeneratedHeroAbility(unit hero, int player) {
    if (hero == null || !UnitIsAlive(hero)) { return false; }
    if (StringContains(UnitGetType(hero), "Swann", c_stringAnywhere, c_stringNoCase)) {
        if (APRG_TrySwannFlamingBetty(hero, player)) { return true; }
    }
    return APRG_TryCategorizedAutonomousAbility(hero, player, false);
}

void APRG_TickGeneratedHeroAbilities(int player, fixed now) {
    unitgroup enemies;
    int i;
    unit hero;
    if (now < g_aprgNextGeneratedHeroAbilityTime) { return; }
    g_aprgNextGeneratedHeroAbilityTime = now + 2.5;
    enemies = APRG_EnemyAllUnits(player);
    for (i = 0; i < g_aprgGeneratedHeroCount; i += 1) {
        hero = g_aprgGeneratedHeroes[i];
        if (hero == null || !UnitIsAlive(hero) || !UnitGroupHasUnit(enemies, hero)) { continue; }
        APRG_TryGeneratedHeroAbility(hero, player);
    }
    if (g_aprgDehakaPackHero != null && UnitIsAlive(g_aprgDehakaPackHero) && UnitGroupHasUnit(enemies, g_aprgDehakaPackHero)) {
        APRG_TryGeneratedHeroAbility(g_aprgDehakaPackHero, player);
    }
}

unit APRG_NearestFriendlyAbilityTarget(unit caster, int player, fixed maxRange) {
    unitgroup units;
    int i;
    unit u;
    unit best = null;
    fixed distance;
    fixed bestDistance = 99999.0;
    fixed life;
    fixed lifeMax;
    fixed shields;
    fixed shieldsMax;
    point origin;
    if (caster == null) { return null; }
    origin = UnitGetPosition(caster);
    units = APRG_PlayerAllUnits(player);
    for (i = UnitGroupCount(units, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null || !UnitIsAlive(u)) { continue; }
        distance = DistanceBetweenPoints(origin, UnitGetPosition(u));
        if (distance > maxRange || distance >= bestDistance) { continue; }
        life = UnitGetPropertyFixed(u, c_unitPropLife, c_unitPropCurrent);
        lifeMax = UnitGetPropertyFixed(u, c_unitPropLifeMax, c_unitPropCurrent);
        shields = UnitGetPropertyFixed(u, c_unitPropShields, c_unitPropCurrent);
        shieldsMax = UnitGetPropertyFixed(u, c_unitPropShieldsMax, c_unitPropCurrent);
        if ((lifeMax > 0.0 && life < lifeMax - 0.5) || (shieldsMax > 0.0 && shields < shieldsMax - 0.5)) {
            best = u;
            bestDistance = distance;
        }
    }
    return best;
}

string APRG_AutonomousAbilityAlignment(string abilityType, int player) {
    if (abilityType == "" || !CatalogEntryIsValid(c_gameCatalogAbil, abilityType)) { return ""; }
    return CatalogFieldValueGet(c_gameCatalogAbil, abilityType, "Alignment", player);
}

bool APRG_AbilityUsesNativeAutocast(string abilityType, int owner) {
    if (abilityType == "" || !CatalogEntryIsValid(c_gameCatalogAbil, abilityType)) { return false; }
    return (
        CatalogFieldValueGet(c_gameCatalogAbil, abilityType, "Flags[AutoCast]", owner) == "1" ||
        CatalogFieldValueGet(c_gameCatalogAbil, abilityType, "Flags[AutoCastOn]", owner) == "1"
    );
}

bool APRG_AIHas(string abilityType, string token) {
    return abilityType != "" && StringContains(abilityType, token, c_stringAnywhere, c_stringNoCase);
}

int APRG_AutonomousAbilityCategory(string abilityType) {
    if (abilityType == "") { return APRG_AI_NONE; }

    if (
        APRG_AIHas(abilityType, "StasisWard") || APRG_AIHas(abilityType, "StasisTrap") ||
        APRG_AIHas(abilityType, "MassRecall") || APRG_AIHas(abilityType, "Recall") ||
        APRG_AIHas(abilityType, "Nuke") || APRG_AIHas(abilityType, "Calldown") ||
        APRG_AIHas(abilityType, "CarrierHangar") || APRG_AIHas(abilityType, "Interceptor") ||
        APRG_AIHas(abilityType, "Scarabs") || APRG_AIHas(abilityType, "Train") ||
        APRG_AIHas(abilityType, "Research") ||
        APRG_AIHas(abilityType, "Merge") || APRG_AIHas(abilityType, "Rally") ||
        APRG_AIHas(abilityType, "Transport") || APRG_AIHas(abilityType, "Load") || APRG_AIHas(abilityType, "Unload")
    ) { return APRG_AI_NONE; }

    if (APRG_AIHas(abilityType, "Cloak") || APRG_AIHas(abilityType, "Cloaking")) { return APRG_AI_CLOAK; }

    if (APRG_AIHas(abilityType, "TacticalJump") || APRG_AIHas(abilityType, "Blink")) { return APRG_AI_MOBILITY; }

    if (
        APRG_AIHas(abilityType, "MindControl") || APRG_AIHas(abilityType, "Domination") ||
        APRG_AIHas(abilityType, "Neural") || APRG_AIHas(abilityType, "ParasiticDomination") ||
        APRG_AIHas(abilityType, "Reclamation")
    ) { return APRG_AI_CAPTURE; }

    if (APRG_AIHas(abilityType, "Consume") || APRG_AIHas(abilityType, "Consumption") || APRG_AIHas(abilityType, "Sacrifice")) { return APRG_AI_CONSUME; }

    if (APRG_AIHas(abilityType, "Revelation") || APRG_AIHas(abilityType, "OcularSymbiote")) { return APRG_AI_REVEAL; }

    if (APRG_AIHas(abilityType, "HealingDrone") || APRG_AIHas(abilityType, "RepairDrone")) { return APRG_AI_HEAL_SUMMON; }
    if (
        APRG_AIHas(abilityType, "Transfus") || APRG_AIHas(abilityType, "Mend") ||
        APRG_AIHas(abilityType, "Restore") || APRG_AIHas(abilityType, "ShieldRecharge")
    ) { return APRG_AI_HEAL; }

    if (APRG_AIHas(abilityType, "DefensiveMatrix") || APRG_AIHas(abilityType, "ProtectiveShield")) { return APRG_AI_DEFENSIVE_TARGET; }
    if (
        APRG_AIHas(abilityType, "GuardianShield") || APRG_AIHas(abilityType, "DarkSwarm") ||
        APRG_AIHas(abilityType, "MicrobialShroud") || APRG_AIHas(abilityType, "PointDefenseDrone") ||
        APRG_AIHas(abilityType, "DefensiveDrone")
    ) { return APRG_AI_DEFENSIVE_AREA; }

    if (APRG_AIHas(abilityType, "IonicForceField") || APRG_AIHas(abilityType, "Barrier")) { return APRG_AI_REACTIVE; }
    if (
        APRG_AIHas(abilityType, "Stim") || APRG_AIHas(abilityType, "Frenzy") ||
        APRG_AIHas(abilityType, "Prismatic") || APRG_AIHas(abilityType, "DamageBoost") ||
        APRG_AIHas(abilityType, "Overcharge") || APRG_AIHas(abilityType, "DehakaMirrorImage")
    ) { return APRG_AI_SELF_BUFF; }
    if (APRG_AIHas(abilityType, "DehakaHeal")) { return APRG_AI_REACTIVE; }

    if (APRG_AIHas(abilityType, "Abduct") || APRG_AIHas(abilityType, "Grapple") || APRG_AIHas(abilityType, "Drag")) { return APRG_AI_FORCED_MOVE; }
    if (APRG_AIHas(abilityType, "LockOn") || APRG_AIHas(abilityType, "GravitonBeam")) { return APRG_AI_CHANNEL; }

    if (
        APRG_AIHas(abilityType, "Irradiate") || APRG_AIHas(abilityType, "Plague") ||
        APRG_AIHas(abilityType, "ParasiticBomb") || APRG_AIHas(abilityType, "Disintegration") ||
        APRG_AIHas(abilityType, "LightningBomb")
    ) { return APRG_AI_DOT; }

    if (APRG_AIHas(abilityType, "Feedback") || APRG_AIHas(abilityType, "EMP")) { return APRG_AI_ANTI_CASTER; }
    if (
        APRG_AIHas(abilityType, "Lockdown") || APRG_AIHas(abilityType, "Scrambler") ||
        APRG_AIHas(abilityType, "InterferenceMatrix") || APRG_AIHas(abilityType, "VoidStasis") ||
        APRG_AIHas(abilityType, "Stun")
    ) { return APRG_AI_DISABLE; }

    if (
        APRG_AIHas(abilityType, "AntiArmor") || APRG_AIHas(abilityType, "ShredderMissile") ||
        APRG_AIHas(abilityType, "Corruption") || APRG_AIHas(abilityType, "OpticalFlare") ||
        APRG_AIHas(abilityType, "DetectWeakness")
    ) { return APRG_AI_DEBUFF; }

    if (APRG_AIHas(abilityType, "SpiderMine")) { return APRG_AI_TRAP; }
    if (APRG_AIHas(abilityType, "HoloDecoy") || APRG_AIHas(abilityType, "Hallucination")) { return APRG_AI_DECOY; }
    if (
        APRG_AIHas(abilityType, "AutoTurret") || APRG_AIHas(abilityType, "RailGunTurret") ||
        APRG_AIHas(abilityType, "InfestedTerran") || APRG_AIHas(abilityType, "SpawnBaneling") ||
        APRG_AIHas(abilityType, "SpawnBroodling") || APRG_AIHas(abilityType, "BroodlingSpawn") ||
        APRG_AIHas(abilityType, "SpawnLocust") || APRG_AIHas(abilityType, "LocustLaunch") || APRG_AIHas(abilityType, "LocustFlyingLaunch") ||
        (APRG_AIHas(abilityType, "Flaming") || APRG_AIHas(abilityType, "Betty"))
    ) { return APRG_AI_SUMMON; }

    if (APRG_AIHas(abilityType, "ForceField")) { return APRG_AI_NONE; } // bad automated walls are worse than no cast
    if (APRG_AIHas(abilityType, "DisruptionWeb") || APRG_AIHas(abilityType, "BlindingCloud")) { return APRG_AI_AREA_DENIAL; }
    if (
        APRG_AIHas(abilityType, "Fungal") || APRG_AIHas(abilityType, "Ensnare") ||
        APRG_AIHas(abilityType, "FlashBang") || APRG_AIHas(abilityType, "CrushingGrip") ||
        APRG_AIHas(abilityType, "Ultrasonic") || APRG_AIHas(abilityType, "Maelstrom") ||
        APRG_AIHas(abilityType, "TimeWarp")
    ) { return APRG_AI_AOE_CONTROL; }
    if (
        APRG_AIHas(abilityType, "PsiStorm") || APRG_AIHas(abilityType, "PsionicStorm") ||
        APRG_AIHas(abilityType, "SeekerMissile") || APRG_AIHas(abilityType, "MissilePods") ||
        APRG_AIHas(abilityType, "ClusterBomb") || APRG_AIHas(abilityType, "Clusterbomb") ||
        APRG_AIHas(abilityType, "CorrosiveBile") || APRG_AIHas(abilityType, "PsionicOrb") ||
        APRG_AIHas(abilityType, "DestructionWave") || APRG_AIHas(abilityType, "AreaBlast")
    ) { return APRG_AI_AOE_DAMAGE; }

    if (APRG_AIHas(abilityType, "Penetrating") || APRG_AIHas(abilityType, "LineAttack") || APRG_AIHas(abilityType, "Laser")) { return APRG_AI_LINE; }
    if (APRG_AIHas(abilityType, "PurificationNova") || APRG_AIHas(abilityType, "NovaLaunch") || APRG_AIHas(abilityType, "CorrosiveBile")) { return APRG_AI_DELAYED; }

    if (APRG_AIHas(abilityType, "Vortex") || APRG_AIHas(abilityType, "BlackHole") || APRG_AIHas(abilityType, "Apocalypse")) { return APRG_AI_ULTIMATE; }

    if (
        APRG_AIHas(abilityType, "Snipe") || APRG_AIHas(abilityType, "PsionicLash") ||
        APRG_AIHas(abilityType, "MindBlast") || APRG_AIHas(abilityType, "Yamato") ||
        APRG_AIHas(abilityType, "KineticBlast") || APRG_AIHas(abilityType, "ShadowCannon") ||
        APRG_AIHas(abilityType, "Obliterate") || APRG_AIHas(abilityType, "250mm") ||
        APRG_AIHas(abilityType, "330mm")
    ) { return APRG_AI_BURST; }
    if (APRG_AIHas(abilityType, "LeapingStrike") || APRG_AIHas(abilityType, "BurrowCharge") || APRG_AIHas(abilityType, "DashAttack")) { return APRG_AI_BURST; }

    if (APRG_AIHas(abilityType, "ChronoBeam") || APRG_AIHas(abilityType, "Acceleration")) { return APRG_AI_SUPPORT; }

    return APRG_AI_NONE;
}

int APRG_AutonomousAbilityCategoryCached(string abilityType) {
    string key;
    int cached;
    int category;
    if (abilityType == "") { return APRG_AI_NONE; }
    key = "APRG_AICategory_" + abilityType;
    cached = DataTableGetInt(true, key);
    if (cached > 0) { return cached - 1; }
    category = APRG_AutonomousAbilityCategory(abilityType);
    DataTableSetInt(true, key, category + 1);
    return category;
}

bool APRG_AbilityUsesNativeAutocastCached(string abilityType, int owner) {
    string key;
    int cached;
    bool nativeAutocast;
    if (abilityType == "") { return false; }
    key = "APRG_AIAutocast_" + IntToString(owner) + "_" + abilityType;
    cached = DataTableGetInt(true, key);
    if (cached > 0) { return cached == 2; }
    nativeAutocast = APRG_AbilityUsesNativeAutocast(abilityType, owner);
    if (nativeAutocast) { DataTableSetInt(true, key, 2); }
    else { DataTableSetInt(true, key, 1); }
    return nativeAutocast;
}

bool APRG_IsAutonomousCloakAbility(string abilityType) {
    return APRG_AutonomousAbilityCategoryCached(abilityType) == APRG_AI_CLOAK;
}

bool APRG_AutonomousCloakReady(unit caster) {
    fixed energy;
    fixed maximum;
    if (caster == null || UnitTestState(caster, c_unitStateCloaked)) { return false; }
    energy = UnitGetPropertyFixed(caster, c_unitPropEnergy, c_unitPropCurrent);
    maximum = UnitGetPropertyFixed(caster, c_unitPropEnergyMax, c_unitPropCurrent);
    return maximum > 0.0 && energy >= maximum - 0.5;
}

fixed APRG_AutonomousAbilityRange(string abilityType, int owner) {
    fixed range;
    if (abilityType == "" || !CatalogEntryIsValid(c_gameCatalogAbil, abilityType)) { return 14.0; }
    range = StringToFixed(CatalogFieldValueGet(c_gameCatalogAbil, abilityType, "Range", owner));
    if (range <= 0.0) { return 14.0; }
    return range + 2.0;
}

fixed APRG_AICategoryRepeatDelay(int category) {
    if (category == APRG_AI_SUMMON || category == APRG_AI_TRAP || category == APRG_AI_DECOY || category == APRG_AI_ULTIMATE || category == APRG_AI_CAPTURE) { return 8.0; }
    if (category == APRG_AI_AOE_DAMAGE || category == APRG_AI_AOE_CONTROL || category == APRG_AI_AREA_DENIAL || category == APRG_AI_DOT || category == APRG_AI_DISABLE || category == APRG_AI_DEBUFF) { return 3.0; }
    return 2.0;
}

bool APRG_AICastThrottleReady(unit caster, string abilityType, int category) {
    string key;
    fixed last;
    if (caster == null || abilityType == "") { return false; }
    key = "APRG_AICast_" + IntToString(UnitGetTag(caster)) + "_" + abilityType;
    last = DataTableGetFixed(true, key);
    if (last > 0.0 && GameGetMissionTime() - last < APRG_AICategoryRepeatDelay(category)) { return false; }
    return true;
}

void APRG_RecordAICast(unit caster, string abilityType) {
    if (caster == null || abilityType == "") { return; }
    DataTableSetFixed(true, "APRG_AICast_" + IntToString(UnitGetTag(caster)) + "_" + abilityType, GameGetMissionTime());
}

unitgroup APRG_AIOpposingTargetsNear(unit caster, int player, bool friendlyToPlayer, fixed radius) {
    unitgroup result;
    point origin;
    int i;
    unit u;
    if (caster == null) { return UnitGroupEmpty(); }
    if (radius < 1.0) { radius = 1.0; }
    origin = UnitGetPosition(caster);
    if (friendlyToPlayer) {
        result = UnitGroupAlliance(
            player, c_unitAllianceEnemy, RegionCircle(origin, radius),
            UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)) | (1 << (c_targetFilterInvulnerable - 32))), 0
        );
    }
    else {
        result = UnitGroup(
            null, player, RegionCircle(origin, radius),
            UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)) | (1 << (c_targetFilterInvulnerable - 32))), 0
        );
    }
    for (i = UnitGroupCount(result, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(result, i);
        if (u != null && (UnitTestState(u, c_unitStateInvulnerable) || APRG_IsCreepTumorType(UnitGetType(u)) || APRG_IsRakShirObjectiveUnit(u))) { UnitGroupRemove(result, u); }
    }
    return result;
}

unit APRG_AIClosestOpposingTarget(unit caster, int player, bool friendlyToPlayer) {
    unitgroup targets;
    if (caster == null) { return null; }
    targets = APRG_AIOpposingTargetsNear(caster, player, friendlyToPlayer, 24.0);
    return UnitGroupClosestToPoint(targets, UnitGetPosition(caster));
}

bool APRG_AIEnemyWithinNine(unit caster, int player, bool friendlyToPlayer) {
    unitgroup targets;
    if (caster == null) { return false; }
    targets = APRG_AIOpposingTargetsNear(caster, player, friendlyToPlayer, 9.0);
    return UnitGroupCount(targets, c_unitCountAlive) > 0;
}

unit APRG_AINearestFriendlyTarget(unit caster, int player, bool friendlyToPlayer, fixed range) {
    if (friendlyToPlayer) { return APRG_NearestFriendlyAbilityTarget(caster, player, range); }
    return APRG_NearestOwnedInjuredAbilityTarget(caster, range);
}

unit APRG_TryAutonomousOffensiveOrder(unit caster, unitgroup candidates, string abilityType, int commandIndex) {
    unit target;
    point origin;
    order castOrder;
    fixed maxRange;
    fixed distance;
    int attempted;
    if (caster == null || candidates == null || abilityType == "") { return null; }
    origin = UnitGetPosition(caster);
    maxRange = APRG_AutonomousAbilityRange(abilityType, UnitGetOwner(caster));
    attempted = 0;
    while (UnitGroupCount(candidates, c_unitCountAlive) > 0 && attempted < 32) {
        target = UnitGroupClosestToPoint(candidates, origin);
        if (target == null) { break; }
        UnitGroupRemove(candidates, target);
        attempted += 1;
        if (!UnitIsAlive(target)) { continue; }
        distance = DistanceBetweenPoints(origin, UnitGetPosition(target));
        if (distance > maxRange) { break; }
        castOrder = OrderTargetingUnit(AbilityCommand(abilityType, commandIndex), target);
        if (UnitOrderIsValid(caster, castOrder)) {
            UnitIssueOrder(caster, castOrder, c_orderQueueReplace);
            return target;
        }
        castOrder = OrderTargetingPoint(AbilityCommand(abilityType, commandIndex), UnitGetPosition(target));
        if (UnitOrderIsValid(caster, castOrder)) {
            UnitIssueOrder(caster, castOrder, c_orderQueueReplace);
            return target;
        }
    }
    return null;
}

bool APRG_TryAutonomousPointOrder(unit caster, string abilityType, int commandIndex, point targetPoint) {
    order castOrder;
    if (caster == null || targetPoint == null) { return false; }
    castOrder = OrderTargetingPoint(AbilityCommand(abilityType, commandIndex), targetPoint);
    if (!UnitOrderIsValid(caster, castOrder)) { return false; }
    UnitIssueOrder(caster, castOrder, c_orderQueueReplace);
    return true;
}

// Slay's mutation and boon Purifiers must cast Vortex only at visible,
// living enemy units.  The generic spellcaster target list also contains
// structures, which are inappropriate Vortex targets.  Do not let a failed
// unit search fall through to the generic nearest-building point fallback.
bool APRG_TrySlayPurifierVortex(unit purifier, int player, bool friendlyToPlayer) {
    unitgroup targets;
    unit target;
    point origin;
    order previousOrder;
    bool hadPreviousOrder;
    int i;
    int commandIndex;
    int examined = 0;
    int owner;
    string abilityType = "VortexPurifier";
    if (purifier == null || !UnitIsAlive(purifier)) { return false; }
    if (purifier != g_aprgPurifier && purifier != g_aprgPurifierAlliance) { return false; }
    if (!UnitAbilityExists(purifier, abilityType) || !APRG_AICastThrottleReady(purifier, abilityType, APRG_AI_ULTIMATE)) { return false; }
    owner = UnitGetOwner(purifier);
    origin = UnitGetPosition(purifier);
    // The campaign VortexPurifier ability has a native range of 10.
    // Require the actual caster owner's vision, not just proximity.
    targets = APRG_AIOpposingTargetsNear(purifier, player, friendlyToPlayer, 10.0);
    for (i = UnitGroupCount(targets, c_unitCountAlive); i > 0; i -= 1) {
        target = UnitGroupUnitFromEnd(targets, i);
        if (target == null) { continue; }
        if (!UnitIsAlive(target) ||
            UnitTypeTestAttribute(UnitGetType(target), c_unitAttributeStructure) ||
            !libNtve_gf_UnitIsVisibleToPlayer(target, owner)) {
            UnitGroupRemove(targets, target);
        }
    }
    // No valid visible enemy units means no Vortex, even if enemy
    // buildings are within range.  Preserve the previous combat order.
    if (UnitGroupCount(targets, c_unitCountAlive) <= 0) { return false; }
    hadPreviousOrder = UnitOrderCount(purifier) > 0;
    if (hadPreviousOrder) { previousOrder = UnitOrder(purifier, 0); }
    while (UnitGroupCount(targets, c_unitCountAlive) > 0 && examined < 24) {
        target = UnitGroupClosestToPoint(targets, origin);
        if (target == null) { break; }
        UnitGroupRemove(targets, target);
        examined += 1;
        if (!UnitIsAlive(target) ||
            UnitTypeTestAttribute(UnitGetType(target), c_unitAttributeStructure) ||
            !libNtve_gf_UnitIsVisibleToPlayer(target, owner)) { continue; }
        if (DistanceBetweenPoints(origin, UnitGetPosition(target)) > 10.0) { continue; }
        for (commandIndex = 0; commandIndex < 4; commandIndex += 1) {
            if (APRG_TryAutonomousPointOrder(purifier, abilityType, commandIndex, UnitGetPosition(target))) {
                APRG_QueuePriorAutonomousOrder(purifier, previousOrder, hadPreviousOrder);
                APRG_RecordAICast(purifier, abilityType);
                return true;
            }
        }
    }
    return false;
}

bool APRG_TrySwannFlamingBetty(unit swann, int player) {
    string unitType;
    string key;
    string abilityType;
    fixed now;
    fixed last;
    point origin;
    point castPoint;
    unitgroup nearbyTargets;
    unitgroup created;
    unit betty;
    int abilityIndex;
    int abilityCount;
    int commandIndex;
    int pointAttempt;
    bool hadPriorOrder;
    order priorOrder;
    if (swann == null || !UnitIsAlive(swann)) { return false; }
    hadPriorOrder = UnitOrderCount(swann) > 0;
    if (hadPriorOrder) { priorOrder = UnitOrder(swann, 0); }
    unitType = UnitGetType(swann);
    if (!StringContains(unitType, "Swann", c_stringAnywhere, c_stringNoCase)) { return false; }

    now = GameGetMissionTime();
    key = "APRG_SwannBetty_" + IntToString(UnitGetTag(swann));
    last = DataTableGetFixed(true, key);
    // Native Place Flaming Betty has a 44-second cooldown and a 45-second life.
    // Keep the same cadence even if we have to use the catalog fallback below.
    if (last > 0.0 && now - last < 44.0) { return false; }
    nearbyTargets = APRG_AIOpposingTargetsNear(swann, player, false, 16.0);
    if (UnitGroupCount(nearbyTargets, c_unitCountAlive) <= 0) { return false; }

    origin = UnitGetPosition(swann);
    abilityCount = MinI(64, UnitAbilityCount(swann));
    for (abilityIndex = 1; abilityIndex <= abilityCount; abilityIndex += 1) {
        abilityType = UnitAbilityGet(swann, abilityIndex);
        if (
            !StringContains(abilityType, "Flaming", c_stringAnywhere, c_stringNoCase) &&
            !StringContains(abilityType, "Betty", c_stringAnywhere, c_stringNoCase)
        ) { continue; }
        for (commandIndex = 0; commandIndex < 4; commandIndex += 1) {
            for (pointAttempt = 0; pointAttempt < 12; pointAttempt += 1) {
                castPoint = PointWithOffsetPolar(origin, RandomFixed(2.0, 5.0), libNtve_gf_RandomAngle());
                if (castPoint == null || !RegionContainsPoint(RegionPlayableMap(), castPoint) || !PointPathingPassable(castPoint)) { continue; }
                if (APRG_TryAutonomousPointOrder(swann, abilityType, commandIndex, castPoint)) {
                    APRG_QueuePriorAutonomousOrder(swann, priorOrder, hadPriorOrder);
                    DataTableSetFixed(true, key, now);
                    APRG_RecordAICast(swann, abilityType);
                    return true;
                }
            }
        }
    }

    // Some dependency combinations expose Rory Swann but not a usable command
    // for Place Flaming Betty. In that case reproduce the native result rather
    // than silently leaving the hero without his signature ability.
    if (!CatalogEntryIsValid(c_gameCatalogUnit, "FlamingBetty")) { return false; }
    for (pointAttempt = 0; pointAttempt < 12; pointAttempt += 1) {
        castPoint = PointWithOffsetPolar(origin, RandomFixed(2.0, 5.0), libNtve_gf_RandomAngle());
        if (castPoint == null || !RegionContainsPoint(RegionPlayableMap(), castPoint) || !PointPathingPassable(castPoint)) { continue; }
        created = UnitCreate(1, "FlamingBetty", c_unitCreateIgnorePlacement, UnitGetOwner(swann), castPoint, libNtve_gf_RandomAngle());
        betty = UnitGroupUnitFromEnd(created, 1);
        if (betty == null) { continue; }
        APRG_RegisterMutationEnemyGroup(created);
        if (CatalogEntryIsValid(c_gameCatalogBehavior, "AutoTurretTimedLife")) {
            UnitBehaviorAdd(betty, "AutoTurretTimedLife", betty, 1);
            UnitBehaviorSetDuration(betty, "AutoTurretTimedLife", 45.0);
            UnitBehaviorSetDurationRemaining(betty, "AutoTurretTimedLife", 45.0);
        }
        DataTableSetFixed(true, key, now);
        return true;
    }
    return false;
}

bool APRG_TryAutonomousUnitOrder(unit caster, string abilityType, int commandIndex, unit target) {
    order castOrder;
    if (caster == null || target == null || !UnitIsAlive(target)) { return false; }
    castOrder = OrderTargetingUnit(AbilityCommand(abilityType, commandIndex), target);
    if (!UnitOrderIsValid(caster, castOrder)) { return false; }
    UnitIssueOrder(caster, castOrder, c_orderQueueReplace);
    return true;
}

bool APRG_TryAttackDeploymentPosture(unit caster, int player, bool friendlyToPlayer) {
    string unitType;
    string abilityType;
    string key;
    int i;
    int commandIndex;
    unit enemy;
    fixed now;
    fixed since;
    fixed repositionUntil;
    order postureOrder;
    bool buried;
    if (caster == null || !UnitIsAlive(caster)) { return false; }
    unitType = UnitGetType(caster);
    if (
        !APRG_AIHas(unitType, "Lurker") && !APRG_AIHas(unitType, "Impaler") &&
        !APRG_AIHas(unitType, "WidowMine") && !APRG_AIHas(unitType, "SwarmHost")
    ) { return false; }
    now = GameGetMissionTime();
    key = "APRG_Posture_" + IntToString(UnitGetTag(caster));
    buried = UnitTestState(caster, c_unitStateBuried) || APRG_AIHas(unitType, "Burrowed") || APRG_AIHas(unitType, "Rooted");
    since = DataTableGetFixed(true, key + "_Since");
    repositionUntil = DataTableGetFixed(true, key + "_MoveUntil");
    enemy = APRG_AIClosestOpposingTarget(caster, player, friendlyToPlayer);

    if (buried && since > 0.0 && now - since >= 10.0) {
        for (i = 1; i <= UnitAbilityCount(caster); i += 1) {
            abilityType = UnitAbilityGet(caster, i);
            if (
                !APRG_AIHas(abilityType, "Burrow") && !APRG_AIHas(abilityType, "Unburrow") &&
                !APRG_AIHas(abilityType, "Uproot") && !APRG_AIHas(abilityType, "Unroot")
            ) { continue; }
            for (commandIndex = 0; commandIndex < 4; commandIndex += 1) {
                postureOrder = Order(AbilityCommand(abilityType, commandIndex));
                if (!UnitOrderIsValid(caster, postureOrder)) { continue; }
                UnitIssueOrder(caster, postureOrder, c_orderQueueReplace);
                DataTableSetFixed(true, key + "_Since", 0.0);
                DataTableSetFixed(true, key + "_MoveUntil", now + 4.0);
                if (enemy != null) { UnitIssueOrder(caster, OrderTargetingPoint(AbilityCommand("attack", 0), UnitGetPosition(enemy)), c_orderQueueAddToEnd); }
                return true;
            }
        }
    }
    if (!buried && now >= repositionUntil && enemy != null && DistanceBetweenPoints(UnitGetPosition(caster), UnitGetPosition(enemy)) <= 9.0) {
        for (i = 1; i <= UnitAbilityCount(caster); i += 1) {
            abilityType = UnitAbilityGet(caster, i);
            if (
                !APRG_AIHas(abilityType, "Burrow") && !APRG_AIHas(abilityType, "Root") &&
                !APRG_AIHas(abilityType, "Deploy")
            ) { continue; }
            for (commandIndex = 0; commandIndex < 4; commandIndex += 1) {
                postureOrder = Order(AbilityCommand(abilityType, commandIndex));
                if (!UnitOrderIsValid(caster, postureOrder)) { continue; }
                UnitIssueOrder(caster, postureOrder, c_orderQueueReplace);
                DataTableSetFixed(true, key + "_Since", now);
                return true;
            }
        }
    }
    if (buried && since <= 0.0) { DataTableSetFixed(true, key + "_Since", now); }
    return false;
}

bool APRG_TryLowHpRetreatMobility(unit caster, int player, string abilityType, int commandIndex, bool friendlyToPlayer) {
    fixed life;
    fixed lifeMax;
    unit home;
    order castOrder;
    if (!friendlyToPlayer || caster == null) { return false; }
    life = UnitGetPropertyFixed(caster, c_unitPropLife, c_unitPropCurrent);
    lifeMax = UnitGetPropertyFixed(caster, c_unitPropLifeMax, c_unitPropCurrent);
    if (lifeMax <= 0.0 || life / lifeMax > 0.20) { return false; }
    home = APRG_FindPlayerHomeStructure(player);
    if (home == null) { return false; }
    castOrder = OrderTargetingPoint(AbilityCommand(abilityType, commandIndex), UnitGetPosition(home));
    if (!UnitOrderIsValid(caster, castOrder)) { return false; }
    UnitIssueOrder(caster, castOrder, c_orderQueueReplace);
    return true;
}

bool APRG_TryConsumeAbility(unit caster, int player, bool friendlyToPlayer, string abilityType, int commandIndex) {
    unitgroup candidates;
    unit target;
    point origin;
    fixed energy;
    fixed maxEnergy;
    int attempted;
    if (caster == null) { return false; }
    energy = UnitGetPropertyFixed(caster, c_unitPropEnergy, c_unitPropCurrent);
    maxEnergy = UnitGetPropertyFixed(caster, c_unitPropEnergyMax, c_unitPropCurrent);
    if (maxEnergy <= 0.0 || energy / maxEnergy > 0.35) { return false; }
    origin = UnitGetPosition(caster);
    if (friendlyToPlayer) { candidates = APRG_PlayerAllUnits(player); }
    else { candidates = UnitGroup(null, UnitGetOwner(caster), RegionCircle(origin, 10.0), UnitFilter(0,0,(1 << c_targetFilterMissile),(1 << (c_targetFilterDead - 32))),0); }
    attempted = 0;
    while (UnitGroupCount(candidates, c_unitCountAlive) > 0 && attempted < 24) {
        target = UnitGroupClosestToPoint(candidates, origin);
        if (target == null) { break; }
        UnitGroupRemove(candidates, target);
        attempted += 1;
        if (target == caster || !UnitIsAlive(target)) { continue; }
        if (UnitTypeTestAttribute(UnitGetType(target), c_unitAttributeHeroic)) { continue; }
        if (APRG_TryAutonomousUnitOrder(caster, abilityType, commandIndex, target)) { return true; }
    }
    return false;
}

void APRG_QueuePriorAutonomousOrder(unit caster, order priorOrder, bool hadPriorOrder) {
    if (!hadPriorOrder || caster == null || !UnitIsAlive(caster)) { return; }
    if (!UnitOrderIsValid(caster, priorOrder)) { return; }
    UnitIssueOrder(caster, priorOrder, c_orderQueueAddToEnd);
}

// All Slay-controlled High Templar use this before the generic ability scan.
// Mass Spellcasters and Specialists otherwise miss storms while moving toward
// distant bases, or cast Feedback before trying a valid multi-unit Psi Storm.
bool APRG_TryHighTemplarStorm(unit caster, int player, bool friendlyToPlayer, order priorOrder, bool hadPriorOrder) {
    int a;
    int commandIndex;
    int i;
    int j;
    int score;
    int bestScore;
    int count;
    string abilityType;
    string unitType;
    unitgroup targets;
    unit candidate;
    unit other;
    point candidatePoint;
    point bestPoint;
    point origin;
    fixed range;
    fixed distance;
    fixed bestNearest;
    fixed last;
    string cooldownKey;
    if (caster == null || !UnitIsAlive(caster)) { return false; }
    unitType = UnitGetType(caster);
    if (!StringContains(unitType, "HighTemplar", c_stringAnywhere, c_stringNoCase) &&
        !StringContains(unitType, "Signifier", c_stringAnywhere, c_stringNoCase)) { return false; }
    cooldownKey = "APRG_TemplarStorm_" + IntToString(UnitGetTag(caster));
    last = DataTableGetFixed(true, cooldownKey);
    if (last > 0.0 && GameGetMissionTime() - last < 1.5) { return false; }
    origin = UnitGetPosition(caster);
    for (a = 1; a <= MinI(64, UnitAbilityCount(caster)); a += 1) {
        abilityType = UnitAbilityGet(caster, a);
        if (!APRG_AIHas(abilityType, "PsiStorm") &&
            !APRG_AIHas(abilityType, "PsionicStorm")) { continue; }
        // The native Storm is 9 range; honor smaller catalog variants and do
        // not search beyond 10 to avoid futile orders on out-of-range enemies.
        range = MinF(10.0, APRG_AutonomousAbilityRange(abilityType, UnitGetOwner(caster)));
        targets = APRG_AIOpposingTargetsNear(caster, player, friendlyToPlayer, range);
        count = MinI(24, UnitGroupCount(targets, c_unitCountAlive));
        if (count <= 0) { continue; }
        // Target actual enemy concentrations rather than the nearest enemy by
        // itself. Even a single nearby target qualifies if no cluster exists.
        bestPoint = null;
        bestScore = -1;
        bestNearest = 999.0;
        for (i = 1; i <= count; i += 1) {
            candidate = UnitGroupUnitFromEnd(targets, i);
            if (candidate == null || !UnitIsAlive(candidate)) { continue; }
            candidatePoint = UnitGetPosition(candidate);
            distance = DistanceBetweenPoints(origin, candidatePoint);
            if (distance > range) { continue; }
            score = 0;
            for (j = 1; j <= count; j += 1) {
                other = UnitGroupUnitFromEnd(targets, j);
                if (other != null && UnitIsAlive(other) &&
                    DistanceBetweenPoints(candidatePoint, UnitGetPosition(other)) <= 2.5) { score += 1; }
            }
            if (score > bestScore || (score == bestScore && distance < bestNearest)) {
                bestPoint = candidatePoint;
                bestScore = score;
                bestNearest = distance;
            }
        }
        if (bestPoint == null) { continue; }
        for (commandIndex = 0; commandIndex < 4; commandIndex += 1) {
            if (APRG_TryAutonomousPointOrder(caster, abilityType, commandIndex, bestPoint)) {
                APRG_QueuePriorAutonomousOrder(caster, priorOrder, hadPriorOrder);
                DataTableSetFixed(true, cooldownKey, GameGetMissionTime());
                APRG_RecordAICast(caster, abilityType);
                return true;
            }
        }
    }
    return false;
}

bool APRG_TryCategorizedAutonomousAbility(unit caster, int player, bool friendlyToPlayer) {
    int abilityIndex;
    int abilityCount;
    int commandIndex;
    int category;
    string abilityType;
    unit enemyTarget;
    unit friendlyTarget;
    unit offensiveTarget;
    unitgroup offensiveTargets;
    order castOrder;
    point castPoint;
    point casterPoint;
    int pointAttempt;
    fixed life;
    fixed lifeMax;
    bool inCombat;
    bool hadPriorOrder;
    order priorOrder;
    if (caster == null || !UnitIsAlive(caster)) { return false; }

    // Preserve the roaming/attack-move objective across opportunistic casts.
    // This is what lets scripted units use abilities without forgetting where
    // they were going and standing idle after the cast finishes.
    hadPriorOrder = UnitOrderCount(caster) > 0;
    if (hadPriorOrder) { priorOrder = UnitOrder(caster, 0); }

    if (APRG_TryAttackDeploymentPosture(caster, player, friendlyToPlayer)) { return true; }
    // Prioritize storm even if native autocast is enabled for this ability.
    if (APRG_TryHighTemplarStorm(caster, player, friendlyToPlayer, priorOrder, hadPriorOrder)) { return true; }
    if (APRG_TrySlayPurifierVortex(caster, player, friendlyToPlayer)) { return true; }

    enemyTarget = APRG_AIClosestOpposingTarget(caster, player, friendlyToPlayer);
    inCombat = enemyTarget != null;
    abilityCount = MinI(96, UnitAbilityCount(caster));
    for (abilityIndex = 1; abilityIndex <= abilityCount; abilityIndex += 1) {
        abilityType = UnitAbilityGet(caster, abilityIndex);
        if (abilityType == "") { continue; }
        // Slay Purifiers use a unit-only Vortex selector above.  Never
        // retry their Vortex on the generic structure/point target pool.
        if ((caster == g_aprgPurifier || caster == g_aprgPurifierAlliance) &&
            APRG_AIHas(abilityType, "Vortex")) { continue; }
        if (APRG_AbilityUsesNativeAutocastCached(abilityType, UnitGetOwner(caster))) { continue; }
        category = APRG_AutonomousAbilityCategoryCached(abilityType);
        if (category == APRG_AI_NONE || !APRG_AICastThrottleReady(caster, abilityType, category)) { continue; }

        for (commandIndex = 0; commandIndex < 4; commandIndex += 1) {
            if (category == APRG_AI_CLOAK) {
                if (!inCombat || !APRG_AutonomousCloakReady(caster)) { break; }
                castOrder = Order(AbilityCommand(abilityType, commandIndex));
                if (UnitOrderIsValid(caster, castOrder)) { UnitIssueOrder(caster, castOrder, c_orderQueueReplace); APRG_QueuePriorAutonomousOrder(caster, priorOrder, hadPriorOrder); APRG_RecordAICast(caster, abilityType); return true; }
                break; // never probe an Off command
            }
            if (category == APRG_AI_MOBILITY) {
                if (APRG_TryLowHpRetreatMobility(caster, player, abilityType, commandIndex, friendlyToPlayer)) { APRG_RecordAICast(caster, abilityType); return true; }
                continue;
            }
            if (category == APRG_AI_REACTIVE) {
                life = UnitGetPropertyFixed(caster, c_unitPropLife, c_unitPropCurrent);
                lifeMax = UnitGetPropertyFixed(caster, c_unitPropLifeMax, c_unitPropCurrent);
                if (lifeMax > 0.0 && life / lifeMax > 0.65) { continue; }
                castOrder = Order(AbilityCommand(abilityType, commandIndex));
                if (UnitOrderIsValid(caster, castOrder)) { UnitIssueOrder(caster, castOrder, c_orderQueueReplace); APRG_QueuePriorAutonomousOrder(caster, priorOrder, hadPriorOrder); APRG_RecordAICast(caster, abilityType); return true; }
                continue;
            }
            if (category == APRG_AI_SELF_BUFF) {
                if (!inCombat) { continue; }
                castOrder = Order(AbilityCommand(abilityType, commandIndex));
                if (UnitOrderIsValid(caster, castOrder)) { UnitIssueOrder(caster, castOrder, c_orderQueueReplace); APRG_QueuePriorAutonomousOrder(caster, priorOrder, hadPriorOrder); APRG_RecordAICast(caster, abilityType); return true; }
                continue;
            }
            if (category == APRG_AI_HEAL || category == APRG_AI_DEFENSIVE_TARGET || category == APRG_AI_SUPPORT || category == APRG_AI_REVEAL) {
                friendlyTarget = APRG_AINearestFriendlyTarget(caster, player, friendlyToPlayer, APRG_AutonomousAbilityRange(abilityType, UnitGetOwner(caster)));
                if (friendlyTarget != null && APRG_TryAutonomousUnitOrder(caster, abilityType, commandIndex, friendlyTarget)) { APRG_QueuePriorAutonomousOrder(caster, priorOrder, hadPriorOrder); APRG_RecordAICast(caster, abilityType); return true; }
                if (category == APRG_AI_REVEAL && enemyTarget != null && APRG_TryAutonomousUnitOrder(caster, abilityType, commandIndex, enemyTarget)) { APRG_QueuePriorAutonomousOrder(caster, priorOrder, hadPriorOrder); APRG_RecordAICast(caster, abilityType); return true; }
                continue;
            }
            if (category == APRG_AI_HEAL_SUMMON) {
                friendlyTarget = APRG_AINearestFriendlyTarget(caster, player, friendlyToPlayer, 10.0);
                if (friendlyTarget != null && APRG_TryAutonomousPointOrder(caster, abilityType, commandIndex, UnitGetPosition(friendlyTarget))) { APRG_QueuePriorAutonomousOrder(caster, priorOrder, hadPriorOrder); APRG_RecordAICast(caster, abilityType); return true; }
                continue;
            }
            if (category == APRG_AI_DEFENSIVE_AREA) {
                if (!inCombat) { continue; }
                castOrder = Order(AbilityCommand(abilityType, commandIndex));
                if (UnitOrderIsValid(caster, castOrder)) { UnitIssueOrder(caster, castOrder, c_orderQueueReplace); APRG_QueuePriorAutonomousOrder(caster, priorOrder, hadPriorOrder); APRG_RecordAICast(caster, abilityType); return true; }
                if (APRG_TryAutonomousPointOrder(caster, abilityType, commandIndex, UnitGetPosition(caster))) { APRG_QueuePriorAutonomousOrder(caster, priorOrder, hadPriorOrder); APRG_RecordAICast(caster, abilityType); return true; }
                if (enemyTarget != null && APRG_TryAutonomousPointOrder(caster, abilityType, commandIndex, UnitGetPosition(enemyTarget))) { APRG_QueuePriorAutonomousOrder(caster, priorOrder, hadPriorOrder); APRG_RecordAICast(caster, abilityType); return true; }
                continue;
            }
            if (category == APRG_AI_CONSUME) {
                if (APRG_TryConsumeAbility(caster, player, friendlyToPlayer, abilityType, commandIndex)) { APRG_QueuePriorAutonomousOrder(caster, priorOrder, hadPriorOrder); APRG_RecordAICast(caster, abilityType); return true; }
                continue;
            }

            if (category == APRG_AI_SUMMON && (APRG_AIHas(abilityType, "Flaming") || APRG_AIHas(abilityType, "Betty"))) {
                if (!inCombat) { continue; }
                casterPoint = UnitGetPosition(caster);
                for (pointAttempt = 0; pointAttempt < 8; pointAttempt += 1) {
                    castPoint = PointWithOffsetPolar(casterPoint, RandomFixed(2.0, 5.0), libNtve_gf_RandomAngle());
                    if (castPoint == null || !RegionContainsPoint(RegionPlayableMap(), castPoint) || !PointPathingPassable(castPoint)) { continue; }
                    if (APRG_TryAutonomousPointOrder(caster, abilityType, commandIndex, castPoint)) {
                        APRG_QueuePriorAutonomousOrder(caster, priorOrder, hadPriorOrder);
                        APRG_RecordAICast(caster, abilityType);
                        return true;
                    }
                }
                continue;
            }

            offensiveTargets = APRG_AIOpposingTargetsNear(caster, player, friendlyToPlayer, APRG_AutonomousAbilityRange(abilityType, UnitGetOwner(caster)));
            offensiveTarget = APRG_TryAutonomousOffensiveOrder(caster, offensiveTargets, abilityType, commandIndex);
            if (offensiveTarget != null) { APRG_QueuePriorAutonomousOrder(caster, priorOrder, hadPriorOrder); APRG_RecordAICast(caster, abilityType); return true; }

            if (enemyTarget != null && (
                category == APRG_AI_SUMMON || category == APRG_AI_TRAP || category == APRG_AI_DECOY ||
                category == APRG_AI_AOE_DAMAGE || category == APRG_AI_AOE_CONTROL || category == APRG_AI_AREA_DENIAL ||
                category == APRG_AI_LINE || category == APRG_AI_DELAYED || category == APRG_AI_ULTIMATE || category == APRG_AI_DEBUFF
            )) {
                castPoint = UnitGetPosition(enemyTarget);
                if (APRG_TryAutonomousPointOrder(caster, abilityType, commandIndex, castPoint)) { APRG_QueuePriorAutonomousOrder(caster, priorOrder, hadPriorOrder); APRG_RecordAICast(caster, abilityType); return true; }
            }
        }
    }
    return false;
}

bool APRG_TryFriendlyAutonomousAbility(unit caster, int player) {
    return APRG_TryCategorizedAutonomousAbility(caster, player, true);
}

bool APRG_IsTrackedActiveEnemy(unit u) {
    int i;
    if (u == null) { return false; }
    for (i = 0; i < APRG_MAX_ACTIVE_ENEMIES; i += 1) {
        if (g_aprgActiveEnemyUnits[i] == u) { return true; }
    }
    return false;
}

void APRG_TickFriendlyAutonomousAbilities(int player, fixed now) {
    int count;
    int processed;
    int index;
    unit u;
    if (now < g_aprgNextFriendlyAutonomousAbilityTime) { return; }
    g_aprgNextFriendlyAutonomousAbilityTime = now + 0.5;

    count = UnitGroupCount(g_aprgAirSupportUnits, c_unitCountAlive);
    if (count <= 0) { g_aprgFriendlyAirAbilityCursor = 0; }
    else {
        if (g_aprgFriendlyAirAbilityCursor >= count) { g_aprgFriendlyAirAbilityCursor = 0; }
        for (processed = 0; processed < 5 && processed < count; processed += 1) {
            index = ((g_aprgFriendlyAirAbilityCursor + processed) % count) + 1;
            u = UnitGroupUnitFromEnd(g_aprgAirSupportUnits, index);
            if (u == null || !UnitIsAlive(u)) { continue; }
            APRG_TryFriendlyAutonomousAbility(u, player);
        }
        g_aprgFriendlyAirAbilityCursor = (g_aprgFriendlyAirAbilityCursor + processed) % count;
    }

    count = UnitGroupCount(g_aprgClonedUnits, c_unitCountAlive);
    if (count <= 0) { g_aprgFriendlyCloneAbilityCursor = 0; }
    else {
        if (g_aprgFriendlyCloneAbilityCursor >= count) { g_aprgFriendlyCloneAbilityCursor = 0; }
        for (processed = 0; processed < 5 && processed < count; processed += 1) {
            index = ((g_aprgFriendlyCloneAbilityCursor + processed) % count) + 1;
            u = UnitGroupUnitFromEnd(g_aprgClonedUnits, index);
            if (u == null || !UnitIsAlive(u)) { continue; }
            APRG_TryFriendlyAutonomousAbility(u, player);
        }
        g_aprgFriendlyCloneAbilityCursor = (g_aprgFriendlyCloneAbilityCursor + processed) % count;
    }

    count = UnitGroupCount(g_aprgAlliedSupport, c_unitCountAlive);
    if (count <= 0) { g_aprgFriendlySupportAbilityCursor = 0; }
    else {
        if (g_aprgFriendlySupportAbilityCursor >= count) { g_aprgFriendlySupportAbilityCursor = 0; }
        for (processed = 0; processed < 5 && processed < count; processed += 1) {
            index = ((g_aprgFriendlySupportAbilityCursor + processed) % count) + 1;
            u = UnitGroupUnitFromEnd(g_aprgAlliedSupport, index);
            if (u == null || !UnitIsAlive(u)) { continue; }
            APRG_TryFriendlyAutonomousAbility(u, player);
        }
        g_aprgFriendlySupportAbilityCursor = (g_aprgFriendlySupportAbilityCursor + processed) % count;
    }

    count = UnitGroupCount(g_aprgAlliedZombies, c_unitCountAlive);
    if (count <= 0) { g_aprgFriendlyZombieAbilityCursor = 0; }
    else {
        if (g_aprgFriendlyZombieAbilityCursor >= count) { g_aprgFriendlyZombieAbilityCursor = 0; }
        for (processed = 0; processed < 5 && processed < count; processed += 1) {
            index = ((g_aprgFriendlyZombieAbilityCursor + processed) % count) + 1;
            u = UnitGroupUnitFromEnd(g_aprgAlliedZombies, index);
            if (u == null || !UnitIsAlive(u)) { continue; }
            APRG_TryFriendlyAutonomousAbility(u, player);
        }
        g_aprgFriendlyZombieAbilityCursor = (g_aprgFriendlyZombieAbilityCursor + processed) % count;
    }

    if (g_aprgTychus != null && UnitIsAlive(g_aprgTychus)) { APRG_TryFriendlyAutonomousAbility(g_aprgTychus, player); }
    if (g_aprgPurifierAlliance != null && UnitIsAlive(g_aprgPurifierAlliance)) { APRG_TryFriendlyAutonomousAbility(g_aprgPurifierAlliance, player); }
}

void APRG_TickEnemyCombatAbilities(int player, fixed now) {
    unitgroup enemies;
    int count;
    int processed;
    int index;
    unit enemy;
    if (now < g_aprgNextEnemyAbilityTime) { return; }
    g_aprgNextEnemyAbilityTime = now + 1.0;
    enemies = APRG_EnemyMobileUnits(player);
    count = UnitGroupCount(enemies, c_unitCountAlive);
    if (count <= 0) { g_aprgEnemyAbilityCursor = 0; return; }
    if (g_aprgEnemyAbilityCursor >= count) { g_aprgEnemyAbilityCursor = 0; }
    for (processed = 0; processed < 24 && processed < count; processed += 1) {
        index = ((g_aprgEnemyAbilityCursor + processed) % count) + 1;
        enemy = UnitGroupUnitFromEnd(enemies, index);
        if (enemy == null || !UnitIsAlive(enemy)) { continue; }
        if (APRG_IsScriptedPurifier(enemy) || APRG_IsRakShirObjectiveUnit(enemy)) { continue; }
        if (
            !g_aprgDestructionStarted &&
            !UnitGroupHasUnit(g_aprgHostileRaiders, enemy) &&
            !UnitGroupHasUnit(g_aprgHostilePatrollers, enemy) &&
            !UnitGroupHasUnit(g_aprgDarkTemplarRaiders, enemy) &&
            !UnitGroupHasUnit(g_aprgMarauderKillTeamUnits, enemy) &&
            !UnitGroupHasUnit(g_aprgGoldenFleet, enemy) &&
            !UnitGroupHasUnit(g_aprgTrueGoldenFleet, enemy) &&
            !UnitGroupHasUnit(g_aprgTrueGoldenPhoenixes, enemy) &&
            !UnitGroupHasUnit(g_aprgTaldarimRaiders, enemy) &&
            enemy != g_aprgDehakaPackHero &&
            !(APRG_HasExtension2(APRG_EXT2_MUT_ACTIVE_ENEMIES) && APRG_IsTrackedActiveEnemy(enemy))
        ) { continue; }
        if (APRG_HasExtension2(APRG_EXT2_MUT_ACTIVE_ENEMIES) && APRG_IsTrackedActiveEnemy(enemy)) {
            AISetUnitScriptControlled(enemy, false);
        }
        APRG_TryGeneratedHeroAbility(enemy, player);
    }
    g_aprgEnemyAbilityCursor = (g_aprgEnemyAbilityCursor + processed) % count;
}

unit APRG_FindInjuredFriendlyForQueen(unit queen, fixed radius) {
    unitgroup allies;
    int i;
    unit u;
    unit best = null;
    fixed life;
    fixed maxLife;
    fixed missing;
    fixed bestMissing = 0.0;
    int owner;
    if (queen == null) { return null; }
    owner = UnitGetOwner(queen);
    allies = UnitGroup(null, owner, RegionCircle(UnitGetPosition(queen), radius), UnitFilter(0, 0, 0, 0), 0);
    for (i = UnitGroupCount(allies, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(allies, i);
        if (u == null || !UnitIsAlive(u) || u == queen) { continue; }
        maxLife = UnitGetPropertyFixed(u, c_unitPropLifeMax, c_unitPropCurrent);
        life = UnitGetPropertyFixed(u, c_unitPropLife, c_unitPropCurrent);
        missing = maxLife - life;
        if (maxLife > 0.0 && missing >= 25.0 && missing > bestMissing) {
            best = u;
            bestMissing = missing;
        }
    }
    return best;
}

bool APRG_TryQueenTransfusion(unit queen) {
    unit target;
    int abilityIndex;
    int abilityCount;
    int commandIndex;
    string abilityType;
    order healOrder;
    if (queen == null || !UnitIsAlive(queen) || !StringContains(UnitGetType(queen), "Queen", c_stringAnywhere, c_stringNoCase)) { return false; }
    target = APRG_FindInjuredFriendlyForQueen(queen, 12.0);
    if (target == null) { return false; }
    abilityCount = MinI(64, UnitAbilityCount(queen));
    for (abilityIndex = 1; abilityIndex <= abilityCount; abilityIndex += 1) {
        abilityType = UnitAbilityGet(queen, abilityIndex);
        if (!StringContains(abilityType, "Transfus", c_stringAnywhere, c_stringNoCase)) { continue; }
        for (commandIndex = 0; commandIndex < 4; commandIndex += 1) {
            healOrder = OrderTargetingUnit(AbilityCommand(abilityType, commandIndex), target);
            if (UnitOrderIsValid(queen, healOrder)) {
                UnitIssueOrder(queen, healOrder, c_orderQueueReplace);
                return true;
            }
        }
    }
    return false;
}

void APRG_TickQueenTransfusions(int player, fixed now) {
    unitgroup playerUnits;
    unitgroup enemies;
    int i;
    unit u;
    if (now < g_aprgNextQueenAbilityTime) { return; }
    g_aprgNextQueenAbilityTime = now + 1.0;
    playerUnits = APRG_PlayerMobileUnits(player);
    for (i = UnitGroupCount(playerUnits, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(playerUnits, i);
        if (
            u != null && UnitGroupHasUnit(g_aprgAlliedSupport, u) &&
            StringContains(UnitGetType(u), "Queen", c_stringAnywhere, c_stringNoCase)
        ) { APRG_TryQueenTransfusion(u); }
    }
    enemies = APRG_EnemyMobileUnits(player);
    for (i = UnitGroupCount(enemies, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(enemies, i);
        if (
            u != null &&
            (UnitGroupHasUnit(g_aprgHostileRaiders, u) || UnitGroupHasUnit(g_aprgHostilePatrollers, u)) &&
            StringContains(UnitGetType(u), "Queen", c_stringAnywhere, c_stringNoCase)
        ) { APRG_TryQueenTransfusion(u); }
    }
}

void APRG_TickGeneratedHeroNoRevive() {
    int i;
    unit u;
    for (i = 0; i < g_aprgGeneratedHeroCount; i += 1) {
        u = g_aprgGeneratedHeroes[i];
        if (u == null) { continue; }
        if (UnitIsAlive(u)) {
            APRG_DisableGeneratedHeroRevive(u);
            if ((UnitGetType(u) == "ZaGara" || UnitGetType(u) == "Zagara") && UnitGetPropertyFixed(u, c_unitPropLife, c_unitPropCurrent) <= 3.1) {
                UnitKill(u);
                if (UnitIsAlive(u)) { UnitRemove(u); }
            }
        }
        if (!g_aprgGeneratedHeroDied[i] && !UnitIsAlive(u)) {
            g_aprgGeneratedHeroDied[i] = true;
        }
        else if (g_aprgGeneratedHeroDied[i] && UnitIsAlive(u)) {
            UnitRemove(u);
        }
    }
}

string APRG_AlarakHeroType() {
    // "Alarak" is not the reliable gameplay catalog id in every dependency
    // set. Prefer the LotV campaign hero, then the co-op hero, and retain the
    // older aliases only as fallbacks for unusual mission catalogs.
    if (CatalogEntryIsValid(c_gameCatalogUnit, "AlarakChampion")) { return "AlarakChampion"; }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "AlarakCoop")) { return "AlarakCoop"; }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "Alarak")) { return "Alarak"; }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "PitAlarak")) { return "PitAlarak"; }
    return "";
}

string APRG_VorazunHeroType() {
    // The campaign hero is VorazunChampion. Bare "Vorazun" is not a reliable
    // unit id and can fall through into an unrelated random hero.
    if (CatalogEntryIsValid(c_gameCatalogUnit, "VorazunChampion")) { return "VorazunChampion"; }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "SMX2ProtossVorazun")) { return "SMX2ProtossVorazun"; }
    return "";
}

string APRG_HeroCandidate(int index) {
    if (index == 0) { return "RaynorCommando"; }
    if (index == 1) { return ""; }
    if (index == 2) { return "TychusCommando"; }
    if (index == 3) { return ""; }
    if (index == 4) { return ""; }
    if (index == 5) { return "Swann"; }
    if (index == 6) { return ""; }
    if (index == 7) { return "Zeratul"; }
    if (index == 8) { return "ZeratulVoid"; }
    if (index == 9) { return "ArtanisVoid"; }
    if (index == 10) { return APRG_AlarakHeroType(); }
    if (index == 11) { return APRG_AlarakHeroType(); }
    if (index == 12) { return APRG_AlarakHeroType(); }
    if (index == 13) { return "Mohandar"; }
    if (index == 14) { return "Selendis"; }
    if (index == 15) { return "Karax"; }
    if (index == 16) { return "KaraxChampion"; }
    if (index == 17) { return "ZaGara"; }
    if (index == 18) { return "Zagara"; }
    if (index == 19) { return "Dehaka"; }
    if (index == 20) { return "Nova"; }
    if (index == 21) { return ""; }
    if (index == 22) { return ""; }
    if (index == 23) { return "Tosh"; }
    if (index == 24) { return "Stukov"; }
    if (index == 25) { return "InfestedStukov"; }
    if (index == 26) { return "InfestedStukovCoop"; }
    if (index == 27) { return "Fenix"; }
    if (index == 28) { return "FenixChampion"; }
    if (index == 29) { return "FenixCoop"; }
    if (index == 30) { return APRG_VorazunHeroType(); }
    if (index == 31) { return "Stukov"; }
    if (index == 32) { return "Urun"; }
    if (index == 33) { return "Niadra"; }
    if (index == 34) { return "Karass"; }
    if (index == 35) { return "FenixKaldalisZealot"; }
    return "";
}

string APRG_HostileHeroFamilyKey(string heroType) {
    if (StringContains(heroType, "Raynor", c_stringAnywhere, c_stringNoCase)) { return "Raynor"; }
    if (StringContains(heroType, "Tychus", c_stringAnywhere, c_stringNoCase)) { return "Tychus"; }
    if (StringContains(heroType, "Swann", c_stringAnywhere, c_stringNoCase)) { return "Swann"; }
    if (StringContains(heroType, "Zeratul", c_stringAnywhere, c_stringNoCase)) { return "Zeratul"; }
    if (StringContains(heroType, "Artanis", c_stringAnywhere, c_stringNoCase)) { return "Artanis"; }
    if (StringContains(heroType, "Alarak", c_stringAnywhere, c_stringNoCase)) { return "Alarak"; }
    if (StringContains(heroType, "Karax", c_stringAnywhere, c_stringNoCase)) { return "Karax"; }
    if (StringContains(heroType, "Zagara", c_stringAnywhere, c_stringNoCase) || heroType == "ZaGara") { return "Zagara"; }
    if (StringContains(heroType, "Stukov", c_stringAnywhere, c_stringNoCase)) { return "Stukov"; }
    if (StringContains(heroType, "Fenix", c_stringAnywhere, c_stringNoCase)) { return "Fenix"; }
    return heroType;
}

