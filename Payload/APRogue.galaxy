    units = APRG_PlayerAllUnits(player);
    for (i = UnitGroupCount(units, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null || !UnitIsAlive(u)) { continue; }
        distance = DistanceBetweenPoints(origin, UnitGetPosition(u));
        if (distance > maxRange || distance >= bestDistance) { continue; }
        life = UnitGetPropertyFixed(u, c_unitPropLife, c_unitPropCurrent);
        lifeMax = UnitGetPropertyFixed(u, c_unitPropLifeMax, c_unitPropCurrent);
        shields = UnitGetPropertyFixed(u, c_unitPropShields, c_unitPropCurrent);
        shieldsMax = UnitGetPropertyFixed(u, c_unitPropShieldsMax, c_unitPropCurrent);
        if ((lifeMax > 0.0 && life < lifeMax - 0.5) || (shieldsMax > 0.0 && shields < shieldsMax - 0.5)) {
            best = u;
            bestDistance = distance;
        }
    }
    return best;
}

string APRG_AutonomousAbilityAlignment(string abilityType, int player) {
    if (abilityType == "" || !CatalogEntryIsValid(c_gameCatalogAbil, abilityType)) { return ""; }
    return CatalogFieldValueGet(c_gameCatalogAbil, abilityType, "Alignment", player);
}

bool APRG_AbilityUsesNativeAutocast(string abilityType, int owner) {
    if (abilityType == "" || !CatalogEntryIsValid(c_gameCatalogAbil, abilityType)) { return false; }
    return (
        CatalogFieldValueGet(c_gameCatalogAbil, abilityType, "Flags[AutoCast]", owner) == "1" ||
        CatalogFieldValueGet(c_gameCatalogAbil, abilityType, "Flags[AutoCastOn]", owner) == "1"
    );
}

bool APRG_AIHas(string abilityType, string token) {
    return abilityType != "" && StringContains(abilityType, token, c_stringAnywhere, c_stringNoCase);
}

int APRG_AutonomousAbilityCategory(string abilityType) {
    if (abilityType == "") { return APRG_AI_NONE; }

    if (
        APRG_AIHas(abilityType, "StasisWard") || APRG_AIHas(abilityType, "StasisTrap") ||
        APRG_AIHas(abilityType, "MassRecall") || APRG_AIHas(abilityType, "Recall") ||
        APRG_AIHas(abilityType, "Nuke") || APRG_AIHas(abilityType, "Calldown") ||
        APRG_AIHas(abilityType, "CarrierHangar") || APRG_AIHas(abilityType, "Interceptor") ||
        APRG_AIHas(abilityType, "Scarabs") || APRG_AIHas(abilityType, "Train") ||
        APRG_AIHas(abilityType, "Research") ||
        APRG_AIHas(abilityType, "Merge") || APRG_AIHas(abilityType, "Rally") ||
        APRG_AIHas(abilityType, "Transport") || APRG_AIHas(abilityType, "Load") || APRG_AIHas(abilityType, "Unload")
    ) { return APRG_AI_NONE; }

    if (APRG_AIHas(abilityType, "Cloak") || APRG_AIHas(abilityType, "Cloaking")) { return APRG_AI_CLOAK; }

    if (APRG_AIHas(abilityType, "TacticalJump") || APRG_AIHas(abilityType, "Blink")) { return APRG_AI_MOBILITY; }

    if (
        APRG_AIHas(abilityType, "MindControl") || APRG_AIHas(abilityType, "Domination") ||
        APRG_AIHas(abilityType, "Neural") || APRG_AIHas(abilityType, "ParasiticDomination") ||
        APRG_AIHas(abilityType, "Reclamation")
    ) { return APRG_AI_CAPTURE; }

    if (APRG_AIHas(abilityType, "Consume") || APRG_AIHas(abilityType, "Consumption") || APRG_AIHas(abilityType, "Sacrifice")) { return APRG_AI_CONSUME; }

    if (APRG_AIHas(abilityType, "Revelation") || APRG_AIHas(abilityType, "OcularSymbiote")) { return APRG_AI_REVEAL; }

    if (APRG_AIHas(abilityType, "HealingDrone") || APRG_AIHas(abilityType, "RepairDrone")) { return APRG_AI_HEAL_SUMMON; }
    if (
        APRG_AIHas(abilityType, "Transfus") || APRG_AIHas(abilityType, "Mend") ||
        APRG_AIHas(abilityType, "Restore") || APRG_AIHas(abilityType, "ShieldRecharge")
    ) { return APRG_AI_HEAL; }

    if (APRG_AIHas(abilityType, "DefensiveMatrix") || APRG_AIHas(abilityType, "ProtectiveShield")) { return APRG_AI_DEFENSIVE_TARGET; }
    if (
        APRG_AIHas(abilityType, "GuardianShield") || APRG_AIHas(abilityType, "DarkSwarm") ||
        APRG_AIHas(abilityType, "MicrobialShroud") || APRG_AIHas(abilityType, "PointDefenseDrone") ||
        APRG_AIHas(abilityType, "DefensiveDrone")
    ) { return APRG_AI_DEFENSIVE_AREA; }

    if (APRG_AIHas(abilityType, "IonicForceField") || APRG_AIHas(abilityType, "Barrier")) { return APRG_AI_REACTIVE; }
    if (
        APRG_AIHas(abilityType, "Stim") || APRG_AIHas(abilityType, "Frenzy") ||
        APRG_AIHas(abilityType, "Prismatic") || APRG_AIHas(abilityType, "DamageBoost") ||
        APRG_AIHas(abilityType, "Overcharge") || APRG_AIHas(abilityType, "DehakaMirrorImage")
    ) { return APRG_AI_SELF_BUFF; }
    if (APRG_AIHas(abilityType, "DehakaHeal")) { return APRG_AI_REACTIVE; }

    if (APRG_AIHas(abilityType, "Abduct") || APRG_AIHas(abilityType, "Grapple") || APRG_AIHas(abilityType, "Drag")) { return APRG_AI_FORCED_MOVE; }
    if (APRG_AIHas(abilityType, "LockOn") || APRG_AIHas(abilityType, "GravitonBeam")) { return APRG_AI_CHANNEL; }

    if (
        APRG_AIHas(abilityType, "Irradiate") || APRG_AIHas(abilityType, "Plague") ||
        APRG_AIHas(abilityType, "ParasiticBomb") || APRG_AIHas(abilityType, "Disintegration") ||
        APRG_AIHas(abilityType, "LightningBomb")
    ) { return APRG_AI_DOT; }

    if (APRG_AIHas(abilityType, "Feedback") || APRG_AIHas(abilityType, "EMP")) { return APRG_AI_ANTI_CASTER; }
    if (
        APRG_AIHas(abilityType, "Lockdown") || APRG_AIHas(abilityType, "Scrambler") ||
        APRG_AIHas(abilityType, "InterferenceMatrix") || APRG_AIHas(abilityType, "VoidStasis") ||
        APRG_AIHas(abilityType, "Stun")
    ) { return APRG_AI_DISABLE; }

    if (
        APRG_AIHas(abilityType, "AntiArmor") || APRG_AIHas(abilityType, "ShredderMissile") ||
        APRG_AIHas(abilityType, "Corruption") || APRG_AIHas(abilityType, "OpticalFlare") ||
        APRG_AIHas(abilityType, "DetectWeakness")
    ) { return APRG_AI_DEBUFF; }

    if (APRG_AIHas(abilityType, "SpiderMine")) { return APRG_AI_TRAP; }
    if (APRG_AIHas(abilityType, "HoloDecoy") || APRG_AIHas(abilityType, "Hallucination")) { return APRG_AI_DECOY; }
    if (
        APRG_AIHas(abilityType, "AutoTurret") || APRG_AIHas(abilityType, "RailGunTurret") ||
        APRG_AIHas(abilityType, "InfestedTerran") || APRG_AIHas(abilityType, "SpawnBaneling") ||
        APRG_AIHas(abilityType, "SpawnBroodling") || APRG_AIHas(abilityType, "BroodlingSpawn") ||
        APRG_AIHas(abilityType, "SpawnLocust") || APRG_AIHas(abilityType, "LocustLaunch") || APRG_AIHas(abilityType, "LocustFlyingLaunch") ||
        (APRG_AIHas(abilityType, "Flaming") || APRG_AIHas(abilityType, "Betty"))
    ) { return APRG_AI_SUMMON; }

    if (APRG_AIHas(abilityType, "ForceField")) { return APRG_AI_NONE; } // bad automated walls are worse than no cast
    if (APRG_AIHas(abilityType, "DisruptionWeb") || APRG_AIHas(abilityType, "BlindingCloud")) { return APRG_AI_AREA_DENIAL; }
    if (
        APRG_AIHas(abilityType, "Fungal") || APRG_AIHas(abilityType, "Ensnare") ||
        APRG_AIHas(abilityType, "FlashBang") || APRG_AIHas(abilityType, "CrushingGrip") ||
        APRG_AIHas(abilityType, "Ultrasonic") || APRG_AIHas(abilityType, "Maelstrom") ||
        APRG_AIHas(abilityType, "TimeWarp")
    ) { return APRG_AI_AOE_CONTROL; }
    if (
        APRG_AIHas(abilityType, "PsiStorm") || APRG_AIHas(abilityType, "PsionicStorm") ||
        APRG_AIHas(abilityType, "SeekerMissile") || APRG_AIHas(abilityType, "MissilePods") ||
        APRG_AIHas(abilityType, "ClusterBomb") || APRG_AIHas(abilityType, "Clusterbomb") ||
        APRG_AIHas(abilityType, "CorrosiveBile") || APRG_AIHas(abilityType, "PsionicOrb") ||
        APRG_AIHas(abilityType, "DestructionWave") || APRG_AIHas(abilityType, "AreaBlast")
    ) { return APRG_AI_AOE_DAMAGE; }

    if (APRG_AIHas(abilityType, "Penetrating") || APRG_AIHas(abilityType, "LineAttack") || APRG_AIHas(abilityType, "Laser")) { return APRG_AI_LINE; }
    if (APRG_AIHas(abilityType, "PurificationNova") || APRG_AIHas(abilityType, "NovaLaunch") || APRG_AIHas(abilityType, "CorrosiveBile")) { return APRG_AI_DELAYED; }

    if (APRG_AIHas(abilityType, "Vortex") || APRG_AIHas(abilityType, "BlackHole") || APRG_AIHas(abilityType, "Apocalypse")) { return APRG_AI_ULTIMATE; }

    if (
        APRG_AIHas(abilityType, "Snipe") || APRG_AIHas(abilityType, "PsionicLash") ||
        APRG_AIHas(abilityType, "MindBlast") || APRG_AIHas(abilityType, "Yamato") ||
        APRG_AIHas(abilityType, "KineticBlast") || APRG_AIHas(abilityType, "ShadowCannon") ||
        APRG_AIHas(abilityType, "Obliterate") || APRG_AIHas(abilityType, "250mm") ||
        APRG_AIHas(abilityType, "330mm")
    ) { return APRG_AI_BURST; }
    if (APRG_AIHas(abilityType, "LeapingStrike") || APRG_AIHas(abilityType, "BurrowCharge") || APRG_AIHas(abilityType, "DashAttack")) { return APRG_AI_BURST; }

    if (APRG_AIHas(abilityType, "ChronoBeam") || APRG_AIHas(abilityType, "Acceleration")) { return APRG_AI_SUPPORT; }

    return APRG_AI_NONE;
}

int APRG_AutonomousAbilityCategoryCached(string abilityType) {
    string key;
    int cached;
    int category;
    if (abilityType == "") { return APRG_AI_NONE; }
    key = "APRG_AICategory_" + abilityType;
    cached = DataTableGetInt(true, key);
    if (cached > 0) { return cached - 1; }
    category = APRG_AutonomousAbilityCategory(abilityType);
    DataTableSetInt(true, key, category + 1);
    return category;
}

bool APRG_AbilityUsesNativeAutocastCached(string abilityType, int owner) {
    string key;
    int cached;
    bool nativeAutocast;
    if (abilityType == "") { return false; }
    key = "APRG_AIAutocast_" + IntToString(owner) + "_" + abilityType;
    cached = DataTableGetInt(true, key);
    if (cached > 0) { return cached == 2; }
    nativeAutocast = APRG_AbilityUsesNativeAutocast(abilityType, owner);
    if (nativeAutocast) { DataTableSetInt(true, key, 2); }
    else { DataTableSetInt(true, key, 1); }
    return nativeAutocast;
}

bool APRG_IsAutonomousCloakAbility(string abilityType) {
    return APRG_AutonomousAbilityCategoryCached(abilityType) == APRG_AI_CLOAK;
}

bool APRG_AutonomousCloakReady(unit caster) {
    fixed energy;
    fixed maximum;
    if (caster == null || UnitTestState(caster, c_unitStateCloaked)) { return false; }
    energy = UnitGetPropertyFixed(caster, c_unitPropEnergy, c_unitPropCurrent);
    maximum = UnitGetPropertyFixed(caster, c_unitPropEnergyMax, c_unitPropCurrent);
    return maximum > 0.0 && energy >= maximum - 0.5;
}

fixed APRG_AutonomousAbilityRange(string abilityType, int owner) {
    fixed range;
    if (abilityType == "" || !CatalogEntryIsValid(c_gameCatalogAbil, abilityType)) { return 14.0; }
    range = StringToFixed(CatalogFieldValueGet(c_gameCatalogAbil, abilityType, "Range", owner));
    if (range <= 0.0) { return 14.0; }
    return range + 2.0;
}

fixed APRG_AICategoryRepeatDelay(int category) {
    if (category == APRG_AI_SUMMON || category == APRG_AI_TRAP || category == APRG_AI_DECOY || category == APRG_AI_ULTIMATE || category == APRG_AI_CAPTURE) { return 8.0; }
    if (category == APRG_AI_AOE_DAMAGE || category == APRG_AI_AOE_CONTROL || category == APRG_AI_AREA_DENIAL || category == APRG_AI_DOT || category == APRG_AI_DISABLE || category == APRG_AI_DEBUFF) { return 3.0; }
    return 2.0;
}

bool APRG_AICastThrottleReady(unit caster, string abilityType, int category) {
    string key;
    fixed last;
    if (caster == null || abilityType == "") { return false; }
    key = "APRG_AICast_" + IntToString(UnitGetTag(caster)) + "_" + abilityType;
    last = DataTableGetFixed(true, key);
    if (last > 0.0 && GameGetMissionTime() - last < APRG_AICategoryRepeatDelay(category)) { return false; }
    return true;
}

void APRG_RecordAICast(unit caster, string abilityType) {
    if (caster == null || abilityType == "") { return; }
    DataTableSetFixed(true, "APRG_AICast_" + IntToString(UnitGetTag(caster)) + "_" + abilityType, GameGetMissionTime());
}

unitgroup APRG_AIOpposingTargetsNear(unit caster, int player, bool friendlyToPlayer, fixed radius) {
    unitgroup result;
    point origin;
    int i;
    unit u;
    if (caster == null) { return UnitGroupEmpty(); }
    if (radius < 1.0) { radius = 1.0; }
    origin = UnitGetPosition(caster);
    if (friendlyToPlayer) {
        result = UnitGroupAlliance(
            player, c_unitAllianceEnemy, RegionCircle(origin, radius),
            UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)) | (1 << (c_targetFilterInvulnerable - 32))), 0
        );
    }
    else {
        result = UnitGroup(
            null, player, RegionCircle(origin, radius),
            UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)) | (1 << (c_targetFilterInvulnerable - 32))), 0
        );
    }
    for (i = UnitGroupCount(result, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(result, i);
        if (u != null && (UnitTestState(u, c_unitStateInvulnerable) || APRG_IsCreepTumorType(UnitGetType(u)) || APRG_IsRakShirObjectiveUnit(u))) { UnitGroupRemove(result, u); }
    }
    return result;
}

unit APRG_AIClosestOpposingTarget(unit caster, int player, bool friendlyToPlayer) {
    unitgroup targets;
    if (caster == null) { return null; }
    targets = APRG_AIOpposingTargetsNear(caster, player, friendlyToPlayer, 24.0);
    return UnitGroupClosestToPoint(targets, UnitGetPosition(caster));
}

bool APRG_AIEnemyWithinNine(unit caster, int player, bool friendlyToPlayer) {
    unitgroup targets;
    if (caster == null) { return false; }
    targets = APRG_AIOpposingTargetsNear(caster, player, friendlyToPlayer, 9.0);
    return UnitGroupCount(targets, c_unitCountAlive) > 0;
}

unit APRG_AINearestFriendlyTarget(unit caster, int player, bool friendlyToPlayer, fixed range) {
    if (friendlyToPlayer) { return APRG_NearestFriendlyAbilityTarget(caster, player, range); }
    return APRG_NearestOwnedInjuredAbilityTarget(caster, range);
}

unit APRG_TryAutonomousOffensiveOrder(unit caster, unitgroup candidates, string abilityType, int commandIndex) {
    unit target;
    point origin;
    order castOrder;
    fixed maxRange;
    fixed distance;
    int attempted;
    if (caster == null || candidates == null || abilityType == "") { return null; }
    origin = UnitGetPosition(caster);
    maxRange = APRG_AutonomousAbilityRange(abilityType, UnitGetOwner(caster));
    attempted = 0;
    while (UnitGroupCount(candidates, c_unitCountAlive) > 0 && attempted < 32) {
        target = UnitGroupClosestToPoint(candidates, origin);
        if (target == null) { break; }
        UnitGroupRemove(candidates, target);
        attempted += 1;
        if (!UnitIsAlive(target)) { continue; }
        distance = DistanceBetweenPoints(origin, UnitGetPosition(target));
        if (distance > maxRange) { break; }
        castOrder = OrderTargetingUnit(AbilityCommand(abilityType, commandIndex), target);
        if (UnitOrderIsValid(caster, castOrder)) {
            UnitIssueOrder(caster, castOrder, c_orderQueueReplace);
            return target;
        }
        castOrder = OrderTargetingPoint(AbilityCommand(abilityType, commandIndex), UnitGetPosition(target));
        if (UnitOrderIsValid(caster, castOrder)) {
            UnitIssueOrder(caster, castOrder, c_orderQueueReplace);
            return target;
        }
    }
    return null;
}

bool APRG_TryAutonomousPointOrder(unit caster, string abilityType, int commandIndex, point targetPoint) {
    order castOrder;
    if (caster == null || targetPoint == null) { return false; }
    castOrder = OrderTargetingPoint(AbilityCommand(abilityType, commandIndex), targetPoint);
    if (!UnitOrderIsValid(caster, castOrder)) { return false; }
    UnitIssueOrder(caster, castOrder, c_orderQueueReplace);
    return true;
}

// Slay's mutation and boon Purifiers must cast Vortex only at visible,
// living enemy units.  The generic spellcaster target list also contains
// structures, which are inappropriate Vortex targets.  Do not let a failed
// unit search fall through to the generic nearest-building point fallback.
bool APRG_TrySlayPurifierVortex(unit purifier, int player, bool friendlyToPlayer) {
    unitgroup targets;
    unit target;
    point origin;
    order previousOrder;
    bool hadPreviousOrder;
    int i;
    int commandIndex;
    int examined = 0;
    int owner;
    string abilityType = "VortexPurifier";
    if (purifier == null || !UnitIsAlive(purifier)) { return false; }
    if (purifier != g_aprgPurifier && purifier != g_aprgPurifierAlliance) { return false; }
    if (!UnitAbilityExists(purifier, abilityType) || !APRG_AICastThrottleReady(purifier, abilityType, APRG_AI_ULTIMATE)) { return false; }
    owner = UnitGetOwner(purifier);
    origin = UnitGetPosition(purifier);
    // The campaign VortexPurifier ability has a native range of 10.
    // Require the actual caster owner's vision, not just proximity.
    targets = APRG_AIOpposingTargetsNear(purifier, player, friendlyToPlayer, 10.0);
    for (i = UnitGroupCount(targets, c_unitCountAlive); i > 0; i -= 1) {
        target = UnitGroupUnitFromEnd(targets, i);
        if (target == null) { continue; }
        if (!UnitIsAlive(target) ||
            UnitTypeTestAttribute(UnitGetType(target), c_unitAttributeStructure) ||
            !libNtve_gf_UnitIsVisibleToPlayer(target, owner)) {
            UnitGroupRemove(targets, target);
        }
    }
    // No valid visible enemy units means no Vortex, even if enemy
    // buildings are within range.  Preserve the previous combat order.
    if (UnitGroupCount(targets, c_unitCountAlive) <= 0) { return false; }
    hadPreviousOrder = UnitOrderCount(purifier) > 0;
    if (hadPreviousOrder) { previousOrder = UnitOrder(purifier, 0); }
    while (UnitGroupCount(targets, c_unitCountAlive) > 0 && examined < 24) {
        target = UnitGroupClosestToPoint(targets, origin);
        if (target == null) { break; }
        UnitGroupRemove(targets, target);
        examined += 1;
        if (!UnitIsAlive(target) ||
            UnitTypeTestAttribute(UnitGetType(target), c_unitAttributeStructure) ||
            !libNtve_gf_UnitIsVisibleToPlayer(target, owner)) { continue; }
        if (DistanceBetweenPoints(origin, UnitGetPosition(target)) > 10.0) { continue; }
        for (commandIndex = 0; commandIndex < 4; commandIndex += 1) {
            if (APRG_TryAutonomousPointOrder(purifier, abilityType, commandIndex, UnitGetPosition(target))) {
                APRG_QueuePriorAutonomousOrder(purifier, previousOrder, hadPreviousOrder);
                APRG_RecordAICast(purifier, abilityType);
                return true;
            }
        }
    }
    return false;
}

bool APRG_TrySwannFlamingBetty(unit swann, int player) {
    string unitType;
    string key;
    string abilityType;
    fixed now;
    fixed last;
    point origin;
    point castPoint;
    unitgroup nearbyTargets;
    unitgroup created;
    unit betty;
    int abilityIndex;
    int abilityCount;
    int commandIndex;
    int pointAttempt;
    bool hadPriorOrder;
    order priorOrder;
    if (swann == null || !UnitIsAlive(swann)) { return false; }
    hadPriorOrder = UnitOrderCount(swann) > 0;
    if (hadPriorOrder) { priorOrder = UnitOrder(swann, 0); }
    unitType = UnitGetType(swann);
    if (!StringContains(unitType, "Swann", c_stringAnywhere, c_stringNoCase)) { return false; }

    now = GameGetMissionTime();
    key = "APRG_SwannBetty_" + IntToString(UnitGetTag(swann));
    last = DataTableGetFixed(true, key);
    // Native Place Flaming Betty has a 44-second cooldown and a 45-second life.
    // Keep the same cadence even if we have to use the catalog fallback below.
    if (last > 0.0 && now - last < 44.0) { return false; }
    nearbyTargets = APRG_AIOpposingTargetsNear(swann, player, false, 16.0);
    if (UnitGroupCount(nearbyTargets, c_unitCountAlive) <= 0) { return false; }

    origin = UnitGetPosition(swann);
    abilityCount = MinI(64, UnitAbilityCount(swann));
    for (abilityIndex = 1; abilityIndex <= abilityCount; abilityIndex += 1) {
        abilityType = UnitAbilityGet(swann, abilityIndex);
        if (
            !StringContains(abilityType, "Flaming", c_stringAnywhere, c_stringNoCase) &&
            !StringContains(abilityType, "Betty", c_stringAnywhere, c_stringNoCase)
        ) { continue; }
        for (commandIndex = 0; commandIndex < 4; commandIndex += 1) {
            for (pointAttempt = 0; pointAttempt < 12; pointAttempt += 1) {
                castPoint = PointWithOffsetPolar(origin, RandomFixed(2.0, 5.0), libNtve_gf_RandomAngle());
                if (castPoint == null || !RegionContainsPoint(RegionPlayableMap(), castPoint) || !PointPathingPassable(castPoint)) { continue; }
                if (APRG_TryAutonomousPointOrder(swann, abilityType, commandIndex, castPoint)) {
                    APRG_QueuePriorAutonomousOrder(swann, priorOrder, hadPriorOrder);
                    DataTableSetFixed(true, key, now);
                    APRG_RecordAICast(swann, abilityType);
                    return true;
                }
            }
        }
    }

    // Some dependency combinations expose Rory Swann but not a usable command
    // for Place Flaming Betty. In that case reproduce the native result rather
    // than silently leaving the hero without his signature ability.
    if (!CatalogEntryIsValid(c_gameCatalogUnit, "FlamingBetty")) { return false; }
    for (pointAttempt = 0; pointAttempt < 12; pointAttempt += 1) {
        castPoint = PointWithOffsetPolar(origin, RandomFixed(2.0, 5.0), libNtve_gf_RandomAngle());
        if (castPoint == null || !RegionContainsPoint(RegionPlayableMap(), castPoint) || !PointPathingPassable(castPoint)) { continue; }
        created = UnitCreate(1, "FlamingBetty", c_unitCreateIgnorePlacement, UnitGetOwner(swann), castPoint, libNtve_gf_RandomAngle());
        betty = UnitGroupUnitFromEnd(created, 1);
        if (betty == null) { continue; }
        APRG_RegisterMutationEnemyGroup(created);
        if (CatalogEntryIsValid(c_gameCatalogBehavior, "AutoTurretTimedLife")) {
            UnitBehaviorAdd(betty, "AutoTurretTimedLife", betty, 1);
            UnitBehaviorSetDuration(betty, "AutoTurretTimedLife", 45.0);
            UnitBehaviorSetDurationRemaining(betty, "AutoTurretTimedLife", 45.0);
        }
        DataTableSetFixed(true, key, now);
        return true;
    }
    return false;
}

bool APRG_TryAutonomousUnitOrder(unit caster, string abilityType, int commandIndex, unit target) {
    order castOrder;
    if (caster == null || target == null || !UnitIsAlive(target)) { return false; }
    castOrder = OrderTargetingUnit(AbilityCommand(abilityType, commandIndex), target);
    if (!UnitOrderIsValid(caster, castOrder)) { return false; }
    UnitIssueOrder(caster, castOrder, c_orderQueueReplace);
    return true;
}

bool APRG_TryAttackDeploymentPosture(unit caster, int player, bool friendlyToPlayer) {
    string unitType;
    string abilityType;
    string key;
    int i;
    int commandIndex;
    unit enemy;
    fixed now;
    fixed since;
    fixed repositionUntil;
    order postureOrder;
    bool buried;
    if (caster == null || !UnitIsAlive(caster)) { return false; }
    unitType = UnitGetType(caster);
    if (
        !APRG_AIHas(unitType, "Lurker") && !APRG_AIHas(unitType, "Impaler") &&
        !APRG_AIHas(unitType, "WidowMine") && !APRG_AIHas(unitType, "SwarmHost")
    ) { return false; }
    now = GameGetMissionTime();
    key = "APRG_Posture_" + IntToString(UnitGetTag(caster));
    buried = UnitTestState(caster, c_unitStateBuried) || APRG_AIHas(unitType, "Burrowed") || APRG_AIHas(unitType, "Rooted");
    since = DataTableGetFixed(true, key + "_Since");
    repositionUntil = DataTableGetFixed(true, key + "_MoveUntil");
    enemy = APRG_AIClosestOpposingTarget(caster, player, friendlyToPlayer);

    if (buried && since > 0.0 && now - since >= 10.0) {
        for (i = 1; i <= UnitAbilityCount(caster); i += 1) {
            abilityType = UnitAbilityGet(caster, i);
            if (
                !APRG_AIHas(abilityType, "Burrow") && !APRG_AIHas(abilityType, "Unburrow") &&
                !APRG_AIHas(abilityType, "Uproot") && !APRG_AIHas(abilityType, "Unroot")
            ) { continue; }
            for (commandIndex = 0; commandIndex < 4; commandIndex += 1) {
                postureOrder = Order(AbilityCommand(abilityType, commandIndex));
                if (!UnitOrderIsValid(caster, postureOrder)) { continue; }
                UnitIssueOrder(caster, postureOrder, c_orderQueueReplace);
                DataTableSetFixed(true, key + "_Since", 0.0);
                DataTableSetFixed(true, key + "_MoveUntil", now + 4.0);
                if (enemy != null) { UnitIssueOrder(caster, OrderTargetingPoint(AbilityCommand("attack", 0), UnitGetPosition(enemy)), c_orderQueueAddToEnd); }
                return true;
            }
        }
    }
    if (!buried && now >= repositionUntil && enemy != null && DistanceBetweenPoints(UnitGetPosition(caster), UnitGetPosition(enemy)) <= 9.0) {
        for (i = 1; i <= UnitAbilityCount(caster); i += 1) {
            abilityType = UnitAbilityGet(caster, i);
            if (
                !APRG_AIHas(abilityType, "Burrow") && !APRG_AIHas(abilityType, "Root") &&
                !APRG_AIHas(abilityType, "Deploy")
            ) { continue; }
            for (commandIndex = 0; commandIndex < 4; commandIndex += 1) {
                postureOrder = Order(AbilityCommand(abilityType, commandIndex));
                if (!UnitOrderIsValid(caster, postureOrder)) { continue; }
                UnitIssueOrder(caster, postureOrder, c_orderQueueReplace);
                DataTableSetFixed(true, key + "_Since", now);
                return true;
            }
        }
    }
    if (buried && since <= 0.0) { DataTableSetFixed(true, key + "_Since", now); }
    return false;
}

bool APRG_TryLowHpRetreatMobility(unit caster, int player, string abilityType, int commandIndex, bool friendlyToPlayer) {
    fixed life;
    fixed lifeMax;
    unit home;
    order castOrder;
    if (!friendlyToPlayer || caster == null) { return false; }
    life = UnitGetPropertyFixed(caster, c_unitPropLife, c_unitPropCurrent);
    lifeMax = UnitGetPropertyFixed(caster, c_unitPropLifeMax, c_unitPropCurrent);
    if (lifeMax <= 0.0 || life / lifeMax > 0.20) { return false; }
    home = APRG_FindPlayerHomeStructure(player);
    if (home == null) { return false; }
    castOrder = OrderTargetingPoint(AbilityCommand(abilityType, commandIndex), UnitGetPosition(home));
    if (!UnitOrderIsValid(caster, castOrder)) { return false; }
    UnitIssueOrder(caster, castOrder, c_orderQueueReplace);
    return true;
}

bool APRG_TryConsumeAbility(unit caster, int player, bool friendlyToPlayer, string abilityType, int commandIndex) {
    unitgroup candidates;
    unit target;
    point origin;
    fixed energy;
    fixed maxEnergy;
    int attempted;
    if (caster == null) { return false; }
    energy = UnitGetPropertyFixed(caster, c_unitPropEnergy, c_unitPropCurrent);
    maxEnergy = UnitGetPropertyFixed(caster, c_unitPropEnergyMax, c_unitPropCurrent);
    if (maxEnergy <= 0.0 || energy / maxEnergy > 0.35) { return false; }
    origin = UnitGetPosition(caster);
    if (friendlyToPlayer) { candidates = APRG_PlayerAllUnits(player); }
    else { candidates = UnitGroup(null, UnitGetOwner(caster), RegionCircle(origin, 10.0), UnitFilter(0,0,(1 << c_targetFilterMissile),(1 << (c_targetFilterDead - 32))),0); }
    attempted = 0;
    while (UnitGroupCount(candidates, c_unitCountAlive) > 0 && attempted < 24) {
        target = UnitGroupClosestToPoint(candidates, origin);
        if (target == null) { break; }
        UnitGroupRemove(candidates, target);
        attempted += 1;
        if (target == caster || !UnitIsAlive(target)) { continue; }
        if (UnitTypeTestAttribute(UnitGetType(target), c_unitAttributeHeroic)) { continue; }
        if (APRG_TryAutonomousUnitOrder(caster, abilityType, commandIndex, target)) { return true; }
    }
    return false;
}

void APRG_QueuePriorAutonomousOrder(unit caster, order priorOrder, bool hadPriorOrder) {
    if (!hadPriorOrder || caster == null || !UnitIsAlive(caster)) { return; }
    if (!UnitOrderIsValid(caster, priorOrder)) { return; }
    UnitIssueOrder(caster, priorOrder, c_orderQueueAddToEnd);
}

// All Slay-controlled High Templar use this before the generic ability scan.
// Mass Spellcasters and Specialists otherwise miss storms while moving toward
// distant bases, or cast Feedback before trying a valid multi-unit Psi Storm.
bool APRG_TryHighTemplarStorm(unit caster, int player, bool friendlyToPlayer, order priorOrder, bool hadPriorOrder) {
    int a;
    int commandIndex;
    int i;
    int j;
    int score;
    int bestScore;
    int count;
    string abilityType;
    string unitType;
    unitgroup targets;
    unit candidate;
    unit other;
    point candidatePoint;
    point bestPoint;
    point origin;
    fixed range;
    fixed distance;
    fixed bestNearest;
    fixed last;
    string cooldownKey;
    if (caster == null || !UnitIsAlive(caster)) { return false; }
    unitType = UnitGetType(caster);
    if (!StringContains(unitType, "HighTemplar", c_stringAnywhere, c_stringNoCase) &&
        !StringContains(unitType, "Signifier", c_stringAnywhere, c_stringNoCase)) { return false; }
    cooldownKey = "APRG_TemplarStorm_" + IntToString(UnitGetTag(caster));
    last = DataTableGetFixed(true, cooldownKey);
    if (last > 0.0 && GameGetMissionTime() - last < 1.5) { return false; }
    origin = UnitGetPosition(caster);
    for (a = 1; a <= MinI(64, UnitAbilityCount(caster)); a += 1) {
        abilityType = UnitAbilityGet(caster, a);
        if (!APRG_AIHas(abilityType, "PsiStorm") &&
            !APRG_AIHas(abilityType, "PsionicStorm")) { continue; }
        // The native Storm is 9 range; honor smaller catalog variants and do
        // not search beyond 10 to avoid futile orders on out-of-range enemies.
        range = MinF(10.0, APRG_AutonomousAbilityRange(abilityType, UnitGetOwner(caster)));
        targets = APRG_AIOpposingTargetsNear(caster, player, friendlyToPlayer, range);
        count = MinI(24, UnitGroupCount(targets, c_unitCountAlive));
        if (count <= 0) { continue; }
        // Target actual enemy concentrations rather than the nearest enemy by
        // itself. Even a single nearby target qualifies if no cluster exists.
        bestPoint = null;
        bestScore = -1;
        bestNearest = 999.0;
        for (i = 1; i <= count; i += 1) {
            candidate = UnitGroupUnitFromEnd(targets, i);
            if (candidate == null || !UnitIsAlive(candidate)) { continue; }
            candidatePoint = UnitGetPosition(candidate);
            distance = DistanceBetweenPoints(origin, candidatePoint);
            if (distance > range) { continue; }
            score = 0;
            for (j = 1; j <= count; j += 1) {
                other = UnitGroupUnitFromEnd(targets, j);
                if (other != null && UnitIsAlive(other) &&
                    DistanceBetweenPoints(candidatePoint, UnitGetPosition(other)) <= 2.5) { score += 1; }
            }
            if (score > bestScore || (score == bestScore && distance < bestNearest)) {
                bestPoint = candidatePoint;
                bestScore = score;
                bestNearest = distance;
            }
        }
        if (bestPoint == null) { continue; }
        for (commandIndex = 0; commandIndex < 4; commandIndex += 1) {
            if (APRG_TryAutonomousPointOrder(caster, abilityType, commandIndex, bestPoint)) {
                APRG_QueuePriorAutonomousOrder(caster, priorOrder, hadPriorOrder);
                DataTableSetFixed(true, cooldownKey, GameGetMissionTime());
                APRG_RecordAICast(caster, abilityType);
                return true;
            }
        }
    }
    return false;
}

bool APRG_TryCategorizedAutonomousAbility(unit caster, int player, bool friendlyToPlayer) {
    int abilityIndex;
    int abilityCount;
    int commandIndex;
    int category;
    string abilityType;
    unit enemyTarget;
    unit friendlyTarget;
    unit offensiveTarget;
    unitgroup offensiveTargets;
    order castOrder;
    point castPoint;
    point casterPoint;
    int pointAttempt;
    fixed life;
    fixed lifeMax;
    bool inCombat;
    bool hadPriorOrder;
    order priorOrder;
    if (caster == null || !UnitIsAlive(caster)) { return false; }
    // Covert Assistance Tosh's reactive matrix/Psi Shield is issued by his
    // dedicated tick. This shared caster must never drain his shield reserve.
    // 200 energy leaves >=100 after any 100-energy offensive cast.
    if ((caster == g_aprgCovertTosh || caster == g_aprgTosh) &&
        UnitGetPropertyFixed(caster, c_unitPropEnergy, c_unitPropCurrent) < 200.0) { return false; }

    // Preserve the roaming/attack-move objective across opportunistic casts.
    // This is what lets scripted units use abilities without forgetting where
    // they were going and standing idle after the cast finishes.
    hadPriorOrder = UnitOrderCount(caster) > 0;
    if (hadPriorOrder) { priorOrder = UnitOrder(caster, 0); }

    if (APRG_TryAttackDeploymentPosture(caster, player, friendlyToPlayer)) { return true; }
    // Prioritize storm even if native autocast is enabled for this ability.
    if (APRG_TryHighTemplarStorm(caster, player, friendlyToPlayer, priorOrder, hadPriorOrder)) { return true; }
    if (APRG_TrySlayPurifierVortex(caster, player, friendlyToPlayer)) { return true; }

    enemyTarget = APRG_AIClosestOpposingTarget(caster, player, friendlyToPlayer);
    inCombat = enemyTarget != null;
    abilityCount = MinI(96, UnitAbilityCount(caster));
    for (abilityIndex = 1; abilityIndex <= abilityCount; abilityIndex += 1) {
        abilityType = UnitAbilityGet(caster, abilityIndex);
        if (abilityType == "") { continue; }
        // Slay Purifiers use a unit-only Vortex selector above.  Never
        // retry their Vortex on the generic structure/point target pool.
        if ((caster == g_aprgPurifier || caster == g_aprgPurifierAlliance) &&
            APRG_AIHas(abilityType, "Vortex")) { continue; }
        if (APRG_AbilityUsesNativeAutocastCached(abilityType, UnitGetOwner(caster))) { continue; }
        category = APRG_AutonomousAbilityCategoryCached(abilityType);
        if (category == APRG_AI_NONE || !APRG_AICastThrottleReady(caster, abilityType, category)) { continue; }

        for (commandIndex = 0; commandIndex < 4; commandIndex += 1) {
            if (category == APRG_AI_CLOAK) {
                if (!inCombat || !APRG_AutonomousCloakReady(caster)) { break; }
                castOrder = Order(AbilityCommand(abilityType, commandIndex));
                if (UnitOrderIsValid(caster, castOrder)) { UnitIssueOrder(caster, castOrder, c_orderQueueReplace); APRG_QueuePriorAutonomousOrder(caster, priorOrder, hadPriorOrder); APRG_RecordAICast(caster, abilityType); return true; }
                break; // never probe an Off command
            }
            if (category == APRG_AI_MOBILITY) {
                if (APRG_TryLowHpRetreatMobility(caster, player, abilityType, commandIndex, friendlyToPlayer)) { APRG_RecordAICast(caster, abilityType); return true; }
                continue;
            }
            if (category == APRG_AI_REACTIVE) {
                life = UnitGetPropertyFixed(caster, c_unitPropLife, c_unitPropCurrent);
                lifeMax = UnitGetPropertyFixed(caster, c_unitPropLifeMax, c_unitPropCurrent);
                if (lifeMax > 0.0 && life / lifeMax > 0.65) { continue; }
                castOrder = Order(AbilityCommand(abilityType, commandIndex));
                if (UnitOrderIsValid(caster, castOrder)) { UnitIssueOrder(caster, castOrder, c_orderQueueReplace); APRG_QueuePriorAutonomousOrder(caster, priorOrder, hadPriorOrder); APRG_RecordAICast(caster, abilityType); return true; }
                continue;
            }
            if (category == APRG_AI_SELF_BUFF) {
                if (!inCombat) { continue; }
                castOrder = Order(AbilityCommand(abilityType, commandIndex));
                if (UnitOrderIsValid(caster, castOrder)) { UnitIssueOrder(caster, castOrder, c_orderQueueReplace); APRG_QueuePriorAutonomousOrder(caster, priorOrder, hadPriorOrder); APRG_RecordAICast(caster, abilityType); return true; }
                continue;
            }
            if (category == APRG_AI_HEAL || category == APRG_AI_DEFENSIVE_TARGET || category == APRG_AI_SUPPORT || category == APRG_AI_REVEAL) {
                friendlyTarget = APRG_AINearestFriendlyTarget(caster, player, friendlyToPlayer, APRG_AutonomousAbilityRange(abilityType, UnitGetOwner(caster)));
                if (friendlyTarget != null && APRG_TryAutonomousUnitOrder(caster, abilityType, commandIndex, friendlyTarget)) { APRG_QueuePriorAutonomousOrder(caster, priorOrder, hadPriorOrder); APRG_RecordAICast(caster, abilityType); return true; }
                if (category == APRG_AI_REVEAL && enemyTarget != null && APRG_TryAutonomousUnitOrder(caster, abilityType, commandIndex, enemyTarget)) { APRG_QueuePriorAutonomousOrder(caster, priorOrder, hadPriorOrder); APRG_RecordAICast(caster, abilityType); return true; }
                continue;
            }
            if (category == APRG_AI_HEAL_SUMMON) {
                friendlyTarget = APRG_AINearestFriendlyTarget(caster, player, friendlyToPlayer, 10.0);
                if (friendlyTarget != null && APRG_TryAutonomousPointOrder(caster, abilityType, commandIndex, UnitGetPosition(friendlyTarget))) { APRG_QueuePriorAutonomousOrder(caster, priorOrder, hadPriorOrder); APRG_RecordAICast(caster, abilityType); return true; }
                continue;
            }
            if (category == APRG_AI_DEFENSIVE_AREA) {
                if (!inCombat) { continue; }
                castOrder = Order(AbilityCommand(abilityType, commandIndex));
                if (UnitOrderIsValid(caster, castOrder)) { UnitIssueOrder(caster, castOrder, c_orderQueueReplace); APRG_QueuePriorAutonomousOrder(caster, priorOrder, hadPriorOrder); APRG_RecordAICast(caster, abilityType); return true; }
                if (APRG_TryAutonomousPointOrder(caster, abilityType, commandIndex, UnitGetPosition(caster))) { APRG_QueuePriorAutonomousOrder(caster, priorOrder, hadPriorOrder); APRG_RecordAICast(caster, abilityType); return true; }
                if (enemyTarget != null && APRG_TryAutonomousPointOrder(caster, abilityType, commandIndex, UnitGetPosition(enemyTarget))) { APRG_QueuePriorAutonomousOrder(caster, priorOrder, hadPriorOrder); APRG_RecordAICast(caster, abilityType); return true; }
                continue;
            }
            if (category == APRG_AI_CONSUME) {
                if (APRG_TryConsumeAbility(caster, player, friendlyToPlayer, abilityType, commandIndex)) { APRG_QueuePriorAutonomousOrder(caster, priorOrder, hadPriorOrder); APRG_RecordAICast(caster, abilityType); return true; }
                continue;
            }

            if (category == APRG_AI_SUMMON && (APRG_AIHas(abilityType, "Flaming") || APRG_AIHas(abilityType, "Betty"))) {
                if (!inCombat) { continue; }
                casterPoint = UnitGetPosition(caster);
                for (pointAttempt = 0; pointAttempt < 8; pointAttempt += 1) {
                    castPoint = PointWithOffsetPolar(casterPoint, RandomFixed(2.0, 5.0), libNtve_gf_RandomAngle());
                    if (castPoint == null || !RegionContainsPoint(RegionPlayableMap(), castPoint) || !PointPathingPassable(castPoint)) { continue; }
                    if (APRG_TryAutonomousPointOrder(caster, abilityType, commandIndex, castPoint)) {
                        APRG_QueuePriorAutonomousOrder(caster, priorOrder, hadPriorOrder);
                        APRG_RecordAICast(caster, abilityType);
                        return true;
                    }
                }
                continue;
            }

            offensiveTargets = APRG_AIOpposingTargetsNear(caster, player, friendlyToPlayer, APRG_AutonomousAbilityRange(abilityType, UnitGetOwner(caster)));
            offensiveTarget = APRG_TryAutonomousOffensiveOrder(caster, offensiveTargets, abilityType, commandIndex);
            if (offensiveTarget != null) { APRG_QueuePriorAutonomousOrder(caster, priorOrder, hadPriorOrder); APRG_RecordAICast(caster, abilityType); return true; }

            if (enemyTarget != null && (
                category == APRG_AI_SUMMON || category == APRG_AI_TRAP || category == APRG_AI_DECOY ||
                category == APRG_AI_AOE_DAMAGE || category == APRG_AI_AOE_CONTROL || category == APRG_AI_AREA_DENIAL ||
                category == APRG_AI_LINE || category == APRG_AI_DELAYED || category == APRG_AI_ULTIMATE || category == APRG_AI_DEBUFF
            )) {
                castPoint = UnitGetPosition(enemyTarget);
                if (APRG_TryAutonomousPointOrder(caster, abilityType, commandIndex, castPoint)) { APRG_QueuePriorAutonomousOrder(caster, priorOrder, hadPriorOrder); APRG_RecordAICast(caster, abilityType); return true; }
            }
        }
    }
    return false;
}

bool APRG_TryFriendlyAutonomousAbility(unit caster, int player) {
    return APRG_TryCategorizedAutonomousAbility(caster, player, true);
}

bool APRG_IsTrackedActiveEnemy(unit u) {
    int i;
    if (u == null) { return false; }
    for (i = 0; i < APRG_MAX_ACTIVE_ENEMIES; i += 1) {
        if (g_aprgActiveEnemyUnits[i] == u) { return true; }
    }
    return false;
}

void APRG_TickFriendlyAutonomousAbilities(int player, fixed now) {
    int count;
    int processed;
    int index;
    unit u;
    if (now < g_aprgNextFriendlyAutonomousAbilityTime) { return; }
    g_aprgNextFriendlyAutonomousAbilityTime = now + 0.5;

    count = UnitGroupCount(g_aprgAirSupportUnits, c_unitCountAlive);
    if (count <= 0) { g_aprgFriendlyAirAbilityCursor = 0; }
    else {
        if (g_aprgFriendlyAirAbilityCursor >= count) { g_aprgFriendlyAirAbilityCursor = 0; }
        for (processed = 0; processed < 5 && processed < count; processed += 1) {
            index = ((g_aprgFriendlyAirAbilityCursor + processed) % count) + 1;
            u = UnitGroupUnitFromEnd(g_aprgAirSupportUnits, index);
            if (u == null || !UnitIsAlive(u)) { continue; }
            APRG_TryFriendlyAutonomousAbility(u, player);
        }
        g_aprgFriendlyAirAbilityCursor = (g_aprgFriendlyAirAbilityCursor + processed) % count;
    }

    count = UnitGroupCount(g_aprgClonedUnits, c_unitCountAlive);
    if (count <= 0) { g_aprgFriendlyCloneAbilityCursor = 0; }
    else {
        if (g_aprgFriendlyCloneAbilityCursor >= count) { g_aprgFriendlyCloneAbilityCursor = 0; }
        for (processed = 0; processed < 5 && processed < count; processed += 1) {
            index = ((g_aprgFriendlyCloneAbilityCursor + processed) % count) + 1;
            u = UnitGroupUnitFromEnd(g_aprgClonedUnits, index);
            if (u == null || !UnitIsAlive(u)) { continue; }
            APRG_TryFriendlyAutonomousAbility(u, player);
        }
        g_aprgFriendlyCloneAbilityCursor = (g_aprgFriendlyCloneAbilityCursor + processed) % count;
    }

    count = UnitGroupCount(g_aprgAlliedSupport, c_unitCountAlive);
    if (count <= 0) { g_aprgFriendlySupportAbilityCursor = 0; }
    else {
        if (g_aprgFriendlySupportAbilityCursor >= count) { g_aprgFriendlySupportAbilityCursor = 0; }
        for (processed = 0; processed < 5 && processed < count; processed += 1) {
            index = ((g_aprgFriendlySupportAbilityCursor + processed) % count) + 1;
            u = UnitGroupUnitFromEnd(g_aprgAlliedSupport, index);
            if (u == null || !UnitIsAlive(u)) { continue; }
            APRG_TryFriendlyAutonomousAbility(u, player);
        }
        g_aprgFriendlySupportAbilityCursor = (g_aprgFriendlySupportAbilityCursor + processed) % count;
    }

    count = UnitGroupCount(g_aprgAlliedZombies, c_unitCountAlive);
    if (count <= 0) { g_aprgFriendlyZombieAbilityCursor = 0; }
    else {
        if (g_aprgFriendlyZombieAbilityCursor >= count) { g_aprgFriendlyZombieAbilityCursor = 0; }
        for (processed = 0; processed < 5 && processed < count; processed += 1) {
            index = ((g_aprgFriendlyZombieAbilityCursor + processed) % count) + 1;
            u = UnitGroupUnitFromEnd(g_aprgAlliedZombies, index);
            if (u == null || !UnitIsAlive(u)) { continue; }
            APRG_TryFriendlyAutonomousAbility(u, player);
        }
        g_aprgFriendlyZombieAbilityCursor = (g_aprgFriendlyZombieAbilityCursor + processed) % count;
    }

    if (g_aprgTychus != null && UnitIsAlive(g_aprgTychus)) { APRG_TryFriendlyAutonomousAbility(g_aprgTychus, player); }
    if (g_aprgPurifierAlliance != null && UnitIsAlive(g_aprgPurifierAlliance)) { APRG_TryFriendlyAutonomousAbility(g_aprgPurifierAlliance, player); }
}

void APRG_TickEnemyCombatAbilities(int player, fixed now) {
    unitgroup enemies;
    int count;
    int processed;
    int index;
    unit enemy;
    if (now < g_aprgNextEnemyAbilityTime) { return; }
    g_aprgNextEnemyAbilityTime = now + 1.0;
    enemies = APRG_EnemyMobileUnits(player);
    count = UnitGroupCount(enemies, c_unitCountAlive);
    if (count <= 0) { g_aprgEnemyAbilityCursor = 0; return; }
    if (g_aprgEnemyAbilityCursor >= count) { g_aprgEnemyAbilityCursor = 0; }
    for (processed = 0; processed < 24 && processed < count; processed += 1) {
        index = ((g_aprgEnemyAbilityCursor + processed) % count) + 1;
        enemy = UnitGroupUnitFromEnd(enemies, index);
        if (enemy == null || !UnitIsAlive(enemy)) { continue; }
        // Do not let autonomous hero casting start the Leviathan's native
        // Mutalisk/Brood Lord abilities before its timed approach finishes.
        if (enemy == g_aprgBaseLeviathan && !g_aprgBaseLeviathanPositioned) { continue; }
        if (APRG_IsScriptedPurifier(enemy) || APRG_IsRakShirObjectiveUnit(enemy)) { continue; }
        if (
            !g_aprgDestructionStarted &&
            !UnitGroupHasUnit(g_aprgHostileRaiders, enemy) &&
            !UnitGroupHasUnit(g_aprgHostilePatrollers, enemy) &&
            !UnitGroupHasUnit(g_aprgDarkTemplarRaiders, enemy) &&
            !UnitGroupHasUnit(g_aprgMarauderKillTeamUnits, enemy) &&
            !UnitGroupHasUnit(g_aprgGoldenFleet, enemy) &&
            !UnitGroupHasUnit(g_aprgTrueGoldenFleet, enemy) &&
            !UnitGroupHasUnit(g_aprgTrueGoldenPhoenixes, enemy) &&
            !UnitGroupHasUnit(g_aprgTaldarimRaiders, enemy) &&
            enemy != g_aprgDehakaPackHero &&
            !(APRG_HasExtension2(APRG_EXT2_MUT_ACTIVE_ENEMIES) && APRG_IsTrackedActiveEnemy(enemy))
        ) { continue; }
        if (APRG_HasExtension2(APRG_EXT2_MUT_ACTIVE_ENEMIES) && APRG_IsTrackedActiveEnemy(enemy)) {
            AISetUnitScriptControlled(enemy, false);
        }
        APRG_TryGeneratedHeroAbility(enemy, player);
    }
    g_aprgEnemyAbilityCursor = (g_aprgEnemyAbilityCursor + processed) % count;
}

unit APRG_FindInjuredFriendlyForQueen(unit queen, fixed radius) {
    unitgroup allies;
    int i;
    unit u;
    unit best = null;
    fixed life;
    fixed maxLife;
    fixed missing;
    fixed bestMissing = 0.0;
    int owner;
    if (queen == null) { return null; }
    owner = UnitGetOwner(queen);
    allies = UnitGroup(null, owner, RegionCircle(UnitGetPosition(queen), radius), UnitFilter(0, 0, 0, 0), 0);
    for (i = UnitGroupCount(allies, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(allies, i);
        if (u == null || !UnitIsAlive(u) || u == queen) { continue; }
        maxLife = UnitGetPropertyFixed(u, c_unitPropLifeMax, c_unitPropCurrent);
        life = UnitGetPropertyFixed(u, c_unitPropLife, c_unitPropCurrent);
        missing = maxLife - life;
        if (maxLife > 0.0 && missing >= 25.0 && missing > bestMissing) {
            best = u;
            bestMissing = missing;
        }
    }
    return best;
}

bool APRG_TryQueenTransfusion(unit queen) {
    unit target;
    int abilityIndex;
    int abilityCount;
    int commandIndex;
    string abilityType;
    order healOrder;
    if (queen == null || !UnitIsAlive(queen) || !StringContains(UnitGetType(queen), "Queen", c_stringAnywhere, c_stringNoCase)) { return false; }
    target = APRG_FindInjuredFriendlyForQueen(queen, 12.0);
    if (target == null) { return false; }
    abilityCount = MinI(64, UnitAbilityCount(queen));
    for (abilityIndex = 1; abilityIndex <= abilityCount; abilityIndex += 1) {
        abilityType = UnitAbilityGet(queen, abilityIndex);
        if (!StringContains(abilityType, "Transfus", c_stringAnywhere, c_stringNoCase)) { continue; }
        for (commandIndex = 0; commandIndex < 4; commandIndex += 1) {
            healOrder = OrderTargetingUnit(AbilityCommand(abilityType, commandIndex), target);
            if (UnitOrderIsValid(queen, healOrder)) {
                UnitIssueOrder(queen, healOrder, c_orderQueueReplace);
                return true;
            }
        }
    }
    return false;
}

void APRG_TickQueenTransfusions(int player, fixed now) {
    unitgroup playerUnits;
    unitgroup enemies;
    int i;
    unit u;
    if (now < g_aprgNextQueenAbilityTime) { return; }
    g_aprgNextQueenAbilityTime = now + 1.0;
    playerUnits = APRG_PlayerMobileUnits(player);
    for (i = UnitGroupCount(playerUnits, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(playerUnits, i);
        if (
            u != null && UnitGroupHasUnit(g_aprgAlliedSupport, u) &&
            StringContains(UnitGetType(u), "Queen", c_stringAnywhere, c_stringNoCase)
        ) { APRG_TryQueenTransfusion(u); }
    }
    enemies = APRG_EnemyMobileUnits(player);
    for (i = UnitGroupCount(enemies, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(enemies, i);
        if (
            u != null &&
            (UnitGroupHasUnit(g_aprgHostileRaiders, u) || UnitGroupHasUnit(g_aprgHostilePatrollers, u)) &&
            StringContains(UnitGetType(u), "Queen", c_stringAnywhere, c_stringNoCase)
        ) { APRG_TryQueenTransfusion(u); }
    }
}

void APRG_TickGeneratedHeroNoRevive() {
    int i;
    unit u;
    for (i = 0; i < g_aprgGeneratedHeroCount; i += 1) {
        u = g_aprgGeneratedHeroes[i];
        if (u == null) { continue; }
        if (UnitIsAlive(u)) {
            APRG_DisableGeneratedHeroRevive(u);
            if (StringContains(UnitGetType(u), "Zagara", c_stringAnywhere, c_stringNoCase) &&
                UnitGetPropertyFixed(u, c_unitPropLife, c_unitPropCurrent) <= 6.0) {
                UnitKill(u);
                if (UnitIsAlive(u)) { UnitRemove(u); }
            }
        }
        if (!g_aprgGeneratedHeroDied[i] && !UnitIsAlive(u)) {
            g_aprgGeneratedHeroDied[i] = true;
        }
        else if (g_aprgGeneratedHeroDied[i] && UnitIsAlive(u)) {
            UnitRemove(u);
        }
    }
}

// Some campaign Zagara variants stop taking lethal damage with a few HP.
// Check both hostile and player-owned commander Zagara, independently of
// max HP changes or the generated enemy-hero tracker.
// Keep this bounded instead of scanning every game tick.
void APRG_TickEnemyZagaraFatalHp(int player, fixed now) {
    unitgroup candidates;
    unit zagara;
    int i;
    int pass;
    if (now < g_aprgNextEnemyZagaraFatalCheckTime) { return; }
    g_aprgNextEnemyZagaraFatalCheckTime = now + 0.5;
    for (pass = 0; pass < 2; pass += 1) {
        if (pass == 0) { candidates = APRG_EnemyAllUnits(player); }
        else { candidates = APRG_PlayerAllUnits(player); }
        for (i = UnitGroupCount(candidates, c_unitCountAlive); i > 0; i -= 1) {
            zagara = UnitGroupUnitFromEnd(candidates, i);
            if (zagara == null || !UnitIsAlive(zagara)) { continue; }
            if (!StringContains(UnitGetType(zagara), "Zagara", c_stringAnywhere, c_stringNoCase)) { continue; }
            if (UnitGetPropertyFixed(zagara, c_unitPropLife, c_unitPropCurrent) > 6.0) { continue; }
            // Do not strip the player's normal commander-revival logic.
            if (pass == 0) { APRG_DisableGeneratedHeroRevive(zagara); }
            UnitKill(zagara);
            if (UnitIsAlive(zagara)) { UnitRemove(zagara); }
        }
    }
}

string APRG_AlarakHeroType() {
    // "Alarak" is not the reliable gameplay catalog id in every dependency
    // set. Prefer the LotV campaign hero, then the co-op hero, and retain the
    // older aliases only as fallbacks for unusual mission catalogs.
    if (CatalogEntryIsValid(c_gameCatalogUnit, "AlarakChampion")) { return "AlarakChampion"; }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "AlarakCoop")) { return "AlarakCoop"; }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "Alarak")) { return "Alarak"; }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "PitAlarak")) { return "PitAlarak"; }
    return "";
}

string APRG_VorazunHeroType() {
    // The campaign hero is VorazunChampion. Bare "Vorazun" is not a reliable
    // unit id and can fall through into an unrelated random hero.
    if (CatalogEntryIsValid(c_gameCatalogUnit, "VorazunChampion")) { return "VorazunChampion"; }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "SMX2ProtossVorazun")) { return "SMX2ProtossVorazun"; }
    return "";
}

// The controllable LotV Artanis is ArtanisVoid (Twilight Blades), not
// Wings of Liberty's hero mothership "Artanis". Never substitute a random
// commander when that catalog is unavailable on the current map.
string APRG_ArtanisHeroType() {
    if (CatalogEntryIsValid(c_gameCatalogUnit, "ArtanisVoid")) { return "ArtanisVoid"; }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "AP_ArtanisVoid")) { return "AP_ArtanisVoid"; }
    return "";
}

// HotS and AP mission scripts spawn the real campaign hero as "ZaGara".
// The plausible-looking "Zagara" link is not reliable across campaign data.
string APRG_ZagaraHeroType() {
    if (CatalogEntryIsValid(c_gameCatalogUnit, "ZaGara")) { return "ZaGara"; }
    return "";
}

// Niadra evolves through multiple campaign CUnit stages. Prefer her mature
// combat form when this mission exposes it; fall back to other Niadra stages.
// Do not substitute a different hero until none of these can be created.
string APRG_NiadraHeroType() {
    if (CatalogEntryIsValid(c_gameCatalogUnit, "NiadraLevel3")) { return "NiadraLevel3"; }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "Niadra3")) { return "Niadra3"; }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "Niadra")) { return "Niadra"; }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "NiadraLevel2")) { return "NiadraLevel2"; }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "Niadra2")) { return "Niadra2"; }
    return "";
}

string APRG_HeroCandidate(int index) {
    if (index == 0) { return "RaynorCommando"; }
    if (index == 1) { return ""; }
    if (index == 2) { return "TychusCommando"; }
    if (index == 3) { return ""; }
    if (index == 4) { return ""; }
    if (index == 5) { return "Swann"; }
    if (index == 6) { return ""; }
    if (index == 7) { return "Zeratul"; }
    if (index == 8) { return "ZeratulVoid"; }
    if (index == 9) { return APRG_ArtanisHeroType(); }
    if (index == 10) { return APRG_AlarakHeroType(); }
    if (index == 11) { return APRG_AlarakHeroType(); }
    if (index == 12) { return APRG_AlarakHeroType(); }
    if (index == 13) { return "Mohandar"; }
    if (index == 14) { return "Selendis"; }
    if (index == 15) { return "Karax"; }
    if (index == 16) { return "KaraxChampion"; }
    if (index == 17) { return APRG_ZagaraHeroType(); }
    if (index == 18) { return APRG_ZagaraHeroType(); }
    if (index == 19) { return "Dehaka"; }
    if (index == 20) { return "Nova"; }
    if (index == 21) { return ""; }
    if (index == 22) { return ""; }
    if (index == 23) { return "Tosh"; }
    if (index == 24) { return "Stukov"; }
    if (index == 25) { return "InfestedStukov"; }
    if (index == 26) { return "InfestedStukovCoop"; }
    if (index == 27) { return "Fenix"; }
    if (index == 28) { return "FenixChampion"; }
    if (index == 29) { return "FenixCoop"; }
    if (index == 30) { return APRG_VorazunHeroType(); }
    if (index == 31) { return "Stukov"; }
    if (index == 32) { return "Urun"; }
    if (index == 33) { return APRG_NiadraHeroType(); }
    if (index == 34) { return "Karass"; }
    if (index == 35) { return "FenixKaldalisZealot"; }
    return "";
}

string APRG_HostileHeroFamilyKey(string heroType) {
    if (StringContains(heroType, "Raynor", c_stringAnywhere, c_stringNoCase)) { return "Raynor"; }
    if (StringContains(heroType, "Tychus", c_stringAnywhere, c_stringNoCase)) { return "Tychus"; }
    if (StringContains(heroType, "Swann", c_stringAnywhere, c_stringNoCase)) { return "Swann"; }
    if (StringContains(heroType, "Zeratul", c_stringAnywhere, c_stringNoCase)) { return "Zeratul"; }
    if (StringContains(heroType, "Artanis", c_stringAnywhere, c_stringNoCase)) { return "Artanis"; }
    if (StringContains(heroType, "Alarak", c_stringAnywhere, c_stringNoCase)) { return "Alarak"; }
    if (StringContains(heroType, "Karax", c_stringAnywhere, c_stringNoCase)) { return "Karax"; }
    if (StringContains(heroType, "Zagara", c_stringAnywhere, c_stringNoCase) || heroType == "ZaGara") { return "Zagara"; }
    if (StringContains(heroType, "Stukov", c_stringAnywhere, c_stringNoCase)) { return "Stukov"; }
    if (StringContains(heroType, "Fenix", c_stringAnywhere, c_stringNoCase)) { return "Fenix"; }
    return heroType;
}

string APRG_CommanderHeroDisplayName(string heroType) {
    if (StringContains(heroType, "Raynor", c_stringAnywhere, c_stringNoCase)) { return "Raynor"; }
    if (StringContains(heroType, "Swann", c_stringAnywhere, c_stringNoCase)) { return "Swann"; }
    if (StringContains(heroType, "Zeratul", c_stringAnywhere, c_stringNoCase)) { return "Zeratul"; }
    if (StringContains(heroType, "Artanis", c_stringAnywhere, c_stringNoCase)) { return "Artanis"; }
    if (StringContains(heroType, "Alarak", c_stringAnywhere, c_stringNoCase)) { return "Alarak"; }
    if (StringContains(heroType, "Mohandar", c_stringAnywhere, c_stringNoCase)) { return "Mohandar"; }
    if (StringContains(heroType, "Selendis", c_stringAnywhere, c_stringNoCase)) { return "Selendis"; }
    if (StringContains(heroType, "Karax", c_stringAnywhere, c_stringNoCase)) { return "Karax"; }
    if (StringContains(heroType, "Zagara", c_stringAnywhere, c_stringNoCase) || heroType == "ZaGara") { return "Zagara"; }
    if (StringContains(heroType, "Dehaka", c_stringAnywhere, c_stringNoCase)) { return "Dehaka"; }
    if (StringContains(heroType, "Nova", c_stringAnywhere, c_stringNoCase)) { return "Nova"; }
    if (StringContains(heroType, "Tosh", c_stringAnywhere, c_stringNoCase)) { return "Tosh"; }
    if (StringContains(heroType, "Stukov", c_stringAnywhere, c_stringNoCase)) { return "Stukov"; }
    if (StringContains(heroType, "Fenix", c_stringAnywhere, c_stringNoCase)) { return "Fenix"; }
    if (StringContains(heroType, "Vorazun", c_stringAnywhere, c_stringNoCase)) { return "Vorazun"; }
    if (StringContains(heroType, "Urun", c_stringAnywhere, c_stringNoCase)) { return "Urun"; }
    if (StringContains(heroType, "Niadra", c_stringAnywhere, c_stringNoCase)) { return "Niadra"; }
    if (StringContains(heroType, "Karass", c_stringAnywhere, c_stringNoCase)) { return "Karass"; }
    return heroType;
}

string APRG_FindUnusedValidHostileHeroType() {
    int start = RandomInt(0, APRG_HERO_CANDIDATE_COUNT - 1);
    int step;
    string candidate;
    string fallback = "";
    string family;
    for (step = 0; step < APRG_HERO_CANDIDATE_COUNT; step += 1) {
        candidate = APRG_HeroCandidate((start + step) % APRG_HERO_CANDIDATE_COUNT);
        if (candidate == "" || !CatalogEntryIsValid(c_gameCatalogUnit, candidate)) { continue; }
        if (fallback == "") { fallback = candidate; }
        family = APRG_HostileHeroFamilyKey(candidate);
        if (!DataTableGetBool(true, "APRG_HostileHeroFamily_" + family)) { return candidate; }
    }
    return fallback;
}

void APRG_MarkHostileHeroFamilyUsed(string heroType) {
    string family = APRG_HostileHeroFamilyKey(heroType);
    if (family != "") { DataTableSetBool(true, "APRG_HostileHeroFamily_" + family, true); }
}

string APRG_FindValidHeroType() {
    int start = RandomInt(0, APRG_HERO_CANDIDATE_COUNT - 1);
    int step;
    string candidate;
    for (step = 0; step < APRG_HERO_CANDIDATE_COUNT; step += 1) {
        candidate = APRG_HeroCandidate((start + step) % APRG_HERO_CANDIDATE_COUNT);
        if (candidate != "" && CatalogEntryIsValid(c_gameCatalogUnit, candidate)) {
            return candidate;
        }
    }
    return "";
}

string APRG_CommanderFallbackCandidate(int slot) {
    if (slot == 0) { return "RaynorCommando"; }
    if (slot == 1) { return "Swann"; }
    if (slot == 2) { return "Zeratul"; }
    if (slot == 3) { return APRG_ArtanisHeroType(); }
    if (slot == 4) { return APRG_AlarakHeroType(); }
    if (slot == 5) { return "Mohandar"; }
    if (slot == 6) { return "Selendis"; }
    if (slot == 7) { return "Karax"; }
    if (slot == 8) { return APRG_ZagaraHeroType(); }
    if (slot == 9) { return "Dehaka"; }
    if (slot == 10) { return "Nova"; }
    if (slot == 11) { return "Tosh"; }
    if (slot == 12) { return "Stukov"; }
    if (slot == 13) { return "Fenix"; }
    if (slot == 14) { return APRG_VorazunHeroType(); }
    if (slot == 15) { return "Urun"; }
    if (slot == 16) { return APRG_NiadraHeroType(); }
    if (slot == 17) { return "Karass"; }
    return "";
}

// Explicit Zagara fallback never retries the same unavailable or unspawnable
// ZaGara link. Preserve the existing Commander roster and catalog checks.
string APRG_FindValidCommanderHeroFallbackExcept(string excludedType) {
    int start = RandomInt(0, 17);
    int step;
    string candidate;
    for (step = 0; step < 18; step += 1) {
        candidate = APRG_CommanderFallbackCandidate((start + step) % 18);
        if (candidate == "" || candidate == excludedType) { continue; }
        if (CatalogEntryIsValid(c_gameCatalogUnit, candidate)) { return candidate; }
    }
    return "";
}

string APRG_FindValidCommanderHeroType() {
    int start = RandomInt(0, 17);
    int step;
    string candidate;
    for (step = 0; step < 18; step += 1) {
        candidate = APRG_CommanderFallbackCandidate((start + step) % 18);
        if (candidate != "" && CatalogEntryIsValid(c_gameCatalogUnit, candidate)) {
            return candidate;
        }
    }
    return "";
}

string APRG_FindValidHeroTypeFromIndex(int preferredIndex) {
    string candidate;
    // Explicit Artanis rolls must never turn into Urun (or another random
    // fallback) merely because the native Void dependency was not loaded.
    if (preferredIndex == 9) { return APRG_ArtanisHeroType(); }
    if (preferredIndex == 33) {
        candidate = APRG_NiadraHeroType();
        if (candidate != "") { return candidate; }
        return APRG_FindValidCommanderHeroType();
    }
    if (preferredIndex == 18 || preferredIndex == 17) {
        candidate = APRG_ZagaraHeroType();
        if (candidate != "") { return candidate; }
        // A real usable commander is better than no hero if the mission's
        // restricted data cannot load ZaGara; do not change dependencies.
        return APRG_FindValidCommanderHeroFallbackExcept("ZaGara");
    }
    if ((preferredIndex == 0 || preferredIndex == 1) && CatalogEntryIsValid(c_gameCatalogUnit, "RaynorCommando")) {
        return "RaynorCommando";
    }
    if (preferredIndex == 6 && CatalogEntryIsValid(c_gameCatalogUnit, "SwannCommando")) {
        return "SwannCommando";
    }
    if (preferredIndex >= 0 && preferredIndex < APRG_HERO_CANDIDATE_COUNT) {
        candidate = APRG_HeroCandidate(preferredIndex);
        if (candidate != "" && CatalogEntryIsValid(c_gameCatalogUnit, candidate)) { return candidate; }
    }
    // Commander fallback is intentionally restricted to the Commander roster.
    // Tychus is a Heroes of the Storm candidate, not a normal Commander roll.
    return APRG_FindValidCommanderHeroType();
}

bool APRG_IsPlayerHeroUnit(unit u, int player) {
    string unitType;
    if (u == null || !UnitIsAlive(u) || UnitGetOwner(u) != player) { return false; }
    unitType = UnitGetType(u);
    if (DataTableGetBool(true, "APRG_NoHeroRegen_" + IntToString(UnitGetTag(u)))) { return false; }
    return UnitTypeTestAttribute(unitType, c_unitAttributeHeroic) ||
        StringContains(unitType, "Tychus", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Odin", c_stringAnywhere, c_stringNoCase);
}

void APRG_TickHeroRegeneration(int player, fixed now) {
    unitgroup units;
    int i;
    unit u;
    fixed current;
    fixed maximum;
    fixed lastHeal;
    fixed healAmount;
    string key;
    if (now < g_aprgNextHeroRegenerationTime) { return; }
    g_aprgNextHeroRegenerationTime = now + 1.0;
    units = APRG_PlayerMobileUnits(player);
    for (i = UnitGroupCount(units, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (!APRG_IsPlayerHeroUnit(u, player)) { continue; }
        key = "APRG_HeroRegen_" + IntToString(UnitGetTag(u));
        lastHeal = DataTableGetFixed(true, key);
        if (lastHeal > 0.0 && now - lastHeal < 1.0) { continue; }
        DataTableSetFixed(true, key, now);
        current = UnitGetPropertyFixed(u, c_unitPropLife, c_unitPropCurrent);
        maximum = UnitGetPropertyFixed(u, c_unitPropLifeMax, c_unitPropCurrent);
        healAmount = 1.0;
        if (StringContains(UnitGetType(u), "Odin", c_stringAnywhere, c_stringNoCase)) { healAmount = 0.5; }
        if (maximum > 0.0 && current < maximum) {
            UnitSetPropertyFixed(u, c_unitPropLife, MinF(maximum, current + healAmount));
        }
    }
}

void APRG_GiveGeneralIfReady(int player) {
    unit base;
    point p;
    string heroType;
    unitgroup created;
    fixed now;
    if (!APRG_PlayerMacroBaseReady(player)) { return; }
    now = GameGetMissionTime();

    if (g_aprgGeneralGiven) {
        // Crew commanders are single-life assets, as required by the XLSX.
        if ((g_aprgMissionFlags & APRG_MISSION_FLAG_CREW_CHALLENGE) != 0) { return; }
        if (g_aprgCommanderHero != null && UnitIsAlive(g_aprgCommanderHero)) {
            g_aprgCommanderHeroDeathTime = -1.0;
            return;
        }
        if (g_aprgCommanderHeroType == "") { return; }
        if (g_aprgCommanderHeroDeathTime < 0.0) {
            g_aprgCommanderHeroDeathTime = now;
            return;
        }
        if (now - g_aprgCommanderHeroDeathTime < 60.0) { return; }
        base = APRG_FindPlayerHomeStructure(player);
        if (base == null) { return; }
        p = APRG_FindGroundPointNear(UnitGetPosition(base), 4.0, 9.0);
        if (p == null) { p = UnitGetPosition(base); }
        if (g_aprgCommanderHeroType == "Nova" || g_aprgCommanderHeroType == "RaynorCommando" || g_aprgCommanderHeroType == "ArtanisVoid" || g_aprgCommanderHeroType == "ZaGara") {
            created = APRG_CreatePlayerUnitsVanillaSafe(1, g_aprgCommanderHeroType, player, p, libNtve_gf_RandomAngle());
        }
        else {
            created = APRG_CreatePlayerUnitsSafe(1, g_aprgCommanderHeroType, player, p, libNtve_gf_RandomAngle());
        }
        g_aprgCommanderHero = UnitGroupUnitFromEnd(created, 1);
        // A catalog entry can exist yet fail to create a live playable unit.
        // Only Zagara opts into this alternative, retaining Artanis's strict
        // behavior and all other commanders' existing respawn logic.
        if (g_aprgCommanderHeroType == "ZaGara" && (g_aprgCommanderHero == null || !UnitIsAlive(g_aprgCommanderHero))) {
            heroType = APRG_FindValidCommanderHeroFallbackExcept("ZaGara");
            if (heroType != "") {
                created = APRG_CreatePlayerUnitsSafe(1, heroType, player, p, libNtve_gf_RandomAngle());
                g_aprgCommanderHero = UnitGroupUnitFromEnd(created, 1);
                if (g_aprgCommanderHero != null && UnitIsAlive(g_aprgCommanderHero)) {
                    g_aprgCommanderHeroType = heroType;
                    UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaChat, StringToText("Slay: Zagara unavailable; deployed " + APRG_CommanderHeroDisplayName(heroType) + " instead."));
                }
            }
        }
        APRG_RegisterGeneratedHeroGroup(created);
        if (g_aprgCommanderHero != null && UnitIsAlive(g_aprgCommanderHero)) {
            UIDisplayMessage(
                PlayerGroupSingle(player), c_messageAreaChat,
                StringToText(APRG_CommanderHeroDisplayName(g_aprgCommanderHeroType) + " has respawned")
            );
        }
        if (g_aprgCommanderHero == null || !UnitIsAlive(g_aprgCommanderHero)) { return; }
        g_aprgCommanderHeroDeathTime = -1.0;
        return;
    }

    base = APRG_FindPlayerHomeStructure(player);
    if (base == null) { return; }
    p = APRG_FindGroundPointNear(UnitGetPosition(base), 4.0, 9.0);
    if (p == null) { return; }
    heroType = APRG_FindValidHeroTypeFromIndex(g_aprgCommanderHeroIndex);
    if (heroType == "") {
        if (g_aprgCommanderHeroIndex == 9) {
            UIDisplayMessage(
                PlayerGroupSingle(player), c_messageAreaChat,
                StringToText("Slay: Artanis could not spawn (LotV hero catalog unavailable on this mission).")
            );
        }
        if (g_aprgCommanderHeroIndex == 18) {
            UIDisplayMessage(
                PlayerGroupSingle(player), c_messageAreaChat,
                StringToText("Slay: Zagara could not spawn (HotS ZaGara catalog unavailable on this mission).")
            );
        }
        g_aprgGeneralGiven = true;
        return;
    }
    if (heroType == "Nova" || heroType == "RaynorCommando" || heroType == "ArtanisVoid" || heroType == "ZaGara") {
        created = APRG_CreatePlayerUnitsVanillaSafe(1, heroType, player, p, libNtve_gf_RandomAngle());
    }
    else {
        created = APRG_CreatePlayerUnitsSafe(1, heroType, player, p, libNtve_gf_RandomAngle());
    }
    g_aprgCommanderHero = UnitGroupUnitFromEnd(created, 1);
    if (g_aprgCommanderHeroIndex == 33 && (g_aprgCommanderHero == null || !UnitIsAlive(g_aprgCommanderHero))) {
        // The catalog may expose a shell for one evolution form that fails
        // native creation. Retry the original CUnit and level-3 alternative.
        if (heroType != "Niadra" && CatalogEntryIsValid(c_gameCatalogUnit, "Niadra")) {
            created = APRG_CreatePlayerUnitsSafe(1, "Niadra", player, p, libNtve_gf_RandomAngle());
            g_aprgCommanderHero = UnitGroupUnitFromEnd(created, 1);
            if (g_aprgCommanderHero != null && UnitIsAlive(g_aprgCommanderHero)) { heroType = "Niadra"; }
        }
        if ((g_aprgCommanderHero == null || !UnitIsAlive(g_aprgCommanderHero)) &&
            heroType != "NiadraLevel3" && CatalogEntryIsValid(c_gameCatalogUnit, "NiadraLevel3")) {
            created = APRG_CreatePlayerUnitsSafe(1, "NiadraLevel3", player, p, libNtve_gf_RandomAngle());
            g_aprgCommanderHero = UnitGroupUnitFromEnd(created, 1);
            if (g_aprgCommanderHero != null && UnitIsAlive(g_aprgCommanderHero)) { heroType = "NiadraLevel3"; }
        }
        if (g_aprgCommanderHero == null || !UnitIsAlive(g_aprgCommanderHero)) {
            heroType = APRG_FindValidCommanderHeroType();
            if (heroType != "") {
                created = APRG_CreatePlayerUnitsSafe(1, heroType, player, p, libNtve_gf_RandomAngle());
                g_aprgCommanderHero = UnitGroupUnitFromEnd(created, 1);
            }
        }
    }
    if (heroType == "ZaGara" && (g_aprgCommanderHero == null || !UnitIsAlive(g_aprgCommanderHero))) {
        heroType = APRG_FindValidCommanderHeroFallbackExcept("ZaGara");
        if (heroType != "") {
            created = APRG_CreatePlayerUnitsSafe(1, heroType, player, p, libNtve_gf_RandomAngle());
            g_aprgCommanderHero = UnitGroupUnitFromEnd(created, 1);
        }
    }
    if (g_aprgCommanderHeroIndex == 18 && heroType != "ZaGara" &&
        g_aprgCommanderHero != null && UnitIsAlive(g_aprgCommanderHero)) {
        UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaChat, StringToText("Slay: Zagara unavailable; deployed " + APRG_CommanderHeroDisplayName(heroType) + " instead."));
    }
    g_aprgCommanderHeroType = heroType;
    APRG_RegisterGeneratedHeroGroup(created);
    g_aprgGeneralGiven = true;
}

void APRG_GiveFarseers(int player) {
    if (!g_aprgFarseersGiven) {
        g_aprgFarseerRevealer = VisRevealerCreate(player, RegionPlayableMap());
        g_aprgFarseersGiven = true;
        return;
    }
    if (APRG_PlayerMacroBaseReady(player) && !g_aprgFarseersMacroRefreshGiven) {
        g_aprgFarseerRevealer = VisRevealerCreate(player, RegionPlayableMap());
        g_aprgFarseersMacroRefreshGiven = true;
    }
}

void APRG_EnsurePlayerInterceptorCost(int player) {
    int abilityCount;
    int abilityIndex;
    int infoCount;
    int infoIndex;
    int unitCount;
    int unitIndex;
    bool abilityProducesInterceptor;
    string abilityType;
    string basePath;
    string trainedUnitType;
    fixed maxCount;
    if (CatalogEntryIsValid(c_gameCatalogUnit, "Interceptor")) {
        CatalogFieldValueSet(c_gameCatalogUnit, "Interceptor", "CostResource[0]", player, "15");
    }
    abilityCount = CatalogEntryCount(c_gameCatalogAbil);
    for (abilityIndex = 1; abilityIndex <= abilityCount; abilityIndex += 1) {
        abilityType = CatalogEntryGet(c_gameCatalogAbil, abilityIndex);
        if (abilityType == "" || !CatalogEntryIsValid(c_gameCatalogAbil, abilityType)) { continue; }
        abilityProducesInterceptor = false;
        infoCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, "InfoArray", player);
        for (infoIndex = 0; infoIndex < infoCount; infoIndex += 1) {
            basePath = "InfoArray[" + IntToString(infoIndex) + "]";
            trainedUnitType = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, basePath + ".Unit", player);
            if (StringContains(trainedUnitType, "Interceptor", c_stringAnywhere, c_stringNoCase)) {
                abilityProducesInterceptor = true;
            }
            unitCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, basePath + ".Unit", player);
            for (unitIndex = 0; unitIndex < unitCount && !abilityProducesInterceptor; unitIndex += 1) {
                trainedUnitType = CatalogFieldValueGet(
                    c_gameCatalogAbil,
                    abilityType,
                    basePath + ".Unit[" + IntToString(unitIndex) + "]",
                    player
                );
                if (StringContains(trainedUnitType, "Interceptor", c_stringAnywhere, c_stringNoCase)) {
                    abilityProducesInterceptor = true;
                }
            }
            if (!abilityProducesInterceptor) { continue; }
            CatalogFieldValueSet(c_gameCatalogAbil, abilityType, basePath + ".Resource[0]", player, "15");
            CatalogFieldValueSet(c_gameCatalogAbil, abilityType, basePath + ".Cost.Resource[0]", player, "15");
            if (!APRG_HasExtension4(APRG_EXT4_BOON_TRUE_CARRIERS)) {
                CatalogFieldValueSet(c_gameCatalogAbil, abilityType, basePath + ".MaxCount", player, "8");
            }
        }
        if (abilityProducesInterceptor) {
            CatalogFieldValueSet(c_gameCatalogAbil, abilityType, "Cost.Resource[0]", player, "15");
            maxCount = StringToFixed(CatalogFieldValueGet(c_gameCatalogAbil, abilityType, "MaxCount", player));
            if (!APRG_HasExtension4(APRG_EXT4_BOON_TRUE_CARRIERS) && maxCount > 8.0) {
                CatalogFieldValueSet(c_gameCatalogAbil, abilityType, "MaxCount", player, "8");
            }
        }
    }
}

bool APRG_CarrierGetsFreeInterceptors(unit carrier) {
    int player;
    if (carrier == null || !UnitIsAlive(carrier)) { return false; }
    player = APRG_GetPrimaryPlayer();
    if (UnitGetOwner(carrier) != player) { return true; }
    return DataTableGetBool(true, "APRG_Uncommandable_" + IntToString(UnitGetTag(carrier)));
}

bool APRG_IsFriendlyCarrierOwner(int owner, int player) {
    if (owner == player) { return true; }
    if (owner <= 0) { return false; }
    return !libNtve_gf_PlayerIsEnemy(owner, player, libNtve_ge_PlayerRelation_Enemy);
}

bool APRG_InterceptorFamilyType(string unitType) {
    return unitType != "" && StringContains(unitType, "Interceptor", c_stringAnywhere, c_stringNoCase);
}

bool APRG_InterceptorInfoProducesUnit(int player, string abilityType, int infoIndex) {
    string basePath;
    string producedUnit;
    int unitCount;
    int unitIndex;
    if (abilityType == "" || !CatalogEntryIsValid(c_gameCatalogAbil, abilityType) || infoIndex < 0) { return false; }
    basePath = "InfoArray[" + IntToString(infoIndex) + "]";
    producedUnit = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, basePath + ".Unit", player);
    if (APRG_InterceptorFamilyType(producedUnit)) { return true; }
    unitCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, basePath + ".Unit", player);
    for (unitIndex = 0; unitIndex < unitCount; unitIndex += 1) {
        producedUnit = CatalogFieldValueGet(
            c_gameCatalogAbil,
            abilityType,
            basePath + ".Unit[" + IntToString(unitIndex) + "]",
            player
        );
        if (APRG_InterceptorFamilyType(producedUnit)) { return true; }
    }
    return false;
}

void APRG_SetTrueCarrierAbilityCapacity(int owner, string abilityType) {
    int infoCount;
    int infoIndex;
    string basePath;
    string key;
    if (owner <= 0 || abilityType == "" || !CatalogEntryIsValid(c_gameCatalogAbil, abilityType)) { return; }
    key = "APRG_TrueCarrierAbility_" + IntToString(owner) + "_" + abilityType;
    if (DataTableGetBool(true, key)) { return; }
    infoCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, "InfoArray", owner);
    for (infoIndex = 0; infoIndex < infoCount; infoIndex += 1) {
        if (!APRG_InterceptorInfoProducesUnit(owner, abilityType, infoIndex)) { continue; }
        basePath = "InfoArray[" + IntToString(infoIndex) + "]";
        CatalogFieldValueSet(c_gameCatalogAbil, abilityType, basePath + ".MaxCount", owner, "100");
        CatalogFieldValueSet(c_gameCatalogAbil, abilityType, basePath + ".Button.Requirements", owner, "");
        CatalogFieldValueSet(c_gameCatalogAbil, abilityType, "MaxCount", owner, "100");
    }
    DataTableSetBool(true, key, true);
}

void APRG_SetTrueCarrierCapacityForOwner(int owner) {
    unitgroup units;
    unit u;
    int i;
    int abilityCount;
    int abilityIndex;
    string unitType;
    string abilityType;
    if (owner <= 0) { return; }
    units = UnitGroup(
        null, owner, RegionPlayableMap(),
        UnitFilter(0, 0, (1 << c_targetFilterStructure) | (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32))), 0
    );
    for (i = UnitGroupCount(units, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null) { continue; }
        unitType = UnitGetType(u);
        if (!StringContains(unitType, "Carrier", c_stringAnywhere, c_stringNoCase)) { continue; }
        abilityCount = UnitAbilityCount(u);
        for (abilityIndex = 1; abilityIndex <= abilityCount; abilityIndex += 1) {
            abilityType = UnitAbilityGet(u, abilityIndex);
            APRG_SetTrueCarrierAbilityCapacity(owner, abilityType);
        }
    }
}

void APRG_ApplyTrueCarriersToFriendlyOwners(int player) {
    unitgroup carriers;
    unit u;
    int i;
    int owner;
    string unitType;
    if (!APRG_HasExtension4(APRG_EXT4_BOON_TRUE_CARRIERS)) { return; }
    carriers = UnitGroup(
        null, c_playerAny, RegionPlayableMap(),
        UnitFilter(0, 0, (1 << c_targetFilterStructure) | (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0
    );
    for (i = UnitGroupCount(carriers, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(carriers, i);
        if (u == null) { continue; }
        unitType = UnitGetType(u);
        if (!StringContains(unitType, "Carrier", c_stringAnywhere, c_stringNoCase)) { continue; }
        owner = UnitGetOwner(u);
        if (APRG_IsFriendlyCarrierOwner(owner, player)) { APRG_SetTrueCarrierCapacityForOwner(owner); }
    }
}

bool APRG_ArmInterceptorMagazineToCap(unit carrier, int cap) {
    int abilityCount;
    int abilityIndex;
    int infoCount;
    int infoIndex;
    int current;
    int owner;
    string abilityType;
    string basePath;
    if (carrier == null || !UnitIsAlive(carrier) || cap <= 0) { return false; }
    owner = UnitGetOwner(carrier);
    abilityCount = UnitAbilityCount(carrier);
    for (abilityIndex = 1; abilityIndex <= abilityCount; abilityIndex += 1) {
        abilityType = UnitAbilityGet(carrier, abilityIndex);
        if (abilityType == "" || !CatalogEntryIsValid(c_gameCatalogAbil, abilityType)) { continue; }
        infoCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, "InfoArray", owner);
        for (infoIndex = 0; infoIndex < infoCount; infoIndex += 1) {
            if (!APRG_InterceptorInfoProducesUnit(owner, abilityType, infoIndex)) { continue; }
            basePath = "InfoArray[" + IntToString(infoIndex) + "]";
            CatalogFieldValueSet(c_gameCatalogAbil, abilityType, basePath + ".MaxCount", owner, IntToString(cap));
            CatalogFieldValueSet(c_gameCatalogAbil, abilityType, "MaxCount", owner, IntToString(cap));
            current = UnitMagazineCount(carrier, abilityType);
            if (current < cap) {
                UnitMagazineArm(carrier, AbilityCommand(abilityType, infoIndex), cap - current);
            }
            return true;
        }
    }
    return false;
}

void APRG_ReplenishEnemySelendisInterceptors(int player) {
    unitgroup units;
    unit u;
    int i;
    int owner;
    string unitType;
    units = UnitGroup(
        null, c_playerAny, RegionPlayableMap(),
        UnitFilter(0, 0, (1 << c_targetFilterStructure) | (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0
    );
    for (i = UnitGroupCount(units, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null || !UnitIsAlive(u)) { continue; }
        unitType = UnitGetType(u);
        if (!StringContains(unitType, "Selendis", c_stringAnywhere, c_stringNoCase)) { continue; }
        owner = UnitGetOwner(u);
        if (owner <= 0 || !libNtve_gf_PlayerIsEnemy(owner, player, libNtve_ge_PlayerRelation_Enemy)) { continue; }
        APRG_ArmInterceptorMagazineToCap(u, 8);
    }
}

string APRG_AirSupportType(int index) {
    if (index == 0) { return "Scout"; }
    if (index == 1) { return "VoidRay"; }
    if (index == 2) { return "Battlecruiser"; }
    if (index == 3) { return "Carrier"; }
    if (index == 4) { return "Tempest"; }
    if (index == 5) { return "Banshee"; }
    if (index == 6) { return "BroodLord"; }
    if (index == 7) { return "Guardian"; }
    if (index == 8) { return "Mutalisk"; }
    if (index == 9) { return "Mothership"; }
    if (index == 10) { return "Raven"; }
    return "";
}

void APRG_SpawnAirSupport(int player) {
    unit base;
    point p;
    string unitType;
    int attempt;
    unitgroup created;
    unit supportUnit;
    if (!APRG_PlayerMacroBaseReady(player)) {
        return;
    }
    base = APRG_FindPlayerHomeStructure(player);
    if (base == null) {
        return;
    }
    p = PointWithOffsetPolar(UnitGetPosition(base), 6.0, libNtve_gf_RandomAngle());
    for (attempt = 0; attempt < 10; attempt += 1) {
        unitType = APRG_AirSupportType(RandomInt(0, 10));
        if (CatalogEntryIsValid(c_gameCatalogUnit, unitType)) {
            if (unitType == "Scout" || unitType == "Mothership") {
                created = APRG_CreatePlayerUnitsVanillaSafe(1, unitType, player, p, libNtve_gf_RandomAngle());
            }
            else {
                created = APRG_CreatePlayerUnitsSafe(1, unitType, player, p, libNtve_gf_RandomAngle());
            }
            if (unitType == "Raven" && created != null && UnitGroupCount(created, c_unitCountAlive) > 0) {
                supportUnit = UnitGroupUnitFromEnd(created, 1);
                if (supportUnit != null) { UnitSetPropertyFixed(supportUnit, c_unitPropEnergy, UnitGetPropertyFixed(supportUnit, c_unitPropEnergyMax, c_unitPropCurrent)); }
            }
            if (unitType == "Carrier" && created != null && UnitGroupCount(created, c_unitCountAlive) > 0) {
                supportUnit = UnitGroupUnitFromEnd(created, 1);
                if (supportUnit != null) {
                    UnitGroupAdd(g_aprgAirSupportCarriers, supportUnit);
                    APRG_ArmInterceptorMagazineToCap(supportUnit, 8);
                }
            }
            UnitGroupAddUnitGroup(g_aprgAirSupportUnits, created);
            APRG_AddAlliedSupport(created, p, player, true);
            if (!g_aprgAirSupportVOCued && created != null && UnitGroupCount(created, c_unitCountAlive) > 0) {
                g_aprgAirSupportVOCued = true;
                APRG_QueueCampaignVO("TValerian01Raynor00043", 2.5);
            }
            return;
        }
    }
}

void APRG_ReplenishAirSupportCarriers() {
    int i;
    int count;
    int cap;
    int owner;
    int player;
    unit u;
    player = APRG_GetPrimaryPlayer();
    i = UnitGroupCount(g_aprgAirSupportCarriers, c_unitCountAlive);
    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(g_aprgAirSupportCarriers, i);
        if (u == null) { break; }
        if (!APRG_CarrierGetsFreeInterceptors(u)) { continue; }
        owner = UnitGetOwner(u);
        cap = 8;
        if (
            APRG_HasExtension4(APRG_EXT4_BOON_TRUE_CARRIERS) &&
            APRG_IsFriendlyCarrierOwner(owner, player)
        ) {
            APRG_SetTrueCarrierCapacityForOwner(owner);
            cap = 100;
        }
        if (APRG_IsFriendlyCarrierOwner(owner, player) && !APRG_HasExtension4(APRG_EXT4_BOON_TRUE_CARRIERS)) { continue; }
        APRG_ArmInterceptorMagazineToCap(u, cap);
    }
}

void APRG_GiveFireSquadIfReady(int player) {
    point p;
    unit home;
    string colossusType = "";
    if (g_aprgFireSquadGiven || !APRG_PlayerMacroBaseReady(player)) { return; }
    home = APRG_FindPlayerHomeStructure(player);
    if (home == null) { return; }
    p = APRG_PlayerSafeSpawnPoint(player, PointWithOffsetPolar(UnitGetPosition(home), 7.0, libNtve_gf_RandomAngle()));
    if (p == null) { return; }
    APRG_CreatePlayerUnitsSafe(3, "Firebat", player, p, libNtve_gf_RandomAngle());
    APRG_CreatePlayerUnitsSafe(2, "Hellion", player, p, libNtve_gf_RandomAngle());
    if (APRG_PlayerSpawnCandidateHealthy(player, "HellionTank", false)) {
        APRG_CreatePlayerUnitsSafe(2, "HellionTank", player, p, libNtve_gf_RandomAngle());
    }
    else if (APRG_PlayerSpawnCandidateHealthy(player, "Hellbat", false)) {
        APRG_CreatePlayerUnitsSafe(2, "Hellbat", player, p, libNtve_gf_RandomAngle());
    }
    else {
        APRG_CreatePlayerUnitsSafe(2, "Hellion", player, p, libNtve_gf_RandomAngle());
    }
    if (APRG_PlayerSpawnCandidateHealthy(player, "AP_ColossusPurifier", false)) { colossusType = "AP_ColossusPurifier"; }
    else if (APRG_PlayerSpawnCandidateHealthy(player, "ColossusPurifier", false)) { colossusType = "ColossusPurifier"; }
    // Do not silently replace the Purification Colossus with the Aiur/default model.
    if (colossusType != "") { APRG_CreatePlayerUnitsSafe(1, colossusType, player, p, libNtve_gf_RandomAngle()); }
    g_aprgFireSquadGiven = true;
}

void APRG_GiveFuelPipeline(int player) {
    if (!APRG_PlayerMacroBaseReady(player)) {
        return;
    }
    PlayerModifyPropertyInt(player, c_playerPropVespene, c_playerPropOperSetTo, PlayerGetPropertyInt(player, c_playerPropVespene) + 3);
}

void APRG_ApplyRapidEvolution(int player) {
    unitgroup units;
    int i;
    unit u;
    fixed hp;
    if (!APRG_PlayerMacroBaseReady(player)) { return; }
    units = APRG_PlayerMobileUnits(player);
    i = UnitGroupCount(units, c_unitCountAlive);
    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null) { break; }
        hp = UnitGetPropertyFixed(u, c_unitPropLifeMax, c_unitPropCurrent);
        UnitSetPropertyFixed(u, c_unitPropLifeMax, hp + 1.0);
    }
}

void APRG_ApplyCompoundingInterest(int player) {
    int minerals;
    if (!APRG_PlayerMacroBaseReady(player)) {
        return;
    }
    minerals = PlayerGetPropertyInt(player, c_playerPropMinerals);
    PlayerModifyPropertyInt(player, c_playerPropMinerals, c_playerPropOperSetTo, (minerals * 11) / 10);
}

void APRG_SetTransportLife(unitgroup created, fixed life) {
    int i;
    unit transport;
    if (created == null) { return; }
    for (i = UnitGroupCount(created, c_unitCountAlive); i > 0; i -= 1) {
        transport = UnitGroupUnitFromEnd(created, i);
        if (transport == null) { continue; }
        UnitSetPropertyFixed(transport, c_unitPropLifeMax, life);
        UnitSetPropertyFixed(transport, c_unitPropLife, life);
    }
}

void APRG_EnsureDropperlordTransport(unitgroup created) {
    int i;
    unit transport;
    if (created == null || !CatalogEntryIsValid(c_gameCatalogAbil, "OverlordTransport")) { return; }
    for (i = UnitGroupCount(created, c_unitCountAlive); i > 0; i -= 1) {
        transport = UnitGroupUnitFromEnd(created, i);
        if (transport == null) { continue; }
        if (!UnitAbilityExists(transport, "OverlordTransport")) { UnitAbilityAdd(transport, "OverlordTransport"); }
        UnitAbilityShow(transport, "OverlordTransport", true);
        UnitAbilityEnable(transport, "OverlordTransport", true);
    }
}

void APRG_GiveTransportsIfReady(int player) {
    unit base;
    point p;
    unitgroup created;
    if (g_aprgTransportsGiven || !APRG_PlayerMacroBaseReady(player)) { return; }
    base = APRG_FindPlayerHomeStructure(player);
    if (base == null) { return; }
    p = PointWithOffsetPolar(UnitGetPosition(base), 7.0, libNtve_gf_RandomAngle());

    if (CatalogEntryIsValid(c_gameCatalogUnit, "Hercules")) {
        created = APRG_CreatePlayerUnitsSafe(1, "Hercules", player, p, libNtve_gf_RandomAngle());
        APRG_SetTransportLife(created, 1000.0);
    }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "Medivac")) {
        created = APRG_CreatePlayerUnitsSafe(1, "Medivac", player, p, libNtve_gf_RandomAngle());
        APRG_SetTransportLife(created, 500.0);
    }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "OverlordTransport")) {
        created = APRG_CreatePlayerUnitsSafe(1, "OverlordTransport", player, p, libNtve_gf_RandomAngle());
        APRG_SetTransportLife(created, 500.0);
        APRG_EnsureDropperlordTransport(created);
    }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "WarpPrism")) {
        created = APRG_CreatePlayerUnitsSafe(1, "WarpPrism", player, p, libNtve_gf_RandomAngle());
        APRG_SetTransportLife(created, 500.0);
    }
    g_aprgTransportsGiven = true;
}

void APRG_SpawnLostViking(int player) {
    point p;
    string unitType = "VikingFighter";
    if (!APRG_PlayerMacroBaseReady(player)) {
        return;
    }
    p = RegionRandomPoint(RegionPlayableMap());
    if (p == null) {
        return;
    }
    if (!CatalogEntryIsValid(c_gameCatalogUnit, unitType)) {
        unitType = "Viking";
    }
    if (CatalogEntryIsValid(c_gameCatalogUnit, unitType)) {
        APRG_CreatePlayerUnitsSafe(1, unitType, player, p, libNtve_gf_RandomAngle());
    }
}

void APRG_SpawnWarfieldOmegaCluster(int player, point center) {
    int i;
    point p;
    APRG_PlayWarfieldVO("029");
    for (i = 0; i < 3; i += 1) {
        p = PointWithOffsetPolar(center, RandomFixed(1.0, 4.0), libNtve_gf_RandomAngle());
        if (p == null || !RegionContainsPoint(RegionPlayableMap(), p)) { p = center; }
        if (!APRG_QueueRealDropPod(APRG_DROP_KIND_WARFIELD_OMEGA, player, p, null)) {
            APRG_ResolveWarfieldOmegaDrop(player, p);
        }
    }
}

void APRG_SpawnWarfieldReinforcements(int player) {
    point p;
    int i;
    for (i = 0; i < 2; i += 1) {
        p = APRG_FindAlliedRaidOriginGroundPoint(player);
        if (p == null) { continue; }
        if (RandomInt(1, 100) <= 5) { APRG_SpawnWarfieldOmegaCluster(player, p); continue; }
        if (!APRG_QueueRealDropPod(APRG_DROP_KIND_WARFIELD, player, p, null)) {
            APRG_ResolveWarfieldDrop(player, p);
            g_aprgWarfieldNormalDropCount += 1;
        }
    }
}

void APRG_TickWarfieldBurst(int player, fixed now) {
    return;
}


void APRG_ApplyDarkness(int player) {
    unitgroup units = APRG_PlayerAllUnits(player);
    int i = UnitGroupCount(units, c_unitCountAlive);
    unit u;
    string unitType;
    string key;
    fixed sight;
    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null) { break; }
        unitType = UnitGetType(u);
        key = "APRG_Darkness_" + IntToString(player) + "_" + unitType;
        if (DataTableGetBool(true, key)) { continue; }
        sight = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "Sight", player));
        sight = MaxF(0.0, sight - 4.0);
        CatalogFieldValueSet(c_gameCatalogUnit, unitType, "Sight", player, FixedToString(sight, c_fixedPrecisionAny));
        DataTableSetBool(true, key, true);
    }
}

void APRG_ApplyAdrenaline(int player) {
    unitgroup units = APRG_EnemyAllUnits(player);
    int i = UnitGroupCount(units, c_unitCountAlive);
    unit u;
    int owner;
    string unitType;
    string unitKey;
    fixed speed;
    int weaponIndex;
    int weaponCount;
    string weaponType;
    string weaponKey;
    fixed period;
    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null) { break; }
        owner = UnitGetOwner(u);
        if (owner < 0) { continue; }
        unitType = UnitGetType(u);
        unitKey = "APRG_AdrenalineUnit_" + IntToString(owner) + "_" + unitType;
        if (!DataTableGetBool(true, unitKey)) {
            speed = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "Speed", owner));
            if (speed > 0.0) {
                CatalogFieldValueSet(c_gameCatalogUnit, unitType, "Speed", owner, FixedToString(speed * 1.3, c_fixedPrecisionAny));
            }
            DataTableSetBool(true, unitKey, true);
        }

        weaponCount = UnitWeaponCount(u);
        weaponIndex = 1;
        for (; weaponIndex <= weaponCount; weaponIndex += 1) {
            weaponType = UnitWeaponGet(u, weaponIndex);
            if (weaponType == "") { continue; }
            weaponKey = "APRG_AdrenalineWeapon_" + IntToString(owner) + "_" + weaponType;
            if (DataTableGetBool(true, weaponKey)) { continue; }
            period = StringToFixed(CatalogFieldValueGet(c_gameCatalogWeapon, weaponType, "Period", owner));
            if (period > 0.0) {
                CatalogFieldValueSet(c_gameCatalogWeapon, weaponType, "Period", owner, FixedToString(period / 1.3, c_fixedPrecisionAny));
            }
            DataTableSetBool(true, weaponKey, true);
        }
    }
}

void APRG_ApplyPickyEaters(int player) {
    int count;
    int i;
    string unitType;
    fixed made;
    if (g_aprgPickyCatalogApplied) { return; }

    count = CatalogEntryCount(c_gameCatalogUnit);
    if (count > 4096) { count = 4096; }
    for (i = 1; i <= count; i += 1) {
        unitType = CatalogEntryGet(c_gameCatalogUnit, i);
        if (unitType == "") { continue; }
        made = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "Food", player));
        if (made > 4.0) {
            CatalogFieldValueSet(c_gameCatalogUnit, unitType, "Food", player, "4");
        }
    }
    g_aprgPickyCatalogApplied = true;
}


void APRG_ApplyRisingGasPrices(int player) {
    int count;
    int i;
    string unitType;
    fixed gasCost;
    if (g_aprgRisingGasApplied) { return; }

    count = CatalogEntryCount(c_gameCatalogUnit);
    if (count > 4096) { count = 4096; }
    i = 1;
    for (; i <= count; i += 1) {
        unitType = CatalogEntryGet(c_gameCatalogUnit, i);
        if (unitType == "") { continue; }
        gasCost = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "CostResource[1]", player));
        if (gasCost <= 0.0) { continue; }
        // Resource costs must be written as integers: fractional catalog costs
        // can be rejected by SC2 and silently revert to their original value.
        // Read the current price so earlier reductions (e.g. Horde Mode) remain.
        CatalogFieldValueSet(
            c_gameCatalogUnit, unitType, "CostResource[1]", player,
            IntToString(MaxI(1, FixedToInt(RoundI(gasCost * 1.5))))
        );
    }
    g_aprgRisingGasApplied = true;
}

void APRG_AdvanceArmsRace(int player) {
    unitgroup enemies = APRG_EnemyAllUnits(player);
    int i = UnitGroupCount(enemies, c_unitCountAlive);
    unit u;
    int owner;
    string key;
    string weaponType;
    string effectType;
    int weaponIndex;
    int weaponCount;
    fixed currentAmount;
    fixed priorMultiplier;
    fixed baseEstimate;
    fixed increment;

    g_aprgArmsRaceStacks += 1;

    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(enemies, i);
        if (u == null) { break; }
        owner = UnitGetOwner(u);
        if (owner < 0) { continue; }
        weaponCount = UnitWeaponCount(u);
        weaponIndex = 1;
        for (; weaponIndex <= weaponCount; weaponIndex += 1) {
            weaponType = UnitWeaponGet(u, weaponIndex);
            if (weaponType == "") { continue; }
            effectType = CatalogFieldValueGet(c_gameCatalogWeapon, weaponType, "DisplayEffect", owner);
            if (effectType == "" || !CatalogEntryIsValid(c_gameCatalogEffect, effectType)) { continue; }
            key = "APRG_ArmsDamage_" + IntToString(g_aprgArmsRaceStacks) + "_" + IntToString(owner) + "_" + effectType;
            if (DataTableGetBool(true, key)) { continue; }
            currentAmount = StringToFixed(CatalogFieldValueGet(c_gameCatalogEffect, effectType, "Amount", owner));
            if (currentAmount <= 0.0) { continue; }
            priorMultiplier = 1.0 + (0.1 * (g_aprgArmsRaceStacks - 1));
            baseEstimate = currentAmount / priorMultiplier;
            increment = baseEstimate * 0.1;
            CatalogFieldValueModify(c_gameCatalogEffect, effectType, "Amount", owner, FixedToString(increment, c_fixedPrecisionAny), c_upgradeOperationAdd);
            DataTableSetBool(true, key, true);
        }
    }
}

void APRG_ApplyJuggernaut(int player) {
    unitgroup units = APRG_PlayerMobileUnits(player);
    unitgroup workers = APRG_PlayerWorkers(player);
    int i = UnitGroupCount(units, c_unitCountAlive);
    unit u;
    string unitType;
    string key;
    fixed supply;
    bool isWorker;

    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null) { break; }
        unitType = UnitGetType(u);
        isWorker = UnitGroupHasUnit(workers, u);

        key = "APRG_JuggernautArmor_" + IntToString(player) + "_" + unitType;
        if (!DataTableGetBool(true, key)) {
            supply = DataTableGetFixed(true, "APRG_HordeOriginalSupply_" + IntToString(player) + "_" + unitType);
            if (supply <= 0.0) { supply = UnitTypeGetProperty(unitType, c_unitPropSuppliesUsed); }
            if (supply > 0.0) {
                CatalogFieldValueModify(c_gameCatalogUnit, unitType, "LifeArmor", player, FixedToString(supply, c_fixedPrecisionAny), c_upgradeOperationAdd);
                CatalogFieldValueModify(c_gameCatalogUnit, unitType, "ShieldArmor", player, FixedToString(supply, c_fixedPrecisionAny), c_upgradeOperationAdd);
            }
            DataTableSetBool(true, key, true);
        }

        if (!isWorker && !UnitHasBehavior(u, "APRogueJuggernautSlow")) {
            UnitBehaviorAdd(u, "APRogueJuggernautSlow", u, 1);
        }
    }
}

void APRG_ApplyAssemblyCatalog(int player) {
    int count;
    int i;
    int infoCount;
    int infoIndex;
    string unitType;
    string abilityType;
    string basePath;
    string producedUnit;
    string researchedUpgrade;
    fixed buildTime;
    fixed entryTime;
    if (g_aprgAssemblyCatalogApplied) { return; }

    count = CatalogEntryCount(c_gameCatalogUnit);
    if (count > 4096) { count = 4096; }
    for (i = 1; i <= count; i += 1) {
        unitType = CatalogEntryGet(c_gameCatalogUnit, i);
        if (unitType == "") { continue; }
        buildTime = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "BuildTime", player));
        if (buildTime > 0.0) {
            CatalogFieldValueSet(c_gameCatalogUnit, unitType, "BuildTime", player, FixedToString(buildTime * 0.5, c_fixedPrecisionAny));
        }
    }

    count = CatalogEntryCount(c_gameCatalogAbil);
    if (count > 4096) { count = 4096; }
    for (i = 1; i <= count; i += 1) {
        abilityType = CatalogEntryGet(c_gameCatalogAbil, i);
        if (abilityType == "") { continue; }
        infoCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, "InfoArray", player);
            for (infoIndex = 0; infoIndex < infoCount; infoIndex += 1) {
            basePath = "InfoArray[" + IntToString(infoIndex) + "]";
            producedUnit = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, basePath + ".Unit", player);
            researchedUpgrade = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, basePath + ".Upgrade", player);
            if (producedUnit == "" && researchedUpgrade == "") { continue; }
            entryTime = StringToFixed(CatalogFieldValueGet(c_gameCatalogAbil, abilityType, basePath + ".Time", player));
            if (entryTime > 0.0) {
                CatalogFieldValueSet(c_gameCatalogAbil, abilityType, basePath + ".Time", player, FixedToString(entryTime * 0.5, c_fixedPrecisionAny));
            }
        }
    }
    g_aprgAssemblyCatalogApplied = true;
}

void APRG_ApplyEliteToGroup(int player, unitgroup units, bool allowMovement) {
    int i = UnitGroupCount(units, c_unitCountAlive);
    unit u;
    string unitType;
    string trainedKey;
    fixed value;
    fixed oldMax;
    fixed oldCurrent;
    fixed ratio;
    fixed maxRange;
    fixed weaponRange;
    fixed lifeArmor;
    fixed shieldArmor;
    int wi;
    int wc;
    int stacks;

    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null) { break; }
        if (UnitGroupHasUnit(g_aprgEliteProcessed, u)) { continue; }
        unitType = UnitGetType(u);

        if (allowMovement) {
            trainedKey = "APRG_EliteTrained_" + IntToString(UnitGetTag(u));
            if (!DataTableGetBool(true, trainedKey)) { continue; }
        }

        oldMax = UnitGetPropertyFixed(u, c_unitPropLifeMax, c_unitPropCurrent);
        oldCurrent = UnitGetPropertyFixed(u, c_unitPropLife, c_unitPropCurrent);
        if (oldMax > 0.0) {
            ratio = oldCurrent / oldMax;
            UnitSetPropertyFixed(u, c_unitPropLifeMax, oldMax * 1.15);
            UnitSetPropertyFixed(u, c_unitPropLife, oldMax * 1.15 * ratio);
        }
        oldMax = UnitGetPropertyFixed(u, c_unitPropShieldsMax, c_unitPropCurrent);
        oldCurrent = UnitGetPropertyFixed(u, c_unitPropShields, c_unitPropCurrent);
        if (oldMax > 0.0) {
            ratio = oldCurrent / oldMax;
            UnitSetPropertyFixed(u, c_unitPropShieldsMax, oldMax * 1.15);
            UnitSetPropertyFixed(u, c_unitPropShields, oldMax * 1.15 * ratio);
        }
        oldMax = UnitGetPropertyFixed(u, c_unitPropEnergyMax, c_unitPropCurrent);
        oldCurrent = UnitGetPropertyFixed(u, c_unitPropEnergy, c_unitPropCurrent);
        if (oldMax > 0.0) {
            ratio = oldCurrent / oldMax;
            UnitSetPropertyFixed(u, c_unitPropEnergyMax, oldMax * 1.15);
            UnitSetPropertyFixed(u, c_unitPropEnergy, oldMax * 1.15 * ratio);
        }

        value = UnitGetPropertyFixed(u, c_unitPropLifeRegen, c_unitPropCurrent);
        if (value > 0.0) { UnitSetPropertyFixed(u, c_unitPropLifeRegen, value * 1.15); }
        value = UnitGetPropertyFixed(u, c_unitPropShieldsRegen, c_unitPropCurrent);
        if (value > 0.0) { UnitSetPropertyFixed(u, c_unitPropShieldsRegen, value * 1.15); }
        value = UnitGetPropertyFixed(u, c_unitPropEnergyRegen, c_unitPropCurrent);
        if (value > 0.0) { UnitSetPropertyFixed(u, c_unitPropEnergyRegen, value * 1.15); }

        if (CatalogEntryIsValid(c_gameCatalogBehavior, "APRogueEliteTrainedCore")) {
            UnitBehaviorAdd(u, "APRogueEliteTrainedCore", u, 1);
        }

        maxRange = 0.0;
        wc = UnitWeaponCount(u);
        for (wi = 1; wi <= wc; wi += 1) {
            weaponRange = UnitWeaponRange(u, wi);
            if (weaponRange > maxRange) { maxRange = weaponRange; }
        }
        if (maxRange > 0.0 && CatalogEntryIsValid(c_gameCatalogBehavior, "APRogueEliteRange005")) {
            stacks = MaxI(1, FixedToInt(RoundI(maxRange * 3.0)));
            UnitBehaviorAdd(u, "APRogueEliteRange005", u, stacks);
        }

        lifeArmor = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "LifeArmor", player));
        if (lifeArmor > 0.0 && CatalogEntryIsValid(c_gameCatalogBehavior, "APRogueEliteLifeArmor005")) {
            stacks = MaxI(1, FixedToInt(RoundI(lifeArmor * 3.0)));
            UnitBehaviorAdd(u, "APRogueEliteLifeArmor005", u, stacks);
        }
        shieldArmor = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "ShieldArmor", player));
        if (shieldArmor > 0.0 && CatalogEntryIsValid(c_gameCatalogBehavior, "APRogueEliteShieldArmor005")) {
            stacks = MaxI(1, FixedToInt(RoundI(shieldArmor * 3.0)));
            UnitBehaviorAdd(u, "APRogueEliteShieldArmor005", u, stacks);
        }

        UnitGroupAdd(g_aprgEliteProcessed, u);
    }
}

void APRG_ApplyEliteSoldiers(int player) {
    APRG_ApplyEliteToGroup(player, APRG_PlayerMobileUnits(player), true);
    APRG_ApplyEliteToGroup(player, APRG_PlayerStructures(player), false);
}

void APRG_DealExplosiveArmorDamage(point p, int player, fixed damage, fixed radius) {
    unitgroup enemies;
    int i;
    unit target;
    fixed shields;
    fixed life;
    fixed remaining;
    if (p == null || damage <= 0.0 || radius <= 0.0) { return; }
    enemies = UnitGroupAlliance(player, c_unitAllianceEnemy, RegionCircle(p, radius),
        UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    for (i = UnitGroupCount(enemies, c_unitCountAlive); i > 0; i -= 1) {
        target = UnitGroupUnitFromEnd(enemies, i); if (target == null) { break; }
        // Campaign objective death must be registered by the native mission.
        // Slay's explosive armor is a scripted property subtraction/UnitKill.
        if (APRG_IsCampaignNullCircuit(target)) { continue; }
        remaining = damage;
        shields = UnitGetPropertyFixed(target, c_unitPropShields, c_unitPropCurrent);
        if (shields > 0.0) { if (shields >= remaining) { UnitSetPropertyFixed(target, c_unitPropShields, shields - remaining); remaining = 0.0; } else { UnitSetPropertyFixed(target, c_unitPropShields, 0.0); remaining -= shields; } }
        if (remaining > 0.0) { life = UnitGetPropertyFixed(target, c_unitPropLife, c_unitPropCurrent); if (life <= remaining) { UnitKill(target); } else { UnitSetPropertyFixed(target, c_unitPropLife, life - remaining); } }
    }
}

bool APRG_InstantWorkers_Func(bool testConds, bool runActions) {
    string unitType;
    if (!runActions || !g_aprgStarted || !APRG_HasBlessing(APRG_BLESS_INSTANT_WORKERS)) {
        return true;
    }
    if (EventPlayer() != APRG_GetPrimaryPlayer()) {
        return true;
    }
    unitType = libNtve_gf_TriggeringProgressUnitType();
    if (
        unitType == "SCV" || unitType == "Drone" || unitType == "Probe" ||
        unitType == "AP_SCV" || unitType == "AP_Drone" || unitType == "AP_Probe"
    ) {
        UnitSetProgressComplete(EventUnit(), 1, 100);
    }
    return true;
}

void APRG_SpawnZombie(point p, int owner, bool allied, int player) {
    unitgroup created;
    if (!CatalogEntryIsValid(c_gameCatalogUnit, "InfestedCivilian")) {
        return;
    }
    created = UnitCreate(1, "InfestedCivilian", c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
    if (UnitGroupCount(created, c_unitCountAlive) > 0) {
        DataTableSetBool(true, "APRG_BasicZombie_" + IntToString(UnitGetTag(UnitGroupUnitFromEnd(created, 1))), true);
    }
    if (allied) {
        APRG_AddAlliedZombies(created, player);
    }
    else {
        APRG_AddHostileRaiders(created, p, player);
        if (!g_aprgHostileZombieVOCued && created != null && UnitGroupCount(created, c_unitCountAlive) > 0) {
            g_aprgHostileZombieVOCued = true;
            APRG_QueueCampaignVO("THanson02BriefingHanson00001", 0.0);
        }
    }
}

void APRG_QueueEnemyRespawn(unit dead, int player, fixed now) {
    int i;
    int owner;
    string unitType;
    fixed speed;
    if (dead == null || RandomInt(1, 100) > 50) { return; }
    owner = UnitGetOwner(dead);
    if (owner < 0 || !libNtve_gf_PlayerIsEnemy(owner, player, libNtve_ge_PlayerRelation_Enemy)) { return; }
    unitType = UnitGetType(dead);
    if (unitType == "" || !CatalogEntryIsValid(c_gameCatalogUnit, unitType)) { return; }
    if (StringContains(unitType, "Interceptor", c_stringAnywhere, c_stringNoCase)) { return; }
    speed = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "Speed", owner));
    if (speed <= 0.0) { return; }
    for (i = 0; i < APRG_MAX_RESPAWN_QUEUE; i += 1) {
        if (g_aprgRespawnState[i] != 0) { continue; }
        g_aprgRespawnState[i] = 1;
        g_aprgRespawnType[i] = unitType;
        g_aprgRespawnOwner[i] = owner;
        g_aprgRespawnPoint[i] = UnitGetPosition(dead);
        g_aprgRespawnTime[i] = now + 60.0;
        return;
    }
}

bool APRG_IsForAiurZealotType(string unitType) {
    if (unitType == "") { return false; }
    return StringContains(unitType, "Zealot", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Sentinel", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Centurion", c_stringAnywhere, c_stringNoCase);
}

bool APRG_IsReaperBoonType(string unitType) {
    if (unitType == "") { return false; }
    return StringContains(unitType, "Reaper", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "DeathHead", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Death Head", c_stringAnywhere, c_stringNoCase);
}

bool APRG_IsMarineBoonType(string unitType) {
    if (unitType == "") { return false; }
    return StringContains(unitType, "Marine", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "WarPig", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "War Pig", c_stringAnywhere, c_stringNoCase);
}

string APRG_CanonicalProtossReinforcementType(string requested) {
    if (StringContains(requested, "Zealot", c_stringAnywhere, c_stringNoCase) ||
        StringContains(requested, "Sentinel", c_stringAnywhere, c_stringNoCase) ||
        StringContains(requested, "Centurion", c_stringAnywhere, c_stringNoCase)) { return "Zealot"; }
    if (requested == "Stalker") { return "Stalker"; }
    if (requested == "Adept") { return "Adept"; }
    if (requested == "Sentry") { return "Sentry"; }
    if (requested == "HighTemplar") { return "HighTemplar"; }
    if (requested == "DarkTemplar") { return "DarkTemplar"; }
    if (requested == "Immortal") { return "Immortal"; }
    if (requested == "Colossus") { return "Colossus"; }
    if (requested == "Archon") { return "Archon"; }
    if (requested == "Dragoon") { return "Dragoon"; }
    if (requested == "Reaver") { return "Reaver"; }
    if (requested == "Scout") { return "Scout"; }
    if (requested == "Phoenix") { return "Phoenix"; }
    if (requested == "VoidRay") { return "VoidRay"; }
    if (requested == "Carrier") { return "Carrier"; }
    if (requested == "Tempest") { return "Tempest"; }
    if (requested == "Observer") { return "Observer"; }
    if (requested == "WarpPrism") { return "WarpPrism"; }
    if (requested == "Oracle") { return "Oracle"; }
    if (requested == "Arbiter") { return "Arbiter"; }
    return requested;
}

actor APRG_CreateWarpVisual(unit u, point at) {
    actor fx;
    if (u == null || at == null) { return null; }
    // The native LotV Purifier warp script attaches this model with inherited
    // visibility at Ref_Origin (not Ref_Center). Both hostile Nexus Shields /
    // Purifier waves and allied For Aiur waves use this same helper.
    if (CatalogEntryIsValid(c_gameCatalogModel, "ProtossGenericWarpInOut")) {
        fx = libNtve_gf_AttachModelToUnitInheritVisibility(u, "ProtossGenericWarpInOut", "Ref_Origin");
        if (fx != null) { return fx; }
    }
    // Some WoL/HotS mission catalogs do not provide the LotV generic model.
    // A real, native Protoss teleport-in MODEL from the Liberty campaign is a
    // visible fallback; the marker actor alone is not a full warp animation.
    if (CatalogEntryIsValid(c_gameCatalogModel, "MothershipTeleportIn")) {
        fx = libNtve_gf_AttachModelToUnitInheritVisibility(u, "MothershipTeleportIn", "Ref_Origin");
        if (fx != null) {
            ActorSend(fx, libNtve_gf_SetScale(0.45, 0.45, 0.45, 0.0));
            return fx;
        }
    }
    return libNtve_gf_CreateActorAtPoint("ProtossFastWarpinMarker", at);
}

bool APRG_QueueAllyWarp(string unitType, int owner, point center, fixed when) {
    int i;
    if (unitType == "" || center == null || owner < 0) { return false; }
    unitType = APRG_CanonicalProtossReinforcementType(unitType);
    for (i = 0; i < 512; i += 1) {
        if (g_aprgAllyWarpState[i] != 0) { continue; }
        g_aprgAllyWarpState[i] = 1;
        g_aprgAllyWarpOwner[i] = owner;
        g_aprgAllyWarpType[i] = unitType;
        g_aprgAllyWarpPoint[i] = center;
        g_aprgAllyWarpTime[i] = when;
        g_aprgAllyWarpActor[i] = null;
        g_aprgAllyWarpUnit[i] = null;
        g_aprgAllyWarpPurifierAlliance[i] = (g_aprgPurifierAlliance != null && UnitIsAlive(g_aprgPurifierAlliance) && owner == UnitGetOwner(g_aprgPurifierAlliance));
        return true;
    }
    return false;
}

void APRG_ProcessAllyWarpQueue(int player, fixed now) {
    int i;
    int best = -1;
    fixed bestTime = 99999999.0;
    point spawnPoint;
    unitgroup created;
    unitgroup ready;
    unit u;
    int j;
    actor mainActor;
    for (i = 0; i < 512; i += 1) {
        if (g_aprgAllyWarpState[i] == 0 || g_aprgAllyWarpTime[i] > now) { continue; }
        if (best < 0 || g_aprgAllyWarpTime[i] < bestTime) {
            best = i;
            bestTime = g_aprgAllyWarpTime[i];
        }
    }
    if (best < 0) { return; }

    if (g_aprgAllyWarpState[best] == 1) {
        spawnPoint = APRG_FindGroundPointNear(g_aprgAllyWarpPoint[best], 1.0, 7.0);
        if (spawnPoint == null) { spawnPoint = g_aprgAllyWarpPoint[best]; }
        g_aprgAllyWarpPoint[best] = spawnPoint;
        if (!CatalogEntryIsValid(c_gameCatalogUnit, g_aprgAllyWarpType[best])) {
            g_aprgAllyWarpState[best] = 0;
            return;
        }
        created = UnitCreate(1, g_aprgAllyWarpType[best], c_unitCreateIgnorePlacement,
            g_aprgAllyWarpOwner[best], spawnPoint, libNtve_gf_RandomAngle());
        if (created == null || UnitGroupCount(created, c_unitCountAlive) <= 0) {
            g_aprgAllyWarpState[best] = 0;
            return;
        }
        u = UnitGroupUnitFromEnd(created, 1);
        if (u == null) { g_aprgAllyWarpState[best] = 0; return; }
        g_aprgAllyWarpUnit[best] = u;
        APRG_MakeGroupUncommandable(created);
        for (j = UnitGroupCount(created, c_unitCountAlive); j > 0; j -= 1) {
            u = UnitGroupUnitFromEnd(created, j);
            if (u != null) {
                UnitSetState(u, c_unitStateUsingSupply, false);
                UnitGroupAdd(g_aprgClonedUnits, u);
            }
        }

        u = g_aprgAllyWarpUnit[best];
        libNtve_gf_PauseUnit(u, true);
        mainActor = libNtve_gf_MainActorofUnit(u);
        if (mainActor != null) {
            ActorSend(mainActor, libNtve_gf_SetOpacity(0.0, 0.0));
            ActorSend(mainActor, libNtve_gf_SetOpacity(1.0, 5.0));
        }
        g_aprgAllyWarpActor[best] = APRG_CreateWarpVisual(u, spawnPoint);
        if (CatalogEntryIsValid(c_gameCatalogBehavior, "ProtossGenericWarpInOut")) {
            UnitBehaviorAdd(u, "ProtossGenericWarpInOut", u, 1);
        }
        g_aprgAllyWarpState[best] = 2;
        g_aprgAllyWarpTime[best] = now + 5.0;
        return;
    }

    u = g_aprgAllyWarpUnit[best];
    if (u != null && UnitIsAlive(u)) {
        if (CatalogEntryIsValid(c_gameCatalogBehavior, "ProtossGenericWarpInOut")) {
            UnitBehaviorRemove(u, "ProtossGenericWarpInOut", 1);
        }
        mainActor = libNtve_gf_MainActorofUnit(u);
        if (mainActor != null) { ActorSend(mainActor, libNtve_gf_SetOpacity(1.0, 0.0)); }
        libNtve_gf_PauseUnit(u, false);
        ready = UnitGroupEmpty();
        UnitGroupAdd(ready, u);
        // Both Purifier Alliance and For Aiur units are uncommandable AI allies.
        // Keep them in the recurring support/ability-AI pool after the warp stun.
        UnitGroupAdd(g_aprgAlliedSupport, u);
        if (g_aprgAllyWarpPurifierAlliance[best]) { UnitGroupAdd(g_aprgPurifierAllianceReinforcements, u); }
        APRG_OrderGroupTowardNearestEnemyStructure(ready, UnitGetPosition(u), player);
    }
    if (g_aprgAllyWarpActor[best] != null) { ActorSend(g_aprgAllyWarpActor[best], "Destroy"); }
    g_aprgAllyWarpState[best] = 0;
    g_aprgAllyWarpOwner[best] = -1;
    g_aprgAllyWarpType[best] = "";
    g_aprgAllyWarpPoint[best] = null;
    g_aprgAllyWarpTime[best] = 0.0;
    g_aprgAllyWarpActor[best] = null;
    g_aprgAllyWarpUnit[best] = null;
    g_aprgAllyWarpPurifierAlliance[best] = false;
}

void APRG_QueueForAiurDeath(unit dead, point p) {
    int i;
    if (dead == null || p == null) { return; }
    for (i = 0; i < 128; i += 1) {
        if (g_aprgForAiurPendingState[i] != 0) { continue; }
        g_aprgForAiurPendingState[i] = 1;
        g_aprgForAiurPendingUnit[i] = dead;
        g_aprgForAiurPendingOwner[i] = UnitGetOwner(dead);
        g_aprgForAiurPendingType[i] = UnitGetType(dead);
        g_aprgForAiurPendingPoint[i] = p;
        g_aprgForAiurPendingTime[i] = GameGetMissionTime() + 1.0;
        return;
    }
}

bool APRG_ForAiurPendingWasSaved(int slot) {
    unit original;
    unitgroup rebound;
    unit candidate;
    int i;
    original = g_aprgForAiurPendingUnit[slot];
    if (original != null && UnitIsAlive(original) && UnitGetOwner(original) == g_aprgForAiurPendingOwner[slot]) {
        return true;
    }
    if (!StringContains(g_aprgForAiurPendingType[slot], "Sentinel", c_stringAnywhere, c_stringNoCase)) { return false; }
    rebound = UnitGroup(
        g_aprgForAiurPendingType[slot],
        g_aprgForAiurPendingOwner[slot],
        RegionCircle(g_aprgForAiurPendingPoint[slot], 0.55),
        UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))),
        0
    );
    for (i = UnitGroupCount(rebound, c_unitCountAlive); i > 0; i -= 1) {
        candidate = UnitGroupUnitFromEnd(rebound, i);
        if (candidate != null && UnitIsAlive(candidate)) { return true; }
    }
    return false;
}

void APRG_CreateForAiurWave(string deadType, point p, int player, fixed now) {
    int i;
    int count;
    int queued = 0;
    string supportType;
    string heavyType;
    if (p == null || deadType == "") { return; }

    count = RandomInt(3, 6);
    for (i = 0; i < count; i += 1) {
        if (APRG_QueueAllyWarp(deadType, player, p, now + 0.2 * IntToFixed(queued))) { queued += 1; }
    }
    count = RandomInt(0, 4);
    for (i = 0; i < count; i += 1) {
        if (APRG_QueueAllyWarp("Stalker", player, p, now + 0.2 * IntToFixed(queued))) { queued += 1; }
    }
    count = RandomInt(0, 4);
    for (i = 0; i < count; i += 1) {
        if (APRG_QueueAllyWarp("Adept", player, p, now + 0.2 * IntToFixed(queued))) { queued += 1; }
    }
    if (RandomInt(0, 1) == 0) { supportType = "Sentry"; }
    else { supportType = "HighTemplar"; }
    if (APRG_QueueAllyWarp(supportType, player, p, now + 0.2 * IntToFixed(queued))) { queued += 1; }
    i = RandomInt(0, 2);
    if (i == 0) { heavyType = "Immortal"; }
    else if (i == 1) { heavyType = "Colossus"; }
    else { heavyType = "Archon"; }
    APRG_QueueAllyWarp(heavyType, player, p, now + 0.2 * IntToFixed(queued));
}

void APRG_TickForAiurPending(int player, fixed now) {
    int i;
    for (i = 0; i < 128; i += 1) {
        if (g_aprgForAiurPendingState[i] == 0 || now < g_aprgForAiurPendingTime[i]) { continue; }
        if (!APRG_ForAiurPendingWasSaved(i)) {
            APRG_CreateForAiurWave(g_aprgForAiurPendingType[i], g_aprgForAiurPendingPoint[i], player, now);
        }
        g_aprgForAiurPendingState[i] = 0;
        g_aprgForAiurPendingUnit[i] = null;
        g_aprgForAiurPendingOwner[i] = -1;
        g_aprgForAiurPendingType[i] = "";
        g_aprgForAiurPendingPoint[i] = null;
        g_aprgForAiurPendingTime[i] = 0.0;
    }
}

void APRG_TickHitAndRun(int player) {
    unitgroup units;
    unit u;
    string unitType;
    string key;
    point current;
    point previous;
    int i;
    units = APRG_PlayerMobileUnits(player);
    for (i = UnitGroupCount(units, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null) { continue; }
        unitType = UnitGetType(u);
        if (!APRG_IsReaperBoonType(unitType)) { continue; }
        key = "APRG_HitRun_" + IntToString(UnitGetTag(u));
        current = UnitGetPosition(u);
        if (!DataTableGetBool(true, key + "_Init")) {
            DataTableSetFixed(true, key + "_X", PointGetX(current));
            DataTableSetFixed(true, key + "_Y", PointGetY(current));
            DataTableSetBool(true, key + "_Init", true);
            continue;
        }
        previous = Point(DataTableGetFixed(true, key + "_X"), DataTableGetFixed(true, key + "_Y"));
        if (DistanceBetweenPoints(previous, current) >= 0.08) {
            if (!UnitHasBehavior(u, "APRogueHitAndRun")) { UnitBehaviorAdd(u, "APRogueHitAndRun", u, 1); }
        }
        else if (UnitHasBehavior(u, "APRogueHitAndRun")) {
            UnitBehaviorRemove(u, "APRogueHitAndRun", c_unitBehaviorCountAll);
        }
        DataTableSetFixed(true, key + "_X", PointGetX(current));
        DataTableSetFixed(true, key + "_Y", PointGetY(current));
    }
}

void APRG_SpawnNoDeathsUltralisk(point p, int player) {
    int owner;
    unitgroup created;
    unit punishment;
    if (p == null || !CatalogEntryIsValid(c_gameCatalogUnit, "Ultralisk")) { return; }
    owner = APRG_FindHostileOwnerNearPoint(player, p);
    if (owner < 0) { return; }
    created = UnitCreate(1, "Ultralisk", c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
    if (created != null && UnitGroupCount(created, c_unitCountAlive) > 0 && CatalogEntryIsValid(c_gameCatalogBehavior, "AutoTurretTimedLife")) {
        punishment = UnitGroupUnitFromEnd(created, 1);
        if (punishment != null) {
            UnitBehaviorAdd(punishment, "AutoTurretTimedLife", punishment, 1);
            UnitBehaviorSetDuration(punishment, "AutoTurretTimedLife", 10.0);
            UnitBehaviorSetDurationRemaining(punishment, "AutoTurretTimedLife", 10.0);
        }
    }
    APRG_AddHostileRaiders(created, p, player);
}

void APRG_QueueNoDeathsUltralisk(unit dead, point p) {
    int i;
    if (dead == null || p == null) { return; }
    for (i = 0; i < 512; i += 1) {
        if (g_aprgNoDeathsPendingState[i] != 0) { continue; }
        g_aprgNoDeathsPendingState[i] = 1;
        g_aprgNoDeathsPendingUnit[i] = dead;
        g_aprgNoDeathsPendingOwner[i] = UnitGetOwner(dead);
        g_aprgNoDeathsPendingType[i] = UnitGetType(dead);
        g_aprgNoDeathsPendingPoint[i] = p;
        g_aprgNoDeathsPendingTime[i] = GameGetMissionTime() + 1.0;
        return;
    }
}

bool APRG_NoDeathsPendingUnitWasSaved(int slot) {
    unit original;
    unitgroup rebound;
    unit candidate;
    int i;
    original = g_aprgNoDeathsPendingUnit[slot];
    if (original != null && UnitIsAlive(original) && UnitGetOwner(original) == g_aprgNoDeathsPendingOwner[slot]) {
        return true;
    }
    if (g_aprgNoDeathsPendingType[slot] == "" || g_aprgNoDeathsPendingPoint[slot] == null) { return false; }
    rebound = UnitGroup(
        g_aprgNoDeathsPendingType[slot],
        g_aprgNoDeathsPendingOwner[slot],
        RegionCircle(g_aprgNoDeathsPendingPoint[slot], 0.55),
        UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))),
        0
    );
    for (i = UnitGroupCount(rebound, c_unitCountAlive); i > 0; i -= 1) {
        candidate = UnitGroupUnitFromEnd(rebound, i);
        if (candidate != null && UnitIsAlive(candidate)) { return true; }
    }
    return false;
}

void APRG_TickNoDeathsAllowed(int player, fixed now) {
    int i;
    for (i = 0; i < 512; i += 1) {
        if (g_aprgNoDeathsPendingState[i] == 0 || now < g_aprgNoDeathsPendingTime[i]) { continue; }
        if (!APRG_NoDeathsPendingUnitWasSaved(i)) {
            APRG_SpawnNoDeathsUltralisk(g_aprgNoDeathsPendingPoint[i], player);
        }
        g_aprgNoDeathsPendingState[i] = 0;
        g_aprgNoDeathsPendingUnit[i] = null;
        g_aprgNoDeathsPendingOwner[i] = -1;
        g_aprgNoDeathsPendingType[i] = "";
        g_aprgNoDeathsPendingPoint[i] = null;
        g_aprgNoDeathsPendingTime[i] = 0.0;
    }
}

void APRG_NuclearWorkerDeath(point p, int player) {
    int owner;
    if (p == null || !CatalogEntryIsValid(c_gameCatalogEffect, "NukeDamage")) { return; }
    owner = APRG_FindHostileOwnerNearPoint(player, p);
    if (owner < 0) { return; }
    APRG_CreateObjectiveSafeSlayEffect(owner, "NukeDamage", p, 12.0);
}

bool APRG_IsWorkerTypeForDeath(string unitType) {
    if (unitType == "") { return false; }
    return StringContains(unitType, "SCV", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Drone", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Probe", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "MULE", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Worker", c_stringAnywhere, c_stringNoCase);
}

bool APRG_KillTrackerDamage_Func(bool testConds, bool runActions) {
    unit victim;
    unit source;
    int player;
    int owner;
    if (!runActions || !g_aprgStarted) { return true; }
    victim = EventUnit();
    source = EventUnitDamageSourceUnit();
    if (victim == null || source == null || victim == source) { return true; }
    player = APRG_GetPrimaryPlayer();
    if (UnitGetOwner(source) != player) { return true; }
    owner = UnitGetOwner(victim);
    if (owner < 0 || !libNtve_gf_PlayerIsEnemy(owner, player, libNtve_ge_PlayerRelation_Enemy)) { return true; }
    DataTableSetUnit(true, "APRG_LastAttacker_" + IntToString(UnitGetTag(victim)), source);
    return true;
}

string APRG_MaddeningShadeCandidate(int index) {
    if (index == 0) { return "Marine"; }
    if (index == 1) { return "Marauder"; }
    if (index == 2) { return "Zealot"; }
    if (index == 3) { return "Stalker"; }
    if (index == 4) { return "Zergling"; }
    if (index == 5) { return "Roach"; }
    if (index == 6) { return "Hydralisk"; }
    if (index == 7) { return "Mutalisk"; }
    if (index == 8) { return "VikingFighter"; }
    if (index == 9) { return "Banshee"; }
    if (index == 10) { return "Immortal"; }
    if (index == 11) { return "Archon"; }
    if (index == 12) { return "Thor"; }
    if (index == 13) { return "Ultralisk"; }
    return "";
}

bool APRG_MaddeningShadeCompletedNear(point p, int player) {
    unitgroup nearby;
    int i;
    unit u;
    string unitType;
    if (p == null) { return false; }
    nearby = UnitGroup(null, player, RegionCircle(p, 2.5), UnitFilter(0, 0, (1 << c_targetFilterStructure) | (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    for (i = UnitGroupCount(nearby, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(nearby, i);
        if (u == null) { continue; }
        unitType = UnitGetType(u);
        if (StringContains(unitType, "Adept", c_stringAnywhere, c_stringNoCase) && !StringContains(unitType, "PhaseShift", c_stringAnywhere, c_stringNoCase)) { return true; }
    }
    return false;
}

void APRG_SpawnMaddeningShadeReward(point p, int player, fixed now) {
    int start;
    int step;
    string unitType;
    unitgroup created;
    unit u;
    string key;
    if (p == null || g_aprgMaddeningShadeUnits == null) { return; }
    if (UnitGroupCount(g_aprgMaddeningShadeUnits, c_unitCountAlive) >= 128) { return; }
    start = RandomInt(0, 13);
    unitType = "";
    for (step = 0; step < 14; step += 1) {
        unitType = APRG_MaddeningShadeCandidate((start + step) % 14);
        if (unitType != "" && CatalogEntryIsValid(c_gameCatalogUnit, unitType)) { break; }
        unitType = "";
    }
    if (unitType == "") { return; }
    created = APRG_CreatePlayerUnitsSafe(1, unitType, player, p, libNtve_gf_RandomAngle());
    u = UnitGroupUnitFromEnd(created, 1);
    if (u == null) { return; }
    UnitSetState(u, c_unitStateUsingSupply, false);
    UnitGroupAdd(g_aprgMaddeningShadeUnits, u);
    key = "APRG_MaddeningShadeExpire_" + IntToString(UnitGetTag(u));
    DataTableSetFixed(true, key, now + 15.0);
}

void APRG_TickMaddeningShadeUnits(fixed now) {
    int i;
    unit u;
    string key;
    fixed expires;
    if (g_aprgMaddeningShadeUnits == null) { return; }
    for (i = UnitGroupCount(g_aprgMaddeningShadeUnits, c_unitCountAll); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(g_aprgMaddeningShadeUnits, i);
        if (u == null || !UnitIsAlive(u)) {
            if (u != null) { UnitGroupRemove(g_aprgMaddeningShadeUnits, u); }
            continue;
        }
        key = "APRG_MaddeningShadeExpire_" + IntToString(UnitGetTag(u));
        expires = DataTableGetFixed(true, key);
        if (expires > 0.0 && now >= expires) {
            UnitGroupRemove(g_aprgMaddeningShadeUnits, u);
            UnitRemove(u);
        }
    }
}

int APRG_FindAnyHostileOwner(int player, point p) {
    int owner;
    unitgroup enemies;
    unit anchor;
    owner = APRG_FindHostileOwnerNearPoint(player, p);
    if (owner >= 0) { return owner; }
    enemies = APRG_EnemyAllUnits(player);
    if (UnitGroupCount(enemies, c_unitCountAlive) <= 0) { return -1; }
    anchor = UnitGroupClosestToPoint(enemies, p);
    if (anchor == null) { return -1; }
    return UnitGetOwner(anchor);
}

bool APRG_UnitHasTimedLife(unit u) {
    int i;
    string behavior;
    if (u == null) { return false; }
    if (DataTableGetBool(true, "APRG_HadTimedLife_" + IntToString(UnitGetTag(u)))) { return true; }
    if (StringContains(UnitGetType(u), "MULE", c_stringAnywhere, c_stringNoCase)) { return true; }
    for (i = UnitBehaviorCountAll(u); i >= 1; i -= 1) {
        behavior = UnitBehaviorGet(u, i);
        if (behavior != "" && UnitBehaviorHasFlag(behavior, c_unitBehaviorFlagTimedLife)) { return true; }
    }
    return false;
}

void APRG_RecordTimedLifeUnit(unit u) {
    int i;
    string behavior;
    if (u == null) { return; }
    if (StringContains(UnitGetType(u), "MULE", c_stringAnywhere, c_stringNoCase)) {
        DataTableSetBool(true, "APRG_HadTimedLife_" + IntToString(UnitGetTag(u)), true);
        return;
    }
    for (i = UnitBehaviorCountAll(u); i >= 1; i -= 1) {
        behavior = UnitBehaviorGet(u, i);
        if (behavior != "" && UnitBehaviorHasFlag(behavior, c_unitBehaviorFlagTimedLife)) {
            DataTableSetBool(true, "APRG_HadTimedLife_" + IntToString(UnitGetTag(u)), true);
            return;
        }
    }
}

bool APRG_TimedLifeCreated_Func(bool testConds, bool runActions) {
    unit created;
    if (!runActions || !g_aprgStarted) { return true; }
    created = EventUnitCreatedUnit();
    APRG_RecordTimedLifeUnit(created);
    return true;
}

bool APRG_DeathSpawnExcluded(unit dead, string unitType) {
    string tag;
    if (dead == null || unitType == "") { return true; }

    // All death-spawn mechanics share this definition of a "real" unit death.
    // Disposable summons, temporary/fake units, workers, and Slay-created free
    // units must never recursively create zombies or No Deaths Allowed ultralisks.
    if (APRG_UnitHasTimedLife(dead)) { return true; }
    if (APRG_IsWorkerTypeForDeath(unitType)) { return true; }
    tag = IntToString(UnitGetTag(dead));
    if (DataTableGetBool(true, "APRG_ArchonCannonMini_" + tag)) { return true; }
    if (DataTableGetBool(true, "APRG_Uncommandable_" + tag)) { return true; }

    if (StringContains(unitType, "Larva", c_stringAnywhere, c_stringNoCase)) { return true; }
    if (StringContains(unitType, "Egg", c_stringAnywhere, c_stringNoCase)) { return true; }
    if (StringContains(unitType, "Cocoon", c_stringAnywhere, c_stringNoCase)) { return true; }
    if (StringContains(unitType, "Chrysalis", c_stringAnywhere, c_stringNoCase)) { return true; }
    if (StringContains(unitType, "Broodling", c_stringAnywhere, c_stringNoCase)) { return true; }
    if (StringContains(unitType, "Roachling", c_stringAnywhere, c_stringNoCase)) { return true; }
    if (StringContains(unitType, "Locust", c_stringAnywhere, c_stringNoCase)) { return true; }
    if (StringContains(unitType, "Interceptor", c_stringAnywhere, c_stringNoCase)) { return true; }
    if (StringContains(unitType, "Changeling", c_stringAnywhere, c_stringNoCase)) { return true; }
    if (StringContains(unitType, "Hallucination", c_stringAnywhere, c_stringNoCase)) { return true; }
    if (StringContains(unitType, "HoloDecoy", c_stringAnywhere, c_stringNoCase)) { return true; }
    if (StringContains(unitType, "Decoy", c_stringAnywhere, c_stringNoCase)) { return true; }
    if (StringContains(unitType, "Dummy", c_stringAnywhere, c_stringNoCase)) { return true; }
    return false;
}

bool APRG_BasicZombieDeathExcluded(unit dead, string unitType) {
    string tag;
    if (APRG_DeathSpawnExcluded(dead, unitType)) { return true; }
    tag = IntToString(UnitGetTag(dead));
    // Never cross-trigger another zombie mechanic's own free spawns.
    return DataTableGetBool(true, "APRG_BasicZombie_" + tag) ||
        DataTableGetBool(true, "APRG_ZombieApocalypse_" + tag);
}

bool APRG_ZombieApocalypseDeathExcluded(unit dead, string unitType) {
    string tag;
    if (dead == null || APRG_DeathSpawnExcluded(dead, unitType)) { return true; }
    tag = IntToString(UnitGetTag(dead));
    // Only exclude zombies we created. Natural or purchased Infested Terran
    // must remain eligible, but zombies from either effect never recurse.
    return DataTableGetBool(true, "APRG_ZombieApocalypse_" + tag) ||
        DataTableGetBool(true, "APRG_BasicZombie_" + tag);
}

void APRG_TagZombieApocalypseGroup(unitgroup created) {
    int i;
    unit u;
    string key;
    for (i = UnitGroupCount(created, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(created, i);
        if (u == null) { continue; }
        key = "APRG_ZombieApocalypse_" + IntToString(UnitGetTag(u));
        DataTableSetBool(true, key, true);
    }
}

void APRG_SpawnZombieApocalypse(point p, int player) {
    int owner;
    int meleeCount;
    string rangedType;
    unitgroup created;
    unitgroup rangedCreated;
    if (p == null) { return; }
    owner = APRG_FindAnyHostileOwner(player, p);
    if (owner < 0) { return; }
    meleeCount = RandomInt(1, 3);
    if (CatalogEntryIsValid(c_gameCatalogUnit, "InfestedCivilian")) {
        created = UnitCreate(meleeCount, "InfestedCivilian", c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
        APRG_TagZombieApocalypseGroup(created);
        APRG_AddHostileRaiders(created, p, player);
        if (!g_aprgHostileZombieVOCued && created != null && UnitGroupCount(created, c_unitCountAlive) > 0) {
            g_aprgHostileZombieVOCued = true;
            APRG_QueueCampaignVO("THanson02BriefingHanson00001", 0.0);
        }
    }
    if (RandomInt(1, 100) > 20) { return; }
    rangedType = "";
    if (CatalogEntryIsValid(c_gameCatalogUnit, "InfestedTerranCampaign")) { rangedType = "InfestedTerranCampaign"; }
    else if (CatalogEntryIsValid(c_gameCatalogUnit, "InfestedTerran")) { rangedType = "InfestedTerran"; }
    if (rangedType == "") { return; }
    rangedCreated = UnitCreate(1, rangedType, c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
    APRG_TagZombieApocalypseGroup(rangedCreated);
    APRG_AddHostileRaiders(rangedCreated, p, player);
}

bool APRG_QueueZombieSpawnJob(int kind, point p, int owner) {
    int slot;
    if (p == null || kind <= 0) { return false; }
    if (g_aprgZombieSpawnCount >= APRG_MAX_ZOMBIE_SPAWN_JOBS) { return false; }
    slot = g_aprgZombieSpawnTail;
    g_aprgZombieSpawnPoint[slot] = Point(PointGetX(p), PointGetY(p));
    g_aprgZombieSpawnKind[slot] = kind;
    g_aprgZombieSpawnOwner[slot] = owner;
    g_aprgZombieSpawnTail = (g_aprgZombieSpawnTail + 1) % APRG_MAX_ZOMBIE_SPAWN_JOBS;
    g_aprgZombieSpawnCount += 1;
    return true;
}

void APRG_ProcessZombieSpawnQueue(int player) {
    int processed = 0;
    int slot;
    int kind;
    int owner;
    point p;
    while (g_aprgZombieSpawnCount > 0 && processed < APRG_ZOMBIE_JOBS_PER_FAST_TICK) {
        slot = g_aprgZombieSpawnHead;
        p = g_aprgZombieSpawnPoint[slot];
        kind = g_aprgZombieSpawnKind[slot];
        owner = g_aprgZombieSpawnOwner[slot];
        g_aprgZombieSpawnPoint[slot] = null;
        g_aprgZombieSpawnKind[slot] = 0;
        g_aprgZombieSpawnOwner[slot] = -1;
        g_aprgZombieSpawnHead = (g_aprgZombieSpawnHead + 1) % APRG_MAX_ZOMBIE_SPAWN_JOBS;
        g_aprgZombieSpawnCount -= 1;
        processed += 1;

        if (kind == APRG_ZOMBIE_JOB_ALLIED) {
            APRG_SpawnZombie(p, player, true, player);
        }
        else if (kind == APRG_ZOMBIE_JOB_HOSTILE) {
            if (owner < 0) { owner = APRG_FindHostileOwnerNearPoint(player, p); }
            if (owner >= 0) { APRG_SpawnZombie(p, owner, false, player); }
        }
        else if (kind == APRG_ZOMBIE_JOB_APOCALYPSE) {
            APRG_SpawnZombieApocalypse(p, player);
        }
    }
}

void APRG_NuclearStructureDeath(point p, int player) {
    if (p == null || !CatalogEntryIsValid(c_gameCatalogEffect, "NukeDamage")) { return; }
    APRG_CreateObjectiveSafeSlayEffect(player, "NukeDamage", p, 12.0);
}

string APRG_RichGasStructureReplacement(string unitType) {
    if (unitType == "Refinery" && CatalogEntryIsValid(c_gameCatalogUnit, "RefineryRich")) { return "RefineryRich"; }
    if (unitType == "Assimilator" && CatalogEntryIsValid(c_gameCatalogUnit, "AssimilatorRich")) { return "AssimilatorRich"; }
    if (unitType == "Extractor" && CatalogEntryIsValid(c_gameCatalogUnit, "ExtractorRich")) { return "ExtractorRich"; }
    return "";
}

bool APRG_PointHasGasStructure(point p) {
    unitgroup structures;
    int i;
    unit u;
    string unitType;
    structures = UnitGroup(
        null,
        c_playerAny,
        RegionPlayableMap(),
        UnitFilter((1 << c_targetFilterStructure), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32))),
        0
    );
    for (i = UnitGroupCount(structures, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(structures, i);
        if (u == null || DistanceBetweenPoints(p, UnitGetPosition(u)) > 2.0) { continue; }
        unitType = UnitGetType(u);
        if (
            StringContains(unitType, "Refinery", c_stringAnywhere, c_stringNoCase) ||
            StringContains(unitType, "Assimilator", c_stringAnywhere, c_stringNoCase) ||
            StringContains(unitType, "Extractor", c_stringAnywhere, c_stringNoCase)
        ) { return true; }
    }
    return false;
}

void APRG_ApplyRichResources(int player, bool minerals, bool vespene) {
    unitgroup resources;
    unitgroup playerUnits;
    int pass;
    int i;
    unit u;
    string unitType;
    string resourceType;
    string replacementType;
    bool replaced;

    if (vespene) {
        playerUnits = APRG_PlayerAllUnits(player);
        for (i = UnitGroupCount(playerUnits, c_unitCountAlive); i > 0; i -= 1) {
            u = UnitGroupUnitFromEnd(playerUnits, i);
            if (u == null || !UnitTypeTestAttribute(UnitGetType(u), c_unitAttributeStructure)) { continue; }
            unitType = UnitGetType(u);
            replacementType = APRG_RichGasStructureReplacement(unitType);
            if (replacementType != "") {
                libNtve_gf_ReplaceUnit(u, replacementType, libNtve_ge_ReplaceUnitOptions_OldUnitsRelative);
            }
        }
    }

    for (pass = 0; pass < 512; pass += 1) {
        replaced = false;
        resources = UnitGroup(
            null,
            c_playerAny,
            RegionPlayableMap(),
            UnitFilter((1 << c_targetFilterHarvestableResource), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32))),
            0
        );
        for (i = UnitGroupCount(resources, c_unitCountAlive); i > 0; i -= 1) {
            u = UnitGroupUnitFromEnd(resources, i);
            if (u == null) { continue; }
            unitType = UnitGetType(u);
            resourceType = CatalogFieldValueGet(c_gameCatalogUnit, unitType, "ResourceType", c_playerAny);
            if (minerals && resourceType == "Minerals" && !StringContains(unitType, "RichMineralField", c_stringAnywhere, c_stringNoCase)) {
                if (CatalogEntryIsValid(c_gameCatalogUnit, "RichMineralField")) {
                    libNtve_gf_ReplaceUnit(u, "RichMineralField", libNtve_ge_ReplaceUnitOptions_OldUnitsRelative);
                    replaced = true;
                    break;
                }
            }
            else if (
                vespene &&
                resourceType == "Vespene" &&
                !StringContains(unitType, "RichVespeneGeyser", c_stringAnywhere, c_stringNoCase) &&
                !APRG_PointHasGasStructure(UnitGetPosition(u))
            ) {
                if (CatalogEntryIsValid(c_gameCatalogUnit, "RichVespeneGeyser")) {
                    libNtve_gf_ReplaceUnit(u, "RichVespeneGeyser", libNtve_ge_ReplaceUnitOptions_OldUnitsRelative);
                    replaced = true;
                    break;
                }
            }
        }
        if (!replaced) { break; }
    }
}

void APRG_InitializeResourceSwap(int player) {
    int minerals;
    int vespene;
    if (g_aprgResourceSwapInitialized) { return; }
    minerals = PlayerGetPropertyInt(player, c_playerPropMinerals);
    vespene = PlayerGetPropertyInt(player, c_playerPropVespene);
    g_aprgResourceSwapBusy = true;
    PlayerModifyPropertyInt(player, c_playerPropMinerals, c_playerPropOperSetTo, vespene);
    PlayerModifyPropertyInt(player, c_playerPropVespene, c_playerPropOperSetTo, minerals);
    g_aprgResourceSwapBusy = false;
    g_aprgResourceSwapMinerals = PlayerGetPropertyInt(player, c_playerPropMinerals);
    g_aprgResourceSwapVespene = PlayerGetPropertyInt(player, c_playerPropVespene);
    g_aprgResourceSwapInitialized = true;
}

bool APRG_ResourceSwap_Func(bool testConds, bool runActions) {
    int player;
    int property;
    int minerals;
    int vespene;
    int delta;
    if (!runActions || !g_aprgStarted || !APRG_HasExtension3(APRG_EXT3_MUT_RESOURCE_SWAP)) { return true; }
    if (g_aprgResourceSwapBusy) { return true; }
    player = APRG_GetPrimaryPlayer();
    if (EventPlayer() != player) { return true; }
    property = EventPlayerProperty();
    minerals = PlayerGetPropertyInt(player, c_playerPropMinerals);
    vespene = PlayerGetPropertyInt(player, c_playerPropVespene);
    g_aprgResourceSwapBusy = true;
    if (property == c_playerPropMinerals && minerals > g_aprgResourceSwapMinerals) {
        delta = minerals - g_aprgResourceSwapMinerals;
        PlayerModifyPropertyInt(player, c_playerPropMinerals, c_playerPropOperSetTo, g_aprgResourceSwapMinerals);
        PlayerModifyPropertyInt(player, c_playerPropVespene, c_playerPropOperSetTo, vespene + delta);
    }
    else if (property == c_playerPropVespene && vespene > g_aprgResourceSwapVespene) {
        delta = vespene - g_aprgResourceSwapVespene;
        PlayerModifyPropertyInt(player, c_playerPropVespene, c_playerPropOperSetTo, g_aprgResourceSwapVespene);
        PlayerModifyPropertyInt(player, c_playerPropMinerals, c_playerPropOperSetTo, minerals + delta);
    }
    g_aprgResourceSwapBusy = false;
    g_aprgResourceSwapMinerals = PlayerGetPropertyInt(player, c_playerPropMinerals);
    g_aprgResourceSwapVespene = PlayerGetPropertyInt(player, c_playerPropVespene);
    return true;
}

bool APRG_IsKnownTerranBiologicalFamily(string unitType) {
    if (unitType == "") { return false; }
    return StringContains(unitType, "Marine", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Marauder", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Reaper", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Firebat", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Medic", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Ghost", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Spectre", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "WarPig", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "DevilDog", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "HammerSecur", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Tychus", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Raynor", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Warfield", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Nova", c_stringAnywhere, c_stringNoCase);
}

bool APRG_IsInfantryBoonType(string unitType, int player) {
    string race;
    if (unitType == "" || !CatalogEntryIsValid(c_gameCatalogUnit, unitType)) { return false; }
    if (APRG_IsWorkerTypeForDeath(unitType) || UnitTypeTestAttribute(unitType, c_unitAttributeStructure)) { return false; }
    if (!UnitTypeTestAttribute(unitType, c_unitAttributeBiological)) { return false; }
    race = CatalogFieldValueGet(c_gameCatalogUnit, unitType, "Race", player);
    if (StringContains(race, "Terr", c_stringAnywhere, c_stringNoCase)) { return true; }
    return race == "" && APRG_IsKnownTerranBiologicalFamily(unitType);
}

void APRG_BeginDeadManSwitch(point center, int player, fixed now) {
    int n;
    int slot;
    int scan;
    fixed angle;
    point p;
    actor indicator;
    if (center == null || !CatalogEntryIsValid(c_gameCatalogEffect, "NukeDamage")) { return; }
    for (n = 0; n < 6; n += 1) {
        slot = -1;
        for (scan = 0; scan < APRG_MAX_DEAD_MAN_NUKES; scan += 1) {
            if (g_aprgDeadManNukeState[scan] == 0) { slot = scan; break; }
        }
        if (slot < 0) { return; }
        angle = IntToFixed(n) * 60.0;
        p = PointWithOffsetPolar(center, 10.0, angle);
        indicator = null;
        if (CatalogEntryIsValid(c_gameCatalogModel, "GhostNukeIndicator")) {
            indicator = libNtve_gf_CreateModelAtPoint("GhostNukeIndicator", p);
        }
        PingCreate(PlayerGroupSingle(player), "PingWarning", p, ColorWithAlpha(100.00, 0.00, 0.00, 0.00), 8.0);
        PingSetScale(PingLastCreated(), 1.25);
        g_aprgDeadManNukePoint[slot] = p;
        g_aprgDeadManNukeTime[slot] = now + 8.0;
        g_aprgDeadManNukeIndicator[slot] = indicator;
        g_aprgDeadManNukeState[slot] = 1;
    }
}

void APRG_TickDeadManSwitchNukes(int player, fixed now) {
    int i;
    if (!APRG_HasExtension4(APRG_EXT4_BOON_DEAD_MAN_SWITCH)) { return; }
    for (i = 0; i < APRG_MAX_DEAD_MAN_NUKES; i += 1) {
        if (g_aprgDeadManNukeState[i] != 1 || now < g_aprgDeadManNukeTime[i]) { continue; }
        APRG_CreateObjectiveSafeSlayEffect(player, "NukeDamage", g_aprgDeadManNukePoint[i], 12.0);
        if (g_aprgDeadManNukeIndicator[i] != null) { ActorSend(g_aprgDeadManNukeIndicator[i], "Destroy"); }
        g_aprgDeadManNukeState[i] = 0;
        g_aprgDeadManNukePoint[i] = null;
        g_aprgDeadManNukeTime[i] = 0.0;
        g_aprgDeadManNukeIndicator[i] = null;
    }
}

// Hybrid Research uses the existing structure-death trigger rather than a
// separate scanning loop. Keep weights independent of catalog availability:
// 40% Reaver, 40% Destroyer, 10% Nemesis, 5% Behemoth, 5% Dominator.
// On campaigns missing the requested model, fall back to an existing hybrid
// rather than spawn an error unit or lose the death effect entirely.
string APRG_HybridResearchChooseType() {
    int roll;
    string hybridType;
    roll = RandomInt(1, 100);
    if (roll <= 40) { hybridType = "HybridReaver"; }
    else if (roll <= 80) { hybridType = "HybridDestroyer"; }
    else if (roll <= 90) { hybridType = "HybridNemesis"; }
    else if (roll <= 95) { hybridType = "HybridBehemoth"; }
    else { hybridType = "HybridDominator"; }
    if (CatalogEntryIsValid(c_gameCatalogUnit, hybridType)) { return hybridType; }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "HybridReaver")) { return "HybridReaver"; }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "HybridDestroyer")) { return "HybridDestroyer"; }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "HybridNemesis")) { return "HybridNemesis"; }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "HybridBehemoth")) { return "HybridBehemoth"; }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "HybridDominator")) { return "HybridDominator"; }
    return "";
}

void APRG_HybridResearchStructureDeath(point deathPoint, int deadOwner, int player) {
    string hybridType;
    unitgroup spawned;
    if (deathPoint == null || deadOwner < 0) { return; }
    hybridType = APRG_HybridResearchChooseType();
    if (hybridType == "") { return; }
    spawned = UnitCreate(1, hybridType, c_unitCreateIgnorePlacement, deadOwner, deathPoint, libNtve_gf_RandomAngle());
    APRG_AddHostileRaiders(spawned, deathPoint, player);
}

void APRG_ApplyGloriousMartyrs(point deathPoint, int player);
bool APRG_IsFieryUnitType(string unitType);
void APRG_DealDirectDamage(unit target, fixed damage);
bool APRG_IsDev5MorphType(string unitType);
bool APRG_IsDev5VoidRayType(string unitType);
void APRG_ApplyDev5Stats(int player);
void APRG_TickUnlimitedScarabs(int player, fixed now);

bool APRG_Death_Func(bool testConds, bool runActions) {
    unit dead;
    point p;
    int player;
    int owner;
    int killer;
    string unitType;
    fixed speed;
    fixed now;
    unitgroup chainCreated;
    unit chainBaneling;
    unit home;
    unit killingUnit;
    unitgroup evoCreated;
    unit evolvedUnit;
    string killerType;
    bool deathSpawnExcluded;
    if (!runActions || !g_aprgStarted) {
        return true;
    }
    dead = EventUnit();
    if (dead == null) {
        return true;
    }
    p = UnitGetPosition(dead);
    player = APRG_GetPrimaryPlayer();
    // Before the macro base is established, do not fire mutation death
    // spawns, nuclear detonations, or hostile revival queues.
    // Player blessing death effects likewise begin with the run's gameplay.
    if (!APRG_PlayerMacroBaseReady(player)) { return true; }
    if (dead == g_aprgOrlanFortress && !g_aprgOrlanDestroyedVOCued) {
        g_aprgOrlanDestroyedVOCued = true;
        APRG_QueueCampaignVO("THorner02Orlan00019", 0.0);
    }
    owner = UnitGetOwner(dead);
    unitType = UnitGetType(dead);
    if (owner == player && APRG_HasExtension5(APRG_EXT5_BOON_EXPLOSIVE_PREDATORS) &&
        StringContains(unitType, "Predator", c_stringAnywhere, c_stringNoCase)) {
        evoCreated = UnitGroupAlliance(player, c_unitAllianceEnemy, RegionCircle(p, 2.0),
            UnitFilter(0, 0, (1 << c_targetFilterMissile),
                (1 << (c_targetFilterDead - 32))), 0);
        for (killer = UnitGroupCount(evoCreated, c_unitCountAlive); killer > 0; killer -= 1) {
            evolvedUnit = UnitGroupUnitFromEnd(evoCreated, killer);
            if (evolvedUnit != null && UnitIsAlive(evolvedUnit)) {
                APRG_DealDirectDamage(evolvedUnit, 100.0);
            }
        }
    }
    deathSpawnExcluded = APRG_DeathSpawnExcluded(dead, unitType);
    speed = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "Speed", owner));
    now = GameGetMissionTime();
    killingUnit = DataTableGetUnit(true, "APRG_LastAttacker_" + IntToString(UnitGetTag(dead)));
    DataTableValueRemove(true, "APRG_LastAttacker_" + IntToString(UnitGetTag(dead)));

    if (DataTableGetBool(true, "APRG_WarfieldGorgon_" + IntToString(UnitGetTag(dead)))) {
        DataTableSetBool(true, "APRG_WarfieldGorgon_" + IntToString(UnitGetTag(dead)), false);
        APRG_PlayRandomWarfieldGorgonDeath();
    }

    if (APRG_HasExtension2(APRG_EXT2_BLESS_GLORIOUS_MARTYRS) && owner == player) {
        APRG_ApplyGloriousMartyrs(p, player);
    }
    if (APRG_HasBlessing(APRG_BLESS_EXPLOSIVE_ARMOR) && owner == player) {
        APRG_DealExplosiveArmorDamage(
            p,
            player,
            20.0 * UnitTypeGetProperty(unitType, c_unitPropSuppliesUsed),
            2.5 + MaxF(0.0, UnitTypeGetProperty(unitType, c_unitPropSuppliesUsed) - 1.0)
        );
    }
    if (
        APRG_PlayerMacroBaseReady(player) &&
        APRG_HasExtension(APRG_EXT_MUT_NO_DEATHS_ALLOWED) &&
        owner == player &&
        !deathSpawnExcluded &&
        speed > 0.0 &&
        !DataTableGetBool(true, "APRG_Uncommandable_" + IntToString(UnitGetTag(dead)))
    ) {
        APRG_QueueNoDeathsUltralisk(dead, p);
    }
    if ((APRG_PlayerMacroBaseReady(player) && APRG_HasExtension(APRG_EXT_MUT_NUCLEAR_WORKERS)) && owner == player && APRG_IsWorkerTypeForDeath(unitType)) {
        APRG_NuclearWorkerDeath(p, player);
    }
    if (
        (APRG_PlayerMacroBaseReady(player) && APRG_HasExtension3(APRG_EXT3_MUT_NUCLEAR_STRUCTURES)) &&
        owner >= 0 &&
        libNtve_gf_PlayerIsEnemy(owner, player, libNtve_ge_PlayerRelation_Enemy) &&
        UnitTypeTestAttribute(unitType, c_unitAttributeStructure) &&
        APRG_IsSlayStructureEffectEligibleType(unitType)
    ) {
        APRG_NuclearStructureDeath(p, player);
    }
    if (
        APRG_HasExtension3(APRG_EXT3_MUT_HYBRID_RESEARCH) &&
        owner >= 0 &&
        libNtve_gf_PlayerIsEnemy(owner, player, libNtve_ge_PlayerRelation_Enemy) &&
        UnitTypeTestAttribute(unitType, c_unitAttributeStructure) &&
        APRG_IsSlayStructureEffectEligibleType(unitType)
    ) {
        APRG_HybridResearchStructureDeath(p, owner, player);
    }
    if (
        APRG_PlayerMacroBaseReady(player) &&
        APRG_HasExtension3(APRG_EXT3_MUT_ZOMBIE_APOCALYPSE) &&
        (owner == player || (owner >= 0 && libNtve_gf_PlayerIsEnemy(owner, player, libNtve_ge_PlayerRelation_Enemy))) &&
        !APRG_ZombieApocalypseDeathExcluded(dead, unitType)
    ) {
        if (!APRG_QueueZombieSpawnJob(APRG_ZOMBIE_JOB_APOCALYPSE, p, -1)) {
            APRG_SpawnZombieApocalypse(p, player);
        }
    }
    if (
        APRG_HasExtension4(APRG_EXT4_BOON_KILL_STREAK) && killingUnit != null &&
        owner >= 0 && libNtve_gf_PlayerIsEnemy(owner, player, libNtve_ge_PlayerRelation_Enemy) &&
        UnitGetOwner(killingUnit) == player && UnitIsAlive(killingUnit) &&
        (StringContains(UnitGetType(killingUnit), "Ghost", c_stringAnywhere, c_stringNoCase) || StringContains(UnitGetType(killingUnit), "Spectre", c_stringAnywhere, c_stringNoCase)) &&
        CatalogEntryIsValid(c_gameCatalogBehavior, "APRogueKillStreak")
    ) {
        UnitBehaviorAdd(killingUnit, "APRogueKillStreak", killingUnit, 1);
    }
    if (owner == player && !deathSpawnExcluded && APRG_HasExtension4(APRG_EXT4_BOON_INFANTRY_REINFORCEMENTS) && APRG_IsInfantryBoonType(unitType, player)) {
        killer = FixedToInt(UnitTypeGetProperty(unitType, c_unitPropSuppliesUsed) * 7.0);
        if (killer > 100) { killer = 100; }
        if (killer > 0 && RandomInt(1, 100) <= killer) {
            APRG_QueueRealDropPod(APRG_DROP_KIND_INFANTRY_REINFORCEMENTS, player, p, null);
        }
    }
    if (
        owner == player && !deathSpawnExcluded && APRG_HasExtension4(APRG_EXT4_BOON_ACIDIC_LANDING_MARKERS) &&
        StringContains(unitType, "Baneling", c_stringAnywhere, c_stringNoCase) && RandomInt(1, 100) <= 20
    ) {
        APRG_QueueRealDropPod(APRG_DROP_KIND_ACIDIC_LANDING, player, p, null);
    }
    if (owner == player && APRG_HasExtension4(APRG_EXT4_BOON_RECYCLED_ARMOR) && APRG_IsInfantryBoonType(unitType, player)) {
        // Pay less for any Slay-made uncommandable infantry, independent of which boon spawned it.
        // The shared marker is set by APRG_MakeGroupUncommandable for Cloning Technology,
        // Meat Grinder, Warfield pods, and other autonomous player-owned support units.
        if (DataTableGetBool(true, "APRG_Uncommandable_" + IntToString(UnitGetTag(dead)))) {
            PlayerModifyPropertyInt(player, c_playerPropMinerals, c_playerPropOperSetTo, PlayerGetPropertyInt(player, c_playerPropMinerals) + 8);
            PlayerModifyPropertyInt(player, c_playerPropVespene, c_playerPropOperSetTo, PlayerGetPropertyInt(player, c_playerPropVespene) + 2);
        } else {
            PlayerModifyPropertyInt(player, c_playerPropMinerals, c_playerPropOperSetTo, PlayerGetPropertyInt(player, c_playerPropMinerals) + 25);
            PlayerModifyPropertyInt(player, c_playerPropVespene, c_playerPropOperSetTo, PlayerGetPropertyInt(player, c_playerPropVespene) + 10);
        }
    }
    if (
        owner == player && APRG_HasExtension4(APRG_EXT4_BOON_DEAD_MAN_SWITCH) &&
        StringContains(unitType, "Spectre", c_stringAnywhere, c_stringNoCase)
    ) {
        APRG_BeginDeadManSwitch(p, player, now);
    }
    if (
        owner == player && !deathSpawnExcluded && APRG_HasExtension4(APRG_EXT4_BOON_CELL_DIVISION) &&
        (StringContains(unitType, "Ultralisk", c_stringAnywhere, c_stringNoCase) ||
         StringContains(unitType, "Torrasque", c_stringAnywhere, c_stringNoCase)) &&
        CatalogEntryIsValid(c_gameCatalogUnit, "Roach")
    ) {
        evoCreated = APRG_CreatePlayerUnitsSafe(6, "Roach", player, p, libNtve_gf_RandomAngle());
    }
    if (
        owner >= 0 && libNtve_gf_PlayerIsEnemy(owner, player, libNtve_ge_PlayerRelation_Enemy) &&
        !deathSpawnExcluded &&
        APRG_HasExtension4(APRG_EXT4_BOON_ZERGLING_INFESTATION) &&
        DataTableGetFixed(true, "APRG_ZerglingInfestUntil_" + IntToString(UnitGetTag(dead))) >= now
    ) {
        killer = FixedToInt(UnitTypeGetProperty(unitType, c_unitPropSuppliesUsed));
        if (killer > 0 && CatalogEntryIsValid(c_gameCatalogUnit, "Zergling")) {
            evoCreated = APRG_CreatePlayerUnitsSafe(killer, "Zergling", player, p, libNtve_gf_RandomAngle());
        }
        DataTableValueRemove(true, "APRG_ZerglingInfestUntil_" + IntToString(UnitGetTag(dead)));
    }
    if (!deathSpawnExcluded && APRG_PlayerMacroBaseReady(player) && APRG_HasExtension(APRG_EXT_MUT_VICTORY_TEMPORARY)) {
        APRG_QueueEnemyRespawn(dead, player, now);
    }
    if (APRG_HasExtension(APRG_EXT_BLESS_BOUNTY_KILLS)) {
        killer = libNtve_gf_KillingPlayer();
        if (killer == player && owner >= 0 && libNtve_gf_PlayerIsEnemy(owner, player, libNtve_ge_PlayerRelation_Enemy)) {
            PlayerModifyPropertyInt(player, c_playerPropMinerals, c_playerPropOperSetTo, PlayerGetPropertyInt(player, c_playerPropMinerals) + 4);
            PlayerModifyPropertyInt(player, c_playerPropVespene, c_playerPropOperSetTo, PlayerGetPropertyInt(player, c_playerPropVespene) + 3);
        }
    }
    if ((APRG_PlayerMacroBaseReady(player) && APRG_HasExtension3(APRG_EXT3_MUT_COMBAT_PAY))) {
        killer = libNtve_gf_KillingPlayer();
        if (killer == player && owner >= 0 && libNtve_gf_PlayerIsEnemy(owner, player, libNtve_ge_PlayerRelation_Enemy)) {
            PlayerModifyPropertyInt(
                player,
                c_playerPropMinerals,
                c_playerPropOperSetTo,
                MaxI(0, PlayerGetPropertyInt(player, c_playerPropMinerals) - 4)
            );
        }
    }
    if (!deathSpawnExcluded && APRG_HasExtension2(APRG_EXT2_BOON_CHAIN_REACTION) && owner >= 0 && libNtve_gf_PlayerIsEnemy(owner, player, libNtve_ge_PlayerRelation_Enemy) && CatalogEntryIsValid(c_gameCatalogUnit,"Baneling")) {
        chainCreated = APRG_CreatePlayerUnitsSafe(1,"Baneling",player,p,libNtve_gf_RandomAngle());
        chainBaneling = UnitGroupUnitFromEnd(chainCreated,1);
        if (chainBaneling != null) { UnitSetState(chainBaneling,c_unitStateUsingSupply,false); }
    }
    if (
        !deathSpawnExcluded && APRG_HasExtension2(APRG_EXT2_BOON_AIUR_RECRUITMENT) && owner == player &&
        APRG_IsForAiurZealotType(unitType) && RandomInt(1, 100) <= 10
    ) {
        APRG_QueueForAiurDeath(dead, p);
    }
    if (
        APRG_HasExtension3(APRG_EXT3_BOON_MADDENING_SHADES) &&
        owner == player &&
        StringContains(unitType, "AdeptPhaseShift", c_stringAnywhere, c_stringNoCase) &&
        APRG_MaddeningShadeCompletedNear(p, player)
    ) {
        APRG_SpawnMaddeningShadeReward(p, player, now);
    }

    if (
        APRG_HasExtension3(APRG_EXT3_BOON_STRETCHY_SPINES) &&
        owner >= 0 &&
        libNtve_gf_PlayerIsEnemy(owner, player, libNtve_ge_PlayerRelation_Enemy) &&
        killingUnit != null &&
        UnitGetOwner(killingUnit) == player &&
        UnitIsAlive(killingUnit) &&
        StringContains(UnitGetType(killingUnit), "SpineCrawler", c_stringAnywhere, c_stringNoCase)
    ) {
        UnitBehaviorAdd(killingUnit, "APRogueStretchySpines", killingUnit, 1);
    }
    if (
        APRG_HasExtension2(APRG_EXT2_BOON_FIRE_POWER) &&
        owner >= 0 &&
        libNtve_gf_PlayerIsEnemy(owner, player, libNtve_ge_PlayerRelation_Enemy) &&
        killingUnit != null &&
        UnitGetOwner(killingUnit) == player &&
        APRG_IsFieryUnitType(UnitGetType(killingUnit))
    ) {
        if (g_aprgFirePowerStacks < 1000) { g_aprgFirePowerStacks += 1; }
    }
    if (
        !deathSpawnExcluded && APRG_HasExtension2(APRG_EXT2_BOON_ROACHLING_MINES) &&
        owner == player &&
        StringContains(unitType, "SpiderMine", c_stringAnywhere, c_stringNoCase) &&
        CatalogEntryIsValid(c_gameCatalogUnit, "Roachling")
    ) {
        evoCreated = APRG_CreatePlayerUnitsSafe(5, "Roachling", player, p, libNtve_gf_RandomAngle());
        for (killer = UnitGroupCount(evoCreated, c_unitCountAlive); killer > 0; killer -= 1) {
            evolvedUnit = UnitGroupUnitFromEnd(evoCreated, killer);
            if (evolvedUnit != null) { UnitSetState(evolvedUnit, c_unitStateUsingSupply, false); }
        }
    }
    if (
        !deathSpawnExcluded && APRG_HasExtension2(APRG_EXT2_BOON_BROODLING_EVOLUTION) &&
        owner >= 0 &&
        libNtve_gf_PlayerIsEnemy(owner, player, libNtve_ge_PlayerRelation_Enemy) &&
        killingUnit != null &&
        UnitGetOwner(killingUnit) == player &&
        UnitIsAlive(killingUnit)
    ) {
        killerType = UnitGetType(killingUnit);
        if (
            StringContains(killerType, "Broodling", c_stringAnywhere, c_stringNoCase) &&
            CatalogEntryIsValid(c_gameCatalogUnit, "Zergling")
        ) {
            evoCreated = APRG_CreatePlayerUnitsSafe(1, "Zergling", player, UnitGetPosition(killingUnit), UnitGetFacing(killingUnit));
            evolvedUnit = UnitGroupUnitFromEnd(evoCreated, 1);
            if (evolvedUnit != null) {
                UnitSetState(evolvedUnit, c_unitStateUsingSupply, false);
                UnitGroupAdd(g_aprgBroodEvolutionStage1, evolvedUnit);
                UnitRemove(killingUnit);
            }
        }
        else if (UnitGroupHasUnit(g_aprgBroodEvolutionStage1, killingUnit) && CatalogEntryIsValid(c_gameCatalogUnit, "Roach")) {
            evoCreated = APRG_CreatePlayerUnitsSafe(1, "Roach", player, UnitGetPosition(killingUnit), UnitGetFacing(killingUnit));
            evolvedUnit = UnitGroupUnitFromEnd(evoCreated, 1);
            if (evolvedUnit != null) {
                UnitSetState(evolvedUnit, c_unitStateUsingSupply, false);
                UnitGroupAdd(g_aprgBroodEvolutionStage2, evolvedUnit);
                UnitGroupRemove(g_aprgBroodEvolutionStage1, killingUnit);
                UnitRemove(killingUnit);
            }
        }
        else if (UnitGroupHasUnit(g_aprgBroodEvolutionStage2, killingUnit) && CatalogEntryIsValid(c_gameCatalogUnit, "Ultralisk")) {
            evoCreated = APRG_CreatePlayerUnitsSafe(1, "Ultralisk", player, UnitGetPosition(killingUnit), UnitGetFacing(killingUnit));
            evolvedUnit = UnitGroupUnitFromEnd(evoCreated, 1);
            if (evolvedUnit != null) {
                UnitSetState(evolvedUnit, c_unitStateUsingSupply, false);
                UnitGroupRemove(g_aprgBroodEvolutionStage2, killingUnit);
                UnitRemove(killingUnit);
            }
        }
    }
    if (APRG_PlayerMacroBaseReady(player) && APRG_HasMutation(APRG_MUT_ZOMBIES) && !APRG_BasicZombieDeathExcluded(dead, unitType)) {
        if (!APRG_QueueZombieSpawnJob(APRG_ZOMBIE_JOB_HOSTILE, p, -1)) {
            owner = APRG_FindHostileOwnerNearPoint(player, p);
            if (owner >= 0) { APRG_SpawnZombie(p, owner, false, player); }
        }
    }
    if (APRG_PlayerMacroBaseReady(player) && APRG_HasBlessing(APRG_BLESS_ZOMBIES) && !APRG_BasicZombieDeathExcluded(dead, unitType)) {
        if (!APRG_QueueZombieSpawnJob(APRG_ZOMBIE_JOB_ALLIED, p, player)) {
            APRG_SpawnZombie(p, player, true, player);
        }
    }
    return true;
}

void APRG_TrySpawnHostileHero(int player) {
    point p;
    int owner;
    string heroType;
    unitgroup created;
    int attempt;
    point candidate;
    if (g_aprgHostileHeroesSpawned >= 7 || g_aprgHostileHeroRetries >= APRG_STATIC_SPAWN_MAX_RETRIES) { return; }
    g_aprgHostileHeroRetries += 1;
    // Heroes of the Storm must never materialize within 20 range of a
    // player-owned or allied structure, even after the early-game grace period.
    p = null;
    for (attempt = 0; attempt < 12; attempt += 1) {
        candidate = APRG_FindHeroPatrolOrigin(player);
        if (candidate == null) { break; }
        if (APRG_PointNearPlayerOrAlliedBuilding(candidate, player, 20.0)) { continue; }
        p = candidate;
        break;
    }
    if (p == null) { return; }
    owner = APRG_FindHostileOwnerNearPoint(player, p);
    if (owner < 0) { return; }
    heroType = APRG_FindUnusedValidHostileHeroType();
    if (heroType == "") { return; }
    created = UnitCreate(1, heroType, c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
    if (UnitGroupCount(created, c_unitCountAlive) > 0) {
        APRG_MarkHostileHeroFamilyUsed(heroType);
        APRG_RegisterGeneratedHeroGroup(created);
        AISetUnitScriptControlled(UnitGroupUnitFromEnd(created, 1), false);
        UnitGroupAddUnitGroup(g_aprgHostilePatrollers, created);
        UnitGroupAddUnitGroup(g_aprgHeroesOfStormUnits, created);
        g_aprgHostileHeroesSpawned += 1;
        APRG_OrderHeroesOfStormRandomPatrol(UnitGroupUnitFromEnd(created, 1));
    }
}

void APRG_SpawnWraithRaid(int player) {
    point p = APRG_FindRandomMapEdgePoint();
    int owner;
    unitgroup created;
    if (p == null || !CatalogEntryIsValid(c_gameCatalogUnit, "Wraith")) { return; }
    owner = APRG_FindHostileOwnerNearPoint(player, p);
    if (owner < 0) { return; }
    created = UnitCreate(1, "Wraith", c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
    APRG_AddHostileRaiders(created, p, player);
}

fixed APRG_WraithRaidNextInterval(fixed now) {
    fixed progress;
    fixed minimum;
    fixed maximum;
    now = APRG_TimeSinceMacroBase(now);
    if (now <= 120.0) { return RandomFixed(10.0, 60.0); }
    if (now >= 780.0) { return RandomFixed(2.0, 10.0); }
    progress = (now - 120.0) / 660.0;
    minimum = 10.0 - (8.0 * progress);
    maximum = 60.0 - (50.0 * progress);
    return RandomFixed(minimum, maximum);
}


point APRG_FindPlayerMineralLinePoint(int player) {
    unit base = APRG_FindPlayerHomeStructure(player);
    unitgroup resources;
    unitgroup minerals = UnitGroupEmpty();
    int i;
    unit u;
    unit nearest;

    if (base == null) { return null; }
    resources = UnitGroup(
        null,
        c_playerAny,
        RegionPlayableMap(),
        UnitFilter(
            (1 << c_targetFilterHarvestableResource),
            0,
            (1 << c_targetFilterMissile),
            (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))
        ),
        0
    );
    i = UnitGroupCount(resources, c_unitCountAlive);
    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(resources, i);
        if (u == null) { break; }
        if (CatalogFieldValueGet(c_gameCatalogUnit, UnitGetType(u), "ResourceType", c_playerAny) == "Minerals") {
            UnitGroupAdd(minerals, u);
        }
    }
    if (UnitGroupCount(minerals, c_unitCountAlive) <= 0) {
        return UnitGetPosition(base);
    }
    nearest = UnitGroupClosestToPoint(minerals, UnitGetPosition(base));
    if (nearest == null) { return UnitGetPosition(base); }
    return UnitGetPosition(nearest);
}

fixed APRG_VikingRaidIntervalMinimum(fixed now) {
    // Every three minutes after base establishment the minimum increases 3s.
    fixed elapsed = APRG_TimeSinceMacroBase(now);
    int completedPhases = FixedToInt(elapsed / 180.0);
    return MinF(180.0, 20.0 + 3.0 * IntToFixed(completedPhases));
}

void APRG_SpawnVikingRaid(int player) {
    point spawnPoint;
    point mineralLine;
    int owner;
    int count;
    int minutes;
    int lower;
    int upper;
    unitgroup created;

    if (!CatalogEntryIsValid(c_gameCatalogUnit, "VikingFighter")) { return; }
    spawnPoint = APRG_FindRaidOriginAirPoint(player);
    mineralLine = APRG_FindPlayerMineralLinePoint(player);
    if (spawnPoint == null || mineralLine == null) { return; }
    owner = APRG_FindHostileOwnerNearPoint(player, spawnPoint);
    if (owner < 0) { return; }
    minutes = FixedToInt(APRG_TimeSinceMacroBase(GameGetMissionTime()) / 60.0);
    lower = 1 + (minutes / 3);
    upper = 3 + (minutes / 2);
    if (upper < lower) { upper = lower; }
    count = RandomInt(lower, upper);
    created = UnitCreate(count, "VikingFighter", c_unitCreateIgnorePlacement, owner, spawnPoint, libNtve_gf_RandomAngle());
    if (created == null || UnitGroupCount(created, c_unitCountAlive) <= 0) { return; }
    APRG_RegisterMutationEnemyGroup(created);
    UnitGroupIssueOrder(created, OrderTargetingPoint(AbilityCommand("move", 0), mineralLine), c_orderQueueReplace);
    UnitGroupIssueOrder(created, Order(AbilityCommand("AssaultMode", 0)), c_orderQueueAddToEnd);
    UnitGroupIssueOrder(created, OrderTargetingPoint(AbilityCommand("attack", 0), mineralLine), c_orderQueueAddToEnd);
}

bool APRG_VoidThrasherPointNearFriendlyUnits(point candidate, int player) {
    unitgroup ownUnits;
    unitgroup alliedUnits;
    int i;
    unit u;
    if (candidate == null) { return true; }
    ownUnits = UnitGroup(
        null, player, RegionCircle(candidate, 20.0),
        UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0
    );
    if (UnitGroupCount(ownUnits, c_unitCountAlive) > 0) { return true; }
    alliedUnits = UnitGroupAlliance(
        player, c_unitAllianceAlly, RegionCircle(candidate, 20.0),
        UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0
    );
    for (i = UnitGroupCount(alliedUnits, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(alliedUnits, i);
        if (u != null && UnitGetOwner(u) != player) { return true; }
    }
    return false;
}

point APRG_FindVoidThrasherPoint(int player) {
    unit base;
    int attempt;
    point candidate;
    point bestPoint;
    unit nearestPlayerStructure;
    fixed nearestDistance;
    fixed homeDistance;
    fixed bestHomeDistance;
    base = APRG_FindPlayerHomeStructure(player);
    if (base == null) { return null; }
    bestPoint = null;
    bestHomeDistance = 99999.0;

    for (attempt = 0; attempt < 128; attempt += 1) {
        candidate = PointWithOffsetPolar(UnitGetPosition(base), RandomFixed(30.0, 70.0), libNtve_gf_RandomAngle());
        if (!RegionContainsPoint(RegionPlayableMap(), candidate) || !PointPathingPassable(candidate)) { continue; }
        if (APRG_GroundSpawnsNeedPlayerPathing() && !PointPathingIsConnected(candidate, UnitGetPosition(base))) { continue; }
        if (APRG_VoidThrasherPointNearFriendlyUnits(candidate, player)) { continue; }
        nearestPlayerStructure = APRG_NearestPlayerStructure(candidate, player);
        if (nearestPlayerStructure == null) { continue; }
        nearestDistance = DistanceBetweenPoints(candidate, UnitGetPosition(nearestPlayerStructure));
        if (nearestDistance < 30.0) { continue; }
        homeDistance = DistanceBetweenPoints(candidate, UnitGetPosition(base));
        if (homeDistance < bestHomeDistance) {
            bestHomeDistance = homeDistance;
            bestPoint = candidate;
        }
    }
    return bestPoint;
}

unitgroup APRG_CreateVoidThrasher(int owner, point p) {
    unitgroup created = UnitGroupEmpty();
    if (CatalogEntryIsValid(c_gameCatalogUnit, "VoidThrasherWalker")) {
        created = UnitCreate(1, "VoidThrasherWalker", c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
        if (created != null && UnitGroupCount(created, c_unitCountAlive) > 0) { return created; }
    }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "VoidThrasher")) {
        created = UnitCreate(1, "VoidThrasher", c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
    }
    return created;
}

unitgroup APRG_PlayerTargetableStructures(int player) {
    unitgroup result;
    unit u;
    int i;
    result = UnitGroup(
        null,
        player,
        RegionPlayableMap(),
        UnitFilter(
            (1 << c_targetFilterStructure),
            0,
            (1 << c_targetFilterMissile) | (1 << c_targetFilterCloaked),
            (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)) | (1 << (c_targetFilterInvulnerable - 32))
        ),
        0
    );    for (i = UnitGroupCount(result, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(result, i);
        if (u != null && !APRG_IsSlayStructureEffectEligibleType(UnitGetType(u))) { UnitGroupRemove(result, u); }
    }
    return result;
}

void APRG_RegisterVoidThrasherMapVision(unit thrasher, int owner, int player) {
    int slot;
    if (thrasher == null || !UnitIsAlive(thrasher)) { return; }
    APRG_RegisterAlwaysVisibleUnit(thrasher, player);
    for (slot = 0; slot < 32; slot += 1) {
        if (g_aprgVoidThrasherVisionUnits[slot] == null || !UnitIsAlive(g_aprgVoidThrasherVisionUnits[slot])) {
            if (g_aprgVoidThrasherEnemyRevealers[slot] != null) {
                VisRevealerDestroy(g_aprgVoidThrasherEnemyRevealers[slot]);
            }
            g_aprgVoidThrasherVisionUnits[slot] = thrasher;
            g_aprgVoidThrasherEnemyRevealers[slot] = VisRevealerCreate(owner, RegionPlayableMap());
            if (slot >= g_aprgVoidThrasherVisionCount) { g_aprgVoidThrasherVisionCount = slot + 1; }
            return;
        }
    }
}

void APRG_TickVoidThrasherMapVision() {
    int slot;
    for (slot = 0; slot < g_aprgVoidThrasherVisionCount; slot += 1) {
        if (g_aprgVoidThrasherVisionUnits[slot] != null && UnitIsAlive(g_aprgVoidThrasherVisionUnits[slot])) { continue; }
        if (g_aprgVoidThrasherEnemyRevealers[slot] != null) {
            VisRevealerDestroy(g_aprgVoidThrasherEnemyRevealers[slot]);
        }
        g_aprgVoidThrasherVisionUnits[slot] = null;
        g_aprgVoidThrasherEnemyRevealers[slot] = null;
    }
}

void APRG_SpawnVoidThrasher(int player) {
    point p;
    int owner;
    unitgroup created;
    unit thrasher;
    p = APRG_FindVoidThrasherPoint(player);
    if (p == null) { return; }
    owner = APRG_FindHostileOwnerNearPoint(player, p);
    if (owner < 0) { return; }
    created = APRG_CreateVoidThrasher(owner, p);
    if (created == null || UnitGroupCount(created, c_unitCountAlive) <= 0) { return; }
    UnitGroupAddUnitGroup(g_aprgVoidThrashers, created);
    if (UnitGroupUnitFromEnd(created, 1) != null) {
        thrasher = UnitGroupUnitFromEnd(created, 1);
        APRG_StripVoidEntityBehavior(thrasher);
        AISetUnitScriptControlled(thrasher, true);
        UnitSetPropertyFixed(thrasher, c_unitPropMovementSpeed, 0.0);
        DataTableSetFixed(true, "APRG_VoidThrasherNextShot_" + IntToString(UnitGetTag(thrasher)), 0.0);
        APRG_RegisterVoidThrasherMapVision(thrasher, owner, player);
        if (CatalogEntryIsValid(c_gameCatalogAbil, "KaiserWormScourgeMissile")) {
            CatalogFieldValueSet(c_gameCatalogAbil, "KaiserWormScourgeMissile", "Range", owner, "500.0");
        }
    }
    MinimapPing(PlayerGroupSingle(player), p, 6.0, Color(100.0, 0.0, 0.0));
    UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaChat, StringToText("[Slay] Void Thrasher detected."));
}

bool APRG_TryVoidThrasherLocalAbility(unit thrasher, int player) {
    unit target;
    int abilityIndex;
    int abilityCount;
    int commandIndex;
    string abilityType;
    order castOrder;
    if (thrasher == null || !UnitIsAlive(thrasher)) { return false; }
    target = APRG_NearestPlayerHeroAbilityTarget(thrasher, player, 12.0);
    if (target == null) { return false; }

    if (CatalogEntryIsValid(c_gameCatalogAbil, "KaiserWormScourgeMissile")) {
        castOrder = OrderTargetingUnit(AbilityCommand("KaiserWormScourgeMissile", 0), target);
        if (UnitOrderIsValid(thrasher, castOrder)) {
            UnitIssueOrder(thrasher, castOrder, c_orderQueueReplace);
            return true;
        }
        castOrder = OrderTargetingPoint(AbilityCommand("KaiserWormScourgeMissile", 0), UnitGetPosition(target));
        if (UnitOrderIsValid(thrasher, castOrder)) {
            UnitIssueOrder(thrasher, castOrder, c_orderQueueReplace);
            return true;
        }
    }

    abilityCount = MinI(64, UnitAbilityCount(thrasher));
    for (abilityIndex = 1; abilityIndex <= abilityCount; abilityIndex += 1) {
        abilityType = UnitAbilityGet(thrasher, abilityIndex);
        if (abilityType == "" || abilityType == "KaiserWormScourgeMissile" || !APRG_IsCombatHeroAbility(abilityType)) { continue; }
        for (commandIndex = 0; commandIndex < 4; commandIndex += 1) {
            castOrder = OrderTargetingUnit(AbilityCommand(abilityType, commandIndex), target);
            if (UnitOrderIsValid(thrasher, castOrder)) { UnitIssueOrder(thrasher, castOrder, c_orderQueueReplace); return true; }
            castOrder = OrderTargetingPoint(AbilityCommand(abilityType, commandIndex), UnitGetPosition(target));
            if (UnitOrderIsValid(thrasher, castOrder)) { UnitIssueOrder(thrasher, castOrder, c_orderQueueReplace); return true; }
            castOrder = Order(AbilityCommand(abilityType, commandIndex));
            if (UnitOrderIsValid(thrasher, castOrder)) { UnitIssueOrder(thrasher, castOrder, c_orderQueueReplace); return true; }
        }
    }
    return false;
}

void APRG_TickVoidThrashers(int player, fixed now) {
    int i;
    unit thrasher;
    unit target;
    unitgroup structures;
    fixed nextShot;
    string key;
    APRG_TickVoidThrasherMapVision();
    structures = APRG_PlayerTargetableStructures(player);
    if (UnitGroupCount(structures, c_unitCountAlive) <= 0) { return; }
    for (i = UnitGroupCount(g_aprgVoidThrashers, c_unitCountAlive); i > 0; i -= 1) {
        thrasher = UnitGroupUnitFromEnd(g_aprgVoidThrashers, i);
        if (thrasher == null || !UnitIsAlive(thrasher)) { continue; }
        target = UnitGroupClosestToPoint(structures, UnitGetPosition(thrasher));
        if (target == null) { continue; }
        key = "APRG_VoidThrasherNextShot_" + IntToString(UnitGetTag(thrasher));
        nextShot = DataTableGetFixed(true, key);

        UnitSetPropertyFixed(thrasher, c_unitPropMovementSpeed, 0.0);
        if (now < nextShot) { continue; }
        if (APRG_TryVoidThrasherLocalAbility(thrasher, player)) {
            DataTableSetFixed(true, key, now + 4.0);
            continue;
        }
        if (CatalogEntryIsValid(c_gameCatalogAbil, "KaiserWormScourgeMissile")) {
            UnitIssueOrder(thrasher, OrderTargetingUnit(AbilityCommand("KaiserWormScourgeMissile", 0), target), c_orderQueueReplace);
        }
        else {
            UnitIssueOrder(thrasher, OrderTargetingUnit(AbilityCommand("attack", 0), target), c_orderQueueReplace);
        }
        DataTableSetFixed(true, key, now + 4.0);
    }
}

void APRG_ApplySquishy(int player) {
    unitgroup units = APRG_PlayerAllUnits(player);
    int i = UnitGroupCount(units, c_unitCountAlive);
    unit u;
    string unitType;
    string key;

    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null) { break; }
        unitType = UnitGetType(u);
        key = "APRG_Squishy_" + IntToString(player) + "_" + unitType;
        CatalogFieldValueSet(c_gameCatalogUnit, unitType, "LifeArmor", player, "0");
        CatalogFieldValueSet(c_gameCatalogUnit, unitType, "ShieldArmor", player, "0");
        DataTableSetBool(true, key, true);
    }
}

bool APRG_ForcedVariety_Func(bool testConds, bool runActions) {
    string unitType;
    fixed mineralCost;
    fixed gasCost;
    int player;

    if (!runActions || !g_aprgStarted || !APRG_HasMutation(APRG_MUT_FORCED_VARIETY) || !APRG_PlayerMacroBaseReady(APRG_GetPrimaryPlayer())) { return true; }
    player = APRG_GetPrimaryPlayer();
    if (EventPlayer() != player) { return true; }
    unitType = libNtve_gf_TriggeringProgressUnitType();
    if (unitType == "" || !CatalogEntryIsValid(c_gameCatalogUnit, unitType)) { return true; }

    mineralCost = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "CostResource[0]", player));
    gasCost = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "CostResource[1]", player));
    if (mineralCost > 0.0) {
        CatalogFieldValueSet(
            c_gameCatalogUnit, unitType, "CostResource[0]", player,
            IntToString(FixedToInt(RoundI(mineralCost * 1.02)))
        );
    }
    if (gasCost > 0.0) {
        CatalogFieldValueSet(
            c_gameCatalogUnit, unitType, "CostResource[1]", player,
            IntToString(FixedToInt(RoundI(gasCost * 1.02)))
        );
    }
    return true;
}




const int APRG_UNEXPECTED_CANDIDATE_COUNT = 30;

string APRG_UnexpectedCandidate(int index) {
    if (index == 0) { return "Marine"; }
    if (index == 1) { return "Marauder"; }
    if (index == 2) { return "Firebat"; }
    if (index == 3) { return "Hellion"; }
    if (index == 4) { return "Goliath"; }
    if (index == 5) { return "SiegeTank"; }
    if (index == 6) { return "VikingFighter"; }
    if (index == 7) { return "Banshee"; }
    if (index == 8) { return "Battlecruiser"; }
    if (index == 9) { return "Thor"; }
    if (index == 10) { return "Zergling"; }
    if (index == 11) { return "Roach"; }
    if (index == 12) { return "Hydralisk"; }
    if (index == 13) { return "Mutalisk"; }
    if (index == 14) { return "Infestor"; }
    if (index == 15) { return "Ultralisk"; }
    if (index == 16) { return "BroodLord"; }
    if (index == 17) { return "Zealot"; }
    if (index == 18) { return "Stalker"; }
    if (index == 19) { return "Dragoon"; }
    if (index == 20) { return "Sentry"; }
    if (index == 21) { return "HighTemplar"; }
    if (index == 22) { return "Immortal"; }
    if (index == 23) { return "Colossus"; }
    if (index == 24) { return "VoidRay"; }
    if (index == 25) { return "Carrier"; }
    if (index == 26) { return "Tempest"; }
    if (index == 27) { return "Archon"; }
    if (index == 28) { return "Diamondback"; }
    if (index == 29) { return "Lurker"; }
    return "";
}

fixed APRG_UnitResourceCost(string unitType, int player) {
    fixed minerals;
    fixed gas;
    if (unitType == "" || !CatalogEntryIsValid(c_gameCatalogUnit, unitType)) { return -1.0; }
    minerals = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "CostResource[0]", player));
    gas = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "CostResource[1]", player));
    return minerals + gas;
}

string APRG_UnexpectedEvolutionCanonicalType(int player, string candidate) {
    if (
        candidate == "Stalker" &&
        CatalogEntryIsValid(c_gameCatalogUnit, "StalkerShakuras") &&
        APRG_PlayerSpawnCandidateHealthy(player, "StalkerShakuras", false)
    ) { return "StalkerShakuras"; }
    return candidate;
}

string APRG_FindUnexpectedEvolutionReplacement(int player, string trainedType) {
    fixed trainedCost;
    fixed candidateCost;
    int eligibleCount;
    int targetEligible;
    int i;
    string candidate;

    trainedCost = APRG_UnitResourceCost(trainedType, player);
    if (trainedCost < 0.0) { return ""; }

    eligibleCount = 0;
    for (i = 0; i < APRG_UNEXPECTED_CANDIDATE_COUNT; i += 1) {
        candidate = APRG_UnexpectedCandidate(i);
        if (candidate == "" || candidate == trainedType || !CatalogEntryIsValid(c_gameCatalogUnit, candidate)) { continue; }
        candidateCost = APRG_UnitResourceCost(candidate, player);
        if (candidateCost > trainedCost) { eligibleCount += 1; }
    }
    if (eligibleCount <= 0) { return ""; }

    targetEligible = RandomInt(1, eligibleCount);
    eligibleCount = 0;
    for (i = 0; i < APRG_UNEXPECTED_CANDIDATE_COUNT; i += 1) {
        candidate = APRG_UnexpectedCandidate(i);
        if (candidate == "" || candidate == trainedType || !CatalogEntryIsValid(c_gameCatalogUnit, candidate)) { continue; }
        candidateCost = APRG_UnitResourceCost(candidate, player);
        if (candidateCost <= trainedCost) { continue; }
        eligibleCount += 1;
        if (eligibleCount == targetEligible) { return APRG_UnexpectedEvolutionCanonicalType(player, candidate); }
    }
    return "";
}

void APRG_EnsureBlinkOnUnit(int player, unit u);

bool APRG_OccasionalBlessing_Func(bool testConds, bool runActions) {
    int player;
    int roll;
    int threshold;
    unit trained;
    string trainedType;
    string replacementType;
    point p;
    fixed facing;
    unitgroup created;
    unit replacement;

    if (!runActions || !g_aprgStarted) { return true; }
    if (
        !APRG_HasExtension(APRG_EXT_BLESS_OCCASIONAL_THOR) &&
        !APRG_HasExtension(APRG_EXT_BLESS_OCCASIONAL_ULTRALISK) &&
        !APRG_HasExtension(APRG_EXT_BLESS_OCCASIONAL_COLOSSUS) &&
        !APRG_HasExtension(APRG_EXT_BLESS_UNEXPECTED_EVOLUTION)
    ) {
        return true;
    }

    player = APRG_GetPrimaryPlayer();
    if (EventPlayer() != player) { return true; }
    trained = EventUnitProgressUnit();
    if (trained == null || !UnitIsAlive(trained)) { return true; }
    trainedType = UnitGetType(trained);

    roll = RandomInt(1, 10000);
    threshold = 0;
    replacementType = "";

    if (APRG_HasExtension(APRG_EXT_BLESS_OCCASIONAL_THOR)) {
        threshold += 400;
        if (roll <= threshold) { replacementType = "Thor"; }
    }
    if (replacementType == "" && APRG_HasExtension(APRG_EXT_BLESS_OCCASIONAL_ULTRALISK)) {
        threshold += 400;
        if (roll <= threshold) { replacementType = "Ultralisk"; }
    }
    if (replacementType == "" && APRG_HasExtension(APRG_EXT_BLESS_OCCASIONAL_COLOSSUS)) {
        threshold += 400;
        if (roll <= threshold) { replacementType = "Colossus"; }
    }
    if (replacementType == "" && APRG_HasExtension(APRG_EXT_BLESS_UNEXPECTED_EVOLUTION)) {
        threshold += 2000;
        if (roll <= threshold) {
            replacementType = APRG_FindUnexpectedEvolutionReplacement(player, trainedType);
        }
    }
    if (
        replacementType == "" ||
        !CatalogEntryIsValid(c_gameCatalogUnit, replacementType) ||
        trainedType == replacementType
    ) {
        return true;
    }

    replacementType = APRG_PlayerSpawnCatalogTypeForPlayer(replacementType, player);
    p = UnitGetPosition(trained);
    facing = UnitGetFacing(trained);

    libNtve_gf_ReplaceUnit(trained, replacementType, libNtve_ge_ReplaceUnitOptions_OldUnitsRelative);
    replacement = libNtve_gf_LastReplacedUnit();
    if (replacement != null && APRG_HasExtension(APRG_EXT_BLESS_BLINK)) { APRG_EnsureBlinkOnUnit(player, replacement); }
    return true;
}


bool APRG_IsOccasionalReplacementSource(string unitType) {
    return (
        unitType == "Marine" ||
        unitType == "Zealot" ||
        unitType == "Zergling" ||
        unitType == "Marauder" ||
        unitType == "Firebat" ||
        unitType == "Hellion" ||
        unitType == "Goliath" ||
        unitType == "Stalker" ||
        unitType == "Dragoon" ||
        unitType == "Roach" ||
        unitType == "Hydralisk"
    );
}

void APRG_ApplyOccasionalEnemyReplacement(int player, string replacementType) {
    unitgroup enemies;
    unitgroup created;
    int i;
    int slot;
    unit u;
    unit replacement;
    string unitType;
    point p;
    int owner;
    if (!CatalogEntryIsValid(c_gameCatalogUnit, replacementType)) { return; }
    enemies = APRG_EnemyMobileUnits(player);
    for (i = UnitGroupCount(enemies, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(enemies, i); if (u == null) { break; }
        unitType = UnitGetType(u);
        if (!APRG_IsOccasionalReplacementSource(unitType) || RandomInt(1, 80) > 1) { continue; }
        p = UnitGetPosition(u); owner = UnitGetOwner(u); UnitRemove(u);
        created = UnitCreate(1, replacementType, c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
        replacement = UnitGroupUnitFromEnd(created, 1);
        if (replacement != null && g_aprgOccasionalRaidCount < 128) {
            slot = g_aprgOccasionalRaidCount; g_aprgOccasionalRaidUnits[slot] = replacement;
            g_aprgOccasionalRaidTimes[slot] = GameGetMissionTime() + 360.0; g_aprgOccasionalRaidCount += 1;
        }
    }
}

void APRG_ApplyEnemyRegeneration(int player) {
    unitgroup enemies = APRG_EnemyAllUnits(player);
    int i = UnitGroupCount(enemies, c_unitCountAlive);
    unit u;
    fixed current;
    fixed maximum;
    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(enemies, i);
        if (u == null) { break; }

        maximum = UnitGetPropertyFixed(u, c_unitPropLifeMax, c_unitPropCurrent);
        current = UnitGetPropertyFixed(u, c_unitPropLife, c_unitPropCurrent);
        if (maximum > 0.0 && current < maximum) {
            UnitSetPropertyFixed(u, c_unitPropLife, MinF(maximum, current + 5.0));
        }

        maximum = UnitGetPropertyFixed(u, c_unitPropShieldsMax, c_unitPropCurrent);
        current = UnitGetPropertyFixed(u, c_unitPropShields, c_unitPropCurrent);
        if (maximum > 0.0 && current < maximum) {
            UnitSetPropertyFixed(u, c_unitPropShields, MinF(maximum, current + 5.0));
        }
    }
}

void APRG_ApplyBlindingLight(int player) {
    unitgroup enemies = APRG_EnemyAllUnits(player);
    int i = UnitGroupCount(enemies, c_unitCountAlive);
    unit u;
    int owner;
    string unitType;
    string key;
    fixed sight;
    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(enemies, i);
        if (u == null) { break; }
        if (APRG_IsRakShirObjectiveUnit(u)) { continue; }
        owner = UnitGetOwner(u);
        if (owner < 0) { continue; }
        unitType = UnitGetType(u);
        key = "APRG_BlindingLight_" + IntToString(owner) + "_" + unitType;
        if (DataTableGetBool(true, key)) { continue; }
        sight = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "Sight", owner));
        sight = MaxF(0.0, sight - 4.0);
        CatalogFieldValueSet(c_gameCatalogUnit, unitType, "Sight", owner, FixedToString(sight, c_fixedPrecisionAny));
        DataTableSetBool(true, key, true);
    }
}

void APRG_GiveSpecialistsIfReady(int player) {
    unit home;
    point p;
    string unitType;
    string preferredType;
    int i;
    unitgroup created;
    unit specialist;
    if (g_aprgSpecialistsGiven || !APRG_PlayerMacroBaseReady(player)) { return; }
    home = APRG_FindPlayerHomeStructure(player);
    if (home == null) { return; }
    p = APRG_FindGroundPointNear(UnitGetPosition(home), 4.0, 9.0);
    if (p == null) { return; }

    for (i = 0; i < 10; i += 1) {
        unitType = "";
        preferredType = "";
        if (i == 0) {
            unitType = "Ghost";
            preferredType = "AP_Ghost";
        }
        else if (i == 1) { unitType = "Raven"; }
        else if (i == 2) { unitType = "ScienceVessel"; }
        else if (i == 3) {
            unitType = "Infestor";
            preferredType = "AP_Infestor";
        }
        else if (i == 4) {
            if (APRG_PlayerSpawnCandidateHealthy(player, "DefilerMP", false)) { unitType = "DefilerMP"; }
        }
        else if (i == 5) {
            unitType = "Spectre";
            preferredType = "AP_Spectre";
        }
        else if (i == 6) { unitType = "Viper"; }
        else if (i == 7) {
            if (CatalogEntryIsValid(c_gameCatalogUnit, "AP_HighTemplar")) { unitType = "AP_HighTemplar"; }
            else if (CatalogEntryIsValid(c_gameCatalogUnit, "HighTemplar")) { unitType = "HighTemplar"; }
            else if (CatalogEntryIsValid(c_gameCatalogUnit, "HighTemplarShakuras")) { unitType = "HighTemplarShakuras"; }
        }
        else if (i == 8) {
            unitType = "Sentry";
            preferredType = "AP_SentryAiur";
        }
        else if (i == 9) {
            unitType = "Oracle";
            preferredType = "AP_Oracle";
        }
        if (unitType != "" && CatalogEntryIsValid(c_gameCatalogUnit, unitType)) {
            if (unitType == "DefilerMP") {
                created = APRG_CreatePlayerUnitsVanillaSafe(1, unitType, player, p, libNtve_gf_RandomAngle());
            }
            else if (preferredType != "") {
                created = APRG_CreatePreferredPlayerUnitsSafe(1, preferredType, unitType, player, p, libNtve_gf_RandomAngle());
            }
            else {
                created = APRG_CreatePlayerUnitsSafe(1, unitType, player, p, libNtve_gf_RandomAngle());
            }
            specialist = UnitGroupUnitFromEnd(created, 1);
        }
    }
    g_aprgSpecialistsGiven = true;
}

void APRG_ApplyFortifications(int player) {
    unitgroup structures = APRG_PlayerStructures(player);
    int i = UnitGroupCount(structures, c_unitCountAlive);
    unit u;
    string unitType;
    string key;
    fixed armor;
    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(structures, i);
        if (u == null) { break; }
        unitType = UnitGetType(u);
        key = "APRG_Fortifications_" + IntToString(player) + "_" + unitType;
        if (DataTableGetBool(true, key)) { continue; }

        armor = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "LifeArmor", player));
        CatalogFieldValueSet(c_gameCatalogUnit, unitType, "LifeArmor", player, FixedToString(armor + 5.0, c_fixedPrecisionAny));
        armor = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "ShieldArmor", player));
        CatalogFieldValueSet(c_gameCatalogUnit, unitType, "ShieldArmor", player, FixedToString(armor + 5.0, c_fixedPrecisionAny));
        DataTableSetBool(true, key, true);
    }
}

int APRG_FindBanelingSource(unit base) {
    int i;
    for (i = 0; i < APRG_MAX_CONGA_SOURCES; i += 1) {
        if (g_aprgBanelingSources[i] == base) { return i; }
    }
    return -1;
}

int APRG_FindFreeBanelingSource() {
    int i;
    for (i = 0; i < APRG_MAX_CONGA_SOURCES; i += 1) {
        if (g_aprgBanelingSources[i] == null) { return i; }
    }
    return -1;
}

void APRG_RegisterBanelingSource(unit base, fixed now) {
    int slot;
    if (base == null || !UnitIsAlive(base) || !APRG_IsTownHallType(UnitGetType(base))) { return; }
    if (APRG_FindBanelingSource(base) >= 0) { return; }
    slot = APRG_FindFreeBanelingSource();
    if (slot < 0) { return; }
    g_aprgBanelingSources[slot] = base;
    g_aprgBanelingNextTime[slot] = now + RandomFixed(5.0, 15.0);
}

void APRG_RegisterBanelingSources(int player, fixed now) {
    unitgroup structures = APRG_PlayerStructures(player);
    int i = UnitGroupCount(structures, c_unitCountAlive);
    unit base;

    for (; i > 0; i -= 1) {
        base = UnitGroupUnitFromEnd(structures, i);
        if (base == null) { break; }
        if (APRG_IsTownHallType(UnitGetType(base))) {
            APRG_RegisterBanelingSource(base, now);
        }
    }
}

unitgroup APRG_CreatePlayerBaneling(int player, point p) {
    unitgroup created;
    if (!CatalogEntryIsValid(c_gameCatalogUnit, "Baneling")) { return UnitGroupEmpty(); }
    // Baneling Stream is intentionally a self-guided combat unit. Some AP
    // production variants lack the normal suicide attack order, so spawn the
    // campaign Baneling directly instead of substituting an AP alias.
    created = APRG_CreatePlayerUnitsVanillaSafe(1, "Baneling", player, p, libNtve_gf_RandomAngle());
    if (created != null && UnitGroupCount(created, c_unitCountAlive) > 0) { return created; }
    return UnitCreate(1, "Baneling", c_unitCreateIgnorePlacement, player, p, libNtve_gf_RandomAngle());
}

unit APRG_NearestEnemyGroundMobile(point fromPoint, int player) {
    unitgroup units = UnitGroupFilterPlane(APRG_EnemyMobileUnits(player), c_planeGround, 0);
    if (UnitGroupCount(units, c_unitCountAlive) <= 0) { return null; }
    return UnitGroupClosestToPoint(units, fromPoint);
}

// Do not use APRG_OrderAttackMove here: its general-purpose support-unit
// fallback issues a plain move if the attack command is invalid. A Baneling
// must never silently switch to movement-only orders.
bool APRG_OrderBanelingStreamAttackMove(unit u, point destination) {
    order attackOrder;
    if (u == null || !UnitIsAlive(u) || destination == null) { return false; }
    attackOrder = OrderTargetingPoint(AbilityCommand("attack", 0), destination);
    if (!UnitOrderIsValid(u, attackOrder)) { return false; }
    UnitIssueOrder(u, attackOrder, c_orderQueueReplace);
    return true;
}

// Prefer actual reachable enemy buildings instead of retargeting at roaming
// defenders. The 6-point reach tolerance accounts for unpathable building
// footprints; ground connectivity is still required for island missions.
unit APRG_BanelingStreamBuildingTarget(unit u, int player) {
    unitgroup structures;
    unit candidate;
    unit closest = null;
    int i;
    fixed distance;
    fixed closestDistance = 999999.0;
    if (u == null || !UnitIsAlive(u)) { return null; }
    structures = APRG_EnemyTargetableStructures(player);
    for (i = UnitGroupCount(structures, c_unitCountAlive); i > 0; i -= 1) {
        candidate = UnitGroupUnitFromEnd(structures, i);
        if (candidate == null || !UnitIsAlive(candidate) || UnitTestState(candidate, c_unitStateInvulnerable)) { continue; }
        if (!UnitPathableToPoint(u, UnitGetPosition(candidate), 6.0, 100000.0)) { continue; }
        distance = DistanceBetweenPoints(UnitGetPosition(u), UnitGetPosition(candidate));
        if (distance < closestDistance) { closest = candidate; closestDistance = distance; }
    }
    return closest;
}

void APRG_OrderBanelingStreamUnit(unit u, int player) {
    unit building;
    unit target;
    point destination;
    if (u == null || !UnitIsAlive(u)) { return; }

    // Baneling Stream promises to attack the enemy BASE. Prioritize a
    // reachable hostile structure, not an arbitrary roaming ground unit.
    building = APRG_BanelingStreamBuildingTarget(u, player);
    if (building != null) {
        destination = UnitGetPosition(building);
        if (APRG_OrderBanelingStreamAttackMove(u, destination)) { return; }
    }

    // When no structure can be reached (e.g. an island or an all-unit map),
    // attack-move toward a ground enemy before falling back to patrol.
    target = APRG_NearestEnemyGroundMobile(UnitGetPosition(u), player);
    if (target != null && UnitPathableToPoint(u, UnitGetPosition(target), 3.0, 100000.0)) {
        destination = UnitGetPosition(target);
        if (APRG_OrderBanelingStreamAttackMove(u, destination)) { return; }
    }
    destination = APRG_RandomFixedPatrolPointForUnit(u, player, true);
    if (destination != null) { APRG_OrderBanelingStreamAttackMove(u, destination); }
}

void APRG_TickBanelingStream(int player, fixed now) {
    int i;
    unit base;
    point p;
    unitgroup created;
    if (!APRG_PlayerMacroBaseReady(player)) { return; }

    APRG_RegisterBanelingSources(player, now);
    for (i = 0; i < APRG_MAX_CONGA_SOURCES; i += 1) {
        base = g_aprgBanelingSources[i];
        if (base == null) { continue; }
        if (!UnitIsAlive(base) || UnitGetOwner(base) != player || !APRG_IsTownHallType(UnitGetType(base))) {
            g_aprgBanelingSources[i] = null;
            g_aprgBanelingNextTime[i] = 0.0;
            continue;
        }
        if (now < g_aprgBanelingNextTime[i]) { continue; }
        p = APRG_FindGroundPointNear(UnitGetPosition(base), 3.0, 8.0);
        if (p == null) { p = UnitGetPosition(base); }
        created = APRG_CreatePlayerBaneling(player, p);
        if (created != null && UnitGroupCount(created, c_unitCountAlive) > 0) {
            APRG_MakeGroupUncommandable(created);
            UnitGroupAddUnitGroup(g_aprgBanelingStreamUnits, created);
            APRG_OrderBanelingStreamUnit(UnitGroupUnitFromEnd(created, 1), player);
        }
        g_aprgBanelingNextTime[i] = now + RandomFixed(5.0, 15.0);
    }

    if (now >= g_aprgNextBanelingStreamRetargetTime) {
        for (i = UnitGroupCount(g_aprgBanelingStreamUnits, c_unitCountAlive); i > 0; i -= 1) {
            APRG_OrderBanelingStreamUnit(UnitGroupUnitFromEnd(g_aprgBanelingStreamUnits, i), player);
        }
        g_aprgNextBanelingStreamRetargetTime = now + 8.0;
    }
}

unit APRG_CreateTychusAtHome(int player) {
    unit home;
    point p;
    unitgroup created;
    if (!CatalogEntryIsValid(c_gameCatalogUnit, "TychusCommando")) { return null; }
    home = APRG_FindPlayerHomeStructure(player);
    if (home == null) { return null; }
    p = APRG_FindGroundPointNear(UnitGetPosition(home), 4.0, 8.0);
    if (p == null) { return null; }
    created = APRG_CreatePlayerUnitsSafe(1, "TychusCommando", player, p, libNtve_gf_RandomAngle());
    if (created == null || UnitGroupCount(created, c_unitCountAlive) <= 0) { return null; }
    return UnitGroupUnitFromEnd(created, 1);
}

void APRG_GiveTychusIfReady(int player, fixed now) {
    if (g_aprgTychusGiven || !APRG_PlayerMacroBaseReady(player)) { return; }
    if (!CatalogEntryIsValid(c_gameCatalogUnit, "TychusCommando")) {
        g_aprgTychusGiven = true;
        return;
    }
    g_aprgTychus = APRG_CreateTychusAtHome(player);
    if (g_aprgTychus != null) {
        g_aprgNextTychusOrderTime = now;
        g_aprgTychusDeathTime = -1.0;
    }
    g_aprgTychusGiven = true;
}

void APRG_TickTychus(int player, fixed now) {
    unit target;
    if (!g_aprgTychusGiven) { APRG_GiveTychusIfReady(player, now); }
    if (!g_aprgTychusGiven) { return; }

    if (g_aprgTychus == null) {
        if (g_aprgTychusDeathTime < 0.0) { g_aprgTychusDeathTime = now; }
        if (now - g_aprgTychusDeathTime >= 15.0) {
            g_aprgTychus = APRG_CreateTychusAtHome(player);
            if (g_aprgTychus != null) {
                g_aprgTychusDeathTime = -1.0;
                g_aprgNextTychusOrderTime = now + RandomFixed(10.0, 25.0);
            }
        }
        return;
    }
    if (!UnitIsAlive(g_aprgTychus)) {
        if (g_aprgTychusDeathTime < 0.0) { g_aprgTychusDeathTime = now; }
        if (now - g_aprgTychusDeathTime >= 15.0) {
            UnitRevive(g_aprgTychus);
            if (UnitIsAlive(g_aprgTychus)) {
                UnitSetPropertyFixed(g_aprgTychus, c_unitPropLifePercent, 100.0);
                g_aprgTychusDeathTime = -1.0;
                g_aprgNextTychusOrderTime = now + RandomFixed(10.0, 25.0);
            }
        }
        return;
    }
    g_aprgTychusDeathTime = -1.0;
    if (now < g_aprgNextTychusOrderTime) { return; }
    target = APRG_NearestEligibleEnemyStructure(UnitGetPosition(g_aprgTychus), player);
    if (target != null) {
        APRG_OrderAttackMove(g_aprgTychus, UnitGetPosition(target));
    }
    g_aprgNextTychusOrderTime = now + RandomFixed(10.0, 25.0);
}

void APRG_TickZagarasAid(int player, fixed now) {
    unit home;
    point p;
    if (!APRG_PlayerMacroBaseReady(player) || now < g_aprgNextZagaraAidTime) { return; }
    if (!CatalogEntryIsValid(c_gameCatalogUnit, "Baneling")) {
        g_aprgNextZagaraAidTime = now + 600.0;
        return;
    }
    home = APRG_FindPlayerHomeStructure(player);
    if (home == null) {
        g_aprgNextZagaraAidTime = now + 1.0;
        return;
    }
    p = APRG_FindGroundPointNear(UnitGetPosition(home), 4.0, 10.0);
    if (p == null) {
        g_aprgNextZagaraAidTime = now + 1.0;
        return;
    }
    APRG_CreatePlayerUnitsSafe(100, "Baneling", player, p, libNtve_gf_RandomAngle());
    g_aprgNextZagaraAidTime = now + 600.0;
}

void APRG_ApplyLogistics(int player) {
    PlayerModifyPropertyFixed(player, c_playerPropSuppliesLimit, c_playerPropOperSetTo, 400.0);
}

void APRG_BeginNuclearAnnihilation(int player, fixed now) {
    point p;
    int owner;

    if (g_aprgNukePending) { return; }
    if (
        !CatalogEntryIsValid(c_gameCatalogModel, "GhostNukeIndicator") ||
        !CatalogEntryIsValid(c_gameCatalogEffect, "NukeDamage")
    ) { return; }

    p = RegionRandomPoint(RegionPlayableMap());
    if (p == null) { return; }
    owner = APRG_FindHostileOwnerNearPoint(player, p);
    if (owner < 0) { return; }

    g_aprgNukeIndicator = libNtve_gf_CreateModelAtPoint("GhostNukeIndicator", p);
    PingCreate(PlayerGroupAll(), "PingWarning", p, ColorWithAlpha(100.00, 0.00, 0.00, 0.00), 16.0);
    PingSetScale(PingLastCreated(), 1.5);
    g_aprgPendingNukePoint = p;
    g_aprgPendingNukeOwner = owner;
    g_aprgNukeDetonateTime = now + 19.0;
    g_aprgNukeFinalWarningShown = false;
    g_aprgNukePending = true;
}

void APRG_TickNuclearAnnihilation(int player, fixed now) {
    if (!APRG_PlayerMacroBaseReady(player) || g_aprgMacroReadyTime < 0.0) {
        if (g_aprgNukePending) {
            if (g_aprgNukeIndicator != null) { ActorSend(g_aprgNukeIndicator, "Destroy"); }
            g_aprgNukePending = false;
            g_aprgNukeFinalWarningShown = false;
            g_aprgPendingNukePoint = null;
            g_aprgPendingNukeOwner = -1;
            g_aprgNukeIndicator = null;
        }
        return;
    }
    if (g_aprgNextNukeTime < g_aprgMacroReadyTime + 30.0) {
        g_aprgNextNukeTime = g_aprgMacroReadyTime + 30.0;
    }
    if (
        g_aprgNukePending &&
        !g_aprgNukeFinalWarningShown &&
        now >= g_aprgNukeDetonateTime - 5.0
    ) {
        PingCreate(
            PlayerGroupAll(), "PingWarning", g_aprgPendingNukePoint,
            ColorWithAlpha(100.00, 0.00, 0.00, 0.00), 5.0
        );
        PingSetScale(PingLastCreated(), 2.0);
        g_aprgNukeFinalWarningShown = true;
    }
    if (g_aprgNukePending && now >= g_aprgNukeDetonateTime) {
        APRG_CreateObjectiveSafeSlayEffect(g_aprgPendingNukeOwner, "NukeDamage", g_aprgPendingNukePoint, 12.0);
        if (g_aprgNukeIndicator != null) {
            ActorSend(g_aprgNukeIndicator, "Destroy");
        }
        g_aprgNukePending = false;
        g_aprgNukeFinalWarningShown = false;
        g_aprgPendingNukePoint = null;
        g_aprgPendingNukeOwner = -1;
        g_aprgNukeIndicator = null;
    }
    if (!g_aprgNukePending && now >= g_aprgNextNukeTime) {
        APRG_BeginNuclearAnnihilation(player, now);
        g_aprgNextNukeTime = now + 30.0;
    }
}

void APRG_EnforceNotEnoughEnergy(int player) {
    unitgroup units;
    int i;
    unit u;
    fixed energy;
    fixed now = GameGetMissionTime();
    if (!APRG_PlayerMacroBaseReady(player) || now < g_aprgNextEnergyLeakTime) { return; }
    g_aprgNextEnergyLeakTime = now + 3.0;
    units = APRG_PlayerAllUnits(player);
    for (i = UnitGroupCount(units, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null) { break; }
        energy = UnitGetPropertyFixed(u, c_unitPropEnergy, c_unitPropCurrent);
        if (energy > 0.0) { UnitSetPropertyFixed(u, c_unitPropEnergy, MaxF(0.0, energy - 1.0)); }
    }
}

void APRG_ApplyEnergyOverload(int player) {
    unitgroup units = APRG_PlayerMobileUnits(player);
    int i = UnitGroupCount(units, c_unitCountAlive);
    unit u;
    fixed regen;
    fixed maxEnergy;
    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null) {
            break;
        }
        if (UnitGroupHasUnit(g_aprgEnergyOverloadProcessed, u)) {
            continue;
        }
        maxEnergy = UnitGetPropertyFixed(u, c_unitPropEnergyMax, c_unitPropCurrent);
        regen = UnitGetPropertyFixed(u, c_unitPropEnergyRegen, c_unitPropNormal);
        if (maxEnergy > 0.0 && regen > 0.0) {
            UnitSetPropertyFixed(u, c_unitPropEnergyRegen, regen * 3.0);
        }
        UnitGroupAdd(g_aprgEnergyOverloadProcessed, u);
    }
}



void APRG_SetGroupLife(unitgroup group, fixed life) {
    int i;
    unit u;
    if (group == null || life <= 0.0) { return; }
    i = UnitGroupCount(group, c_unitCountAlive);
    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(group, i);
        if (u == null) { break; }
        UnitSetPropertyFixed(u, c_unitPropLifeMax, life);
        UnitSetPropertyFixed(u, c_unitPropLife, life);
    }
}

unitgroup APRG_CreateRealGorgon(int owner, point p) {
    unitgroup created;
    unit u;
    if (owner < 0 || p == null) { return UnitGroupEmpty(); }
    if (!CatalogEntryIsValid(c_gameCatalogUnit, "GehennaCruiser")) { return UnitGroupEmpty(); }
    created = UnitCreate(1, "GehennaCruiser", c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
    if (created == null || UnitGroupCount(created, c_unitCountAlive) <= 0) { return UnitGroupEmpty(); }
    u = UnitGroupUnitFromEnd(created, 1);
    if (u != null) {
        libNtve_gf_SendActorMessageToUnit(u, "AnimCopy ::external.GorgonFinderTag");
    }
    return created;
}

void APRG_SpawnAlliedGorgon(int player) {
    unit home;
    point p;
    unitgroup created;
    home = APRG_FindPlayerHomeStructure(player);
    if (home == null) { return; }

    p = PointWithOffsetPolar(UnitGetPosition(home), RandomFixed(5.0, 10.0), libNtve_gf_RandomAngle());
    if (p == null || !RegionContainsPoint(RegionPlayableMap(), p)) { p = UnitGetPosition(home); }
    created = APRG_CreateRealGorgon(player, p);
    if (created == null || UnitGroupCount(created, c_unitCountAlive) <= 0) { return; }
    APRG_SetGroupLife(created, 100.0);
    if (UnitGroupUnitFromEnd(created, 1) != null) {
        DataTableSetBool(true, "APRG_WarfieldGorgon_" + IntToString(UnitGetTag(UnitGroupUnitFromEnd(created, 1))), true);
    }
    APRG_AddAlliedSupport(created, p, player, true);
    APRG_PlayRandomWarfieldGorgonCall();
}

void APRG_SpawnEnemyGorgon(int player) {
    point p;
    int owner;
    unitgroup created;
    p = APRG_FindRaidOriginAirPoint(player);
    if (p == null) { return; }
    owner = APRG_FindHostileOwnerNearPoint(player, p);
    if (owner < 0) { return; }
    created = APRG_CreateRealGorgon(owner, p);
    if (created == null || UnitGroupCount(created, c_unitCountAlive) <= 0) { return; }
    APRG_EnsureAirReachableToPlayer(UnitGroupUnitFromEnd(created, 1), player);
    APRG_SetGroupLife(created, 100.0);
    if (UnitGroupUnitFromEnd(created, 1) != null) {
        DataTableSetBool(true, "APRG_WarfieldGorgon_" + IntToString(UnitGetTag(UnitGroupUnitFromEnd(created, 1))), true);
    }
    APRG_AddHostileRaiders(created, p, player);
    APRG_PlayRandomWarfieldGorgonCall();
}

void APRG_TickGorgons(int player, fixed now) {
    if (APRG_HasExtension(APRG_EXT_BLESS_ANOTHER_GORGON) && APRG_PlayerMacroBaseReady(player) && now >= g_aprgNextGorgonBlessingTime) {
        APRG_SpawnAlliedGorgon(player); g_aprgNextGorgonBlessingTime = now + 60.0;
    }
    if (APRG_HasExtension(APRG_EXT_MUT_ANOTHER_GORGON) && APRG_PlayerMacroBaseReady(player)) {
        if (g_aprgMacroReadyTime >= 0.0 && g_aprgNextGorgonMutationTime < g_aprgMacroReadyTime + 180.0) { g_aprgNextGorgonMutationTime = g_aprgMacroReadyTime + 180.0; }
        if (now >= g_aprgNextGorgonMutationTime) { APRG_SpawnEnemyGorgon(player); g_aprgNextGorgonMutationTime = now + 60.0; }
    }
}


void APRG_TickBurrowedZerglings(int player) {
    int burst;
    point p;
    unit base;
    unitgroup created;
    unitgroup playerUnits;
    int i;
    unit u;
    unit nearest;
    unit target;
    int owner;

    if (!CatalogEntryIsValid(c_gameCatalogUnit, "ZerglingBurrowed")) { return; }

    base = APRG_FindPlayerHomeStructure(player);
    if (!APRG_PlayerMacroBaseReady(player) || base == null) { return; }
    burst = 0;
    while (
        burst < 10 &&
        g_aprgBurrowedZerglingsSpawned < 150 &&
        g_aprgBurrowedZerglingAttempts < 1000
    ) {
        burst += 1;
        g_aprgBurrowedZerglingAttempts += 1;
        p = APRG_FindRandomGroundPoint();
        if (p == null) { continue; }
        if (!PointPathingIsConnected(p, UnitGetPosition(base))) { continue; }
        if (DistanceBetweenPoints(p, UnitGetPosition(base)) < 30.0) { continue; }
        owner = APRG_FindHostileOwnerNearPoint(player, p);
        if (owner < 0) { continue; }
        created = UnitCreate(1, "ZerglingBurrowed", c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
        u = UnitGroupUnitFromEnd(created, 1);
        if (u != null) {
            UnitIssueOrder(u, OrderSetAutoCast(AbilityCommand("BurrowZerglingUp", 0), true), c_orderQueueReplace);
            UnitGroupAdd(g_aprgBurrowedZerglings, u);
            g_aprgBurrowedZerglingsSpawned += 1;
        }
    }

    playerUnits = APRG_PlayerMobileUnits(player);
    i = UnitGroupCount(g_aprgBurrowedZerglings, c_unitCountAlive);
    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(g_aprgBurrowedZerglings, i);
        if (u == null || !UnitIsAlive(u)) { continue; }
        nearest = UnitGroupClosestToPoint(playerUnits, UnitGetPosition(u));
        if (nearest == null || DistanceBetweenPoints(UnitGetPosition(u), UnitGetPosition(nearest)) > 8.0) { continue; }

        UnitIssueOrder(u, Order(AbilityCommand("BurrowZerglingUp", 0)), c_orderQueueReplace);
        target = APRG_NearestPlayerStructure(UnitGetPosition(u), player);
        if (target != null) {
            UnitIssueOrder(
                u,
                OrderTargetingPoint(AbilityCommand("attack", 0), UnitGetPosition(target)),
                c_orderQueueAddToEnd
            );
        }
        UnitGroupAdd(g_aprgHostileRaiders, u);
        UnitGroupRemove(g_aprgBurrowedZerglings, u);
    }
}

bool APRG_AddBestDonorWeapon(unit target, string donorType, point p, int owner, fixed minimumRange) {
    unitgroup donorGroup;
    unit donor;
    int count;
    int i;
    int bestIndex;
    fixed bestRange;
    fixed range;
    string weaponType;

    if (target == null || p == null || !CatalogEntryIsValid(c_gameCatalogUnit, donorType)) { return false; }
    donorGroup = UnitCreate(1, donorType, c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
    donor = UnitGroupUnitFromEnd(donorGroup, 1);
    if (donor == null) { return false; }
    count = UnitWeaponCount(donor);
    bestIndex = 0;
    bestRange = minimumRange;
    for (i = 1; i <= count; i += 1) {
        if (!UnitWeaponIsEnabled(donor, i)) { continue; }
        range = UnitWeaponRange(donor, i);
        if (range > bestRange) {
            bestRange = range;
            bestIndex = i;
        }
    }
    if (bestIndex > 0) {
        weaponType = UnitWeaponGet(donor, bestIndex);
        if (weaponType != "") {
            UnitWeaponAdd(target, weaponType, null);
        }
    }
    UnitRemove(donor);
    return bestIndex > 0;
}

bool APRG_AddBestDonorWeaponAnyState(unit target, string donorType, point p, int owner) {
    unitgroup donorGroup;
    unit donor;
    int count;
    int i;
    int bestIndex = 0;
    fixed bestRange = -1.0;
    fixed range;
    string weaponType;
    if (target == null || p == null || !CatalogEntryIsValid(c_gameCatalogUnit, donorType)) { return false; }
    donorGroup = UnitCreate(1, donorType, c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
    donor = UnitGroupUnitFromEnd(donorGroup, 1);
    if (donor == null) { return false; }
    count = UnitWeaponCount(donor);
    for (i = 1; i <= count; i += 1) {
        range = UnitWeaponRange(donor, i);
        if (range > bestRange) { bestRange = range; bestIndex = i; }
    }
    if (bestIndex > 0) {
        weaponType = UnitWeaponGet(donor, bestIndex);
        if (weaponType != "") { UnitWeaponAdd(target, weaponType, null); }
    }
    UnitRemove(donor);
    return bestIndex > 0;
}

bool APRG_AddGoliathAirWeapon(unit target, point p, int owner) {
    unitgroup donorGroup;
    unit donor;
    int count;
    int i;
    int bestIndex;
    int fallbackIndex;
    fixed bestRange;
    fixed fallbackRange;
    fixed range;
    string weaponType;
    bool preferred;
    if (target == null || p == null || !CatalogEntryIsValid(c_gameCatalogUnit, "Goliath")) { return false; }
    donorGroup = UnitCreate(1, "Goliath", c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
    donor = UnitGroupUnitFromEnd(donorGroup, 1);
    if (donor == null) { return false; }
    count = UnitWeaponCount(donor);
    bestIndex = 0;
    fallbackIndex = 0;
    bestRange = -1.0;
    fallbackRange = -1.0;
    for (i = 1; i <= count; i += 1) {
        weaponType = UnitWeaponGet(donor, i);
        range = UnitWeaponRange(donor, i);
        if (range > fallbackRange) { fallbackRange = range; fallbackIndex = i; }
        preferred = (
            StringContains(weaponType, "Missile", c_stringAnywhere, c_stringNoCase) ||
            StringContains(weaponType, "Hellfire", c_stringAnywhere, c_stringNoCase) ||
            StringContains(weaponType, "Air", c_stringAnywhere, c_stringNoCase)
        );
        if (preferred && range >= bestRange) { bestRange = range; bestIndex = i; }
    }
    if (bestIndex <= 0) { bestIndex = fallbackIndex; }
    if (bestIndex > 0) {
        weaponType = UnitWeaponGet(donor, bestIndex);
        if (weaponType != "") { UnitWeaponAdd(target, weaponType, null); }
    }
    UnitRemove(donor);
    return bestIndex > 0;
}

point APRG_FindSniperThorPoint(int player) {
    unit home;
    point homePoint;
    point p;
    fixed distance;
    int attempts;
    home = APRG_FindPlayerHomeStructure(player);
    if (home == null) { return null; }
    homePoint = UnitGetPosition(home);
    for (attempts = 0; attempts < APRG_MAX_POINT_ATTEMPTS * 4; attempts += 1) {
        p = PointWithOffsetPolar(homePoint, RandomFixed(30.0, 50.0), libNtve_gf_RandomAngle());
        if (p == null || !RegionContainsPoint(RegionPlayableMap(), p) || !PointPathingPassable(p)) { continue; }
        if (APRG_PointNearRakShirDuel(p, 24.0)) { continue; }
        if (APRG_PointNearPlayerOrAlliedBuilding(p, player, 20.0)) { continue; }
        distance = DistanceBetweenPoints(p, homePoint);
        if (distance < 30.0 || distance > 50.0) { continue; }
        if (APRG_GroundSpawnsNeedPlayerPathing() && !PointPathingIsConnected(p, homePoint)) { continue; }
        return p;
    }
    return null;
}

void APRG_TrySpawnSniperThor(int player) {
    point p;
    int owner;
    unitgroup created;
    unit thor;
    fixed life;
    int weaponCount;
    int weaponIndex;
    fixed bestThorRange = 0.0;
    fixed range;
    int rangeStacks;
    if (g_aprgSniperThorSpawned || g_aprgSniperThorRetries >= APRG_STATIC_SPAWN_MAX_RETRIES) { return; }
    if (!CatalogEntryIsValid(c_gameCatalogUnit, "Thor")) { g_aprgSniperThorRetries = APRG_STATIC_SPAWN_MAX_RETRIES; return; }
    g_aprgSniperThorRetries += 1;
    p = APRG_FindSniperThorPoint(player); if (p == null) { return; }
    owner = APRG_FindHostileOwnerNearPoint(player, p); if (owner < 0) { return; }
    created = UnitCreate(1, "Thor", c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
    if (created == null || UnitGroupCount(created, c_unitCountAlive) <= 0) { return; }
    APRG_RegisterMutationEnemyGroup(created);
    thor = UnitGroupUnitFromEnd(created, 1); if (thor == null) { return; }
    life = UnitGetPropertyFixed(thor, c_unitPropLifeMax, c_unitPropCurrent);
    if (life > 0.0) { UnitSetPropertyFixed(thor, c_unitPropLifeMax, life * 3.0); UnitSetPropertyFixed(thor, c_unitPropLife, life * 3.0); }
    if (CatalogEntryIsValid(c_gameCatalogBehavior, "APRogueSniperThorDamage")) { UnitBehaviorAdd(thor, "APRogueSniperThorDamage", thor, 1); }
    weaponCount = UnitWeaponCount(thor);
    for (weaponIndex = 1; weaponIndex <= weaponCount; weaponIndex += 1) {
        if (!UnitWeaponIsEnabled(thor, weaponIndex)) { continue; }
        range = UnitWeaponRange(thor, weaponIndex); if (range > bestThorRange) { bestThorRange = range; }
    }
    if (bestThorRange > 0.0 && CatalogEntryIsValid(c_gameCatalogBehavior, "APRogueSniperThorRangeQuarter")) {
        rangeStacks = MaxI(1, FixedToInt(RoundI(bestThorRange * 8.0)));
        UnitBehaviorAdd(thor, "APRogueSniperThorRangeQuarter", thor, rangeStacks);
    }
    g_aprgSniperThor = thor;
    g_aprgSniperThorSpawned = true;
}

void APRG_TickSniperThorDefenseAttack(int player, fixed now) {
    if ((g_aprgMissionFlags & APRG_MISSION_FLAG_TIMED_DEFENSE) == 0 || APRG_TimeSinceMacroBase(now) < 960.0) { return; }
    if (g_aprgSniperThorDefenseAttackOrdered || g_aprgSniperThor == null || !UnitIsAlive(g_aprgSniperThor)) { return; }
    if (APRG_OrderAttackPlayer(g_aprgSniperThor, player)) {
        g_aprgSniperThorDefenseAttackOrdered = true;
    }
}

point APRG_TowerDefenseFrontPoint(point enemyHome, point playerHome, int attempt) {
    fixed progress;
    fixed x;
    fixed y;
    point center;
    point candidate;
    progress = MinF(0.90, 0.10 + IntToFixed(attempt) * 0.065);
    x = PointGetX(enemyHome) + (PointGetX(playerHome) - PointGetX(enemyHome)) * progress;
    y = PointGetY(enemyHome) + (PointGetY(playerHome) - PointGetY(enemyHome)) * progress;
    center = Point(x, y);
    candidate = APRG_FindGroundPointNear(center, 0.0, 6.0);
    if (candidate != null) { return candidate; }
    if (RegionContainsPoint(RegionPlayableMap(), center) && PointPathingPassable(center)) { return center; }
    return null;
}

string APRG_TowerDefenseBuildCommandString(int owner, string face) {
    int cardCount;
    int cardIndex;
    int buttonCount;
    int buttonIndex;
    string path;
    string candidateFace;
    string abilCmd;
    if (owner < 0 || face == "" || !CatalogEntryIsValid(c_gameCatalogUnit, "Probe")) { return ""; }
    cardCount = CatalogFieldValueCount(c_gameCatalogUnit, "Probe", "CardLayouts", owner);
    for (cardIndex = 0; cardIndex < cardCount; cardIndex += 1) {
        path = "CardLayouts[" + IntToString(cardIndex) + "].LayoutButtons";
        buttonCount = CatalogFieldValueCount(c_gameCatalogUnit, "Probe", path, owner);
        for (buttonIndex = 0; buttonIndex < buttonCount; buttonIndex += 1) {
            candidateFace = CatalogFieldValueGet(c_gameCatalogUnit, "Probe", path + "[" + IntToString(buttonIndex) + "].Face", owner);
            if (candidateFace != face) { continue; }
            abilCmd = CatalogFieldValueGet(c_gameCatalogUnit, "Probe", path + "[" + IntToString(buttonIndex) + "].AbilCmd", owner);
            if (abilCmd != "") { return abilCmd; }
        }
    }
    return "";
}

bool APRG_TowerDefenseStructureNear(int owner, point p, string typeNeedle, fixed radius) {
    unitgroup nearby;
    int i;
    unit u;
    if (owner < 0 || p == null || typeNeedle == "") { return false; }
    nearby = UnitGroup(null, owner, RegionCircle(p, radius), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    for (i = UnitGroupCount(nearby, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(nearby, i);
        if (u != null && StringContains(UnitGetType(u), typeNeedle, c_stringAnywhere, c_stringNoCase)) { return true; }
    }
    return false;
}

bool APRG_IssueTowerDefenseBuild(unit probe, string face, point center, fixed minRadius, fixed maxRadius) {
    int owner;
    int attempt;
    int oldMinerals;
    int oldGas;
    bool requirementsEnabled;
    bool restrictionsEnabled;
    bool issued;
    string abilCmdText;
    point buildPoint;
    order buildOrder;
    if (probe == null || !UnitIsAlive(probe) || center == null || face == "") { return false; }
    owner = UnitGetOwner(probe);
    if (owner < 0) { return false; }
    abilCmdText = APRG_TowerDefenseBuildCommandString(owner, face);
    if (abilCmdText == "") { return false; }

    oldMinerals = PlayerGetPropertyInt(owner, c_playerPropMinerals);
    oldGas = PlayerGetPropertyInt(owner, c_playerPropVespene);
    requirementsEnabled = TechTreeRequirementsEnabled(owner);
    restrictionsEnabled = TechTreeRestrictionsEnabled(owner);
    PlayerModifyPropertyInt(owner, c_playerPropMinerals, c_playerPropOperSetTo, MaxI(oldMinerals, 1000));
    PlayerModifyPropertyInt(owner, c_playerPropVespene, c_playerPropOperSetTo, MaxI(oldGas, 1000));
    TechTreeRequirementsEnable(owner, false);
    TechTreeRestrictionsEnable(owner, false);

    issued = false;
    for (attempt = 0; attempt < 10; attempt += 1) {
        buildPoint = APRG_FindGroundPointNear(center, minRadius, maxRadius);
        if (buildPoint == null) { continue; }
        if (face == "Pylon" && APRG_TowerDefenseStructureNear(owner, buildPoint, "Pylon", 3.0)) { continue; }
        if (face == "ShieldBattery" && !APRG_TowerDefenseStructureNear(owner, buildPoint, "PhotonCannon", 6.0)) { continue; }
        buildOrder = OrderTargetingPoint(StringToAbilCmd(abilCmdText), buildPoint);
        if (!UnitOrderIsValid(probe, buildOrder)) { continue; }
        if (UnitIssueOrder(probe, buildOrder, c_orderQueueReplace)) {
            issued = true;
            break;
        }
    }

    TechTreeRequirementsEnable(owner, requirementsEnabled);
    TechTreeRestrictionsEnable(owner, restrictionsEnabled);
    PlayerModifyPropertyInt(owner, c_playerPropMinerals, c_playerPropOperSetTo, oldMinerals);
    PlayerModifyPropertyInt(owner, c_playerPropVespene, c_playerPropOperSetTo, oldGas);
    return issued;
}

point APRG_TowerDefenseCreepTarget(point current, int player) {
    unit home;
    point homePoint;
    point center;
    point candidate;
    fixed x;
    fixed y;
    if (current == null) { return null; }
    home = APRG_FindPlayerHomeStructure(player);
    if (home == null) { return current; }
    homePoint = UnitGetPosition(home);
    x = PointGetX(current) + (PointGetX(homePoint) - PointGetX(current)) * 0.15;
    y = PointGetY(current) + (PointGetY(homePoint) - PointGetY(current)) * 0.15;
    center = Point(x, y);
    candidate = APRG_FindGroundPointNear(center, 0.0, 6.0);
    if (candidate != null) { return candidate; }
    if (RegionContainsPoint(RegionPlayableMap(), center) && PointPathingPassable(center)) { return center; }
    return current;
}

void APRG_StartTowerDefenseConstruction(unit probe, point target, fixed now) {
    string key;
    if (probe == null || !UnitIsAlive(probe) || target == null) { return; }
    key = "APRG_TowerDefenseProbe_" + IntToString(UnitGetTag(probe));
    DataTableSetInt(true, key + "_Stage", 1);
    DataTableSetInt(true, key + "_Failures", 0);
    DataTableSetFixed(true, key + "_SearchStart", -1.0);
    DataTableSetFixed(true, key + "_Next", now);
}

void APRG_TickTowerDefenseProbes(int player, fixed now) {
    int i;
    unit probe;
    string key;
    point target;
    point creepTarget;
    fixed started;
    fixed nextStage;
    fixed searchStart;
    fixed minRadius;
    fixed maxRadius;
    int stage;
    int buildIndex;
    int failures;
    int clusters;
    int owner;
    string face;
    bool issued;
    if (g_aprgTowerDefenseProbes == null) { return; }
    for (i = UnitGroupCount(g_aprgTowerDefenseProbes, c_unitCountAll); i > 0; i -= 1) {
        probe = UnitGroupUnitFromEnd(g_aprgTowerDefenseProbes, i);
        if (probe == null || !UnitIsAlive(probe)) {
            if (probe != null) { UnitGroupRemove(g_aprgTowerDefenseProbes, probe); }
            continue;
        }
        owner = UnitGetOwner(probe);
        key = "APRG_TowerDefenseProbe_" + IntToString(UnitGetTag(probe));
        target = Point(DataTableGetFixed(true, key + "_X"), DataTableGetFixed(true, key + "_Y"));
        started = DataTableGetFixed(true, key + "_Start");
        stage = DataTableGetInt(true, key + "_Stage");
        nextStage = DataTableGetFixed(true, key + "_Next");
        if (stage == 0) {
            if (DistanceBetweenPoints(UnitGetPosition(probe), target) <= 3.5) {
                APRG_StartTowerDefenseConstruction(probe, target, now);
            }
            else if (now - started >= 30.0) {
                creepTarget = APRG_TowerDefenseCreepTarget(target, player);
                if (creepTarget != null) {
                    target = creepTarget;
                    DataTableSetFixed(true, key + "_X", PointGetX(target));
                    DataTableSetFixed(true, key + "_Y", PointGetY(target));
                    DataTableSetFixed(true, key + "_Start", now);
                    UnitIssueOrder(probe, OrderTargetingPoint(AbilityCommand("move", 0), target), c_orderQueueReplace);
                }
            }
        }
        else if (stage == 1 && now >= nextStage) {
            if (UnitOrderCount(probe) > 0) {
                DataTableSetFixed(true, key + "_Next", now + 0.75);
                continue;
            }
            buildIndex = DataTableGetInt(true, key + "_BuildIndex");
            failures = DataTableGetInt(true, key + "_Failures");
            clusters = DataTableGetInt(true, key + "_Clusters");

            if (buildIndex >= 13) {
                clusters += 1;
                DataTableSetInt(true, key + "_Clusters", clusters);
                if (clusters >= 3) {
                    UnitGroupRemove(g_aprgTowerDefenseProbes, probe);
                    UnitRemove(probe);
                    continue;
                }
                creepTarget = APRG_TowerDefenseCreepTarget(target, player);
                if (creepTarget != null) {
                    target = creepTarget;
                    DataTableSetFixed(true, key + "_X", PointGetX(target));
                    DataTableSetFixed(true, key + "_Y", PointGetY(target));
                    DataTableSetFixed(true, key + "_Start", now);
                    DataTableSetFixed(true, key + "_SearchStart", -1.0);
                    DataTableSetInt(true, key + "_BuildIndex", 0);
                    DataTableSetInt(true, key + "_Failures", 0);
                    DataTableSetInt(true, key + "_Stage", 0);
                    UnitIssueOrder(probe, OrderTargetingPoint(AbilityCommand("move", 0), target), c_orderQueueReplace);
                }
                continue;
            }

            face = "PhotonCannon";
            minRadius = 2.5;
            maxRadius = 8.0;
            if (buildIndex == 0) {
                face = "Pylon";
                minRadius = 0.0;
                maxRadius = 2.0;
            }
            else if (buildIndex == 6) {
                face = "ShieldBattery";
                minRadius = 2.0;
                maxRadius = 6.0;
            }
            else if (buildIndex == 7) {
                face = "Pylon";
                minRadius = 4.0;
                maxRadius = 8.0;
            }

            if (face == "Pylon" && APRG_TowerDefenseStructureNear(owner, target, "Pylon", 3.0)) {
                issued = true;
            }
            else {
                if (face == "ShieldBattery" && !APRG_TowerDefenseStructureNear(owner, target, "PhotonCannon", 8.0)) {
                    face = "PhotonCannon";
                    minRadius = 2.5;
                    maxRadius = 8.0;
                }
                issued = APRG_IssueTowerDefenseBuild(probe, face, target, minRadius, maxRadius);
            }

            if (issued) {
                buildIndex += 1;
                failures = 0;
                DataTableSetInt(true, key + "_BuildIndex", buildIndex);
                DataTableSetInt(true, key + "_Failures", failures);
                DataTableSetFixed(true, key + "_SearchStart", -1.0);
                DataTableSetFixed(true, key + "_Next", now + 0.75);
            }
            else {
                failures += 1;
                DataTableSetInt(true, key + "_Failures", failures);
                searchStart = DataTableGetFixed(true, key + "_SearchStart");
                if (searchStart < 0.0) {
                    searchStart = now;
                    DataTableSetFixed(true, key + "_SearchStart", searchStart);
                }
                if (now - searchStart >= 30.0) {
                    creepTarget = APRG_TowerDefenseCreepTarget(target, player);
                    if (creepTarget != null) {
                        target = creepTarget;
                        DataTableSetFixed(true, key + "_X", PointGetX(target));
                        DataTableSetFixed(true, key + "_Y", PointGetY(target));
                        DataTableSetFixed(true, key + "_Start", now);
                        DataTableSetFixed(true, key + "_SearchStart", -1.0);
                        DataTableSetInt(true, key + "_Stage", 0);
                        DataTableSetInt(true, key + "_Failures", 0);
                        UnitIssueOrder(probe, OrderTargetingPoint(AbilityCommand("move", 0), target), c_orderQueueReplace);
                    }
                }
                else {
                    DataTableSetFixed(true, key + "_Next", now + 2.0);
                }
            }
        }
    }
}

void APRG_TryTowerDefense(int player, fixed now) {
    point spawnPoint;
    point targetPoint;
    unit home;
    unit enemyHome;
    int owner;
    unitgroup created;
    unit probe;

    if (!APRG_PlayerMacroBaseReady(player) || now < g_aprgNextTowerDefenseTime) { return; }
    g_aprgNextTowerDefenseTime = now + 30.0;
    if (g_aprgTowerDefenseAttempts >= 80) { return; }
    g_aprgTowerDefenseAttempts += 1;
    if (!CatalogEntryIsValid(c_gameCatalogUnit, "Probe")) { return; }
    home = APRG_FindPlayerHomeStructure(player);
    if (home == null) { return; }
    enemyHome = APRG_RandomPathableHostileBaseAnchor(player);
    if (enemyHome == null) { return; }
    spawnPoint = APRG_FindGroundPointNear(UnitGetPosition(enemyHome), 3.0, 8.0);
    if (spawnPoint == null) { spawnPoint = UnitGetPosition(enemyHome); }
    targetPoint = APRG_TowerDefenseFrontPoint(UnitGetPosition(enemyHome), UnitGetPosition(home), g_aprgTowerDefenseAttempts);
    if (targetPoint == null) { return; }
    owner = UnitGetOwner(enemyHome);
    if (owner < 0) { return; }

    created = UnitCreate(1, "Probe", c_unitCreateIgnorePlacement, owner, spawnPoint, libNtve_gf_RandomAngle());
    APRG_RegisterMutationEnemyGroup(created);
    probe = UnitGroupUnitFromEnd(created, 1);
    if (probe == null) { return; }
    AISetUnitScriptControlled(probe, true);
    DataTableSetFixed(true, "APRG_TowerDefenseProbe_" + IntToString(UnitGetTag(probe)) + "_X", PointGetX(targetPoint));
    DataTableSetFixed(true, "APRG_TowerDefenseProbe_" + IntToString(UnitGetTag(probe)) + "_Y", PointGetY(targetPoint));
    DataTableSetFixed(true, "APRG_TowerDefenseProbe_" + IntToString(UnitGetTag(probe)) + "_Start", now);
    DataTableSetFixed(true, "APRG_TowerDefenseProbe_" + IntToString(UnitGetTag(probe)) + "_SearchStart", -1.0);
    DataTableSetInt(true, "APRG_TowerDefenseProbe_" + IntToString(UnitGetTag(probe)) + "_BuildIndex", 0);
    DataTableSetInt(true, "APRG_TowerDefenseProbe_" + IntToString(UnitGetTag(probe)) + "_Clusters", 0);
    DataTableSetInt(true, "APRG_TowerDefenseProbe_" + IntToString(UnitGetTag(probe)) + "_Stage", 0);
    UnitGroupAdd(g_aprgTowerDefenseProbes, probe);
    UnitIssueOrder(probe, OrderTargetingPoint(AbilityCommand("move", 0), targetPoint), c_orderQueueReplace);
}

void APRG_ApplyCloakedNightmare(int player) {
    unitgroup enemies;
    int i;
    unit u;
    if (!APRG_PlayerMacroBaseReady(player)) { return; }
    enemies = APRG_EnemyMobileUnits(player);
    UnitGroupAddUnitGroup(enemies, APRG_EnemyStructures(player));
    i = UnitGroupCount(enemies, c_unitCountAlive);
    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(enemies, i);
        if (u == null) { break; }
        if (!UnitHasBehavior(u, "APRogueCloakedNightmare")) {
            UnitBehaviorAdd(u, "APRogueCloakedNightmare", u, 1);
        }
    }
}

void APRG_ApplyRapidRepair(int player) {
    unitgroup owned;
    int i;
    unit u;
    string unitType;
    string key;
    fixed repairTime;

    owned = APRG_PlayerMobileUnits(player);
    UnitGroupAddUnitGroup(owned, APRG_PlayerStructures(player));
    i = UnitGroupCount(owned, c_unitCountAlive);
    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(owned, i);
        if (u == null) { break; }
        unitType = UnitGetType(u);
        key = "APRG_RapidRepair_" + IntToString(player) + "_" + unitType;
        if (DataTableGetBool(true, key)) { continue; }
        repairTime = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "RepairTime", player));
        if (repairTime > 0.0) {
            CatalogFieldValueModify(c_gameCatalogUnit, unitType, "RepairTime", player, "0.2", c_upgradeOperationMultiply);
        }
        DataTableSetBool(true, key, true);
    }
}

bool APRG_IsConcussedShellUnitType(string unitType) {
    if (unitType == "") { return false; }
    return StringContains(unitType, "Marauder", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Hammer", c_stringAnywhere, c_stringNoCase);
}

void APRG_BuffConcussedDamageEffect(string effectType, int player) {
    string key;
    fixed amount;
    fixed armored;
    if (effectType == "" || !CatalogEntryIsValid(c_gameCatalogEffect, effectType)) { return; }
    key = "APRG_ConcussedDamage_" + IntToString(player) + "_" + effectType;
    if (DataTableGetBool(true, key)) { return; }
    amount = StringToFixed(CatalogFieldValueGet(c_gameCatalogEffect, effectType, "Amount", player));
    if (amount > 0.0) {
        CatalogFieldValueModify(c_gameCatalogEffect, effectType, "Amount", player, "10.0", c_upgradeOperationMultiply);
    }
    armored = StringToFixed(CatalogFieldValueGet(c_gameCatalogEffect, effectType, "AttributeBonus[Armored]", player));
    if (armored > 0.0) {
        CatalogFieldValueModify(c_gameCatalogEffect, effectType, "AttributeBonus[Armored]", player, "10.0", c_upgradeOperationMultiply);
    }
    DataTableSetBool(true, key, true);
}

void APRG_UseConcussedShellMover(string launchEffect, int player) {
    int moverCount;
    int moverIndex;
    string path;
    if (launchEffect == "" || !CatalogEntryIsValid(c_gameCatalogEffect, launchEffect)) { return; }
    if (!CatalogEntryIsValid(c_gameCatalogMover, "APRogueConcussedShellMover")) { return; }
    moverCount = CatalogFieldValueCount(c_gameCatalogEffect, launchEffect, "Movers", player);
    if (moverCount <= 0) { return; }
    if (moverCount > 8) { moverCount = 8; }
    for (moverIndex = 0; moverIndex < moverCount; moverIndex += 1) {
        path = "Movers[" + IntToString(moverIndex) + "].Link";
        CatalogReferenceSet(
            "Effect," + launchEffect + "," + path,
            player,
            "APRogueConcussedShellMover"
        );
    }
}

string APRG_ConcussedChildEffect(string effectType, int player, int childIndex) {
    if (effectType == "" || !CatalogEntryIsValid(c_gameCatalogEffect, effectType)) { return ""; }
    if (childIndex == 0) { return CatalogFieldValueGet(c_gameCatalogEffect, effectType, "Effect", player); }
    if (childIndex == 1) { return CatalogFieldValueGet(c_gameCatalogEffect, effectType, "ImpactEffect", player); }
    if (childIndex == 2) { return CatalogFieldValueGet(c_gameCatalogEffect, effectType, "FinalEffect", player); }
    if (childIndex == 3) { return CatalogFieldValueGet(c_gameCatalogEffect, effectType, "LaunchEffect", player); }
    if (childIndex == 4) { return CatalogFieldValueGet(c_gameCatalogEffect, effectType, "InitialEffect", player); }
    if (childIndex == 5) { return CatalogFieldValueGet(c_gameCatalogEffect, effectType, "PeriodicEffect", player); }
    if (childIndex >= 6 && childIndex < 22) {
        return CatalogFieldValueGet(c_gameCatalogEffect, effectType, "EffectArray[" + IntToString(childIndex - 6) + "]", player);
    }
    return "";
}

void APRG_UseConcussedShellMoverGraph(string rootEffect, int player) {
    string key;
    string child;
    string grandchild;
    int ci;
    int gi;
    if (rootEffect == "" || !CatalogEntryIsValid(c_gameCatalogEffect, rootEffect)) { return; }
    key = "APRG_ConcussedMoverGraph_" + IntToString(player) + "_" + rootEffect;
    if (DataTableGetBool(true, key)) { return; }
    APRG_UseConcussedShellMover(rootEffect, player);
    for (ci = 0; ci < 22; ci += 1) {
        child = APRG_ConcussedChildEffect(rootEffect, player, ci);
        if (child == "" || !CatalogEntryIsValid(c_gameCatalogEffect, child)) { continue; }
        APRG_UseConcussedShellMover(child, player);
        for (gi = 0; gi < 22; gi += 1) {
            grandchild = APRG_ConcussedChildEffect(child, player, gi);
            if (grandchild == "" || !CatalogEntryIsValid(c_gameCatalogEffect, grandchild)) { continue; }
            APRG_UseConcussedShellMover(grandchild, player);
        }
    }
    DataTableSetBool(true, key, true);
}

void APRG_ApplyConcussedShells(int player) {
    unitgroup units;
    unit u;
    int i;
    int wi;
    int wc;
    string unitType;
    string weaponType;
    string displayEffect;
    string launchEffect;

    APRG_BuffConcussedDamageEffect("PunisherGrenadesU", player);
    APRG_BuffConcussedDamageEffect("PunisherGrenadesU2", player);
    APRG_BuffConcussedDamageEffect("PunisherGrenadesU3", player);
    APRG_UseConcussedShellMoverGraph("PunisherGrenadesLM", player);

    units = APRG_PlayerMobileUnits(player);
    for (i = UnitGroupCount(units, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null || !UnitIsAlive(u)) { continue; }
        unitType = UnitGetType(u);
        wc = UnitWeaponCount(u);
        for (wi = 1; wi <= wc; wi += 1) {
            weaponType = UnitWeaponGet(u, wi);
            if (weaponType == "") { continue; }
            if (!APRG_IsConcussedShellUnitType(unitType) && !StringContains(weaponType, "Punisher", c_stringAnywhere, c_stringNoCase)) { continue; }
            displayEffect = CatalogFieldValueGet(c_gameCatalogWeapon, weaponType, "DisplayEffect", player);
            APRG_BuffConcussedDamageEffect(displayEffect, player);
            launchEffect = CatalogFieldValueGet(c_gameCatalogWeapon, weaponType, "Effect", player);
            if (launchEffect == "" || !CatalogEntryIsValid(c_gameCatalogEffect, launchEffect)) { continue; }
            APRG_UseConcussedShellMoverGraph(launchEffect, player);
        }
    }
    g_aprgConcussedShellsApplied = true;
}

bool APRG_IsThorFamilyType(string unitType) {
    if (unitType == "") { return false; }
    return StringContains(unitType, "Thor", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Jotun", c_stringAnywhere, c_stringNoCase);
}

bool APRG_IsUltraliskFamilyType(string unitType) {
    if (unitType == "") { return false; }
    return StringContains(unitType, "Ultralisk", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Torrasque", c_stringAnywhere, c_stringNoCase);
}

bool APRG_IsGoliathFamilyType(string unitType) {
    if (unitType == "") { return false; }
    return StringContains(unitType, "Goliath", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Spartan", c_stringAnywhere, c_stringNoCase);
}

bool APRG_IsMercenaryUnitType(string unitType) {
    if (unitType == "") { return false; }
    if (
        StringContains(unitType, "Compound", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "PredatorNest", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "MercenaryStructure", c_stringAnywhere, c_stringNoCase)
    ) { return false; }
    return StringContains(unitType, "Merc", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "WarPig", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "DevilDog", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Hammer", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Spartan", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "SiegeBreaker", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "HelsAngel", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "DuskWing", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Jackson", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "DukesRevenge", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Skibi", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "DeathHead", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "WingedNightmare", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "MidnightRider", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Brynhild", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Jotun", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "InfestedMedic", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "InfestedSiegeBreaker", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "InfestedDuskWing", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "DevouringOne", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "HunterKiller", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Torrasque", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Hunterling", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Yggdrasil", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "CausticHorror", c_stringAnywhere, c_stringNoCase);
}

bool APRG_MercenaryCommandProducesUnit(string abilityType, int commandIndex, int player) {
    string basePath;
    string candidateUnitType;
    int producedCount;
    int producedIndex;
    bool namedMercAbility;
    bool sawNonStructure = false;
    if (
        abilityType == "" || commandIndex < 0 ||
        !CatalogEntryIsValid(c_gameCatalogAbil, abilityType)
    ) { return false; }

    basePath = "InfoArray[" + IntToString(commandIndex) + "]";
    namedMercAbility =
        StringContains(abilityType, "Hire", c_stringAnywhere, c_stringNoCase) ||
        StringContains(abilityType, "Recruit", c_stringAnywhere, c_stringNoCase) ||
        StringContains(abilityType, "Merc", c_stringAnywhere, c_stringNoCase) ||
        StringContains(abilityType, "Mercenary", c_stringAnywhere, c_stringNoCase);

    candidateUnitType = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, basePath + ".Unit", player);
    if (candidateUnitType != "" && CatalogEntryIsValid(c_gameCatalogUnit, candidateUnitType)) {
        if (APRG_IsMercenaryUnitType(candidateUnitType)) { return true; }
        if (!UnitTypeTestAttribute(candidateUnitType, c_unitAttributeStructure)) { sawNonStructure = true; }
    }

    producedCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, basePath + ".Unit", player);
    for (producedIndex = 0; producedIndex < producedCount; producedIndex += 1) {
        candidateUnitType = CatalogFieldValueGet(
            c_gameCatalogAbil, abilityType,
            basePath + ".Unit[" + IntToString(producedIndex) + "]", player
        );
        if (candidateUnitType == "" || !CatalogEntryIsValid(c_gameCatalogUnit, candidateUnitType)) { continue; }
        if (APRG_IsMercenaryUnitType(candidateUnitType)) { return true; }
        if (!UnitTypeTestAttribute(candidateUnitType, c_unitAttributeStructure)) { sawNonStructure = true; }
    }

    return namedMercAbility && sawNonStructure;
}

bool APRG_IsMercenaryRecruitAbility(string abilityType, int player) {
    int infoCount;
    int infoIndex;
    if (abilityType == "" || !CatalogEntryIsValid(c_gameCatalogAbil, abilityType)) { return false; }
    infoCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, "InfoArray", player);
    if (infoCount > 64) { infoCount = 64; }
    for (infoIndex = 0; infoIndex < infoCount; infoIndex += 1) {
        if (APRG_MercenaryCommandProducesUnit(abilityType, infoIndex, player)) { return true; }
    }
    return false;
}

int APRG_MercenaryUpgradeStacks(int slot) {
    int divisor = 1;
    int i = 0;
    int packed = g_aprgMercenaryUpgradePacked;
    if (slot < 0 || slot > 7) { return 0; }
    if (slot >= 6) {
        slot -= 6;
        packed = g_aprgMercenaryUpgradePacked2;
    }
    for (; i < slot; i += 1) { divisor *= 32; }
    return (packed / divisor) % 32;
}

// AP upgrades (especially Rapid Reinforcement and Progressive Fast Delivery)
// can rewrite these catalog values after Slay's one-time Repeat Contractor
// adjustment. Check them again on the periodic mercenary-building watchdog.
// Legitimate zero TimeStart values must survive: Fast Delivery may deliberately
// make initial mercenary calldowns available immediately.
void APRG_ClampMercenaryCooldownField(int player, string abilityType, string field) {
    string rawValue;
    fixed value;
    bool initialTimer;
    if (abilityType == "" || field == "") { return; }
    rawValue = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, field, player);
    if (rawValue == "") { return; }
    value = StringToFixed(rawValue);
    initialTimer = StringContains(field, "TimeStart", c_stringAnywhere, c_stringNoCase);
    if (value > 1000.0) {
        // An overflowing, previously underflowed timer should not lock a
        // calldown out for tens of thousands of seconds.
        CatalogFieldValueSet(c_gameCatalogAbil, abilityType, field, player, "10");
    }
    else if (value < 0.0) {
        // Do not propagate an AP or Slay negative value into SC2's cooldown
        // engine. Preserve a ready-on-start (zero) timer when appropriate.
        CatalogFieldValueSet(c_gameCatalogAbil, abilityType, field, player,
                             initialTimer ? "0" : "1");
    }
    else if (value > 0.0 && value < 1.0) {
        CatalogFieldValueSet(c_gameCatalogAbil, abilityType, field, player, "1");
    }
}

void APRG_ReduceMercenaryCooldownField(int player, string abilityType, string field, fixed reduction) {
    fixed value;
    string rawValue;
    if (abilityType == "" || field == "") { return; }
    rawValue = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, field, player);
    if (rawValue == "") { return; }
    value = StringToFixed(rawValue);
    if (value > 1000.0 || value < 0.0) {
        // Overflow recovery is a repair, not another cooldown reduction:
        // leave a >1000-second timer at exactly 10, not (10 - stacks).
        APRG_ClampMercenaryCooldownField(player, abilityType, field);
        return;
    }
    APRG_ClampMercenaryCooldownField(player, abilityType, field);
    value = StringToFixed(CatalogFieldValueGet(c_gameCatalogAbil, abilityType, field, player));
    if (reduction > 0.0 && value > 0.0) {
        CatalogFieldValueSet(
            c_gameCatalogAbil, abilityType, field, player,
            FixedToString(MaxF(1.0, value - reduction), c_fixedPrecisionAny)
        );
    }
    // Catch anything introduced by our own reduction as well as AP's earlier
    // modification. This path is also used with reduction=0 by the watchdog.
    APRG_ClampMercenaryCooldownField(player, abilityType, field);
}

// Initial mercenary cooldowns have often been started by AP's own Galaxy
// code before APRG_ActivateEffects runs. Catalog edits alone do NOT shorten
// those already-running player-scoped countdowns. Shorten each real cooldown
// link once, never subtract beyond zero, and leave Fast Delivery's ready (0)
// links untouched. In particular, no negative PlayerAddCooldown is used.
void APRG_ReduceActiveMercenaryCooldownOnce(int player, string abilityType, string field, fixed reduction) {
    string link;
    string key;
    fixed remaining;
    fixed target;
    if (reduction <= 0.0 || abilityType == "" || field == "") { return; }
    link = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, field, player);
    if (link == "") { return; }
    key = "APRG_MercInitialReduced_" + IntToString(player) + "_" + link;
    if (DataTableGetBool(true, key)) { return; }
    DataTableSetBool(true, key, true);
    remaining = PlayerGetCooldown(player, link);
    if (remaining <= 0.0) { return; }
    if (remaining > 1000.0) { target = 10.0; }
    else { target = MaxF(0.0, remaining - reduction); }
    // Same reset API as Archipelago's own mercenary cooldown initializer.
    // Do not use PlayerAddCooldown with a huge negative delta: the engine may
    // already have wrapped that timer, which would create a second overflow.
    libNtve_gf_PlayerRemoveCooldown(player, link);
    if (target > 0.0) { PlayerAddCooldown(player, link, target); }
}

void APRG_ApplyRepeatContractorCooldowns(int player, int repeatStacks) {
    int count;
    int i;
    int infoCount;
    int infoIndex;
    int producedCount;
    int producedIndex;
    int costCount;
    int costIndex;
    string abilityType;
    string basePath;
    string costPath;
    string trainedUnitType;
    string candidateUnitType;
    fixed reduction;
    bool mercAbility;
    bool infoProducesMerc;
    // The 60s AP Rapid Reinforcement adjustment is Slay-controlled. The
    // unchecked native AP_RapidReinforcement upgrade is excluded from the AP
    // calculated item list for Slay only, so even a 30s starting cooldown
    // cannot underflow inside the engine before the watchdog can run.
    // Existing Repeat Contractor stacks combine additively and get ONE floor.
    reduction = 30.0 * IntToFixed(MaxI(0, repeatStacks));
    if ((g_aprgMercenaryUpgradePacked2 & 1024) != 0) { reduction += 60.0; }

    count = CatalogEntryCount(c_gameCatalogAbil);
    for (i = 1; i <= count; i += 1) {
        abilityType = CatalogEntryGet(c_gameCatalogAbil, i);
        if (abilityType == "" || !CatalogEntryIsValid(c_gameCatalogAbil, abilityType)) { continue; }
        mercAbility = APRG_IsMercenaryRecruitAbility(abilityType, player) ||
            abilityType == "AP_SummonMercenaries" || abilityType == "AP_SummonZergMercs";
        if (!mercAbility) { continue; }
        infoCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, "InfoArray", player);
        for (infoIndex = 0; infoIndex < infoCount; infoIndex += 1) {
            basePath = "InfoArray[" + IntToString(infoIndex) + "]";
            infoProducesMerc = APRG_MercenaryCommandProducesUnit(abilityType, infoIndex, player);
            if (!infoProducesMerc && abilityType != "AP_SummonMercenaries" &&
                abilityType != "AP_SummonZergMercs") { continue; }
            // AP's normal initial PlayerAddCooldown already happened; align
            // currently active links with the reduced catalog once per link.
            APRG_ReduceActiveMercenaryCooldownOnce(player, abilityType,
                basePath + ".Cooldown.Link", reduction);
            APRG_ReduceActiveMercenaryCooldownOnce(player, abilityType,
                basePath + ".Cost.Cooldown.Link", reduction);
            APRG_ReduceMercenaryCooldownField(player, abilityType, basePath + ".Cooldown.TimeUse", reduction);
            APRG_ReduceMercenaryCooldownField(player, abilityType, basePath + ".Cooldown.TimeStart", reduction);
            APRG_ReduceMercenaryCooldownField(player, abilityType, basePath + ".Cost.Cooldown.TimeUse", reduction);
            APRG_ReduceMercenaryCooldownField(player, abilityType, basePath + ".Cost.Cooldown.TimeStart", reduction);
            APRG_ReduceMercenaryCooldownField(player, abilityType, basePath + ".Charge.TimeUse", reduction);
            APRG_ReduceMercenaryCooldownField(player, abilityType, basePath + ".Charge.TimeStart", reduction);
            APRG_ReduceMercenaryCooldownField(player, abilityType, basePath + ".Cost.Charge.TimeUse", reduction);
            APRG_ReduceMercenaryCooldownField(player, abilityType, basePath + ".Cost.Charge.TimeStart", reduction);
        }
        if (!mercAbility) { continue; }
        APRG_ReduceMercenaryCooldownField(player, abilityType, "Cooldown.TimeUse", reduction);
        APRG_ReduceMercenaryCooldownField(player, abilityType, "Cooldown.TimeStart", reduction);
        APRG_ReduceMercenaryCooldownField(player, abilityType, "Cost.Cooldown.TimeUse", reduction);
        APRG_ReduceMercenaryCooldownField(player, abilityType, "Cost.Cooldown.TimeStart", reduction);
        APRG_ReduceMercenaryCooldownField(player, abilityType, "Charge.TimeUse", reduction);
        APRG_ReduceMercenaryCooldownField(player, abilityType, "Charge.TimeStart", reduction);
        APRG_ReduceMercenaryCooldownField(player, abilityType, "Cost.Charge.TimeUse", reduction);
        APRG_ReduceMercenaryCooldownField(player, abilityType, "Cost.Charge.TimeStart", reduction);
        costCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, "Cost", player);
        for (costIndex = 0; costIndex < costCount; costIndex += 1) {
            costPath = "Cost[" + IntToString(costIndex) + "]";
            APRG_ReduceMercenaryCooldownField(player, abilityType, costPath + ".Cooldown.TimeUse", reduction);
            APRG_ReduceMercenaryCooldownField(player, abilityType, costPath + ".Cooldown.TimeStart", reduction);
            APRG_ReduceMercenaryCooldownField(player, abilityType, costPath + ".Charge.TimeUse", reduction);
            APRG_ReduceMercenaryCooldownField(player, abilityType, costPath + ".Charge.TimeStart", reduction);
        }
    }
}

void APRG_ClearSuspiciousMercenaryTimerLink(unit structure, int player, string abilityType, string field) {
    string link;
    fixed remaining;
    if (structure == null || !UnitIsAlive(structure) || abilityType == "" || field == "") { return; }
    link = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, field, player);
    if (link == "") { return; }

    // Check all three cooldown scopes: AP's custom initial calldowns can use
    // a player/shared link even when the unit-ability lookup looks ready.
    remaining = UnitAbilityGetCooldown(structure, abilityType, link);
    if (remaining > 1000.0) {
        UnitModifyCooldown(structure, link, 10.0, c_cooldownOperationSet);
    }
    remaining = UnitGetCooldown(structure, link);
    if (remaining > 1000.0) {
        UnitModifyCooldown(structure, link, 10.0, c_cooldownOperationSet);
    }
    remaining = PlayerGetCooldown(player, link);
    if (remaining > 1000.0) {
        libNtve_gf_PlayerRemoveCooldown(player, link);
        PlayerAddCooldown(player, link, 10.0);
    }

    remaining = UnitAbilityGetChargeRegen(structure, abilityType, link);
    if (remaining > 1000.0) {
        UnitAbilityAddChargeRegen(structure, abilityType, link, 10.0 - remaining);
    }
    remaining = UnitGetChargeRegen(structure, link);
    if (remaining > 1000.0) {
        UnitAddChargeRegen(structure, link, 10.0 - remaining);
    }
    remaining = PlayerGetChargeRegen(player, link);
    if (remaining > 1000.0) {
        libNtve_gf_PlayerRemoveChargeRegen(player, link);
        PlayerAddChargeRegen(player, link, 10.0);
    }
}

void APRG_SanitizeContractStructureTimers(unit structure, int player) {
    int abilityCount;
    int abilityIndex;
    int infoCount;
    int infoIndex;
    int costCount;
    int costIndex;
    string abilityType;
    string basePath;
    string costPath;
    if (structure == null || !UnitIsAlive(structure)) { return; }

    abilityCount = MinI(128, UnitAbilityCount(structure));
    for (abilityIndex = 1; abilityIndex <= abilityCount; abilityIndex += 1) {
        abilityType = UnitAbilityGet(structure, abilityIndex);
        if (abilityType == "" || !CatalogEntryIsValid(c_gameCatalogAbil, abilityType)) { continue; }
        // This is already scoped to a Merc Compound/Predator Nest. Do not
        // discard AP calldown abilities merely because their InfoArray unit
        // types have unusual names or their command list isn't a Train ability.
        // We only clamp nonsensical timers, never legitimate long cooldowns.

        APRG_ReduceMercenaryCooldownField(player, abilityType, "Cooldown.TimeUse", 0.0);
        APRG_ReduceMercenaryCooldownField(player, abilityType, "Cooldown.TimeStart", 0.0);
        APRG_ReduceMercenaryCooldownField(player, abilityType, "Charge.TimeUse", 0.0);
        APRG_ReduceMercenaryCooldownField(player, abilityType, "Charge.TimeStart", 0.0);
        APRG_ReduceMercenaryCooldownField(player, abilityType, "Cost.Cooldown.TimeUse", 0.0);
        APRG_ReduceMercenaryCooldownField(player, abilityType, "Cost.Cooldown.TimeStart", 0.0);
        APRG_ReduceMercenaryCooldownField(player, abilityType, "Cost.Charge.TimeUse", 0.0);
        APRG_ReduceMercenaryCooldownField(player, abilityType, "Cost.Charge.TimeStart", 0.0);
        APRG_ClearSuspiciousMercenaryTimerLink(structure, player, abilityType, "Cooldown.Link");
        APRG_ClearSuspiciousMercenaryTimerLink(structure, player, abilityType, "Charge.Link");
        APRG_ClearSuspiciousMercenaryTimerLink(structure, player, abilityType, "Cost.Cooldown.Link");
        APRG_ClearSuspiciousMercenaryTimerLink(structure, player, abilityType, "Cost.Charge.Link");

        costCount = MinI(8, CatalogFieldValueCount(c_gameCatalogAbil, abilityType, "Cost", player));
        for (costIndex = 0; costIndex < costCount; costIndex += 1) {
            costPath = "Cost[" + IntToString(costIndex) + "]";
            APRG_ReduceMercenaryCooldownField(player, abilityType, costPath + ".Cooldown.TimeUse", 0.0);
            APRG_ReduceMercenaryCooldownField(player, abilityType, costPath + ".Cooldown.TimeStart", 0.0);
            APRG_ReduceMercenaryCooldownField(player, abilityType, costPath + ".Charge.TimeUse", 0.0);
            APRG_ReduceMercenaryCooldownField(player, abilityType, costPath + ".Charge.TimeStart", 0.0);
            APRG_ClearSuspiciousMercenaryTimerLink(structure, player, abilityType, costPath + ".Cooldown.Link");
            APRG_ClearSuspiciousMercenaryTimerLink(structure, player, abilityType, costPath + ".Charge.Link");
        }

        infoCount = MinI(64, CatalogFieldValueCount(c_gameCatalogAbil, abilityType, "InfoArray", player));
        for (infoIndex = 0; infoIndex < infoCount; infoIndex += 1) {
            basePath = "InfoArray[" + IntToString(infoIndex) + "]";
            APRG_ReduceMercenaryCooldownField(player, abilityType, basePath + ".Cooldown.TimeUse", 0.0);
            APRG_ReduceMercenaryCooldownField(player, abilityType, basePath + ".Cooldown.TimeStart", 0.0);
            APRG_ReduceMercenaryCooldownField(player, abilityType, basePath + ".Charge.TimeUse", 0.0);
            APRG_ReduceMercenaryCooldownField(player, abilityType, basePath + ".Charge.TimeStart", 0.0);
            APRG_ReduceMercenaryCooldownField(player, abilityType, basePath + ".Cost.Cooldown.TimeUse", 0.0);
            APRG_ReduceMercenaryCooldownField(player, abilityType, basePath + ".Cost.Cooldown.TimeStart", 0.0);
            APRG_ReduceMercenaryCooldownField(player, abilityType, basePath + ".Cost.Charge.TimeUse", 0.0);
            APRG_ReduceMercenaryCooldownField(player, abilityType, basePath + ".Cost.Charge.TimeStart", 0.0);
            APRG_ClearSuspiciousMercenaryTimerLink(structure, player, abilityType, basePath + ".Cooldown.Link");
            APRG_ClearSuspiciousMercenaryTimerLink(structure, player, abilityType, basePath + ".Charge.Link");
            APRG_ClearSuspiciousMercenaryTimerLink(structure, player, abilityType, basePath + ".Cost.Cooldown.Link");
            APRG_ClearSuspiciousMercenaryTimerLink(structure, player, abilityType, basePath + ".Cost.Charge.Link");
            costCount = MinI(8, CatalogFieldValueCount(c_gameCatalogAbil, abilityType, basePath + ".Cost", player));
            for (costIndex = 0; costIndex < costCount; costIndex += 1) {
                costPath = basePath + ".Cost[" + IntToString(costIndex) + "]";
                APRG_ReduceMercenaryCooldownField(player, abilityType, costPath + ".Cooldown.TimeUse", 0.0);
                APRG_ReduceMercenaryCooldownField(player, abilityType, costPath + ".Cooldown.TimeStart", 0.0);
                APRG_ReduceMercenaryCooldownField(player, abilityType, costPath + ".Charge.TimeUse", 0.0);
                APRG_ReduceMercenaryCooldownField(player, abilityType, costPath + ".Charge.TimeStart", 0.0);
                APRG_ClearSuspiciousMercenaryTimerLink(structure, player, abilityType, costPath + ".Cooldown.Link");
                APRG_ClearSuspiciousMercenaryTimerLink(structure, player, abilityType, costPath + ".Charge.Link");
            }
        }
    }
}

void APRG_ScaleMercenaryUnitCost(int player, string unitType, fixed factor) {
    int resourceIndex;
    fixed value;
    string field;
    string key;
    if (unitType == "" || factor >= 1.0 || !CatalogEntryIsValid(c_gameCatalogUnit, unitType)) { return; }
    key = "APRG_AffordableMercUnit_" + IntToString(player) + "_" + unitType;
    if (DataTableGetBool(true, key)) { return; }
    for (resourceIndex = 0; resourceIndex < 2; resourceIndex += 1) {
        field = "CostResource[" + IntToString(resourceIndex) + "]";
        value = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, field, player));
        if (value > 0.0) {
            CatalogFieldValueSet(
                c_gameCatalogUnit, unitType, field, player,
                IntToString(MaxI(1, FixedToInt(RoundI(value * factor))))
            );
        }
    }
    DataTableSetBool(true, key, true);
}

void APRG_ScaleMercenaryAbilityResourceField(int player, string abilityType, string field, fixed factor) {
    fixed value;
    if (abilityType == "" || field == "" || factor >= 1.0) { return; }
    value = StringToFixed(CatalogFieldValueGet(c_gameCatalogAbil, abilityType, field, player));
    if (value <= 0.0) { return; }
    CatalogFieldValueSet(
        c_gameCatalogAbil, abilityType, field, player,
        IntToString(MaxI(1, FixedToInt(RoundI(value * factor))))
    );
}

void APRG_ApplyMercenaryRecruitCatalog(int player) {
    int affordableStacks = APRG_MercenaryUpgradeStacks(4);
    int repeatStacks = APRG_MercenaryUpgradeStacks(5);
    int count;
    int i;
    int infoCount;
    int infoIndex;
    int producedCount;
    int producedIndex;
    int costCount;
    int costIndex;
    string unitType;
    string abilityType;
    string candidateUnitType;
    string basePath;
    string costPath;
    fixed factor = 1.0;
    fixed value;
    if (g_aprgMercenaryCatalogApplied) { return; }

    for (i = 0; i < affordableStacks; i += 1) { factor *= 0.5; }

    if (affordableStacks > 0) {
        count = CatalogEntryCount(c_gameCatalogUnit);
        if (count > 4096) { count = 4096; }
        for (i = 1; i <= count; i += 1) {
            unitType = CatalogEntryGet(c_gameCatalogUnit, i);
            if (!APRG_IsMercenaryUnitType(unitType)) { continue; }
            APRG_ScaleMercenaryUnitCost(player, unitType, factor);
        }

        count = CatalogEntryCount(c_gameCatalogAbil);
        if (count > 4096) { count = 4096; }
        for (i = 1; i <= count; i += 1) {
            abilityType = CatalogEntryGet(c_gameCatalogAbil, i);
            if (!APRG_IsMercenaryRecruitAbility(abilityType, player)) { continue; }
            infoCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, "InfoArray", player);
            if (infoCount > 64) { infoCount = 64; }
            for (infoIndex = 0; infoIndex < infoCount; infoIndex += 1) {
                basePath = "InfoArray[" + IntToString(infoIndex) + "]";
                if (!APRG_MercenaryCommandProducesUnit(abilityType, infoIndex, player)) { continue; }
                APRG_ScaleMercenaryAbilityResourceField(player, abilityType, basePath + ".Resource[0]", factor);
                APRG_ScaleMercenaryAbilityResourceField(player, abilityType, basePath + ".Resource[1]", factor);
                APRG_ScaleMercenaryAbilityResourceField(player, abilityType, basePath + ".Cost.Resource[0]", factor);
                APRG_ScaleMercenaryAbilityResourceField(player, abilityType, basePath + ".Cost.Resource[1]", factor);

                candidateUnitType = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, basePath + ".Unit", player);
                if (candidateUnitType != "") { APRG_ScaleMercenaryUnitCost(player, candidateUnitType, factor); }
                producedCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, basePath + ".Unit", player);
                if (producedCount > 16) { producedCount = 16; }
                for (producedIndex = 0; producedIndex < producedCount; producedIndex += 1) {
                    candidateUnitType = CatalogFieldValueGet(
                        c_gameCatalogAbil, abilityType,
                        basePath + ".Unit[" + IntToString(producedIndex) + "]", player
                    );
                    if (candidateUnitType != "") { APRG_ScaleMercenaryUnitCost(player, candidateUnitType, factor); }
                }

                costCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, basePath + ".Cost", player);
                if (costCount > 8) { costCount = 8; }
                for (costIndex = 0; costIndex < costCount; costIndex += 1) {
                    costPath = basePath + ".Cost[" + IntToString(costIndex) + "]";
                    APRG_ScaleMercenaryAbilityResourceField(player, abilityType, costPath + ".Resource[0]", factor);
                    APRG_ScaleMercenaryAbilityResourceField(player, abilityType, costPath + ".Resource[1]", factor);
                }
            }
            APRG_ScaleMercenaryAbilityResourceField(player, abilityType, "Resource[0]", factor);
            APRG_ScaleMercenaryAbilityResourceField(player, abilityType, "Resource[1]", factor);
            APRG_ScaleMercenaryAbilityResourceField(player, abilityType, "Cost.Resource[0]", factor);
            APRG_ScaleMercenaryAbilityResourceField(player, abilityType, "Cost.Resource[1]", factor);
            costCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, "Cost", player);
            if (costCount > 8) { costCount = 8; }
            for (costIndex = 0; costIndex < costCount; costIndex += 1) {
                costPath = "Cost[" + IntToString(costIndex) + "]";
                APRG_ScaleMercenaryAbilityResourceField(player, abilityType, costPath + ".Resource[0]", factor);
                APRG_ScaleMercenaryAbilityResourceField(player, abilityType, costPath + ".Resource[1]", factor);
            }
        }
    }

    APRG_ApplyRepeatContractorCooldowns(player, repeatStacks);
    g_aprgMercenaryCatalogApplied = true;
}

void APRG_ApplyMercenaryUnitUpgrades(unit u, int player) {
    int eliteStacks = APRG_MercenaryUpgradeStacks(0);
    int armoredStacks = APRG_MercenaryUpgradeStacks(1);
    int regenStacks = APRG_MercenaryUpgradeStacks(2);
    int sniperStacks = APRG_MercenaryUpgradeStacks(3);
    int spotterStacks = APRG_MercenaryUpgradeStacks(6);
    string unitType;
    string weaponType;
    string key;
    int wi;
    int wc;
    fixed maximum;
    fixed life;
    fixed ratio;
    fixed value;
    if (u == null || !UnitIsAlive(u)) { return; }
    unitType = UnitGetType(u);
    if (!APRG_IsMercenaryUnitType(unitType)) { return; }

    if (spotterStacks > 0) {
        key = "APRG_MercSight_" + IntToString(player) + "_" + unitType;
        if (!DataTableGetBool(true, key)) {
            value = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "Sight", player));
            if (value > 0.0) {
                CatalogFieldValueSet(
                    c_gameCatalogUnit, unitType, "Sight", player,
                    FixedToString(value + 5.0 * IntToFixed(spotterStacks), c_fixedPrecisionAny)
                );
            }
            DataTableSetBool(true, key, true);
        }
    }

    if (armoredStacks > 0) {
        key = "APRG_MercArmor_" + IntToString(player) + "_" + unitType;
        if (!DataTableGetBool(true, key)) {
            CatalogFieldValueModify(c_gameCatalogUnit, unitType, "LifeArmor", player, FixedToString(1.0 * IntToFixed(armoredStacks), c_fixedPrecisionAny), c_upgradeOperationAdd);
            DataTableSetBool(true, key, true);
        }
    }
    if (sniperStacks > 0) {
        if (unitType == "DukesRevenge" || unitType == "AP_DukesRevenge") {
            // Jackson's Revenge can use weapons that the shared catalog upgrade
            // does not reliably affect. Give THIS UNIT the same +50% per stack
            // using our existing 0.05-range behavior. Never apply both paths.
            key = "APRG_JacksonSniper_" + IntToString(UnitGetTag(u));
            if (!DataTableGetBool(true, key + "_Initialized")) {
                maximum = 0.0;
                wc = UnitWeaponCount(u);
                for (wi = 1; wi <= wc; wi += 1) {
                    value = UnitWeaponRange(u, wi);
                    if (value > maximum) { maximum = value; }
                }
                // Campaign unit may not expose its weapon array until initialized.
                if (maximum <= 0.0) { maximum = 6.0; }
                DataTableSetFixed(true, key + "_OriginalRange", maximum);
                DataTableSetBool(true, key + "_Initialized", true);
            }
            value = DataTableGetFixed(true, key + "_OriginalRange");
            wc = MaxI(1, FixedToInt(RoundI(value * 10.0 * IntToFixed(sniperStacks))));
            wi = DataTableGetInt(true, key + "_AppliedStacks");
            if (wc > wi && CatalogEntryIsValid(c_gameCatalogBehavior, "APRogueSupportCrewRange005")) {
                UnitBehaviorAdd(u, "APRogueSupportCrewRange005", u, wc - wi);
                DataTableSetInt(true, key + "_AppliedStacks", wc);
            }
        }
        else {
            wc = UnitWeaponCount(u);
            for (wi = 1; wi <= wc; wi += 1) {
                weaponType = UnitWeaponGet(u, wi);
                if (weaponType == "") { continue; }
                key = "APRG_MercRange_" + IntToString(player) + "_" + weaponType;
                if (DataTableGetBool(true, key)) { continue; }
                value = StringToFixed(CatalogFieldValueGet(c_gameCatalogWeapon, weaponType, "Range", player));
                if (value > 0.0) {
                    CatalogFieldValueModify(c_gameCatalogWeapon, weaponType, "Range", player, FixedToString(value * 0.5 * IntToFixed(sniperStacks), c_fixedPrecisionAny), c_upgradeOperationAdd);
                }
                DataTableSetBool(true, key, true);
            }
        }
    }
    if (eliteStacks > 0 && !UnitGroupHasUnit(g_aprgMercenaryHpProcessed, u)) {
        maximum = UnitGetPropertyFixed(u, c_unitPropLifeMax, c_unitPropCurrent);
        life = UnitGetPropertyFixed(u, c_unitPropLife, c_unitPropCurrent);
        if (maximum > 0.0) {
            ratio = life / maximum;
            maximum = maximum * (1.0 + 0.25 * IntToFixed(eliteStacks));
            UnitSetPropertyFixed(u, c_unitPropLifeMax, maximum);
            UnitSetPropertyFixed(u, c_unitPropLife, maximum * ratio);
        }
        UnitGroupAdd(g_aprgMercenaryHpProcessed, u);
    }
    if (regenStacks > 0) {
        maximum = UnitGetPropertyFixed(u, c_unitPropLifeMax, c_unitPropCurrent);
        life = UnitGetPropertyFixed(u, c_unitPropLife, c_unitPropCurrent);
        if (maximum > 0.0 && life < maximum) {
            UnitSetPropertyFixed(u, c_unitPropLife, MinF(maximum, life + 1.0 * IntToFixed(regenStacks)));
        }
    }
}

bool APRG_UnitNearMercenary(unit target, unitgroup playerUnits) {
    int i;
    unit candidate;
    if (target == null || playerUnits == null) { return false; }
    for (i = UnitGroupCount(playerUnits, c_unitCountAlive); i > 0; i -= 1) {
        candidate = UnitGroupUnitFromEnd(playerUnits, i);
        if (candidate == null || candidate == target || !UnitIsAlive(candidate)) { continue; }
        if (!APRG_IsMercenaryUnitType(UnitGetType(candidate))) { continue; }
        if (DistanceBetweenPoints(UnitGetPosition(target), UnitGetPosition(candidate)) <= 8.0) { return true; }
    }
    return false;
}

void APRG_SetSupportCrewAura(unit u, int player, int supportStacks, bool shouldHave) {
    string key;
    string unitType;
    bool hasAura;
    fixed factor;
    fixed maximum;
    fixed current;
    fixed ratio;
    fixed maxRange = 0.0;
    fixed weaponRange;
    fixed lifeArmor;
    fixed shieldArmor;
    int wi;
    int wc;
    int behaviorStacks;
    if (u == null || !UnitIsAlive(u) || supportStacks <= 0) { return; }
    if (APRG_IsMercenaryUnitType(UnitGetType(u))) { return; }
    key = "APRG_SupportCrewActive_" + IntToString(UnitGetTag(u));
    hasAura = DataTableGetBool(true, key);
    if (hasAura == shouldHave) { return; }
    factor = 1.0 + 0.15 * IntToFixed(supportStacks);
    unitType = UnitGetType(u);

    maximum = UnitGetPropertyFixed(u, c_unitPropLifeMax, c_unitPropCurrent);
    current = UnitGetPropertyFixed(u, c_unitPropLife, c_unitPropCurrent);
    if (maximum > 0.0) {
        ratio = current / maximum;
        if (shouldHave) { maximum *= factor; }
        else { maximum /= factor; }
        UnitSetPropertyFixed(u, c_unitPropLifeMax, maximum);
        UnitSetPropertyFixed(u, c_unitPropLife, MinF(maximum, maximum * ratio));
    }

    if (shouldHave) {
        if (CatalogEntryIsValid(c_gameCatalogBehavior, "APRogueSupportCrewDamage")) {
            UnitBehaviorAdd(u, "APRogueSupportCrewDamage", u, supportStacks);
        }
        wc = UnitWeaponCount(u);
        for (wi = 1; wi <= wc; wi += 1) {
            weaponRange = UnitWeaponRange(u, wi);
            if (weaponRange > maxRange) { maxRange = weaponRange; }
        }
        if (maxRange > 0.0 && CatalogEntryIsValid(c_gameCatalogBehavior, "APRogueSupportCrewRange005")) {
            behaviorStacks = MaxI(1, FixedToInt(RoundI(maxRange * 3.0 * IntToFixed(supportStacks))));
            UnitBehaviorAdd(u, "APRogueSupportCrewRange005", u, behaviorStacks);
        }
        lifeArmor = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "LifeArmor", player));
        if (lifeArmor > 0.0 && CatalogEntryIsValid(c_gameCatalogBehavior, "APRogueSupportCrewLifeArmor005")) {
            behaviorStacks = MaxI(1, FixedToInt(RoundI(lifeArmor * 3.0 * IntToFixed(supportStacks))));
            UnitBehaviorAdd(u, "APRogueSupportCrewLifeArmor005", u, behaviorStacks);
        }
        shieldArmor = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "ShieldArmor", player));
        if (shieldArmor > 0.0 && CatalogEntryIsValid(c_gameCatalogBehavior, "APRogueSupportCrewShieldArmor005")) {
            behaviorStacks = MaxI(1, FixedToInt(RoundI(shieldArmor * 3.0 * IntToFixed(supportStacks))));
            UnitBehaviorAdd(u, "APRogueSupportCrewShieldArmor005", u, behaviorStacks);
        }
        DataTableSetBool(true, key, true);
    }
    else {
        UnitBehaviorRemove(u, "APRogueSupportCrewDamage", c_unitBehaviorCountAll);
        UnitBehaviorRemove(u, "APRogueSupportCrewRange005", c_unitBehaviorCountAll);
        UnitBehaviorRemove(u, "APRogueSupportCrewLifeArmor005", c_unitBehaviorCountAll);
        UnitBehaviorRemove(u, "APRogueSupportCrewShieldArmor005", c_unitBehaviorCountAll);
        DataTableSetBool(true, key, false);
    }
}

void APRG_TickSupportCrew(int player, unitgroup playerUnits) {
    int supportStacks = APRG_MercenaryUpgradeStacks(7);
    int i;
    unit u;
    bool nearMerc;
    if (supportStacks <= 0 || playerUnits == null) { return; }
    for (i = UnitGroupCount(playerUnits, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(playerUnits, i);
        if (u == null || !UnitIsAlive(u) || APRG_IsMercenaryUnitType(UnitGetType(u))) { continue; }
        nearMerc = APRG_UnitNearMercenary(u, playerUnits);
        APRG_SetSupportCrewAura(u, player, supportStacks, nearMerc);
    }
}

void APRG_TickMercenaryUpgrades(int player) {
    unitgroup units;
    int i;
    unit u;
    if (g_aprgMercenaryUpgradePacked <= 0 && g_aprgMercenaryUpgradePacked2 <= 0) { return; }
    APRG_ApplyMercenaryRecruitCatalog(player);
    units = APRG_PlayerMobileUnits(player);
    for (i = UnitGroupCount(units, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        APRG_ApplyMercenaryUnitUpgrades(u, player);
    }
    APRG_TickSupportCrew(player, units);
}

void APRG_DealDirectDamage(unit target, fixed damage) {
    fixed shields;
    fixed life;
    fixed remaining;
    if (target == null || !UnitIsAlive(target) || damage <= 0.0 || APRG_IsCampaignNullCircuit(target)) { return; }
    remaining = damage;
    shields = UnitGetPropertyFixed(target, c_unitPropShields, c_unitPropCurrent);
    if (shields > 0.0) {
        if (shields >= remaining) {
            UnitSetPropertyFixed(target, c_unitPropShields, shields - remaining);
            return;
        }
        UnitSetPropertyFixed(target, c_unitPropShields, 0.0);
        remaining -= shields;
    }
    life = UnitGetPropertyFixed(target, c_unitPropLife, c_unitPropCurrent);
    if (life <= remaining) { UnitKill(target); }
    else { UnitSetPropertyFixed(target, c_unitPropLife, life - remaining); }
}

bool APRG_MercenaryDamage_Func(bool testConds, bool runActions) {
    int eliteStacks;
    int player;
    int owner;
    unit source;
    unit victim;
    fixed damage;
    if (!runActions || !g_aprgStarted || g_aprgMercenaryDamageBusy) { return true; }
    eliteStacks = APRG_MercenaryUpgradeStacks(0);
    if (eliteStacks <= 0) { return true; }
    source = EventUnitDamageSourceUnit();
    victim = EventUnit();
    if (source == null || victim == null || source == victim || !APRG_IsMercenaryUnitType(UnitGetType(source))) { return true; }
    player = APRG_GetPrimaryPlayer();
    if (UnitGetOwner(source) != player) { return true; }
    owner = UnitGetOwner(victim);
    if (owner < 0 || !libNtve_gf_PlayerIsEnemy(owner, player, libNtve_ge_PlayerRelation_Enemy)) { return true; }
    damage = EventUnitDamageAmount();
    if (damage <= 0.0) { return true; }
    g_aprgMercenaryDamageBusy = true;
    APRG_DealDirectDamage(victim, damage * 0.25 * IntToFixed(eliteStacks));
    g_aprgMercenaryDamageBusy = false;
    return true;
}

unit APRG_FindSpearCaster(int player);
unit APRG_FindSpearAutonomousCaster(int player);

bool APRG_IsSpearCasterType(string unitType) {
    return (
        unitType == "AP_SoACaster" || unitType == "AP_SoAAutonomousCaster" ||
        unitType == "SoACaster" || unitType == "SOACaster" ||
        unitType == "SpearOfAdunCaster" || unitType == "VoidSpearofAdun"
    );
}

int APRG_MarkUnlimitedPowerSpearAbilities(unit caster) {
    int abilityCount;
    int abilityIndex;
    int marked = 0;
    string abilityType;
    if (caster == null) { return 0; }
    abilityCount = MinI(64, UnitAbilityCount(caster));
    for (abilityIndex = 1; abilityIndex <= abilityCount; abilityIndex += 1) {
        abilityType = UnitAbilityGet(caster, abilityIndex);
        if (abilityType == "") { continue; }
        DataTableSetBool(true, "APRG_UnlimitedPowerExclude_" + abilityType, true);
        marked += 1;
    }
    return marked;
}

bool APRG_PrepareUnlimitedPowerSpearExclusions(int player) {
    unit caster;
    unit autonomousCaster;
    bool spearExpected;
    int marked;
    caster = APRG_FindSpearCaster(player);
    autonomousCaster = APRG_FindSpearAutonomousCaster(player);
    marked = APRG_MarkUnlimitedPowerSpearAbilities(caster);
    marked += APRG_MarkUnlimitedPowerSpearAbilities(autonomousCaster);

    spearExpected = (
        APRG_HasProgression(APRG_PROGRESSION_SPEAR) ||
        APRG_HasExtension3(APRG_EXT3_BLESS_SPEAR_OF_ADUN) ||
        APRG_HasExtension3(APRG_EXT3_BLESS_SPEAR_OVERCHARGE)
    );
    if (spearExpected && (caster == null && autonomousCaster == null || marked <= 0)) { return false; }
    return true;
}

bool APRG_UnlimitedPowerAbilityExcluded(string abilityType) {
    if (abilityType == "") { return false; }
    return DataTableGetBool(true, "APRG_UnlimitedPowerExclude_" + abilityType);
}

void APRG_UnlimitedPowerZeroCostPath(int player, string abilityType, string basePath) {
    string field;
    string value;
    fixed numeric;
    if (abilityType == "" || basePath == "" || !CatalogEntryIsValid(c_gameCatalogAbil, abilityType)) { return; }
    field = basePath + ".Vital[Energy]";
    value = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, field, player);
    numeric = StringToFixed(value); if (value != "" && numeric > 0.0) { CatalogFieldValueSet(c_gameCatalogAbil, abilityType, field, player, FixedToString(numeric * 0.5, c_fixedPrecisionAny)); }
    field = basePath + ".VitalFraction[Energy]";
    value = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, field, player);
    numeric = StringToFixed(value); if (value != "" && numeric > 0.0) { CatalogFieldValueSet(c_gameCatalogAbil, abilityType, field, player, FixedToString(numeric * 0.5, c_fixedPrecisionAny)); }
    field = basePath + ".Cooldown.TimeStart";
    value = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, field, player);
    numeric = StringToFixed(value); if (value != "" && numeric > 0.0) { CatalogFieldValueSet(c_gameCatalogAbil, abilityType, field, player, FixedToString(numeric * 0.5, c_fixedPrecisionAny)); }
    field = basePath + ".Cooldown.TimeUse";
    value = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, field, player);
    numeric = StringToFixed(value); if (value != "" && numeric > 0.0) { CatalogFieldValueSet(c_gameCatalogAbil, abilityType, field, player, FixedToString(numeric * 0.5, c_fixedPrecisionAny)); }
    field = basePath + ".Charge.TimeStart";
    value = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, field, player);
    numeric = StringToFixed(value); if (value != "" && numeric > 0.0) { CatalogFieldValueSet(c_gameCatalogAbil, abilityType, field, player, FixedToString(numeric * 0.5, c_fixedPrecisionAny)); }
    field = basePath + ".Charge.TimeUse";
    value = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, field, player);
    numeric = StringToFixed(value); if (value != "" && numeric > 0.0) { CatalogFieldValueSet(c_gameCatalogAbil, abilityType, field, player, FixedToString(numeric * 0.5, c_fixedPrecisionAny)); }
}

void APRG_ApplyUnlimitedPowerAbility(int player, string abilityType) {
    int costCount;
    int costIndex;
    int infoCount;
    int infoIndex;
    int nestedCostCount;
    int nestedCostIndex;
    string infoPath;
    if (
        abilityType == "" || !CatalogEntryIsValid(c_gameCatalogAbil, abilityType) ||
        APRG_UnlimitedPowerAbilityExcluded(abilityType)
    ) { return; }

    APRG_UnlimitedPowerZeroCostPath(player, abilityType, "Cost");
    costCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, "Cost", player);
    for (costIndex = 0; costIndex < costCount; costIndex += 1) {
        APRG_UnlimitedPowerZeroCostPath(player, abilityType, "Cost[" + IntToString(costIndex) + "]");
    }

    infoCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, "InfoArray", player);
    for (infoIndex = 0; infoIndex < infoCount; infoIndex += 1) {
        infoPath = "InfoArray[" + IntToString(infoIndex) + "]";
        APRG_UnlimitedPowerZeroCostPath(player, abilityType, infoPath);
        APRG_UnlimitedPowerZeroCostPath(player, abilityType, infoPath + ".Cost");
        nestedCostCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, infoPath + ".Cost", player);
        for (nestedCostIndex = 0; nestedCostIndex < nestedCostCount; nestedCostIndex += 1) {
            APRG_UnlimitedPowerZeroCostPath(
                player,
                abilityType,
                infoPath + ".Cost[" + IntToString(nestedCostIndex) + "]"
            );
        }
    }
}

void APRG_ApplyUnlimitedPowerCatalog(int player) {
    int count;
    int i;
    string abilityType;
    if (g_aprgUnlimitedPowerCatalogApplied) { return; }
    if (!APRG_PrepareUnlimitedPowerSpearExclusions(player)) { return; }
    count = CatalogEntryCount(c_gameCatalogAbil);
    for (i = 1; i <= count; i += 1) {
        abilityType = CatalogEntryGet(c_gameCatalogAbil, i);
        APRG_ApplyUnlimitedPowerAbility(player, abilityType);
    }
    g_aprgUnlimitedPowerCatalogApplied = true;
}

void APRG_TickUnlimitedPower(int player) {
    APRG_ApplyUnlimitedPowerCatalog(player);
}

bool APRG_IsColossusFamilyType(string unitType) {
    return unitType != "" && StringContains(unitType, "Colossus", c_stringAnywhere, c_stringNoCase);
}

void APRG_TickUnstableColossi(int player) {
    unitgroup units;
    int i;
    unit u;
    string unitType;
    string key;
    string oldBehavior;
    string newBehavior;
    int oldStage;
    int newStage;
    fixed life;
    fixed maxLife;
    fixed ratio;

    units = APRG_PlayerMobileUnits(player);
    i = UnitGroupCount(units, c_unitCountAlive);
    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null) { break; }
        unitType = UnitGetType(u);
        if (!APRG_IsColossusFamilyType(unitType)) { continue; }
        maxLife = UnitGetPropertyFixed(u, c_unitPropLifeMax, c_unitPropCurrent);
        life = UnitGetPropertyFixed(u, c_unitPropLife, c_unitPropCurrent);
        if (maxLife <= 0.0) { continue; }
        ratio = life / maxLife;
        if (ratio < 0.0) { ratio = 0.0; }
        if (ratio > 1.0) { ratio = 1.0; }
        newStage = FixedToInt((1.0 - ratio) * 15.99);
        if (newStage < 0) { newStage = 0; }
        if (newStage > 15) { newStage = 15; }
        key = "APRG_UnstableColossiStage_" + IntToString(UnitGetTag(u));
        oldStage = DataTableGetInt(true, key);
        if (oldStage == newStage) { continue; }
        if (oldStage > 0) {
            oldBehavior = "APRogueUnstableColossi" + IntToString(oldStage);
            UnitBehaviorRemove(u, oldBehavior, c_unitBehaviorCountAll);
        }
        if (newStage > 0) {
            newBehavior = "APRogueUnstableColossi" + IntToString(newStage);
            UnitBehaviorAdd(u, newBehavior, u, 1);
        }
        DataTableSetInt(true, key, newStage);
    }
}

bool APRG_HordeUnitTypeQualifies(int player, string unitType) {
    if (unitType == "" || !CatalogEntryIsValid(c_gameCatalogUnit, unitType)) { return false; }
    return !UnitTypeTestAttribute(unitType, c_unitAttributeStructure);
}

bool APRG_HordeProductionIntermediateType(string unitType) {
    return StringContains(unitType, "Larva", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Egg", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Cocoon", c_stringAnywhere, c_stringNoCase);
}

bool APRG_HordeAbilityInfoProducesUnit(int player, string abilityType, string unitType) {
    int infoCount;
    int infoIndex;
    int unitCount;
    int unitIndex;
    string basePath;
    string producedUnit;
    if (abilityType == null || abilityType == "" || unitType == "" || !CatalogEntryIsValid(c_gameCatalogAbil, abilityType)) { return false; }
    infoCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, "InfoArray", player);
    for (infoIndex = 0; infoIndex < infoCount; infoIndex += 1) {
        basePath = "InfoArray[" + IntToString(infoIndex) + "]";
        producedUnit = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, basePath + ".Unit", player);
        if (producedUnit == unitType) { return true; }
        unitCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, basePath + ".Unit", player);
        for (unitIndex = 0; unitIndex < unitCount; unitIndex += 1) {
            producedUnit = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, basePath + ".Unit[" + IntToString(unitIndex) + "]", player);
            if (producedUnit == unitType) { return true; }
        }
    }
    return false;
}

void APRG_ApplyHordeProducedUnit(unit u, int player) {
    string unitType;
    string tagKey;
    string processedType;
    string lifeBaseKey;
    string lifeTargetKey;
    string shieldBaseKey;
    string shieldTargetKey;
    fixed oldMax;
    fixed oldCurrent;
    fixed baseline;
    fixed target;
    fixed ratio;
    if (u == null || UnitGetOwner(u) != player || !UnitIsAlive(u)) { return; }
    unitType = UnitGetType(u);
    if (!APRG_HordeUnitTypeQualifies(player, unitType) || APRG_HordeProductionIntermediateType(unitType)) { return; }

    tagKey = IntToString(UnitGetTag(u));
    processedType = DataTableGetString(true, "APRG_HordeProducedType_" + tagKey);
    lifeBaseKey = "APRG_HordeLifeBase_" + tagKey;
    lifeTargetKey = "APRG_HordeLifeTarget_" + tagKey;
    shieldBaseKey = "APRG_HordeShieldBase_" + tagKey;
    shieldTargetKey = "APRG_HordeShieldTarget_" + tagKey;

    oldMax = UnitGetPropertyFixed(u, c_unitPropLifeMax, c_unitPropCurrent);
    oldCurrent = UnitGetPropertyFixed(u, c_unitPropLife, c_unitPropCurrent);
    if (oldMax > 0.0) {
        if (processedType != unitType) {
            baseline = oldMax;
            DataTableSetFixed(true, lifeBaseKey, baseline);
            DataTableSetFixed(true, lifeTargetKey, baseline * 0.75);
        }
        else {
            baseline = DataTableGetFixed(true, lifeBaseKey);
            target = DataTableGetFixed(true, lifeTargetKey);
            if (target > 0.0 && oldMax > target + 0.05) {
                baseline = oldMax;
                DataTableSetFixed(true, lifeBaseKey, baseline);
                DataTableSetFixed(true, lifeTargetKey, baseline * 0.75);
            }
        }
        target = DataTableGetFixed(true, lifeTargetKey);
        if (target <= 0.0) { target = oldMax * 0.75; }
        if (oldMax > target + 0.05 || oldMax < target - 0.05) {
            ratio = oldCurrent / oldMax;
            if (ratio < 0.0) { ratio = 0.0; }
            if (ratio > 1.0) { ratio = 1.0; }
            UnitSetPropertyFixed(u, c_unitPropLifeMax, target);
            UnitSetPropertyFixed(u, c_unitPropLife, target * ratio);
        }
    }

    oldMax = UnitGetPropertyFixed(u, c_unitPropShieldsMax, c_unitPropCurrent);
    oldCurrent = UnitGetPropertyFixed(u, c_unitPropShields, c_unitPropCurrent);
    if (oldMax > 0.0) {
        if (processedType != unitType) {
            baseline = oldMax;
            DataTableSetFixed(true, shieldBaseKey, baseline);
            DataTableSetFixed(true, shieldTargetKey, baseline * 0.75);
        }
        else {
            baseline = DataTableGetFixed(true, shieldBaseKey);
            target = DataTableGetFixed(true, shieldTargetKey);
            if (target > 0.0 && oldMax > target + 0.05) {
                baseline = oldMax;
                DataTableSetFixed(true, shieldBaseKey, baseline);
                DataTableSetFixed(true, shieldTargetKey, baseline * 0.75);
            }
        }
        target = DataTableGetFixed(true, shieldTargetKey);
        if (target <= 0.0) { target = oldMax * 0.75; }
        if (oldMax > target + 0.05 || oldMax < target - 0.05) {
            ratio = oldCurrent / oldMax;
            if (ratio < 0.0) { ratio = 0.0; }
            if (ratio > 1.0) { ratio = 1.0; }
            UnitSetPropertyFixed(u, c_unitPropShieldsMax, target);
            UnitSetPropertyFixed(u, c_unitPropShields, target * ratio);
        }
    }
    UnitSetScale(u, 75.0, 75.0, 75.0);
    DataTableSetString(true, "APRG_HordeProducedType_" + tagKey, unitType);
}

bool APRG_HordeTrain_Func(bool testConds, bool runActions) {
    int player;
    unit trained;
    if (!runActions || !g_aprgStarted || !APRG_HasExtension(APRG_EXT_BLESS_HORDE_MODE)) { return true; }
    player = APRG_GetPrimaryPlayer();
    if (EventPlayer() != player) { return true; }
    trained = EventUnitProgressUnit();
    APRG_ApplyHordeProducedUnit(trained, player);
    return true;
}

bool APRG_HordeCreated_Func(bool testConds, bool runActions) {
    int player;
    unit creator;
    unit created;
    string createdType;
    string abilityType;
    bool structureSource = false;
    bool mercenarySource = false;
    if (!runActions || !g_aprgStarted || !APRG_HasExtension(APRG_EXT_BLESS_HORDE_MODE)) { return true; }
    player = APRG_GetPrimaryPlayer();
    created = EventUnitCreatedUnit();
    creator = EventUnit();
    if (created == null || UnitGetOwner(created) != player) { return true; }
    createdType = UnitGetType(created);
    if (!APRG_HordeUnitTypeQualifies(player, createdType) || APRG_HordeProductionIntermediateType(createdType)) { return true; }

    abilityType = EventUnitCreatedAbil();
    if (creator != null && UnitGetOwner(creator) == player && UnitTypeTestAttribute(UnitGetType(creator), c_unitAttributeStructure)) {
        structureSource = true;
    }
    mercenarySource = APRG_IsMercenaryRecruitAbility(abilityType, player);
    if (!structureSource && !mercenarySource) { return true; }
    APRG_ApplyHordeProducedUnit(created, player);
    return true;
}

void APRG_HordeHalveAbilityField(int player, string abilityType, string fieldPath) {
    fixed value;
    bool isMercenaryTimer;
    isMercenaryTimer = APRG_IsMercenaryRecruitAbility(abilityType, player) && (
        StringContains(fieldPath, "Cooldown.Time", c_stringAnywhere, c_stringNoCase) ||
        StringContains(fieldPath, "Charge.Time", c_stringAnywhere, c_stringNoCase)
    );
    if (isMercenaryTimer) { APRG_ClampMercenaryCooldownField(player, abilityType, fieldPath); }
    value = StringToFixed(CatalogFieldValueGet(c_gameCatalogAbil, abilityType, fieldPath, player));
    if (value > 0.0) {
        if (isMercenaryTimer) {
            CatalogFieldValueSet(c_gameCatalogAbil, abilityType, fieldPath, player,
                                 FixedToString(MaxF(1.0, value * 0.5), c_fixedPrecisionAny));
        }
        else { CatalogFieldValueSet(c_gameCatalogAbil, abilityType, fieldPath, player, FixedToString(value * 0.5, c_fixedPrecisionAny)); }
    }
    if (isMercenaryTimer) { APRG_ClampMercenaryCooldownField(player, abilityType, fieldPath); }
}

void APRG_HordeHalveAbilityResourceField(int player, string abilityType, string fieldPath) {
    fixed value;
    int halved;
    value = StringToFixed(CatalogFieldValueGet(c_gameCatalogAbil, abilityType, fieldPath, player));
    if (value <= 0.0) { return; }
    halved = FixedToInt(RoundI(value * 0.5));
    if (halved < 1) { halved = 1; }
    CatalogFieldValueSet(c_gameCatalogAbil, abilityType, fieldPath, player, IntToString(halved));
}

void APRG_ApplyHordeCatalog(int player) {
    int count;
    int i;
    int infoCount;
    int infoIndex;
    int producedCount;
    int producedIndex;
    int sectionCount;
    int sectionIndex;
    int durationCount;
    int durationIndex;
    int costCount;
    int costIndex;
    string unitType;
    string abilityType;
    string trainedUnitType;
    string candidateUnitType;
    string basePath;
    string sectionPath;
    string durationPath;
    string costPath;
    fixed food;
    fixed mineralCost;
    fixed gasCost;
    fixed unitBuildTime;
    fixed originalSupply;
    bool infoProducesUnit;
    bool producesUnit;
    bool mercAbility;
    if (g_aprgHordeCatalogApplied) { return; }

    count = CatalogEntryCount(c_gameCatalogUnit);
    for (i = 1; i <= count; i += 1) {
        unitType = CatalogEntryGet(c_gameCatalogUnit, i);
        if (!APRG_HordeUnitTypeQualifies(player, unitType)) { continue; }

        originalSupply = UnitTypeGetProperty(unitType, c_unitPropSuppliesUsed);
        if (originalSupply > 0.0) {
            DataTableSetFixed(true, "APRG_HordeOriginalSupply_" + IntToString(player) + "_" + unitType, originalSupply);
        }

        mineralCost = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "CostResource[0]", player));
        gasCost = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "CostResource[1]", player));
        if (mineralCost > 0.0) { CatalogFieldValueSet(c_gameCatalogUnit, unitType, "CostResource[0]", player, IntToString(MaxI(1, FixedToInt(RoundI(mineralCost * 0.5))))); }
        if (gasCost > 0.0) { CatalogFieldValueSet(c_gameCatalogUnit, unitType, "CostResource[1]", player, IntToString(MaxI(1, FixedToInt(RoundI(gasCost * 0.5))))); }

        food = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "Food", player));
        if (food < 0.0) { CatalogFieldValueSet(c_gameCatalogUnit, unitType, "Food", player, FixedToString(food * 0.5, c_fixedPrecisionAny)); }

        unitBuildTime = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "BuildTime", player));
        if (unitBuildTime > 0.0) {
            CatalogFieldValueSet(c_gameCatalogUnit, unitType, "BuildTime", player, FixedToString(unitBuildTime * 0.5, c_fixedPrecisionAny));
        }
    }

    count = CatalogEntryCount(c_gameCatalogAbil);
    for (i = 1; i <= count; i += 1) {
        abilityType = CatalogEntryGet(c_gameCatalogAbil, i);
        if (abilityType == "" || !CatalogEntryIsValid(c_gameCatalogAbil, abilityType)) { continue; }
        // ArchonWarp consumes/merges units rather than training a normal unit.
        // Halving its resource/cost fields can create refunds when Horde Mode
        // and Power Overwhelming are combined, so leave this ability untouched.
        if (abilityType == "ArchonWarp") { continue; }
        producesUnit = false;
        mercAbility = StringContains(abilityType, "Hire", c_stringAnywhere, c_stringNoCase) ||
            StringContains(abilityType, "Merc", c_stringAnywhere, c_stringNoCase) ||
            StringContains(abilityType, "Mercenary", c_stringAnywhere, c_stringNoCase);
        infoCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, "InfoArray", player);
        for (infoIndex = 0; infoIndex < infoCount; infoIndex += 1) {
            basePath = "InfoArray[" + IntToString(infoIndex) + "]";
            infoProducesUnit = false;

            trainedUnitType = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, basePath + ".Unit", player);
            if (APRG_HordeUnitTypeQualifies(player, trainedUnitType)) {
                infoProducesUnit = true;
                if (APRG_IsMercenaryUnitType(trainedUnitType)) { mercAbility = true; }
            }
            producedCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, basePath + ".Unit", player);
            for (producedIndex = 0; producedIndex < producedCount; producedIndex += 1) {
                candidateUnitType = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, basePath + ".Unit[" + IntToString(producedIndex) + "]", player);
                if (!APRG_HordeUnitTypeQualifies(player, candidateUnitType)) { continue; }
                infoProducesUnit = true;
                if (APRG_IsMercenaryUnitType(candidateUnitType)) { mercAbility = true; }
            }
            if (!infoProducesUnit) { continue; }
            producesUnit = true;

            APRG_HordeHalveAbilityField(player, abilityType, basePath + ".Time");

            sectionCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, basePath + ".SectionArray", player);
            for (sectionIndex = 0; sectionIndex < sectionCount; sectionIndex += 1) {
                sectionPath = basePath + ".SectionArray[" + IntToString(sectionIndex) + "]";
                durationCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, sectionPath + ".DurationArray", player);
                for (durationIndex = 0; durationIndex < durationCount; durationIndex += 1) {
                    durationPath = sectionPath + ".DurationArray[" + IntToString(durationIndex) + "]";
                    APRG_HordeHalveAbilityField(player, abilityType, durationPath);
                }
            }

            APRG_HordeHalveAbilityResourceField(player, abilityType, basePath + ".Resource[0]");
            APRG_HordeHalveAbilityResourceField(player, abilityType, basePath + ".Resource[1]");
            APRG_HordeHalveAbilityResourceField(player, abilityType, basePath + ".Cost.Resource[0]");
            APRG_HordeHalveAbilityResourceField(player, abilityType, basePath + ".Cost.Resource[1]");

            APRG_HordeHalveAbilityField(player, abilityType, basePath + ".Cooldown.TimeUse");
            APRG_HordeHalveAbilityField(player, abilityType, basePath + ".Cooldown.TimeStart");
            APRG_HordeHalveAbilityField(player, abilityType, basePath + ".Cost.Cooldown.TimeUse");
            APRG_HordeHalveAbilityField(player, abilityType, basePath + ".Cost.Cooldown.TimeStart");
            APRG_HordeHalveAbilityField(player, abilityType, basePath + ".Charge.TimeUse");
            APRG_HordeHalveAbilityField(player, abilityType, basePath + ".Charge.TimeStart");
            APRG_HordeHalveAbilityField(player, abilityType, basePath + ".Cost.Charge.TimeUse");
            APRG_HordeHalveAbilityField(player, abilityType, basePath + ".Cost.Charge.TimeStart");
        }

        if (producesUnit || mercAbility) {
            APRG_HordeHalveAbilityResourceField(player, abilityType, "Resource[0]");
            APRG_HordeHalveAbilityResourceField(player, abilityType, "Resource[1]");
            APRG_HordeHalveAbilityResourceField(player, abilityType, "Cost.Resource[0]");
            APRG_HordeHalveAbilityResourceField(player, abilityType, "Cost.Resource[1]");
            APRG_HordeHalveAbilityField(player, abilityType, "Cost.Cooldown.TimeUse");
            APRG_HordeHalveAbilityField(player, abilityType, "Cost.Cooldown.TimeStart");
            APRG_HordeHalveAbilityField(player, abilityType, "Cost.Charge.TimeUse");
            APRG_HordeHalveAbilityField(player, abilityType, "Cost.Charge.TimeStart");

            costCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, "Cost", player);
            for (costIndex = 0; costIndex < costCount; costIndex += 1) {
                costPath = "Cost[" + IntToString(costIndex) + "]";
                APRG_HordeHalveAbilityResourceField(player, abilityType, costPath + ".Resource[0]");
                APRG_HordeHalveAbilityResourceField(player, abilityType, costPath + ".Resource[1]");
                APRG_HordeHalveAbilityField(player, abilityType, costPath + ".Cooldown.TimeUse");
                APRG_HordeHalveAbilityField(player, abilityType, costPath + ".Cooldown.TimeStart");
                APRG_HordeHalveAbilityField(player, abilityType, costPath + ".Charge.TimeUse");
                APRG_HordeHalveAbilityField(player, abilityType, costPath + ".Charge.TimeStart");
            }
        }
    }
    g_aprgHordeCatalogApplied = true;
}


bool APRG_HordeLarvaBaseType(string unitType) {
    if (StringContains(unitType, "HiveMindEmulator", c_stringAnywhere, c_stringNoCase)) { return false; }
    return StringContains(unitType, "Hatchery", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Lair", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Hive", c_stringAnywhere, c_stringNoCase);
}

int APRG_CountNearbyLarva(unit base, int player, fixed radius) {
    unitgroup nearby;
    int i;
    int count;
    unit u;
    if (base == null) { return 0; }
    nearby = UnitGroup(
        null, player, RegionCircle(UnitGetPosition(base), radius),
        UnitFilter(0, 0, (1 << c_targetFilterStructure) | (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0
    );
    count = 0;
    for (i = UnitGroupCount(nearby, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(nearby, i);
        if (u != null && StringContains(UnitGetType(u), "Larva", c_stringAnywhere, c_stringNoCase)) { count += 1; }
    }
    return count;
}

bool APRG_TriggerNativeLarvaInjection(unit base) {
    if (base == null || !UnitIsAlive(base)) { return false; }
    if (CatalogEntryIsValid(c_gameCatalogBehavior, "QueenSpawnLarvaTimer")) {
        UnitBehaviorAdd(base, "QueenSpawnLarvaTimer", base, 1);
        UnitBehaviorSetDurationRemaining(base, "QueenSpawnLarvaTimer", 0.25);
        return true;
    }
    if (CatalogEntryIsValid(c_gameCatalogBehavior, "SpawnLarva")) {
        UnitBehaviorSpawn(base, "SpawnLarva", 3);
        return true;
    }
    return false;
}

void APRG_TickHordeLarva(int player, fixed now) {
    unitgroup bases;
    int i;
    unit base;
    if (!APRG_PlayerMacroBaseReady(player) || now < g_aprgNextHordeLarvaTime) { return; }
    if (APRG_HasExtension2(APRG_EXT2_BLESS_INFINITE_LARVA)) { return; }
    g_aprgNextHordeLarvaTime = now + 33.0;
    bases = APRG_PlayerStructures(player);
    for (i = UnitGroupCount(bases, c_unitCountAlive); i > 0; i -= 1) {
        base = UnitGroupUnitFromEnd(bases, i);
        if (base == null || UnitGetOwner(base) != player || !APRG_HordeLarvaBaseType(UnitGetType(base))) { continue; }
        APRG_TriggerNativeLarvaInjection(base);
    }
}

void APRG_ApplyHordeMode(int player) {
    APRG_ApplyHordeCatalog(player);
}

void APRG_AddCommandCardButton(int player, string unitType, string face, string abilCmd, int row, int column) {
    int count;
    int i;
    int r;
    int c;
    string basePath;
    bool occupied;
    if (!CatalogEntryIsValid(c_gameCatalogUnit, unitType)) { return; }
    count = CatalogFieldValueCount(c_gameCatalogUnit, unitType, "CardLayouts[0].LayoutButtons", player);
    for (i = 0; i < count; i += 1) {
        basePath = "CardLayouts[0].LayoutButtons[" + IntToString(i) + "]";
        if (CatalogFieldValueGet(c_gameCatalogUnit, unitType, basePath + ".Face", player) == face) { return; }
    }

    occupied = false;
    for (i = 0; i < count; i += 1) {
        basePath = "CardLayouts[0].LayoutButtons[" + IntToString(i) + "]";
        if (CatalogFieldValueGet(c_gameCatalogUnit, unitType, basePath + ".Row", player) == IntToString(row)
            && CatalogFieldValueGet(c_gameCatalogUnit, unitType, basePath + ".Column", player) == IntToString(column)) {
            occupied = true;
            break;
        }
    }
    if (occupied) {
        for (r = 2; r >= 0; r -= 1) {
            for (c = 4; c >= 0; c -= 1) {
                occupied = false;
                for (i = 0; i < count; i += 1) {
                    basePath = "CardLayouts[0].LayoutButtons[" + IntToString(i) + "]";
                    if (CatalogFieldValueGet(c_gameCatalogUnit, unitType, basePath + ".Row", player) == IntToString(r)
                        && CatalogFieldValueGet(c_gameCatalogUnit, unitType, basePath + ".Column", player) == IntToString(c)) {
                        occupied = true;
                        break;
                    }
                }
                if (!occupied) {
                    row = r;
                    column = c;
                    r = -1;
                    break;
                }
            }
        }
    }

    basePath = "CardLayouts[0].LayoutButtons[" + IntToString(count) + "]";
    CatalogFieldValueSet(c_gameCatalogUnit, unitType, basePath + ".Face", player, face);
    CatalogFieldValueSet(c_gameCatalogUnit, unitType, basePath + ".Type", player, "AbilCmd");
    CatalogFieldValueSet(c_gameCatalogUnit, unitType, basePath + ".AbilCmd", player, abilCmd);
    CatalogFieldValueSet(c_gameCatalogUnit, unitType, basePath + ".Row", player, IntToString(row));
    CatalogFieldValueSet(c_gameCatalogUnit, unitType, basePath + ".Column", player, IntToString(column));
}

bool APRG_HideScvJumpJetsButtonsForType(int player, string unitType) {
    int count;
    int i;
    string basePath;
    string face;
    string abilCmd;
    bool changed = false;
    bool faceMatches;
    bool abilMatches;
    if (!CatalogEntryIsValid(c_gameCatalogUnit, unitType)) { return false; }
    count = CatalogFieldValueCount(c_gameCatalogUnit, unitType, "CardLayouts[0].LayoutButtons", player);
    for (i = 0; i < count; i += 1) {
        basePath = "CardLayouts[0].LayoutButtons[" + IntToString(i) + "]";
        face = CatalogFieldValueGet(c_gameCatalogUnit, unitType, basePath + ".Face", player);
        abilCmd = CatalogFieldValueGet(c_gameCatalogUnit, unitType, basePath + ".AbilCmd", player);
        faceMatches = StringContains(face, "Jump", c_stringAnywhere, c_stringNoCase) && StringContains(face, "Jet", c_stringAnywhere, c_stringNoCase);
        abilMatches = StringContains(abilCmd, "Jump", c_stringAnywhere, c_stringNoCase) && StringContains(abilCmd, "Jet", c_stringAnywhere, c_stringNoCase);
        if (!faceMatches && !abilMatches) { continue; }
        // Construction Jump Jets is passive. Keep the underlying upgrade/ability,
        // but remove its redundant command-card button so Slay's Archon Merge
        // button cannot share the same slot or tooltip.
        CatalogFieldValueSet(c_gameCatalogUnit, unitType, basePath + ".Face", player, "");
        CatalogFieldValueSet(c_gameCatalogUnit, unitType, basePath + ".Type", player, "");
        CatalogFieldValueSet(c_gameCatalogUnit, unitType, basePath + ".AbilCmd", player, "");
        changed = true;
    }
    return changed;
}

void APRG_HideScvJumpJetsCommandCard(int player) {
    APRG_HideScvJumpJetsButtonsForType(player, "SCV");
    APRG_HideScvJumpJetsButtonsForType(player, "AP_SCV");
}

string APRG_ArchonWarpButtonFace(int player) {
    string sourceUnitType = "";
    int count;
    int i;
    string basePath;
    string abilCmd;
    string face;
    if (CatalogEntryIsValid(c_gameCatalogUnit, "HighTemplar")) { sourceUnitType = "HighTemplar"; }
    else if (CatalogEntryIsValid(c_gameCatalogUnit, "DarkTemplar")) { sourceUnitType = "DarkTemplar"; }
    if (sourceUnitType == "") { return "AWrp"; }
    count = CatalogFieldValueCount(c_gameCatalogUnit, sourceUnitType, "CardLayouts[0].LayoutButtons", player);
    for (i = 0; i < count; i += 1) {
        basePath = "CardLayouts[0].LayoutButtons[" + IntToString(i) + "]";
        abilCmd = CatalogFieldValueGet(c_gameCatalogUnit, sourceUnitType, basePath + ".AbilCmd", player);
        if (!StringContains(abilCmd, "ArchonWarp", c_stringAnywhere, c_stringNoCase)) { continue; }
        face = CatalogFieldValueGet(c_gameCatalogUnit, sourceUnitType, basePath + ".Face", player);
        if (face != "") { return face; }
    }
    return "AWrp";
}

bool APRG_CopyArchonWarpButton(int player, string targetUnitType) {
    string sourceUnitType = "";
    int count;
    int i;
    string basePath;
    string abilCmd;
    string face;
    if (CatalogEntryIsValid(c_gameCatalogUnit, "HighTemplar")) { sourceUnitType = "HighTemplar"; }
    else if (CatalogEntryIsValid(c_gameCatalogUnit, "DarkTemplar")) { sourceUnitType = "DarkTemplar"; }
    if (sourceUnitType == "") { return false; }
    count = CatalogFieldValueCount(c_gameCatalogUnit, sourceUnitType, "CardLayouts[0].LayoutButtons", player);
    for (i = 0; i < count; i += 1) {
        basePath = "CardLayouts[0].LayoutButtons[" + IntToString(i) + "]";
        abilCmd = CatalogFieldValueGet(c_gameCatalogUnit, sourceUnitType, basePath + ".AbilCmd", player);
        if (!StringContains(abilCmd, "ArchonWarp", c_stringAnywhere, c_stringNoCase)) { continue; }
        face = CatalogFieldValueGet(c_gameCatalogUnit, sourceUnitType, basePath + ".Face", player);
        if (face == "" || abilCmd == "") { continue; }
        APRG_AddCommandCardButton(player, targetUnitType, face, abilCmd, 1, 3);
        return true;
    }
    return false;
}

void APRG_ApplyPowerOverwhelming(int player) {
    unitgroup workers;
    int i;
    unit u;
    string workerType;
    if (!APRG_PlayerMacroBaseReady(player) || !CatalogEntryIsValid(c_gameCatalogAbil, "ArchonWarp")) { return; }

    TechTreeAbilityAllow(player, AbilityCommand("ArchonWarp", 0), true);
    workers = APRG_PlayerWorkers(player);
    i = UnitGroupCount(workers, c_unitCountAlive);
    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(workers, i);
        if (u == null) { break; }
        workerType = UnitGetType(u);
        if (UnitGroupHasUnit(g_aprgPowerOverwhelmingProcessed, u)) { continue; }
        UnitAbilityAdd(u, "ArchonWarp");
        UnitAbilityShow(u, "ArchonWarp", true);
        UnitAbilityEnable(u, "ArchonWarp", true);
        APRG_HideScvJumpJetsButtonsForType(player, workerType);
        APRG_CopyArchonWarpButton(player, workerType);
        UnitGroupAdd(g_aprgPowerOverwhelmingProcessed, u);
    }
}

void APRG_ApplyDrakkenDrillBlessing(int player) {
    unitgroup workers;
    int i;
    unit u;
    string workerType;
    string drillType;
    if (!APRG_PlayerMacroBaseReady(player) || !CatalogEntryIsValid(c_gameCatalogAbil, "APRogueBuildDrakkenLaserDrill")) { return; }
    drillType = APRG_DrillUnitType();
    if (drillType == "") { return; }
    CatalogFieldValueSet(c_gameCatalogUnit, drillType, "CostResource[0]", player, "800");
    CatalogFieldValueSet(c_gameCatalogUnit, drillType, "CostResource[1]", player, "800");
    CatalogFieldValueSet(c_gameCatalogUnit, drillType, "BuildTime", player, "30");
    CatalogFieldValueSet(c_gameCatalogAbil, "APRogueBuildDrakkenLaserDrill", "InfoArray[Build1].Unit", player, drillType);
    CatalogFieldValueSet(c_gameCatalogAbil, "APRogueBuildDrakkenLaserDrill", "InfoArray[Build1].Time", player, "30");
    if (!g_aprgDrakkenDataUnlocked && CatalogEntryIsValid(c_gameCatalogUpgrade, "APRogueDrakkenUnlocked")) {
        TechTreeUpgradeAddLevel(player, "APRogueDrakkenUnlocked", 1);
        g_aprgDrakkenDataUnlocked = true;
    }
    TechTreeAbilityAllow(player, AbilityCommand("APRogueBuildDrakkenLaserDrill", 0), true);
    TechTreeAbilityAllow(player, AbilityCommand("APRogueBuildDrakkenLaserDrill", 1), true);
    workers = APRG_PlayerWorkers(player);
    i = UnitGroupCount(workers, c_unitCountAlive);
    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(workers, i);
        if (u == null) { break; }
        workerType = UnitGetType(u);
        if (UnitGroupHasUnit(g_aprgDrakkenDrillProcessed, u)) { continue; }
        UnitAbilityAdd(u, "APRogueBuildDrakkenLaserDrill");
        UnitAbilityShow(u, "APRogueBuildDrakkenLaserDrill", true);
        UnitAbilityEnable(u, "APRogueBuildDrakkenLaserDrill", true);
        APRG_AddCommandCardButton(player, workerType, "APRogueBuildDrakkenLaserDrillButton", "APRogueBuildDrakkenLaserDrill,Build1", 1, 4);
        UnitGroupAdd(g_aprgDrakkenDrillProcessed, u);
    }
}

string APRG_JetpacksModelForType(string unitType) {
    if (StringContains(unitType, "Marine", c_stringAnywhere, c_stringNoCase)) { return "Marine"; }
    if (StringContains(unitType, "Zealot", c_stringAnywhere, c_stringNoCase)) { return "Zealot"; }
    if (StringContains(unitType, "Zergling", c_stringAnywhere, c_stringNoCase)) { return "Zergling"; }
    return "";
}

string APRG_JetpacksShellForType(string unitType) {
    if (StringContains(unitType, "Burrowed", c_stringAnywhere, c_stringNoCase)
        || StringContains(unitType, "Egg", c_stringAnywhere, c_stringNoCase)
        || StringContains(unitType, "Cocoon", c_stringAnywhere, c_stringNoCase)
        || StringContains(unitType, "Respawn", c_stringAnywhere, c_stringNoCase)
        || StringContains(unitType, "Missile", c_stringAnywhere, c_stringNoCase)) {
        return "";
    }
    if (StringContains(unitType, "Marine", c_stringAnywhere, c_stringNoCase)
        || StringContains(unitType, "Zealot", c_stringAnywhere, c_stringNoCase)
        || StringContains(unitType, "Zergling", c_stringAnywhere, c_stringNoCase)) {
        return "Mutalisk";
    }
    return "";
}

void APRG_ConvertJetpacksUnit(unit source) {
    unit replacement;
    int owner;
    int weaponCount;
    int wi;
    fixed oldLifeMax;
    fixed oldLife;
    fixed oldShieldMax;
    fixed oldShields;
    fixed oldEnergyMax;
    fixed oldEnergy;
    fixed oldSpeed;
    fixed lifeRatio;
    fixed shieldRatio;
    fixed energyRatio;
    string sourceType;
    string sourceWeapon;
    string removeWeapon;
    string fallbackWeapon;
    string modelType;
    string shellType;
    order priorOrder;
    bool hadIssuedOrder;

    if (source == null || !UnitIsAlive(source)) { return; }
    sourceType = UnitGetType(source);
    shellType = APRG_JetpacksShellForType(sourceType);
    if (shellType == "" || !CatalogEntryIsValid(c_gameCatalogUnit, shellType)) { return; }
    owner = UnitGetOwner(source);
    if (owner < 0) { return; }

    hadIssuedOrder = false;
    if (UnitOrderCount(source) > 0 && !UnitOrderIsAcquired(source, 0)) {
        priorOrder = UnitOrder(source, 0);
        hadIssuedOrder = true;
    }

    oldLifeMax = UnitGetPropertyFixed(source, c_unitPropLifeMax, c_unitPropCurrent);
    oldLife = UnitGetPropertyFixed(source, c_unitPropLife, c_unitPropCurrent);
    oldShieldMax = UnitGetPropertyFixed(source, c_unitPropShieldsMax, c_unitPropCurrent);
    oldShields = UnitGetPropertyFixed(source, c_unitPropShields, c_unitPropCurrent);
    oldEnergyMax = UnitGetPropertyFixed(source, c_unitPropEnergyMax, c_unitPropCurrent);
    oldEnergy = UnitGetPropertyFixed(source, c_unitPropEnergy, c_unitPropCurrent);
    oldSpeed = UnitGetPropertyFixed(source, c_unitPropMovementSpeed, c_unitPropCurrent);
    lifeRatio = 1.0;
    shieldRatio = 1.0;
    energyRatio = 1.0;
    if (oldLifeMax > 0.0) { lifeRatio = oldLife / oldLifeMax; }
    if (oldShieldMax > 0.0) { shieldRatio = oldShields / oldShieldMax; }
    if (oldEnergyMax > 0.0) { energyRatio = oldEnergy / oldEnergyMax; }

    sourceWeapon = "";
    weaponCount = UnitWeaponCount(source);
    for (wi = 1; wi <= weaponCount; wi += 1) {
        if (sourceWeapon == "" && UnitWeaponIsEnabled(source, wi)) { sourceWeapon = UnitWeaponGet(source, wi); }
    }
    if (sourceWeapon == "" && weaponCount > 0) { sourceWeapon = UnitWeaponGet(source, 1); }

    libNtve_gf_ReplaceUnit(source, shellType, libNtve_ge_ReplaceUnitOptions_OldUnitsRelative);
    replacement = libNtve_gf_LastReplacedUnit();
    if (replacement == null) { return; }

    fallbackWeapon = "";
    if (sourceWeapon != "" && CatalogEntryIsValid(c_gameCatalogWeapon, sourceWeapon)) {
        weaponCount = UnitWeaponCount(replacement);
        if (weaponCount > 0) { fallbackWeapon = UnitWeaponGet(replacement, 1); }
        for (wi = weaponCount; wi >= 1; wi -= 1) {
            removeWeapon = UnitWeaponGet(replacement, wi);
            if (removeWeapon != "") { UnitWeaponRemove(replacement, removeWeapon); }
        }
        UnitWeaponAdd(replacement, sourceWeapon, null);
        if (UnitWeaponCount(replacement) <= 0 && fallbackWeapon != ""
            && CatalogEntryIsValid(c_gameCatalogWeapon, fallbackWeapon)) {
            UnitWeaponAdd(replacement, fallbackWeapon, null);
        }
    }

    if (oldLifeMax > 0.0) {
        UnitSetPropertyFixed(replacement, c_unitPropLifeMax, oldLifeMax);
        UnitSetPropertyFixed(replacement, c_unitPropLife, MaxF(1.0, oldLifeMax * lifeRatio));
    }
    if (oldShieldMax > 0.0) {
        UnitSetPropertyFixed(replacement, c_unitPropShieldsMax, oldShieldMax);
        UnitSetPropertyFixed(replacement, c_unitPropShields, oldShieldMax * shieldRatio);
    }
    if (oldEnergyMax > 0.0) {
        UnitSetPropertyFixed(replacement, c_unitPropEnergyMax, oldEnergyMax);
        UnitSetPropertyFixed(replacement, c_unitPropEnergy, oldEnergyMax * energyRatio);
    }
    if (oldSpeed > 0.0) { UnitSetPropertyFixed(replacement, c_unitPropMovementSpeed, oldSpeed); }

    modelType = APRG_JetpacksModelForType(sourceType);
    if (modelType != "" && CatalogEntryIsValid(c_gameCatalogModel, modelType)) {
        libNtve_gf_SendActorMessageToUnit(replacement, libNtve_gf_ModelSwap(modelType, 0));
    }
    UnitSetInfoText2(replacement, UnitTypeGetName(sourceType));
    DataTableSetString(true, "APRG_JetpacksSourceType_" + IntToString(UnitGetTag(replacement)), sourceType);
    UnitGroupAdd(g_aprgJetpacksProcessed, replacement);

    AISetUnitScriptControlled(replacement, false);
    if (hadIssuedOrder && UnitOrderIsValid(replacement, priorOrder)) {
        UnitIssueOrder(replacement, priorOrder, c_orderQueueReplace);
    }
}

fixed APRG_JetpackMineralValue(unit u) {
    string sourceType;
    string key;
    fixed value;
    int owner;
    if (u == null || !UnitIsAlive(u)) { return 0.0; }
    key = "APRG_JetpacksSourceType_" + IntToString(UnitGetTag(u));
    sourceType = DataTableGetString(true, key);
    if (sourceType == "") { return 0.0; }
    owner = UnitGetOwner(u);
    value = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, sourceType, "CostResource[0]", owner));
    if (value <= 0.0) {
        if (StringContains(sourceType, "Marine", c_stringAnywhere, c_stringNoCase)) { return 50.0; }
        if (StringContains(sourceType, "Zealot", c_stringAnywhere, c_stringNoCase)) { return 100.0; }
        if (StringContains(sourceType, "Zergling", c_stringAnywhere, c_stringNoCase)) { return 25.0; }
    }
    return value;
}

void APRG_TickJetpackAttackWaves(int player, fixed now) {
    unitgroup candidates;
    unitgroup attackers;
    unit target;
    unit u;
    fixed targetValue;
    fixed selectedValue;
    fixed cost;
    point destination;
    int cap;

    if (!APRG_PlayerMacroBaseReady(player) || now < g_aprgNextJetpackWaveTime) { return; }
    cap = 50 * (g_aprgJetpackWaveIndex + 1);
    if (cap > 1000) { cap = 1000; }
    targetValue = IntToFixed(cap);
    selectedValue = 0.0;
    candidates = UnitGroupEmpty();
    UnitGroupAddUnitGroup(candidates, g_aprgJetpacksProcessed);
    attackers = UnitGroupEmpty();

    while (selectedValue < targetValue && UnitGroupCount(candidates, c_unitCountAlive) > 0) {
        u = UnitGroupRandomUnit(candidates, c_unitCountAlive);
        if (u == null) { break; }
        UnitGroupRemove(candidates, u);
        if (!UnitIsAlive(u)) { continue; }
        cost = APRG_JetpackMineralValue(u);
        if (cost <= 0.0) { continue; }
        UnitGroupAdd(attackers, u);
        selectedValue += cost;
    }

    target = APRG_FindPlayerHomeStructure(player);
    if (target != null && UnitGroupCount(attackers, c_unitCountAlive) > 0) {
        destination = UnitGetPosition(target);
        UnitGroupIssueOrder(attackers, OrderTargetingPoint(AbilityCommand("attack", 0), destination), c_orderQueueReplace);
    }
    g_aprgJetpackWaveIndex += 1;
    if (g_aprgJetpackWaveIndex == 1) { g_aprgNextJetpackWaveTime = g_aprgMacroReadyTime + 360.0; }
    else { g_aprgNextJetpackWaveTime += 60.0; }
}

void APRG_ApplyJetpacks(int player) {
    unitgroup enemies;
    int i;
    unit u;
    string unitType;
    enemies = APRG_EnemyAllUnits(player);
    i = UnitGroupCount(enemies, c_unitCountAlive);
    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(enemies, i);
        if (u == null) { break; }
        unitType = UnitGetType(u);
        if (APRG_JetpacksShellForType(unitType) == "") { continue; }
        APRG_ConvertJetpacksUnit(u);
    }
    APRG_TickJetpackAttackWaves(player, GameGetMissionTime());
}

void APRG_EnableStealthTunnelType(int player, string unitType) {
    string key;
    string mover;
    fixed fallbackSpeed;
    if (!CatalogEntryIsValid(c_gameCatalogUnit, unitType) || !CatalogEntryIsValid(c_gameCatalogUnit, "InfestorBurrowed")) { return; }
    key = "APRG_StealthTunnelType_" + IntToString(player) + "_" + unitType;
    if (DataTableGetBool(true, key)) { return; }
    mover = CatalogFieldValueGet(c_gameCatalogUnit, "InfestorBurrowed", "Mover", player);
    fallbackSpeed = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, "InfestorBurrowed", "Speed", player));
    if (mover != "") { CatalogFieldValueSet(c_gameCatalogUnit, unitType, "Mover", player, mover); }
    if (fallbackSpeed > 0.0) { CatalogFieldValueSet(c_gameCatalogUnit, unitType, "Speed", player, FixedToString(fallbackSpeed, c_fixedPrecisionAny)); }
    CatalogFieldValueSet(c_gameCatalogUnit, unitType, "Collide[Burrow]", player, "0");
    CatalogFieldValueSet(c_gameCatalogUnit, unitType, "Collide[RoachBurrow]", player, "1");
    APRG_AddCommandCardButton(player, unitType, "Move", "move,Move", 0, 0);
    APRG_AddCommandCardButton(player, unitType, "Stop", "stop,Stop", 0, 1);
    DataTableSetBool(true, key, true);
}

void APRG_ApplyStealthTunnels(int player) {
    unitgroup units;
    int i;
    unit u;
    string unitType;
    string speedKey;
    fixed speed;
    fixed cachedSpeed;
    bool buried;
    units = APRG_PlayerAllUnits(player);
    i = UnitGroupCount(units, c_unitCountAlive);
    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null) { break; }
        unitType = UnitGetType(u);
        speedKey = "APRG_StealthTunnelSpeed_" + IntToString(UnitGetTag(u));
        buried = CatalogFieldValueGet(c_gameCatalogUnit, unitType, "FlagArray[Buried]", player) == "1";
        if (!buried) {
            speed = UnitGetPropertyFixed(u, c_unitPropMovementSpeed, c_unitPropCurrent);
            if (speed > 0.0) { DataTableSetFixed(true, speedKey, speed); }
            continue;
        }
        APRG_EnableStealthTunnelType(player, unitType);
        UnitAbilityAdd(u, "move");
        UnitAbilityAdd(u, "stop");
        cachedSpeed = DataTableGetFixed(true, speedKey);
        if (cachedSpeed > 0.0) { UnitSetPropertyFixed(u, c_unitPropMovementSpeed, cachedSpeed); }
    }
}

void APRG_EnsureBlinkOnUnit(int player, unit u) {
    string unitType;
    if (u == null || !UnitIsAlive(u) || !CatalogEntryIsValid(c_gameCatalogAbil, "APRogueBlink")) { return; }
    unitType = UnitGetType(u);
    if (APRG_IsSpearCasterType(unitType)) {
        if (UnitAbilityExists(u, "APRogueBlink")) {
            UnitAbilityShow(u, "APRogueBlink", false);
            UnitAbilityEnable(u, "APRogueBlink", false);
            UnitAbilityRemove(u, "APRogueBlink");
        }
        return;
    }
    if (UnitTypeTestAttribute(unitType, c_unitAttributeStructure)) {
        if (UnitAbilityExists(u, "APRogueBlink")) {
            UnitAbilityShow(u, "APRogueBlink", false);
            UnitAbilityEnable(u, "APRogueBlink", false);
        }
        return;
    }

    if (UnitAbilityExists(u, "Blink")) { UnitAbilityRemove(u, "Blink"); }
    if (UnitAbilityExists(u, "AP_Blink")) { UnitAbilityRemove(u, "AP_Blink"); }
    if (UnitAbilityExists(u, "AP_BlinkMultiple")) { UnitAbilityRemove(u, "AP_BlinkMultiple"); }
    if (!UnitAbilityExists(u, "APRogueBlink")) { UnitAbilityAdd(u, "APRogueBlink"); }
    UnitAbilityShow(u, "APRogueBlink", true);
    UnitAbilityEnable(u, "APRogueBlink", true);
}

void APRG_PrepareBlinkCatalog(int player) {
    g_aprgBlinkCatalogPrepared = true;
}

void APRG_ApplyBlinkBlessing(int player) {
    unitgroup units;
    int i;
    unit u;
    if (!CatalogEntryIsValid(c_gameCatalogAbil, "APRogueBlink")) { return; }
    APRG_PrepareBlinkCatalog(player);
    if (CatalogEntryIsValid(c_gameCatalogUpgrade, "APRogueBlinkUnlocked")
        && TechTreeUpgradeCount(player, "APRogueBlinkUnlocked", c_techCountCompleteOnly) <= 0) {
        TechTreeUpgradeAddLevel(player, "APRogueBlinkUnlocked", 1);
    }
    TechTreeAbilityAllow(player, AbilityCommand("APRogueBlink", 0), true);

    units = UnitGroup(
        null, player, RegionPlayableMap(),
        UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0
    );
    for (i = UnitGroupCount(units, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null) { break; }
        APRG_EnsureBlinkOnUnit(player, u);
    }
}

string APRG_ZagaraBanelingSoundId(string suffix) {
    string cacheKey;
    string cached;
    string token;
    string entry;
    string assetFile;
    int count;
    int i;
    cacheKey = "APRG_ZagaraBanelingSound_" + suffix;
    cached = DataTableGetString(true, cacheKey);
    if (cached != "" && CatalogEntryIsValid(c_gameCatalogSound, cached)) { return cached; }
    token = "_roguequeen_" + suffix + ".ogg";
    count = CatalogEntryCount(c_gameCatalogSound);
    for (i = 1; i <= count; i += 1) {
        entry = CatalogEntryGet(c_gameCatalogSound, i);
        if (entry == "" || !CatalogEntryIsValid(c_gameCatalogSound, entry)) { continue; }
        assetFile = CatalogFieldValueGet(c_gameCatalogSound, entry, "AssetArray[0].File", c_playerAny);
        if (StringContains(assetFile, token, c_stringEnd, c_stringNoCase)) {
            DataTableSetString(true, cacheKey, entry);
            return entry;
        }
    }
    return "";
}

void APRG_PlayZagaraBanelingVO(int player, int waveIndex) {
    string suffix = "";
    string soundId;
    if (waveIndex == 1) { suffix = "091"; }
    else if (waveIndex == 2) { suffix = "056"; }
    else if (waveIndex == 3) { suffix = "057"; }
    if (suffix == "") { return; }
    soundId = APRG_ZagaraBanelingSoundId(suffix);
    if (soundId != "") {
        SoundPlay(SoundLink(soundId, c_soundIndexAny), PlayerGroupSingle(player), 100.0, 0.0);
    }
}

void APRG_RetargetZagaraBanelings(int player) {
    int i;
    int j;
    int count = UnitGroupCount(g_aprgZagaraBanelingUnits, c_unitCountAlive);
    int batchCount;
    int ordinal;
    unit baneling;
    unit target;
    unit candidate;
    unit home = null;
    unitgroup structures = null;
    unitgroup mobile = null;
    fixed closest;
    fixed distance;
    point destination;
    if (count <= 0) { g_aprgZagaraBanelingRetargetCursor = 0; return; }
    // Keep the 25-unit round-robin budget: initial orders are staggered
    // across four seconds, not issued to 100 units on a single frame.
    if (g_aprgZagaraBanelingRetargetCursor >= count) { g_aprgZagaraBanelingRetargetCursor = 0; }
    batchCount = count;
    if (batchCount > 25) { batchCount = 25; }
    for (i = 0; i < batchCount; i += 1) {
        ordinal = ((g_aprgZagaraBanelingRetargetCursor + i) % count) + 1;
        baneling = UnitGroupUnitFromEnd(g_aprgZagaraBanelingUnits, ordinal);
        if (baneling == null || !UnitIsAlive(baneling)) { continue; }
        // Native attack-move already engages enemies en route. Reissuing
        // the same order every four seconds triggers 100 ground re-paths
        // and interrupts ongoing combat. Only reassign idle units.
        if (UnitGroupHasUnit(g_aprgZagaraBanelingOrderedUnits, baneling) &&
            UnitOrderCount(baneling) > 0) { continue; }
        // Most Banelings spawned together share connected terrain. Choose
        // a reachable structure once, then reuse that goal for the swarm.
        if (g_aprgZagaraBanelingSharedTarget == null ||
            !UnitIsAlive(g_aprgZagaraBanelingSharedTarget) ||
            UnitTestState(g_aprgZagaraBanelingSharedTarget, c_unitStateInvulnerable)) {
            if (structures == null) { structures = APRG_PlayerStructures(player); }
            g_aprgZagaraBanelingSharedTarget =
                APRG_NearestPathablePlayerStructureFromGroup(baneling, player, structures);
            if (g_aprgZagaraBanelingSharedTarget != null &&
                !UnitPathableToPoint(baneling, UnitGetPosition(g_aprgZagaraBanelingSharedTarget),
                    7.0, 100000.0)) {
                g_aprgZagaraBanelingSharedTarget = null;
            }
        }
        target = g_aprgZagaraBanelingSharedTarget;
        if (target != null &&
            APRG_OrderBanelingStreamAttackMove(baneling, UnitGetPosition(target))) {
            UnitGroupAdd(g_aprgZagaraBanelingOrderedUnits, baneling);
            continue;
        }
        // No accessible player structures: keep the existing reachable
        // mobile/home/patrol fallback, but only compute it for idle units.
        if (mobile == null) { mobile = APRG_PlayerMobileUnits(player); }
        target = null;
        closest = 100000.0;
        for (j = UnitGroupCount(mobile, c_unitCountAlive); j > 0; j -= 1) {
            candidate = UnitGroupUnitFromEnd(mobile, j);
            if (candidate == null || !UnitIsAlive(candidate) ||
                UnitTestState(candidate, c_unitStateInvulnerable)) { continue; }
            if (!UnitPathableToPoint(baneling, UnitGetPosition(candidate), 4.0, 100000.0)) { continue; }
            distance = DistanceBetweenPoints(UnitGetPosition(candidate), UnitGetPosition(baneling));
            if (distance < closest) { target = candidate; closest = distance; }
        }
        if (target != null &&
            APRG_OrderBanelingStreamAttackMove(baneling, UnitGetPosition(target))) {
            UnitGroupAdd(g_aprgZagaraBanelingOrderedUnits, baneling);
            continue;
        }
        if (home == null) { home = APRG_FindPlayerHomeStructure(player); }
        if (home != null && UnitPathableToPoint(baneling, UnitGetPosition(home), 8.0, 100000.0) &&
            APRG_OrderBanelingStreamAttackMove(baneling, UnitGetPosition(home))) {
            UnitGroupAdd(g_aprgZagaraBanelingOrderedUnits, baneling);
            continue;
        }
        destination = APRG_RandomFixedPatrolPointForUnit(baneling, player, true);
        if (destination != null && APRG_OrderBanelingStreamAttackMove(baneling, destination)) {
            UnitGroupAdd(g_aprgZagaraBanelingOrderedUnits, baneling);
        }
    }
    g_aprgZagaraBanelingRetargetCursor = (g_aprgZagaraBanelingRetargetCursor + batchCount) % count;
}

void APRG_TickZagarasBanelings(int player, fixed now) {
    unit enemyBase;
    unit home;
    unitgroup created;
    unitgroup spawnedBanelings;
    unit baneling;
    int enemyOwner;
    int batch;
    int i;
    point spawnPoint;
    point initialSpawnPoint;
    if (!APRG_PlayerMacroBaseReady(player)) { return; }
    if (now >= g_aprgNextZagaraBanelingRetargetTime) {
        APRG_RetargetZagaraBanelings(player);
        g_aprgNextZagaraBanelingRetargetTime = now + 1.0;
    }
    if (now < g_aprgNextZagaraBanelingTime) { return; }
    if (!CatalogEntryIsValid(c_gameCatalogUnit, "Baneling")) { g_aprgNextZagaraBanelingTime = now + 1.0; return; }
    enemyBase = APRG_RandomPathableHostileBaseAnchor(player);
    home = APRG_FindPlayerHomeStructure(player);
    if (enemyBase == null || home == null) { g_aprgNextZagaraBanelingTime = now + 1.0; return; }
    enemyOwner = UnitGetOwner(enemyBase);
    if (enemyOwner < 0) { g_aprgNextZagaraBanelingTime = now + 1.0; return; }
    // Disperse the 100 units around five safe reachable points. A single
    // ignore-placement pile can cause Banelings to body-block one another.
    initialSpawnPoint = APRG_FindHostileGroundPointNear(player, UnitGetPosition(enemyBase), 3.0, 10.0);
    if (initialSpawnPoint == null || !APRG_LabRatEnemySpawnAllowed(initialSpawnPoint, player)) {
        g_aprgNextZagaraBanelingTime = now + 1.0;
        return;
    }
    spawnedBanelings = UnitGroupEmpty();
    for (batch = 0; batch < 5; batch += 1) {
        spawnPoint = APRG_FindHostileGroundPointNear(player, UnitGetPosition(enemyBase), 3.0, 10.0);
        if (spawnPoint == null || !APRG_LabRatEnemySpawnAllowed(spawnPoint, player)) { spawnPoint = initialSpawnPoint; }
        created = UnitCreate(20, "Baneling", c_unitCreateIgnorePlacement, enemyOwner, spawnPoint, libNtve_gf_RandomAngle());
        for (i = UnitGroupCount(created, c_unitCountAlive); i > 0; i -= 1) {
            baneling = UnitGroupUnitFromEnd(created, i);
            if (baneling != null) { AISetUnitScriptControlled(baneling, false); }
        }
        UnitGroupAddUnitGroup(spawnedBanelings, created);
    }
    if (UnitGroupCount(spawnedBanelings, c_unitCountAlive) <= 0) { g_aprgNextZagaraBanelingTime = now + 1.0; return; }
    g_aprgZagaraBanelingWaveIndex += 1;
    g_aprgZagaraBanelingSharedTarget = null;
    UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaChat, StringToText("BANELINGS INCOMING"));
    APRG_PlayZagaraBanelingVO(player, g_aprgZagaraBanelingWaveIndex);
    UnitGroupAddUnitGroup(g_aprgZagaraBanelingUnits, spawnedBanelings);
    // Kick-start only one bounded retarget batch on the spawn frame.
    APRG_RetargetZagaraBanelings(player);
    g_aprgNextZagaraBanelingRetargetTime = now + 1.0;
    g_aprgNextZagaraBanelingTime += 600.0;
}


void APRG_GiveLurkerDefenseIfReady(int player) {
    unit home;
    unit u;
    unitgroup created;
    point p;
    string lurkerType;
    int i;
    fixed speed;

    if (g_aprgLurkerDefenseGiven || !APRG_PlayerMacroBaseReady(player)) { return; }
    home = APRG_FindPlayerHomeStructure(player);
    if (home == null) { return; }
    p = APRG_FindGroundPointNear(UnitGetPosition(home), 4.0, 10.0);
    if (p == null) { return; }

    lurkerType = "";
    if (CatalogEntryIsValid(c_gameCatalogUnit, "Lurker")) { lurkerType = "Lurker"; }
    else if (CatalogEntryIsValid(c_gameCatalogUnit, "LurkerMP")) { lurkerType = "LurkerMP"; }
    if (lurkerType != "") {
        created = APRG_CreatePlayerUnitsSafe(4, lurkerType, player, p, libNtve_gf_RandomAngle());
        i = UnitGroupCount(created, c_unitCountAlive);
        for (; i > 0; i -= 1) {
            u = UnitGroupUnitFromEnd(created, i);
            if (u == null) { break; }
            speed = UnitGetPropertyFixed(u, c_unitPropMovementSpeed, c_unitPropCurrent);
            if (speed > 0.0) { UnitSetPropertyFixed(u, c_unitPropMovementSpeed, speed * 0.5); }
        }
    }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "Impaler")) {
        created = APRG_CreatePlayerUnitsSafe(4, "Impaler", player, p, libNtve_gf_RandomAngle());
        i = UnitGroupCount(created, c_unitCountAlive);
        for (; i > 0; i -= 1) {
            u = UnitGroupUnitFromEnd(created, i);
            if (u == null) { break; }
            speed = UnitGetPropertyFixed(u, c_unitPropMovementSpeed, c_unitPropCurrent);
            if (speed > 0.0) { UnitSetPropertyFixed(u, c_unitPropMovementSpeed, speed * 0.5); }
        }
    }
    g_aprgLurkerDefenseGiven = true;
}

void APRG_ApplyCombatWorkers(int player) {
    unitgroup workers;
    unit u;
    int i;
    int weaponIndex;
    int weaponCount;
    string unitType;
    string weaponType;
    string effectType;
    string key;
    fixed oldMax;
    fixed oldCurrent;
    fixed ratio;
    fixed speed;

    workers = APRG_PlayerWorkers(player);
    i = UnitGroupCount(workers, c_unitCountAlive);
    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(workers, i);
        if (u == null) { break; }
        if (UnitGroupHasUnit(g_aprgCombatWorkersProcessed, u)) { continue; }
        unitType = UnitGetType(u);

        oldMax = UnitGetPropertyFixed(u, c_unitPropLifeMax, c_unitPropCurrent);
        oldCurrent = UnitGetPropertyFixed(u, c_unitPropLife, c_unitPropCurrent);
        if (oldMax > 0.0) {
            ratio = oldCurrent / oldMax;
            UnitSetPropertyFixed(u, c_unitPropLifeMax, oldMax * 3.0);
            UnitSetPropertyFixed(u, c_unitPropLife, oldMax * 3.0 * ratio);
        }
        oldMax = UnitGetPropertyFixed(u, c_unitPropShieldsMax, c_unitPropCurrent);
        oldCurrent = UnitGetPropertyFixed(u, c_unitPropShields, c_unitPropCurrent);
        if (oldMax > 0.0) {
            ratio = oldCurrent / oldMax;
            UnitSetPropertyFixed(u, c_unitPropShieldsMax, oldMax * 3.0);
            UnitSetPropertyFixed(u, c_unitPropShields, oldMax * 3.0 * ratio);
        }
        key = "APRG_CombatWorkerSpeed_" + IntToString(player) + "_" + unitType;
        if (!DataTableGetBool(true, key)) {
            speed = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "Speed", player));
            if (speed > 0.0) { CatalogFieldValueSet(c_gameCatalogUnit, unitType, "Speed", player, FixedToString(speed * 3.0, c_fixedPrecisionAny)); }
            DataTableSetBool(true, key, true);
        }

        weaponCount = UnitWeaponCount(u);
        for (weaponIndex = 1; weaponIndex <= weaponCount; weaponIndex += 1) {
            weaponType = UnitWeaponGet(u, weaponIndex);
            if (weaponType == "") { continue; }
            key = "APRG_CombatWorkerWeapon_" + IntToString(player) + "_" + weaponType;
            if (!DataTableGetBool(true, key)) {
                CatalogFieldValueModify(c_gameCatalogWeapon, weaponType, "Period", player, FixedToString(1.0 / 3.0, c_fixedPrecisionAny), c_upgradeOperationMultiply);
                DataTableSetBool(true, key, true);
            }
            effectType = CatalogFieldValueGet(c_gameCatalogWeapon, weaponType, "DisplayEffect", player);
            if (effectType == "" || !CatalogEntryIsValid(c_gameCatalogEffect, effectType)) { continue; }
            key = "APRG_CombatWorkerDamage_" + IntToString(player) + "_" + effectType;
            if (!DataTableGetBool(true, key)) {
                CatalogFieldValueModify(c_gameCatalogEffect, effectType, "Amount", player, "3.0", c_upgradeOperationMultiply);
                DataTableSetBool(true, key, true);
            }
        }
        UnitGroupAdd(g_aprgCombatWorkersProcessed, u);
    }
}

void APRG_ApplyEnemyRapidEvolution(int player) {
    unitgroup units;
    unit u;
    int i;
    fixed hp;
    fixed shields;
    units = APRG_EnemyMobileUnits(player);
    i = UnitGroupCount(units, c_unitCountAlive);
    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null) { break; }
        hp = UnitGetPropertyFixed(u, c_unitPropLifeMax, c_unitPropCurrent);
        if (hp > 0.0) { UnitSetPropertyFixed(u, c_unitPropLifeMax, hp + 1.0); }
        shields = UnitGetPropertyFixed(u, c_unitPropShieldsMax, c_unitPropCurrent);
        if (shields > 0.0) { UnitSetPropertyFixed(u, c_unitPropShieldsMax, shields + 1.0); }
    }
}

void APRG_ScaleUnitShields(unit u, fixed factor) {
    fixed maximum;
    fixed current;
    fixed ratio;
    fixed newMaximum;
    if (u == null || factor <= 0.0) { return; }
    maximum = UnitGetPropertyFixed(u, c_unitPropShieldsMax, c_unitPropCurrent);
    if (maximum <= 0.0) { return; }
    current = UnitGetPropertyFixed(u, c_unitPropShields, c_unitPropCurrent);
    ratio = current / maximum;
    newMaximum = MaxF(1.0, maximum * factor);
    UnitSetPropertyFixed(u, c_unitPropShieldsMax, newMaximum);
    UnitSetPropertyFixed(u, c_unitPropShields, MaxF(0.0, newMaximum * ratio));
}

void APRG_ApplyGlassCannons(int player) {
    unitgroup units;
    unit u;
    int i;
    int weaponIndex;
    int weaponCount;
    string weaponType;
    string effectType;
    string key;
    fixed oldMax;
    fixed oldCurrent;
    fixed ratio;

    units = APRG_PlayerMobileUnits(player);
    i = UnitGroupCount(units, c_unitCountAlive);
    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null) { break; }
        if (UnitGroupHasUnit(g_aprgGlassCannonsProcessed, u)) { continue; }
        oldMax = UnitGetPropertyFixed(u, c_unitPropLifeMax, c_unitPropCurrent);
        oldCurrent = UnitGetPropertyFixed(u, c_unitPropLife, c_unitPropCurrent);
        if (oldMax > 0.0) {
            ratio = oldCurrent / oldMax;
            UnitSetPropertyFixed(u, c_unitPropLifeMax, MaxF(1.0, oldMax * 0.65));
            UnitSetPropertyFixed(u, c_unitPropLife, MaxF(1.0, oldMax * 0.65) * ratio);
        }
        APRG_ScaleUnitShields(u, 0.65);
        weaponCount = UnitWeaponCount(u);
        for (weaponIndex = 1; weaponIndex <= weaponCount; weaponIndex += 1) {
            weaponType = UnitWeaponGet(u, weaponIndex);
            if (weaponType == "") { continue; }
            effectType = CatalogFieldValueGet(c_gameCatalogWeapon, weaponType, "DisplayEffect", player);
            if (effectType == "" || !CatalogEntryIsValid(c_gameCatalogEffect, effectType)) { continue; }
            key = "APRG_GlassDamage_" + IntToString(player) + "_" + effectType;
            if (!DataTableGetBool(true, key)) {
                CatalogFieldValueModify(c_gameCatalogEffect, effectType, "Amount", player, "2.0", c_upgradeOperationMultiply);
                DataTableSetBool(true, key, true);
            }
        }
        UnitGroupAdd(g_aprgGlassCannonsProcessed, u);
    }
}

void APRG_EnsureProtossResearchStructures(int player) {
    if (CatalogEntryIsValid(c_gameCatalogUnit, "Forge")) {
        TechTreeUnitAllow(player, "Forge", true);
    }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "CyberneticsCore")) {
        TechTreeUnitAllow(player, "CyberneticsCore", true);
    }
}

// Player Odins (including the blessing and bottled consumable) should never
// have a nuclear strike.  Do not alter the enemy Odin mutation.
void APRG_RemovePlayerOdinNuclearStrike(unit odin, int player) {
    string unitType;
    string abilityType;
    string path;
    string face;
    string command;
    int abilityIndex;
    int cardIndex;
    int buttonIndex;
    int cardCount;
    int buttonCount;
    if (odin == null || !UnitIsAlive(odin) || UnitGetOwner(odin) != player) { return; }
    unitType = UnitGetType(odin);
    if (!StringContains(unitType, "Odin", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Wreckage", c_stringAnywhere, c_stringNoCase)) { return; }

    // Strip the native campaign ability explicitly, then handle possible
    // AP/mission variants by inspecting the unit's actual ability list.
    if (UnitAbilityExists(odin, "OdinNuclearStrike")) {
        UnitAbilityShow(odin, "OdinNuclearStrike", false);
        UnitAbilityEnable(odin, "OdinNuclearStrike", false);
        UnitAbilityRemove(odin, "OdinNuclearStrike");
    }
    for (abilityIndex = MinI(64, UnitAbilityCount(odin)); abilityIndex > 0; abilityIndex -= 1) {
        abilityType = UnitAbilityGet(odin, abilityIndex);
        if (abilityType == "" ||
            (!StringContains(abilityType, "Nuke", c_stringAnywhere, c_stringNoCase) &&
             !StringContains(abilityType, "Nuclear", c_stringAnywhere, c_stringNoCase))) { continue; }
        UnitAbilityShow(odin, abilityType, false);
        UnitAbilityEnable(odin, abilityType, false);
        UnitAbilityRemove(odin, abilityType);
    }

    // Hide command-card buttons as well as removing the abilities, using the
    // owning player's catalog scope only.  Never modify enemy Odin cards.
    cardCount = MinI(8, CatalogFieldValueCount(c_gameCatalogUnit, unitType, "CardLayouts", player));
    if (cardCount < 1) { cardCount = 1; }
    for (cardIndex = 0; cardIndex < cardCount; cardIndex += 1) {
        path = "CardLayouts[" + IntToString(cardIndex) + "].LayoutButtons";
        buttonCount = MinI(64, CatalogFieldValueCount(c_gameCatalogUnit, unitType, path, player));
        for (buttonIndex = 0; buttonIndex < buttonCount; buttonIndex += 1) {
            face = CatalogFieldValueGet(c_gameCatalogUnit, unitType, path + "[" + IntToString(buttonIndex) + "].Face", player);
            command = CatalogFieldValueGet(c_gameCatalogUnit, unitType, path + "[" + IntToString(buttonIndex) + "].AbilCmd", player);
            if (!StringContains(face, "Nuke", c_stringAnywhere, c_stringNoCase) &&
                !StringContains(face, "Nuclear", c_stringAnywhere, c_stringNoCase) &&
                !StringContains(command, "Nuke", c_stringAnywhere, c_stringNoCase) &&
                !StringContains(command, "Nuclear", c_stringAnywhere, c_stringNoCase)) { continue; }
            CatalogFieldValueSet(c_gameCatalogUnit, unitType, path + "[" + IntToString(buttonIndex) + "].Face", player, "");
            CatalogFieldValueSet(c_gameCatalogUnit, unitType, path + "[" + IntToString(buttonIndex) + "].Type", player, "");
            CatalogFieldValueSet(c_gameCatalogUnit, unitType, path + "[" + IntToString(buttonIndex) + "].AbilCmd", player, "");
        }
    }
}

void APRG_TickPlayerOdinNoNukes(int player, fixed now) {
    unitgroup owned;
    unit candidate;
    int i;
    if (now < g_aprgNextPlayerOdinNukeCheckTime) { return; }
    g_aprgNextPlayerOdinNukeCheckTime = now + 3.0;
    owned = APRG_PlayerAllUnits(player);
    for (i = UnitGroupCount(owned, c_unitCountAlive); i > 0; i -= 1) {
        candidate = UnitGroupUnitFromEnd(owned, i);
        if (candidate == null || !UnitIsAlive(candidate)) { continue; }
        if (!StringContains(UnitGetType(candidate), "Odin", c_stringAnywhere, c_stringNoCase)) { continue; }
        APRG_RemovePlayerOdinNuclearStrike(candidate, player);
    }
}

void APRG_GiveOdinIfReady(int player) {
    unit home;
    point p;
    unitgroup created;
    if (g_aprgOdinGiven || !APRG_PlayerMacroBaseReady(player)) { return; }
    if (!CatalogEntryIsValid(c_gameCatalogUnit, "Odin")) { return; }
    home = APRG_FindPlayerHomeStructure(player);
    if (home == null) { return; }
    p = APRG_PlayerBuildingSpawnPoint(player, UnitGetPosition(home), 5.0, 12.0);
    if (p == null) { return; }
    created = APRG_CreatePlayerUnitsSafe(1, "Odin", player, p, libNtve_gf_RandomAngle());
    APRG_RemovePlayerOdinNuclearStrike(UnitGroupUnitFromEnd(created, 1), player);
    APRG_RegisterGeneratedHeroGroup(created);
    g_aprgOdinGiven = true;
}

bool APRG_IsWidowMineType(string unitType) {
    return unitType != "" && StringContains(unitType, "WidowMine", c_stringAnywhere, c_stringNoCase);
}

void APRG_ApplyBuildingOvercharge(int player) {
    unitgroup structures;
    unitgroup created;
    int i;
    int slot;
    unit u;
    unit proxy;
    point p;
    string proxyType = "";

    if (CatalogEntryIsValid(c_gameCatalogUnit, "PylonOvercharged")) { proxyType = "PylonOvercharged"; }
    else if (CatalogEntryIsValid(c_gameCatalogUnit, "Battlecruiser")) { proxyType = "Battlecruiser"; }
    if (proxyType == "") { return; }
    for (slot = 0; slot < g_aprgBuildingOverchargeCount; slot += 1) {
        u = g_aprgBuildingOverchargeSource[slot];
        proxy = g_aprgBuildingOverchargeProxy[slot];
        if (u != null && UnitIsAlive(u) && (APRG_IsWidowMineType(UnitGetType(u)) || APRG_IsSpiderMineType(UnitGetType(u)))) {
            if (proxy != null && UnitIsAlive(proxy)) { UnitRemove(proxy); }
            UnitGroupRemove(g_aprgBuildingOverchargeProcessed, u);
            g_aprgBuildingOverchargeSource[slot] = null;
            g_aprgBuildingOverchargeProxy[slot] = null;
            continue;
        }
        if (u != null && UnitIsAlive(u) && proxy != null && UnitIsAlive(proxy)) {
            UnitSetPosition(proxy, UnitGetPosition(u), true);
            if (UnitGetType(proxy) == "Battlecruiser") {
                UnitSetHeight(proxy, UnitGetHeight(u) + 0.25, 0.0);
            }
            UnitSetState(proxy, c_unitStateInvulnerable, true);
            UnitSetState(proxy, c_unitStateTargetable, false);
            UnitSetState(proxy, c_unitStateSelectable, false);
            UnitSelect(proxy, player, false);
        }
        else if ((u == null || !UnitIsAlive(u)) && proxy != null && UnitIsAlive(proxy)) {
            UnitRemove(proxy);
            g_aprgBuildingOverchargeProxy[slot] = null;
        }
        else if (u != null && UnitIsAlive(u) && (proxy == null || !UnitIsAlive(proxy))) {
            UnitGroupRemove(g_aprgBuildingOverchargeProcessed, u);
            g_aprgBuildingOverchargeSource[slot] = null;
            g_aprgBuildingOverchargeProxy[slot] = null;
        }
    }
    structures = APRG_PlayerStructures(player);
    i = UnitGroupCount(structures, c_unitCountAlive);
    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(structures, i);
        if (u == null) { break; }
        if ((APRG_IsWidowMineType(UnitGetType(u)) || APRG_IsSpiderMineType(UnitGetType(u)))) { continue; }
        if (UnitGroupHasUnit(g_aprgBuildingOverchargeProcessed, u)) { continue; }
        if (g_aprgBuildingOverchargeCount >= 256) { return; }
        p = UnitGetPosition(u);
        created = UnitCreate(1, proxyType, c_unitCreateIgnorePlacement, player, p, 270.0);
        if (created == null || UnitGroupCount(created, c_unitCountAlive) <= 0) { continue; }
        proxy = UnitGroupUnitFromEnd(created, 1);
        if (proxy == null) { continue; }
        UnitSetState(proxy, c_unitStateUsingSupply, false);
        // Crew must never adopt this graphical turret proxy as a real BC.
        // Keep it invulnerable and mark with one point of MAX life so the
        // observation bridge can recognize it independently of commandability.
        if (UnitGetType(proxy) == "Battlecruiser") {
            UnitSetPropertyFixed(proxy, c_unitPropLifeMax, 1.0);
            UnitSetPropertyFixed(proxy, c_unitPropLife, 1.0);
        }
        UnitSetState(proxy, c_unitStateInvulnerable, true);
        UnitSetState(proxy, c_unitStateTargetable, false);
        UnitSetState(proxy, c_unitStateSelectable, false);
        libNtve_gf_MakeUnitUncommandable(proxy, true);
        UnitSelect(proxy, player, false);
        UnitSetPropertyFixed(proxy, c_unitPropMovementSpeed, 0.0);
        UnitSetPropertyFixed(proxy, c_unitPropEnergyMax, 0.0);
        UnitSetPropertyFixed(proxy, c_unitPropEnergy, 0.0);
        UnitSetPropertyFixed(proxy, c_unitPropEnergyRegen, 0.0);
        UnitSetScale(proxy, 0.05, 0.05, 0.05);
        if (UnitGetType(proxy) == "Battlecruiser") {
            UnitSetHeight(proxy, UnitGetHeight(u) + 0.25, 0.0);
        }
        g_aprgBuildingOverchargeSource[g_aprgBuildingOverchargeCount] = u;
        g_aprgBuildingOverchargeProxy[g_aprgBuildingOverchargeCount] = proxy;
        g_aprgBuildingOverchargeCount += 1;
        UnitGroupAdd(g_aprgBuildingOverchargeProcessed, u);
    }
}

void APRG_GiveGhostReportingIfReady(int player) {
    unit home;
    point p;
    point academyPoint;
    unitgroup created;
    unitgroup ghosts;
    unit ghost;
    int i;
    if (g_aprgGhostReportingGiven || !APRG_PlayerMacroBaseReady(player)) { return; }
    if (!CatalogEntryIsValid(c_gameCatalogUnit, "Ghost") || !CatalogEntryIsValid(c_gameCatalogUnit, "GhostAcademy")) { return; }
    home = APRG_FindPlayerHomeStructure(player);
    if (home == null) { return; }
    p = APRG_FindGroundPointNear(UnitGetPosition(home), 4.0, 10.0);
    academyPoint = APRG_PlayerBuildingSpawnPoint(player, UnitGetPosition(home), 7.0, 14.0);
    if (p == null || academyPoint == null) { return; }
    ghosts = APRG_CreatePlayerUnitsVanillaSafe(3, "Ghost", player, p, libNtve_gf_RandomAngle());
    if (CatalogEntryIsValid(c_gameCatalogAbil, "GhostCloak")) {
        TechTreeAbilityAllow(player, AbilityCommand("GhostCloak", 0), true);
        for (i = UnitGroupCount(ghosts, c_unitCountAlive); i > 0; i -= 1) {
            ghost = UnitGroupUnitFromEnd(ghosts, i);
            if (ghost == null) { break; }
            UnitAbilityAdd(ghost, "GhostCloak");
            UnitAbilityShow(ghost, "GhostCloak", true);
            UnitAbilityEnable(ghost, "GhostCloak", true);
        }
    }
    created = APRG_CreatePlayerUnitsVanillaSafe(1, "GhostAcademy", player, academyPoint, libNtve_gf_RandomAngle());
    g_aprgGhostReportingAcademy = UnitGroupUnitFromEnd(created, 1);
    if (g_aprgGhostReportingAcademy != null) {
        UnitMagazineArm(g_aprgGhostReportingAcademy, AbilityCommand("ArmSiloWithNuke", 0), 1);
        g_aprgGhostReportingGiven = true;
    }
}

void APRG_TickGhostReporting(int player) {
    int count;
    if (!g_aprgGhostReportingGiven) { APRG_GiveGhostReportingIfReady(player); }
    if (g_aprgGhostReportingAcademy == null || !UnitIsAlive(g_aprgGhostReportingAcademy)) { return; }
    count = UnitMagazineCount(g_aprgGhostReportingAcademy, "ArmSiloWithNuke");
    if (count < 1) {
        UnitMagazineArm(g_aprgGhostReportingAcademy, AbilityCommand("ArmSiloWithNuke", 0), 1);
    }
}

string APRG_TaldarimMothershipType() {
    if (CatalogEntryIsValid(c_gameCatalogUnit, "Flagship")) { return "Flagship"; }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "SOAMothershipv4")) { return "SOAMothershipv4"; }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "TalDarimMothership")) { return "TalDarimMothership"; }
    return "";
}

unit APRG_RandomTaldarimTarget(int player) {
    unitgroup structures;
    int count;
    structures = APRG_PlayerStructures(player);
    count = UnitGroupCount(structures, c_unitCountAlive);
    if (count <= 0) { return null; }
    return UnitGroupUnitFromEnd(structures, RandomInt(1, count));
}

void APRG_OrderTaldarimUnit(unit u, int player) {
    unit target;
    if (u == null || !UnitIsAlive(u)) { return; }
    target = APRG_RandomTaldarimTarget(player);
    if (target == null) { return; }
    APRG_OrderAttackMove(u, UnitGetPosition(target));
}

void APRG_RegisterTaldarimGroup(unitgroup created, int player) {
    int i;
    unit u;
    if (created == null) { return; }
    for (i = UnitGroupCount(created, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(created, i);
        if (u == null) { continue; }
        UnitGroupAdd(g_aprgTaldarimRaiders, u);
        APRG_OrderTaldarimUnit(u, player);
    }
}

void APRG_AddTaldarimGroup(int player, string unitType, int minimumCount, int maximumCount, bool air, bool halfWave) {
    int count;
    int owner;
    point p;
    unitgroup created;
    if (unitType == "" || !CatalogEntryIsValid(c_gameCatalogUnit, unitType)) { return; }
    if (air) { p = APRG_FindRaidOriginAirPoint(player); }
    else { p = APRG_FindRaidOriginGroundPoint(player); }
    if (p == null) { return; }
    owner = APRG_FindHostileOwnerNearPoint(player, p);
    if (owner < 0) { return; }
    count = RandomInt(minimumCount, maximumCount);
    if (halfWave) { count = MaxI(1, (count + 1) / 2); }
    created = UnitCreate(count, unitType, c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
    APRG_RegisterTaldarimGroup(created, player);
}

void APRG_SpawnTaldarimWave(int player, bool halfWave) {
    point alarakPoint;
    int alarakOwner;
    string mothershipType;
    string alarakType;
    unitgroup alarakGroup;
    mothershipType = APRG_TaldarimMothershipType();
    APRG_AddTaldarimGroup(player, mothershipType, 1, 4, true, halfWave);
    APRG_AddTaldarimGroup(player, "AP_Supplicant", 25, 35, false, halfWave);
    APRG_AddTaldarimGroup(player, "StalkerTaldarim", 15, 20, false, halfWave);
    APRG_AddTaldarimGroup(player, "DarkTemplarTaldarim", 2, 10, false, halfWave);
    APRG_AddTaldarimGroup(player, "HighTemplarTaldarim", 2, 10, false, halfWave);
    APRG_AddTaldarimGroup(player, "Monitor", 5, 15, false, halfWave);
    APRG_AddTaldarimGroup(player, "ImmortalTaldarim", 5, 10, false, halfWave);
    APRG_AddTaldarimGroup(player, "ColossusTaldarim", 3, 8, false, halfWave);
    APRG_AddTaldarimGroup(player, "VoidRayTaldarim", 5, 10, true, halfWave);
    alarakType = APRG_AlarakHeroType();
    if (!g_aprgTaldarimAlarakSpawned && alarakType != "") {
        alarakPoint = APRG_FindRaidOriginGroundPoint(player);
        if (alarakPoint != null) {
            alarakOwner = APRG_FindHostileOwnerNearPoint(player, alarakPoint);
            if (alarakOwner >= 0) {
                alarakGroup = UnitCreate(1, alarakType, c_unitCreateIgnorePlacement, alarakOwner, alarakPoint, libNtve_gf_RandomAngle());
                APRG_RegisterGeneratedHeroGroup(alarakGroup);
                APRG_RegisterTaldarimGroup(alarakGroup, player);
                g_aprgTaldarimAlarakSpawned = true;
            }
        }
    }
}

void APRG_RetargetTaldarimRaiders(int player, fixed now) {
    int i;
    unit u;
    if (g_aprgTaldarimRaiders == null || now < g_aprgNextTaldarimRetargetTime) { return; }
    g_aprgNextTaldarimRetargetTime = now + 30.0;
    for (i = UnitGroupCount(g_aprgTaldarimRaiders, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(g_aprgTaldarimRaiders, i);
        APRG_OrderTaldarimUnit(u, player);
    }
}

void APRG_TickTaldarimReinforcements(int player, fixed now) {
    if (!APRG_PlayerMacroBaseReady(player) || now < 1200.0) { return; }
    if (!g_aprgTaldarimAnnounced) {
        UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaChat, StringToText("[Slay] The Tal'Darim have arrived"));
        g_aprgTaldarimAnnounced = true;
        g_aprgNextTaldarimWaveTime = now;
        g_aprgNextTaldarimRetargetTime = now + 30.0;
    }
    if (now >= g_aprgNextTaldarimWaveTime) {
        APRG_SpawnTaldarimWave(player, g_aprgTaldarimWaveIndex > 0);
        g_aprgTaldarimWaveIndex += 1;
        g_aprgNextTaldarimWaveTime = now + 60.0;
    }
    APRG_RetargetTaldarimRaiders(player, now);
}


void APRG_ApplyGloriousMartyrs(point deathPoint, int player) {
    unitgroup nearby;
    int i;
    unit u;
    if (deathPoint == null || !CatalogEntryIsValid(c_gameCatalogBehavior, "APRogueGloriousMartyrStack")) { return; }
    nearby = UnitGroupAlliance(
        player,
        c_unitAllianceAlly,
        RegionCircle(deathPoint, 4.0),
        UnitFilter(
            0,
            0,
            (1 << c_targetFilterStructure) | (1 << c_targetFilterMissile),
            (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))
        ),
        0
    );
    for (i = UnitGroupCount(nearby, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(nearby, i);
        if (u == null || UnitGetOwner(u) != player) { continue; }
        UnitBehaviorAdd(u, "APRogueGloriousMartyrStack", u, 1);
    }
}

void APRG_TickGloriousMartyrs() {
    return;
}

int APRG_FindInflatableSlot(unit u) {
    int i;
    int freeSlot = -1;
    if (u == null) { return -1; }
    for (i = 0; i < APRG_MAX_INFLATABLE_UNITS; i += 1) {
        if (g_aprgInflatableUnits[i] == u) { return i; }
        if (freeSlot < 0 && g_aprgInflatableUnits[i] == null) { freeSlot = i; }
    }
    if (freeSlot >= 0) {
        g_aprgInflatableUnits[freeSlot] = u;
        g_aprgInflatableStacks[freeSlot] = 0;
        g_aprgInflatableBaseSpeed[freeSlot] = UnitGetPropertyFixed(u, c_unitPropMovementSpeed, c_unitPropCurrent);
    }
    return freeSlot;
}

void APRG_InflatableApplyWeaponStack(unit u, int stack, int player) {
    int wi;
    int j;
    int weaponCount;
    string weaponType;
    string effectType;
    string key;
    fixed damageBonus = 0.25;
    fixed previousBonus = 0.0;
    fixed stepBonus;
    fixed currentAmount;
    fixed baseAmount;
    if (stack > 10) {
        for (wi = 10; wi < stack; wi += 1) { damageBonus *= 0.5; }
    }
    for (j = 1; j < stack; j += 1) {
        stepBonus = 0.25;
        if (j > 10) {
            for (wi = 10; wi < j; wi += 1) { stepBonus *= 0.5; }
        }
        previousBonus += stepBonus;
    }
    weaponCount = UnitWeaponCount(u);
    for (wi = 1; wi <= weaponCount; wi += 1) {
        weaponType = UnitWeaponGet(u, wi);
        if (weaponType == "" || !CatalogEntryIsValid(c_gameCatalogWeapon, weaponType)) { continue; }
        key = "APRG_InflatableRange_" + IntToString(player) + "_" + weaponType + "_" + IntToString(stack);
        if (!DataTableGetBool(true, key)) {
            CatalogFieldValueModify(c_gameCatalogWeapon, weaponType, "Range", player, "0.1", c_upgradeOperationAdd);
            effectType = CatalogFieldValueGet(c_gameCatalogWeapon, weaponType, "DisplayEffect", player);
            if (effectType != "" && CatalogEntryIsValid(c_gameCatalogEffect, effectType)) {
                currentAmount = StringToFixed(CatalogFieldValueGet(c_gameCatalogEffect, effectType, "Amount", player));
                if (currentAmount > 0.0) {
                    baseAmount = currentAmount / (1.0 + previousBonus);
                    CatalogFieldValueSet(c_gameCatalogEffect, effectType, "Amount", player, FixedToString(currentAmount + baseAmount * damageBonus, c_fixedPrecisionAny));
                }
            }
            DataTableSetBool(true, key, true);
        }
    }
}

void APRG_ApplyInflatableStack(unit u, int slot, int player) {
    int stack;
    fixed oldMax;
    fixed life;
    fixed ratio;
    fixed oldShieldMax;
    fixed shields;
    fixed shieldRatio;
    fixed speed;
    fixed minimumSpeed;
    fixed visualScale;
    if (u == null || !UnitIsAlive(u) || slot < 0) { return; }
    stack = g_aprgInflatableStacks[slot] + 1;
    if (stack > 300) { return; }
    g_aprgInflatableStacks[slot] = stack;

    oldMax = UnitGetPropertyFixed(u, c_unitPropLifeMax, c_unitPropCurrent);
    life = UnitGetPropertyFixed(u, c_unitPropLife, c_unitPropCurrent);
    if (oldMax > 0.0) {
        ratio = life / oldMax;
        oldMax = oldMax / (1.0 + 0.15 * IntToFixed(stack - 1));
        UnitSetPropertyFixed(u, c_unitPropLifeMax, oldMax * (1.0 + 0.15 * IntToFixed(stack)));
        UnitSetPropertyFixed(u, c_unitPropLife, oldMax * (1.0 + 0.15 * IntToFixed(stack)) * ratio);
    }
    oldShieldMax = UnitGetPropertyFixed(u, c_unitPropShieldsMax, c_unitPropCurrent);
    shields = UnitGetPropertyFixed(u, c_unitPropShields, c_unitPropCurrent);
    if (oldShieldMax > 0.0) {
        shieldRatio = shields / oldShieldMax;
        oldShieldMax = oldShieldMax / (1.0 + 0.15 * IntToFixed(stack - 1));
        UnitSetPropertyFixed(u, c_unitPropShieldsMax, oldShieldMax * (1.0 + 0.15 * IntToFixed(stack)));
        UnitSetPropertyFixed(u, c_unitPropShields, oldShieldMax * (1.0 + 0.15 * IntToFixed(stack)) * shieldRatio);
    }

    APRG_InflatableApplyWeaponStack(u, stack, player);

    speed = UnitGetPropertyFixed(u, c_unitPropMovementSpeed, c_unitPropCurrent);
    minimumSpeed = g_aprgInflatableBaseSpeed[slot] * 0.05;
    if (stack < 20 && speed > minimumSpeed) {
        speed = speed * 0.955;
        if (speed < minimumSpeed) { speed = minimumSpeed; }
        UnitSetPropertyFixed(u, c_unitPropMovementSpeed, speed);
    }
    else if (stack >= 20 && minimumSpeed > 0.0) {
        UnitSetPropertyFixed(u, c_unitPropMovementSpeed, minimumSpeed);
    }
    if (APRG_HasExtension(APRG_EXT_BLESS_HORDE_MODE)) {
        visualScale = MinF(300.0, 50.0 + IntToFixed(stack) * 2.5);
    }
    else {
        visualScale = MinF(300.0, 100.0 + IntToFixed(stack) * 5.0);
    }
    UnitSetScale(u, visualScale, visualScale, visualScale);
}

void APRG_TickInflatableSoldiers(int player, fixed now) {
    unitgroup units;
    int i;
    unit u;
    int slot;
    if (!APRG_PlayerMacroBaseReady(player) || now < g_aprgNextInflatableTime) { return; }
    g_aprgNextInflatableTime = now + 12.0;
    units = APRG_PlayerMobileUnits(player);
    for (i = UnitGroupCount(units, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null || UnitGetOwner(u) != player || APRG_IsWorkerTypeForDeath(UnitGetType(u))) { continue; }
        slot = APRG_FindInflatableSlot(u);
        if (slot >= 0) { APRG_ApplyInflatableStack(u, slot, player); }
    }
}

void APRG_ApplyDoubleTimeGroup(unitgroup units) {
    int i;
    int owner;
    int weaponIndex;
    int weaponCount;
    unit u;
    string unitType;
    string unitKey;
    string weaponType;
    string weaponKey;
    fixed speed;
    fixed period;
    for (i = UnitGroupCount(units, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null) { continue; }
        owner = UnitGetOwner(u);
        if (owner < 0) { continue; }
        unitType = UnitGetType(u);
        unitKey = "APRG_DoubleTimeCatalog_" + IntToString(owner) + "_" + unitType;
        if (!DataTableGetBool(true, unitKey)) {
            speed = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "Speed", owner));
            if (speed > 0.0) {
                CatalogFieldValueSet(c_gameCatalogUnit, unitType, "Speed", owner, FixedToString(speed * 2.0, c_fixedPrecisionAny));
            }
            DataTableSetBool(true, unitKey, true);
        }
        weaponCount = UnitWeaponCount(u);
        for (weaponIndex = 1; weaponIndex <= weaponCount; weaponIndex += 1) {
            weaponType = UnitWeaponGet(u, weaponIndex);
            if (weaponType == "") { continue; }
            weaponKey = "APRG_DoubleTimeWeapon_" + IntToString(owner) + "_" + weaponType;
            if (DataTableGetBool(true, weaponKey)) { continue; }
            period = StringToFixed(CatalogFieldValueGet(c_gameCatalogWeapon, weaponType, "Period", owner));
            if (period > 0.0) {
                CatalogFieldValueSet(c_gameCatalogWeapon, weaponType, "Period", owner, FixedToString(period * 0.5, c_fixedPrecisionAny));
            }
            DataTableSetBool(true, weaponKey, true);
        }
    }
}

void APRG_ApplyDoubleTime(int player) {
    APRG_ApplyDoubleTimeGroup(APRG_PlayerAllUnits(player));
    APRG_ApplyDoubleTimeGroup(APRG_EnemyAllUnits(player));
}

fixed APRG_ShrinkageFactor(int stacks) {
    if (stacks <= 0) { return 1.0; }
    if (stacks >= 50) { return 0.5; }
    return 1.0 - 0.01 * IntToFixed(stacks);
}

int APRG_FindShrinkageSlot(unit u, fixed now) {
    int i;
    int freeSlot = -1;
    unit existing;
    if (u == null) { return -1; }
    for (i = 0; i < APRG_MAX_SHRINKAGE_UNITS; i += 1) {
        existing = g_aprgShrinkageUnits[i];
        if (existing == u) { return i; }
        if (existing != null && !UnitIsAlive(existing)) {
            g_aprgShrinkageUnits[i] = null;
            g_aprgShrinkageUnitStacks[i] = 0;
            g_aprgShrinkageNextStackTime[i] = 0.0;
            existing = null;
        }
        if (freeSlot < 0 && existing == null) { freeSlot = i; }
    }
    if (freeSlot >= 0) {
        g_aprgShrinkageUnits[freeSlot] = u;
        g_aprgShrinkageUnitStacks[freeSlot] = 0;
        g_aprgShrinkageNextStackTime[freeSlot] = now + 6.0;
        UnitSetScale(u, 100.0, 100.0, 100.0);
    }
    return freeSlot;
}

void APRG_ApplyShrinkageUnitStack(unit u, int slot) {
    int oldStacks;
    int newStacks;
    fixed oldFactor;
    fixed newFactor;
    fixed stepFactor;
    fixed oldMax;
    fixed newMax;
    fixed life;
    fixed lifeRatio;
    fixed speed;
    fixed visualScale;
    if (u == null || !UnitIsAlive(u) || slot < 0 || g_aprgShrinkageUnitStacks[slot] >= 50) { return; }
    oldStacks = g_aprgShrinkageUnitStacks[slot];
    newStacks = oldStacks + 1;
    oldFactor = APRG_ShrinkageFactor(oldStacks);
    newFactor = APRG_ShrinkageFactor(newStacks);
    stepFactor = newFactor / oldFactor;

    oldMax = UnitGetPropertyFixed(u, c_unitPropLifeMax, c_unitPropCurrent);
    life = UnitGetPropertyFixed(u, c_unitPropLife, c_unitPropCurrent);
    if (oldMax > 0.0) {
        lifeRatio = life / oldMax;
        newMax = MaxF(1.0, oldMax * stepFactor);
        UnitSetPropertyFixed(u, c_unitPropLifeMax, newMax);
        UnitSetPropertyFixed(u, c_unitPropLife, MaxF(1.0, newMax * lifeRatio));
    }
    APRG_ScaleUnitShields(u, stepFactor);
    speed = UnitGetPropertyFixed(u, c_unitPropMovementSpeed, c_unitPropCurrent);
    if (speed > 0.0) { UnitSetPropertyFixed(u, c_unitPropMovementSpeed, speed * stepFactor); }
    if (CatalogEntryIsValid(c_gameCatalogBehavior, "APRogueShrinkageCombatStack")) {
        UnitBehaviorAdd(u, "APRogueShrinkageCombatStack", u, 1);
    }
    g_aprgShrinkageUnitStacks[slot] = newStacks;
    visualScale = 100.0 * newFactor;
    UnitSetScale(u, visualScale, visualScale, visualScale);
}

void APRG_TickShrinkage(int player, fixed now) {
    unitgroup units;
    int i;
    int slot;
    unit u;
    units = UnitGroup(
        null,
        player,
        RegionPlayableMap(),
        UnitFilter(
            0,
            0,
            (1 << c_targetFilterStructure) | (1 << c_targetFilterWorker) | (1 << c_targetFilterMissile),
            (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))
        ),
        0
    );
    for (i = UnitGroupCount(units, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null || UnitGetOwner(u) != player) { continue; }
        slot = APRG_FindShrinkageSlot(u, now);
        if (slot < 0) { continue; }
        while (g_aprgShrinkageUnitStacks[slot] < 50 && now >= g_aprgShrinkageNextStackTime[slot]) {
            APRG_ApplyShrinkageUnitStack(u, slot);
            g_aprgShrinkageNextStackTime[slot] += 6.0;
        }
    }
}

unit APRG_FindMineralThiefTarget(int player) {
    unitgroup resources;
    unitgroup candidates = UnitGroupEmpty();
    unitgroup workers = APRG_PlayerWorkers(player);
    unitgroup structures = APRG_PlayerStructures(player);
    int i;
    unit u;
    unit nearest;
    point p;
    resources = UnitGroup(
        null,
        c_playerAny,
        RegionPlayableMap(),
        UnitFilter(
            (1 << c_targetFilterHarvestableResource),
            0,
            (1 << c_targetFilterMissile),
            (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))
        ),
        0
    );
    for (i = UnitGroupCount(resources, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(resources, i);
        if (u == null) { continue; }
        if (CatalogFieldValueGet(c_gameCatalogUnit, UnitGetType(u), "ResourceType", c_playerAny) != "Minerals") { continue; }
        p = UnitGetPosition(u);
        nearest = UnitGroupClosestToPoint(workers, p);
        if (nearest != null && DistanceBetweenPoints(p, UnitGetPosition(nearest)) <= 12.0) {
            UnitGroupAdd(candidates, u);
            continue;
        }
        nearest = UnitGroupClosestToPoint(structures, p);
        if (nearest != null && DistanceBetweenPoints(p, UnitGetPosition(nearest)) <= 18.0) {
            UnitGroupAdd(candidates, u);
        }
    }
    if (UnitGroupCount(candidates, c_unitCountAlive) <= 0) { return null; }
    return UnitGroupRandomUnit(candidates, c_unitCountAlive);
}

fixed APRG_MineralThiefMaxCooldown(fixed now) {
    fixed maximum = 30.0 - 3.0 * IntToFixed(FixedToInt(APRG_TimeSinceMacroBase(now) / 60.0));
    return MaxF(2.0, maximum);
}

void APRG_TickMineralThieves(int player, fixed now) {
    unit target;
    point targetPoint;
    point spawnPoint;
    int owner;
    int amount;
    fixed maximum;
    if (now < g_aprgNextMineralThiefTime || !APRG_PlayerMacroBaseReady(player)) { return; }
    target = APRG_FindMineralThiefTarget(player);
    maximum = APRG_MineralThiefMaxCooldown(now);
    g_aprgNextMineralThiefTime = now + RandomFixed(1.0, maximum);
    if (target == null || !CatalogEntryIsValid(c_gameCatalogUnit, "MULE")) { return; }
    targetPoint = UnitGetPosition(target);
    spawnPoint = APRG_FindGroundPointNear(targetPoint, 1.0, 3.0);
    if (spawnPoint == null) { spawnPoint = targetPoint; }
    owner = APRG_FindHostileOwnerNearPoint(player, targetPoint);
    if (owner < 0) { return; }
    if (!APRG_QueueRealDropPod(APRG_DROP_KIND_MINERAL_THIEF, owner, spawnPoint, target)
        && CatalogEntryIsValid(c_gameCatalogEffect, "AP_CalldownMULECreateUnit")) {
        PlayerCreateEffectUnit(owner, "AP_CalldownMULECreateUnit", target);
    }
    amount = UnitGetPropertyInt(target, c_unitPropResources, c_unitPropCurrent);
    if (amount > 0) { UnitSetPropertyInt(target, c_unitPropResources, MaxI(0, amount - 30)); }
}

int APRG_FindActiveEnemySlot(unit u, fixed now) {
    int i;
    int freeSlot = -1;
    unit existing;
    if (u == null) { return -1; }
    for (i = 0; i < APRG_MAX_ACTIVE_ENEMIES; i += 1) {
        existing = g_aprgActiveEnemyUnits[i];
        if (existing == u) { return i; }
        if (existing != null && !UnitIsAlive(existing)) {
            g_aprgActiveEnemyUnits[i] = null;
            g_aprgActiveEnemyNextTime[i] = 0.0;
            existing = null;
        }
        if (freeSlot < 0 && existing == null) { freeSlot = i; }
    }
    if (freeSlot >= 0) {
        g_aprgActiveEnemyUnits[freeSlot] = u;
        g_aprgActiveEnemyNextTime[freeSlot] = 0.0;
    }
    return freeSlot;
}

void APRG_AssignActiveEnemyPatrol(unit u) {
    point destination;
    point origin;
    if (u == null || !UnitIsAlive(u)) { return; }
    AISetUnitScriptControlled(u, false);
    if (APRG_TimeSinceMacroBase(GameGetMissionTime()) < 360.0) {
        destination = APRG_GroundSafePatrolDestination(u, APRG_GetPrimaryPlayer(), 15.0);
    }
    else { destination = APRG_FindRandomGroundPoint(); }
    if (destination == null) { return; }
    origin = UnitGetPosition(u);
    UnitIssueOrder(u, OrderTargetingPoint(AbilityCommand("attack", 0), destination), c_orderQueueReplace);
    UnitIssueOrder(u, OrderTargetingPoint(AbilityCommand("attack", 0), origin), c_orderQueueAddToEnd);
    UnitIssueOrder(u, OrderTargetingPoint(AbilityCommand("attack", 0), destination), c_orderQueueAddToEnd);
    UnitIssueOrder(u, OrderTargetingPoint(AbilityCommand("attack", 0), origin), c_orderQueueAddToEnd);
}

void APRG_TickActiveEnemies(int player, fixed now) {
    unitgroup enemies;
    int i;
    int scanned;
    int slot;
    int chosenSlot = -1;
    unit u;
    fixed speed;
    if (!APRG_PlayerMacroBaseReady(player) || now < g_aprgMacroReadyTime + 180.0) { return; }

    if (now >= g_aprgNextActiveEnemyScanTime) {
        g_aprgNextActiveEnemyScanTime = now + 5.0;
        enemies = APRG_EnemyMobileUnits(player);
        for (i = UnitGroupCount(enemies, c_unitCountAlive); i > 0; i -= 1) {
            u = UnitGroupUnitFromEnd(enemies, i);
            if (u == null || APRG_IsScriptedPurifier(u)) { continue; }
            speed = UnitGetPropertyFixed(u, c_unitPropMovementSpeed, c_unitPropCurrent);
            if (speed <= 0.0) { continue; }
            APRG_FindActiveEnemySlot(u, now);
        }
    }

    if (now < g_aprgNextActiveEnemyOrderTime) { return; }
    g_aprgNextActiveEnemyOrderTime = now + 1.0;

    for (scanned = 0; scanned < APRG_MAX_ACTIVE_ENEMIES; scanned += 1) {
        slot = (g_aprgActiveEnemyCursor + scanned) % APRG_MAX_ACTIVE_ENEMIES;
        u = g_aprgActiveEnemyUnits[slot];
        if (u == null || !UnitIsAlive(u) || APRG_IsScriptedPurifier(u) || g_aprgActiveEnemyNextTime[slot] > 0.0) { continue; }
        speed = UnitGetPropertyFixed(u, c_unitPropMovementSpeed, c_unitPropCurrent);
        if (speed <= 0.0 || UnitOrderCount(u) > 0) { continue; }
        chosenSlot = slot;
        break;
    }

    if (chosenSlot < 0) {
        for (scanned = 0; scanned < APRG_MAX_ACTIVE_ENEMIES; scanned += 1) {
            slot = (g_aprgActiveEnemyCursor + scanned) % APRG_MAX_ACTIVE_ENEMIES;
            u = g_aprgActiveEnemyUnits[slot];
            if (u == null || !UnitIsAlive(u) || APRG_IsScriptedPurifier(u) || g_aprgActiveEnemyNextTime[slot] <= 0.0) { continue; }
            speed = UnitGetPropertyFixed(u, c_unitPropMovementSpeed, c_unitPropCurrent);
            if (speed <= 0.0 || UnitOrderCount(u) > 0) { continue; }
            chosenSlot = slot;
            break;
        }
    }

    if (chosenSlot < 0) { return; }
    u = g_aprgActiveEnemyUnits[chosenSlot];
    if (!APRG_TryGeneratedHeroAbility(u, player)) {
        APRG_AssignActiveEnemyPatrol(u);
    }
    g_aprgActiveEnemyNextTime[chosenSlot] = now;
    g_aprgActiveEnemyCursor = (chosenSlot + 1) % APRG_MAX_ACTIVE_ENEMIES;
}

bool APRG_IsZergTownHallType(string unitType) {
    if (StringContains(unitType, "HiveMindEmulator", c_stringAnywhere, c_stringNoCase)) { return false; }
    return StringContains(unitType, "Hatchery", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Lair", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Hive", c_stringAnywhere, c_stringNoCase);
}

void APRG_TickInfiniteLarva(int player, fixed now) {
    unitgroup bases;
    int i;
    unit base;
    int localLarva;
    if (!APRG_PlayerMacroBaseReady(player) || now < g_aprgNextInfiniteLarvaTime) { return; }
    g_aprgNextInfiniteLarvaTime = now + 1.0;
    bases = APRG_PlayerStructures(player);
    for (i = UnitGroupCount(bases, c_unitCountAlive); i > 0; i -= 1) {
        base = UnitGroupUnitFromEnd(bases, i);
        if (base == null || UnitGetOwner(base) != player || !APRG_IsZergTownHallType(UnitGetType(base))) { continue; }
        localLarva = APRG_CountNearbyLarva(base, player, 8.0);
        if (localLarva >= 19) { continue; }

        APRG_TriggerNativeLarvaInjection(base);
    }
}

point APRG_FindMiraCampPoint(int player) {
    int attempt;
    fixed clearance;
    point candidate;
    point homePoint;
    unit home;
    home = APRG_FindPlayerHomeStructure(player);
    if (home == null) { return null; }
    homePoint = UnitGetPosition(home);

    // Prefer a generously separated camp, but do not postpone a whole
    // mutation until enemy units happen to die.  Enemy units are allies of
    // Mira's mercenaries, not obstacles to their initial placement.
    // On congested maps such as Rendezvous, fall back to a smaller center
    // clearance while still leaving more than 20 range to allied buildings.
    for (attempt = 0; attempt < APRG_MAX_POINT_ATTEMPTS * 2; attempt += 1) {
        clearance = 40.0;
        if (attempt >= APRG_MAX_POINT_ATTEMPTS) { clearance = 26.0; }
        candidate = RegionRandomPoint(RegionPlayableMap());
        if (candidate == null || !PointPathingPassable(candidate)) { continue; }
        if (APRG_GroundSpawnsNeedPlayerPathing() && !PointPathingIsConnected(candidate, homePoint)) { continue; }
        if (APRG_PointNearPlayerOrAlliedBuilding(candidate, player, clearance)) { continue; }
        return candidate;
    }
    // Never place the camp near player/allied buildings as a fallback.
    // Another attempt is made if terrain changes make a safe site available.
    return null;
}

void APRG_AddMiraMercenaryType(int owner, string unitType, int count, point p, int player) {
    unitgroup created;
    int i;
    unit u;
    if (count <= 0 || p == null || !CatalogEntryIsValid(c_gameCatalogUnit, unitType)) { return; }
    created = UnitCreate(count, unitType, c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
    UnitGroupAddUnitGroup(g_aprgMiraMercenaries, created);
    for (i = UnitGroupCount(created, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(created, i);
        if (u == null) { break; }
        AISetUnitScriptControlled(u, true);
    }
}

void APRG_SpawnMiraMercenaries(int player) {
    int owner;
    point campPoint;
    if (g_aprgMiraMercenariesSpawned || !APRG_PlayerMacroBaseReady(player)) { return; }
    campPoint = APRG_FindMiraCampPoint(player);
    if (campPoint == null) { return; }
    owner = APRG_FindHostileOwnerNearPoint(player, campPoint);
    if (owner < 0) { return; }

    APRG_AddMiraMercenaryType(owner, "SiegeBreaker", 6, campPoint, player);
    APRG_AddMiraMercenaryType(owner, "SpartanCompany", 10, campPoint, player);
    APRG_AddMiraMercenaryType(owner, "WarPig", 20, campPoint, player);
    APRG_AddMiraMercenaryType(owner, "HammerSecurity", 10, campPoint, player);
    APRG_AddMiraMercenaryType(owner, "HelsAngelFighter", 5, campPoint, player);
    APRG_AddMiraMercenaryType(owner, "DevilDog", 5, campPoint, player);
    APRG_AddMiraMercenaryType(owner, "DuskWing", 2, campPoint, player);
    // A missing catalog unit must not mark an entirely empty camp as ready.
    // That otherwise prevents the mutation from ever trying again.
    if (UnitGroupCount(g_aprgMiraMercenaries, c_unitCountAlive) <= 0) { return; }
    g_aprgMiraMercenariesSpawned = true;
    g_aprgNextMiraAttackTime = g_aprgMacroReadyTime + 180.0;
}

void APRG_TickMiraMercenaries(int player) {
    int i;
    int attempt;
    unit u;
    unit first;
    unit second;
    unit target;
    int minerals;
    fixed now;
    if (!g_aprgMiraMercenariesSpawned) { APRG_SpawnMiraMercenaries(player); }
    if (!g_aprgMiraMercenariesSpawned || g_aprgMiraMercenariesPurchased) { return; }
    now = GameGetMissionTime();
    if (g_aprgNextMiraAttackTime >= 0.0 && now >= g_aprgNextMiraAttackTime) {
        first = UnitGroupRandomUnit(g_aprgMiraMercenaries, c_unitCountAlive);
        second = null;
        for (attempt = 0; attempt < 8; attempt += 1) {
            u = UnitGroupRandomUnit(g_aprgMiraMercenaries, c_unitCountAlive);
            if (u != null && u != first) { second = u; break; }
        }
        target = APRG_RandomPlayerStructure(player);
        if (first != null && target != null) {
            UnitIssueOrder(first, OrderTargetingPoint(AbilityCommand("attack", 0), UnitGetPosition(target)), c_orderQueueReplace);
        }
        target = APRG_RandomPlayerStructure(player);
        if (second != null && target != null) {
            UnitIssueOrder(second, OrderTargetingPoint(AbilityCommand("attack", 0), UnitGetPosition(target)), c_orderQueueReplace);
        }
        g_aprgNextMiraAttackTime = now + 60.0;
    }
    minerals = PlayerGetPropertyInt(player, c_playerPropMinerals);
    if (minerals < 6000) { return; }
    PlayerModifyPropertyInt(player, c_playerPropMinerals, c_playerPropOperSetTo, minerals - 6000);
    for (i = UnitGroupCount(g_aprgMiraMercenaries, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(g_aprgMiraMercenaries, i);
        if (u == null) { break; }
        UnitSetOwner(u, player, true);
        AISetUnitScriptControlled(u, false);
    }
    g_aprgMiraMercenariesPurchased = true;
    // Mira's original WoL campaign line: "My forces are yours, Jim."
    APRG_QueueCampaignVO("THorner02Han00022", 0.0);
    UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaChat, StringToText("[Slay] Mira's mercenaries purchased for 6000 minerals."));
}

void APRG_ApplyTacticalBinoculars(int player) {
    unitgroup enemies;
    unit u;
    int i;
    int owner;
    int weaponIndex;
    int weaponCount;
    string weaponType;
    string key;
    enemies = APRG_EnemyAllUnits(player);
    i = UnitGroupCount(enemies, c_unitCountAlive);
    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(enemies, i);
        if (u == null) { break; }
        owner = UnitGetOwner(u);
        weaponCount = UnitWeaponCount(u);
        for (weaponIndex = 1; weaponIndex <= weaponCount; weaponIndex += 1) {
            weaponType = UnitWeaponGet(u, weaponIndex);
            if (weaponType == "") { continue; }
            key = "APRG_Binoculars_" + IntToString(owner) + "_" + weaponType;
            if (DataTableGetBool(true, key)) { continue; }
            CatalogFieldValueModify(c_gameCatalogWeapon, weaponType, "Range", owner, "2.0", c_upgradeOperationMultiply);
            DataTableSetBool(true, key, true);
        }
    }
}

void APRG_TickEnemyRespawns(fixed now) {
    int i;
    unitgroup created;
    for (i = 0; i < APRG_MAX_RESPAWN_QUEUE; i += 1) {
        if (g_aprgRespawnState[i] == 0 || now < g_aprgRespawnTime[i]) { continue; }
        if (g_aprgRespawnPoint[i] != null && CatalogEntryIsValid(c_gameCatalogUnit, g_aprgRespawnType[i])) {
            created = UnitCreate(1, g_aprgRespawnType[i], c_unitCreateIgnorePlacement, g_aprgRespawnOwner[i], g_aprgRespawnPoint[i], libNtve_gf_RandomAngle());
            APRG_RegisterMutationEnemyGroup(created);
        }
        g_aprgRespawnState[i] = 0;
        g_aprgRespawnType[i] = "";
        g_aprgRespawnOwner[i] = -1;
        g_aprgRespawnPoint[i] = null;
        g_aprgRespawnTime[i] = 0.0;
    }
}


unit APRG_RandomPlayerStructure(int player) {
    unitgroup structures = APRG_PlayerStructures(player);
    int i;
    unit u;
    for (i = UnitGroupCount(structures, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(structures, i);
        if (u != null && UnitTestState(u, c_unitStateInvulnerable)) { UnitGroupRemove(structures, u); }
    }
    if (UnitGroupCount(structures, c_unitCountAlive) <= 0) { return null; }
    return UnitGroupRandomUnit(structures, c_unitCountAlive);
}

string APRG_DehakaPackType(int kind) {
    if (kind == 0) {
        if (CatalogEntryIsValid(c_gameCatalogUnit, "PrimalZergling")) { return "PrimalZergling"; }
        if (CatalogEntryIsValid(c_gameCatalogUnit, "DehakaZerglingLevel2")) { return "DehakaZerglingLevel2"; }
        if (CatalogEntryIsValid(c_gameCatalogUnit, "DehakaZergling")) { return "DehakaZergling"; }
    }
    else if (kind == 1) {
        if (CatalogEntryIsValid(c_gameCatalogUnit, "PrimalHydralisk")) { return "PrimalHydralisk"; }
        if (CatalogEntryIsValid(c_gameCatalogUnit, "DehakaHydraliskLevel2")) { return "DehakaHydraliskLevel2"; }
        if (CatalogEntryIsValid(c_gameCatalogUnit, "DehakaHydralisk")) { return "DehakaHydralisk"; }
    }
    else if (kind == 2) {
        if (CatalogEntryIsValid(c_gameCatalogUnit, "PrimalRoach")) { return "PrimalRoach"; }
        if (CatalogEntryIsValid(c_gameCatalogUnit, "DehakaRoachLevel2")) { return "DehakaRoachLevel2"; }
        if (CatalogEntryIsValid(c_gameCatalogUnit, "DehakaRoach")) { return "DehakaRoach"; }
    }
    else if (kind == 3) {
        if (CatalogEntryIsValid(c_gameCatalogUnit, "PrimalMutalisk")) { return "PrimalMutalisk"; }
        if (CatalogEntryIsValid(c_gameCatalogUnit, "DehakaMutaliskLevel3")) { return "DehakaMutaliskLevel3"; }
        if (CatalogEntryIsValid(c_gameCatalogUnit, "DehakaMutalisk")) { return "DehakaMutalisk"; }
    }
    else if (kind == 4) {
        if (CatalogEntryIsValid(c_gameCatalogUnit, "PrimalUltralisk")) { return "PrimalUltralisk"; }
        if (CatalogEntryIsValid(c_gameCatalogUnit, "DehakaUltraliskLevel2")) { return "DehakaUltraliskLevel2"; }
        if (CatalogEntryIsValid(c_gameCatalogUnit, "DehakaUltralisk")) { return "DehakaUltralisk"; }
    }
    return "";
}

void APRG_OrderDehakaPackUnit(unit u, int player) {
    unit target;
    if (u == null || !UnitIsAlive(u)) { return; }
    target = APRG_RandomPlayerStructure(player);
    if (target == null) { return; }
    APRG_OrderAttackMove(u, UnitGetPosition(target));
}

void APRG_SpawnDehakaPackUnit(int player, string unitType) {
    unit anchor;
    point p;
    int owner;
    unitgroup created;
    unit u;
    if (unitType == "" || !CatalogEntryIsValid(c_gameCatalogUnit, unitType)) { return; }
    anchor = APRG_RandomPathableHostileBaseAnchor(player);
    if (anchor == null) { return; }
    p = APRG_FindGroundPointNear(UnitGetPosition(anchor), 2.0, 12.0);
    if (p == null) { p = UnitGetPosition(anchor); }
    owner = UnitGetOwner(anchor);
    created = UnitCreate(1, unitType, c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
    u = UnitGroupUnitFromEnd(created, 1);
    if (u == null) { return; }
    UnitGroupAdd(g_aprgDehakaPackUnits, u);
    APRG_OrderDehakaPackUnit(u, player);
}

void APRG_SpawnDehakaPackWave(int player) {
    int i;
    int count;
    string unitType;
    unitType = APRG_DehakaPackType(0);
    count = RandomInt(0, 8);
    for (i = 0; i < count; i += 1) { APRG_SpawnDehakaPackUnit(player, unitType); }
    unitType = APRG_DehakaPackType(1);
    count = RandomInt(0, 2);
    for (i = 0; i < count; i += 1) { APRG_SpawnDehakaPackUnit(player, unitType); }
    unitType = APRG_DehakaPackType(2);
    count = RandomInt(0, 2);
    for (i = 0; i < count; i += 1) { APRG_SpawnDehakaPackUnit(player, unitType); }
    unitType = APRG_DehakaPackType(3);
    count = RandomInt(0, 2);
    for (i = 0; i < count; i += 1) { APRG_SpawnDehakaPackUnit(player, unitType); }
    unitType = APRG_DehakaPackType(4);
    count = 0;
    if (RandomInt(1, 100) > 75) { count = 1; }
    for (i = 0; i < count; i += 1) { APRG_SpawnDehakaPackUnit(player, unitType); }
}

void APRG_EnableDehakaPackHeroAbilities(unit hero) {
    int owner;
    int commandIndex;
    if (hero == null) { return; }
    owner = UnitGetOwner(hero);

    if (CatalogEntryIsValid(c_gameCatalogAbil, "Drag")) {
        if (!UnitAbilityExists(hero, "Drag")) { UnitAbilityAdd(hero, "Drag"); }
        UnitAbilityEnable(hero, "Drag", true);
        for (commandIndex = 0; commandIndex < 4; commandIndex += 1) {
            TechTreeAbilityAllow(owner, AbilityCommand("Drag", commandIndex), true);
        }
    }
    if (CatalogEntryIsValid(c_gameCatalogAbil, "DehakaHeal")) {
        if (!UnitAbilityExists(hero, "DehakaHeal")) { UnitAbilityAdd(hero, "DehakaHeal"); }
        UnitAbilityEnable(hero, "DehakaHeal", true);
        for (commandIndex = 0; commandIndex < 4; commandIndex += 1) {
            TechTreeAbilityAllow(owner, AbilityCommand("DehakaHeal", commandIndex), true);
        }
    }
    if (CatalogEntryIsValid(c_gameCatalogAbil, "DehakaMirrorImage")) {
        if (!UnitAbilityExists(hero, "DehakaMirrorImage")) { UnitAbilityAdd(hero, "DehakaMirrorImage"); }
        UnitAbilityEnable(hero, "DehakaMirrorImage", true);
        for (commandIndex = 0; commandIndex < 4; commandIndex += 1) {
            TechTreeAbilityAllow(owner, AbilityCommand("DehakaMirrorImage", commandIndex), true);
        }
    }
}

void APRG_SpawnDehakaPackHero(int player) {
    unit anchor;
    point p;
    int owner;
    unitgroup created;
    if (!CatalogEntryIsValid(c_gameCatalogUnit, "Dehaka")) { return; }
    anchor = APRG_RandomPathableHostileBaseAnchor(player);
    if (anchor == null) { return; }
    p = APRG_FindGroundPointNear(UnitGetPosition(anchor), 2.0, 12.0);
    if (p == null) { p = UnitGetPosition(anchor); }
    owner = UnitGetOwner(anchor);
    created = UnitCreate(1, "Dehaka", c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
    g_aprgDehakaPackHero = UnitGroupUnitFromEnd(created, 1);
    if (g_aprgDehakaPackHero == null) { return; }
    APRG_RegisterAlwaysVisibleUnit(g_aprgDehakaPackHero, player);
    APRG_EnableDehakaPackHeroAbilities(g_aprgDehakaPackHero);
    UnitGroupAdd(g_aprgDehakaPackUnits, g_aprgDehakaPackHero);
    APRG_OrderDehakaPackUnit(g_aprgDehakaPackHero, player);
}

fixed APRG_DehakaPackInterval(fixed elapsed) {
    if (elapsed >= 780.0) { return 6.0; }
    if (elapsed >= 600.0) { return 8.0; }
    if (elapsed >= 420.0) { return 12.0; }
    return 20.0;
}

void APRG_RetargetDehakaPack(int player) {
    int i;
    unit u;
    for (i = UnitGroupCount(g_aprgDehakaPackUnits, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(g_aprgDehakaPackUnits, i);
        if (u != null && UnitIsAlive(u)) { APRG_OrderDehakaPackUnit(u, player); }
    }
}

void APRG_TickDehakasPack(int player, fixed now) {
    fixed elapsed;
    fixed interval;
    if (!APRG_PlayerMacroBaseReady(player) || g_aprgMacroReadyTime < 0.0) { return; }
    elapsed = now - g_aprgMacroReadyTime;
    if (g_aprgNextDehakaPackTime < 0.0) { g_aprgNextDehakaPackTime = g_aprgMacroReadyTime + 240.0; }
    if (g_aprgNextDehakaRetargetTime < 0.0) { g_aprgNextDehakaRetargetTime = g_aprgMacroReadyTime + 240.0; }
    if (g_aprgNextDehakaHeroCheckTime < 0.0) { g_aprgNextDehakaHeroCheckTime = g_aprgMacroReadyTime + 360.0; }
    if (now >= g_aprgNextDehakaPackTime) {
        APRG_SpawnDehakaPackWave(player);
        interval = APRG_DehakaPackInterval(elapsed);
        g_aprgNextDehakaPackTime = now + interval;
    }
    if (now >= g_aprgNextDehakaRetargetTime) {
        APRG_RetargetDehakaPack(player);
        g_aprgNextDehakaRetargetTime = now + 30.0;
    }
    if (now >= g_aprgNextDehakaHeroCheckTime) {
        if (g_aprgDehakaPackHero == null || !UnitIsAlive(g_aprgDehakaPackHero)) { APRG_SpawnDehakaPackHero(player); }
        g_aprgNextDehakaHeroCheckTime = now + 180.0;
    }
}

point APRG_FindDeepEnemyAirPoint(int player) {
    unitgroup structures;
    unit home;
    unit u;
    unit chosen;
    int i;
    int eligible = 0;
    int tries = 0;
    fixed distance;
    fixed maxDistance = -1.0;
    fixed threshold;
    point candidate;
    structures = APRG_EnemyStructures(player);
    home = APRG_FindPlayerHomeStructure(player);
    if (UnitGroupCount(structures, c_unitCountAlive) <= 0) { return null; }
    if (home == null) {
        chosen = UnitGroupRandomUnit(structures, c_unitCountAlive);
        if (chosen == null) { return null; }
    }
    else {
        for (i = UnitGroupCount(structures, c_unitCountAlive); i > 0; i -= 1) {
            u = UnitGroupUnitFromEnd(structures, i);
            if (u == null) { continue; }
            distance = DistanceBetweenPoints(UnitGetPosition(u), UnitGetPosition(home));
            if (distance > maxDistance) { maxDistance = distance; }
        }
        if (maxDistance < 0.0) { return null; }
        threshold = maxDistance * 0.70;
        for (i = UnitGroupCount(structures, c_unitCountAlive); i > 0; i -= 1) {
            u = UnitGroupUnitFromEnd(structures, i);
            if (u == null) { continue; }
            distance = DistanceBetweenPoints(UnitGetPosition(u), UnitGetPosition(home));
            if (distance < threshold) { continue; }
            eligible += 1;
            if (RandomInt(1, eligible) == 1) { chosen = u; }
        }
        if (chosen == null) { return null; }
    }
    candidate = PointWithOffsetPolar(UnitGetPosition(chosen), RandomFixed(5.0, 18.0), libNtve_gf_RandomAngle());
    for (tries = 0; tries < 8; tries += 1) {
        if (
            candidate != null &&
            APRG_AirSpawnPointAllowed(candidate) &&
            !APRG_PointNearRakShirDuel(candidate, 24.0) &&
            (g_aprgRaynorSafePoint == null || DistanceBetweenPoints(candidate, g_aprgRaynorSafePoint) >= 10.0)
        ) { return candidate; }
        candidate = PointWithOffsetPolar(UnitGetPosition(chosen), RandomFixed(5.0, 18.0), libNtve_gf_RandomAngle());
    }
    return null;
}

void APRG_TickRaynorRepairSCVs(unit target) {
    unit scv;
    int i;
    fixed life;
    fixed maximum;
    fixed distance;
    bool repairerNear = false;
    bool normalRepairObserved = false;
    if (target == null || !UnitIsAlive(target)) { return; }
    life = UnitGetPropertyFixed(target, c_unitPropLife, c_unitPropCurrent);
    maximum = UnitGetPropertyFixed(target, c_unitPropLifeMax, c_unitPropCurrent);
    if (g_aprgRaynorLastObservedLife >= 0.0 && life > g_aprgRaynorLastObservedLife + 0.05) { normalRepairObserved = true; }
    for (i = UnitGroupCount(g_aprgRaynorRepairSCVs, c_unitCountAlive); i > 0; i -= 1) {
        scv = UnitGroupUnitFromEnd(g_aprgRaynorRepairSCVs, i);
        if (scv == null || !UnitIsAlive(scv)) { continue; }
        AISetUnitScriptControlled(scv, true);
        distance = DistanceBetweenPoints(UnitGetPosition(scv), UnitGetPosition(target));
        if (UnitOrderCount(scv) <= 0) {
            UnitIssueOrder(scv, OrderTargetingUnit(AbilityCommand("Repair", 0), target), c_orderQueueReplace);
        }
        if (distance <= 6.0) { repairerNear = true; }
    }
    if (life >= maximum || normalRepairObserved) {
        g_aprgRaynorRepairStallTicks = 0;
    }
    else if (repairerNear && g_aprgRaynorFlybyState == 0) {
        g_aprgRaynorRepairStallTicks += 1;
        if (g_aprgRaynorRepairStallTicks >= 3) {
            life = MinF(maximum, life + 7.5);
            UnitSetPropertyFixed(target, c_unitPropLife, life);
            g_aprgRaynorRepairStallTicks = 2;
        }
    }
    else {
        g_aprgRaynorRepairStallTicks = 0;
    }
    g_aprgRaynorLastObservedLife = UnitGetPropertyFixed(target, c_unitPropLife, c_unitPropCurrent);
}

void APRG_NormalizeRaynorHyperionDurability(unit hyperion, int owner) {
    int i;
    string behavior;
    if (hyperion == null) { return; }

    for (i = UnitBehaviorCountAll(hyperion); i >= 1; i -= 1) {
        behavior = UnitBehaviorGet(hyperion, i);
        if (
            StringContains(behavior, "DamageResponse", c_stringAnywhere, c_stringNoCase) ||
            StringContains(behavior, "DamageReduction", c_stringAnywhere, c_stringNoCase) ||
            StringContains(behavior, "DamageRedux", c_stringAnywhere, c_stringNoCase) ||
            StringContains(behavior, "DivineArmor", c_stringAnywhere, c_stringNoCase) ||
            StringContains(behavior, "Hardened", c_stringAnywhere, c_stringNoCase) ||
            StringContains(behavior, "Invulner", c_stringAnywhere, c_stringNoCase) ||
            StringContains(behavior, "Regener", c_stringAnywhere, c_stringNoCase) ||
            StringContains(behavior, "LifeRegen", c_stringAnywhere, c_stringNoCase)
        ) {
            UnitBehaviorRemove(hyperion, behavior, c_unitBehaviorCountAll);
        }
    }
    CatalogFieldValueSet(c_gameCatalogUnit, UnitGetType(hyperion), "LifeArmor", owner, "3");
    if (!DataTableGetBool(true, "APRG_RaynorHyperionRepairTime_" + IntToString(owner))) {
        CatalogFieldValueModify(c_gameCatalogUnit, UnitGetType(hyperion), "RepairTime", owner, "2.0", c_upgradeOperationMultiply);
        DataTableSetBool(true, "APRG_RaynorHyperionRepairTime_" + IntToString(owner), true);
    }
    UnitSetPropertyFixed(hyperion, c_unitPropLifeMax, 3000.0);
    UnitSetPropertyFixed(hyperion, c_unitPropLife, 3000.0);
    UnitSetPropertyFixed(hyperion, c_unitPropLifeRegen, 0.0);
    if (UnitGetPropertyFixed(hyperion, c_unitPropMovementSpeed, c_unitPropCurrent) < 0.2) {
        UnitSetPropertyFixed(hyperion, c_unitPropMovementSpeed, 1.875);
    }
}

void APRG_ApplyRaynorHyperionStructureDamage(unit hyperion, int owner) {
    int wi;
    int wc;
    string weaponType;
    string effectType;
    string key;
    fixed amount;
    fixed structureBonus;
    fixed desiredBonus;
    if (hyperion == null || UnitGetType(hyperion) != "Hyperion") { return; }
    wc = UnitWeaponCount(hyperion);
    for (wi = 1; wi <= wc; wi += 1) {
        weaponType = UnitWeaponGet(hyperion, wi);
        if (weaponType == "") { continue; }
        effectType = CatalogFieldValueGet(c_gameCatalogWeapon, weaponType, "DisplayEffect", owner);
        if (effectType == "" || !CatalogEntryIsValid(c_gameCatalogEffect, effectType)) { continue; }
        key = "APRG_RaynorHyperionStructureDamage_" + IntToString(owner) + "_" + effectType;
        if (DataTableGetBool(true, key)) { continue; }
        amount = StringToFixed(CatalogFieldValueGet(c_gameCatalogEffect, effectType, "Amount", owner));
        structureBonus = StringToFixed(CatalogFieldValueGet(c_gameCatalogEffect, effectType, "AttributeBonus[Structure]", owner));
        if (amount > 0.0) {
            desiredBonus = ((amount + structureBonus) * 0.5) - amount;
            CatalogFieldValueSet(c_gameCatalogEffect, effectType, "AttributeBonus[Structure]", owner, FixedToString(desiredBonus, c_fixedPrecisionAny));
        }
        DataTableSetBool(true, key, true);
    }
}

unit APRG_RaynorFlybyTarget(int player) {
    unit target;
    if (g_aprgRaynorHyperion == null) { return null; }

    target = APRG_FindPlayerHomeStructure(player);
    if (target != null && UnitIsAlive(target)) { return target; }

    return APRG_RandomPlayerStructure(player);
}

// Raynor's Raiders Hyperion must fly using the ordinary SC2 move order. Do
// not teleport/nudge it when progress is slow: Time Stop legitimately freezes
// the unit, and a movement watchdog would move it despite being frozen.
void APRG_RaynorMoveToward(point destination, fixed now) {
    if (g_aprgRaynorHyperion == null || destination == null || !UnitIsAlive(g_aprgRaynorHyperion)) { return; }
    if (now >= g_aprgRaynorNextMoveRefreshTime) {
        UnitIssueOrder(g_aprgRaynorHyperion, OrderTargetingPoint(AbilityCommand("move", 0), destination), c_orderQueueReplace);
        g_aprgRaynorNextMoveRefreshTime = now + 3.0;
    }
}
void APRG_RaynorBeginMove(point destination, fixed now) {
    if (destination == null || g_aprgRaynorHyperion == null) { return; }
    g_aprgRaynorNextMoveRefreshTime = now;
    APRG_RaynorMoveToward(destination, now);
}

void APRG_TickRaynorsRaiders(int player, fixed now) {
    unit anchor;
    unit target;
    unitgroup created;
    point p;
    point dropPoint;
    int owner;
    int i;
    string hyperionType;
    fixed raynorLife;
    fixed raynorMax;
    if (!APRG_PlayerMacroBaseReady(player) || g_aprgRaynorDestroyed) { return; }

    if (!g_aprgRaynorStarted) {
        anchor = APRG_RandomHostileBaseAnchor(player);
        if (anchor == null) { return; }
        hyperionType = "";
        if (CatalogEntryIsValid(c_gameCatalogUnit, "Hyperion")) { hyperionType = "Hyperion"; }
        else if (CatalogEntryIsValid(c_gameCatalogUnit, "Battlecruiser")) { hyperionType = "Battlecruiser"; }
        if (hyperionType == "") { return; }
        owner = UnitGetOwner(anchor);
        p = APRG_FindDeepEnemyAirPoint(player);
        if (p == null) { p = UnitGetPosition(anchor); }
        created = UnitCreate(1, hyperionType, c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
        g_aprgRaynorHyperion = UnitGroupUnitFromEnd(created, 1);
        if (g_aprgRaynorHyperion == null) { return; }
        APRG_StripVoidEntityBehavior(g_aprgRaynorHyperion);
        if (hyperionType == "Hyperion") {
            APRG_NormalizeRaynorHyperionDurability(g_aprgRaynorHyperion, owner);
            APRG_ApplyRaynorHyperionStructureDamage(g_aprgRaynorHyperion, owner);
        }
        APRG_RegisterAlwaysVisibleUnit(g_aprgRaynorHyperion, player);
        AISetUnitScriptControlled(g_aprgRaynorHyperion, true);
        g_aprgRaynorHomePoint = p;
        g_aprgRaynorSafePoint = p;
        g_aprgRaynorNextFlybyTime = g_aprgMacroReadyTime + 390.0;
        g_aprgRaynorEarliestNextFlybyTime = g_aprgRaynorNextFlybyTime;
        g_aprgRaynorNextRepairDropTime = -1.0;
        g_aprgRaynorSafeArriveTime = now;
        g_aprgRaynorNeedsRepair = false;
        g_aprgRaynorFlybyState = 0;
        g_aprgRaynorLastObservedLife = UnitGetPropertyFixed(g_aprgRaynorHyperion, c_unitPropLife, c_unitPropCurrent);
        g_aprgRaynorRepairStallTicks = 0;
        g_aprgRaynorStarted = true;
    }

    if (g_aprgRaynorHyperion == null || !UnitIsAlive(g_aprgRaynorHyperion)) {
        g_aprgRaynorDestroyed = true;
        g_aprgRaynorFlybyState = 0;
        return;
    }

    APRG_RegisterAlwaysVisibleUnit(g_aprgRaynorHyperion, player);
    owner = UnitGetOwner(g_aprgRaynorHyperion);
    APRG_TickRaynorRepairSCVs(g_aprgRaynorHyperion);

    raynorLife = UnitGetPropertyFixed(g_aprgRaynorHyperion, c_unitPropLife, c_unitPropCurrent);
    raynorMax = UnitGetPropertyFixed(g_aprgRaynorHyperion, c_unitPropLifeMax, c_unitPropCurrent);
    if (g_aprgRaynorFlybyState == 1 && g_aprgRaynorFlybyStartLife > 0.0 && raynorLife <= g_aprgRaynorFlybyStartLife * 0.5) {
        g_aprgRaynorEarliestNextFlybyTime = now + 90.0;
        g_aprgRaynorSafePoint = APRG_FindDeepEnemyAirPoint(player);
        if (g_aprgRaynorSafePoint == null) { g_aprgRaynorSafePoint = g_aprgRaynorHomePoint; }
        if (g_aprgRaynorSafePoint != null) { APRG_RaynorBeginMove(g_aprgRaynorSafePoint, now); }
        g_aprgRaynorFlybyDeadline = now + 90.0;
        g_aprgRaynorFlybyState = 3;
        return;
    }

    if (g_aprgRaynorFlybyState == 1) {
        APRG_RaynorMoveToward(g_aprgRaynorTargetPoint, now);
        if (DistanceBetweenPoints(UnitGetPosition(g_aprgRaynorHyperion), g_aprgRaynorTargetPoint) <= 15.0 || now >= g_aprgRaynorFlybyDeadline) {
            for (i = 0; i < 5; i += 1) {
                dropPoint = APRG_FindGroundPointNear(UnitGetPosition(g_aprgRaynorHyperion), 3.0, 10.0);
                if (dropPoint == null) { dropPoint = UnitGetPosition(g_aprgRaynorHyperion); }
                APRG_QueueRealDropPod(APRG_DROP_KIND_RAYNOR_ASSAULT, owner, dropPoint, null);
            }
            g_aprgRaynorEarliestNextFlybyTime = now + 90.0;
            g_aprgRaynorSafePoint = APRG_FindDeepEnemyAirPoint(player);
            if (g_aprgRaynorSafePoint == null) { g_aprgRaynorSafePoint = g_aprgRaynorHomePoint; }
            if (g_aprgRaynorSafePoint != null) { APRG_RaynorBeginMove(g_aprgRaynorSafePoint, now); }
            g_aprgRaynorFlybyDeadline = now + 90.0;
            g_aprgRaynorFlybyState = 3;
        }
        return;
    }

    if (g_aprgRaynorFlybyState == 3) {
        APRG_RaynorMoveToward(g_aprgRaynorSafePoint, now);
        if (g_aprgRaynorSafePoint == null || DistanceBetweenPoints(UnitGetPosition(g_aprgRaynorHyperion), g_aprgRaynorSafePoint) <= 12.0 || now >= g_aprgRaynorFlybyDeadline) {
            raynorLife = UnitGetPropertyFixed(g_aprgRaynorHyperion, c_unitPropLife, c_unitPropCurrent);
            raynorMax = UnitGetPropertyFixed(g_aprgRaynorHyperion, c_unitPropLifeMax, c_unitPropCurrent);
            g_aprgRaynorFlybyState = 0;
            g_aprgRaynorSafeArriveTime = now;
            g_aprgRaynorNextFlybyTime = now + 180.0;
            g_aprgRaynorNeedsRepair = raynorMax > 0.0 && raynorLife < raynorMax * 0.995;
            if (g_aprgRaynorNeedsRepair) { g_aprgRaynorNextRepairDropTime = now + 90.0; }
            else { g_aprgRaynorNextRepairDropTime = -1.0; }
        }
        return;
    }

    if (g_aprgRaynorFlybyState == 0) {
        raynorLife = UnitGetPropertyFixed(g_aprgRaynorHyperion, c_unitPropLife, c_unitPropCurrent);
        raynorMax = UnitGetPropertyFixed(g_aprgRaynorHyperion, c_unitPropLifeMax, c_unitPropCurrent);
        if (raynorMax > 0.0 && raynorLife < raynorMax * 0.995) { g_aprgRaynorNeedsRepair = true; }
        if (g_aprgRaynorNeedsRepair && raynorMax > 0.0 && raynorLife >= raynorMax * 0.995 && now >= g_aprgRaynorSafeArriveTime + 90.0) {
            g_aprgRaynorNeedsRepair = false;
            if (now >= g_aprgRaynorEarliestNextFlybyTime) { g_aprgRaynorNextFlybyTime = now; }
            else { g_aprgRaynorNextFlybyTime = g_aprgRaynorEarliestNextFlybyTime; }
            g_aprgRaynorNextRepairDropTime = -1.0;
        }
    }

    if (g_aprgRaynorNeedsRepair && g_aprgRaynorNextRepairDropTime >= 0.0 && now >= g_aprgRaynorNextRepairDropTime) {
        dropPoint = APRG_FindGroundPointNear(UnitGetPosition(g_aprgRaynorHyperion), 2.0, 7.0);
        if (dropPoint == null) { dropPoint = UnitGetPosition(g_aprgRaynorHyperion); }
        APRG_QueueRealDropPod(APRG_DROP_KIND_RAYNOR_REPAIR, owner, dropPoint, g_aprgRaynorHyperion);
        g_aprgRaynorNextRepairDropTime = now + 120.0;
    }

    if (now >= g_aprgRaynorNextFlybyTime) {
        target = APRG_RaynorFlybyTarget(player);
        if (target == null) { return; }
        g_aprgRaynorTargetPoint = UnitGetPosition(target);
        UIDisplayMessage(
            PlayerGroupSingle(player), c_messageAreaChat,
            StringToText("[Slay] The Hyperion is approaching your base!")
        );
        g_aprgRaynorFlybyStartLife = UnitGetPropertyFixed(g_aprgRaynorHyperion, c_unitPropLife, c_unitPropCurrent);
        APRG_RaynorBeginMove(g_aprgRaynorTargetPoint, now);
        g_aprgRaynorFlybyState = 1;
        g_aprgRaynorFlybyDeadline = now + 90.0;
    }
}



unit APRG_PurifierFarthestEnemyBuilding(int player) {
    unit home;
    point homePoint;
    unitgroup buildings;
    unit candidate;
    unit best;
    fixed distance;
    fixed bestDistance;
    int i;
    home = APRG_FindPlayerHomeStructure(player);
    if (home == null) { return null; }
    homePoint = UnitGetPosition(home);
    buildings = APRG_EnemyStructures(player);
    best = null;
    bestDistance = -1.0;
    for (i = UnitGroupCount(buildings, c_unitCountAlive); i > 0; i -= 1) {
        candidate = UnitGroupUnitFromEnd(buildings, i);
        if (candidate == null || !UnitIsAlive(candidate)) { continue; }
        distance = DistanceBetweenPoints(UnitGetPosition(candidate), homePoint);
        if (distance > bestDistance) {
            bestDistance = distance;
            best = candidate;
        }
    }
    return best;
}

void APRG_PurifierWarpVisual(unit u) {
    if (u == null) { return; }
}

string APRG_PurifierEscortType() {
    int roll;
    roll = RandomInt(0, 3);
    if (roll == 0) { return "Scout"; }
    if (roll == 1) { return "Phoenix"; }
    if (roll == 2) { return "VoidRay"; }
    return "Carrier";
}

bool APRG_QueuePurifierEscortWarp(string unitType, int owner, point center, fixed when) {
    int i;
    if (unitType == "" || center == null || owner < 0) { return false; }
    for (i = 0; i < 32; i += 1) {
        if (g_aprgPurifierWarpState[i] != 0) { continue; }
        g_aprgPurifierWarpState[i] = 1;
        g_aprgPurifierWarpOwner[i] = owner;
        g_aprgPurifierWarpType[i] = unitType;
        g_aprgPurifierWarpPoint[i] = center;
        g_aprgPurifierWarpTime[i] = when;
        g_aprgPurifierWarpActor[i] = null;
        g_aprgPurifierWarpUnit[i] = null;
        g_aprgPurifierWarpEscort[i] = true;
        return true;
    }
    return false;
}

void APRG_PurifierSpawnEscort(int player) {
    string unitType;
    int owner;
    point p;
    if (g_aprgPurifier == null || !UnitIsAlive(g_aprgPurifier)) { return; }
    owner = UnitGetOwner(g_aprgPurifier);
    p = PointWithOffsetPolar(UnitGetPosition(g_aprgPurifier), RandomFixed(3.0, 7.0), libNtve_gf_RandomAngle());
    unitType = APRG_PurifierEscortType();
    if (!CatalogEntryIsValid(c_gameCatalogUnit, unitType)) { unitType = "Scout"; }
    if (!CatalogEntryIsValid(c_gameCatalogUnit, unitType)) { return; }
    APRG_QueuePurifierEscortWarp(unitType, owner, p, GameGetMissionTime());
}

bool APRG_QueuePurifierHostileWarp(string unitType, int owner, point center, fixed when) {
    int i;
    if (unitType == "" || center == null || owner < 0) { return false; }
    for (i = 0; i < 32; i += 1) {
        if (g_aprgPurifierWarpState[i] != 0) { continue; }
        g_aprgPurifierWarpState[i] = 1;
        g_aprgPurifierWarpOwner[i] = owner;
        g_aprgPurifierWarpType[i] = unitType;
        g_aprgPurifierWarpPoint[i] = center;
        g_aprgPurifierWarpTime[i] = when;
        g_aprgPurifierWarpActor[i] = null;
        g_aprgPurifierWarpUnit[i] = null;
        g_aprgPurifierWarpEscort[i] = false;
        return true;
    }
    return false;
}

void APRG_ProcessPurifierHostileWarpQueue(int player, fixed now) {
    int i;
    int best = -1;
    fixed bestTime = 99999999.0;
    point spawnPoint;
    unitgroup created;
    unitgroup ready;
    unit u;
    actor mainActor;
    for (i = 0; i < 32; i += 1) {
        if (g_aprgPurifierWarpState[i] == 0 || g_aprgPurifierWarpTime[i] > now) { continue; }
        if (best < 0 || g_aprgPurifierWarpTime[i] < bestTime) { best = i; bestTime = g_aprgPurifierWarpTime[i]; }
    }
    if (best < 0) { return; }

    if (g_aprgPurifierWarpState[best] == 1) {
        spawnPoint = APRG_FindGroundPointNear(g_aprgPurifierWarpPoint[best], 1.0, 7.0);
        if (spawnPoint == null) { spawnPoint = g_aprgPurifierWarpPoint[best]; }
        g_aprgPurifierWarpPoint[best] = spawnPoint;
        if (!CatalogEntryIsValid(c_gameCatalogUnit, g_aprgPurifierWarpType[best])) {
            g_aprgPurifierWarpState[best] = 0;
            g_aprgPurifierWarpOwner[best] = -1;
            g_aprgPurifierWarpType[best] = "";
            g_aprgPurifierWarpPoint[best] = null;
            g_aprgPurifierWarpTime[best] = 0.0;
            g_aprgPurifierWarpActor[best] = null;
            g_aprgPurifierWarpUnit[best] = null;
            g_aprgPurifierWarpEscort[best] = false;
            return;
        }
        created = UnitCreate(1, g_aprgPurifierWarpType[best], c_unitCreateIgnorePlacement, g_aprgPurifierWarpOwner[best], spawnPoint, libNtve_gf_RandomAngle());
        if (created == null || UnitGroupCount(created, c_unitCountAlive) <= 0) {
            g_aprgPurifierWarpState[best] = 0;
            g_aprgPurifierWarpEscort[best] = false;
            return;
        }
        u = UnitGroupUnitFromEnd(created, 1);
        if (u == null) {
            g_aprgPurifierWarpState[best] = 0;
            g_aprgPurifierWarpEscort[best] = false;
            return;
        }
        g_aprgPurifierWarpUnit[best] = u;
        if (g_aprgPurifierWarpEscort[best]) {
            UnitGroupAdd(g_aprgPurifierEscort, u);
            if (g_aprgPurifierWarpType[best] == "Carrier") {
                UnitGroupIssueOrder(created, OrderSetAutoCast(AbilityCommand("CarrierHangar", 0), true), c_orderQueueReplace);
                UnitGroupAdd(g_aprgAirSupportCarriers, u);
            }
        }
        else {
            APRG_AddHostileRaiders(created, spawnPoint, player);
        }

        // Match Blizzard's campaign warp presentation: the real unit exists during the warp,
        // is paused, fades in, and has ProtossGenericWarpInOut attached at Ref_Origin.
        libNtve_gf_PauseUnit(u, true);
        mainActor = libNtve_gf_MainActorofUnit(u);
        if (mainActor != null) {
            ActorSend(mainActor, libNtve_gf_SetOpacity(0.0, 0.0));
            ActorSend(mainActor, libNtve_gf_SetOpacity(1.0, 5.0));
        }
        g_aprgPurifierWarpActor[best] = APRG_CreateWarpVisual(u, spawnPoint);
        if (CatalogEntryIsValid(c_gameCatalogBehavior, "ProtossGenericWarpInOut")) {
            UnitBehaviorAdd(u, "ProtossGenericWarpInOut", u, 1);
        }
        g_aprgPurifierWarpState[best] = 2;
        g_aprgPurifierWarpTime[best] = now + 5.0;
        return;
    }

    u = g_aprgPurifierWarpUnit[best];
    if (u != null && UnitIsAlive(u)) {
        if (CatalogEntryIsValid(c_gameCatalogBehavior, "ProtossGenericWarpInOut")) {
            UnitBehaviorRemove(u, "ProtossGenericWarpInOut", 1);
        }
        mainActor = libNtve_gf_MainActorofUnit(u);
        if (mainActor != null) { ActorSend(mainActor, libNtve_gf_SetOpacity(1.0, 0.0)); }
        libNtve_gf_PauseUnit(u, false);
        ready = UnitGroupEmpty();
        UnitGroupAdd(ready, u);
        if (g_aprgPurifierWarpEscort[best]) {
            // Escort flyers used to receive no attack order at all after unpausing.
            APRG_AddHostileRaiders(ready, UnitGetPosition(u), player);
        }
        else {
            APRG_OrderGroupTowardNearestPlayerStructure(ready, UnitGetPosition(u), player);
        }
    }
    if (g_aprgPurifierWarpActor[best] != null) { ActorSend(g_aprgPurifierWarpActor[best], "Destroy"); }
    g_aprgPurifierWarpState[best] = 0;
    g_aprgPurifierWarpOwner[best] = -1;
    g_aprgPurifierWarpType[best] = "";
    g_aprgPurifierWarpPoint[best] = null;
    g_aprgPurifierWarpTime[best] = 0.0;
    g_aprgPurifierWarpActor[best] = null;
    g_aprgPurifierWarpUnit[best] = null;
    g_aprgPurifierWarpEscort[best] = false;
}

void APRG_PurifierSpawnGroundWave(int player) {
    int owner;
    point center;
    int i;
    int queued = 0;
    fixed now;
    if (g_aprgPurifier == null || !UnitIsAlive(g_aprgPurifier)) { return; }
    owner = UnitGetOwner(g_aprgPurifier);
    center = UnitGetPosition(g_aprgPurifier);
    now = GameGetMissionTime();
    for (i = 0; i < 5; i += 1) {
        if (APRG_QueuePurifierHostileWarp("Zealot", owner, center, now + 0.2 * IntToFixed(queued))) { queued += 1; }
    }
    for (i = 0; i < 5; i += 1) {
        if (APRG_QueuePurifierHostileWarp("Stalker", owner, center, now + 0.2 * IntToFixed(queued))) { queued += 1; }
    }
}

void APRG_PurifierKeepEscortClose() {
    int i;
    unit u;
    fixed distance;
    point purifierPoint;
    if (g_aprgPurifier == null || !UnitIsAlive(g_aprgPurifier)) { return; }
    purifierPoint = UnitGetPosition(g_aprgPurifier);
    for (i = UnitGroupCount(g_aprgPurifierEscort, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(g_aprgPurifierEscort, i);
        if (u == null) { continue; }
        distance = DistanceBetweenPoints(UnitGetPosition(u), purifierPoint);
        if (distance > 10.0) {
            UnitIssueOrder(u, OrderTargetingPoint(AbilityCommand("move", 0), purifierPoint), c_orderQueueReplace);
        }
    }
}

void APRG_ForceEndPurifierPlanetCracker(unit purifier) {
    int i;
    string behavior;
    bool restoreAbility = false;
    if (purifier == null || !UnitIsAlive(purifier)) { return; }

    UnitIssueOrder(purifier, Order(AbilityCommand("move", 2)), c_orderQueueReplace);

    for (i = UnitBehaviorCountAll(purifier); i >= 1; i -= 1) {
        behavior = UnitBehaviorGet(purifier, i);
        if (
            StringContains(behavior, "PlanetCracker", c_stringAnywhere, c_stringNoCase) ||
            StringContains(behavior, "PurifierPlanet", c_stringAnywhere, c_stringNoCase)
        ) {
            UnitBehaviorRemove(purifier, behavior, c_unitBehaviorCountAll);
        }
    }
    if (UnitAbilityExists(purifier, "PurifierPlanetCracker")) {
        UnitAbilityRemove(purifier, "PurifierPlanetCracker");
        restoreAbility = true;
    }
    if (restoreAbility) { UnitAbilityAdd(purifier, "PurifierPlanetCracker"); }
}

bool APRG_PurifierNearPlayerStructure(unit purifier, int player, fixed radius) {
    unit nearest;
    if (purifier == null || !UnitIsAlive(purifier)) { return false; }
    nearest = APRG_NearestPlayerStructure(UnitGetPosition(purifier), player);
    if (nearest == null) { return false; }
    return DistanceBetweenPoints(UnitGetPosition(purifier), UnitGetPosition(nearest)) <= radius;
}

// The WoL Purifier unit type begins with InvulnerabilityShield in its base
// catalog. Only the separate, Slay-created mutation/boon units should lose it.
// Never modify the map's scripted Safe Haven Purifier: its shield must remain
// until the native Nexus objective removes it, including on runs where no
// Purifier effect is selected.
void APRG_RemoveSlayPurifierInvulnerability(unit purifier) {
    if (purifier == null || !UnitIsAlive(purifier)) { return; }
    if (purifier == g_aprgPurifier) {
        if (!APRG_HasExtension3(APRG_EXT3_MUT_PURIFIER)) { return; }
    }
    else if (purifier == g_aprgPurifierAlliance) {
        if (!APRG_HasExtension4(APRG_EXT4_BOON_PURIFIER_ALLIANCE)) { return; }
    }
    else { return; } // Never strip the mission-owned Purifier.
    if (UnitBehaviorCount(purifier, "InvulnerabilityShield") > 0) {
        UnitBehaviorRemove(purifier, "InvulnerabilityShield", c_unitBehaviorCountAll);
    }
    UnitSetState(purifier, c_unitStateInvulnerable, false);
}

void APRG_TickPurifier(int player, fixed now) {
    point spawnPoint;
    unit spawnAnchor;
    int owner;
    unitgroup created;
    unit home;
    fixed distance;
    fixed speed;
    fixed life;
    fixed maxLife;
    int i;
    if (!APRG_PlayerMacroBaseReady(player)) { return; }

    if (!g_aprgPurifierSpawned) {
        if (!CatalogEntryIsValid(c_gameCatalogUnit, "Purifier")) { return; }
        spawnAnchor = APRG_PurifierFarthestEnemyBuilding(player);
        if (spawnAnchor == null) { spawnAnchor = APRG_RandomHostileBaseAnchor(player); }
        if (spawnAnchor == null) { return; }
        spawnPoint = UnitGetPosition(spawnAnchor);
        owner = UnitGetOwner(spawnAnchor);
        if (owner < 0) { owner = APRG_FindHostileOwnerNearPoint(player, spawnPoint); }
        if (owner < 0) { return; }
        created = UnitCreate(1, "Purifier", c_unitCreateIgnorePlacement, owner, spawnPoint, libNtve_gf_RandomAngle());
        if (created == null || UnitGroupCount(created, c_unitCountAlive) <= 0) { return; }
        g_aprgPurifier = UnitGroupUnitFromEnd(created, 1);
        if (g_aprgPurifier == null) { return; }
        APRG_StripVoidEntityBehavior(g_aprgPurifier);
        APRG_RemoveSlayPurifierInvulnerability(g_aprgPurifier);
        AISetUnitScriptControlled(g_aprgPurifier, true);
        speed = UnitGetPropertyFixed(g_aprgPurifier, c_unitPropMovementSpeed, c_unitPropCurrent);
        if (speed != 0.25) { UnitSetPropertyFixed(g_aprgPurifier, c_unitPropMovementSpeed, 0.25); }
        g_aprgPurifierRevealRegion = RegionCircle(UnitGetPosition(g_aprgPurifier), 6.0);
        g_aprgPurifierRevealer = VisRevealerCreate(player, g_aprgPurifierRevealRegion);
        g_aprgPurifierSpawned = true;
        g_aprgPurifierCrackerIssued = false;
        g_aprgPurifierHalfHealthWarped = false;
        g_aprgPurifierBeamStopTime = -1.0;
        g_aprgNextPurifierEscortTime = g_aprgMacroReadyTime + 120.0 + 50.0;
        g_aprgNextPurifierGroundWaveTime = g_aprgMacroReadyTime + 120.0 + 120.0;
        g_aprgNextPurifierMoveRefreshTime = g_aprgMacroReadyTime + 120.0;
        MinimapPing(PlayerGroupSingle(player), UnitGetPosition(g_aprgPurifier), 6.0, Color(100.00, 60.00, 0.00));
        UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaChat, StringToText("[Slay] The Purifier is approaching your base."));
    }

    if (g_aprgPurifier == null || !UnitIsAlive(g_aprgPurifier)) { return; }
    // Safe Haven's regular boss is independent; ensure only our mutation unit
    // remains vulnerable even if a campaign trigger restores its starting buff.
    APRG_RemoveSlayPurifierInvulnerability(g_aprgPurifier);
    UnitSetPropertyFixed(g_aprgPurifier, c_unitPropMovementSpeed, 0.25);
    if (g_aprgPurifierRevealRegion != null && g_aprgPurifierRevealer != null) {
        RegionSetCenter(g_aprgPurifierRevealRegion, UnitGetPosition(g_aprgPurifier));
        VisRevealerUpdate(g_aprgPurifierRevealer);
    }
    if (now < g_aprgMacroReadyTime + 120.0) { return; }
    if (!g_aprgPurifierApproachVOCued) {
        g_aprgPurifierApproachVOCued = true;
        APRG_QueueCampaignVO("TTychus05Horner00013", 0.0);
    }
    APRG_PurifierKeepEscortClose();

    if (!g_aprgPurifierHalfHealthWarped) {
        life = UnitGetPropertyFixed(g_aprgPurifier, c_unitPropLife, c_unitPropCurrent);
        maxLife = UnitGetPropertyFixed(g_aprgPurifier, c_unitPropLifeMax, c_unitPropCurrent);
        if (maxLife > 0.0 && life <= maxLife * 0.5) {
            g_aprgPurifierHalfHealthWarped = true;
            for (i = 0; i < 4; i += 1) {
                APRG_QueuePurifierHostileWarp("VoidRay", UnitGetOwner(g_aprgPurifier), UnitGetPosition(g_aprgPurifier), now + 0.2 * IntToFixed(i));
            }
        }
    }

    if (g_aprgPurifierBeamStopTime > 0.0 && now >= g_aprgPurifierBeamStopTime) {
        APRG_ForceEndPurifierPlanetCracker(g_aprgPurifier);
        g_aprgPurifierBeamStopTime = -1.0;
    }

    if (now >= g_aprgNextPurifierEscortTime) {
        APRG_PurifierSpawnEscort(player);
        g_aprgNextPurifierEscortTime = now + 50.0;
    }
    if (now >= g_aprgNextPurifierGroundWaveTime) {
        APRG_PurifierSpawnGroundWave(player);
        g_aprgNextPurifierGroundWaveTime = now + 120.0;
    }

    home = APRG_FindPlayerHomeStructure(player);
    if (home == null) { return; }
    distance = DistanceBetweenPoints(UnitGetPosition(g_aprgPurifier), UnitGetPosition(home));
    if (!g_aprgPurifierCrackerIssued && distance <= 8.0) {
        if (CatalogEntryIsValid(c_gameCatalogAbil, "PurifierPlanetCracker")) {
            UnitIssueOrder(g_aprgPurifier, Order(AbilityCommand("PurifierPlanetCracker", 0)), c_orderQueueReplace);
            UnitIssueOrder(g_aprgPurifier, Order(AbilityCommand("move", 2)), c_orderQueueAddToEnd);
            g_aprgPurifierCrackerIssued = true;
            g_aprgPurifierBeamStopTime = now + 10.0;
            MinimapPing(PlayerGroupSingle(player), UnitGetPosition(g_aprgPurifier), 8.0, Color(100.00, 0.00, 0.00));
            UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaChat, StringToText("[Slay] PURIFIER PLANET CRACKER FIRING."));
        }
        return;
    }
    if (!g_aprgPurifierCrackerIssued && now >= g_aprgNextPurifierMoveRefreshTime) {
        UnitIssueOrder(g_aprgPurifier, OrderTargetingPoint(AbilityCommand("move", 0), UnitGetPosition(home)), c_orderQueueReplace);
        g_aprgNextPurifierMoveRefreshTime = now + 10.0;
    }
    // The mutation Purifier runs a bespoke approach/Planet Cracker loop.
    // Give it the same visible-unit-only Vortex rule as the allied boon,
    // without interrupting the Planet Cracker channel once it has started.
    if (!g_aprgPurifierCrackerIssued) { APRG_TrySlayPurifierVortex(g_aprgPurifier, player, false); }
}

void APRG_QueuePurifierAllianceEscort(int player, fixed now) {
    string unitType;
    point center;
    int owner;
    if (g_aprgPurifierAlliance == null || !UnitIsAlive(g_aprgPurifierAlliance)) { return; }
    unitType = APRG_PurifierEscortType();
    center = UnitGetPosition(g_aprgPurifierAlliance);
    owner = player;
    APRG_QueueAllyWarp(unitType, owner, center, now);
}

void APRG_QueuePurifierAllianceGroundWave(int player, fixed now) {
    int i;
    int queued = 0;
    point center;
    if (g_aprgPurifierAlliance == null || !UnitIsAlive(g_aprgPurifierAlliance)) { return; }
    center = UnitGetPosition(g_aprgPurifierAlliance);
    for (i = 0; i < 5; i += 1) {
        if (APRG_QueueAllyWarp("Zealot", player, center, now + 0.2 * IntToFixed(queued))) { queued += 1; }
    }
    for (i = 0; i < 5; i += 1) {
        if (APRG_QueueAllyWarp("Stalker", player, center, now + 0.2 * IntToFixed(queued))) { queued += 1; }
    }
}

void APRG_TickPurifierAlliance(int player, fixed now) {
    unit home;
    point spawnPoint;
    point current;
    unit target;
    unitgroup created;
    unitgroup nearbyEnemies;
    fixed speed;
    fixed life;
    fixed maxLife;
    int i;
    if (!APRG_PlayerMacroBaseReady(player) || now < 300.0) { return; }

    if (!g_aprgPurifierAllianceSpawned) {
        if (!CatalogEntryIsValid(c_gameCatalogUnit, "Purifier")) { return; }
        home = APRG_FindPlayerHomeStructure(player);
        if (home == null) { return; }
        spawnPoint = PointWithOffsetPolar(UnitGetPosition(home), 8.0, libNtve_gf_RandomAngle());
        g_aprgPurifierAllianceOwner = player;
        created = UnitCreate(1, "Purifier", c_unitCreateIgnorePlacement, player, spawnPoint, libNtve_gf_RandomAngle());
        if (created == null || UnitGroupCount(created, c_unitCountAlive) <= 0) { return; }
        g_aprgPurifierAlliance = UnitGroupUnitFromEnd(created, 1);
        if (g_aprgPurifierAlliance == null) { return; }
        APRG_RemoveSlayPurifierInvulnerability(g_aprgPurifierAlliance);
        APRG_MakeGroupUncommandable(created);
        AISetUnitScriptControlled(g_aprgPurifierAlliance, true);
        UnitSetPropertyFixed(g_aprgPurifierAlliance, c_unitPropMovementSpeed, 0.3);
        g_aprgPurifierAllianceSpawned = true;
        g_aprgPurifierAllianceHalfHealthWarped = false;
        g_aprgNextPurifierAllianceEscortTime = now + 60.0;
        g_aprgNextPurifierAllianceGroundWaveTime = now + 120.0;
        g_aprgNextPurifierAllianceMoveTime = now;
        g_aprgNextPurifierAllianceCrackerTime = now;
        g_aprgPurifierAllianceBeamStopTime = -1.0;
        MinimapPing(PlayerGroupSingle(player), UnitGetPosition(g_aprgPurifierAlliance), 6.0, Color(0.00, 80.00, 100.00));
        UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaChat, StringToText("[Slay] The Purifier has arrived"));
    }

    if (g_aprgPurifierAlliance == null || !UnitIsAlive(g_aprgPurifierAlliance)) { return; }
    APRG_RemoveSlayPurifierInvulnerability(g_aprgPurifierAlliance);
    UnitSetPropertyFixed(g_aprgPurifierAlliance, c_unitPropMovementSpeed, 0.3);
    current = UnitGetPosition(g_aprgPurifierAlliance);

    if (!g_aprgPurifierAllianceHalfHealthWarped) {
        life = UnitGetPropertyFixed(g_aprgPurifierAlliance, c_unitPropLife, c_unitPropCurrent);
        maxLife = UnitGetPropertyFixed(g_aprgPurifierAlliance, c_unitPropLifeMax, c_unitPropCurrent);
        if (maxLife > 0.0 && life <= maxLife * 0.5) {
            g_aprgPurifierAllianceHalfHealthWarped = true;
            for (i = 0; i < 4; i += 1) {
                APRG_QueueAllyWarp("VoidRay", player, current, now + 0.2 * IntToFixed(i));
            }
        }
    }

    if (g_aprgPurifierAllianceBeamStopTime > 0.0) {
        if (now >= g_aprgPurifierAllianceBeamStopTime || APRG_PurifierNearPlayerStructure(g_aprgPurifierAlliance, player, 10.0)) {
            APRG_ForceEndPurifierPlanetCracker(g_aprgPurifierAlliance);
            g_aprgPurifierAllianceBeamStopTime = -1.0;
            g_aprgNextPurifierAllianceMoveTime = now;
        }
        else {
            return;
        }
    }

    if (now >= g_aprgNextPurifierAllianceEscortTime) {
        APRG_QueuePurifierAllianceEscort(player, now);
        g_aprgNextPurifierAllianceEscortTime = now + 60.0;
    }
    if (now >= g_aprgNextPurifierAllianceGroundWaveTime) {
        APRG_QueuePurifierAllianceGroundWave(player, now);
        g_aprgNextPurifierAllianceGroundWaveTime = now + 120.0;
    }

    if (now >= g_aprgNextPurifierAllianceCrackerTime && CatalogEntryIsValid(c_gameCatalogAbil, "PurifierPlanetCracker")) {
        nearbyEnemies = UnitGroupAlliance(
            player,
            c_unitAllianceEnemy,
            RegionCircle(current, 10.0),
            UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32))),
            0
        );
        if (UnitGroupCount(nearbyEnemies, c_unitCountAlive) >= 20 && !APRG_PurifierNearPlayerStructure(g_aprgPurifierAlliance, player, 10.0)) {
            UnitIssueOrder(g_aprgPurifierAlliance, Order(AbilityCommand("PurifierPlanetCracker", 0)), c_orderQueueReplace);
            UnitIssueOrder(g_aprgPurifierAlliance, Order(AbilityCommand("move", 2)), c_orderQueueAddToEnd);
            g_aprgPurifierAllianceBeamStopTime = now + 10.0;
            g_aprgNextPurifierAllianceCrackerTime = now + 30.0;
            return;
        }
    }

    if (now >= g_aprgNextPurifierAllianceMoveTime) {
        target = APRG_NearestEligibleEnemyStructure(current, player);
        if (target == null) { target = APRG_NearestEligibleEnemyMobileUnit(current, player); }
        if (target != null) {
            APRG_OrderAttackMove(g_aprgPurifierAlliance, UnitGetPosition(target));
            if (!g_aprgPurifierAllyVOCued) {
                g_aprgPurifierAllyVOCued = true;
                APRG_QueueCampaignVO("THanson03AHorner00001", 0.0);
            }
        }
        g_aprgNextPurifierAllianceMoveTime = now + 10.0;
    }
}



bool APRG_ReflectiveArmor_Func(bool testConds, bool runActions) {
    unit victim;
    unit source;
    int player;
    int owner;
    fixed damage;
    if (!runActions || !g_aprgStarted || !APRG_HasExtension2(APRG_EXT2_BLESS_REFLECTIVE_ARMOR)) { return true; }
    victim = EventUnit();
    source = EventUnitDamageSourceUnit();
    if (victim == null || source == null || victim == source) { return true; }
    player = APRG_GetPrimaryPlayer();
    if (UnitGetOwner(victim) != player) { return true; }
    owner = UnitGetOwner(source);
    if (owner < 0 || !libNtve_gf_PlayerIsEnemy(owner, player, libNtve_ge_PlayerRelation_Enemy)) { return true; }
    damage = EventUnitDamageAmount();
    if (damage > 0.0) { APRG_DealDirectDamage(source, damage * 0.5); }
    return true;
}

void APRG_TickBuddySystem(int player, fixed now) {
    unitgroup units;
    unitgroup nearby;
    unit u;
    int i;
    if (!APRG_PlayerMacroBaseReady(player) || now < g_aprgNextBuddyCheckTime) { return; }
    g_aprgNextBuddyCheckTime = now + 1.0;
    units = APRG_PlayerMobileUnits(player);
    for (i = UnitGroupCount(units, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null) { break; }
        nearby = UnitGroupAlliance(
            player, c_unitAllianceAlly, RegionCircle(UnitGetPosition(u), 7.5),
            UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0
        );
        UnitGroupRemove(nearby, u);
        if (UnitGroupCount(nearby, c_unitCountAlive) <= 0) { APRG_DealDirectDamage(u, 50.0); }
    }
}

bool APRG_TorrasqueDamage_Func(bool testConds, bool runActions) {
    unit victim;
    unit source;
    fixed damage;
    if (!runActions || !g_aprgStarted || !APRG_HasExtension2(APRG_EXT2_MUT_TORRASQUE)) { return true; }
    source = EventUnitDamageSourceUnit();
    if (source == null || source != g_aprgTorrasque || !UnitIsAlive(source)) { return true; }
    victim = EventUnit(); if (victim == null || victim == source || !UnitIsAlive(victim)) { return true; }
    damage = EventUnitDamageAmount();
    if (damage > 0.0) { APRG_DealDirectDamage(victim, damage * (0.25 + 0.02 * IntToFixed(g_aprgTorrasqueDeaths))); }
    return true;
}

bool APRG_TorrasqueSpawnPointClear(point p, int player) {
    unitgroup nearby;
    if (p == null || APRG_PointNearMineralField(p, 5.0)) { return false; }
    nearby = UnitGroup(
        null, player, RegionCircle(p, 20.0),
        UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))),
        0
    );
    return UnitGroupCount(nearby, c_unitCountAlive) <= 0;
}

point APRG_FindTorrasqueSpawnPoint(int player) {
    int attempt;
    unit anchor;
    point p;
    for (attempt = 0; attempt < 24; attempt += 1) {
        anchor = APRG_RandomPathableHostileBaseAnchor(player);
        if (anchor == null) { continue; }
        p = APRG_FindGroundPointNear(UnitGetPosition(anchor), 4.0, 12.0);
        if (p == null) { p = UnitGetPosition(anchor); }
        if (APRG_TorrasqueSpawnPointClear(p, player)) { return p; }
    }
    return null;
}

unit APRG_FindFriendlyBlockingStructure(unit mover, point targetPoint, fixed radius) {
    int owner;
    int i;
    unit candidate;
    unit best = null;
    unitgroup nearby;
    unitgroup allies;
    fixed moverTargetDistance;
    fixed candidateTargetDistance;
    fixed candidateDistance;
    fixed bestDistance = 999999.0;
    if (mover == null || !UnitIsAlive(mover) || targetPoint == null) { return null; }
    owner = UnitGetOwner(mover);
    moverTargetDistance = DistanceBetweenPoints(UnitGetPosition(mover), targetPoint);
    nearby = UnitGroup(
        null, owner, RegionCircle(UnitGetPosition(mover), radius),
        UnitFilter(
            (1 << c_targetFilterStructure), 0, (1 << c_targetFilterMissile),
            (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)) | (1 << (c_targetFilterInvulnerable - 32))
        ), 0
    );
    allies = UnitGroupAlliance(
        owner, c_unitAllianceAlly, RegionCircle(UnitGetPosition(mover), radius),
        UnitFilter(
            (1 << c_targetFilterStructure), 0, (1 << c_targetFilterMissile),
            (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)) | (1 << (c_targetFilterInvulnerable - 32))
        ), 0
    );
    UnitGroupAddUnitGroup(nearby, allies);
    for (i = UnitGroupCount(nearby, c_unitCountAlive); i > 0; i -= 1) {
        candidate = UnitGroupUnitFromEnd(nearby, i);
        if (candidate == null || !UnitIsAlive(candidate) || candidate == mover) { continue; }
        candidateTargetDistance = DistanceBetweenPoints(UnitGetPosition(candidate), targetPoint);
        // Only clear a friendly building that is actually ahead of the stuck unit.
        if (candidateTargetDistance >= moverTargetDistance - 0.5) { continue; }
        candidateDistance = DistanceBetweenPoints(UnitGetPosition(candidate), UnitGetPosition(mover));
        if (candidateDistance < bestDistance) { best = candidate; bestDistance = candidateDistance; }
    }
    return best;
}

bool APRG_ClearFriendlyBlocker(unit mover, point targetPoint, fixed damage) {
    unit blocker;
    order attackOrder;
    if (mover == null || !UnitIsAlive(mover) || targetPoint == null) { return false; }
    blocker = APRG_FindFriendlyBlockingStructure(mover, targetPoint, 10.0);
    if (blocker == null) { return false; }
    attackOrder = OrderTargetingUnit(AbilityCommand("attack", 0), blocker);
    if (UnitOrderIsValid(mover, attackOrder)) { UnitIssueOrder(mover, attackOrder, c_orderQueueReplace); }
    // Allied structures normally cannot be attacked. Apply the attack damage directly
    // so a genuinely trapped scripted boss can carve its way out instead of stalling forever.
    APRG_DealDirectDamage(blocker, damage);
    return true;
}

void APRG_OrderTorrasqueAtPlayerBase(int player) {
    unit target;
    if (g_aprgTorrasque == null || !UnitIsAlive(g_aprgTorrasque)) { return; }
    target = APRG_FindPlayerHomeStructure(player);
    if (target == null || !UnitIsAlive(target)) {
        target = APRG_NearestPlayerStructure(UnitGetPosition(g_aprgTorrasque), player);
    }
    if (target == null || !UnitIsAlive(target)) { return; }
    AISetUnitScriptControlled(g_aprgTorrasque, false);
    UnitIssueOrder(
        g_aprgTorrasque,
        OrderTargetingPoint(AbilityCommand("attack", 0), UnitGetPosition(target)),
        c_orderQueueReplace
    );
}

void APRG_SpawnTorrasque(int player) {
    point p;
    int owner;
    unitgroup created;
    fixed maximum;
    fixed lifeFactor = 2.0 + 0.08 * IntToFixed(g_aprgTorrasqueDeaths);
    fixed scale = 125.0 + IntToFixed(g_aprgTorrasqueDeaths);
    if (!CatalogEntryIsValid(c_gameCatalogUnit, "Ultralisk")) { return; }
    p = APRG_FindTorrasqueSpawnPoint(player);
    if (p == null) {
        g_aprgTorrasqueRespawnTime = GameGetMissionTime() + 5.0;
        return;
    }
    owner = APRG_FindHostileOwnerNearPoint(player, p);
    if (owner < 0) {
        g_aprgTorrasqueRespawnTime = GameGetMissionTime() + 5.0;
        return;
    }
    created = UnitCreate(1, "Ultralisk", c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
    g_aprgTorrasque = UnitGroupUnitFromEnd(created, 1);
    if (g_aprgTorrasque == null) {
        g_aprgTorrasqueRespawnTime = GameGetMissionTime() + 5.0;
        return;
    }
    maximum = UnitGetPropertyFixed(g_aprgTorrasque, c_unitPropLifeMax, c_unitPropCurrent);
    if (maximum > 0.0) {
        UnitSetPropertyFixed(g_aprgTorrasque, c_unitPropLifeMax, maximum * lifeFactor);
        UnitSetPropertyFixed(g_aprgTorrasque, c_unitPropLife, maximum * lifeFactor);
    }
    APRG_RegisterMutationEnemyGroup(created);
    APRG_StripVoidEntityBehavior(g_aprgTorrasque);
    if (CatalogEntryIsValid(c_gameCatalogBehavior, "APRogueTorrasqueArmor")) {
        UnitBehaviorAdd(g_aprgTorrasque, "APRogueTorrasqueArmor", g_aprgTorrasque, 1);
    }
    UnitSetScale(g_aprgTorrasque, scale, scale, scale);
    // Keep the hostile Torrasque visible on the main map and minimap while
    // roaming, across every death/respawn cycle.
    APRG_RegisterAlwaysVisibleUnit(g_aprgTorrasque, player);
    APRG_OrderTorrasqueAtPlayerBase(player);
    g_aprgTorrasqueNextRetargetTime = GameGetMissionTime() + 10.0;
    g_aprgTorrasqueProgressPoint = UnitGetPosition(g_aprgTorrasque);
    g_aprgTorrasqueProgressTime = GameGetMissionTime();
    g_aprgTorrasqueRespawnTime = -1.0;
}

void APRG_TickTorrasque(int player, fixed now) {
    unit target;
    point currentPoint;
    point targetPoint;
    fixed targetDistance;
    if (!APRG_PlayerMacroBaseReady(player)) { return; }
    if (g_aprgTorrasqueFirstTime < 0.0) { g_aprgTorrasqueFirstTime = g_aprgMacroReadyTime + 240.0; }
    if (g_aprgTorrasque == null) {
        if (now >= g_aprgTorrasqueFirstTime && (g_aprgTorrasqueRespawnTime < 0.0 || now >= g_aprgTorrasqueRespawnTime)) {
            APRG_SpawnTorrasque(player);
        }
        return;
    }
    if (!UnitIsAlive(g_aprgTorrasque)) {
        if (g_aprgTorrasqueRespawnTime < 0.0) {
            g_aprgTorrasqueDeaths += 1;
            g_aprgTorrasqueRespawnTime = now + 5.0;
        }
        if (now >= g_aprgTorrasqueRespawnTime) {
            g_aprgTorrasque = null;
            APRG_SpawnTorrasque(player);
        }
        return;
    }
    if (g_aprgTorrasqueNextRetargetTime < 0.0 || now >= g_aprgTorrasqueNextRetargetTime) {
        APRG_OrderTorrasqueAtPlayerBase(player);
        g_aprgTorrasqueNextRetargetTime = now + 10.0;
    }

    // If the Torrasque has made essentially no progress for 30 seconds while still
    // far from the player, let it break allied buildings that are physically in the way.
    currentPoint = UnitGetPosition(g_aprgTorrasque);
    target = APRG_NearestPlayerStructure(currentPoint, player);
    if (target != null) {
        targetPoint = UnitGetPosition(target);
        targetDistance = DistanceBetweenPoints(currentPoint, targetPoint);
        if (g_aprgTorrasqueProgressPoint == null || DistanceBetweenPoints(currentPoint, g_aprgTorrasqueProgressPoint) >= 2.0 || targetDistance <= 10.0) {
            g_aprgTorrasqueProgressPoint = currentPoint;
            g_aprgTorrasqueProgressTime = now;
        }
        else if (g_aprgTorrasqueProgressTime >= 0.0 && now - g_aprgTorrasqueProgressTime >= 30.0) {
            if (!APRG_ClearFriendlyBlocker(g_aprgTorrasque, targetPoint, 180.0)) {
                g_aprgTorrasqueProgressPoint = currentPoint;
                g_aprgTorrasqueProgressTime = now;
                APRG_OrderTorrasqueAtPlayerBase(player);
            }
        }
    }
}

void APRG_EnsureNormalShieldRegeneration(unit u) {
    int owner;
    string unitType;
    fixed catalogRate;
    fixed delay;
    if (u == null || !UnitIsAlive(u)) { return; }
    owner = UnitGetOwner(u);
    unitType = UnitGetType(u);
    if (unitType == "" || !CatalogEntryIsValid(c_gameCatalogUnit, unitType)) { return; }
    catalogRate = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "ShieldRegenRate", owner));
    if (catalogRate > 0.0) { return; }
    CatalogFieldValueSet(c_gameCatalogUnit, unitType, "ShieldRegenRate", owner, "2.0");
    delay = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "ShieldRegenDelay", owner));
    if (delay <= 0.0) { CatalogFieldValueSet(c_gameCatalogUnit, unitType, "ShieldRegenDelay", owner, "10.0"); }
    UnitSetPropertyFixed(u, c_unitPropShieldsRegen, 2.0);
}

void APRG_ApplyNexusShieldToEnemies(int player) {
    unitgroup enemies;
    unit u;
    int i;
    fixed maximum;
    fixed current;
    if (g_aprgNexusShieldBroken) { return; }
    enemies = APRG_EnemyMobileUnits(player);
    for (i = UnitGroupCount(enemies, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(enemies, i);
        if (u == null) { break; }
        if (UnitGroupHasUnit(g_aprgNexusShieldProcessed, u)) { continue; }
        maximum = UnitGetPropertyFixed(u, c_unitPropShieldsMax, c_unitPropCurrent);
        current = UnitGetPropertyFixed(u, c_unitPropShields, c_unitPropCurrent);
        UnitSetPropertyFixed(u, c_unitPropShieldsMax, maximum + 300.0);
        UnitSetPropertyFixed(u, c_unitPropShields, current + 300.0);
        APRG_EnsureNormalShieldRegeneration(u);
        UnitGroupAdd(g_aprgNexusShieldProcessed, u);
    }
}

void APRG_BreakNexusShield() {
    int i;
    unit u;
    fixed maximum;
    fixed current;
    if (g_aprgNexusShieldBroken) { return; }
    g_aprgNexusShieldBroken = true;
    for (i = UnitGroupCount(g_aprgNexusShieldProcessed, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(g_aprgNexusShieldProcessed, i);
        if (u == null) { break; }
        maximum = UnitGetPropertyFixed(u, c_unitPropShieldsMax, c_unitPropCurrent);
        current = UnitGetPropertyFixed(u, c_unitPropShields, c_unitPropCurrent);
        UnitSetPropertyFixed(u, c_unitPropShieldsMax, MaxF(0.0, maximum - 300.0));
        UnitSetPropertyFixed(u, c_unitPropShields, MinF(current, MaxF(0.0, maximum - 300.0)));
    }
}

void APRG_TickNexusShield(int player) {
    unit anchor;
    unit home;
    point p;
    int owner;
    int attempt;
    unitgroup created;
    fixed shields;
    fixed maxShields;
    fixed now;
    int nexusOwner;
    if (!APRG_PlayerMacroBaseReady(player)) { return; }
    if (!g_aprgNexusShieldSpawned) {
        anchor = APRG_RandomHostileBaseAnchor(player);
        home = APRG_FindPlayerHomeStructure(player);
        if (anchor == null || home == null || !CatalogEntryIsValid(c_gameCatalogUnit, "Nexus")) { return; }
        p = null;
        for (attempt = 0; attempt < APRG_MAX_POINT_ATTEMPTS; attempt += 1) {
            p = PointWithOffsetPolar(UnitGetPosition(home), RandomFixed(30.0, 60.0), libNtve_gf_RandomAngle());
            if (p == null || !RegionContainsPoint(RegionPlayableMap(), p) || !PointPathingPassable(p)) { p = null; continue; }
            if ((APRG_GroundSpawnsNeedPlayerPathing() && !PointPathingIsConnected(p, UnitGetPosition(home))) || APRG_PointNearRakShirDuel(p, 24.0)) { p = null; continue; }
            if (APRG_PointNearPlayerOrAlliedBuilding(p, player, 15.0)) { p = null; continue; }
            break;
        }
        if (p == null) { return; }
        owner = UnitGetOwner(anchor);
        created = UnitCreate(1, "Nexus", c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
        g_aprgNexusShieldNexus = UnitGroupUnitFromEnd(created, 1);
        APRG_RegisterMutationEnemyGroup(created);
        if (g_aprgNexusShieldNexus != null) {
            APRG_StripVoidEntityBehavior(g_aprgNexusShieldNexus);
            APRG_RegisterAlwaysVisibleUnit(g_aprgNexusShieldNexus, player);
        }
        g_aprgNexusShieldSpawned = true;
    }
    if (g_aprgNexusShieldNexus == null || !UnitIsAlive(g_aprgNexusShieldNexus)) { APRG_BreakNexusShield(); return; }
    shields = UnitGetPropertyFixed(g_aprgNexusShieldNexus, c_unitPropShields, c_unitPropCurrent);
    maxShields = UnitGetPropertyFixed(g_aprgNexusShieldNexus, c_unitPropShieldsMax, c_unitPropCurrent);
    now = GameGetMissionTime();
    nexusOwner = UnitGetOwner(g_aprgNexusShieldNexus);

    if (!g_aprgNexusShieldFirstDamageWarped && maxShields > 0.0 && shields <= maxShields - 10.0) {
        g_aprgNexusShieldFirstDamageWarped = true;
        APRG_QueuePurifierHostileWarp("Zealot", nexusOwner, UnitGetPosition(g_aprgNexusShieldNexus), now);
    }
    if (!g_aprgNexusShieldHalfShieldsWarped && maxShields > 0.0 && shields <= maxShields * 0.5) {
        g_aprgNexusShieldHalfShieldsWarped = true;
        APRG_QueuePurifierHostileWarp("Stalker", nexusOwner, UnitGetPosition(g_aprgNexusShieldNexus), now + 0.2);
    }
    if (!g_aprgNexusShieldDepletedWarped && maxShields > 0.0 && shields <= 0.5) {
        g_aprgNexusShieldDepletedWarped = true;
        for (attempt = 0; attempt < 4; attempt += 1) {
            APRG_QueuePurifierHostileWarp("Zealot", nexusOwner, UnitGetPosition(g_aprgNexusShieldNexus), now + 0.2 * IntToFixed(attempt + 2));
            APRG_QueuePurifierHostileWarp("Stalker", nexusOwner, UnitGetPosition(g_aprgNexusShieldNexus), now + 0.2 * IntToFixed(attempt + 5));
        }
    }
    APRG_ApplyNexusShieldToEnemies(player);
}

void APRG_UpdateGargantuanTypeBonuses(unit u, int owner, string keyPrefix) {
    string unitType = UnitGetType(u);
    string weaponType;
    string effectType;
    string key;
    int wi;
    int wc;
    fixed currentValue;
    fixed priorBonus;
    fixed baseValue;
    fixed desiredBonus;
    fixed delta;
    wc = UnitWeaponCount(u);
    for (wi = 1; wi <= wc; wi += 1) {
        weaponType = UnitWeaponGet(u, wi); if (weaponType == "") { continue; }
        effectType = CatalogFieldValueGet(c_gameCatalogWeapon, weaponType, "DisplayEffect", owner);
        if (effectType != "" && CatalogEntryIsValid(c_gameCatalogEffect, effectType)) {
            key = keyPrefix + "Damage_" + IntToString(owner) + "_" + effectType;
            currentValue = StringToFixed(CatalogFieldValueGet(c_gameCatalogEffect, effectType, "Amount", owner)); priorBonus = DataTableGetFixed(true, key);
            baseValue = currentValue - priorBonus; desiredBonus = baseValue * 0.5; delta = desiredBonus - priorBonus;
            if (delta > 0.001 || delta < -0.001) { CatalogFieldValueModify(c_gameCatalogEffect, effectType, "Amount", owner, FixedToString(delta, c_fixedPrecisionAny), c_upgradeOperationAdd); }
            DataTableSetFixed(true, key, desiredBonus);
        }
        key = keyPrefix + "Range_" + IntToString(owner) + "_" + weaponType;
        currentValue = StringToFixed(CatalogFieldValueGet(c_gameCatalogWeapon, weaponType, "Range", owner)); priorBonus = DataTableGetFixed(true, key);
        baseValue = currentValue - priorBonus; desiredBonus = baseValue * 0.5; delta = desiredBonus - priorBonus;
        if (delta > 0.001 || delta < -0.001) { CatalogFieldValueModify(c_gameCatalogWeapon, weaponType, "Range", owner, FixedToString(delta, c_fixedPrecisionAny), c_upgradeOperationAdd); }
        DataTableSetFixed(true, key, desiredBonus);
    }
}

void APRG_ApplyGargantuanEnemies(int player) {
    unitgroup enemies;
    unit u;
    int i;
    int owner;
    fixed maximum;
    fixed current;
    fixed ratio;
    enemies = APRG_EnemyMobileUnits(player);
    for (i = UnitGroupCount(enemies, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(enemies, i);
        if (u == null) { break; }
        owner = UnitGetOwner(u);
        APRG_UpdateGargantuanTypeBonuses(u, owner, "APRG_GargEnemy_");
        if (UnitGroupHasUnit(g_aprgGargantuanProcessed, u)) { continue; }
        maximum = UnitGetPropertyFixed(u, c_unitPropLifeMax, c_unitPropCurrent);
        current = UnitGetPropertyFixed(u, c_unitPropLife, c_unitPropCurrent);
        if (maximum > 0.0) {
            ratio = current / maximum;
            UnitSetPropertyFixed(u, c_unitPropLifeMax, maximum * 1.5);
            UnitSetPropertyFixed(u, c_unitPropLife, maximum * 1.5 * ratio);
        }
        APRG_ScaleUnitShields(u, 1.5);
        UnitSetScale(u, 150.0, 150.0, 150.0);
        UnitGroupAdd(g_aprgGargantuanProcessed, u);
    }
}


void APRG_ApplyGargantuanToTrainedUnit(unit u, int player) {
    fixed maximum;
    fixed current;
    fixed ratio;
    fixed maxRange = 0.0;
    fixed weaponRange;
    int wi;
    int wc;
    int stacks;
    if (u == null || !UnitIsAlive(u) || UnitGetOwner(u) != player) { return; }
    if (UnitTypeTestAttribute(UnitGetType(u), c_unitAttributeStructure)) { return; }
    if (UnitGroupHasUnit(g_aprgGargantuanPlayerProcessed, u)) { return; }

    if (CatalogEntryIsValid(c_gameCatalogBehavior, "APRogueGargantuanTrainedDamage")) {
        UnitBehaviorAdd(u, "APRogueGargantuanTrainedDamage", u, 1);
    }
    wc = UnitWeaponCount(u);
    for (wi = 1; wi <= wc; wi += 1) {
        weaponRange = UnitWeaponRange(u, wi);
        if (weaponRange > maxRange) { maxRange = weaponRange; }
    }
    if (maxRange > 0.0 && CatalogEntryIsValid(c_gameCatalogBehavior, "APRogueGargantuanRangeQuarter")) {
        stacks = MaxI(1, FixedToInt(RoundI(maxRange * 2.0)));
        UnitBehaviorAdd(u, "APRogueGargantuanRangeQuarter", u, stacks);
    }

    maximum = UnitGetPropertyFixed(u, c_unitPropLifeMax, c_unitPropCurrent);
    current = UnitGetPropertyFixed(u, c_unitPropLife, c_unitPropCurrent);
    if (maximum > 0.0) {
        ratio = current / maximum;
        UnitSetPropertyFixed(u, c_unitPropLifeMax, maximum * 1.5);
        UnitSetPropertyFixed(u, c_unitPropLife, maximum * 1.5 * ratio);
    }
    APRG_ScaleUnitShields(u, 1.5);
    UnitSetScale(u, 150.0, 150.0, 150.0);
    UnitGroupAdd(g_aprgGargantuanPlayerProcessed, u);
}

void APRG_ApplyGargantuanPlayerUnits(int player) {
}


bool APRG_IsDefensiveStructureType(string unitType) {
    return
        StringContains(unitType, "Bunker", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "MissileTurret", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "DevastatorTurret", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "PerditionTurret", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "PlanetaryFortress", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "PsiDisrupter", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "HiveMindEmulator", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "SpineCrawler", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "SporeCrawler", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "BileLauncher", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "PhotonCannon", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "KhaydarinMonolith", c_stringAnywhere, c_stringNoCase);
}

bool APRG_IsFieryUnitType(string unitType) {
    if (unitType == "") { return false; }
    if (StringContains(unitType, "Colossus", c_stringAnywhere, c_stringNoCase)) {
        return unitType == "Colossus" || unitType == "AP_Colossus";
    }
    return
        StringContains(unitType, "Hellion", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Firebat", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "DevilDog", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Hellbat", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "PerditionTurret", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Igniter", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Flame", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Fire", c_stringAnywhere, c_stringNoCase);
}

bool APRG_IsInsidePlayerBunker(unit source, int player) {
    unit transport;
    if (source == null) { return false; }
    transport = UnitTransport(source);
    if (transport == null || UnitGetOwner(transport) != player) { return false; }
    return StringContains(UnitGetType(transport), "Bunker", c_stringAnywhere, c_stringNoCase);
}

bool APRG_DefenderDamage_Func(bool testConds, bool runActions) {
    unit victim;
    unit source;
    int player;
    int owner;
    fixed damage;
    fixed bonusMultiplier;
    string sourceType;
    if (!runActions || !g_aprgStarted || g_aprgDefenderBonusDamageBusy) { return true; }
    if (!APRG_HasExtension2(APRG_EXT2_BOON_DEFENDER) && !APRG_HasExtension3(APRG_EXT3_BOON_MISSILE_DEFENSE)) { return true; }
    victim = EventUnit();
    source = EventUnitDamageSourceUnit();
    if (victim == null || source == null || victim == source) { return true; }
    player = APRG_GetPrimaryPlayer();
    if (UnitGetOwner(source) != player) { return true; }
    owner = UnitGetOwner(victim);
    if (owner < 0 || !libNtve_gf_PlayerIsEnemy(owner, player, libNtve_ge_PlayerRelation_Enemy)) { return true; }
    sourceType = UnitGetType(source);
    bonusMultiplier = 0.0;
    if (APRG_HasExtension2(APRG_EXT2_BOON_DEFENDER) && !APRG_IsDefensiveStructureType(sourceType) && APRG_IsInsidePlayerBunker(source, player)) {
        bonusMultiplier += 0.5;
    }
    if (APRG_HasExtension3(APRG_EXT3_BOON_MISSILE_DEFENSE) && StringContains(sourceType, "MissileTurret", c_stringAnywhere, c_stringNoCase)) {
        bonusMultiplier += 0.5;
    }
    if (bonusMultiplier <= 0.0) { return true; }
    damage = EventUnitDamageAmount();
    if (damage <= 0.0) { return true; }
    g_aprgDefenderBonusDamageBusy = true;
    APRG_DealDirectDamage(victim, damage * bonusMultiplier);
    g_aprgDefenderBonusDamageBusy = false;
    return true;
}

void APRG_ApplyFirePower(int player) {
    unitgroup units;
    unit u;
    int i;
    int wi;
    int wc;
    int applied;
    string unitType;
    string weaponType;
    string key;
    fixed oldMultiplier;
    fixed newMultiplier;
    fixed periodMultiplier;
    if (g_aprgFirePowerStacks <= 0) { return; }
    units = APRG_PlayerMobileUnits(player);
    // Perdition Turrets are structures, not mobile units.
    UnitGroupAddUnitGroup(units, APRG_PlayerStructures(player));
    for (i = UnitGroupCount(units, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null) { continue; }
        unitType = UnitGetType(u);
        if (!APRG_IsFieryUnitType(unitType)) { continue; }
        wc = UnitWeaponCount(u);
        for (wi = 1; wi <= wc; wi += 1) {
            weaponType = UnitWeaponGet(u, wi);
            if (weaponType == "") { continue; }
            key = "APRG_FirePowerApplied_" + IntToString(player) + "_" + weaponType;
            applied = DataTableGetInt(true, key);
            if (applied < g_aprgFirePowerStacks) {
                // A single multiplicative catalog update replaces up to 1000
                // per-weapon updates while retaining ADDITIVE attack-speed stacks.
                oldMultiplier = 1.0 + 0.02 * IntToFixed(applied);
                newMultiplier = 1.0 + 0.02 * IntToFixed(g_aprgFirePowerStacks);
                periodMultiplier = oldMultiplier / newMultiplier;
                CatalogFieldValueModify(
                    c_gameCatalogWeapon,
                    weaponType,
                    "Period",
                    player,
                    FixedToString(periodMultiplier, c_fixedPrecisionAny),
                    c_upgradeOperationMultiply
                );
                applied = g_aprgFirePowerStacks;
            }
            DataTableSetInt(true, key, applied);
        }
    }
}

bool APRG_IsAdamantiumMeleeWeapon(unit u, int weaponIndex) {
    string weaponType;
    string meleeFlag;
    fixed range;
    if (u == null || weaponIndex <= 0 || weaponIndex > UnitWeaponCount(u)) { return false; }
    if (!UnitWeaponIsEnabled(u, weaponIndex)) { return false; }
    weaponType = UnitWeaponGet(u, weaponIndex);
    if (weaponType == "") { return false; }

    meleeFlag = CatalogFieldValueGet(c_gameCatalogWeapon, weaponType, "Options[Melee]", UnitGetOwner(u));
    if (meleeFlag == "1" || meleeFlag == "true" || meleeFlag == "True") { return true; }
    range = UnitWeaponRange(u, weaponIndex);
    return range >= 0.0 && range <= 0.5;
}

void APRG_ReconcileAdamantiumDamageField(string effectType, int player, string fieldPath, string fieldKey) {
    string key;
    string amountText;
    fixed currentAmount;
    fixed priorBonus;
    fixed baseAmount;
    fixed desiredBonus;
    fixed delta;
    if (effectType == "" || !CatalogEntryIsValid(c_gameCatalogEffect, effectType)) { return; }
    amountText = CatalogFieldValueGet(c_gameCatalogEffect, effectType, fieldPath, player);
    if (amountText == "") { return; }
    currentAmount = StringToFixed(amountText);
    if (currentAmount == 0.0) { return; }

    key = "APRG_AdamantiumBonus_" + IntToString(player) + "_" + effectType + "_" + fieldKey;
    priorBonus = DataTableGetFixed(true, key);
    baseAmount = currentAmount - priorBonus;
    if (fieldKey == "Amount") {
        baseAmount -= DataTableGetFixed(true, "APRG_BoonDeadlyBonus_" + IntToString(player) + "_" + effectType);
    }
    desiredBonus = baseAmount;
    delta = desiredBonus - priorBonus;
    if (delta > 0.001 || delta < -0.001) {
        CatalogFieldValueModify(c_gameCatalogEffect, effectType, fieldPath, player, FixedToString(delta, c_fixedPrecisionAny), c_upgradeOperationAdd);
    }
    DataTableSetFixed(true, key, desiredBonus);
}

void APRG_ReconcileAdamantiumDamageEffect(string effectType, int player) {
    if (effectType == "" || !CatalogEntryIsValid(c_gameCatalogEffect, effectType)) { return; }
    APRG_ReconcileAdamantiumDamageField(effectType, player, "Amount", "Amount");
    APRG_ReconcileAdamantiumDamageField(effectType, player, "AttributeBonus[Light]", "Light");
    APRG_ReconcileAdamantiumDamageField(effectType, player, "AttributeBonus[Armored]", "Armored");
    APRG_ReconcileAdamantiumDamageField(effectType, player, "AttributeBonus[Biological]", "Biological");
    APRG_ReconcileAdamantiumDamageField(effectType, player, "AttributeBonus[Mechanical]", "Mechanical");
    APRG_ReconcileAdamantiumDamageField(effectType, player, "AttributeBonus[Massive]", "Massive");
    APRG_ReconcileAdamantiumDamageField(effectType, player, "AttributeBonus[Psionic]", "Psionic");
    APRG_ReconcileAdamantiumDamageField(effectType, player, "AttributeBonus[Structure]", "Structure");
    APRG_ReconcileAdamantiumDamageField(effectType, player, "AttributeBonus[Heroic]", "Heroic");
}

string APRG_AdamantiumChildEffect(string effectType, int player, int childIndex) {
    if (effectType == "" || !CatalogEntryIsValid(c_gameCatalogEffect, effectType)) { return ""; }
    if (childIndex == 0) { return CatalogFieldValueGet(c_gameCatalogEffect, effectType, "Effect", player); }
    if (childIndex == 1) { return CatalogFieldValueGet(c_gameCatalogEffect, effectType, "ImpactEffect", player); }
    if (childIndex == 2) { return CatalogFieldValueGet(c_gameCatalogEffect, effectType, "FinalEffect", player); }
    if (childIndex == 3) { return CatalogFieldValueGet(c_gameCatalogEffect, effectType, "LaunchEffect", player); }
    if (childIndex == 4) { return CatalogFieldValueGet(c_gameCatalogEffect, effectType, "InitialEffect", player); }
    if (childIndex == 5) { return CatalogFieldValueGet(c_gameCatalogEffect, effectType, "PeriodicEffect", player); }
    if (childIndex >= 6 && childIndex < 22) {
        return CatalogFieldValueGet(c_gameCatalogEffect, effectType, "EffectArray[" + IntToString(childIndex - 6) + "]", player);
    }
    return "";
}

void APRG_ReconcileAdamantiumWeapons(unit u, int player) {
    int wi;
    int wc;
    int ci;
    int gi;
    int hi;
    string weaponType;
    string rootEffect;
    string childEffect;
    string grandchildEffect;
    string greatGrandchildEffect;
    if (u == null || !UnitIsAlive(u)) { return; }
    wc = UnitWeaponCount(u);
    for (wi = 1; wi <= wc; wi += 1) {
        if (!APRG_IsAdamantiumMeleeWeapon(u, wi)) { continue; }
        weaponType = UnitWeaponGet(u, wi);
        if (weaponType == "") { continue; }
        rootEffect = CatalogFieldValueGet(c_gameCatalogWeapon, weaponType, "DisplayEffect", player);
        if (rootEffect == "") { rootEffect = CatalogFieldValueGet(c_gameCatalogWeapon, weaponType, "Effect", player); }
        if (rootEffect == "" || !CatalogEntryIsValid(c_gameCatalogEffect, rootEffect)) { continue; }

        APRG_ReconcileAdamantiumDamageEffect(rootEffect, player);
        for (ci = 0; ci < 22; ci += 1) {
            childEffect = APRG_AdamantiumChildEffect(rootEffect, player, ci);
            if (childEffect == "" || childEffect == rootEffect) { continue; }
            APRG_ReconcileAdamantiumDamageEffect(childEffect, player);
            for (gi = 0; gi < 22; gi += 1) {
                grandchildEffect = APRG_AdamantiumChildEffect(childEffect, player, gi);
                if (grandchildEffect == "" || grandchildEffect == childEffect || grandchildEffect == rootEffect) { continue; }
                APRG_ReconcileAdamantiumDamageEffect(grandchildEffect, player);
                for (hi = 0; hi < 22; hi += 1) {
                    greatGrandchildEffect = APRG_AdamantiumChildEffect(grandchildEffect, player, hi);
                    if (greatGrandchildEffect == "" || greatGrandchildEffect == grandchildEffect || greatGrandchildEffect == childEffect || greatGrandchildEffect == rootEffect) { continue; }
                    APRG_ReconcileAdamantiumDamageEffect(greatGrandchildEffect, player);
                }
            }
        }
    }
}


// Deadly Vultures modifies the actual SC2 weapon damage effects, not a
// damage-event callback.  Modifiers are player-local and one-time per effect,
// just like Concussed Shells, to avoid repeated 10x stacking on every tick.
// Only positive Amounts and positive armor-class bonuses are scaled.  In
// particular never modify signed values of effect wrappers / other fields.
void APRG_DeadlyVultureMultiplyDamageField(string effectType, int player, string field) {
    string valueText;
    fixed value;
    if (effectType == "" || !CatalogEntryIsValid(c_gameCatalogEffect, effectType)) { return; }
    valueText = CatalogFieldValueGet(c_gameCatalogEffect, effectType, field, player);
    if (valueText == "") { return; }
    value = StringToFixed(valueText);
    if (value <= 0.0) { return; }
    // Keep catalog arithmetic bounded even if other boons/mission upgrades
    // have already amplified the effect. Do not let fixed-point overflow.
    CatalogFieldValueSet(c_gameCatalogEffect, effectType, field, player,
        FixedToString(MinF(value * 10.0, 3000.0), c_fixedPrecisionAny));
}

void APRG_DeadlyVultureMultiplyDamageEffect(string effectType, int player) {
    string key;
    string amount;
    if (effectType == "" || !CatalogEntryIsValid(c_gameCatalogEffect, effectType)) { return; }
    key = "APRG_DeadlyVultureWeaponEffect_" + IntToString(player) + "_" + effectType;
    if (DataTableGetBool(true, key)) { return; }
    amount = CatalogFieldValueGet(c_gameCatalogEffect, effectType, "Amount", player);
    // Most launch/set/search/wrapper effects have no positive base damage;
    // skip them rather than accidentally multiplying behavior magnitudes.
    if (amount == "" || StringToFixed(amount) <= 0.0) { return; }
    APRG_DeadlyVultureMultiplyDamageField(effectType, player, "Amount");
    APRG_DeadlyVultureMultiplyDamageField(effectType, player, "AttributeBonus[Light]");
    APRG_DeadlyVultureMultiplyDamageField(effectType, player, "AttributeBonus[Armored]");
    APRG_DeadlyVultureMultiplyDamageField(effectType, player, "AttributeBonus[Biological]");
    APRG_DeadlyVultureMultiplyDamageField(effectType, player, "AttributeBonus[Mechanical]");
    APRG_DeadlyVultureMultiplyDamageField(effectType, player, "AttributeBonus[Massive]");
    APRG_DeadlyVultureMultiplyDamageField(effectType, player, "AttributeBonus[Psionic]");
    APRG_DeadlyVultureMultiplyDamageField(effectType, player, "AttributeBonus[Structure]");
    APRG_DeadlyVultureMultiplyDamageField(effectType, player, "AttributeBonus[Heroic]");
    DataTableSetBool(true, key, true);
}

void APRG_DeadlyVultureMultiplyEffectTree(string rootEffect, int player) {
    int ci;
    int gi;
    string child;
    string grandchild;
    if (rootEffect == "" || !CatalogEntryIsValid(c_gameCatalogEffect, rootEffect)) { return; }
    APRG_DeadlyVultureMultiplyDamageEffect(rootEffect, player);
    // AP Vulture variants may launch via a Set / missile impact rather than
    // a direct DisplayEffect. Follow only this weapon's own effect graph.
    for (ci = 0; ci < 22; ci += 1) {
        child = APRG_AdamantiumChildEffect(rootEffect, player, ci);
        if (child == "" || child == rootEffect) { continue; }
        APRG_DeadlyVultureMultiplyDamageEffect(child, player);
        for (gi = 0; gi < 22; gi += 1) {
            grandchild = APRG_AdamantiumChildEffect(child, player, gi);
            if (grandchild == "" || grandchild == child || grandchild == rootEffect) { continue; }
            APRG_DeadlyVultureMultiplyDamageEffect(grandchild, player);
        }
    }
}

void APRG_ApplyDeadlyVultureWeaponStats(unit u, int player) {
    int wi;
    int wc;
    string unitType;
    string weaponType;
    string displayEffect;
    string realEffect;
    string key;
    if (u == null || !UnitIsAlive(u)) { return; }
    unitType = UnitGetType(u);
    if (!StringContains(unitType, "Vulture", c_stringAnywhere, c_stringNoCase)) { return; }
    wc = UnitWeaponCount(u);
    for (wi = 1; wi <= wc; wi += 1) {
        weaponType = UnitWeaponGet(u, wi);
        if (weaponType == "") { continue; }
        key = "APRG_DeadlyVultureWeaponVisited_" + IntToString(player) + "_" + weaponType;
        if (DataTableGetBool(true, key)) { continue; }
        displayEffect = CatalogFieldValueGet(c_gameCatalogWeapon, weaponType, "DisplayEffect", player);
        realEffect = CatalogFieldValueGet(c_gameCatalogWeapon, weaponType, "Effect", player);
        APRG_DeadlyVultureMultiplyEffectTree(displayEffect, player);
        if (realEffect != displayEffect) {
            APRG_DeadlyVultureMultiplyEffectTree(realEffect, player);
        }
        // The weapon may be present in the catalog before new Vultures spawn.
        // Each effect itself is independently guarded for shared weapon IDs.
        DataTableSetBool(true, key, true);
    }
}

void APRG_ApplyBoonCombatStats(int player) {
    unitgroup units;
    unitgroup mobileUnits;
    unit u;
    int i;
    int wi;
    int wc;
    string unitType;
    string weaponType;
    string effectType;
    string key;
    fixed value;
    fixed priorBonus;
    fixed baseValue;
    fixed desiredBonus;
    fixed delta;
    fixed maximum;
    fixed current;
    units = APRG_PlayerAllUnits(player);
    mobileUnits = APRG_PlayerMobileUnits(player);
    for (i = UnitGroupCount(units, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null) { break; }
        unitType = UnitGetType(u);
        if (APRG_HasExtension3(APRG_EXT3_BOON_MISSILE_DEFENSE) && StringContains(unitType, "MissileTurret", c_stringAnywhere, c_stringNoCase)) {
            key = "APRG_MissileDefenseHP_" + IntToString(UnitGetTag(u));
            if (!DataTableGetBool(true, key)) {
                maximum = UnitGetPropertyFixed(u, c_unitPropLifeMax, c_unitPropCurrent);
                current = UnitGetPropertyFixed(u, c_unitPropLife, c_unitPropCurrent);
                if (maximum > 0.0) {
                    UnitSetPropertyFixed(u, c_unitPropLifeMax, maximum * 1.5);
                    UnitSetPropertyFixed(u, c_unitPropLife, current * 1.5);
                }
                DataTableSetBool(true, key, true);
            }
        }
        if (APRG_HasExtension2(APRG_EXT2_BOON_AUTO_REPAIR) && g_aprgAutoRepairStacks > 0) {
            key = "APRG_BoonRepairStacks_" + IntToString(UnitGetTag(u));
            wi = DataTableGetInt(true, key);
            while (wi < g_aprgAutoRepairStacks) {
                UnitSetPropertyFixed(u, c_unitPropLifeRegen, UnitGetPropertyFixed(u, c_unitPropLifeRegen, c_unitPropCurrent) + 1.0);
                UnitSetPropertyFixed(u, c_unitPropShieldsRegen, UnitGetPropertyFixed(u, c_unitPropShieldsRegen, c_unitPropCurrent) + 1.0);
                wi += 1;
            }
            DataTableSetInt(true, key, wi);
        }
        if (APRG_HasExtension2(APRG_EXT2_BOON_HEAVY_ARMOR) && (
            APRG_IsThorFamilyType(unitType) || APRG_IsUltraliskFamilyType(unitType) ||
            StringContains(unitType,"Archon",c_stringAnywhere,c_stringNoCase))) {
            key = "APRG_BoonHeavy_" + IntToString(player) + "_" + unitType;
            if (!DataTableGetBool(true, key)) {
                CatalogFieldValueModify(c_gameCatalogUnit, unitType, "LifeArmor", player, "5.0", c_upgradeOperationAdd);
                CatalogFieldValueModify(c_gameCatalogUnit, unitType, "ShieldArmor", player, "5.0", c_upgradeOperationAdd);
                DataTableSetBool(true, key, true);
            }
        }
        if (APRG_HasBlessing(APRG_BOON_ADAMANTIUM_BLADES)) {
            APRG_ReconcileAdamantiumWeapons(u, player);
        }
        if (APRG_HasExtension4(APRG_EXT4_BOON_DEADLY_VULTURES)) {
            APRG_ApplyDeadlyVultureWeaponStats(u, player);
        }
        wc = UnitWeaponCount(u);
        for (wi = 1; wi <= wc; wi += 1) {
            weaponType = UnitWeaponGet(u, wi);
            if (weaponType == "") { continue; }
            if (APRG_HasExtension3(APRG_EXT3_BOON_MISSILE_DEFENSE) && StringContains(unitType, "MissileTurret", c_stringAnywhere, c_stringNoCase)) {
                key = "APRG_MissileDefenseWeapon_" + IntToString(player) + "_" + weaponType;
                if (!DataTableGetBool(true, key)) {
                    CatalogFieldValueModify(c_gameCatalogWeapon, weaponType, "Range", player, "1.5", c_upgradeOperationMultiply);
                    CatalogFieldValueModify(c_gameCatalogWeapon, weaponType, "Period", player, FixedToString(1.0 / 1.5, c_fixedPrecisionAny), c_upgradeOperationMultiply);
                    DataTableSetBool(true, key, true);
                }
            }
            if (APRG_HasExtension2(APRG_EXT2_BOON_DEFENDER) && APRG_IsDefensiveStructureType(unitType)) {
                key = "APRG_BoonDefenderWeapon_" + IntToString(player) + "_" + weaponType;
                if (!DataTableGetBool(true, key)) {
                    CatalogFieldValueModify(c_gameCatalogWeapon, weaponType, "Range", player, "1.5", c_upgradeOperationMultiply);
                    effectType = CatalogFieldValueGet(c_gameCatalogWeapon, weaponType, "DisplayEffect", player);
                    if (effectType != "" && CatalogEntryIsValid(c_gameCatalogEffect, effectType)) {
                        value = StringToFixed(CatalogFieldValueGet(c_gameCatalogEffect, effectType, "Amount", player));
                        if (value > 0.0) {
                            CatalogFieldValueModify(c_gameCatalogEffect, effectType, "Amount", player, "1.5", c_upgradeOperationMultiply);
                        }
                    }
                    DataTableSetBool(true, key, true);
                }
            }
            if (APRG_HasExtension2(APRG_EXT2_BOON_RAPID_FIRE)) {
                key = "APRG_BoonRapid_" + IntToString(player) + "_" + weaponType;
                if (!DataTableGetBool(true, key)) {
                    CatalogFieldValueModify(c_gameCatalogWeapon, weaponType, "Period", player, FixedToString(1.0/1.3,c_fixedPrecisionAny), c_upgradeOperationMultiply);
                    DataTableSetBool(true, key, true);
                }
            }
            if (APRG_HasExtension2(APRG_EXT2_BOON_INTERPLANETARY_FORTRESS) && StringContains(unitType,"PlanetaryFortress",c_stringAnywhere,c_stringNoCase)) {
                key = "APRG_BoonPF_" + IntToString(player) + "_" + weaponType;
                if (!DataTableGetBool(true, key)) {
                    CatalogFieldValueModify(c_gameCatalogWeapon, weaponType, "Range", player, "100.0", c_upgradeOperationAdd);
                    DataTableSetBool(true, key, true);
                }
            }
            if (APRG_HasExtension2(APRG_EXT2_BOON_DEADLY_WEAPONS) && g_aprgDeadlyWeaponsStacks > 0) {
                effectType = CatalogFieldValueGet(c_gameCatalogWeapon, weaponType, "DisplayEffect", player);
                key = "APRG_BoonDeadlyBonus_" + IntToString(player) + "_" + effectType;
                if (effectType != "" && CatalogEntryIsValid(c_gameCatalogEffect,effectType)) {
                    value = StringToFixed(CatalogFieldValueGet(c_gameCatalogEffect, effectType, "Amount", player));
                    priorBonus = DataTableGetFixed(true, key);
                    baseValue = value - priorBonus;
                    desiredBonus = baseValue * 0.25 * IntToFixed(g_aprgDeadlyWeaponsStacks);
                    delta = desiredBonus - priorBonus;
                    if (delta > 0.001 || delta < -0.001) {
                        CatalogFieldValueModify(c_gameCatalogEffect, effectType, "Amount", player, FixedToString(delta, c_fixedPrecisionAny), c_upgradeOperationAdd);
                    }
                    DataTableSetFixed(true, key, desiredBonus);
                }
            }
        }
    }
}

void APRG_ZeroAbilityCooldownPath(int player, string abilityType, string basePath) {
    string field;
    string value;
    if (abilityType == "" || basePath == "" || !CatalogEntryIsValid(c_gameCatalogAbil, abilityType)) { return; }
    field = basePath + ".Cooldown.TimeStart";
    value = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, field, player);
    if (value != "" && StringToFixed(value) != 0.0) { CatalogFieldValueSet(c_gameCatalogAbil, abilityType, field, player, "0"); }
    field = basePath + ".Cooldown.TimeUse";
    value = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, field, player);
    if (value != "" && StringToFixed(value) != 0.0) { CatalogFieldValueSet(c_gameCatalogAbil, abilityType, field, player, "0"); }
    field = basePath + ".Charge.TimeStart";
    value = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, field, player);
    if (value != "" && StringToFixed(value) != 0.0) { CatalogFieldValueSet(c_gameCatalogAbil, abilityType, field, player, "0"); }
    field = basePath + ".Charge.TimeUse";
    value = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, field, player);
    if (value != "" && StringToFixed(value) != 0.0) { CatalogFieldValueSet(c_gameCatalogAbil, abilityType, field, player, "0"); }
}

void APRG_SetAbilityCooldownNearZero(int player, string abilityType) {
    int costCount;
    int costIndex;
    int infoCount;
    int infoIndex;
    int nestedCount;
    int nestedIndex;
    string infoPath;
    if (abilityType == "" || !CatalogEntryIsValid(c_gameCatalogAbil, abilityType)) { return; }
    APRG_ZeroAbilityCooldownPath(player, abilityType, "Cost");
    costCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, "Cost", player);
    for (costIndex = 0; costIndex < costCount; costIndex += 1) {
        APRG_ZeroAbilityCooldownPath(player, abilityType, "Cost[" + IntToString(costIndex) + "]");
    }
    infoCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, "InfoArray", player);
    for (infoIndex = 0; infoIndex < infoCount; infoIndex += 1) {
        infoPath = "InfoArray[" + IntToString(infoIndex) + "]";
        APRG_ZeroAbilityCooldownPath(player, abilityType, infoPath);
        APRG_ZeroAbilityCooldownPath(player, abilityType, infoPath + ".Cost");
        nestedCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, infoPath + ".Cost", player);
        for (nestedIndex = 0; nestedIndex < nestedCount; nestedIndex += 1) {
            APRG_ZeroAbilityCooldownPath(player, abilityType, infoPath + ".Cost[" + IntToString(nestedIndex) + "]");
        }
    }
}

bool APRG_IsUnlimitedBlinkUnitType(string unitType) {
    return unitType != "" && (
        StringContains(unitType, "Stalker", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Slayer", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Instigator", c_stringAnywhere, c_stringNoCase)
    );
}

void APRG_ApplyUnlimitedBlink(int player) {
    unitgroup units;
    unit u;
    int i;
    int abilityCount;
    int abilityIndex;
    int infoCount;
    int commandIndex;
    string abilityType;
    string unitType;

    APRG_SetAbilityCooldownNearZero(player, "Blink");
    APRG_SetAbilityCooldownNearZero(player, "AP_Blink");
    APRG_SetAbilityCooldownNearZero(player, "AP_BlinkMultiple");
    APRG_SetAbilityCooldownNearZero(player, "APRogueBlink");

    units = APRG_PlayerMobileUnits(player);
    for (i = UnitGroupCount(units, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null) { continue; }
        unitType = UnitGetType(u);
        if (!APRG_IsUnlimitedBlinkUnitType(unitType)) { continue; }
        abilityCount = UnitAbilityCount(u);
        for (abilityIndex = 1; abilityIndex <= abilityCount; abilityIndex += 1) {
            abilityType = UnitAbilityGet(u, abilityIndex);
            if (abilityType == "" || !StringContains(abilityType, "Blink", c_stringAnywhere, c_stringNoCase)) { continue; }
            APRG_SetAbilityCooldownNearZero(player, abilityType);
            UnitAbilityReset(u, AbilityCommand(abilityType, 0), c_spendLocationAll);
            infoCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, "InfoArray", player);
            for (commandIndex = 1; commandIndex < infoCount; commandIndex += 1) {
                UnitAbilityReset(u, AbilityCommand(abilityType, commandIndex), c_spendLocationAll);
            }
        }
    }
}

bool APRG_RoachInfestationUnitType(string unitType) {
    return unitType != "" &&
        StringContains(unitType, "Roach", c_stringAnywhere, c_stringNoCase) &&
        !StringContains(unitType, "Warren", c_stringAnywhere, c_stringNoCase);
}

void APRG_ZeroRoachProductionInfo(int player, string abilityType, int infoIndex) {
    string basePath;
    if (abilityType == "" || infoIndex < 0) { return; }
    basePath = "InfoArray[" + IntToString(infoIndex) + "]";
    CatalogFieldValueSet(c_gameCatalogAbil, abilityType, basePath + ".Resource[0]", player, "0");
    CatalogFieldValueSet(c_gameCatalogAbil, abilityType, basePath + ".Resource[1]", player, "0");
    CatalogFieldValueSet(c_gameCatalogAbil, abilityType, basePath + ".Cost.Resource[0]", player, "0");
    CatalogFieldValueSet(c_gameCatalogAbil, abilityType, basePath + ".Cost.Resource[1]", player, "0");
}

void APRG_ApplyRoachInfestation(int player) {
    int count;
    int i;
    int infoCount;
    int infoIndex;
    int unitCount;
    int unitIndex;
    bool producesRoach;
    string unitType;
    string abilityType;
    string trainedUnitType;
    string basePath;
    if (g_aprgRoachInfestationApplied) { return; }

    count = CatalogEntryCount(c_gameCatalogUnit);
    for (i = 1; i <= count; i += 1) {
        unitType = CatalogEntryGet(c_gameCatalogUnit, i);
        if (!APRG_RoachInfestationUnitType(unitType)) { continue; }
        CatalogFieldValueSet(c_gameCatalogUnit, unitType, "CostResource[0]", player, "0");
        CatalogFieldValueSet(c_gameCatalogUnit, unitType, "CostResource[1]", player, "0");
    }

    count = CatalogEntryCount(c_gameCatalogAbil);
    for (i = 1; i <= count; i += 1) {
        abilityType = CatalogEntryGet(c_gameCatalogAbil, i);
        if (abilityType == "" || !CatalogEntryIsValid(c_gameCatalogAbil, abilityType)) { continue; }
        infoCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, "InfoArray", player);
        for (infoIndex = 0; infoIndex < infoCount; infoIndex += 1) {
            basePath = "InfoArray[" + IntToString(infoIndex) + "]";
            producesRoach = false;
            trainedUnitType = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, basePath + ".Unit", player);
            if (APRG_RoachInfestationUnitType(trainedUnitType)) { producesRoach = true; }
            unitCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, basePath + ".Unit", player);
            for (unitIndex = 0; unitIndex < unitCount && !producesRoach; unitIndex += 1) {
                trainedUnitType = CatalogFieldValueGet(
                    c_gameCatalogAbil,
                    abilityType,
                    basePath + ".Unit[" + IntToString(unitIndex) + "]",
                    player
                );
                if (APRG_RoachInfestationUnitType(trainedUnitType)) { producesRoach = true; }
            }
            if (producesRoach) { APRG_ZeroRoachProductionInfo(player, abilityType, infoIndex); }
        }
    }
    g_aprgRoachInfestationApplied = true;
}

void APRG_TickToxicObservation(int player, fixed now) {
    unitgroup observers;
    unitgroup enemies;
    unitgroup damaged;
    unit observer;
    unit target;
    int i;
    int j;
    if (now < g_aprgNextToxicObservationTime) { return; }
    g_aprgNextToxicObservationTime = now + 1.0;
    observers = APRG_PlayerMobileUnits(player);
    damaged = UnitGroupEmpty();
    for (i = UnitGroupCount(observers,c_unitCountAlive); i > 0; i -= 1) {
        observer = UnitGroupUnitFromEnd(observers,i);
        if (observer == null || !StringContains(UnitGetType(observer),"Observer",c_stringAnywhere,c_stringNoCase)) { continue; }
        enemies = UnitGroupAlliance(player,c_unitAllianceEnemy,RegionCircle(UnitGetPosition(observer),8.0),UnitFilter(0,0,(1 << c_targetFilterMissile),(1 << (c_targetFilterDead - 32))),0);
        for (j = UnitGroupCount(enemies,c_unitCountAlive); j > 0; j -= 1) {
            target = UnitGroupUnitFromEnd(enemies,j);
            if (target == null || UnitGroupHasUnit(damaged,target)) { continue; }
            if (!libNtve_gf_UnitIsVisibleToPlayer(target, player)) { continue; }
            APRG_DealDirectDamage(target,10.0);
            UnitGroupAdd(damaged,target);
        }
    }
}

bool APRG_ProductionBoonUnitEligible(unit produced, int player) {
    string unitType;
    fixed cost;
    fixed supply;
    if (produced == null || UnitGetOwner(produced) != player || !UnitIsAlive(produced)) { return false; }
    unitType = UnitGetType(produced);
    if (unitType == "" || !CatalogEntryIsValid(c_gameCatalogUnit, unitType)) { return false; }
    if (UnitTypeTestAttribute(unitType, c_unitAttributeStructure) || APRG_IsWorkerTypeForDeath(unitType)) { return false; }
    if (UnitGroupHasUnit(APRG_PlayerWorkers(player), produced)) { return false; }
    if (APRG_HordeProductionIntermediateType(unitType)) { return false; }
    cost = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "CostResource[0]", player)) +
        StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "CostResource[1]", player));
    supply = UnitTypeGetProperty(unitType, c_unitPropSuppliesUsed);
    return cost > 0.0 || supply > 0.0;
}

// Elite Soldiers includes normally trained workers, unlike production boons
// such as Cloning Technology, which intentionally exclude workers. Avoid
// free/scripted MULEs, larvae, eggs, and units created without a real cost.
bool APRG_EliteProductionUnitEligible(unit produced, int player) {
    string unitType;
    fixed cost;
    if (APRG_ProductionBoonUnitEligible(produced, player)) { return true; }
    if (produced == null || UnitGetOwner(produced) != player || !UnitIsAlive(produced)) { return false; }
    unitType = UnitGetType(produced);
    if (unitType == "" || !CatalogEntryIsValid(c_gameCatalogUnit, unitType) ||
        UnitTypeTestAttribute(unitType, c_unitAttributeStructure) ||
        APRG_HordeProductionIntermediateType(unitType) ||
        !APRG_IsWorkerTypeForDeath(unitType) ||
        StringContains(unitType, "MULE", c_stringAnywhere, c_stringNoCase)) { return false; }
    cost = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "CostResource[0]", player)) +
        StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "CostResource[1]", player));
    return cost > 0.0;
}

unit APRG_CloneAttackTarget(unit clone, int player) {
    unitgroup candidates;
    int i;
    unit candidate;
    unit best = null;
    fixed distance;
    fixed bestDistance = 999999.0;
    point clonePoint;
    bool groundClone;
    if (clone == null || !UnitIsAlive(clone)) { return null; }
    clonePoint = UnitGetPosition(clone);
    groundClone = UnitTestPlane(clone, c_planeGround);

    if (g_aprgCloneTargetCacheActive) { candidates = g_aprgCloneTargetBuildings; }
    else { candidates = APRG_EnemyTargetableStructures(player); }
    for (i = UnitGroupCount(candidates, c_unitCountAlive); i > 0; i -= 1) {
        candidate = UnitGroupUnitFromEnd(candidates, i);
        if (candidate == null || !UnitIsAlive(candidate)) { continue; }
        if (groundClone && !UnitPathableToPoint(clone, UnitGetPosition(candidate), 3.0, 100000.0)) { continue; }
        distance = DistanceBetweenPoints(clonePoint, UnitGetPosition(candidate));
        if (best == null || distance < bestDistance) { best = candidate; bestDistance = distance; }
    }
    if (best != null) { return best; }

    if (g_aprgCloneTargetCacheActive) { candidates = g_aprgCloneTargetMobile; }
    else { candidates = APRG_EnemyMobileUnits(player); }
    for (i = UnitGroupCount(candidates, c_unitCountAlive); i > 0; i -= 1) {
        candidate = UnitGroupUnitFromEnd(candidates, i);
        if (candidate == null || !UnitIsAlive(candidate)) { continue; }
        if (groundClone && !UnitPathableToPoint(clone, UnitGetPosition(candidate), 3.0, 100000.0)) { continue; }
        distance = DistanceBetweenPoints(clonePoint, UnitGetPosition(candidate));
        if (best == null || distance < bestDistance) { best = candidate; bestDistance = distance; }
    }
    return best;
}

void APRG_OrderCloneTowardValidTarget(unit clone, int player) {
    unit target;
    if (clone == null || !UnitIsAlive(clone)) { return; }
    target = APRG_CloneAttackTarget(clone, player);
    if (target == null) { return; }
    APRG_OrderAttackMove(clone, UnitGetPosition(target));
}

void APRG_TryCloneProducedUnit(unit produced, int player) {
    unitgroup created;
    unit clone;
    string key;
    string unitType;
    point p;
    if (!APRG_HasExtension2(APRG_EXT2_BOON_CLONING_TECHNOLOGY) || !APRG_ProductionBoonUnitEligible(produced, player)) { return; }
    key = "APRG_CloningHandled_" + IntToString(UnitGetTag(produced));
    if (DataTableGetBool(true, key)) { return; }
    DataTableSetBool(true, key, true);
    unitType = UnitGetType(produced);
    p = UnitGetPosition(produced);
    created = APRG_CreatePlayerUnitsAtPoint(1, unitType, player, p, UnitGetFacing(produced));
    clone = UnitGroupUnitFromEnd(created, 1);
    if (clone == null) { return; }
    UnitSetState(clone, c_unitStateUsingSupply, false);
    APRG_MakeGroupUncommandable(created);
    UnitGroupAdd(g_aprgClonedUnits, clone);
    APRG_OrderCloneTowardValidTarget(clone, player);
}

void APRG_TryGoliathsOnlineProducedUnit(unit produced, int player) {
    unitgroup created;
    unit extra;
    string key;
    string unitType;
    if (!APRG_HasExtension4(APRG_EXT4_BOON_GOLIATHS_ONLINE) || produced == null || UnitGetOwner(produced) != player || !UnitIsAlive(produced)) { return; }
    unitType = UnitGetType(produced);
    if (!APRG_IsGoliathFamilyType(unitType) || UnitTypeTestAttribute(unitType, c_unitAttributeStructure)) { return; }
    key = "APRG_GoliathsOnlineHandled_" + IntToString(UnitGetTag(produced));
    if (DataTableGetBool(true, key)) { return; }
    DataTableSetBool(true, key, true);
    created = APRG_CreatePlayerUnitsSafe(1, unitType, player, UnitGetPosition(produced), UnitGetFacing(produced));
    extra = UnitGroupUnitFromEnd(created, 1);
    if (extra != null) { UnitSetState(extra, c_unitStateUsingSupply, false); }
}

// Each production event queues the exact same five automatic Marines.  A 0.1s
// fast tick processes up to two Marines globally, avoiding stacked UnitCreate,
// command-card filtering, and autonomous AI work in a single production event.
void APRG_SpawnMeatGrinderExtra(string unitType, int player, point p, fixed facing);
void APRG_EnqueueMeatGrinderMarines(unit produced, int player) {
    int slot;
    if (g_aprgMeatGrinderQueued >= 1024) {
        // At extreme backlog, preserve all five Marines instead of dropping
        // a purchased boon effect. This path is exceptional (>5120 queued).
        APRG_SpawnMeatGrinderExtra(UnitGetType(produced), player, UnitGetPosition(produced), UnitGetFacing(produced));
        APRG_SpawnMeatGrinderExtra(UnitGetType(produced), player, UnitGetPosition(produced), UnitGetFacing(produced));
        APRG_SpawnMeatGrinderExtra(UnitGetType(produced), player, UnitGetPosition(produced), UnitGetFacing(produced));
        APRG_SpawnMeatGrinderExtra(UnitGetType(produced), player, UnitGetPosition(produced), UnitGetFacing(produced));
        APRG_SpawnMeatGrinderExtra(UnitGetType(produced), player, UnitGetPosition(produced), UnitGetFacing(produced));
        return;
    }
    slot = g_aprgMeatGrinderTail;
    g_aprgMeatGrinderOwner[slot] = player;
    g_aprgMeatGrinderType[slot] = UnitGetType(produced);
    g_aprgMeatGrinderPoint[slot] = UnitGetPosition(produced);
    g_aprgMeatGrinderFacing[slot] = UnitGetFacing(produced);
    g_aprgMeatGrinderRemaining[slot] = 5;
    g_aprgMeatGrinderTail = (slot + 1) % 1024;
    g_aprgMeatGrinderQueued += 1;
}

void APRG_SpawnMeatGrinderExtra(string unitType, int player, point p, fixed facing) {
    unitgroup created;
    unit extra;
    created = APRG_CreatePlayerUnitsAtPoint(1, unitType, player, p, facing);
    extra = UnitGroupUnitFromEnd(created, 1);
    if (extra == null) { return; }
    // Preserve the exact supply/controllability/AI behavior of the old batch.
    APRG_MakeGroupUncommandable(created);
    UnitSetState(extra, c_unitStateUsingSupply, false);
    UnitGroupAdd(g_aprgClonedUnits, extra);
    DataTableSetBool(true, "APRG_MeatGrinderHandled_" + IntToString(UnitGetTag(extra)), true);
    APRG_OrderGroupTowardNearestEnemyStructure(created, p, player);
}

void APRG_ProcessMeatGrinderQueue() {
    int count = 0;
    int slot;
    // Two creations per 0.1 game seconds: ten times fewer in one tick than
    // two simultaneous original Marine completions (5 each).
    while (g_aprgMeatGrinderQueued > 0 && count < 2) {
        slot = g_aprgMeatGrinderHead;
        APRG_SpawnMeatGrinderExtra(g_aprgMeatGrinderType[slot], g_aprgMeatGrinderOwner[slot],
            g_aprgMeatGrinderPoint[slot], g_aprgMeatGrinderFacing[slot]);
        g_aprgMeatGrinderRemaining[slot] -= 1;
        count += 1;
        if (g_aprgMeatGrinderRemaining[slot] <= 0) {
            g_aprgMeatGrinderPoint[slot] = null;
            g_aprgMeatGrinderType[slot] = "";
            g_aprgMeatGrinderHead = (slot + 1) % 1024;
            g_aprgMeatGrinderQueued -= 1;
        }
    }
}

void APRG_TryMeatGrinderProducedUnit(unit produced, int player) {
    string key;
    if (!APRG_HasExtension4(APRG_EXT4_BOON_MEAT_GRINDER) || !APRG_ProductionBoonUnitEligible(produced, player)) { return; }
    if (!APRG_IsMarineBoonType(UnitGetType(produced))) { return; }
    key = "APRG_MeatGrinderHandled_" + IntToString(UnitGetTag(produced));
    if (DataTableGetBool(true, key)) { return; }
    DataTableSetBool(true, key, true);
    APRG_EnqueueMeatGrinderMarines(produced, player);
}

void APRG_ApplyTrainedUnitShieldBoon(unit produced, int player) {
    string key;
    fixed maximum;
    fixed current;
    if (!APRG_HasExtension2(APRG_EXT2_BOON_SHIELDS_FOR_ALL) || !APRG_ProductionBoonUnitEligible(produced, player)) { return; }
    key = "APRG_BoonShield_" + IntToString(UnitGetTag(produced));
    if (DataTableGetBool(true, key)) { return; }
    maximum = UnitGetPropertyFixed(produced, c_unitPropShieldsMax, c_unitPropCurrent);
    current = UnitGetPropertyFixed(produced, c_unitPropShields, c_unitPropCurrent);
    UnitSetPropertyFixed(produced, c_unitPropShieldsMax, maximum + 50.0);
    UnitSetPropertyFixed(produced, c_unitPropShields, current + 50.0);
    APRG_EnsureNormalShieldRegeneration(produced);
    DataTableSetBool(true, key, true);
}

void APRG_TryProductionBoons(unit produced, int player) {
    if (APRG_HasBlessing(APRG_BLESS_ELITE_SOLDIERS) && APRG_EliteProductionUnitEligible(produced, player)) {
        DataTableSetBool(true, "APRG_EliteTrained_" + IntToString(UnitGetTag(produced)), true);
    }
    APRG_ApplyTrainedUnitShieldBoon(produced, player);
    if (APRG_HasExtension3(APRG_EXT3_BOON_GARGANTUAN_UNITS)) {
        APRG_ApplyGargantuanToTrainedUnit(produced, player);
    }
    APRG_TryCloneProducedUnit(produced, player);
    APRG_TryGoliathsOnlineProducedUnit(produced, player);
    APRG_TryMeatGrinderProducedUnit(produced, player);
}

bool APRG_Cloning_Func(bool testConds, bool runActions) {
    unit trained;
    int player;
    if (!runActions || !g_aprgStarted) { return true; }
    player = APRG_GetPrimaryPlayer();
    if (EventPlayer() != player) { return true; }
    trained = EventUnitProgressUnit();
    APRG_TryProductionBoons(trained, player);
    return true;
}

bool APRG_ProductionCreated_Func(bool testConds, bool runActions) {
    int player;
    unit creator;
    unit created;
    string createdType;
    string abilityType;
    bool structureSource = false;
    bool mercenarySource = false;
    if (!runActions || !g_aprgStarted) { return true; }
    if (
        !APRG_HasExtension2(APRG_EXT2_BOON_CLONING_TECHNOLOGY) &&
        !APRG_HasExtension2(APRG_EXT2_BOON_SHIELDS_FOR_ALL) &&
        !APRG_HasExtension3(APRG_EXT3_BOON_GARGANTUAN_UNITS) &&
        !APRG_HasExtension4(APRG_EXT4_BOON_GOLIATHS_ONLINE) &&
        !APRG_HasExtension4(APRG_EXT4_BOON_MEAT_GRINDER) &&
        !APRG_HasBlessing(APRG_BLESS_ELITE_SOLDIERS)
    ) { return true; }
    player = APRG_GetPrimaryPlayer();
    created = EventUnitCreatedUnit();
    creator = EventUnit();
    if (created == null || UnitGetOwner(created) != player) { return true; }
    createdType = UnitGetType(created);
    if (createdType == "" || APRG_HordeProductionIntermediateType(createdType)) { return true; }
    abilityType = EventUnitCreatedAbil();
    if (creator != null && UnitGetOwner(creator) == player && UnitTypeTestAttribute(UnitGetType(creator), c_unitAttributeStructure)) {
        structureSource = abilityType == "" || APRG_HordeAbilityInfoProducesUnit(player, abilityType, createdType);
        if (!structureSource && !CatalogEntryIsValid(c_gameCatalogAbil, abilityType)) { structureSource = true; }
    }
    mercenarySource = APRG_IsMercenaryRecruitAbility(abilityType, player);
    if (!structureSource && !mercenarySource) { return true; }
    APRG_TryProductionBoons(created, player);
    return true;
}

void APRG_RetargetClonedUnits(int player, fixed now) {
    int i;
    int work = 0;
    int currentAlive;
    unit clone;
    // A large Meat Grinder / Cloning Technology army previously repathed every
    // unit in the same tick. Spread work over normal 1-second mission ticks;
    // each unit still gets the same structure-first/pathable target AI.
    if (g_aprgCloneRetargetRemaining <= 0) {
        if (now < g_aprgNextCloneRetargetTime) { return; }
        g_aprgCloneRetargetRemaining = UnitGroupCount(g_aprgClonedUnits, c_unitCountAlive);
        if (g_aprgCloneRetargetRemaining <= 0) {
            g_aprgNextCloneRetargetTime = now + 10.0;
            return;
        }
    }
    currentAlive = UnitGroupCount(g_aprgClonedUnits, c_unitCountAlive);
    // Reuse the same target groups for all units handled this tick, while
    // retaining per-Marine closest/pathable-target selection.
    g_aprgCloneTargetBuildings = APRG_EnemyTargetableStructures(player);
    g_aprgCloneTargetMobile = APRG_EnemyMobileUnits(player);
    g_aprgCloneTargetCacheActive = true;
    while (g_aprgCloneRetargetRemaining > 0 && work < 40) {
        i = g_aprgCloneRetargetRemaining;
        // Units can die between ticks: clamp the cursor to the living group.
        i = MinI(i, currentAlive);
        if (i <= 0) { g_aprgCloneRetargetRemaining = 0; break; }
        clone = UnitGroupUnitFromEnd(g_aprgClonedUnits, i);
        g_aprgCloneRetargetRemaining = i - 1;
        if (clone == null || !UnitIsAlive(clone)) { continue; }
        APRG_OrderCloneTowardValidTarget(clone, player);
        work += 1;
    }
    g_aprgCloneTargetCacheActive = false;
    g_aprgCloneTargetBuildings = UnitGroupEmpty();
    g_aprgCloneTargetMobile = UnitGroupEmpty();
    if (g_aprgCloneRetargetRemaining <= 0) { g_aprgNextCloneRetargetTime = now + 10.0; }
}

bool APRG_ArchonCannons_Func(bool testConds, bool runActions) {
    unit victim;
    unit source;
    unit mini;
    unitgroup created;
    int player;
    int owner;
    string sourceType;
    string key;
    point p;
    fixed maximum;
    fixed current;
    fixed ratio;
    if (!runActions || !g_aprgStarted || !APRG_HasExtension3(APRG_EXT3_BOON_ARCHON_CANNONS)) { return true; }
    victim = EventUnit();
    source = EventUnitDamageSourceUnit();
    if (victim == null || source == null || victim == source) { return true; }
    player = APRG_GetPrimaryPlayer();
    if (UnitGetOwner(source) != player) { return true; }
    sourceType = UnitGetType(source);
    if (
        !StringContains(sourceType, "PhotonCannon", c_stringAnywhere, c_stringNoCase) &&
        !StringContains(sourceType, "Dragoon", c_stringAnywhere, c_stringNoCase)
    ) { return true; }
    owner = UnitGetOwner(victim);
    if (owner < 0 || !libNtve_gf_PlayerIsEnemy(owner, player, libNtve_ge_PlayerRelation_Enemy)) { return true; }
    if (UnitGroupCount(g_aprgArchonCannonArchons, c_unitCountAlive) >= 128) { return true; }
    if (!CatalogEntryIsValid(c_gameCatalogUnit, "Archon")) { return true; }

    p = UnitGetPosition(victim);
    created = APRG_CreatePlayerUnitsSafe(1, "Archon", player, p, UnitGetFacing(source));
    mini = UnitGroupUnitFromEnd(created, 1);
    if (mini == null) { return true; }

    UnitSetScale(mini, 50.0, 50.0, 50.0);
    maximum = UnitGetPropertyFixed(mini, c_unitPropLifeMax, c_unitPropCurrent);
    current = UnitGetPropertyFixed(mini, c_unitPropLife, c_unitPropCurrent);
    if (maximum > 0.0) {
        ratio = current / maximum;
        UnitSetPropertyFixed(mini, c_unitPropLifeMax, maximum * 0.25);
        UnitSetPropertyFixed(mini, c_unitPropLife, maximum * 0.25 * ratio);
    }
    maximum = UnitGetPropertyFixed(mini, c_unitPropShieldsMax, c_unitPropCurrent);
    current = UnitGetPropertyFixed(mini, c_unitPropShields, c_unitPropCurrent);
    if (maximum > 0.0) {
        ratio = current / maximum;
        UnitSetPropertyFixed(mini, c_unitPropShieldsMax, maximum * 0.25);
        UnitSetPropertyFixed(mini, c_unitPropShields, maximum * 0.25 * ratio);
    }
    if (CatalogEntryIsValid(c_gameCatalogBehavior, "APRogueMiniArchonDamage")) {
        UnitBehaviorAdd(mini, "APRogueMiniArchonDamage", mini, 1);
    }
    UnitSetState(mini, c_unitStateUsingSupply, false);
    UnitSetState(mini, c_unitStateSelectable, true);
    AISetUnitScriptControlled(mini, false);
    UnitGroupAdd(g_aprgArchonCannonArchons, mini);

    // Mini-Archons are free temporary projectiles, not normal army deaths.
    // Record the exclusion before the timed-life behavior is applied so that
    // all death effects (including No Deaths Allowed) ignore their deaths.
    DataTableSetBool(true, "APRG_ArchonCannonMini_" + IntToString(UnitGetTag(mini)), true);
    key = "APRG_ArchonCannonExpire_" + IntToString(UnitGetTag(mini));
    DataTableSetFixed(true, key, GameGetMissionTime() + 10.0);
    if (CatalogEntryIsValid(c_gameCatalogBehavior, "AutoTurretTimedLife")) {
        UnitBehaviorAdd(mini, "AutoTurretTimedLife", mini, 1);
        UnitBehaviorSetDuration(mini, "AutoTurretTimedLife", 10.0);
        UnitBehaviorSetDurationRemaining(mini, "AutoTurretTimedLife", 10.0);
    }
    UnitIssueOrder(mini, OrderTargetingUnit(AbilityCommand("attack", 0), victim), c_orderQueueReplace);
    return true;
}

void APRG_TickArchonCannons(fixed now) {
    int i;
    unit mini;
    string key;
    fixed expires;
    if (g_aprgArchonCannonArchons == null) { return; }
    for (i = UnitGroupCount(g_aprgArchonCannonArchons, c_unitCountAll); i > 0; i -= 1) {
        mini = UnitGroupUnitFromEnd(g_aprgArchonCannonArchons, i);
        if (mini == null) { continue; }
        key = "APRG_ArchonCannonExpire_" + IntToString(UnitGetTag(mini));
        if (!UnitIsAlive(mini)) {
            UnitGroupRemove(g_aprgArchonCannonArchons, mini);
            continue;
        }
        expires = DataTableGetFixed(true, key);
        if (expires > 0.0 && expires <= now) {
            UnitGroupRemove(g_aprgArchonCannonArchons, mini);
            UnitRemove(mini);
        }
    }
}


bool APRG_HydraStorms_Func(bool testConds, bool runActions) {
    unit victim;
    unit source;
    int player;
    int owner;
    string sourceType;
    point impactPoint;
    if (!runActions || !g_aprgStarted || !APRG_HasExtension3(APRG_EXT3_BOON_HYRDA_STORMS)) { return true; }
    victim = EventUnit();
    source = EventUnitDamageSourceUnit();
    if (victim == null || source == null || victim == source) { return true; }
    player = APRG_GetPrimaryPlayer();
    if (UnitGetOwner(source) != player) { return true; }
    sourceType = UnitGetType(source);
    if (
        !StringContains(sourceType, "Hydralisk", c_stringAnywhere, c_stringNoCase) &&
        !StringContains(sourceType, "HunterKiller", c_stringAnywhere, c_stringNoCase)
    ) { return true; }
    owner = UnitGetOwner(victim);
    if (owner < 0 || !libNtve_gf_PlayerIsEnemy(owner, player, libNtve_ge_PlayerRelation_Enemy)) { return true; }
    if (!CatalogEntryIsValid(c_gameCatalogEffect, "PsiStormPersistent")) { return true; }
    impactPoint = UnitGetPosition(victim);
    APRG_CreateObjectiveSafeSlayEffect(player, "PsiStormPersistent", impactPoint, 5.0);
    return true;
}

bool APRG_CorrosiveClaws_Func(bool testConds, bool runActions) {
    unit victim;
    unit source;
    int player;
    int owner;
    int corrosiveStacks;
    string sourceType;
    if (!runActions || !g_aprgStarted || !APRG_HasExtension3(APRG_EXT3_BOON_CORROSIVE_CLAWS)) { return true; }
    victim = EventUnit();
    source = EventUnitDamageSourceUnit();
    if (victim == null || source == null || victim == source || !UnitIsAlive(victim)) { return true; }
    player = APRG_GetPrimaryPlayer();
    if (UnitGetOwner(source) != player) { return true; }
    sourceType = UnitGetType(source);
    if (!StringContains(sourceType, "Zergling", c_stringAnywhere, c_stringNoCase)) { return true; }
    owner = UnitGetOwner(victim);
    if (owner < 0 || !libNtve_gf_PlayerIsEnemy(owner, player, libNtve_ge_PlayerRelation_Enemy)) { return true; }
    corrosiveStacks = UnitBehaviorCount(victim, "APRogueCorrosiveClaws");
    if (corrosiveStacks < 0) { corrosiveStacks = 0; }
    UnitBehaviorRemove(victim, "APRogueCorrosiveClaws", c_unitBehaviorCountAll);
    UnitBehaviorAdd(victim, "APRogueCorrosiveClaws", source, corrosiveStacks + 1);
    return true;
}

bool APRG_EnhancedControl_Func(bool testConds, bool runActions) {
    unit u;
    int player;
    int oldOwner;
    fixed maximum;
    fixed current;
    fixed ratio;
    string key;
    if (!runActions || !g_aprgStarted || !APRG_HasBlessing(APRG_BOON_ENHANCED_CONTROL)) { return true; }
    u = EventUnit();
    if (u == null || !UnitIsAlive(u)) { return true; }
    player = APRG_GetPrimaryPlayer();
    oldOwner = EventUnitOwnerOld();
    if (UnitGetOwner(u) != player || oldOwner < 0 || !libNtve_gf_PlayerIsEnemy(oldOwner, player, libNtve_ge_PlayerRelation_Enemy)) { return true; }
    key = "APRG_EnhancedControl_" + IntToString(UnitGetTag(u));
    if (DataTableGetBool(true, key)) { return true; }
    maximum = UnitGetPropertyFixed(u, c_unitPropLifeMax, c_unitPropCurrent);
    current = UnitGetPropertyFixed(u, c_unitPropLife, c_unitPropCurrent);
    if (maximum > 0.0) {
        ratio = current / maximum;
        UnitSetPropertyFixed(u, c_unitPropLifeMax, maximum * 3.0);
        UnitSetPropertyFixed(u, c_unitPropLife, maximum * 3.0 * ratio);
    }
    APRG_ScaleUnitShields(u, 3.0);
    UnitBehaviorAdd(u, "APRogueEnhancedControl", u, 1);
    DataTableSetBool(true, key, true);
    return true;
}

void APRG_HalveBansheeDamageForType(unit u, int player) {
    int wi;
    int wc;
    string weapon;
    string effect;
    string key;
    if (u == null) { return; }
    wc = UnitWeaponCount(u);
    for (wi = 1; wi <= wc; wi += 1) {
        weapon = UnitWeaponGet(u, wi);
        if (weapon == "") { continue; }
        effect = CatalogFieldValueGet(c_gameCatalogWeapon, weapon, "DisplayEffect", player);
        if (effect == "" || !CatalogEntryIsValid(c_gameCatalogEffect, effect)) { continue; }
        key = "APRG_MiniBansheeDamage_" + IntToString(player) + "_" + effect;
        if (!DataTableGetBool(true, key)) {
            CatalogFieldValueModify(c_gameCatalogEffect, effect, "Amount", player, "0.5", c_upgradeOperationMultiply);
            DataTableSetBool(true, key, true);
        }
    }
}

bool APRG_BansheeSwarm_Func(bool testConds, bool runActions) {
    unit trained;
    unit mini;
    unitgroup created;
    int player;
    int i;
    string unitType;
    fixed maximum;
    fixed current;
    fixed ratio;
    point p;
    fixed facing;
    if (!runActions || !g_aprgStarted || !APRG_HasBlessing(APRG_BOON_BANSHEE_SWARM)) { return true; }
    player = APRG_GetPrimaryPlayer();
    if (EventPlayer() != player) { return true; }
    trained = EventUnitProgressUnit();
    if (trained == null || !UnitIsAlive(trained)) { return true; }
    unitType = UnitGetType(trained);
    if (!StringContains(unitType, "Banshee", c_stringAnywhere, c_stringNoCase)) { return true; }
    if (DataTableGetBool(true, "APRG_MiniBanshee_" + IntToString(UnitGetTag(trained)))) { return true; }
    p = UnitGetPosition(trained);
    facing = UnitGetFacing(trained);
    APRG_HalveBansheeDamageForType(trained, player);
    UnitRemove(trained);
    created = APRG_CreatePlayerUnitsSafe(6, unitType, player, p, facing);
    for (i = UnitGroupCount(created, c_unitCountAlive); i > 0; i -= 1) {
        mini = UnitGroupUnitFromEnd(created, i);
        if (mini == null) { continue; }
        DataTableSetBool(true, "APRG_MiniBanshee_" + IntToString(UnitGetTag(mini)), true);
        UnitSetScale(mini, 50.0, 50.0, 50.0);
        maximum = UnitGetPropertyFixed(mini, c_unitPropLifeMax, c_unitPropCurrent);
        current = UnitGetPropertyFixed(mini, c_unitPropLife, c_unitPropCurrent);
        if (maximum > 0.0) {
            ratio = current / maximum;
            UnitSetPropertyFixed(mini, c_unitPropLifeMax, maximum * 0.5);
            UnitSetPropertyFixed(mini, c_unitPropLife, maximum * 0.5 * ratio);
        }
        if (i > 1) { UnitSetState(mini, c_unitStateUsingSupply, false); }
    }
    return true;
}

void APRG_MultiplyBanelingRadiusEffect(int player, string effect) {
    string key;
    if (effect == "" || !CatalogEntryIsValid(c_gameCatalogEffect, effect)) { return; }
    key = "APRG_BanelingRadius_" + IntToString(player) + "_" + effect;
    if (DataTableGetBool(true, key)) { return; }
    CatalogFieldValueModify(c_gameCatalogEffect, effect, "AreaArray[0].Radius", player, "3.0", c_upgradeOperationMultiply);
    DataTableSetBool(true, key, true);
}

void APRG_ApplyEnlargedBanelingCatalog(int player) {
    string key = "APRG_EnlargedBanelingCatalog_" + IntToString(player);
    if (DataTableGetBool(true, key)) { return; }

    APRG_MultiplyBanelingRadiusEffect(player, "AP_HotSBanelingExplodeLargeSearch");
    APRG_MultiplyBanelingRadiusEffect(player, "AP_HotSBanelingExplodeLargeSearchAll");
    APRG_MultiplyBanelingRadiusEffect(player, "AP_HotSBanelingExplodeLargeHealSearch");
    APRG_MultiplyBanelingRadiusEffect(player, "AP_HotSBanelingExplodeLargeHealSearchAll");
    APRG_MultiplyBanelingRadiusEffect(player, "AP_HotSBanelingExplodeSmallSearch");
    APRG_MultiplyBanelingRadiusEffect(player, "AP_HotSBanelingExplodeSmallSearchAll");
    APRG_MultiplyBanelingRadiusEffect(player, "AP_HotSBanelingExplodeSmallHealSearch");
    APRG_MultiplyBanelingRadiusEffect(player, "AP_HotSBanelingExplodeSmallHealSearchAll");
    APRG_MultiplyBanelingRadiusEffect(player, "AP_SIVolatileInfestedExplodeDamage");
    APRG_MultiplyBanelingRadiusEffect(player, "AP_SIVolatileInfestedExplodeDamageStructure");
    APRG_MultiplyBanelingRadiusEffect(player, "AP_BanelingLaunchExplodeSearch");
    APRG_MultiplyBanelingRadiusEffect(player, "AP_BanelingLargeHealSearchAll");

    DataTableSetBool(true, key, true);
}

void APRG_ApplyEnlargedBanelings(int player) {
    unitgroup units;
    unit u;
    int i;
    string unitType;
    string key;

    APRG_ApplyEnlargedBanelingCatalog(player);
    units = APRG_PlayerMobileUnits(player);
    for (i = UnitGroupCount(units, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null) { continue; }
        unitType = UnitGetType(u);
        if (!StringContains(unitType, "Baneling", c_stringAnywhere, c_stringNoCase)) { continue; }
        key = "APRG_EnlargedBanelingScale_" + IntToString(UnitGetTag(u));
        if (!DataTableGetBool(true, key)) {
            UnitSetScale(u, 150.0, 150.0, 150.0);
            DataTableSetBool(true, key, true);
        }
    }
}

bool APRG_IsMobileSiegeType(string unitType) {
    return StringContains(unitType, "SiegeTank", c_stringAnywhere, c_stringNoCase)
        || StringContains(unitType, "SiegeBreaker", c_stringAnywhere, c_stringNoCase);
}

void APRG_EnableMobileSiegeType(int player, string unitType) {
    string key;
    string donorType;
    string mover;
    string speed;
    if (!CatalogEntryIsValid(c_gameCatalogUnit, unitType)) { return; }
    if (!StringContains(unitType, "Sieged", c_stringAnywhere, c_stringNoCase)) { return; }
    key = "APRG_MobileSiegeType_" + IntToString(player) + "_" + unitType;
    if (DataTableGetBool(true, key)) { return; }
    donorType = "SiegeTank";
    if (StringContains(unitType, "SiegeBreaker", c_stringAnywhere, c_stringNoCase) && CatalogEntryIsValid(c_gameCatalogUnit, "SiegeBreaker")) {
        donorType = "SiegeBreaker";
    }
    if (!CatalogEntryIsValid(c_gameCatalogUnit, donorType)) { return; }
    mover = CatalogFieldValueGet(c_gameCatalogUnit, donorType, "Mover", player);
    speed = CatalogFieldValueGet(c_gameCatalogUnit, donorType, "Speed", player);
    if (mover != "") { CatalogFieldValueSet(c_gameCatalogUnit, unitType, "Mover", player, mover); }
    if (speed != "") { CatalogFieldValueSet(c_gameCatalogUnit, unitType, "Speed", player, speed); }
    APRG_AddCommandCardButton(player, unitType, "Move", "move,Move", 0, 0);
    APRG_AddCommandCardButton(player, unitType, "Stop", "stop,Stop", 0, 1);
    DataTableSetBool(true, key, true);
}

void APRG_ApplyMobileSiege(int player) {
    unitgroup units;
    int i;
    unit u;
    string unitType;
    units = APRG_PlayerAllUnits(player);
    i = UnitGroupCount(units, c_unitCountAlive);
    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null) { break; }
        unitType = UnitGetType(u);
        if (!APRG_IsMobileSiegeType(unitType) || !StringContains(unitType, "Sieged", c_stringAnywhere, c_stringNoCase)) { continue; }
        APRG_EnableMobileSiegeType(player, unitType);
        if (!UnitAbilityExists(u, "move")) { UnitAbilityAdd(u, "move"); }
        if (!UnitAbilityExists(u, "stop")) { UnitAbilityAdd(u, "stop"); }
        UnitAbilityShow(u, "move", true);
        UnitAbilityEnable(u, "move", true);
        UnitAbilityShow(u, "stop", true);
        UnitAbilityEnable(u, "stop", true);
    }
}

bool APRG_IsVikingAnchorType(string unitType) {
    return StringContains(unitType, "Viking", c_stringAnywhere, c_stringNoCase)
        || StringContains(unitType, "HelsAngel", c_stringAnywhere, c_stringNoCase)
        || StringContains(unitType, "HelAngel", c_stringAnywhere, c_stringNoCase)
        || StringContains(unitType, "Brynhild", c_stringAnywhere, c_stringNoCase);
}

void APRG_ApplyVikingAnchors(int player) {
    unitgroup units = APRG_PlayerMobileUnits(player);
    int i = UnitGroupCount(units, c_unitCountAlive);
    unit u;
    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null) { break; }
        if (!APRG_IsVikingAnchorType(UnitGetType(u))) { continue; }
        if (UnitTestPlane(u, c_planeGround)) {
            UnitBehaviorAdd(u, "APRogueVikingAnchors", u, 1);
        }
        else {
            UnitBehaviorRemove(u, "APRogueVikingAnchors", c_unitBehaviorCountAll);
        }
    }
}

string APRG_TerranMercenaryStructureType() {
    if (CatalogEntryIsValid(c_gameCatalogUnit, "AP_MercCompound")) { return "AP_MercCompound"; }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "MercCompound")) { return "MercCompound"; }
    return "";
}

string APRG_ZergMercenaryStructureType() {
    if (CatalogEntryIsValid(c_gameCatalogUnit, "AP_PredatorNest")) { return "AP_PredatorNest"; }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "AP_ZergPredatorNest")) { return "AP_ZergPredatorNest"; }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "AP_ZergMercenaryCompound")) { return "AP_ZergMercenaryCompound"; }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "PredatorNest")) { return "PredatorNest"; }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "ZergPredatorNest")) { return "ZergPredatorNest"; }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "ZergMercenaryCompound")) { return "ZergMercenaryCompound"; }
    return "";
}

unit APRG_FindOwnedUnitOfType(int player, string unitType) {
    unitgroup units;
    unit u;
    if (unitType == "" || !CatalogEntryIsValid(c_gameCatalogUnit, unitType)) { return null; }
    units = UnitGroup(unitType, player, RegionPlayableMap(), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0);
    u = UnitGroupUnitFromEnd(units, 1);
    return u;
}

bool APRG_IsTerranContractStructureType(string unitType) {
    if (unitType == "") { return false; }
    return StringContains(unitType, "MercCompound", c_stringAnywhere, c_stringNoCase)
        || StringContains(unitType, "MercenaryCompound", c_stringAnywhere, c_stringNoCase);
}

bool APRG_IsZergContractStructureType(string unitType) {
    if (unitType == "") { return false; }
    return StringContains(unitType, "PredatorNest", c_stringAnywhere, c_stringNoCase)
        || StringContains(unitType, "ZergMercenaryCompound", c_stringAnywhere, c_stringNoCase);
}

// Run this at most once every three seconds. Only actual player-owned mercenary
// structures are inspected; normal unit training and spells are untouched.
// The tracked progression structures are not exhaustive: native/AP scripts may
// create or replace their own Compound/Nest actors after initial discovery.
void APRG_SanitizeKnownAPMercenaryTimers(int player) {
    string abilityType;
    string path;
    string link;
    int i;
    int count;
    fixed remaining;
    int abilityIndex;
    for (abilityIndex = 0; abilityIndex < 2; abilityIndex += 1) {
        abilityType = "AP_SummonMercenaries";
        if (abilityIndex == 1) { abilityType = "AP_SummonZergMercs"; }
        if (!CatalogEntryIsValid(c_gameCatalogAbil, abilityType)) { continue; }
        count = MinI(64, CatalogFieldValueCount(c_gameCatalogAbil, abilityType, "InfoArray", player));
        for (i = 0; i < count; i += 1) {
            path = "InfoArray[" + IntToString(i) + "]";
            APRG_ClampMercenaryCooldownField(player, abilityType, path + ".Cooldown.TimeUse");
            APRG_ClampMercenaryCooldownField(player, abilityType, path + ".Cooldown.TimeStart");
            link = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, path + ".Cooldown.Link", player);
            if (link == "") { continue; }
            remaining = PlayerGetCooldown(player, link);
            if (remaining > 1000.0) {
                libNtve_gf_PlayerRemoveCooldown(player, link);
                PlayerAddCooldown(player, link, 10.0);
            }
            remaining = PlayerGetChargeRegen(player, link);
            if (remaining > 1000.0) {
                libNtve_gf_PlayerRemoveChargeRegen(player, link);
                PlayerAddChargeRegen(player, link, 10.0);
            }
        }
    }
}

void APRG_SanitizeAllOwnedContractStructureTimers(int player) {
    unitgroup units;
    unit candidate;
    string candidateType;
    int i;
    units = APRG_PlayerAllUnits(player);
    for (i = UnitGroupCount(units, c_unitCountAlive); i > 0; i -= 1) {
        candidate = UnitGroupUnitFromEnd(units, i);
        if (candidate == null || !UnitIsAlive(candidate)) { continue; }
        candidateType = UnitGetType(candidate);
        if (!APRG_IsTerranContractStructureType(candidateType) &&
            !APRG_IsZergContractStructureType(candidateType)) { continue; }
        APRG_SanitizeContractStructureTimers(candidate, player);
    }
}

unit APRG_FindExistingContractStructure(int player, bool terran) {
    unitgroup units;
    int i;
    unit u;
    string unitType;
    units = APRG_PlayerAllUnits(player);
    for (i = UnitGroupCount(units, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null || !UnitIsAlive(u)) { continue; }
        unitType = UnitGetType(u);
        if (terran && APRG_IsTerranContractStructureType(unitType)) { return u; }
        if (!terran && APRG_IsZergContractStructureType(unitType)) { return u; }
    }
    return null;
}

bool APRG_ContractProducedUnitAllowed(int player, string unitType) {
    string apType;
    string rawType;
    if (unitType == "") { return true; }

    if (TechTreeUnitIsAllowed(player, unitType)) { return true; }
    if (StringFind(unitType, "AP_", c_stringCase) == 1) {
        rawType = StringSub(unitType, 4, StringLength(unitType));
        if (
            rawType != "" && CatalogEntryIsValid(c_gameCatalogUnit, rawType) &&
            TechTreeUnitIsAllowed(player, rawType)
        ) { return true; }
        return false;
    }
    apType = "AP_" + unitType;
    if (
        CatalogEntryIsValid(c_gameCatalogUnit, apType) &&
        TechTreeUnitIsAllowed(player, apType)
    ) { return true; }
    return false;
}

void APRG_FilterContractStructureCommandCard(int player, string unitType) {
    int cardCount;
    int cardIndex;
    int buttonCount;
    int buttonIndex;
    int commandIndex;
    string buttonPath;
    string abilCmdText;
    string abilityType;
    string trainedUnitType;
    abilcmd command;

    if (unitType == "" || !CatalogEntryIsValid(c_gameCatalogUnit, unitType)) { return; }
    cardCount = CatalogFieldValueCount(c_gameCatalogUnit, unitType, "CardLayouts", player);
    if (cardCount > 8) { cardCount = 8; }
    for (cardIndex = 0; cardIndex < cardCount; cardIndex += 1) {
        buttonPath = "CardLayouts[" + IntToString(cardIndex) + "].LayoutButtons";
        buttonCount = CatalogFieldValueCount(c_gameCatalogUnit, unitType, buttonPath, player);
        if (buttonCount > 64) { buttonCount = 64; }
        for (buttonIndex = 0; buttonIndex < buttonCount; buttonIndex += 1) {
            abilCmdText = CatalogFieldValueGet(
                c_gameCatalogUnit, unitType,
                buttonPath + "[" + IntToString(buttonIndex) + "].AbilCmd",
                player
            );
            if (abilCmdText == "") { continue; }
            command = StringToAbilCmd(abilCmdText);
            abilityType = AbilityCommandGetAbility(command);
            commandIndex = AbilityCommandGetCommand(command);
            if (
                abilityType == "" ||
                commandIndex < 0 ||
                !CatalogEntryIsValid(c_gameCatalogAbil, abilityType)
            ) { continue; }

            if (!APRG_MercenaryCommandProducesUnit(abilityType, commandIndex, player)) { continue; }

            trainedUnitType = CatalogFieldValueGet(
                c_gameCatalogAbil, abilityType,
                "InfoArray[" + IntToString(commandIndex) + "].Unit",
                player
            );
            if (trainedUnitType == "" || APRG_ContractProducedUnitAllowed(player, trainedUnitType)) { continue; }

            CatalogFieldValueSet(
                c_gameCatalogUnit, unitType,
                buttonPath + "[" + IntToString(buttonIndex) + "].AbilCmd",
                player, ""
            );
            CatalogFieldValueSet(
                c_gameCatalogUnit, unitType,
                buttonPath + "[" + IntToString(buttonIndex) + "].Face",
                player, ""
            );
        }
    }
}

unit APRG_TransformContractStructureToAP(int player, unit source, bool terran) {
    string targetType;
    unit replacement;
    if (source == null || !UnitIsAlive(source)) { return source; }
    targetType = APRG_TerranMercenaryStructureType();
    if (!terran) { targetType = APRG_ZergMercenaryStructureType(); }
    if (targetType == "" || UnitGetType(source) == targetType) {
        APRG_FilterContractStructureCommandCard(player, UnitGetType(source));
        return source;
    }
    if (!CatalogEntryIsValid(c_gameCatalogUnit, targetType)) {
        APRG_FilterContractStructureCommandCard(player, UnitGetType(source));
        return source;
    }

    libNtve_gf_ReplaceUnit(source, targetType, libNtve_ge_ReplaceUnitOptions_OldUnitsRelative);
    replacement = libNtve_gf_LastReplacedUnit();
    if (replacement != null && UnitIsAlive(replacement)) {
        APRG_FilterContractStructureCommandCard(player, UnitGetType(replacement));
        return replacement;
    }
    APRG_FilterContractStructureCommandCard(player, UnitGetType(source));
    return source;
}

bool APRG_IsContractProductionAnchorType(string unitType) {
    if (unitType == "") { return false; }
    if (APRG_IsTownHallType(unitType)) { return true; }
    return StringContains(unitType, "Barracks", c_stringAnywhere, c_stringNoCase)
        || StringContains(unitType, "Factory", c_stringAnywhere, c_stringNoCase)
        || StringContains(unitType, "Starport", c_stringAnywhere, c_stringNoCase)
        || StringContains(unitType, "Gateway", c_stringAnywhere, c_stringNoCase)
        || StringContains(unitType, "WarpGate", c_stringAnywhere, c_stringNoCase)
        || StringContains(unitType, "Robotics", c_stringAnywhere, c_stringNoCase)
        || StringContains(unitType, "Stargate", c_stringAnywhere, c_stringNoCase)
        || StringContains(unitType, "Hatchery", c_stringAnywhere, c_stringNoCase)
        || StringContains(unitType, "Lair", c_stringAnywhere, c_stringNoCase)
        || StringContains(unitType, "Hive", c_stringAnywhere, c_stringNoCase);
}

unit APRG_FindContractSpawnAnchor(int player) {
    unitgroup structures;
    int i;
    unit candidate;
    unit home;
    string unitType;
    structures = APRG_PlayerStructures(player);
    home = APRG_FindPlayerHomeStructure(player);

    for (i = UnitGroupCount(structures, c_unitCountAlive); i > 0; i -= 1) {
        candidate = UnitGroupUnitFromEnd(structures, i);
        if (candidate == null || !UnitIsAlive(candidate)) { continue; }
        unitType = UnitGetType(candidate);
        if (!APRG_IsTownHallType(unitType) && APRG_IsContractProductionAnchorType(unitType)) { return candidate; }
    }
    if (home != null && UnitIsAlive(home)) { return home; }
    for (i = UnitGroupCount(structures, c_unitCountAlive); i > 0; i -= 1) {
        candidate = UnitGroupUnitFromEnd(structures, i);
        if (candidate != null && UnitIsAlive(candidate)) { return candidate; }
    }
    return null;
}

point APRG_ContractStructureSpawnPoint(int player) {
    unit anchor;
    unit home;
    unit alternate;
    unitgroup structures;
    point p;
    int i;

    home = APRG_FindPlayerHomeStructure(player);
    if (home != null && UnitIsAlive(home)) {
        p = APRG_PlayerBuildingSpawnPoint(player, UnitGetPosition(home), 4.0, 16.0);
        if (p != null) { return p; }
    }

    anchor = APRG_FindContractSpawnAnchor(player);
    if (anchor != null && UnitIsAlive(anchor) && anchor != home) {
        p = APRG_PlayerBuildingSpawnPoint(player, UnitGetPosition(anchor), 4.0, 14.0);
        if (p != null) { return p; }
    }

    structures = APRG_PlayerStructures(player);
    for (i = UnitGroupCount(structures, c_unitCountAlive); i > 0; i -= 1) {
        alternate = UnitGroupUnitFromEnd(structures, i);
        if (alternate == null || !UnitIsAlive(alternate) || alternate == anchor || alternate == home) { continue; }
        p = APRG_PlayerBuildingSpawnPoint(player, UnitGetPosition(alternate), 4.0, 14.0);
        if (p != null) { return p; }
    }
    return null;
}

unit APRG_CreateContractStructure(int player, string unitType) {
    int attempt;
    unit existing;
    point p;
    unitgroup created;
    unit result;

    if (!APRG_PlayerMacroBaseReady(player) || unitType == "") { return null; }
    if (!CatalogEntryIsValid(c_gameCatalogUnit, unitType)) { return null; }

    existing = APRG_FindOwnedUnitOfType(player, unitType);
    if (existing != null && UnitIsAlive(existing)) {
        APRG_FilterContractStructureCommandCard(player, UnitGetType(existing));
        return existing;
    }

    for (attempt = 0; attempt < 4; attempt += 1) {
        p = APRG_ContractStructureSpawnPoint(player);
        if (p == null) { continue; }

        created = UnitCreate(1, unitType, 0, player, p, libNtve_gf_RandomAngle());
        if (created == null || UnitGroupCount(created, c_unitCountAlive) <= 0) {
            created = UnitCreate(1, unitType, c_unitCreateIgnorePlacement, player, p, libNtve_gf_RandomAngle());
        }
        if (created == null || UnitGroupCount(created, c_unitCountAlive) <= 0) { continue; }

        result = UnitGroupUnitFromEnd(created, 1);
        if (result == null) { continue; }

        APRG_FilterContractStructureCommandCard(player, UnitGetType(result));
        return result;
    }
    return null;
}

unit APRG_CreateTerranContractStructure(int player) {
    unit result;
    result = APRG_CreateContractStructure(player, "MercCompound");
    if (result != null) { return APRG_TransformContractStructureToAP(player, result, true); }
    result = APRG_CreateContractStructure(player, "AP_MercCompound");
    if (result != null) { return APRG_TransformContractStructureToAP(player, result, true); }
    return null;
}

unit APRG_CreateZergContractStructure(int player) {
    unit result;
    result = APRG_CreateContractStructure(player, "PredatorNest");
    if (result != null) { return APRG_TransformContractStructureToAP(player, result, false); }
    result = APRG_CreateContractStructure(player, "ZergPredatorNest");
    if (result != null) { return APRG_TransformContractStructureToAP(player, result, false); }
    result = APRG_CreateContractStructure(player, "ZergMercenaryCompound");
    if (result != null) { return APRG_TransformContractStructureToAP(player, result, false); }
    result = APRG_CreateContractStructure(player, "AP_PredatorNest");
    if (result != null) { return APRG_TransformContractStructureToAP(player, result, false); }
    result = APRG_CreateContractStructure(player, "AP_ZergPredatorNest");
    if (result != null) { return APRG_TransformContractStructureToAP(player, result, false); }
    result = APRG_CreateContractStructure(player, "AP_ZergMercenaryCompound");
    if (result != null) { return APRG_TransformContractStructureToAP(player, result, false); }
    return null;
}


void APRG_ApplyPrimalKerriganAppearance(unit u) {
    if (u == null) { return; }
}

bool APRG_IsShopKerriganType(string unitType) {
    if (unitType == "" || !StringContains(unitType, "Kerrigan", c_stringAnywhere, c_stringNoCase)) { return false; }
    if (StringContains(unitType, "Egg", c_stringAnywhere, c_stringNoCase)) { return false; }
    if (StringContains(unitType, "Cocoon", c_stringAnywhere, c_stringNoCase)) { return false; }
    if (StringContains(unitType, "Birth", c_stringAnywhere, c_stringNoCase)) { return false; }
    return true;
}

bool APRG_KerriganSpawnPresent(unit u, int player) {
    point p;
    if (u == null || !UnitIsAlive(u) || UnitGetOwner(u) != player) { return false; }
    if (!APRG_IsShopKerriganType(UnitGetType(u))) { return false; }
    if ((g_aprgMissionFlags & APRG_MISSION_FLAG_EPILOGUE_KERRIGAN) != 0 &&
        !DataTableGetBool(true, "APRG_ShopKerrigan_" + IntToString(UnitGetTag(u)))) { return false; }
    // An alive, off-screen mission actor is not a controllable respawn.
    if (!UnitTestState(u, c_unitStateSelectable)) { return false; }
    p = UnitGetPosition(u);
    return p != null && RegionContainsPoint(RegionPlayableMap(), p);
}

unit APRG_FindShopKerrigan(int player) {
    unitgroup units;
    int i;
    unit u;
    units = APRG_PlayerAllUnits(player);
    for (i = UnitGroupCount(units, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (APRG_KerriganSpawnPresent(u, player)) { return u; }
    }
    return null;
}

string APRG_FallbackKerriganType() {
    if (CatalogEntryIsValid(c_gameCatalogUnit, "K5Kerrigan")) { return "K5Kerrigan"; }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "KerriganVoid")) { return "KerriganVoid"; }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "Kerrigan")) { return "Kerrigan"; }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "KerriganInfested")) { return "KerriganInfested"; }
    return "";
}

point APRG_KerriganSafeHomePoint(int player) {
    unit home;
    unit worker;
    unitgroup workers;
    point homePoint;
    point candidate;
    point bestPoint;
    fixed bestScore;
    fixed score;
    int pass;
    int attempt;
    home = APRG_FindPlayerHomeStructure(player);
    if (home == null || !UnitIsAlive(home)) { return null; }
    homePoint = UnitGetPosition(home);
    workers = APRG_PlayerWorkers(player);
    worker = UnitGroupClosestToPoint(workers, homePoint);
    if (worker != null && DistanceBetweenPoints(UnitGetPosition(worker), homePoint) > 16.0) { worker = null; }
    // Prefer the worker's actual reachable ground, but don't let a mission's
    // unusual pathing graph reject all spawn points (e.g. Growing Shadow).
    // Both passes stay near the established home and avoid mineral fields.
    for (pass = 0; pass < 2; pass += 1) {
        bestPoint = null;
        bestScore = 999999.0;
        for (attempt = 0; attempt < 96; attempt += 1) {
            candidate = PointWithOffsetPolar(homePoint, RandomFixed(4.5, 10.0), libNtve_gf_RandomAngle());
            if (candidate == null || !RegionContainsPoint(RegionPlayableMap(), candidate) ||
                !PointPathingPassable(candidate) || APRG_PointNearMineralField(candidate, 4.0) ||
                APRG_PointNearRakShirDuel(candidate, 24.0)) { continue; }
            if (pass == 0 && worker != null &&
                !UnitPathableToPoint(worker, candidate, 2.0, 100000.0)) { continue; }
            score = DistanceBetweenPoints(candidate, homePoint);
            if (worker != null) { score += 0.35 * DistanceBetweenPoints(candidate, UnitGetPosition(worker)); }
            if (score < bestScore) { bestPoint = candidate; bestScore = score; }
        }
        if (bestPoint != null) { return bestPoint; }
    }
    // Last resort: reuse our standard base-near safe-spawn search. Never
    // teleport Kerrigan to a remote mission corner to satisfy placement.
    return APRG_PlayerSafeSpawnPoint(player,
        PointWithOffsetPolar(homePoint, 5.0, libNtve_gf_RandomAngle()));
}

unit APRG_CreateShopKerriganAtHome(int player, string requestedType) {
    string unitType;
    unit home;
    point p;
    unitgroup created;
    unitType = requestedType;
    if (unitType == "" || !CatalogEntryIsValid(c_gameCatalogUnit, unitType)) { unitType = APRG_FallbackKerriganType(); }
    if (unitType == "") { return null; }
    unitType = APRG_PlayerSpawnCatalogTypeForPlayer(unitType, player);
    if (!CatalogEntryIsValid(c_gameCatalogUnit, unitType)) { return null; }
    home = APRG_FindPlayerHomeStructure(player);
    if (home == null || !UnitIsAlive(home)) { return null; }
    p = APRG_KerriganSafeHomePoint(player);
    if (p == null) { return null; } // Retry instead of spawning in an inaccessible corner.
    created = UnitCreate(1, unitType, c_unitCreateIgnorePlacement, player, p, libNtve_gf_RandomAngle());
    if (created == null || UnitGroupCount(created, c_unitCountAlive) <= 0) { return null; }
    home = UnitGroupUnitFromEnd(created, 1);
    if (home != null) {
        DataTableSetBool(true, "APRG_ShopKerrigan_" + IntToString(UnitGetTag(home)), true);
    }
    APRG_ApplyPrimalKerriganAppearance(home);
    return home;
}

unit APRG_CreateShopKerriganAtPoint(int player, string requestedType, point p) {
    string unitType;
    unitgroup created;
    unit result;
    unitType = requestedType;
    if (p == null) { return APRG_CreateShopKerriganAtHome(player, requestedType); }
    if (unitType == "" || !CatalogEntryIsValid(c_gameCatalogUnit, unitType)) { unitType = APRG_FallbackKerriganType(); }
    unitType = APRG_PlayerSpawnCatalogTypeForPlayer(unitType, player);
    if (unitType == "" || !CatalogEntryIsValid(c_gameCatalogUnit, unitType)) { return null; }
    created = UnitCreate(1, unitType, c_unitCreateIgnorePlacement, player, p, libNtve_gf_RandomAngle());
    if (created == null || UnitGroupCount(created, c_unitCountAlive) <= 0) {
        // A mission-owned cocoon can disappear on the same frame we cache its
        // position. If direct recreation fails there, retry at the player's base
        // rather than leaving Kerrigan permanently absent.
        return APRG_CreateShopKerriganAtHome(player, requestedType);
    }
    result = UnitGroupUnitFromEnd(created, 1);
    if (result != null) {
        DataTableSetBool(true, "APRG_ShopKerrigan_" + IntToString(UnitGetTag(result)), true);
    }
    APRG_ApplyPrimalKerriganAppearance(result);
    return result;
}

point APRG_FindKerriganCocoonPoint(int player) {
    unitgroup units;
    int i;
    unit u;
    unit kerriganCocoon = null;
    string unitType;
    units = UnitGroup(null, player, null, UnitFilter(0, 0, 0, 0), 0);
    for (i = UnitGroupCount(units, c_unitCountAll); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null || !UnitIsAlive(u)) { continue; }
        unitType = UnitGetType(u);
        if (unitType == "KerriganReviveCocoon" || unitType == "KerriganXelNagaReviveCocoon") {
            return UnitGetPosition(u);
        }
        if (
            kerriganCocoon == null &&
            StringContains(unitType, "Kerrigan", c_stringAnywhere, c_stringNoCase) &&
            StringContains(unitType, "Cocoon", c_stringAnywhere, c_stringNoCase)
        ) {
            kerriganCocoon = u;
        }
    }
    if (kerriganCocoon != null) { return UnitGetPosition(kerriganCocoon); }
    return null;
}

void APRG_RemoveKerriganReviveCocoons(int player) {
    unitgroup units;
    unit u;
    string unitType;
    int i;
    units = UnitGroup(null, player, null, UnitFilter(0, 0, 0, 0), 0);
    // Only the owning player's Kerrigan revive cocoons, not normal Zerg eggs
    // or cocoons elsewhere on the map. This runs after a successful respawn.
    for (i = UnitGroupCount(units, c_unitCountAll); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null || !UnitIsAlive(u)) { continue; }
        unitType = UnitGetType(u);
        if (unitType == "KerriganReviveCocoon" || unitType == "KerriganXelNagaReviveCocoon" ||
            (StringContains(unitType, "Kerrigan", c_stringAnywhere, c_stringNoCase) &&
             StringContains(unitType, "Cocoon", c_stringAnywhere, c_stringNoCase))) {
            UnitRemove(u);
        }
    }
}

void APRG_PositionShopKerriganAtHome(int player) {
    unit home;
    point p;
    if (g_aprgShopKerrigan == null || !UnitIsAlive(g_aprgShopKerrigan)) { return; }
    home = APRG_FindPlayerHomeStructure(player);
    if (home == null || !UnitIsAlive(home)) { return; }
    p = APRG_KerriganSafeHomePoint(player);
    if (p != null) { UnitSetPosition(g_aprgShopKerrigan, p, true); }
}

int APRG_KerriganRecklessPowerStacks() {
    return g_aprgKerriganUpgradeFlags & 255;
}

int APRG_KerriganRecklessSpeedStacks() {
    return (g_aprgKerriganUpgradeFlags >> 8) & 255;
}

bool APRG_HasKerriganShopUpgrade(int flag) {
    if (flag == APRG_KERRIGAN_RECKLESS_POWER) { return APRG_KerriganRecklessPowerStacks() > 0; }
    if (flag == APRG_KERRIGAN_RECKLESS_SPEED) { return APRG_KerriganRecklessSpeedStacks() > 0; }
    return false;
}

fixed APRG_KerriganRespawnDelay() {
    return 60.0 * IntToFixed(1 + APRG_KerriganRecklessPowerStacks() + APRG_KerriganRecklessSpeedStacks());
}

void APRG_ApplyKerriganShopUpgrades(unit u) {
    string tagKey;
    fixed energyMaximum;
    int powerStacks;
    int speedStacks;
    if (u == null || !UnitIsAlive(u)) { return; }
    tagKey = IntToString(UnitGetTag(u));
    powerStacks = APRG_KerriganRecklessPowerStacks();
    speedStacks = APRG_KerriganRecklessSpeedStacks();

    if (powerStacks > 0) {
        if (UnitBehaviorCount(u, "APRogueKerriganRecklessPower") < powerStacks) {
            UnitBehaviorAdd(u, "APRogueKerriganRecklessPower", u, powerStacks - UnitBehaviorCount(u, "APRogueKerriganRecklessPower"));
        }
        if (!DataTableGetBool(true, "APRG_KerriganRecklessEnergy_" + tagKey)) {
            energyMaximum = UnitGetPropertyFixed(u, c_unitPropEnergyMax, c_unitPropCurrent);
            if (energyMaximum > 0.0) {
                UnitSetPropertyFixed(u, c_unitPropEnergyMax, energyMaximum * (1.0 + 0.5 * IntToFixed(powerStacks)));
            }
            DataTableSetBool(true, "APRG_KerriganRecklessEnergy_" + tagKey, true);
        }
    }
    if (speedStacks > 0 && UnitBehaviorCount(u, "APRogueKerriganRecklessSpeed") < speedStacks) {
        UnitBehaviorAdd(u, "APRogueKerriganRecklessSpeed", u, speedStacks - UnitBehaviorCount(u, "APRogueKerriganRecklessSpeed"));
    }
}

// Only acknowledge a respawn after the unit survives at least a full game
// second inside the playable map. Do not restart the death timer on failure.
void APRG_ConfirmShopKerriganRespawn(int player) {
    g_aprgShopKerriganType = UnitGetType(g_aprgShopKerrigan);
    g_aprgShopKerriganDeathTime = -1.0;
    g_aprgShopKerriganDeathPoint = null;
    g_aprgShopKerriganRespawnPoint = null;
    g_aprgShopKerriganVerifyAt = -1.0;
    g_aprgShopKerriganNextRetryAt = -1.0;
    g_aprgShopKerriganPositioned = true;
    APRG_ApplyPrimalKerriganAppearance(g_aprgShopKerrigan);
    APRG_ApplyKerriganShopUpgrades(g_aprgShopKerrigan);
    // Epilogue mission cocoons may belong to the story Kerrigan.
    if ((g_aprgMissionFlags & APRG_MISSION_FLAG_EPILOGUE_KERRIGAN) == 0) {
        APRG_RemoveKerriganReviveCocoons(player);
    }
    UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaChat, StringToText("Kerrigan has respawned"));
}

void APRG_TickShopKerrigan(int player, fixed now) {
    unit fresh;
    unit home;
    bool replacingTrackedKerrigan;
    fixed respawnDelay;
    fixed respawnElapsed;
    point respawnPoint;
    if (!APRG_HasProgression(APRG_PROGRESSION_KERRIGAN) || !APRG_PlayerMacroBaseReady(player)) { return; }
    respawnDelay = APRG_KerriganRespawnDelay();

    if (g_aprgShopKerriganDeathTime >= 0.0) {
        fresh = APRG_FindShopKerrigan(player);
        respawnElapsed = now - g_aprgShopKerriganDeathTime;
        if (respawnElapsed < respawnDelay) {
            // Native HotS respawns can be up to two seconds ahead of this
            // timer. Preserve their hero when close to the deadline, but do
            // not announce it as respawned until it survives verification.
            if (fresh != null) {
                if (respawnElapsed >= respawnDelay - 2.0) {
                    g_aprgShopKerrigan = fresh;
                    g_aprgShopKerriganType = UnitGetType(fresh);
                }
                else {
                    if (g_aprgShopKerriganType == "") { g_aprgShopKerriganType = UnitGetType(fresh); }
                    UnitRemove(fresh);
                    if (fresh == g_aprgShopKerrigan) { g_aprgShopKerrigan = null; }
                }
            }
            return;
        }

        if (g_aprgShopKerriganVerifyAt >= 0.0) {
            if (APRG_KerriganSpawnPresent(g_aprgShopKerrigan, player)) {
                if (now >= g_aprgShopKerriganVerifyAt) {
                    APRG_ConfirmShopKerriganRespawn(player);
                }
                return;
            }
            // Campaign death/transform callbacks removed this attempt.
            // Retry shortly; the original countdown is still complete.
            g_aprgShopKerriganVerifyAt = -1.0;
            g_aprgShopKerriganNextRetryAt = now + 2.0;
            g_aprgShopKerrigan = null;
        }
        if (now < g_aprgShopKerriganNextRetryAt) { return; }

        // A native respawn is preferred, but don't trust an off-map/invalid
        // Kerrigan merely because UnitIsAlive returned true.
        if (fresh != null && APRG_KerriganSpawnPresent(fresh, player)) {
            g_aprgShopKerrigan = fresh;
            g_aprgShopKerriganType = UnitGetType(fresh);
        }
        else {
            // Avoid UnitRevive on a dead mission hero: some native death
            // triggers immediately kill/remove that handle again. Create a
            // clean hero near the player's base, not in the enemy army that
            // killed the previous one. Use last death/cocoon location only
            // when the base cannot provide a spawn position.
            g_aprgShopKerrigan = APRG_CreateShopKerriganAtHome(player, g_aprgShopKerriganType);
            if (!APRG_KerriganSpawnPresent(g_aprgShopKerrigan, player)) {
                respawnPoint = g_aprgShopKerriganRespawnPoint;
                if (respawnPoint == null) { respawnPoint = g_aprgShopKerriganDeathPoint; }
                g_aprgShopKerrigan = APRG_CreateShopKerriganAtPoint(player, g_aprgShopKerriganType, respawnPoint);
            }
        }
        if (APRG_KerriganSpawnPresent(g_aprgShopKerrigan, player)) {
            // Stabilize at full HP and verify the unit after mission triggers
            // have had a full game second to process its creation.
            UnitSetPropertyFixed(g_aprgShopKerrigan, c_unitPropLifePercent, 100.0);
            home = APRG_FindPlayerHomeStructure(player);
            if (home != null && UnitIsAlive(home)) {
                respawnPoint = APRG_KerriganSafeHomePoint(player);
                if (respawnPoint != null) { UnitSetPosition(g_aprgShopKerrigan, respawnPoint, true); }
            }
            APRG_ApplyPrimalKerriganAppearance(g_aprgShopKerrigan);
            APRG_ApplyKerriganShopUpgrades(g_aprgShopKerrigan);
            g_aprgShopKerriganVerifyAt = now + 1.0;
            g_aprgShopKerriganNextRetryAt = now + 2.0;
        }
        else {
            g_aprgShopKerrigan = null;
            g_aprgShopKerriganNextRetryAt = now + 2.0;
        }
        return;
    }

    fresh = APRG_FindShopKerrigan(player);
    if (fresh != null && fresh != g_aprgShopKerrigan) {
        replacingTrackedKerrigan = (g_aprgShopKerrigan != null);
        g_aprgShopKerrigan = fresh;
        g_aprgShopKerriganType = UnitGetType(fresh);
        g_aprgShopKerriganPositioned = replacingTrackedKerrigan;
        APRG_ApplyPrimalKerriganAppearance(g_aprgShopKerrigan);
        APRG_ApplyKerriganShopUpgrades(g_aprgShopKerrigan);
    }

    if (g_aprgShopKerrigan == null) {
        g_aprgShopKerrigan = APRG_CreateShopKerriganAtHome(player, g_aprgShopKerriganType);
        if (g_aprgShopKerrigan != null) {
            g_aprgShopKerriganType = UnitGetType(g_aprgShopKerrigan);
            g_aprgShopKerriganPositioned = true;
            APRG_ApplyKerriganShopUpgrades(g_aprgShopKerrigan);
        }
        return;
    }

    if (!APRG_KerriganSpawnPresent(g_aprgShopKerrigan, player)) {
        g_aprgShopKerriganDeathTime = now;
        g_aprgShopKerriganDeathPoint = UnitGetPosition(g_aprgShopKerrigan);
        g_aprgShopKerriganRespawnPoint = null;
        g_aprgShopKerriganVerifyAt = -1.0;
        g_aprgShopKerriganNextRetryAt = -1.0;
        UIDisplayMessage(
            PlayerGroupSingle(player), c_messageAreaChat,
            StringToText("[Slay] Kerrigan will respawn in " + IntToString(FixedToInt(respawnDelay)) + " seconds")
        );
        if ((g_aprgMissionFlags & APRG_MISSION_FLAG_EPILOGUE_KERRIGAN) == 0) {
            respawnPoint = APRG_FindKerriganCocoonPoint(player);
            if (respawnPoint != null) { g_aprgShopKerriganRespawnPoint = respawnPoint; }
        }
        return;
    }

    if (!g_aprgShopKerriganPositioned) {
        APRG_PositionShopKerriganAtHome(player);
        g_aprgShopKerriganPositioned = true;
    }
    APRG_ApplyPrimalKerriganAppearance(g_aprgShopKerrigan);
    APRG_ApplyKerriganShopUpgrades(g_aprgShopKerrigan);
}

void APRG_TickContractStructures(int player) {
    fixed life;
    fixed maximum;
    fixed now;
    bool checkMercenaryCooldowns;
    unit existing;
    if (!APRG_PlayerMacroBaseReady(player)) { return; }
    now = GameGetMissionTime();
    checkMercenaryCooldowns = now >= g_aprgNextMercenaryCooldownWatchTime;
    if (checkMercenaryCooldowns) { g_aprgNextMercenaryCooldownWatchTime = now + 3.0; }

    if (APRG_HasProgression(APRG_PROGRESSION_TERRAN_CONTRACTS)) {
        // Resolve each contract building only once per mission. A failed initial
        // placement can be retried; a destroyed building must never be recreated.
        if (!g_aprgTerranContractStructureResolved) {
            existing = APRG_FindExistingContractStructure(player, true);
            if (existing != null) {
                g_aprgTerranContractStructure = APRG_TransformContractStructureToAP(player, existing, true);
            }
            else {
                g_aprgTerranContractStructure = APRG_CreateTerranContractStructure(player);
            }
            if (g_aprgTerranContractStructure != null) { g_aprgTerranContractStructureResolved = true; }
        }
    }

    if (g_aprgTerranContractStructure != null && UnitIsAlive(g_aprgTerranContractStructure)) {
        APRG_FilterContractStructureCommandCard(player, UnitGetType(g_aprgTerranContractStructure));
    }

    if (APRG_HasProgression(APRG_PROGRESSION_ZERG_CONTRACTS)) {
        // Predator Nest has the same permanent-on-death behavior as the compound.
        if (!g_aprgZergContractStructureResolved) {
            existing = APRG_FindExistingContractStructure(player, false);
            if (existing != null) {
                g_aprgZergContractStructure = APRG_TransformContractStructureToAP(player, existing, false);
            }
            else {
                g_aprgZergContractStructure = APRG_CreateZergContractStructure(player);
            }
            if (g_aprgZergContractStructure != null) { g_aprgZergContractStructureResolved = true; }
        }
        if (g_aprgZergContractStructure != null && UnitIsAlive(g_aprgZergContractStructure)) {
            APRG_FilterContractStructureCommandCard(player, UnitGetType(g_aprgZergContractStructure));
        }
        if (g_aprgZergContractStructure != null && UnitIsAlive(g_aprgZergContractStructure) && !CreepIsPresent(UnitGetPosition(g_aprgZergContractStructure))) {
            life = UnitGetPropertyFixed(g_aprgZergContractStructure, c_unitPropLife, c_unitPropCurrent);
            maximum = UnitGetPropertyFixed(g_aprgZergContractStructure, c_unitPropLifeMax, c_unitPropCurrent);
            if (life < maximum) { UnitSetPropertyFixed(g_aprgZergContractStructure, c_unitPropLife, MinF(maximum, life + 5.0)); }
        }
    }
    if (checkMercenaryCooldowns) {
        // Check authoritative AP player-wide links even if a compound has not
        // spawned or AP uses an unusual command card.
        APRG_SanitizeKnownAPMercenaryTimers(player);
        APRG_SanitizeAllOwnedContractStructureTimers(player);
    }
}

unit APRG_FindSpearCaster(int player) {
    unitgroup candidates;
    unit caster;
    if (CatalogEntryIsValid(c_gameCatalogUnit, "AP_SoACaster")) {
        candidates = UnitGroup("AP_SoACaster", player, null, UnitFilter(0, 0, 0, 0), 0);
        caster = UnitGroupUnitFromEnd(candidates, 1);
        if (caster != null) { return caster; }
    }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "SoACaster")) {
        candidates = UnitGroup("SoACaster", player, null, UnitFilter(0, 0, 0, 0), 0);
        caster = UnitGroupUnitFromEnd(candidates, 1);
        if (caster != null) { return caster; }
    }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "SOACaster")) {
        candidates = UnitGroup("SOACaster", player, null, UnitFilter(0, 0, 0, 0), 0);
        caster = UnitGroupUnitFromEnd(candidates, 1);
        if (caster != null) { return caster; }
    }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "SpearOfAdunCaster")) {
        candidates = UnitGroup("SpearOfAdunCaster", player, null, UnitFilter(0, 0, 0, 0), 0);
        caster = UnitGroupUnitFromEnd(candidates, 1);
        if (caster != null) { return caster; }
    }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "VoidSpearofAdun")) {
        candidates = UnitGroup("VoidSpearofAdun", player, null, UnitFilter(0, 0, 0, 0), 0);
        caster = UnitGroupUnitFromEnd(candidates, 1);
        if (caster != null) { return caster; }
    }
    return null;
}

unit APRG_FindSpearAutonomousCaster(int player) {
    unitgroup candidates;
    unit caster;
    if (!CatalogEntryIsValid(c_gameCatalogUnit, "AP_SoAAutonomousCaster")) { return null; }
    candidates = UnitGroup("AP_SoAAutonomousCaster", player, null, UnitFilter(0, 0, 0, 0), 0);
    caster = UnitGroupUnitFromEnd(candidates, 1);
    return caster;
}

fixed APRG_SpearCooldownFactor() {
    fixed factor = 1.0;
    int i;
    for (i = 0; i < g_aprgSpearCooldownReductionStacks; i += 1) { factor *= 0.8; }
    return factor;
}

fixed APRG_SpearCooldownDuration(string abilityType, int costIndex, int player) {
    fixed useTime;
    fixed startTime;
    string prefix;
    prefix = "Cost[" + IntToString(costIndex) + "].Cooldown.";
    useTime = StringToFixed(CatalogFieldValueGet(c_gameCatalogAbil, abilityType, prefix + "TimeUse", player));
    startTime = StringToFixed(CatalogFieldValueGet(c_gameCatalogAbil, abilityType, prefix + "TimeStart", player));
    return MaxF(useTime, startTime);
}

void APRG_SetSpearCooldownLink(unit caster, int player, string link, fixed duration) {
    if (link == "" || duration <= 0.0) { return; }
    UnitModifyCooldown(caster, link, duration, c_cooldownOperationSet);
    libNtve_gf_PlayerRemoveCooldown(player, link);
    PlayerAddCooldown(player, link, duration);
}

void APRG_SaveSpearBaseRegen(unit caster) {
    string baseKey;
    string savedKey;
    fixed originalRegen;
    fixed savedRegen;
    if (caster == null) { return; }
    baseKey = IntToString(UnitGetTag(caster));
    savedKey = "APRG_SpearBaseRegenSaved_" + baseKey;
    originalRegen = UnitGetPropertyFixed(caster, c_unitPropEnergyRegen, c_unitPropCurrent);
    savedRegen = DataTableGetFixed(true, "APRG_SpearBaseRegen_" + baseKey);
    if (!DataTableGetBool(true, "APRG_SpearBaseUnlocked_" + baseKey)) {
        if (!DataTableGetBool(true, savedKey) || originalRegen > savedRegen) {
            DataTableSetFixed(true, "APRG_SpearBaseRegen_" + baseKey, originalRegen);
            DataTableSetBool(true, savedKey, true);
        }
    }
}

fixed APRG_SpearBonusRegen() {
    fixed bonus = 0.0;
    int i;
    for (i = 0; i < g_aprgSpearEnergyRegenStacks; i += 1) { bonus += 0.5; }
    return bonus;
}

fixed APRG_SpearDesiredRegen(unit caster) {
    string baseKey;
    fixed desired;
    if (caster == null) { return 0.0; }
    baseKey = IntToString(UnitGetTag(caster));
    desired = DataTableGetFixed(true, "APRG_SpearBaseRegen_" + baseKey) + APRG_SpearBonusRegen();
    return desired;
}

void APRG_PinSpearPreBase(unit caster, int player) {
    int abilityIndex;
    int abilityCount;
    int costIndex;
    string abilityType;
    string link;
    fixed duration;
    if (caster == null) { return; }
    APRG_SaveSpearBaseRegen(caster);
    UnitSetPropertyFixed(caster, c_unitPropEnergy, 0.0);
    UnitSetPropertyFixed(caster, c_unitPropEnergyRegen, 0.0);
    abilityCount = MinI(64, UnitAbilityCount(caster));
    for (abilityIndex = 1; abilityIndex <= abilityCount; abilityIndex += 1) {
        abilityType = UnitAbilityGet(caster, abilityIndex);
        if (abilityType == "" || !CatalogEntryIsValid(c_gameCatalogAbil, abilityType)) { continue; }
        UnitAbilityEnable(caster, abilityType, false);
        for (costIndex = 0; costIndex < 4; costIndex += 1) {
            link = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, "Cost[" + IntToString(costIndex) + "].Cooldown.Link", player);
            duration = APRG_SpearCooldownDuration(abilityType, costIndex, player);
            APRG_SetSpearCooldownLink(caster, player, link, duration);
        }
    }
}

void APRG_ApplySpearCooldownCatalog(int player, unit caster) {
    int abilityIndex;
    int abilityCount;
    int costIndex;
    string abilityType;
    string field;
    string key;
    fixed value;
    fixed factor;
    factor = APRG_SpearCooldownFactor();
    abilityCount = MinI(64, UnitAbilityCount(caster));
    for (abilityIndex = 1; abilityIndex <= abilityCount; abilityIndex += 1) {
        abilityType = UnitAbilityGet(caster, abilityIndex);
        if (abilityType == "" || !CatalogEntryIsValid(c_gameCatalogAbil, abilityType)) { continue; }
        key = "APRG_SpearCooldownCatalog_" + IntToString(player) + "_" + abilityType;
        if (DataTableGetBool(true, key)) { continue; }
        for (costIndex = 0; costIndex < 4; costIndex += 1) {
            field = "Cost[" + IntToString(costIndex) + "].Cooldown.TimeUse";
            value = StringToFixed(CatalogFieldValueGet(c_gameCatalogAbil, abilityType, field, player));
            if (value > 0.0 && factor != 1.0) { CatalogFieldValueSet(c_gameCatalogAbil, abilityType, field, player, FixedToString(value * factor, c_fixedPrecisionAny)); }
            field = "Cost[" + IntToString(costIndex) + "].Cooldown.TimeStart";
            value = StringToFixed(CatalogFieldValueGet(c_gameCatalogAbil, abilityType, field, player));
            if (value > 0.0 && factor != 1.0) { CatalogFieldValueSet(c_gameCatalogAbil, abilityType, field, player, FixedToString(value * factor, c_fixedPrecisionAny)); }
        }
        DataTableSetBool(true, key, true);
    }
}

void APRG_ReleaseSpearCooldownsAtBase(unit caster, int player) {
    int abilityIndex;
    int abilityCount;
    int costIndex;
    string abilityType;
    string link;
    fixed duration;
    string key;
    if (caster == null) { return; }
    key = "APRG_SpearCooldownReleased_" + IntToString(UnitGetTag(caster));
    APRG_ApplySpearCooldownCatalog(player, caster);
    abilityCount = MinI(64, UnitAbilityCount(caster));
    for (abilityIndex = 1; abilityIndex <= abilityCount; abilityIndex += 1) {
        abilityType = UnitAbilityGet(caster, abilityIndex);
        if (abilityType == "" || !CatalogEntryIsValid(c_gameCatalogAbil, abilityType)) { continue; }
        UnitAbilityEnable(caster, abilityType, true);
        if (DataTableGetBool(true, key)) { continue; }
        for (costIndex = 0; costIndex < 4; costIndex += 1) {
            link = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, "Cost[" + IntToString(costIndex) + "].Cooldown.Link", player);
            duration = APRG_SpearCooldownDuration(abilityType, costIndex, player);
            APRG_SetSpearCooldownLink(caster, player, link, duration);
        }
    }
    DataTableSetBool(true, key, true);
}

// AP's autonomous Spear caster owns passive actions (including Reconstruction
// Beam).  The pre-base gate disables its abilities too, but cooldown cleanup
// belongs only to the controllable caster. Re-enable autonomous abilities
// separately so passives recover when the player base is established.
void APRG_ReleaseSpearAutonomousAbilitiesAtBase(unit caster) {
    int abilityIndex;
    int abilityCount;
    string abilityType;
    if (caster == null) { return; }
    abilityCount = MinI(64, UnitAbilityCount(caster));
    for (abilityIndex = 1; abilityIndex <= abilityCount; abilityIndex += 1) {
        abilityType = UnitAbilityGet(caster, abilityIndex);
        if (abilityType == "" || !CatalogEntryIsValid(c_gameCatalogAbil, abilityType)) { continue; }
        UnitAbilityEnable(caster, abilityType, true);
    }
}

void APRG_ReleaseSpearEnergyAtBase(unit caster) {
    string baseKey;
    string unlockedKey;
    if (caster == null) { return; }
    APRG_SaveSpearBaseRegen(caster);
    baseKey = IntToString(UnitGetTag(caster));
    unlockedKey = "APRG_SpearBaseUnlocked_" + baseKey;
    if (!DataTableGetBool(true, unlockedKey)) {
        UnitSetPropertyFixed(caster, c_unitPropEnergy, 0.0);
        DataTableSetBool(true, unlockedKey, true);
    }
    UnitSetPropertyFixed(caster, c_unitPropEnergyRegen, APRG_SpearDesiredRegen(caster));
}

void APRG_TickSpearEnergyBonus(unit caster, fixed now) {
    if (caster == null) { return; }
    UnitSetPropertyFixed(caster, c_unitPropEnergyRegen, APRG_SpearDesiredRegen(caster));
    g_aprgSpearLastEnergyBonusTime = now;
}

void APRG_TickSpearBaseGate(int player) {
    unit caster;
    unit autonomousCaster;
    fixed now;
    if (!APRG_HasProgression(APRG_PROGRESSION_SPEAR)) { return; }
    caster = APRG_FindSpearCaster(player);
    autonomousCaster = APRG_FindSpearAutonomousCaster(player);
    if (caster == null && autonomousCaster == null) { return; }
    now = GameGetMissionTime();

    if (!APRG_PlayerMacroBaseReady(player)) {
        APRG_PinSpearPreBase(caster, player);
        APRG_PinSpearPreBase(autonomousCaster, player);
        g_aprgSpearLastEnergyBonusTime = now;
        return;
    }

    APRG_ReleaseSpearEnergyAtBase(caster);
    APRG_ReleaseSpearEnergyAtBase(autonomousCaster);
    APRG_TickSpearEnergyBonus(caster, now);
    APRG_TickSpearEnergyBonus(autonomousCaster, now);

    APRG_ReleaseSpearCooldownsAtBase(caster, player);
    APRG_ReleaseSpearAutonomousAbilitiesAtBase(autonomousCaster);
}

bool APRG_SpearGate_Func(bool testConds, bool runActions) {
    if (!runActions) { return true; }
    APRG_TickSpearBaseGate(APRG_GetPrimaryPlayer());
    return true;
}

bool APRG_ArgumentUnitEligible(unit u, int player) {
    if (u == null || !UnitIsAlive(u) || UnitGetOwner(u) != player) { return false; }
    if (DataTableGetBool(true, "APRG_Uncommandable_" + IntToString(UnitGetTag(u)))) { return false; }
    return true;
}

void APRG_TickArguments(int player, fixed now) {
    unitgroup units;
    unit attacker;
    unit target;
    unit candidate;
    int attempt;
    if (!APRG_PlayerMacroBaseReady(player)) { return; }
    if (g_aprgNextArgumentsTime < 0.0) { g_aprgNextArgumentsTime = now + RandomFixed(20.0, 60.0); return; }
    if (now < g_aprgNextArgumentsTime) { return; }
    units = APRG_PlayerMobileUnits(player);
    attacker = null;
    target = null;
    for (attempt = 0; attempt < 16; attempt += 1) {
        candidate = UnitGroupRandomUnit(units, c_unitCountAlive);
        if (APRG_ArgumentUnitEligible(candidate, player)) { attacker = candidate; break; }
    }
    if (attacker != null) {
        for (attempt = 0; attempt < 24; attempt += 1) {
            candidate = UnitGroupRandomUnit(units, c_unitCountAlive);
            if (candidate != attacker && APRG_ArgumentUnitEligible(candidate, player)) { target = candidate; break; }
        }
    }
    if (attacker != null && target != null) {
        UnitIssueOrder(attacker, OrderTargetingUnit(AbilityCommand("attack", 0), target), c_orderQueueReplace);
    }
    g_aprgNextArgumentsTime = now + RandomFixed(20.0, 60.0);
}

void APRG_ApplyGodModeCatalog(int player) {
    int count;
    int i;
    int infoCount;
    int infoIndex;
    string unitType;
    string abilityType;
    string basePath;
    string producedUnit;
    fixed buildTime;
    fixed entryTime;
    if (!g_aprgGodMode || g_aprgGodModeCatalogApplied || player <= 0) { return; }

    count = CatalogEntryCount(c_gameCatalogUnit);
    for (i = 1; i <= count; i += 1) {
        unitType = CatalogEntryGet(c_gameCatalogUnit, i);
        if (unitType == "" || !CatalogEntryIsValid(c_gameCatalogUnit, unitType)) { continue; }
        buildTime = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "BuildTime", player));
        if (buildTime > 0.1) { CatalogFieldValueSet(c_gameCatalogUnit, unitType, "BuildTime", player, "0.1"); }
    }
    count = CatalogEntryCount(c_gameCatalogAbil);
    for (i = 1; i <= count; i += 1) {
        abilityType = CatalogEntryGet(c_gameCatalogAbil, i);
        if (abilityType == "" || !CatalogEntryIsValid(c_gameCatalogAbil, abilityType)) { continue; }
        infoCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, "InfoArray", player);
        for (infoIndex = 0; infoIndex < infoCount; infoIndex += 1) {
            basePath = "InfoArray[" + IntToString(infoIndex) + "]";
            producedUnit = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, basePath + ".Unit", player);
            if (producedUnit == "" && CatalogFieldValueCount(c_gameCatalogAbil, abilityType, basePath + ".Unit", player) <= 0) { continue; }
            entryTime = StringToFixed(CatalogFieldValueGet(c_gameCatalogAbil, abilityType, basePath + ".Time", player));
            if (entryTime > 0.1) { CatalogFieldValueSet(c_gameCatalogAbil, abilityType, basePath + ".Time", player, "0.1"); }
        }
    }
    g_aprgGodModeCatalogApplied = true;
}

void APRG_TickGodMode(int player) {
    if (!g_aprgGodMode || player <= 0) { return; }
    APRG_ApplyGodModeCatalog(player);
    if (PlayerGetPropertyInt(player, c_playerPropMinerals) < 1000000) {
        PlayerModifyPropertyInt(player, c_playerPropMinerals, c_playerPropOperSetTo, 1000000);
    }
    if (PlayerGetPropertyInt(player, c_playerPropVespene) < 1000000) {
        PlayerModifyPropertyInt(player, c_playerPropVespene, c_playerPropOperSetTo, 1000000);
    }
}

// Production is blocked PER ACTOR, never via global catalog rewrites.
// Other modes do not enter this path. Restrict only recognized native worker,
// production-building and larva actors; scripted special heroes and tactical
// unit morphs (Siege/Viking/Burrow etc.) remain functional.
// Strip only the known Archipelago CUnit prefix. A broadly fuzzy
// unit-name match can disable hero abilities and mission mechanics.
string APRG_CrewEconomyType(string unitType) {
    if (StringFind(unitType, "AP_", c_stringCase) == 1) {
        return StringSub(unitType, 4, StringLength(unitType));
    }
    return unitType;
}

bool APRG_CrewProductionHostType(string unitType) {
    string t = APRG_CrewEconomyType(unitType);
    return (t == "SCV" || t == "Drone" || t == "Probe" ||
            t == "Larva" ||
            t == "CommandCenter" || t == "OrbitalCommand" ||
            t == "PlanetaryFortress" ||
            t == "Hatchery" || t == "Lair" || t == "Hive" ||
            t == "Nexus" || t == "Zergling" ||
            t == "Corruptor" || t == "Roach" ||
            t == "Hydralisk" ||
            t == "Barracks" || t == "Factory" || t == "Starport" ||
            t == "BarracksFlying" || t == "FactoryFlying" ||
            t == "StarportFlying" ||
            t == "Gateway" || t == "WarpGate" ||
            t == "RoboticsFacility" || t == "Stargate" ||
            // These grant paid unit calldowns/training in Archipelago.
            // Do not affect the campaign's scripted reinforcement triggers.
            t == "MercCompound" || t == "MercenaryCompound" ||
            t == "PredatorNest" || t == "ZergPredatorNest" ||
            t == "ZergMercenaryCompound");
}

bool APRG_CrewPurchasedMorphAbility(string unitType, string abilityType) {
    string t = APRG_CrewEconomyType(unitType);
    // Burrow/unburrow are tactical transformations, even on workers.
    // Never globally disable every CAbilMorph on a Drone.
    if (StringContains(abilityType, "Burrow", c_stringAnywhere, c_stringNoCase)) {
        return false;
    }
    if (t == "Larva" || t == "Drone") { return true; }
    if (t == "Hatchery" &&
        StringContains(abilityType, "Lair", c_stringAnywhere, c_stringNoCase)) { return true; }
    if (t == "Lair" &&
        StringContains(abilityType, "Hive", c_stringAnywhere, c_stringNoCase)) { return true; }
    if (t == "CommandCenter" &&
        (StringContains(abilityType, "Orbital", c_stringAnywhere, c_stringNoCase) ||
         StringContains(abilityType, "Planetary", c_stringAnywhere, c_stringNoCase))) { return true; }
    if (t == "Zergling" &&
        StringContains(abilityType, "Baneling", c_stringAnywhere, c_stringNoCase)) { return true; }
    if (t == "Corruptor" &&
        StringContains(abilityType, "BroodLord", c_stringAnywhere, c_stringNoCase)) { return true; }
    if (t == "Roach" &&
        StringContains(abilityType, "Ravager", c_stringAnywhere, c_stringNoCase)) { return true; }
    if (t == "Hydralisk" &&
        StringContains(abilityType, "Lurker", c_stringAnywhere, c_stringNoCase)) { return true; }
    return false;
}

int APRG_CrewNativeTypeCode(string nativeType);
void APRG_CrewDoubleSpawnDurability(unit target);
bool APRG_CrewProdAdvanceTraining(unit producer,string expectedType);
bool APRG_CrewProdAdvanceConstruction(unit built);
bool APRG_CrewProdCanReplaceConstruction(string nativeType);
bool APRG_CrewProdReplaceStalledFoundation(unit built);
void APRG_CrewProdClamp(unitgroup owned,int player);
// Dev51 Crew native production. Crew-only CAbil and CUnit resource prices
// are zero, including repairs. Purchased-copy receipts still gate completion.
// Orders may begin immediately; entitlement claims begin after verified End.
string APRG_CrewProdCanonical(string nativeType) {
    string t=APRG_CrewEconomyType(nativeType);
    if (t=="TrooperMengsk" || t=="TrooperRifle" ||
        t=="TrooperFlamethrower" || t=="TrooperMissileLauncher") { return "Trooper"; }
    if (t=="BarracksTechLab" || t=="FactoryTechLab" || t=="StarportTechLab") { return "TechLab"; }
    if (t=="BarracksReactor" || t=="FactoryReactor" || t=="StarportReactor") { return "Reactor"; }
    return t;
}

bool APRG_CrewProdUnitType(string nativeType) {
    return APRG_CrewNativeTypeCode(nativeType) > 0;
}

string APRG_CrewProdListKey(string nativeType) {
    return "APRG_CrewProdList_" + IntToString(g_aprgCrewDeathToken) + "_" + nativeType;
}

int APRG_CrewProdClaim(string nativeType) {
    string listKey;
    string usedKey;
    int number;
    int i;
    if (!g_aprgCrewProdReady || !APRG_CrewProdUnitType(nativeType) || g_aprgCrewDeathToken <= 0) {
        return 0;
    }
    listKey = APRG_CrewProdListKey(nativeType);
    for (i=1; i<=DataTableGetInt(true,listKey+"_Count"); i+=1) {
        number = DataTableGetInt(true,listKey+"_"+IntToString(i));
        usedKey = "APRG_CrewProdSpent_"+IntToString(g_aprgCrewDeathToken)+"_"+IntToString(number);
        if (number>0 && !DataTableGetBool(true,usedKey)) {
            // Reserve BEFORE changing SC2 progress. Parallel trains and builds
            // can never claim the same individually purchased copy.
            DataTableSetBool(true,usedKey,true);
            if (g_aprgCrewDeathBank!=null) {
                BankValueSetFromInt(g_aprgCrewDeathBank,
                    "Session"+IntToString(g_aprgCrewDeathToken),
                    "Claim"+IntToString(number),g_aprgCrewDeathToken);
                // No BankSave in Claim: synchronous saves here introduced
                // a regression after Dev56's successful training test.
            }
            return number;
        }
    }
    return 0;
}

void APRG_CrewProdReturn(int number) {
    if (number>0 && g_aprgCrewDeathToken>0) {
        DataTableSetBool(true,"APRG_CrewProdSpent_"+IntToString(g_aprgCrewDeathToken)+"_"+
            IntToString(number),false);
        if (g_aprgCrewDeathBank!=null) {
            BankValueSetFromInt(g_aprgCrewDeathBank,
                "Session"+IntToString(g_aprgCrewDeathToken),
                "Claim"+IntToString(number),0);
        }
    }
}

void APRG_CrewProdReceiptTag(unit completed, int producerTag, int number, bool trained) {
    string prefix;
    string section;
    string nativeType;
    int player;
    if (number<=0 || completed==null || producerTag<=0 || g_aprgCrewDeathBank==null) { return; }
    player=APRG_GetPrimaryPlayer();
    if (UnitGetOwner(completed)!=player || !UnitIsAlive(completed)) { return; }
    nativeType=APRG_CrewProdCanonical(UnitGetType(completed));
    if (!APRG_CrewProdUnitType(nativeType)) { return; }
    if (trained) { prefix="Train"+IntToString(number); }
    else { prefix="Build"+IntToString(number); }
    section="Session"+IntToString(g_aprgCrewDeathToken);
    BankValueSetFromInt(g_aprgCrewDeathBank,section,prefix+"Tag",UnitGetTag(completed));
    BankValueSetFromInt(g_aprgCrewDeathBank,section,prefix+"Worker",producerTag);
    BankValueSetFromInt(g_aprgCrewDeathBank,section,prefix+"Type",APRG_CrewNativeTypeCode(nativeType));
    BankValueSetFromInt(g_aprgCrewDeathBank,section,prefix+"Owner",player);
    BankValueSetFromInt(g_aprgCrewDeathBank,section,prefix+"Complete",g_aprgCrewDeathToken);
    BankSave(g_aprgCrewDeathBank);
    DataTableSetBool(true,"APRG_CrewTracked_"+IntToString(g_aprgCrewDeathToken)+"_"+
        IntToString(UnitGetTag(completed)),true);
    APRG_CrewDoubleSpawnDurability(completed);
}

// Dev56: independent, bank-backed production diagnostics. These only observe
// Crew processing and never create units or authorize unpaid production.
void APRG_CrewProdDiagnostic(string eventName, int detail) {
    string key;
    int count;
    if (g_aprgCrewDeathBank==null || g_aprgCrewDeathToken<=0) { return; }
    key="APRG_CrewProdDiag_"+eventName;
    count=DataTableGetInt(true,key)+1;
    DataTableSetInt(true,key,count);
    BankValueSetFromInt(g_aprgCrewDeathBank,"Session"+IntToString(g_aprgCrewDeathToken),
        "ProdDiag"+eventName,count);
    BankValueSetFromInt(g_aprgCrewDeathBank,"Session"+IntToString(g_aprgCrewDeathToken),
        "ProdLast"+eventName,detail);
    BankSave(g_aprgCrewDeathBank);
}

bool APRG_CrewAbilityTrainsUnit(string ability,int player,string nativeType,int recipeCount);
void APRG_CrewProdConfigure(unit u,int player);

// Mid-mission AP items may arrive after the producer was first configured.
// Refresh existing native CAbilTrain recipes for THIS unlocked unit. Never
// synthesize an AP recipe or expose unrelated train commands globally.
void APRG_CrewRefreshUnitUnlock(int player,string nativeType) {
    unitgroup group;
    unit u;
    int i;
    int j;
    int count;
    int recipeCount;
    bool found=false;
    string host="";
    string ability;
    string unitName;
    string baseName;
    if (nativeType=="Trooper" || nativeType=="Marine" || nativeType=="Marauder" ||
        nativeType=="Firebat" || nativeType=="Reaper" || nativeType=="Medic") {
        host="Barracks";
    }
    // The initial fix focuses on the observed Dominion Trooper failure.
    if (host=="") { return; }
    group=APRG_PlayerAllUnits(player);
    for (i=UnitGroupCount(group,c_unitCountAlive);i>0;i-=1) {
        u=UnitGroupUnitFromEnd(group,i);
        if (u==null || !UnitIsAlive(u) || UnitGetOwner(u)!=player ||
            APRG_CrewEconomyType(UnitGetType(u))!=host) { continue; }
        APRG_CrewProdConfigure(u,player);
        count=MinI(96,UnitAbilityCount(u));
        for (j=1;j<=count;j+=1) {
            ability=UnitAbilityGet(u,j);
            if (ability=="" || !CatalogEntryIsValid(c_gameCatalogAbil,ability) ||
                AbilityClass(ability)!=c_classIdCAbilTrain) { continue; }
            recipeCount=MinI(96,CatalogFieldValueCount(c_gameCatalogAbil,ability,"InfoArray",player));
            // Scan all native recipes without hiding any existing unit choices.
            // UnitAbilityShow only affects an already-present producer ability.
            if (APRG_CrewAbilityTrainsUnit(ability,player,nativeType,recipeCount)) {
                UnitAbilityEnable(u,ability,true);
                UnitAbilityShow(u,ability,true);
                found=true;
            }
        }
    }
    if (nativeType=="Trooper") {
        if (found) { APRG_CrewProdDiagnostic("TrooperRecipeFound",30); }
        else { APRG_CrewProdDiagnostic("TrooperRecipeMissing",30); }
    }
}

bool APRG_CrewAbilityTrainsUnit(string ability,int player,string nativeType,int recipeCount) {
    int k;
    string candidate;
    string path;
    for (k=0;k<recipeCount;k+=1) {
        path="InfoArray["+IntToString(k)+"].Unit";
        candidate=CatalogFieldValueGet(c_gameCatalogAbil,ability,path,player);
        if (candidate=="") {
            candidate=CatalogFieldValueGet(c_gameCatalogAbil,ability,path+"[0]",player);
        }
        if (APRG_CrewProdCanonical(candidate)==nativeType) { return true; }
    }
    return false;
}

// Crew paid reserve unlocks affect the unit's tech-tree availability only.
// Native Archipelago is still responsible for its normal command-card and
// campaign progression rules. In particular do NOT use UnitAbilityEnable/
// UnitAbilityShow here: doing that exposed extra production commands on
// every Barracks/Factory/Starport in Dev69.
void APRG_CrewUnlockNativeUnit(int player,string nativeType) {
    string apVariant;
    unitgroup owned;
    unit cc;
    int i;
    if (nativeType=="" || nativeType=="TechLab" || nativeType=="Reactor" ||
        !APRG_CrewProdUnitType(nativeType)) { return; }
    // Unlike normal Crew structures, PF is an AP upgrade of an existing CC.
    // Grant its AP tech-tree permission only after a verified paid stock item.
    // The native Specialize/receipt path still consumes one PF copy per morph.
    if (nativeType=="PlanetaryFortress") {
        if (CatalogEntryIsValid(c_gameCatalogUnit,"PlanetaryFortress")) {
            TechTreeUnitAllow(player,"PlanetaryFortress",true);
        }
        if (CatalogEntryIsValid(c_gameCatalogUnit,"AP_PlanetaryFortress")) {
            TechTreeUnitAllow(player,"AP_PlanetaryFortress",true);
        }
        // A PF copy may be purchased MID-MISSION, after a Command Center was
        // already configured. Refresh its existing native specialization
        // ability without adding/synthesizing another command to the card.
        owned=APRG_PlayerAllUnits(player);
        for (i=UnitGroupCount(owned,c_unitCountAlive);i>0;i-=1) {
            cc=UnitGroupUnitFromEnd(owned,i);
            if (cc!=null && UnitIsAlive(cc) && UnitGetOwner(cc)==player &&
                APRG_CrewProdCanonical(UnitGetType(cc))=="CommandCenter") {
                APRG_CrewProdConfigure(cc,player);
            }
        }
        return;
    }
    if (CatalogEntryIsValid(c_gameCatalogUnit,nativeType)) {
        TechTreeUnitAllow(player,nativeType,true);
    }
    apVariant="AP_"+nativeType;
    if (CatalogEntryIsValid(c_gameCatalogUnit,apVariant)) {
        TechTreeUnitAllow(player,apVariant,true);
    }
    APRG_CrewRefreshUnitUnlock(player,nativeType);
}

// Dev73: The Python Crew roster adopts one real controllable actor at a time.
// Confirm the exact *native actor tag*, owner and engine CUnit before adding
// the deployed flag and the regular 2x HP/shields. Per-instance and idempotent.
bool APRG_CrewAdopt_Func(bool testConds,bool runActions) {
    int token;
    int tag;
    int player;
    string nativeType;
    unitgroup owned;
    unit candidate;
    unit u;
    int i;
    string section;
    if (!runActions || !g_aprgCrewProdReady || g_aprgCrewDeathBank==null ||
        (g_aprgMissionFlags & APRG_MISSION_FLAG_CREW_CHALLENGE)==0) { return true; }
    player=APRG_GetPrimaryPlayer();
    token=StringToInt(StringWord(EventChatMessage(false),2));
    tag=StringToInt(StringWord(EventChatMessage(false),3));
    nativeType=StringWord(EventChatMessage(false),4);
    if (EventPlayer()!=player || token!=g_aprgCrewDeathToken || tag<=0 ||
        !APRG_CrewProdUnitType(nativeType) || nativeType=="TechLab" ||
        nativeType=="PlanetaryFortress") { return true; }
    owned=APRG_PlayerAllUnits(player);
    candidate=null;
    for (i=UnitGroupCount(owned,c_unitCountAlive);i>0;i-=1) {
        u=UnitGroupUnitFromEnd(owned,i);
        if (u!=null && UnitIsAlive(u) && UnitGetOwner(u)==player &&
            UnitGetTag(u)==tag &&
            !UnitTypeTestAttribute(UnitGetType(u),c_unitAttributeStructure) &&
            APRG_CrewProdCanonical(UnitGetType(u))==nativeType) {
            candidate=u;
            break;
        }
    }
    if (candidate==null) { return true; }
    if (!DataTableGetBool(true,"APRG_CrewDeployed_"+IntToString(token)+"_"+
        IntToString(tag))) {
        APRG_CrewDoubleSpawnDurability(candidate);
    }
    DataTableSetBool(true,"APRG_CrewTracked_"+IntToString(token)+"_"+
        IntToString(tag),true);
    section="Session"+IntToString(token);
    BankValueSetFromInt(g_aprgCrewDeathBank,section,"AdoptTag"+IntToString(tag),
        APRG_CrewNativeTypeCode(nativeType));
    BankSave(g_aprgCrewDeathBank);
    return true;
}

// Dev73: discovery/reward ownership can change *during* an existing mission.
// Advertise only the AP unit's tech-tree availability, not a free unit copy.
// The Python roster is independently authoritative for stocks and receipts.
bool APRG_CrewUnlockDiscovered_Func(bool testConds,bool runActions) {
    int player;
    int token;
    string nativeType;
    if (!runActions || !g_aprgCrewProdReady || g_aprgCrewDeathBank==null ||
        (g_aprgMissionFlags & APRG_MISSION_FLAG_CREW_CHALLENGE)==0) { return true; }
    player=APRG_GetPrimaryPlayer();
    token=StringToInt(StringWord(EventChatMessage(false),2));
    nativeType=StringWord(EventChatMessage(false),3);
    if (EventPlayer()!=player || token!=g_aprgCrewDeathToken ||
        !APRG_CrewProdUnitType(nativeType) ||
        nativeType=="TechLab") { return true; }
    if (!DataTableGetBool(true,"APRG_CrewUnlocked_"+IntToString(token)+"_"+nativeType)) {
        DataTableSetBool(true,"APRG_CrewUnlocked_"+IntToString(token)+"_"+nativeType,true);
        APRG_CrewUnlockNativeUnit(player,nativeType);
    }
    return true;
}

// Bank individual purchased copies once. Duplicate messages are idempotent;
// a spent ID can never become unspent through another stock message.
// Display confirmed Crew building losses inside the native Slay chat UI.
// The client has already authenticated the banked death and assessed the
// correct catalog price. Only a matching current Crew session can notify.
bool APRG_CrewLossNotice_Func(bool testConds,bool runActions) {
    string msg;
    string name;
    int player;
    int token;
    int cost;
    if (!runActions || !g_aprgCrewProdReady ||
        (g_aprgMissionFlags & APRG_MISSION_FLAG_CREW_CHALLENGE)==0) { return true; }
    player=APRG_GetPrimaryPlayer();
    msg=EventChatMessage(false);
    token=StringToInt(StringWord(msg,2));
    cost=StringToInt(StringWord(msg,3));
    name=StringWord(msg,4);
    if (EventPlayer()!=player || token!=g_aprgCrewDeathToken ||
        cost<=0 || cost>1000 || name=="") { return true; }
    if (name=="Supply_Depot") { name="Supply Depot"; }
    else if (name=="Command_Center") { name="Command Center"; }
    else if (name=="Engineering_Bay") { name="Engineering Bay"; }
    else if (name=="Tech_Lab") { name="Tech Lab"; }
    else if (name=="Planetary_Fortress") { name="Planetary Fortress"; }
    else if (name=="Missile_Turret") { name="Missile Turret"; }
    else if (name=="Sensor_Tower") { name="Sensor Tower"; }
    else if (name=="Spawning_Pool") { name="Spawning Pool"; }
    else if (name=="Photon_Cannon") { name="Photon Cannon"; }
    UIDisplayMessage(PlayerGroupSingle(player),c_messageAreaChat,
        StringToText("[Slay] "+name+" destroyed, subtracting "+IntToString(cost)+" credits"));
    return true;
}

bool APRG_CrewProdStock_Func(bool testConds,bool runActions) {
    int player;
    int token;
    int count;
    int i;
    int k;
    int number;
    int newlyAuthorized=0;
    string nativeType;
    string msg;
    string key;
    string listKey;
    string previous;
    if (!runActions || !g_aprgCrewProdReady || g_aprgCrewDeathBank==null ||
        (g_aprgMissionFlags & APRG_MISSION_FLAG_CREW_CHALLENGE)==0) { return true; }
    player=APRG_GetPrimaryPlayer();
    msg=EventChatMessage(false);
    token=StringToInt(StringWord(msg,2));
    count=StringToInt(StringWord(msg,3));
    if (EventPlayer()!=player || token!=g_aprgCrewDeathToken || count<1 || count>6) { return true; }
    // Validate entire batch before granting even one authorization.
    for (i=0; i<count; i+=1) {
        number=StringToInt(StringWord(msg,4+i*2));
        nativeType=StringWord(msg,5+i*2);
        key="APRG_CrewProdType_"+IntToString(token)+"_"+IntToString(number);
        previous=DataTableGetString(true,key);
        if (number<=0 || number>100000 || !APRG_CrewProdUnitType(nativeType) ||
            (previous!="" && previous!=nativeType)) { return true; }
        for (k=0; k<i; k+=1) {
            if (StringToInt(StringWord(msg,4+k*2))==number) { return true; }
        }
    }
    for (i=0; i<count; i+=1) {
        number=StringToInt(StringWord(msg,4+i*2));
        nativeType=StringWord(msg,5+i*2);
        key="APRG_CrewProdType_"+IntToString(token)+"_"+IntToString(number);
        if (DataTableGetString(true,key)=="") {
            listKey=APRG_CrewProdListKey(nativeType);
            k=DataTableGetInt(true,listKey+"_Count")+1;
            DataTableSetInt(true,listKey+"_Count",k);
            DataTableSetInt(true,listKey+"_"+IntToString(k),number);
            DataTableSetString(true,key,nativeType);
            if (!DataTableGetBool(true,"APRG_CrewUnlocked_"+IntToString(token)+"_"+nativeType)) {
                DataTableSetBool(true,"APRG_CrewUnlocked_"+IntToString(token)+"_"+nativeType,true);
                APRG_CrewUnlockNativeUnit(player,nativeType);
            }
            newlyAuthorized+=1;
        }
        BankValueSetFromInt(g_aprgCrewDeathBank,"Session"+IntToString(token),
            "BuildAuth"+IntToString(number),token);
    }
    BankSave(g_aprgCrewDeathBank);
    if (newlyAuthorized>0) {
        APRG_CrewProdDiagnostic("StockAccepted",newlyAuthorized);
        // Run the claim/retry immediately after a new bank authorization.
        // The old recovery path could miss the 1000s order until the next tick.
        APRG_CrewProdClamp(APRG_PlayerAllUnits(player),player);
    }
    // Only acknowledge newly accepted stocks in the chat. Retransmits
    // still refresh the bank ACK but cannot flood player messages.
    if (newlyAuthorized>0) {
        UIDisplayMessage(PlayerGroupSingle(player),c_messageAreaChat,
            StringToText("[Slay] Crew reserves synchronized ("+IntToString(newlyAuthorized)+" copies)."));
    }
    return true;
}

// Crew-only free production must zero the CUnit's native mineral/gas price.
// Dev81 removed these two assignments to recover repair costs, but SC2/AP
// orders can fall back to CUnit prices EVEN when CAbil train/build costs are 0.
// Record the original price exactly once so a SEPARATE Crew repair economy can
// charge for actual SCV repairs without charging for build/train orders.
void APRG_CrewProdZeroOne(int player,string nativeType) {
    string key;
    if (!CatalogEntryIsValid(c_gameCatalogUnit,nativeType)) { return; }
    key="APRG_CrewRepairPrice_"+IntToString(player)+"_"+nativeType;
    if (!DataTableGetBool(true,key+"_Saved")) {
        DataTableSetFixed(true,key+"_M",StringToFixed(
            CatalogFieldValueGet(c_gameCatalogUnit,nativeType,"CostResource[0]",player)));
        DataTableSetFixed(true,key+"_G",StringToFixed(
            CatalogFieldValueGet(c_gameCatalogUnit,nativeType,"CostResource[1]",player)));
        DataTableSetBool(true,key+"_Saved",true);
    }
    CatalogFieldValueSet(c_gameCatalogUnit,nativeType,"CostResource[0]",player,"0");
    CatalogFieldValueSet(c_gameCatalogUnit,nativeType,"CostResource[1]",player,"0");
    CatalogFieldValueSet(c_gameCatalogUnit,nativeType,"BuildTime",player,"1000");
}

