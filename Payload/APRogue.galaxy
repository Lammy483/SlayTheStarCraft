    g_aprgNextHordeLarvaTime = now + 33.0;
    g_aprgArmsRaceStacks = 0;
    g_aprgNextGorgonBlessingTime = now + 60.0;
    g_aprgNextGorgonMutationTime = now + 60.0;
    g_aprgNextTowerDefenseTime = now + 30.0;
    g_aprgTychusDeathTime = -1.0;
    g_aprgNextEnemyRapidEvolutionTime = now + 5.0;
    g_aprgNextAlliedTargetRotationTime = now + 180.0;
    g_aprgNextInflatableTime = now + 12.0;
    g_aprgRaynorHyperion = null;
    g_aprgRaynorHomePoint = null;
    g_aprgRaynorNextFlybyTime = -1.0;
    g_aprgRaynorFlybyDeadline = -1.0;
    g_aprgRaynorNextRepairDropTime = -1.0;
    g_aprgRaynorFlybyActive = false;
    g_aprgRaynorStarted = false;
    g_aprgRaynorDestroyed = false;
    g_aprgRaynorFlybyState = 0;
    g_aprgRaynorTargetPoint = null;
    g_aprgRaynorSafePoint = null;
    g_aprgRaynorEarliestNextFlybyTime = -1.0;
    g_aprgRaynorNextMoveRefreshTime = -1.0;
    g_aprgRaynorLastObservedLife = -1.0;
    g_aprgRaynorFlybyStartLife = -1.0;
    g_aprgRaynorRepairStallTicks = 0;
    g_aprgFirePowerStacks = 0;
    g_aprgDefenderBonusDamageBusy = false;

    APRG_CacheFixedPatrolPoints(APRG_GetPrimaryPlayer());

    g_aprgTickTrigger = TriggerCreate("APRG_Tick_Func");
    TriggerAddEventTimePeriodic(g_aprgTickTrigger, 1.0, c_timeGame);
    return true;
}

bool APRG_NewBoonDamage_Func(bool testConds, bool runActions) {
    unit victim;
    unit source;
    int player;
    int owner;
    string sourceType;
    string victimType;
    fixed damage;
    fixed blitzLife;
    fixed blitzMaximum;
    fixed blitzNow;
    fixed blitzAccumulatedDamage;
    fixed blitzBurstTime;
    string blitzKey;
    string blitzAccumKey;
    string blitzBurstKey;
    if (!runActions || !g_aprgStarted) { return true; }
    victim = EventUnit();
    source = EventUnitDamageSourceUnit();
    if (victim == null || source == null || victim == source) { return true; }
    player = APRG_GetPrimaryPlayer();
    owner = UnitGetOwner(victim);
    sourceType = UnitGetType(source);
    victimType = UnitGetType(victim);
    damage = EventUnitDamageAmount();

    if (
        APRG_HasExtension4(APRG_EXT4_BOON_REFLECTIVE_CARAPACE) && UnitGetOwner(victim) == player &&
        (StringContains(victimType, "Roach", c_stringAnywhere, c_stringNoCase) ||
        StringContains(victimType, "Ultralisk", c_stringAnywhere, c_stringNoCase) ||
        StringContains(victimType, "Torrasque", c_stringAnywhere, c_stringNoCase)) &&
        UnitGetOwner(source) >= 0 && libNtve_gf_PlayerIsEnemy(UnitGetOwner(source), player, libNtve_ge_PlayerRelation_Enemy) && damage > 0.0
    ) {
        APRG_DealDirectDamage(source, damage);
    }
    if (
        APRG_HasExtension4(APRG_EXT4_BOON_ZERGLING_INFESTATION) && UnitGetOwner(source) == player &&
        StringContains(sourceType, "Zergling", c_stringAnywhere, c_stringNoCase) && owner >= 0 &&
        libNtve_gf_PlayerIsEnemy(owner, player, libNtve_ge_PlayerRelation_Enemy)
    ) {
        DataTableSetFixed(true, "APRG_ZerglingInfestUntil_" + IntToString(UnitGetTag(victim)), GameGetMissionTime() + 10.0);
    }
    if (
        APRG_HasExtension4(APRG_EXT4_BOON_REAPER_BLITZ) && !g_aprgReaperBlitzBusy &&
        UnitGetOwner(source) == player && APRG_IsReaperBoonType(sourceType) && owner >= 0 &&
        libNtve_gf_PlayerIsEnemy(owner, player, libNtve_ge_PlayerRelation_Enemy) && damage > 0.0
    ) {
        blitzLife = UnitGetPropertyFixed(victim, c_unitPropLife, c_unitPropCurrent);
        blitzMaximum = UnitGetPropertyFixed(victim, c_unitPropLifeMax, c_unitPropCurrent);
        blitzNow = GameGetMissionTime();
        blitzKey = "APRG_ReaperBlitzUntil_" + IntToString(UnitGetTag(victim));
        blitzAccumKey = "APRG_ReaperBlitzDamage_" + IntToString(UnitGetTag(victim));
        blitzBurstKey = "APRG_ReaperBlitzBurst_" + IntToString(UnitGetTag(victim));
        if (DataTableGetFixed(true, blitzKey) <= blitzNow) {
            blitzBurstTime = DataTableGetFixed(true, blitzBurstKey);
            blitzAccumulatedDamage = DataTableGetFixed(true, blitzAccumKey);
            if (blitzBurstTime <= 0.0 || blitzNow - blitzBurstTime > 0.15) {
                blitzAccumulatedDamage = 0.0;
            }
            blitzAccumulatedDamage += damage;
            DataTableSetFixed(true, blitzBurstKey, blitzNow);
            DataTableSetFixed(true, blitzAccumKey, blitzAccumulatedDamage);
            if (blitzMaximum > 0.0 && blitzLife + blitzAccumulatedDamage >= blitzMaximum - 0.05) {
                DataTableSetFixed(true, blitzKey, blitzNow + 0.25);
                DataTableSetFixed(true, blitzAccumKey, 0.0);
                g_aprgReaperBlitzBusy = true;
                APRG_DealDirectDamage(victim, damage * 9.0);
                g_aprgReaperBlitzBusy = false;
            }
        }
    }
    if (!UnitIsAlive(victim)) { return true; }
    return true;
}

string APRG_HyperionBoonType() {
    if (CatalogEntryIsValid(c_gameCatalogUnit, "Hyperion")) { return "Hyperion"; }
    return "";
}

// Campaign HyperionYamatoSpecial has no native cost entry. APRogueData.xml
// initializes an empty, writable Cost field; install player-only costs before
// the unit is spawned/replaced so the command card and engine can enforce them.
void APRG_ConfigureHyperionYamato(int player) {
    string abilityType = "HyperionYamatoSpecial";
    if (!CatalogEntryIsValid(c_gameCatalogAbil, abilityType)) { return; }
    CatalogFieldValueSet(c_gameCatalogAbil, abilityType, "Cost.Vital[Energy]", player, "100");
    CatalogFieldValueSet(c_gameCatalogAbil, abilityType, "Cost.Cooldown.Link", player, "APRogueHyperionYamato");
    CatalogFieldValueSet(c_gameCatalogAbil, abilityType, "Cost.Cooldown.TimeUse", player, "15");
    CatalogFieldValueSet(c_gameCatalogAbil, abilityType, "Cost.Cooldown.TimeStart", player, "0");
    // Engines that expose the singular Cost as array element 0 also work.
    CatalogFieldValueSet(c_gameCatalogAbil, abilityType, "Cost[0].Vital[Energy]", player, "100");
    CatalogFieldValueSet(c_gameCatalogAbil, abilityType, "Cost[0].Cooldown.Link", player, "APRogueHyperionYamato");
    CatalogFieldValueSet(c_gameCatalogAbil, abilityType, "Cost[0].Cooldown.TimeUse", player, "15");
}

void APRG_NormalizeHyperionBoon(unit hyperion, int player) {
    int i;
    string behavior;
    if (hyperion == null) { return; }

    for (i = UnitBehaviorCountAll(hyperion); i >= 1; i -= 1) {
        behavior = UnitBehaviorGet(hyperion, i);
        if (
            StringContains(behavior, "DamageResponse", c_stringAnywhere, c_stringNoCase) ||
            StringContains(behavior, "DamageReduction", c_stringAnywhere, c_stringNoCase) ||
            StringContains(behavior, "DamageRedux", c_stringAnywhere, c_stringNoCase) ||
            StringContains(behavior, "DivineArmor", c_stringAnywhere, c_stringNoCase) ||
            StringContains(behavior, "Hardened", c_stringAnywhere, c_stringNoCase) ||
            StringContains(behavior, "Invulner", c_stringAnywhere, c_stringNoCase) ||
            StringContains(behavior, "Regener", c_stringAnywhere, c_stringNoCase) ||
            StringContains(behavior, "LifeRegen", c_stringAnywhere, c_stringNoCase)
        ) {
            UnitBehaviorRemove(hyperion, behavior, c_unitBehaviorCountAll);
        }
    }

    CatalogFieldValueSet(c_gameCatalogUnit, UnitGetType(hyperion), "LifeArmor", player, "3");
    UnitSetPropertyFixed(hyperion, c_unitPropLifeMax, 3000.0);
    UnitSetPropertyFixed(hyperion, c_unitPropLife, 3000.0);
    UnitSetPropertyFixed(hyperion, c_unitPropLifeRegen, 0.0);
    UnitSetPropertyFixed(hyperion, c_unitPropEnergyMax, 200.0);
    UnitSetPropertyFixed(hyperion, c_unitPropEnergy, 200.0);
    DataTableSetBool(true, "APRG_NoHeroRegen_" + IntToString(UnitGetTag(hyperion)), true);

    APRG_ConfigureHyperionYamato(player);
    // Native Hyperion's actual ability: HyperionYamatoSpecial. Some campaign
    // catalog variants expose Energy by its numeric vital index instead.
    CatalogFieldValueSet(c_gameCatalogAbil, "HyperionYamatoSpecial", "Cost[0].Vital[2]", player, "100");
}

string APRG_LeviathanBoonType() {
    if (CatalogEntryIsValid(c_gameCatalogUnit, "Leviathan")) { return "Leviathan"; }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "LeviathanHOTS")) { return "LeviathanHOTS"; }
    return "";
}

bool APRG_LeviathanBoonSpawnUnitType(string unitType) {
    if (unitType == "") { return false; }
    return (
        StringContains(unitType, "Mutalisk", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "BroodLord", c_stringAnywhere, c_stringNoCase)
    );
}

bool APRG_LeviathanBoonSpawnAbility(string abilityType, int player) {
    int infoCount;
    int infoIndex;
    int unitCount;
    int unitIndex;
    int buttonCount;
    int buttonIndex;
    string basePath;
    string producedType;
    string abilityName;
    string buttonFace;
    if (abilityType == "" || !CatalogEntryIsValid(c_gameCatalogAbil, abilityType)) { return false; }

    if (
        StringContains(abilityType, "Mutalisk", c_stringAnywhere, c_stringNoCase) ||
        StringContains(abilityType, "BroodLord", c_stringAnywhere, c_stringNoCase)
    ) { return true; }
    abilityName = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, "Name", player);
    if (
        StringContains(abilityName, "Mutalisk", c_stringAnywhere, c_stringNoCase) ||
        StringContains(abilityName, "BroodLord", c_stringAnywhere, c_stringNoCase)
    ) { return true; }
    buttonCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, "CmdButtonArray", player);
    for (buttonIndex = 0; buttonIndex < buttonCount; buttonIndex += 1) {
        buttonFace = CatalogFieldValueGet(
            c_gameCatalogAbil,
            abilityType,
            "CmdButtonArray[" + IntToString(buttonIndex) + "].DefaultButtonFace",
            player
        );
        if (
            StringContains(buttonFace, "Mutalisk", c_stringAnywhere, c_stringNoCase) ||
            StringContains(buttonFace, "BroodLord", c_stringAnywhere, c_stringNoCase)
        ) { return true; }
    }

    infoCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, "InfoArray", player);
    for (infoIndex = 0; infoIndex < infoCount; infoIndex += 1) {
        basePath = "InfoArray[" + IntToString(infoIndex) + "]";
        producedType = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, basePath + ".Unit", player);
        if (APRG_LeviathanBoonSpawnUnitType(producedType)) { return true; }
        unitCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, basePath + ".Unit", player);
        for (unitIndex = 0; unitIndex < unitCount; unitIndex += 1) {
            producedType = CatalogFieldValueGet(
                c_gameCatalogAbil,
                abilityType,
                basePath + ".Unit[" + IntToString(unitIndex) + "]",
                player
            );
            if (APRG_LeviathanBoonSpawnUnitType(producedType)) { return true; }
        }
    }
    return false;
}

// The native campaign Leviathan types are controllable but can lack the
// ArmySelect flag used by SC2's F2/all-army selection. Apply the override to
// the base catalog as well as the local player (same fix as Karass), so both
// the Corruptor-replacement boon and the bottled hero enter the normal army.
void APRG_EnableLeviathanArmySelection(int player) {
    int variant;
    string leviathanType;
    for (variant = 0; variant < 2; variant += 1) {
        if (variant == 0) { leviathanType = "Leviathan"; }
        else { leviathanType = "LeviathanHOTS"; }
        if (!CatalogEntryIsValid(c_gameCatalogUnit, leviathanType)) { continue; }
        CatalogFieldValueSet(c_gameCatalogUnit, leviathanType, "FlagArray[ArmySelect]", c_playerAny, "1");
        CatalogFieldValueSet(c_gameCatalogUnit, leviathanType, "FlagArray[ArmySelect]", player, "1");
    }
}

void APRG_NormalizeLeviathanBoon(unit leviathan, int player) {
    int abilityCount;
    int abilityIndex;
    int infoCount;
    int infoIndex;
    int costIndex;
    string abilityType;
    string basePath;
    if (leviathan == null) { return; }
    APRG_EnableLeviathanArmySelection(player);

    abilityCount = UnitAbilityCount(leviathan);
    for (abilityIndex = 1; abilityIndex <= abilityCount; abilityIndex += 1) {
        abilityType = UnitAbilityGet(leviathan, abilityIndex);
        if (!APRG_LeviathanBoonSpawnAbility(abilityType, player)) { continue; }

        CatalogFieldValueSet(c_gameCatalogAbil, abilityType, "Cost.Cooldown.TimeUse", player, "60");
        CatalogFieldValueSet(c_gameCatalogAbil, abilityType, "Cost.Cooldown.TimeStart", player, "60");
        for (costIndex = 0; costIndex < 4; costIndex += 1) {
            basePath = "Cost[" + IntToString(costIndex) + "]";
            CatalogFieldValueSet(c_gameCatalogAbil, abilityType, basePath + ".Cooldown.TimeUse", player, "60");
            CatalogFieldValueSet(c_gameCatalogAbil, abilityType, basePath + ".Cooldown.TimeStart", player, "60");
        }
        infoCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, "InfoArray", player);
        for (infoIndex = 0; infoIndex < infoCount; infoIndex += 1) {
            basePath = "InfoArray[" + IntToString(infoIndex) + "]";
            CatalogFieldValueSet(c_gameCatalogAbil, abilityType, basePath + ".Cooldown.TimeUse", player, "60");
            CatalogFieldValueSet(c_gameCatalogAbil, abilityType, basePath + ".Cooldown.TimeStart", player, "60");
            CatalogFieldValueSet(c_gameCatalogAbil, abilityType, basePath + ".Cost.Cooldown.TimeUse", player, "60");
            CatalogFieldValueSet(c_gameCatalogAbil, abilityType, basePath + ".Cost.Cooldown.TimeStart", player, "60");
        }
    }
}

bool APRG_NewBoonTrain_Func(bool testConds, bool runActions) {
    unit trained;
    unit replacement;
    int player;
    string unitType;
    string heroType;
    point p;
    fixed facing;
    if (!runActions || !g_aprgStarted) { return true; }
    player = APRG_GetPrimaryPlayer();
    if (EventPlayer() != player) { return true; }
    trained = EventUnitProgressUnit();
    if (trained == null || !UnitIsAlive(trained)) { return true; }
    unitType = UnitGetType(trained);
    p = UnitGetPosition(trained);
    facing = UnitGetFacing(trained);

    APRG_TryGoliathsOnlineProducedUnit(trained, player);
    if (!g_aprgHyperionUsed && APRG_HasExtension4(APRG_EXT4_BOON_HYPERION) && StringContains(unitType, "Battlecruiser", c_stringAnywhere, c_stringNoCase)) {
        heroType = APRG_HyperionBoonType();
        if (heroType != "") {
            APRG_ConfigureHyperionYamato(player);
            libNtve_gf_ReplaceUnit(trained, heroType, libNtve_ge_ReplaceUnitOptions_OldUnitsRelative);
            replacement = libNtve_gf_LastReplacedUnit();
            if (replacement != null) {
                APRG_NormalizeHyperionBoon(replacement, player);
                g_aprgHyperionUsed = true;
            }
        }
    }
    else if (!g_aprgLeviathanUsed && APRG_HasExtension4(APRG_EXT4_BOON_LEVIATHAN) && StringContains(unitType, "Corruptor", c_stringAnywhere, c_stringNoCase)) {
        heroType = APRG_LeviathanBoonType();
        if (heroType != "") {
            libNtve_gf_ReplaceUnit(trained, heroType, libNtve_ge_ReplaceUnitOptions_OldUnitsRelative);
            replacement = libNtve_gf_LastReplacedUnit();
            if (replacement != null) {
                APRG_NormalizeLeviathanBoon(replacement, player);
                g_aprgLeviathanUsed = true;
            }
        }
    }
    return true;
}

void APRG_TickEnergizedQueens(int player, fixed now) {
    unitgroup units;
    int i;
    unit u;
    string unitType;
    string key;
    fixed lastTime;
    fixed elapsed;
    fixed baseline;
    fixed energy;
    fixed maximum;
    if (!APRG_HasExtension4(APRG_EXT4_BOON_ENERGIZED_QUEENS)) { return; }
    units = APRG_PlayerMobileUnits(player);
    for (i = UnitGroupCount(units, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null || !UnitIsAlive(u)) { continue; }
        unitType = UnitGetType(u);
        if (!StringContains(unitType, "SwarmQueen", c_stringAnywhere, c_stringNoCase) && !StringContains(unitType, "BroodQueen", c_stringAnywhere, c_stringNoCase)) { continue; }
        key = "APRG_EnergizedQueenLast_" + IntToString(UnitGetTag(u));
        lastTime = DataTableGetFixed(true, key);
        if (lastTime <= 0.0) { DataTableSetFixed(true, key, now); continue; }
        elapsed = now - lastTime;
        if (elapsed <= 0.0 || elapsed > 5.0) { elapsed = 1.0; }
        baseline = UnitGetPropertyFixed(u, c_unitPropEnergyRegen, c_unitPropCurrent);
        if (baseline <= 0.0) { baseline = 0.5625; }
        energy = UnitGetPropertyFixed(u, c_unitPropEnergy, c_unitPropCurrent);
        maximum = UnitGetPropertyFixed(u, c_unitPropEnergyMax, c_unitPropCurrent);
        if (maximum > 0.0 && energy < maximum) {
            UnitSetPropertyFixed(u, c_unitPropEnergy, MinF(maximum, energy + baseline * 9.0 * elapsed));
        }
        DataTableSetFixed(true, key, now);
    }
}

string APRG_GuidedShellsRemoveFilterWord(string filters, string word) {
    string result;
    if (filters == "" || word == "") { return filters; }
    result = filters;
    result = StringReplaceWord(result, word + ",", "", c_stringReplaceAll, c_stringNoCase);
    result = StringReplaceWord(result, "," + word, "", c_stringReplaceAll, c_stringNoCase);
    result = StringReplaceWord(result, ";" + word + ",", ";", c_stringReplaceAll, c_stringNoCase);
    result = StringReplaceWord(result, ";" + word, ";", c_stringReplaceAll, c_stringNoCase);
    result = StringReplaceWord(result, word + ";", ";", c_stringReplaceAll, c_stringNoCase);
    result = StringReplaceWord(result, word, "", c_stringReplaceAll, c_stringNoCase);
    return result;
}

void APRG_ApplyGuidedShellsWeapon(int player, string weaponType) {
    string key;
    string field;
    string filters;
    int fieldIndex;
    if (weaponType == "" || !CatalogEntryIsValid(c_gameCatalogWeapon, weaponType)) { return; }
    key = "APRG_GuidedShellsWeapon_" + IntToString(player) + "_" + weaponType;
    if (DataTableGetBool(true, key)) { return; }
    for (fieldIndex = 0; fieldIndex < 3; fieldIndex += 1) {
        field = "TargetFilters";
        if (fieldIndex == 1) { field = "AcquireFilters"; }
        else if (fieldIndex == 2) { field = "ChaseFilters"; }
        filters = CatalogFieldValueGet(c_gameCatalogWeapon, weaponType, field, player);
        if (filters == "") { continue; }
        filters = APRG_GuidedShellsRemoveFilterWord(filters, "Ground");
        filters = APRG_GuidedShellsRemoveFilterWord(filters, "Air");
        CatalogFieldValueSet(c_gameCatalogWeapon, weaponType, field, player, filters);
    }
    DataTableSetBool(true, key, true);
}



void APRG_TickOccasionalReplacementRaids(int player, fixed now) {
    int i;
    unit u;
    unit target;
    for (i = 0; i < g_aprgOccasionalRaidCount; i += 1) {
        u = g_aprgOccasionalRaidUnits[i];
        if (u == null || !UnitIsAlive(u) || g_aprgOccasionalRaidTimes[i] < 0.0 || now < g_aprgOccasionalRaidTimes[i]) { continue; }
        target = APRG_RandomPlayerStructure(player);
        if (target != null) { APRG_OrderAttackMove(u, UnitGetPosition(target)); }
        // Once the delayed raid begins, keep it in the shared hostile-raider pool so
        // a destroyed target does not leave this replacement boss permanently idle.
        UnitGroupAdd(g_aprgHostileRaiders, u);
        g_aprgOccasionalRaidTimes[i] = -1.0;
    }
}

string APRG_ResourcePickupVisual(bool gas) {
    if (gas) {
        if (CatalogEntryIsValid(c_gameCatalogUnit, "PalletGas")) { return "PalletGas"; }
        if (CatalogEntryIsValid(c_gameCatalogUnit, "NaturalGas")) { return "NaturalGas"; }
    }
    else {
        if (CatalogEntryIsValid(c_gameCatalogUnit, "PalletMinerals")) { return "PalletMinerals"; }
        if (CatalogEntryIsValid(c_gameCatalogUnit, "NaturalMinerals")) { return "NaturalMinerals"; }
        if (CatalogEntryIsValid(c_gameCatalogUnit, "NaturalMineralsRed")) { return "NaturalMineralsRed"; }
    }
    return "";
}

void APRG_SpawnResourcePickups(int player) {
    int i;
    bool gas;
    string visualType;
    point p;
    unitgroup created;
    unit u;
    if (g_aprgResourcePickupsSpawned) { return; }
    g_aprgResourcePickupsSpawned = true;
    g_aprgResourcePickupCount = 0;
    for (i = 0; i < 50; i += 1) {
        gas = RandomInt(0, 1) == 1;
        visualType = APRG_ResourcePickupVisual(gas);
        if (visualType == "") { return; }
        p = APRG_FindRandomGroundPoint();
        if (p == null) { continue; }
        created = UnitCreate(1, visualType, 0, 0, p, libNtve_gf_RandomAngle());
        u = UnitGroupUnitFromEnd(created, 1);
        if (u == null) { continue; }
    }
}

void APRG_TickResourcePickups(int player) {
    if (!APRG_PlayerMacroBaseReady(player)) { return; }
    if (!g_aprgResourcePickupsSpawned) { APRG_SpawnResourcePickups(player); }
}

void APRG_OrderMarauderKillTeamGroup(unitgroup team, int player) {
    int i;
    unit u;
    point destination;
    if (team == null || UnitGroupCount(team, c_unitCountAlive) <= 0) { return; }
    destination = APRG_RandomFixedPatrolPoint(player, true);
    if (destination == null) { return; }
    for (i = UnitGroupCount(team, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(team, i);
        if (u == null || !UnitIsAlive(u)) { continue; }
        APRG_OrderAttackMove(u, destination);
    }
}

void APRG_ApplyKillTeamMedicVisual(unit medic) {
    string modelType = "";
    if (medic == null) { return; }
    if (CatalogEntryIsValid(c_gameCatalogModel, "MedicKillTeam")) { modelType = "MedicKillTeam"; }
    else if (CatalogEntryIsValid(c_gameCatalogModel, "medickillteam")) { modelType = "medickillteam"; }
    if (modelType != "") {
        libNtve_gf_SendActorMessageToUnit(medic, libNtve_gf_ModelSwap(modelType, 0));
    }
}

unitgroup APRG_SpawnOneMarauderKillTeam(int player) {
    unit anchor;
    point p;
    int owner;
    unitgroup marauders;
    unitgroup medics;
    int i;
    unit u;
    string marauderType = "Marauder";
    bool actualKillTeam = false;
    unitgroup team = UnitGroupEmpty();
    anchor = APRG_RandomPathableHostileBaseAnchor(player);
    if (anchor == null) { return team; }
    p = APRG_FindGroundPointNear(UnitGetPosition(anchor), 4.0, 12.0);
    if (p == null) { p = UnitGetPosition(anchor); }
    owner = UnitGetOwner(anchor);
    if (CatalogEntryIsValid(c_gameCatalogUnit, "DominionKillTeam")) {
        marauderType = "DominionKillTeam";
        actualKillTeam = true;
    }
    marauders = UnitCreate(15, marauderType, c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
    medics = UnitCreate(3, "Medic", c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
    for (i = UnitGroupCount(marauders, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(marauders, i);
        if (u != null && CatalogEntryIsValid(c_gameCatalogBehavior, "APRogueKillTeamBonus")) {
            UnitBehaviorAdd(u, "APRogueKillTeamBonus", u, 1);
        }
        if (u != null && !actualKillTeam && CatalogEntryIsValid(c_gameCatalogBehavior, "APRogueMarauderKillTeamDamage")) {
            UnitBehaviorAdd(u, "APRogueMarauderKillTeamDamage", u, 1);
        }
    }
    for (i = UnitGroupCount(medics, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(medics, i);
        if (u != null && CatalogEntryIsValid(c_gameCatalogBehavior, "APRogueKillTeamArmor")) {
            UnitBehaviorAdd(u, "APRogueKillTeamArmor", u, 1);
        }
        APRG_ApplyKillTeamMedicVisual(u);
    }
    UnitGroupAddUnitGroup(team, marauders);
    UnitGroupAddUnitGroup(team, medics);
    UnitGroupAddUnitGroup(g_aprgMarauderKillTeamUnits, marauders);
    UnitGroupAddUnitGroup(g_aprgMarauderKillTeamUnits, medics);
    APRG_OrderMarauderKillTeamGroup(team, player);
    MinimapPing(PlayerGroupSingle(player), p, 8.0, Color(100.0, 0.0, 0.0));
    return team;
}

void APRG_TickMarauderKillTeams(int player, fixed now) {
    unit u;
    if (!APRG_PlayerMacroBaseReady(player) || g_aprgMacroReadyTime < 0.0 || now < g_aprgMacroReadyTime + 300.0) { return; }
    if (!g_aprgMarauderKillTeamsSpawned) {
        g_aprgMarauderKillTeamOne = APRG_SpawnOneMarauderKillTeam(player);
        g_aprgMarauderKillTeamTwo = APRG_SpawnOneMarauderKillTeam(player);
        g_aprgMarauderKillTeamsSpawned = true;
        g_aprgNextMarauderKillTeamRetargetTime = now + 30.0;
        return;
    }
    if (now < g_aprgNextMarauderKillTeamRetargetTime) { return; }
    g_aprgNextMarauderKillTeamRetargetTime = now + 30.0;
    APRG_OrderMarauderKillTeamGroup(g_aprgMarauderKillTeamOne, player);
    APRG_OrderMarauderKillTeamGroup(g_aprgMarauderKillTeamTwo, player);
    u = UnitGroupUnitFromEnd(g_aprgMarauderKillTeamOne, 1);
    if (u != null && UnitIsAlive(u)) { MinimapPing(PlayerGroupSingle(player), UnitGetPosition(u), 2.0, Color(100.0, 0.0, 0.0)); }
    u = UnitGroupUnitFromEnd(g_aprgMarauderKillTeamTwo, 1);
    if (u != null && UnitIsAlive(u)) { MinimapPing(PlayerGroupSingle(player), UnitGetPosition(u), 2.0, Color(100.0, 0.0, 0.0)); }
}
void APRG_ApplyNewBoonStats(int player) {
    unitgroup units;
    unit u;
    int i;
    int wi;
    int wc;
    string unitType;
    string weaponType;
    string key;
    fixed maximum;
    fixed current;
    fixed speed;
    fixed sight;
    fixed regen;
    APRG_ApplyTrueCarriersToFriendlyOwners(player);
    units = APRG_PlayerMobileUnits(player);
    for (i = UnitGroupCount(units, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null) { continue; }
        unitType = UnitGetType(u);

        if (
            APRG_HasExtension4(APRG_EXT4_BOON_REGENERATIVE_ABERRATIONS) &&
            (StringContains(unitType, "Aberration", c_stringAnywhere, c_stringNoCase) ||
             StringContains(unitType, "Abberation", c_stringAnywhere, c_stringNoCase))
        ) {
            key = "APRG_RegenerativeAberration_" + IntToString(UnitGetTag(u));
            if (!DataTableGetBool(true, key)) {
                UnitSetPropertyFixed(u, c_unitPropLifeRegen, UnitGetPropertyFixed(u, c_unitPropLifeRegen, c_unitPropCurrent) + 10.0);
                DataTableSetBool(true, key, true);
            }
        }
        if (APRG_HasExtension4(APRG_EXT4_BOON_PERMANENT_STIMPACK) && APRG_IsInfantryBoonType(unitType, player)) {
            key = "APRG_PermanentStimType_" + IntToString(player) + "_" + unitType;
            if (!DataTableGetBool(true, key)) {
                speed = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "Speed", player));
                if (speed > 0.0) { CatalogFieldValueSet(c_gameCatalogUnit, unitType, "Speed", player, FixedToString(speed * 2.0, c_fixedPrecisionAny)); }
                DataTableSetBool(true, key, true);
            }
            key = "APRG_PermanentStimUnit_" + IntToString(UnitGetTag(u));
            if (!DataTableGetBool(true, key)) {
                regen = UnitGetPropertyFixed(u, c_unitPropEnergyRegen, c_unitPropCurrent);
                if (regen > 0.0) { UnitSetPropertyFixed(u, c_unitPropEnergyRegen, regen * 2.0); }
                DataTableSetBool(true, key, true);
                UnitResetSpeed(u);
            }
            wc = UnitWeaponCount(u);
            for (wi = 1; wi <= wc; wi += 1) {
                weaponType = UnitWeaponGet(u, wi);
                if (weaponType == "") { continue; }
                key = "APRG_PermanentStimWeapon_" + IntToString(player) + "_" + weaponType;
                if (!DataTableGetBool(true, key)) {
                    CatalogFieldValueModify(c_gameCatalogWeapon, weaponType, "Period", player, "0.5", c_upgradeOperationMultiply);
                    DataTableSetBool(true, key, true);
                }
            }
        }
        if (APRG_HasExtension4(APRG_EXT4_BOON_SPINE_RIFLING) && (StringContains(unitType, "Hydralisk", c_stringAnywhere, c_stringNoCase) || StringContains(unitType, "HunterKiller", c_stringAnywhere, c_stringNoCase))) {
            wc = UnitWeaponCount(u);
            for (wi = 1; wi <= wc; wi += 1) {
                weaponType = UnitWeaponGet(u, wi);
                if (weaponType == "") { continue; }
                key = "APRG_SpineRifling_" + IntToString(player) + "_" + weaponType;
                if (!DataTableGetBool(true, key)) {
                    CatalogFieldValueModify(c_gameCatalogWeapon, weaponType, "Range", player, "2.0", c_upgradeOperationMultiply);
                    DataTableSetBool(true, key, true);
                }
            }
        }
        if (APRG_HasExtension4(APRG_EXT4_BOON_GUIDED_SHELLS) && (
            StringContains(unitType, "SiegeTank", c_stringAnywhere, c_stringNoCase) ||
            StringContains(unitType, "SiegeBreaker", c_stringAnywhere, c_stringNoCase)
        )) {
            wc = UnitWeaponCount(u);
            for (wi = 1; wi <= wc; wi += 1) {
                weaponType = UnitWeaponGet(u, wi);
                APRG_ApplyGuidedShellsWeapon(player, weaponType);
            }
        }
        if (APRG_HasExtension4(APRG_EXT4_BOON_TRUE_SCOUTS) && StringContains(unitType, "Scout", c_stringAnywhere, c_stringNoCase)) {
            key = "APRG_TrueScoutType_" + IntToString(player) + "_" + unitType;
            if (!DataTableGetBool(true, key)) {
                sight = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "Sight", player));
                speed = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "Speed", player));
                CatalogFieldValueSet(c_gameCatalogUnit, unitType, "Sight", player, FixedToString(sight + 10.0, c_fixedPrecisionAny));
                CatalogFieldValueSet(c_gameCatalogUnit, unitType, "Speed", player, FixedToString(speed + 3.0, c_fixedPrecisionAny));
                DataTableSetBool(true, key, true);
            }
            key = "APRG_TrueScoutUnit_" + IntToString(UnitGetTag(u));
            if (!DataTableGetBool(true, key)) {
                if (CatalogEntryIsValid(c_gameCatalogBehavior, "APRogueTrueScoutDetector")) {
                    sight = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "Sight", player));
                    CatalogFieldValueSet(
                        c_gameCatalogBehavior,
                        "APRogueTrueScoutDetector",
                        "Modification.Detect",
                        player,
                        FixedToString(sight, c_fixedPrecisionAny)
                    );
                    UnitBehaviorAdd(u, "APRogueTrueScoutDetector", u, 1);
                }
                UnitResetSpeed(u);
                DataTableSetBool(true, key, true);
            }
        }
        if (APRG_HasExtension4(APRG_EXT4_BOON_IMMORTAL_IMMORTALS) && StringContains(unitType, "Immortal", c_stringAnywhere, c_stringNoCase)) {
            if (!UnitGroupHasUnit(g_aprgImmortalImmortalsProcessed, u)) {
                maximum = UnitGetPropertyFixed(u, c_unitPropLifeMax, c_unitPropCurrent);
                current = UnitGetPropertyFixed(u, c_unitPropLife, c_unitPropCurrent);
                if (maximum > 0.0) {
                    UnitSetPropertyFixed(u, c_unitPropLifeMax, maximum * 10.0);
                    UnitSetPropertyFixed(u, c_unitPropLife, current * 10.0);
                }
                maximum = UnitGetPropertyFixed(u, c_unitPropShieldsMax, c_unitPropCurrent);
                current = UnitGetPropertyFixed(u, c_unitPropShields, c_unitPropCurrent);
                if (maximum > 0.0) {
                    UnitSetPropertyFixed(u, c_unitPropShieldsMax, maximum * 10.0);
                    UnitSetPropertyFixed(u, c_unitPropShields, current * 10.0);
                }
                UnitGroupAdd(g_aprgImmortalImmortalsProcessed, u);
            }
        }
    }
}

void APRG_TickPermanentStimpack(int player) {
    unitgroup units;
    unit u;
    int i;
    string unitType;
    fixed life;
    if (!APRG_HasExtension4(APRG_EXT4_BOON_PERMANENT_STIMPACK)) { return; }
    units = APRG_PlayerMobileUnits(player);
    for (i = UnitGroupCount(units, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null) { continue; }
        unitType = UnitGetType(u);
        if (!APRG_IsInfantryBoonType(unitType, player)) { continue; }
        life = UnitGetPropertyFixed(u, c_unitPropLife, c_unitPropCurrent);
        if (life <= 1.0) { UnitKill(u); }
        else { UnitSetPropertyFixed(u, c_unitPropLife, life - 1.0); }
    }
}

void APRG_TickInvasionFleet(int player, fixed now) {
    point p;
    if (!APRG_HasExtension4(APRG_EXT4_BOON_INVASION_FLEET)) { return; }
    if (now < 300.0 || now >= 420.0 || now < g_aprgNextInvasionFleetDropTime) { return; }
    p = APRG_FindInvasionFleetDropPoint(player);
    if (p != null) {
        if (!APRG_QueueRealDropPod(APRG_DROP_KIND_INVASION_FLEET, player, p, null)) {
            APRG_ResolvePlayerZergDrop(player, p, true);
        }
    }
    g_aprgNextInvasionFleetDropTime = now + 1.0;
}

void APRG_TickBaseLeviathanBurst(int player, fixed now);
void APRG_TickPotionSpawnQueues(int player, fixed now);

bool APRG_FastBoonTick_Func(bool testConds, bool runActions) {
    int player;
    fixed now;
    if (!runActions || !g_aprgStarted) { return true; }
    player = APRG_GetPrimaryPlayer();
    now = GameGetMissionTime();
    if (!g_aprgEffectsSummaryDisplayed && now >= g_aprgActivationTime + 1.0) {
        APRG_DisplayActiveEffects(player);
        g_aprgEffectsSummaryDisplayed = true;
    }

    if ((g_aprgMissionFlags & APRG_MISSION_FLAG_LEVIATHAN_OUTSIDE_BASE) != 0) { APRG_TickBaseLeviathanBurst(player, now); }
    if (APRG_HasExtension2(APRG_EXT2_BOON_AIUR_RECRUITMENT)) { APRG_TickForAiurPending(player, now); }
    if (APRG_HasExtension4(APRG_EXT4_BOON_HIT_AND_RUN)) { APRG_TickHitAndRun(player); }
    if (
        APRG_HasExtension2(APRG_EXT2_BOON_AIUR_RECRUITMENT) ||
        APRG_HasExtension4(APRG_EXT4_BOON_PURIFIER_ALLIANCE)
    ) { APRG_ProcessAllyWarpQueue(player, now); }
    if (APRG_HasExtension3(APRG_EXT3_MUT_PURIFIER) || APRG_HasExtension2(APRG_EXT2_MUT_NEXUS_SHIELD)) { APRG_ProcessPurifierHostileWarpQueue(player, now); }
    APRG_TickInvasionFleet(player, now);
    APRG_TickPotionSpawnQueues(player, now);
    if (g_aprgZombieSpawnCount > 0) { APRG_ProcessZombieSpawnQueue(player); }

    if (g_aprgFastPhase == 0) { APRG_TickContractStructures(player); }
    else if (g_aprgFastPhase == 1) { APRG_TickMercenaryUpgrades(player); }
    else if (g_aprgFastPhase == 2) { APRG_TickShopKerrigan(player, now); }
    else if (g_aprgFastPhase == 3) { APRG_TickFriendlyAutonomousAbilities(player, now); }
    else if (g_aprgFastPhase == 4) {
        if (now >= g_aprgNextVoidEntityReconcileTime) {
            APRG_ReconcileMutationEnemyVoidEntity();
            g_aprgNextVoidEntityReconcileTime = now + 2.0;
        }
        APRG_TickEnemyCombatAbilities(player, now);
    }
    else if (g_aprgFastPhase == 5) { APRG_TickQueenTransfusions(player, now); APRG_TickEnergizedQueens(player, now); }
    else if (g_aprgFastPhase == 6 && APRG_HasExtension(APRG_EXT_BLESS_BLINK)) { APRG_ApplyBlinkBlessing(player); }
    else if (g_aprgFastPhase == 7 && APRG_PlayerMacroBaseReady(player) && APRG_HasExtension2(APRG_EXT2_MUT_GARGANTUAN_ENEMIES)) { APRG_ApplyGargantuanEnemies(player); }
    else if (g_aprgFastPhase == 8 && g_aprgMaskF != 0 && now >= g_aprgNextNewBoonStatsTime) {
        APRG_ApplyNewBoonStats(player);
        g_aprgNextNewBoonStatsTime = now + 2.0;
    }
    else if (g_aprgFastPhase == 9) { APRG_TickPermanentStimpack(player); }
    g_aprgFastPhase = (g_aprgFastPhase + 1) % 10;
    return true;
}

void APRG_ActivateEffects(int player) {
    if (g_aprgEffectsActivated) {
        return;
    }
    g_aprgEffectsActivated = true;

    APRG_EnsurePlayerInterceptorCost(player);
    APRG_EnableLeviathanArmySelection(player);

    // Karass is a campaign hero whose catalog entry does not consistently carry
    // the ArmySelect flag. Campaign F2 logic reads the base catalog through
    // c_playerAny, so set both that value and the player-specific override.
    if (CatalogEntryIsValid(c_gameCatalogUnit, "Karass")) {
        CatalogFieldValueSet(c_gameCatalogUnit, "Karass", "FlagArray[ArmySelect]", c_playerAny, "1");
        CatalogFieldValueSet(c_gameCatalogUnit, "Karass", "FlagArray[ArmySelect]", player, "1");
    }

    g_aprgFastPhase = 0;
    g_aprgNextVoidEntityReconcileTime = 0.0;
    g_aprgNextBoonCombatStatsTime = 0.0;
    g_aprgNextNewBoonStatsTime = 0.0;
    g_aprgFastBoonTrigger = TriggerCreate("APRG_FastBoonTick_Func");
    TriggerAddEventTimePeriodic(g_aprgFastBoonTrigger, 0.1, c_timeGame);

    if (
        APRG_HasExtension2(APRG_EXT2_BOON_FIRE_POWER) ||
        APRG_HasExtension2(APRG_EXT2_BOON_BROODLING_EVOLUTION) ||
        APRG_HasExtension3(APRG_EXT3_BOON_STRETCHY_SPINES) ||
        APRG_HasExtension4(APRG_EXT4_BOON_KILL_STREAK)
    ) {
        g_aprgKillTrackerTrigger = TriggerCreate("APRG_KillTrackerDamage_Func");
        TriggerAddEventUnitDamaged(g_aprgKillTrackerTrigger, null, c_unitDamageTypeAny, c_unitDamageEither, null);
    }
    if (
        APRG_HasExtension4(APRG_EXT4_BOON_REFLECTIVE_CARAPACE) ||
        APRG_HasExtension4(APRG_EXT4_BOON_ZERGLING_INFESTATION) ||
        APRG_HasExtension4(APRG_EXT4_BOON_REAPER_BLITZ)
    ) {
        g_aprgNewBoonDamageTrigger = TriggerCreate("APRG_NewBoonDamage_Func");
        TriggerAddEventUnitDamaged(g_aprgNewBoonDamageTrigger, null, c_unitDamageTypeAny, c_unitDamageEither, null);
    }
    if (
        APRG_HasExtension4(APRG_EXT4_BOON_GOLIATHS_ONLINE) ||
        APRG_HasExtension4(APRG_EXT4_BOON_HYPERION) ||
        APRG_HasExtension4(APRG_EXT4_BOON_LEVIATHAN)
    ) {
        g_aprgNewBoonTrainTrigger = TriggerCreate("APRG_NewBoonTrain_Func");
        TriggerAddEventUnitTrainProgress(g_aprgNewBoonTrainTrigger, null, c_unitProgressStageComplete);
    }

    if (
        APRG_HasMutation(APRG_MUT_ZOMBIES) ||
        APRG_HasBlessing(APRG_BLESS_ZOMBIES) ||
        APRG_HasBlessing(APRG_BLESS_EXPLOSIVE_ARMOR) ||
        APRG_HasExtension(APRG_EXT_MUT_NO_DEATHS_ALLOWED) ||
        APRG_HasExtension(APRG_EXT_MUT_VICTORY_TEMPORARY) ||
        APRG_HasExtension(APRG_EXT_MUT_NUCLEAR_WORKERS) ||
        APRG_HasExtension(APRG_EXT_BLESS_BOUNTY_KILLS) ||
        APRG_HasExtension(APRG_EXT_BLESS_ANOTHER_GORGON) ||
        APRG_HasExtension(APRG_EXT_MUT_ANOTHER_GORGON) ||
        APRG_HasExtension2(APRG_EXT2_BLESS_GLORIOUS_MARTYRS) ||
        APRG_HasExtension2(APRG_EXT2_BOON_CHAIN_REACTION) ||
        APRG_HasExtension2(APRG_EXT2_BOON_AIUR_RECRUITMENT) ||
        APRG_HasExtension2(APRG_EXT2_BOON_FIRE_POWER) ||
        APRG_HasExtension2(APRG_EXT2_BOON_ROACHLING_MINES) ||
        APRG_HasExtension2(APRG_EXT2_BOON_BROODLING_EVOLUTION) ||
        APRG_HasExtension3(APRG_EXT3_BOON_MADDENING_SHADES) ||
        APRG_HasExtension3(APRG_EXT3_MUT_NUCLEAR_STRUCTURES) ||
        APRG_HasExtension3(APRG_EXT3_MUT_ZOMBIE_APOCALYPSE) ||
        APRG_HasExtension3(APRG_EXT3_MUT_COMBAT_PAY) ||
        APRG_HasExtension3(APRG_EXT3_BOON_STRETCHY_SPINES) ||
        APRG_HasExtension4(APRG_EXT4_BOON_INFANTRY_REINFORCEMENTS) ||
        APRG_HasExtension4(APRG_EXT4_BOON_ACIDIC_LANDING_MARKERS) ||
        APRG_HasExtension4(APRG_EXT4_BOON_RECYCLED_ARMOR) ||
        APRG_HasExtension4(APRG_EXT4_BOON_DEAD_MAN_SWITCH) ||
        APRG_HasExtension4(APRG_EXT4_BOON_CELL_DIVISION) ||
        APRG_HasExtension4(APRG_EXT4_BOON_ZERGLING_INFESTATION) ||
        APRG_HasExtension4(APRG_EXT4_BOON_KILL_STREAK)
    ) {
        g_aprgDeathTrigger = TriggerCreate("APRG_Death_Func");
        TriggerAddEventUnitDied(g_aprgDeathTrigger, null);
        g_aprgTimedLifeCreatedTrigger = TriggerCreate("APRG_TimedLifeCreated_Func");
        TriggerAddEventUnitCreated(g_aprgTimedLifeCreatedTrigger, null, null, null);
    }
    if (APRG_HasBlessing(APRG_BLESS_INSTANT_WORKERS)) {
        g_aprgInstantWorkersTrigger = TriggerCreate("APRG_InstantWorkers_Func");
        TriggerAddEventUnitTrainProgress(g_aprgInstantWorkersTrigger, null, c_unitProgressStageStart);
    }
    if (APRG_HasExtension(APRG_EXT_BLESS_HORDE_MODE)) {
        g_aprgHordeTrainTrigger = TriggerCreate("APRG_HordeTrain_Func");
        TriggerAddEventUnitTrainProgress(g_aprgHordeTrainTrigger, null, c_unitProgressStageComplete);
        g_aprgHordeCreatedTrigger = TriggerCreate("APRG_HordeCreated_Func");
        TriggerAddEventUnitCreated(g_aprgHordeCreatedTrigger, null, null, null);
    }
    if (APRG_HasMutation(APRG_MUT_FORCED_VARIETY)) {
        g_aprgForcedVarietyTrigger = TriggerCreate("APRG_ForcedVariety_Func");
        TriggerAddEventUnitTrainProgress(g_aprgForcedVarietyTrigger, null, c_unitProgressStageComplete);
    }
    if (
        APRG_HasExtension(APRG_EXT_BLESS_OCCASIONAL_THOR) ||
        APRG_HasExtension(APRG_EXT_BLESS_OCCASIONAL_ULTRALISK) ||
        APRG_HasExtension(APRG_EXT_BLESS_OCCASIONAL_COLOSSUS) ||
        APRG_HasExtension(APRG_EXT_BLESS_UNEXPECTED_EVOLUTION)
    ) {
        g_aprgOccasionalBlessingTrigger = TriggerCreate("APRG_OccasionalBlessing_Func");
        TriggerAddEventUnitTrainProgress(g_aprgOccasionalBlessingTrigger, null, c_unitProgressStageComplete);
    }
    if (APRG_HasExtension2(APRG_EXT2_BLESS_REFLECTIVE_ARMOR)) {
        g_aprgReflectiveArmorTrigger = TriggerCreate("APRG_ReflectiveArmor_Func");
        TriggerAddEventUnitDamaged(g_aprgReflectiveArmorTrigger, null, c_unitDamageTypeAny, c_unitDamageEither, null);
    }
    if (APRG_HasExtension2(APRG_EXT2_MUT_TORRASQUE)) {
        g_aprgTorrasqueDamageTrigger = TriggerCreate("APRG_TorrasqueDamage_Func");
        TriggerAddEventUnitDamaged(g_aprgTorrasqueDamageTrigger, null, c_unitDamageTypeAny, c_unitDamageEither, null);
    }
    if (APRG_MercenaryUpgradeStacks(0) > 0) {
        g_aprgMercenaryDamageTrigger = TriggerCreate("APRG_MercenaryDamage_Func");
        TriggerAddEventUnitDamaged(g_aprgMercenaryDamageTrigger, null, c_unitDamageTypeAny, c_unitDamageEither, null);
    }
    if (APRG_HasExtension2(APRG_EXT2_BOON_DEFENDER) || APRG_HasExtension3(APRG_EXT3_BOON_MISSILE_DEFENSE)) {
        g_aprgDefenderDamageTrigger = TriggerCreate("APRG_DefenderDamage_Func");
        TriggerAddEventUnitDamaged(g_aprgDefenderDamageTrigger, null, c_unitDamageTypeAny, c_unitDamageEither, null);
    }
    if (
        APRG_HasExtension2(APRG_EXT2_BOON_CLONING_TECHNOLOGY) ||
        APRG_HasExtension2(APRG_EXT2_BOON_SHIELDS_FOR_ALL) ||
        APRG_HasExtension3(APRG_EXT3_BOON_GARGANTUAN_UNITS) ||
        APRG_HasExtension4(APRG_EXT4_BOON_GOLIATHS_ONLINE) ||
        APRG_HasExtension4(APRG_EXT4_BOON_MEAT_GRINDER)
    ) {
        g_aprgCloningTrigger = TriggerCreate("APRG_Cloning_Func");
        TriggerAddEventUnitTrainProgress(g_aprgCloningTrigger, null, c_unitProgressStageComplete);
        g_aprgProductionCreatedTrigger = TriggerCreate("APRG_ProductionCreated_Func");
        TriggerAddEventUnitCreated(g_aprgProductionCreatedTrigger, null, null, null);
    }
    if (APRG_HasBlessing(APRG_BOON_ENHANCED_CONTROL)) {
        g_aprgEnhancedControlTrigger = TriggerCreate("APRG_EnhancedControl_Func");
        TriggerAddEventUnitChangeOwner(g_aprgEnhancedControlTrigger, null);
    }
    if (APRG_HasBlessing(APRG_BOON_BANSHEE_SWARM)) {
        g_aprgBansheeSwarmTrigger = TriggerCreate("APRG_BansheeSwarm_Func");
        TriggerAddEventUnitTrainProgress(g_aprgBansheeSwarmTrigger, null, c_unitProgressStageComplete);
    }
    if (APRG_HasExtension3(APRG_EXT3_BOON_CORROSIVE_CLAWS)) {
        g_aprgCorrosiveClawsTrigger = TriggerCreate("APRG_CorrosiveClaws_Func");
        TriggerAddEventUnitDamaged(g_aprgCorrosiveClawsTrigger, null, c_unitDamageTypeAny, c_unitDamageEither, null);
    }
    if (APRG_HasExtension3(APRG_EXT3_BOON_ARCHON_CANNONS)) {
        g_aprgArchonCannonsTrigger = TriggerCreate("APRG_ArchonCannons_Func");
        TriggerAddEventUnitDamaged(g_aprgArchonCannonsTrigger, null, c_unitDamageTypeAny, c_unitDamageEither, null);
    }
    if (APRG_HasExtension3(APRG_EXT3_BOON_HYRDA_STORMS)) {
        g_aprgHydraStormsTrigger = TriggerCreate("APRG_HydraStorms_Func");
        TriggerAddEventUnitDamaged(g_aprgHydraStormsTrigger, null, c_unitDamageTypeAny, c_unitDamageEither, null);
    }
    if (APRG_HasExtension3(APRG_EXT3_BOON_UNLIMITED_POWER)) {
        APRG_ApplyUnlimitedPowerCatalog(player);
    }
    if (APRG_HasExtension2(APRG_EXT2_BOON_ROACH_INFESTATION)) { APRG_ApplyRoachInfestation(player); }
    if (APRG_HasMutation(APRG_MUT_RISING_GAS_PRICES)) {
        APRG_ApplyRisingGasPrices(player);
    }
    if (APRG_HasBlessing(APRG_BLESS_ASSEMBLY_LINE)) {
        APRG_ApplyAssemblyCatalog(player);
    }
    if (APRG_HasExtension(APRG_EXT_BLESS_HORDE_MODE)) {
        APRG_ApplyHordeCatalog(player);
    }
    if (g_aprgMercenaryUpgradePacked > 0 || g_aprgMercenaryUpgradePacked2 > 0) {
        APRG_ApplyMercenaryRecruitCatalog(player);
    }
    if (APRG_HasMutation(APRG_MUT_LOW_QUALITY_MINERALS)) {
        APRG_ApplyLowQualityMinerals();
    }
    if (APRG_HasBlessing(APRG_BLESS_FARSEERS)) {
        APRG_GiveFarseers(player);
    }
    if (APRG_HasExtension3(APRG_EXT3_MUT_RESOURCE_SWAP)) {
        APRG_InitializeResourceSwap(player);
        g_aprgResourceSwapTrigger = TriggerCreate("APRG_ResourceSwap_Func");
        TriggerAddEventPlayerPropChange(g_aprgResourceSwapTrigger, player, c_playerPropMinerals);
        TriggerAddEventPlayerPropChange(g_aprgResourceSwapTrigger, player, c_playerPropVespene);
    }
    if (APRG_HasExtension3(APRG_EXT3_BLESS_RICH_MINERALS) || APRG_HasExtension3(APRG_EXT3_BLESS_RICH_VESPENE)) {
        APRG_ApplyRichResources(
            player,
            APRG_HasExtension3(APRG_EXT3_BLESS_RICH_MINERALS),
            APRG_HasExtension3(APRG_EXT3_BLESS_RICH_VESPENE)
        );
        g_aprgRichMineralsApplied = APRG_HasExtension3(APRG_EXT3_BLESS_RICH_MINERALS);
        g_aprgRichVespeneApplied = APRG_HasExtension3(APRG_EXT3_BLESS_RICH_VESPENE);
    }
}


point APRG_FindRandomPlayerMineralLinePoint(int player) {
    unitgroup structures;
    unitgroup townHalls;
    unitgroup resources;
    unitgroup minerals;
    unit base;
    unit u;
    unit nearest;
    int i;
    structures = APRG_PlayerStructures(player);
    townHalls = UnitGroupEmpty();
    for (i = UnitGroupCount(structures, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(structures, i);
        if (u != null && APRG_IsTownHallType(UnitGetType(u))) { UnitGroupAdd(townHalls, u); }
    }
    if (UnitGroupCount(townHalls, c_unitCountAlive) > 0) { base = UnitGroupRandomUnit(townHalls, c_unitCountAlive); }
    else { base = APRG_FindPlayerHomeStructure(player); }
    if (base == null) { return null; }
    resources = UnitGroup(
        null, c_playerAny, RegionPlayableMap(),
        UnitFilter((1 << c_targetFilterHarvestableResource), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0
    );
    minerals = UnitGroupEmpty();
    for (i = UnitGroupCount(resources, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(resources, i);
        if (u != null && CatalogFieldValueGet(c_gameCatalogUnit, UnitGetType(u), "ResourceType", c_playerAny) == "Minerals") { UnitGroupAdd(minerals, u); }
    }
    if (UnitGroupCount(minerals, c_unitCountAlive) <= 0) { return UnitGetPosition(base); }
    nearest = UnitGroupClosestToPoint(minerals, UnitGetPosition(base));
    if (nearest == null) { return UnitGetPosition(base); }
    return UnitGetPosition(nearest);
}

void APRG_SpawnHellionRunBy(int player, int bonusCount) {
    unit anchor;
    point spawnPoint;
    point mineralLine;
    int owner;
    int count;
    unitgroup created;
    if (!CatalogEntryIsValid(c_gameCatalogUnit, "Hellion")) { return; }
    anchor = APRG_RandomPathableHostileBaseAnchor(player);
    if (anchor == null) { return; }
    spawnPoint = APRG_FindGroundPointNear(UnitGetPosition(anchor), 2.0, 12.0);
    if (spawnPoint == null) { spawnPoint = UnitGetPosition(anchor); }
    mineralLine = APRG_FindRandomPlayerMineralLinePoint(player);
    if (mineralLine == null) { return; }
    owner = UnitGetOwner(anchor);
    count = RandomInt(1, 2) + MaxI(0, bonusCount);
    created = UnitCreate(count, "Hellion", c_unitCreateIgnorePlacement, owner, spawnPoint, libNtve_gf_RandomAngle());
    if (created == null) { return; }
    APRG_RegisterMutationEnemyGroup(created);
    UnitGroupIssueOrder(created, OrderTargetingPoint(AbilityCommand("move", 0), mineralLine), c_orderQueueReplace);
    UnitGroupIssueOrder(created, OrderTargetingPoint(AbilityCommand("attack", 0), mineralLine), c_orderQueueAddToEnd);
}

void APRG_TickHellionRunBy(int player, fixed now) {
    if (!APRG_PlayerMacroBaseReady(player) || g_aprgMacroReadyTime < 0.0) { return; }
    if (g_aprgNextHellionRunByTime < 0.0) { g_aprgNextHellionRunByTime = g_aprgMacroReadyTime + 45.0; }
    if (now < g_aprgNextHellionRunByTime) { return; }
    APRG_SpawnHellionRunBy(player, g_aprgHellionRunByWave);
    g_aprgHellionRunByWave += 1;
    g_aprgNextHellionRunByTime = now + 45.0;
}

void APRG_SpawnDiamondbackWanderers(int player) {
    unit anchor;
    point p;
    int owner;
    unitgroup created;
    int i;
    unit u;
    if (g_aprgDiamondbackWanderersSpawned || !CatalogEntryIsValid(c_gameCatalogUnit, "Diamondback")) { return; }
    anchor = APRG_RandomPathableHostileBaseAnchor(player);
    if (anchor == null) { return; }
    p = APRG_FindGroundPointNear(UnitGetPosition(anchor), 4.0, 16.0);
    if (p == null) { p = UnitGetPosition(anchor); }
    owner = UnitGetOwner(anchor);
    created = UnitCreate(50, "Diamondback", c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
    if (created == null) { return; }
    APRG_RegisterMutationEnemyGroup(created);
    for (i = UnitGroupCount(created, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(created, i);
        if (u != null) { UnitGroupAdd(g_aprgDiamondbackWanderers, u); }
    }
    g_aprgDiamondbackWanderersSpawned = true;
    g_aprgNextDiamondbackWanderTime = GameGetMissionTime();
}

point APRG_DiamondbackWanderDestination(unit u, int player) {
    point origin;
    unit anchor;
    point candidate;
    int attempt;
    if (u == null || !UnitIsAlive(u)) { return null; }
    origin = UnitGetPosition(u);

    // 60% of orders deliberately choose a connected point around an enemy-base area.
    if (RandomInt(1, 100) <= 60) {
        anchor = APRG_RandomPathableHostileBaseAnchor(player);
        if (anchor != null) {
            for (attempt = 0; attempt < 24; attempt += 1) {
                candidate = PointWithOffsetPolar(UnitGetPosition(anchor), RandomFixed(2.0, 22.0), libNtve_gf_RandomAngle());
                if (
                    candidate != null &&
                    RegionContainsPoint(RegionPlayableMap(), candidate) &&
                    PointPathingPassable(candidate) &&
                    PointPathingIsConnected(origin, candidate)
                ) {
                    return candidate;
                }
            }
            candidate = UnitGetPosition(anchor);
            if (candidate != null && PointPathingPassable(candidate) && PointPathingIsConnected(origin, candidate)) {
                return candidate;
            }
        }
    }

    // The other 40% can be any connected pathable point on the playable map.
    // Enemy-base areas are intentionally allowed here too.
    for (attempt = 0; attempt < APRG_MAX_POINT_ATTEMPTS; attempt += 1) {
        candidate = RegionRandomPoint(RegionPlayableMap());
        if (candidate == null || !PointPathingPassable(candidate) || APRG_PointNearRakShirDuel(candidate, 24.0)) { continue; }
        if (PointPathingIsConnected(origin, candidate)) { return candidate; }
    }
    return APRG_RandomFixedPatrolPointForUnit(u, player, true);
}

void APRG_TickDiamondbackWanderers(int player, fixed now) {
    int alive;
    int attempts;
    int commanded;
    int index;
    unit u;
    point destination;
    if (!APRG_PlayerMacroBaseReady(player) || g_aprgMacroReadyTime < 0.0) { return; }
    if (!g_aprgDiamondbackWanderersSpawned && now >= g_aprgMacroReadyTime + 30.0) { APRG_SpawnDiamondbackWanderers(player); }
    if (!g_aprgDiamondbackWanderersSpawned || now < g_aprgNextDiamondbackWanderTime) { return; }
    alive = UnitGroupCount(g_aprgDiamondbackWanderers, c_unitCountAlive);
    if (alive <= 0) { return; }
    attempts = 0;
    commanded = 0;
    while (attempts < alive + 6 && commanded < 3) {
        index = (g_aprgDiamondbackWanderCursor % alive) + 1;
        g_aprgDiamondbackWanderCursor += 1;
        attempts += 1;
        u = UnitGroupUnitFromEnd(g_aprgDiamondbackWanderers, index);
        if (u == null || !UnitIsAlive(u)) { continue; }
        destination = APRG_DiamondbackWanderDestination(u, player);
        if (destination == null) { continue; }
        UnitIssueOrder(u, OrderTargetingPoint(AbilityCommand("move", 0), destination), c_orderQueueReplace);
        commanded += 1;
    }
    g_aprgNextDiamondbackWanderTime = now + 1.0;
}

bool APRG_LeviathanMutationAbilityMatches(string abilityType, int owner, string keyword) {
    string name;
    int buttonCount;
    int buttonIndex;
    string face;
    if (abilityType == "" || !CatalogEntryIsValid(c_gameCatalogAbil, abilityType)) { return false; }
    if (StringContains(abilityType, keyword, c_stringAnywhere, c_stringNoCase)) { return true; }
    name = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, "Name", owner);
    if (StringContains(name, keyword, c_stringAnywhere, c_stringNoCase)) { return true; }
    buttonCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, "CmdButtonArray", owner);
    for (buttonIndex = 0; buttonIndex < buttonCount; buttonIndex += 1) {
        face = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, "CmdButtonArray[" + IntToString(buttonIndex) + "].DefaultButtonFace", owner);
        if (StringContains(face, keyword, c_stringAnywhere, c_stringNoCase)) { return true; }
    }
    return false;
}

bool APRG_TryLeviathanMutationSpawn(unit leviathan, int player, string keyword, string fallbackType) {
    int abilityCount;
    int abilityIndex;
    int commandIndex;
    int owner;
    string abilityType;
    order castOrder;
    point p;
    unitgroup created;
    if (leviathan == null || !UnitIsAlive(leviathan)) { return false; }
    owner = UnitGetOwner(leviathan);
    // This mutation is defined around the Leviathan's native spawn abilities; keep
    // enough energy available for the scheduled and damage-triggered casts.
    UnitSetPropertyFixed(leviathan, c_unitPropEnergy, UnitGetPropertyFixed(leviathan, c_unitPropEnergyMax, c_unitPropCurrent));
    abilityCount = MinI(64, UnitAbilityCount(leviathan));
    for (abilityIndex = 1; abilityIndex <= abilityCount; abilityIndex += 1) {
        abilityType = UnitAbilityGet(leviathan, abilityIndex);
        if (!APRG_LeviathanMutationAbilityMatches(abilityType, owner, keyword)) { continue; }
        UnitAbilityEnable(leviathan, abilityType, true);
        for (commandIndex = 0; commandIndex < 4; commandIndex += 1) {
            TechTreeAbilityAllow(owner, AbilityCommand(abilityType, commandIndex), true);
            castOrder = Order(AbilityCommand(abilityType, commandIndex));
            if (UnitOrderIsValid(leviathan, castOrder)) { UnitIssueOrder(leviathan, castOrder, c_orderQueueReplace); return true; }
            castOrder = OrderTargetingPoint(AbilityCommand(abilityType, commandIndex), UnitGetPosition(leviathan));
            if (UnitOrderIsValid(leviathan, castOrder)) { UnitIssueOrder(leviathan, castOrder, c_orderQueueReplace); return true; }
        }
    }
    if (fallbackType == "" || !CatalogEntryIsValid(c_gameCatalogUnit, fallbackType)) { return false; }
    p = PointWithOffsetPolar(UnitGetPosition(leviathan), 3.0, libNtve_gf_RandomAngle());
    created = UnitCreate(1, fallbackType, c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
    APRG_RegisterMutationEnemyGroup(created);
    UnitGroupAddUnitGroup(g_aprgBaseLeviathanSpawnedUnits, created);
    UnitGroupAddUnitGroup(g_aprgHostileRaiders, created);
    APRG_OrderGroupTowardNearestPlayerStructure(created, p, player);
    return created != null;
}

bool APRG_BaseLeviathanSpawnlingType(string unitType) {
    if (unitType == "") { return false; }
    return (
        StringContains(unitType, "Mutalisk", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "BroodLord", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Brood Lord", c_stringAnywhere, c_stringNoCase)
    );
}

void APRG_ClaimBaseLeviathanSpawnlings(int player) {
    int owner;
    int i;
    unit u;
    unitgroup nearby;
    unitgroup one;
    if (g_aprgBaseLeviathan == null || !UnitIsAlive(g_aprgBaseLeviathan)) { return; }
    owner = UnitGetOwner(g_aprgBaseLeviathan);
    nearby = UnitGroup(
        null, owner, RegionCircle(UnitGetPosition(g_aprgBaseLeviathan), 12.0),
        UnitFilter(0, 0, (1 << c_targetFilterStructure) | (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0
    );
    for (i = UnitGroupCount(nearby, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(nearby, i);
        if (u == null || !UnitIsAlive(u) || !APRG_BaseLeviathanSpawnlingType(UnitGetType(u))) { continue; }
        if (UnitGroupHasUnit(g_aprgBaseLeviathanSpawnedUnits, u)) { continue; }
        UnitGroupAdd(g_aprgBaseLeviathanSpawnedUnits, u);
        UnitGroupAdd(g_aprgHostileRaiders, u);
        UnitGroupAdd(g_aprgSlaySpawnedEnemies, u);
        APRG_StripVoidEntityBehavior(u);
        one = UnitGroupEmpty();
        UnitGroupAdd(one, u);
        APRG_OrderGroupTowardNearestPlayerStructure(one, UnitGetPosition(u), player);
    }
}

void APRG_TickBaseLeviathanBurst(int player, fixed now) {
    int casts = 0;
    fixed life;
    fixed maximum;
    if (g_aprgBaseLeviathan == null || !UnitIsAlive(g_aprgBaseLeviathan)) { return; }

    // Fast-tick these thresholds so the retaliation feels immediate rather than
    // waiting for the one-second main mutation tick.
    life = UnitGetPropertyFixed(g_aprgBaseLeviathan, c_unitPropLife, c_unitPropCurrent);
    maximum = UnitGetPropertyFixed(g_aprgBaseLeviathan, c_unitPropLifeMax, c_unitPropCurrent);
    if (!g_aprgBaseLeviathanFirstDamageTriggered && maximum > 0.0 && life < maximum - 0.5) {
        g_aprgBaseLeviathanFirstDamageTriggered = true;
        APRG_TryLeviathanMutationSpawn(g_aprgBaseLeviathan, player, "Mutalisk", "Mutalisk");
    }
    if (!g_aprgBaseLeviathanHalfBurstTriggered && maximum > 0.0 && life <= maximum * 0.5) {
        g_aprgBaseLeviathanHalfBurstTriggered = true;
        g_aprgBaseLeviathanBurstRemaining = 20;
        g_aprgNextBaseLeviathanBurstTime = now;
    }

    while (g_aprgBaseLeviathanBurstRemaining > 0 && now >= g_aprgNextBaseLeviathanBurstTime && casts < 2) {
        APRG_TryLeviathanMutationSpawn(g_aprgBaseLeviathan, player, "Mutalisk", "Mutalisk");
        g_aprgBaseLeviathanBurstRemaining -= 1;
        g_aprgNextBaseLeviathanBurstTime += 0.2;
        casts += 1;
    }
    APRG_ClaimBaseLeviathanSpawnlings(player);
}

fixed APRG_BaseLeviathanMutaliskInterval(fixed now) {
    fixed progress;
    if (g_aprgMacroReadyTime < 0.0) { return 20.0; }
    progress = (now - (g_aprgMacroReadyTime + 240.0)) / 960.0;
    if (progress < 0.0) { progress = 0.0; }
    if (progress > 1.0) { progress = 1.0; }
    return 20.0 - (18.0 * progress);
}

fixed APRG_BaseLeviathanBroodLordInterval(fixed now) {
    fixed progress;
    if (g_aprgMacroReadyTime < 0.0) { return 45.0; }
    progress = (now - (g_aprgMacroReadyTime + 240.0)) / 960.0;
    if (progress < 0.0) { progress = 0.0; }
    if (progress > 1.0) { progress = 1.0; }
    return 45.0 - (40.5 * progress);
}

bool APRG_LeviathanDestructiveAbility(string abilityType, int owner) {
    string abilityName;
    if (abilityType == "" || !CatalogEntryIsValid(c_gameCatalogAbil, abilityType)) { return false; }
    abilityName = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, "Name", owner);
    return (
        StringContains(abilityType, "Bio", c_stringAnywhere, c_stringNoCase) ||
        StringContains(abilityType, "Plasm", c_stringAnywhere, c_stringNoCase) ||
        StringContains(abilityType, "Discharge", c_stringAnywhere, c_stringNoCase) ||
        StringContains(abilityType, "Stasis", c_stringAnywhere, c_stringNoCase) ||
        StringContains(abilityName, "Bio", c_stringAnywhere, c_stringNoCase) ||
        StringContains(abilityName, "Plasm", c_stringAnywhere, c_stringNoCase) ||
        StringContains(abilityName, "Discharge", c_stringAnywhere, c_stringNoCase) ||
        StringContains(abilityName, "Stasis", c_stringAnywhere, c_stringNoCase)
    );
}

void APRG_NormalizeMutationLeviathanCombatCooldown(unit leviathan) {
    int owner;
    int abilityCount;
    int abilityIndex;
    int infoCount;
    int infoIndex;
    int costIndex;
    string abilityType;
    string basePath;
    if (leviathan == null) { return; }
    owner = UnitGetOwner(leviathan);
    abilityCount = MinI(64, UnitAbilityCount(leviathan));
    for (abilityIndex = 1; abilityIndex <= abilityCount; abilityIndex += 1) {
        abilityType = UnitAbilityGet(leviathan, abilityIndex);
        if (!APRG_LeviathanDestructiveAbility(abilityType, owner)) { continue; }
        CatalogFieldValueSet(c_gameCatalogAbil, abilityType, "Cost.Cooldown.TimeUse", owner, "120");
        CatalogFieldValueSet(c_gameCatalogAbil, abilityType, "Cost.Cooldown.TimeStart", owner, "120");
        for (costIndex = 0; costIndex < 4; costIndex += 1) {
            basePath = "Cost[" + IntToString(costIndex) + "]";
            CatalogFieldValueSet(c_gameCatalogAbil, abilityType, basePath + ".Cooldown.TimeUse", owner, "120");
            CatalogFieldValueSet(c_gameCatalogAbil, abilityType, basePath + ".Cooldown.TimeStart", owner, "120");
        }
        infoCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, "InfoArray", owner);
        for (infoIndex = 0; infoIndex < infoCount; infoIndex += 1) {
            basePath = "InfoArray[" + IntToString(infoIndex) + "]";
            CatalogFieldValueSet(c_gameCatalogAbil, abilityType, basePath + ".Cooldown.TimeUse", owner, "120");
            CatalogFieldValueSet(c_gameCatalogAbil, abilityType, basePath + ".Cooldown.TimeStart", owner, "120");
            CatalogFieldValueSet(c_gameCatalogAbil, abilityType, basePath + ".Cost.Cooldown.TimeUse", owner, "120");
            CatalogFieldValueSet(c_gameCatalogAbil, abilityType, basePath + ".Cost.Cooldown.TimeStart", owner, "120");
        }
    }
}

void APRG_TickBaseLeviathan(int player, fixed now) {
    string leviathanType;
    point spawnPoint;
    int owner;
    unit anchor;
    unitgroup created;
    unit target;
    order stopOrder;
    fixed life;
    fixed maximum;
    if (!APRG_PlayerMacroBaseReady(player) || g_aprgMacroReadyTime < 0.0) { return; }
    if (g_aprgBaseLeviathan == null || !UnitIsAlive(g_aprgBaseLeviathan)) {
        // The Leviathan is a one-life encounter. Do not recreate it after the player kills it.
        if (g_aprgBaseLeviathan != null) { return; }
        leviathanType = APRG_LeviathanBoonType();
        if (leviathanType == "") { return; }
        spawnPoint = APRG_FindDeepEnemyAirPoint(player);
        if (spawnPoint == null) { return; }
        anchor = APRG_RandomHostileBaseAnchor(player);
        owner = APRG_FindHostileOwnerNearPoint(player, spawnPoint);
        if (owner < 0 && anchor != null) { owner = UnitGetOwner(anchor); }
        if (owner < 0) { return; }
        created = UnitCreate(1, leviathanType, c_unitCreateIgnorePlacement, owner, spawnPoint, libNtve_gf_RandomAngle());
        g_aprgBaseLeviathan = UnitGroupUnitFromEnd(created, 1);
        if (g_aprgBaseLeviathan == null) { return; }
        APRG_RegisterMutationEnemyGroup(created);
        APRG_RegisterAlwaysVisibleUnit(g_aprgBaseLeviathan, player);
        AISetUnitScriptControlled(g_aprgBaseLeviathan, false);
        UnitSetPropertyFixed(g_aprgBaseLeviathan, c_unitPropEnergyMax, 1000.0);
        UnitSetPropertyFixed(g_aprgBaseLeviathan, c_unitPropEnergy, 1000.0);
        APRG_NormalizeMutationLeviathanCombatCooldown(g_aprgBaseLeviathan);
    }

    life = UnitGetPropertyFixed(g_aprgBaseLeviathan, c_unitPropLife, c_unitPropCurrent);
    maximum = UnitGetPropertyFixed(g_aprgBaseLeviathan, c_unitPropLifeMax, c_unitPropCurrent);
    if (!g_aprgBaseLeviathanFirstDamageTriggered && maximum > 0.0 && life < maximum - 0.5) {
        g_aprgBaseLeviathanFirstDamageTriggered = true;
        APRG_TryLeviathanMutationSpawn(g_aprgBaseLeviathan, player, "Mutalisk", "Mutalisk");
    }
    if (!g_aprgBaseLeviathanHalfBurstTriggered && maximum > 0.0 && life <= maximum * 0.5) {
        g_aprgBaseLeviathanHalfBurstTriggered = true;
        g_aprgBaseLeviathanBurstRemaining = 20;
        g_aprgNextBaseLeviathanBurstTime = now;
    }

    if (now < g_aprgMacroReadyTime + 240.0) { return; }
    if (!g_aprgBaseLeviathanPositioned) {
        target = APRG_NearestPlayerStructure(UnitGetPosition(g_aprgBaseLeviathan), player);
        if (target == null) { return; }
        if (DistanceBetweenPoints(UnitGetPosition(g_aprgBaseLeviathan), UnitGetPosition(target)) > 30.0) {
            UnitIssueOrder(g_aprgBaseLeviathan, OrderTargetingPoint(AbilityCommand("move", 0), UnitGetPosition(target)), c_orderQueueReplace);
            return;
        }
        // Once it reaches 30 range it stops advancing permanently. From here the
        // Leviathan only fights things that engage it while its spawnlings attack.
        stopOrder = Order(AbilityCommand("stop", 0));
        if (UnitOrderIsValid(g_aprgBaseLeviathan, stopOrder)) { UnitIssueOrder(g_aprgBaseLeviathan, stopOrder, c_orderQueueReplace); }
        g_aprgBaseLeviathanPositioned = true;
        g_aprgNextBaseLeviathanMutaliskTime = now;
        g_aprgNextBaseLeviathanBroodLordTime = now;
    }
    if (now >= g_aprgNextBaseLeviathanMutaliskTime) {
        APRG_TryLeviathanMutationSpawn(g_aprgBaseLeviathan, player, "Mutalisk", "Mutalisk");
        g_aprgNextBaseLeviathanMutaliskTime = now + APRG_BaseLeviathanMutaliskInterval(now);
    }
    if (now >= g_aprgNextBaseLeviathanBroodLordTime) {
        APRG_TryLeviathanMutationSpawn(g_aprgBaseLeviathan, player, "BroodLord", "BroodLord");
        g_aprgNextBaseLeviathanBroodLordTime = now + APRG_BaseLeviathanBroodLordInterval(now);
    }
    APRG_ClaimBaseLeviathanSpawnlings(player);
}

bool APRG_TryUnitAbilityKeyword(unit caster, string keyword, unit target, point targetPoint) {
    int abilityCount;
    int abilityIndex;
    int commandIndex;
    int owner;
    string abilityType;
    string abilityName;
    order castOrder;
    if (caster == null || !UnitIsAlive(caster)) { return false; }
    owner = UnitGetOwner(caster);
    abilityCount = MinI(64, UnitAbilityCount(caster));
    for (abilityIndex = 1; abilityIndex <= abilityCount; abilityIndex += 1) {
        abilityType = UnitAbilityGet(caster, abilityIndex);
        if (abilityType == "" || !CatalogEntryIsValid(c_gameCatalogAbil, abilityType)) { continue; }
        abilityName = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, "Name", owner);
        if (!StringContains(abilityType, keyword, c_stringAnywhere, c_stringNoCase) && !StringContains(abilityName, keyword, c_stringAnywhere, c_stringNoCase)) { continue; }
        UnitAbilityEnable(caster, abilityType, true);
        for (commandIndex = 0; commandIndex < 4; commandIndex += 1) {
            TechTreeAbilityAllow(owner, AbilityCommand(abilityType, commandIndex), true);
            if (target != null) {
                castOrder = OrderTargetingUnit(AbilityCommand(abilityType, commandIndex), target);
                if (UnitOrderIsValid(caster, castOrder)) { UnitIssueOrder(caster, castOrder, c_orderQueueReplace); return true; }
            }
            if (targetPoint != null) {
                castOrder = OrderTargetingPoint(AbilityCommand(abilityType, commandIndex), targetPoint);
                if (UnitOrderIsValid(caster, castOrder)) { UnitIssueOrder(caster, castOrder, c_orderQueueReplace); return true; }
            }
            castOrder = Order(AbilityCommand(abilityType, commandIndex));
            if (UnitOrderIsValid(caster, castOrder)) { UnitIssueOrder(caster, castOrder, c_orderQueueReplace); return true; }
        }
    }
    return false;
}

// A connected enemy building can be close to a cliff or blocked terrain.
// Validate the actual spawn position as well as the hostile building anchor.
point APRG_ToshPathableHostileSpawnPoint(unit anchor, int player) {
    unit home;
    point candidate;
    int attempt;
    if (anchor == null || !UnitIsAlive(anchor)) { return null; }
    home = APRG_FindPlayerHomeStructure(player);
    if (home == null || !UnitIsAlive(home)) { return null; }
    for (attempt = 0; attempt < 12; attempt += 1) {
        candidate = APRG_FindGroundPointNear(UnitGetPosition(anchor), 3.0, 10.0);
        if (candidate != null && PointPathingIsConnected(candidate, UnitGetPosition(home))) {
            return candidate;
        }
    }
    return null;
}

// Hostile Tosh uses normal hero spellcasting and attack-move patrols between
// enemy-held regions. Exactly one Tosh is spawned: killing him stops new raids.
bool APRG_TryToshDefensiveShield(unit tosh) {
    fixed health;
    fixed healthMax;
    string abilityType;
    order shieldOrder;
    order priorOrder;
    bool hadPriorOrder;
    int abilityIndex;
    int commandIndex;
    if (tosh == null || !UnitIsAlive(tosh)) { return false; }
    health = UnitGetPropertyFixed(tosh, c_unitPropLife, c_unitPropCurrent);
    healthMax = UnitGetPropertyFixed(tosh, c_unitPropLifeMax, c_unitPropCurrent);
    // Tosh's campaign Psi Shield uses VoodooShield (rather than Raven's
    // DefensiveMatrix). Cast as soon as he takes any real health damage.
    if (healthMax <= 0.0 || health >= healthMax - 0.5) { return false; }
    for (abilityIndex = 1; abilityIndex <= MinI(96, UnitAbilityCount(tosh)); abilityIndex += 1) {
        abilityType = UnitAbilityGet(tosh, abilityIndex);
        if (!APRG_AIHas(abilityType, "VoodooShield") && !APRG_AIHas(abilityType, "PsiShield") &&
            !APRG_AIHas(abilityType, "PsionicShield")) { continue; }
        if (!APRG_AICastThrottleReady(tosh, abilityType, APRG_AI_REACTIVE)) { continue; }
        for (commandIndex = 0; commandIndex < 2; commandIndex += 1) {
            shieldOrder = Order(AbilityCommand(abilityType, commandIndex));
            if (!UnitOrderIsValid(tosh, shieldOrder)) { continue; }
            hadPriorOrder = UnitOrderCount(tosh) > 0;
            if (hadPriorOrder) { priorOrder = UnitOrder(tosh, 0); }
            UnitIssueOrder(tosh, shieldOrder, c_orderQueueReplace);
            APRG_QueuePriorAutonomousOrder(tosh, priorOrder, hadPriorOrder);
            APRG_RecordAICast(tosh, abilityType);
            return true;
        }
    }
    return false;
}

void APRG_TickToshAndHisBoys(int player, fixed now) {
    unit anchor;
    unit spec;
    unit target;
    unitgroup created;
    point spawnPoint;
    point targetPoint;
    int owner;
    int slot;
    int i;
    string toshType;
    order castOrder;
    if (!APRG_PlayerMacroBaseReady(player) || g_aprgMacroReadyTime < 0.0) { return; }
    if (!g_aprgToshSpawned) {
        toshType = "Tosh";
        if (!CatalogEntryIsValid(c_gameCatalogUnit, toshType)) { toshType = "ToshHero"; }
        if (!CatalogEntryIsValid(c_gameCatalogUnit, toshType)) { return; }
        anchor = APRG_RandomPathableHostileBaseAnchor(player);
        if (anchor == null) { return; }
        spawnPoint = APRG_ToshPathableHostileSpawnPoint(anchor, player);
        if (spawnPoint == null) { return; }
        created = UnitCreate(1, toshType, c_unitCreateIgnorePlacement, UnitGetOwner(anchor), spawnPoint, libNtve_gf_RandomAngle());
        g_aprgTosh = UnitGroupUnitFromEnd(created, 1);
        if (g_aprgTosh == null) { return; }
        APRG_RegisterMutationEnemyGroup(created);
        AISetUnitScriptControlled(g_aprgTosh, false);
        g_aprgToshSpawned = true;
        g_aprgNextToshPatrolTime = g_aprgMacroReadyTime + 180.0;
        g_aprgNextToshAbilityTime = g_aprgMacroReadyTime + 180.0;
        g_aprgNextToshSpectreTime = g_aprgMacroReadyTime + 240.0;
    }
    // Previous spectres finish their attacks, but Tosh's death halts new spawns.
    if (g_aprgTosh != null && UnitIsAlive(g_aprgTosh)) {
        // Do not wait for the 5-second generic hero AI tick or for a nearby
        // offensive target before using Tosh's personal protective shield.
        APRG_TryToshDefensiveShield(g_aprgTosh);
        if (now >= g_aprgNextToshPatrolTime) {
            anchor = APRG_RandomPathableHostileBaseAnchor(player);
            if (anchor != null) {
                APRG_OrderAttackMove(g_aprgTosh, UnitGetPosition(anchor));
            }
            g_aprgNextToshPatrolTime = now + 35.0;
        }
        if (now >= g_aprgNextToshAbilityTime) {
            APRG_TryGeneratedHeroAbility(g_aprgTosh, player);
            g_aprgNextToshAbilityTime = now + 5.0;
        }
        if (now >= g_aprgNextToshSpectreTime) {
            // The schedule advances even if no valid terrain exists this minute.
            g_aprgNextToshSpectreTime = now + 60.0;
            if (CatalogEntryIsValid(c_gameCatalogUnit, "Spectre")) {
                slot = -1;
                for (i = 0; i < APRG_MAX_TOSH_SPECTRES; i += 1) {
                    if (g_aprgToshSpectres[i] == null) { slot = i; break; }
                    if (g_aprgToshSpectrePhase[i] == 3 && !UnitIsAlive(g_aprgToshSpectres[i])) {
                        g_aprgToshSpectres[i] = null; slot = i; break;
                    }
                }
                anchor = APRG_RandomPathableHostileBaseAnchor(player);
                if (slot >= 0 && anchor != null) {
                    spawnPoint = APRG_ToshPathableHostileSpawnPoint(anchor, player);
                    if (spawnPoint != null) {
                    created = UnitCreate(1, "Spectre", c_unitCreateIgnorePlacement, UnitGetOwner(anchor), spawnPoint, libNtve_gf_RandomAngle());
                    spec = UnitGroupUnitFromEnd(created, 1);
                    if (spec != null) {
                        APRG_RegisterMutationEnemyGroup(created);
                        g_aprgToshSpectres[slot] = spec;
                        g_aprgToshSpectrePhase[slot] = 1;
                        g_aprgToshSpectreNukePoint[slot] = null;
                        g_aprgToshSpectreNukeTime[slot] = -1.0;
                        g_aprgToshSpectreNextOrderTime[slot] = now;
                        g_aprgToshSpectreNukeIndicator[slot] = null;
                        AISetUnitScriptControlled(spec, false);
                        APRG_TryUnitAbilityKeyword(spec, "Cloak", null, null);
                        if (CatalogEntryIsValid(c_gameCatalogBehavior, "APRogueCloakedNightmare")) {
                            UnitBehaviorAdd(spec, "APRogueCloakedNightmare", spec, 1);
                        }
                    }
                    }
                }
            }
        }
    }
    for (i = 0; i < APRG_MAX_TOSH_SPECTRES; i += 1) {
        spec = g_aprgToshSpectres[i];
        if (spec == null) { continue; }
        if (!UnitIsAlive(spec)) {
            if (g_aprgToshSpectreNukeIndicator[i] != null) { ActorSend(g_aprgToshSpectreNukeIndicator[i], "Destroy"); }
            g_aprgToshSpectreNukeIndicator[i] = null;
            g_aprgToshSpectrePhase[i] = 3;
            continue;
        }
        if (g_aprgToshSpectrePhase[i] == 2) {
            if (now < g_aprgToshSpectreNukeTime[i]) { continue; }
            targetPoint = g_aprgToshSpectreNukePoint[i];
            if (targetPoint != null && CatalogEntryIsValid(c_gameCatalogEffect, "NukeDamage")) {
                PlayerCreateEffectPoint(UnitGetOwner(spec), "NukeDamage", targetPoint);
            }
            if (g_aprgToshSpectreNukeIndicator[i] != null) { ActorSend(g_aprgToshSpectreNukeIndicator[i], "Destroy"); }
            g_aprgToshSpectreNukeIndicator[i] = null;
            g_aprgToshSpectrePhase[i] = 3;
            target = APRG_NearestPathablePlayerStructure(spec, player);
            if (target != null) { APRG_OrderAttackMove(spec, UnitGetPosition(target)); }
            continue;
        }
        if (g_aprgToshSpectrePhase[i] != 1) { continue; }
        target = APRG_NearestPathablePlayerStructure(spec, player);
        if (target == null) { continue; }
        if (g_aprgToshSpectreNukePoint[i] == null) {
            g_aprgToshSpectreNukePoint[i] = PointWithOffsetPolar(UnitGetPosition(target), RandomFixed(0.0, 5.0), libNtve_gf_RandomAngle());
        }
        targetPoint = g_aprgToshSpectreNukePoint[i];
        if (DistanceBetweenPoints(UnitGetPosition(spec), targetPoint) > 9.0) {
            if (now >= g_aprgToshSpectreNextOrderTime[i]) {
                APRG_OrderAttackMove(spec, targetPoint);
                g_aprgToshSpectreNextOrderTime[i] = now + 4.0;
            }
            continue;
        }
        // First prefer the spectre's actual Nuke calldown. Some campaign
        // dependencies require a Ghost Academy, so retain a telegraphed
        // 12-second fallback that can be interrupted by killing the spectre.
        if (APRG_TryUnitAbilityKeyword(spec, "Nuke", null, targetPoint)) {
            g_aprgToshSpectrePhase[i] = 3;
            continue;
        }
        if (CatalogEntryIsValid(c_gameCatalogModel, "GhostNukeIndicator")) {
            g_aprgToshSpectreNukeIndicator[i] = libNtve_gf_CreateModelAtPoint("GhostNukeIndicator", targetPoint);
        }
        g_aprgToshSpectreNukeTime[i] = now + 12.0;
        g_aprgToshSpectrePhase[i] = 2;
        UnitIssueOrder(spec, Order(AbilityCommand("stop", 0)), c_orderQueueReplace);
    }
}

bool APRG_IsOdinDefensiveStructure(unit u) {
    string unitType;
    if (u == null || !UnitIsAlive(u) || !UnitTypeTestAttribute(UnitGetType(u), c_unitAttributeStructure)) { return false; }
    unitType = UnitGetType(u);
    if (UnitWeaponCount(u) > 0) { return true; }
    return (
        StringContains(unitType, "Bunker", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Turret", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Cannon", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "SpineCrawler", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "SporeCrawler", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "PlanetaryFortress", c_stringAnywhere, c_stringNoCase)
    );
}

unit APRG_OdinBarrageTarget(unit odin, int player) {
    unitgroup mobiles;
    unitgroup nearby;
    unitgroup structures;
    unit candidate;
    unit best = null;
    int i;
    int count;
    int bestCount = 0;
    fixed distance;
    fixed bestDistance = 999999.0;
    point odinPoint;
    if (odin == null || !UnitIsAlive(odin)) { return null; }
    odinPoint = UnitGetPosition(odin);

    // Prefer a genuine unit clump: at least three mobile player units inside a
    // 4.5-radius area and within practical Barrage range of the Odin.
    mobiles = APRG_PlayerMobileUnits(player);
    for (i = UnitGroupCount(mobiles, c_unitCountAlive); i > 0; i -= 1) {
        candidate = UnitGroupUnitFromEnd(mobiles, i);
        if (candidate == null || !UnitIsAlive(candidate)) { continue; }
        distance = DistanceBetweenPoints(odinPoint, UnitGetPosition(candidate));
        if (distance > 10.0) { continue; }
        nearby = UnitGroup(
            null, player, RegionCircle(UnitGetPosition(candidate), 4.5),
            UnitFilter(0, 0, (1 << c_targetFilterStructure) | (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0
        );
        count = UnitGroupCount(nearby, c_unitCountAlive);
        if (count >= 3 && (count > bestCount || (count == bestCount && distance < bestDistance))) {
            best = candidate;
            bestCount = count;
            bestDistance = distance;
        }
    }
    if (best != null) { return best; }

    // Otherwise use Barrage on a defensive structure, not an arbitrary building.
    structures = APRG_PlayerStructures(player);
    for (i = UnitGroupCount(structures, c_unitCountAlive); i > 0; i -= 1) {
        candidate = UnitGroupUnitFromEnd(structures, i);
        if (!APRG_IsOdinDefensiveStructure(candidate)) { continue; }
        distance = DistanceBetweenPoints(odinPoint, UnitGetPosition(candidate));
        if (distance <= 10.0 && distance < bestDistance) { best = candidate; bestDistance = distance; }
    }
    return best;
}

void APRG_OrderDelayedOdinAttackMove(int player) {
    unit target;
    if (g_aprgDelayedOdin == null || !UnitIsAlive(g_aprgDelayedOdin)) { return; }
    target = APRG_NearestPathablePlayerStructure(g_aprgDelayedOdin, player);
    if (target == null) { target = APRG_NearestPlayerStructure(UnitGetPosition(g_aprgDelayedOdin), player); }
    if (target == null) { return; }
    AISetUnitScriptControlled(g_aprgDelayedOdin, false);
    UnitIssueOrder(g_aprgDelayedOdin, OrderTargetingPoint(AbilityCommand("attack", 0), UnitGetPosition(target)), c_orderQueueReplace);
}

void APRG_TickDelayedOdin(int player, fixed now) {
    unit anchor;
    point p;
    point currentPoint;
    point targetPoint;
    int owner;
    unitgroup created;
    unit target;
    unit barrageTarget;
    fixed targetDistance;
    bool barrageCast = false;
    if (!APRG_PlayerMacroBaseReady(player) || g_aprgMacroReadyTime < 0.0) { return; }

    // Spawn exactly once. A killed Odin stays dead for the rest of the mission.
    if (!g_aprgDelayedOdinSpawned) {
        if (!CatalogEntryIsValid(c_gameCatalogUnit, "Odin")) { return; }
        anchor = APRG_RandomPathableHostileBaseAnchor(player);
        if (anchor == null) { return; }
        p = APRG_FindGroundPointNear(UnitGetPosition(anchor), 4.0, 14.0);
        if (p == null) { p = UnitGetPosition(anchor); }
        owner = UnitGetOwner(anchor);
        created = UnitCreate(1, "Odin", c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
        g_aprgDelayedOdin = UnitGroupUnitFromEnd(created, 1);
        if (g_aprgDelayedOdin == null) { return; }
        g_aprgDelayedOdinSpawned = true;
        APRG_RegisterMutationEnemyGroup(created);
        AISetUnitScriptControlled(g_aprgDelayedOdin, false);
        if (CatalogEntryIsValid(c_gameCatalogAbil, "OdinBarrage")) { UnitAbilityEnable(g_aprgDelayedOdin, "OdinBarrage", true); }
        g_aprgDelayedOdinProgressPoint = UnitGetPosition(g_aprgDelayedOdin);
        g_aprgDelayedOdinProgressTime = now;
    }
    if (g_aprgDelayedOdin == null || !UnitIsAlive(g_aprgDelayedOdin)) { return; }
    if (now < g_aprgMacroReadyTime + 780.0) { return; }

    if (!g_aprgDelayedOdinAttacking) {
        g_aprgDelayedOdinAttacking = true;
        UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaChat, StringToText("Odin incoming!"));
        g_aprgNextDelayedOdinRetargetTime = now;
        g_aprgNextDelayedOdinBarrageTime = now;
        g_aprgDelayedOdinProgressPoint = UnitGetPosition(g_aprgDelayedOdin);
        g_aprgDelayedOdinProgressTime = now;
    }
    if (g_aprgNextDelayedOdinRetargetTime < 0.0 || now >= g_aprgNextDelayedOdinRetargetTime) {
        APRG_OrderDelayedOdinAttackMove(player);
        g_aprgNextDelayedOdinRetargetTime = now + 10.0;
    }

    if (now >= g_aprgNextDelayedOdinBarrageTime) {
        barrageTarget = APRG_OdinBarrageTarget(g_aprgDelayedOdin, player);
        if (barrageTarget != null) {
            if (CatalogEntryIsValid(c_gameCatalogAbil, "OdinBarrage")) {
                UnitAbilityEnable(g_aprgDelayedOdin, "OdinBarrage", true);
                TechTreeAbilityAllow(UnitGetOwner(g_aprgDelayedOdin), AbilityCommand("OdinBarrage", 0), true);
                if (UnitOrderIsValid(g_aprgDelayedOdin, OrderTargetingPoint(AbilityCommand("OdinBarrage", 0), UnitGetPosition(barrageTarget)))) {
                    UnitIssueOrder(g_aprgDelayedOdin, OrderTargetingPoint(AbilityCommand("OdinBarrage", 0), UnitGetPosition(barrageTarget)), c_orderQueueReplace);
                    barrageCast = true;
                }
            }
            if (!barrageCast) { barrageCast = APRG_TryUnitAbilityKeyword(g_aprgDelayedOdin, "Barrage", barrageTarget, UnitGetPosition(barrageTarget)); }
        }
        if (barrageCast) { g_aprgNextDelayedOdinBarrageTime = now + 10.0; }
        else { g_aprgNextDelayedOdinBarrageTime = now + 3.0; }
    }

    // Break out of an enemy-base traffic jam after 30 seconds of no progress.
    currentPoint = UnitGetPosition(g_aprgDelayedOdin);
    target = APRG_NearestPlayerStructure(currentPoint, player);
    if (target != null) {
        targetPoint = UnitGetPosition(target);
        targetDistance = DistanceBetweenPoints(currentPoint, targetPoint);
        if (g_aprgDelayedOdinProgressPoint == null || DistanceBetweenPoints(currentPoint, g_aprgDelayedOdinProgressPoint) >= 2.0 || targetDistance <= 14.0) {
            g_aprgDelayedOdinProgressPoint = currentPoint;
            g_aprgDelayedOdinProgressTime = now;
        }
        else if (g_aprgDelayedOdinProgressTime >= 0.0 && now - g_aprgDelayedOdinProgressTime >= 30.0) {
            if (!APRG_ClearFriendlyBlocker(g_aprgDelayedOdin, targetPoint, 140.0)) {
                g_aprgDelayedOdinProgressPoint = currentPoint;
                g_aprgDelayedOdinProgressTime = now;
                APRG_OrderDelayedOdinAttackMove(player);
            }
        }
    }
}

void APRG_TickCombinedRaids(int player, fixed now) {
    if (!APRG_PlayerMacroBaseReady(player) || g_aprgMacroReadyTime < 0.0) { return; }
    if (g_aprgCombinedNextWraithTime < 0.0) { g_aprgCombinedNextWraithTime = g_aprgMacroReadyTime + 60.0; }
    if (g_aprgCombinedNextVikingTime < 0.0) { g_aprgCombinedNextVikingTime = g_aprgMacroReadyTime + 20.0; }
    if (g_aprgCombinedNextHellionTime < 0.0) { g_aprgCombinedNextHellionTime = g_aprgMacroReadyTime + 45.0; }
    if (now >= g_aprgCombinedNextWraithTime) { APRG_SpawnWraithRaid(player); g_aprgCombinedNextWraithTime = now + APRG_WraithRaidNextInterval(now); }
    if (now >= g_aprgCombinedNextVikingTime) { APRG_SpawnVikingRaid(player); g_aprgCombinedNextVikingTime = now + RandomFixed(20.0, 180.0); }
    if (now >= g_aprgCombinedNextHellionTime) {
        APRG_SpawnHellionRunBy(player, g_aprgCombinedHellionWave);
        g_aprgCombinedHellionWave += 1;
        g_aprgCombinedNextHellionTime = now + 45.0;
    }
}

string APRG_BrakkType() {
    if (CatalogEntryIsValid(c_gameCatalogUnit, "Brakk")) { return "Brakk"; }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "PrimalBrakk")) { return "PrimalBrakk"; }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "BrakkHero")) { return "BrakkHero"; }
    return "";
}

string APRG_PrimalGuardianType() {
    if (CatalogEntryIsValid(c_gameCatalogUnit, "PrimalGuardian")) { return "PrimalGuardian"; }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "GuardianPrimal")) { return "GuardianPrimal"; }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "Guardian")) { return "Guardian"; }
    return "";
}

void APRG_AddCreatedToBrakkArmy(unitgroup created) {
    int i;
    unit u;
    if (created == null) { return; }
    APRG_RegisterMutationEnemyGroup(created);
    for (i = UnitGroupCount(created, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(created, i);
        if (u != null) { UnitGroupAdd(g_aprgBrakkArmy, u); }
    }
}

void APRG_SpawnBrakkUnitGroup(string unitType, int count, int owner, point center) {
    unitgroup created;
    point p;
    if (unitType == "" || count <= 0 || !CatalogEntryIsValid(c_gameCatalogUnit, unitType)) { return; }
    p = APRG_FindGroundPointNear(center, 1.0, 12.0);
    if (p == null) { p = center; }
    created = UnitCreate(count, unitType, c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
    APRG_AddCreatedToBrakkArmy(created);
}

void APRG_TickBrakkArmy(int player, fixed now) {
    unit anchor;
    point center;
    int owner;
    string brakkType;
    string guardianType;
    unitgroup created;
    unit brakk;
    unit home;
    if (!APRG_PlayerMacroBaseReady(player) || g_aprgMacroReadyTime < 0.0) { return; }
    if (!g_aprgBrakkArmySpawned) {
        anchor = APRG_RandomPathableHostileBaseAnchor(player);
        if (anchor == null) { return; }
        center = UnitGetPosition(anchor);
        owner = UnitGetOwner(anchor);
        brakkType = APRG_BrakkType();
        if (brakkType != "") {
            created = UnitCreate(1, brakkType, c_unitCreateIgnorePlacement, owner, center, libNtve_gf_RandomAngle());
            APRG_AddCreatedToBrakkArmy(created);
            brakk = UnitGroupUnitFromEnd(created, 1);
            if (brakk != null) { APRG_RegisterAlwaysVisibleUnit(brakk, player); }
        }
        APRG_SpawnBrakkUnitGroup(APRG_DehakaPackType(3), 20, owner, center);
        APRG_SpawnBrakkUnitGroup(APRG_DehakaPackType(0), 40, owner, center);
        guardianType = APRG_PrimalGuardianType();
        APRG_SpawnBrakkUnitGroup(guardianType, 10, owner, center);
        APRG_SpawnBrakkUnitGroup(APRG_DehakaPackType(1), 20, owner, center);
        APRG_SpawnBrakkUnitGroup(APRG_DehakaPackType(2), 20, owner, center);
        APRG_SpawnBrakkUnitGroup(APRG_DehakaPackType(4), 10, owner, center);
        g_aprgBrakkArmySpawned = true;
    }
    if (!g_aprgBrakkArmyAttacking && now >= g_aprgMacroReadyTime + 600.0) {
        home = APRG_FindPlayerHomeStructure(player);
        if (home != null) { UnitGroupIssueOrder(g_aprgBrakkArmy, OrderTargetingPoint(AbilityCommand("attack", 0), UnitGetPosition(home)), c_orderQueueReplace); }
        // After the timed assault begins, use the shared hostile-raider retargeting
        // so the army keeps finding live player structures instead of idling at the
        // location of a building that has already died.
        UnitGroupAddUnitGroup(g_aprgHostileRaiders, g_aprgBrakkArmy);
        g_aprgBrakkArmyAttacking = true;
        UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaChat, StringToText("Brakk's Pack incoming!"));
    }
}

point APRG_FindOrlanFortressPoint(int player) {
    int attempt;
    point candidate;
    unit home;
    home = APRG_FindPlayerHomeStructure(player);
    for (attempt = 0; attempt < 96; attempt += 1) {
        candidate = RegionRandomPoint(RegionPlayableMap());
        if (candidate == null || !PointPathingPassable(candidate)) { continue; }
        if (APRG_PointNearPlayerOrAlliedBuilding(candidate, player, 40.0)) { continue; }
        if (!APRG_PointNearPlayerOrAlliedBuilding(candidate, player, 60.0)) { continue; }
        if (APRG_GroundSpawnsNeedPlayerPathing() && home != null && !PointPathingIsConnected(candidate, UnitGetPosition(home))) { continue; }
        return candidate;
    }
    if (home == null) { return null; }
    for (attempt = 0; attempt < 48; attempt += 1) {
        candidate = PointWithOffsetPolar(UnitGetPosition(home), RandomFixed(42.0, 58.0), libNtve_gf_RandomAngle());
        if (candidate == null || !RegionContainsPoint(RegionPlayableMap(), candidate) || !PointPathingPassable(candidate)) { continue; }
        if (APRG_PointNearPlayerOrAlliedBuilding(candidate, player, 40.0)) { continue; }
        if (APRG_GroundSpawnsNeedPlayerPathing() && !PointPathingIsConnected(candidate, UnitGetPosition(home))) { continue; }
        return candidate;
    }
    return null;
}

string APRG_JacksonsRevengeType() {
    // The SC2 CampaignAI RequirementsAI unit ID for the mercenary Battlecruiser
    // is DukesRevenge. JacksonsRevenge is an incomplete catalog alias on some
    // missions (model-less placeholder); never select it by a name scan.
    if (CatalogEntryIsValid(c_gameCatalogUnit, "DukesRevenge")) { return "DukesRevenge"; }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "AP_DukesRevenge")) { return "AP_DukesRevenge"; }
    // Prefer a visible normal Battlecruiser to an unfinished unit with no actor.
    if (CatalogEntryIsValid(c_gameCatalogUnit, "Battlecruiser")) { return "Battlecruiser"; }
    return "";
}

void APRG_SpawnOrlanFortress(int player) {
    point center;
    point p;
    int owner;
    int i;
    fixed angle;
    unitgroup created;
    unit u;
    string jacksonType;
    if (g_aprgOrlanFortressSpawned || !CatalogEntryIsValid(c_gameCatalogUnit, "PlanetaryFortress")) { return; }
    center = APRG_FindOrlanFortressPoint(player);
    if (center == null) { return; }
    owner = APRG_FindHostileOwnerNearPoint(player, center);
    if (owner < 0) { return; }
    created = UnitCreate(1, "PlanetaryFortress", c_unitCreateIgnorePlacement, owner, center, libNtve_gf_RandomAngle());
    g_aprgOrlanFortress = UnitGroupUnitFromEnd(created, 1);
    if (g_aprgOrlanFortress == null) { return; }
    APRG_RegisterMutationEnemyGroup(created);
    APRG_RegisterAlwaysVisibleUnit(g_aprgOrlanFortress, player);
    jacksonType = APRG_JacksonsRevengeType();
    if (jacksonType != "") {
        p = PointWithOffsetPolar(center, 3.0, 90.0);
        created = UnitCreate(1, jacksonType, c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
        APRG_RegisterMutationEnemyGroup(created);
    }
    for (i = 0; i < 3; i += 1) {
        if (CatalogEntryIsValid(c_gameCatalogUnit, "SiegeBreaker")) {
            p = PointWithOffsetPolar(center, 8.0, IntToFixed(i) * 120.0);
            created = UnitCreate(1, "SiegeBreaker", c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
            APRG_RegisterMutationEnemyGroup(created);
            u = UnitGroupUnitFromEnd(created, 1);
            if (u != null) { UnitIssueOrder(u, Order(AbilityCommand("SiegeMode", 0)), c_orderQueueReplace); }
        }
        if (CatalogEntryIsValid(c_gameCatalogUnit, "MissileTurret")) {
            p = PointWithOffsetPolar(center, 10.0, 60.0 + IntToFixed(i) * 120.0);
            created = UnitCreate(1, "MissileTurret", c_unitCreateIgnorePlacement, owner, p, 270.0);
            APRG_RegisterMutationEnemyGroup(created);
        }
    }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "SCV")) {
        for (i = 0; i < 20; i += 1) {
            angle = 18.0 * IntToFixed(i);
            p = PointWithOffsetPolar(center, 8.0, angle);
            created = UnitCreate(1, "SCV", c_unitCreateIgnorePlacement, owner, p, angle + 180.0);
            APRG_RegisterMutationEnemyGroup(created);
            u = UnitGroupUnitFromEnd(created, 1);
            if (u != null) {
                UnitGroupAdd(g_aprgOrlanSCVs, u);
                UnitIssueOrder(u, OrderTargetingPoint(AbilityCommand("move", 0), center), c_orderQueueReplace);
                UnitIssueOrder(u, OrderSetAutoCast(AbilityCommand("Repair", 0), true), c_orderQueueAddToEnd);
            }
        }
    }
    g_aprgOrlanFortressSpawned = true;
    g_aprgNextOrlanRangeTime = GameGetMissionTime() + 30.0;
    g_aprgNextOrlanSCVReplacementTime = GameGetMissionTime() + 12.0;
}

bool APRG_TryOrlanTrainSCV() {
    int owner;
    int abilityCount;
    int abilityIndex;
    int commandIndex;
    int buttonCount;
    int buttonIndex;
    string abilityType;
    string abilityName;
    string face;
    bool matches;
    order trainOrder;
    if (g_aprgOrlanFortress == null || !UnitIsAlive(g_aprgOrlanFortress)) { return false; }
    owner = UnitGetOwner(g_aprgOrlanFortress);
    abilityCount = MinI(64, UnitAbilityCount(g_aprgOrlanFortress));
    for (abilityIndex = 1; abilityIndex <= abilityCount; abilityIndex += 1) {
        abilityType = UnitAbilityGet(g_aprgOrlanFortress, abilityIndex);
        if (abilityType == "" || !CatalogEntryIsValid(c_gameCatalogAbil, abilityType)) { continue; }
        matches = StringContains(abilityType, "SCV", c_stringAnywhere, c_stringNoCase);
        abilityName = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, "Name", owner);
        if (!matches && StringContains(abilityName, "SCV", c_stringAnywhere, c_stringNoCase)) { matches = true; }
        if (!matches) {
            buttonCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, "CmdButtonArray", owner);
            for (buttonIndex = 0; buttonIndex < buttonCount; buttonIndex += 1) {
                face = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, "CmdButtonArray[" + IntToString(buttonIndex) + "].DefaultButtonFace", owner);
                if (StringContains(face, "SCV", c_stringAnywhere, c_stringNoCase)) { matches = true; break; }
            }
        }
        if (!matches) { continue; }
        UnitAbilityEnable(g_aprgOrlanFortress, abilityType, true);
        for (commandIndex = 0; commandIndex < 6; commandIndex += 1) {
            TechTreeAbilityAllow(owner, AbilityCommand(abilityType, commandIndex), true);
            trainOrder = Order(AbilityCommand(abilityType, commandIndex));
            if (UnitOrderIsValid(g_aprgOrlanFortress, trainOrder)) {
                UnitIssueOrder(g_aprgOrlanFortress, trainOrder, c_orderQueueAddToEnd);
                return true;
            }
        }
    }
    return false;
}

void APRG_RegisterNearbyOrlanSCVs() {
    int owner;
    int i;
    unit scv;
    unitgroup nearby;
    if (g_aprgOrlanFortress == null || !UnitIsAlive(g_aprgOrlanFortress)) { return; }
    owner = UnitGetOwner(g_aprgOrlanFortress);
    nearby = UnitGroup(
        null, owner, RegionCircle(UnitGetPosition(g_aprgOrlanFortress), 14.0),
        UnitFilter(0, 0, (1 << c_targetFilterStructure) | (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0
    );
    for (i = UnitGroupCount(nearby, c_unitCountAlive); i > 0; i -= 1) {
        scv = UnitGroupUnitFromEnd(nearby, i);
        if (scv == null || !UnitIsAlive(scv) || !StringContains(UnitGetType(scv), "SCV", c_stringAnywhere, c_stringNoCase)) { continue; }
        if (!UnitGroupHasUnit(g_aprgOrlanSCVs, scv)) { UnitGroupAdd(g_aprgOrlanSCVs, scv); }
    }
}

void APRG_SpawnOrlanReplacementSCV() {
    int owner;
    point p;
    unitgroup created;
    unit scv;
    if (g_aprgOrlanFortress == null || !UnitIsAlive(g_aprgOrlanFortress) || !CatalogEntryIsValid(c_gameCatalogUnit, "SCV")) { return; }
    owner = UnitGetOwner(g_aprgOrlanFortress);
    p = APRG_FindGroundPointNear(UnitGetPosition(g_aprgOrlanFortress), 5.0, 8.0);
    if (p == null) { p = UnitGetPosition(g_aprgOrlanFortress); }
    created = UnitCreate(1, "SCV", c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
    APRG_RegisterMutationEnemyGroup(created);
    scv = UnitGroupUnitFromEnd(created, 1);
    if (scv != null) {
        UnitGroupAdd(g_aprgOrlanSCVs, scv);
        UnitIssueOrder(scv, OrderSetAutoCast(AbilityCommand("Repair", 0), true), c_orderQueueReplace);
    }
}

void APRG_TickOrlanFortress(int player, fixed now) {
    int i;
    int weaponIndex;
    int weaponCount;
    int owner;
    int livingSCVs;
    unit scv;
    string weaponType;
    fixed life;
    fixed maximum;
    if (!APRG_PlayerMacroBaseReady(player)) { return; }
    if (!g_aprgOrlanFortressSpawned) { APRG_SpawnOrlanFortress(player); }
    if (g_aprgOrlanFortress == null || !UnitIsAlive(g_aprgOrlanFortress)) { return; }
    owner = UnitGetOwner(g_aprgOrlanFortress);
    APRG_RegisterNearbyOrlanSCVs();
    livingSCVs = UnitGroupCount(g_aprgOrlanSCVs, c_unitCountAlive);
    if (livingSCVs < 20 && (g_aprgNextOrlanSCVReplacementTime < 0.0 || now >= g_aprgNextOrlanSCVReplacementTime)) {
        // Prefer the Planetary Fortress's real SCV train ability when this campaign
        // dependency exposes it. Fall back to a direct replacement spawn if it does not.
        if (!APRG_TryOrlanTrainSCV()) { APRG_SpawnOrlanReplacementSCV(); }
        g_aprgNextOrlanSCVReplacementTime = now + 12.0;
    }
    if (now >= g_aprgNextOrlanRangeTime) {
        weaponCount = UnitWeaponCount(g_aprgOrlanFortress);
        for (weaponIndex = 1; weaponIndex <= weaponCount; weaponIndex += 1) {
            weaponType = UnitWeaponGet(g_aprgOrlanFortress, weaponIndex);
            if (weaponType != "") { CatalogFieldValueModify(c_gameCatalogWeapon, weaponType, "Range", owner, "1.0", c_upgradeOperationAdd); }
        }
        g_aprgNextOrlanRangeTime = now + 30.0;
    }
    life = UnitGetPropertyFixed(g_aprgOrlanFortress, c_unitPropLife, c_unitPropCurrent);
    maximum = UnitGetPropertyFixed(g_aprgOrlanFortress, c_unitPropLifeMax, c_unitPropCurrent);
    for (i = UnitGroupCount(g_aprgOrlanSCVs, c_unitCountAlive); i > 0; i -= 1) {
        scv = UnitGroupUnitFromEnd(g_aprgOrlanSCVs, i);
        if (scv == null || !UnitIsAlive(scv)) { continue; }
        if (life < maximum - 0.5) { UnitIssueOrder(scv, OrderTargetingUnit(AbilityCommand("Repair", 0), g_aprgOrlanFortress), c_orderQueueReplace); }
        else if (DistanceBetweenPoints(UnitGetPosition(scv), UnitGetPosition(g_aprgOrlanFortress)) > 7.0) { UnitIssueOrder(scv, OrderTargetingPoint(AbilityCommand("move", 0), UnitGetPosition(g_aprgOrlanFortress)), c_orderQueueReplace); }
    }
}

string APRG_EnemySpearCasterType() {
    // AP's autonomous caster is the unit the normal player-side Spear support
    // explicitly uses for autonomous effects. Prefer it for the enemy mutation.
    if (CatalogEntryIsValid(c_gameCatalogUnit, "AP_SoAAutonomousCaster")) { return "AP_SoAAutonomousCaster"; }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "AP_SoACaster")) { return "AP_SoACaster"; }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "SoACaster")) { return "SoACaster"; }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "SpearOfAdunCaster")) { return "SpearOfAdunCaster"; }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "VoidSpearofAdun")) { return "VoidSpearofAdun"; }
    return "";
}

string APRG_EnemySpearSecondaryCasterType(string primaryType) {
    if (primaryType != "AP_SoACaster" && CatalogEntryIsValid(c_gameCatalogUnit, "AP_SoACaster")) { return "AP_SoACaster"; }
    if (primaryType != "AP_SoAAutonomousCaster" && CatalogEntryIsValid(c_gameCatalogUnit, "AP_SoAAutonomousCaster")) { return "AP_SoAAutonomousCaster"; }
    if (primaryType != "SoACaster" && CatalogEntryIsValid(c_gameCatalogUnit, "SoACaster")) { return "SoACaster"; }
    if (primaryType != "SpearOfAdunCaster" && CatalogEntryIsValid(c_gameCatalogUnit, "SpearOfAdunCaster")) { return "SpearOfAdunCaster"; }
    return "";
}

void APRG_PrepareEnemySpearCaster(unit caster, int owner) {
    int abilityCount;
    int abilityIndex;
    int commandIndex;
    string abilityType;
    if (caster == null) { return; }
    UnitSetState(caster, c_unitStateInvulnerable, true);
    UnitSetPropertyFixed(caster, c_unitPropEnergyMax, 1000.0);
    UnitSetPropertyFixed(caster, c_unitPropEnergy, 1000.0);
    UnitSetPropertyFixed(caster, c_unitPropEnergyRegen, 20.0);
    abilityCount = MinI(64, UnitAbilityCount(caster));
    for (abilityIndex = 1; abilityIndex <= abilityCount; abilityIndex += 1) {
        abilityType = UnitAbilityGet(caster, abilityIndex);
        if (abilityType == "") { continue; }
        UnitAbilityEnable(caster, abilityType, true);
        for (commandIndex = 0; commandIndex < 4; commandIndex += 1) {
            TechTreeAbilityAllow(owner, AbilityCommand(abilityType, commandIndex), true);
        }
    }
}

void APRG_ApplyEnemyGuardianShellBehavior(unit u) {
    string behavior;
    if (u == null || !UnitIsAlive(u)) { return; }
    behavior = "";
    if (CatalogEntryIsValid(c_gameCatalogBehavior, "GuardianShell")) { behavior = "GuardianShell"; }
    else if (CatalogEntryIsValid(c_gameCatalogBehavior, "SpearOfAdunGuardianShell")) { behavior = "SpearOfAdunGuardianShell"; }
    else if (CatalogEntryIsValid(c_gameCatalogBehavior, "GuardianShellBehavior")) { behavior = "GuardianShellBehavior"; }
    if (behavior != "" && !UnitHasBehavior(u, behavior)) { UnitBehaviorAdd(u, behavior, u, 1); }
}

void APRG_RefreshEnemyGuardianShell(int player) {
    unitgroup enemies;
    int i;
    unit u;
    enemies = APRG_EnemyMobileUnits(player);
    for (i = UnitGroupCount(enemies, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(enemies, i);
        if (u != null) { APRG_ApplyEnemyGuardianShellBehavior(u); }
    }
}

unit APRG_EnemySpearPlayerTarget(int player) {
    unitgroup targets;
    targets = UnitGroup(null, player, RegionPlayableMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    if (UnitGroupCount(targets, c_unitCountAlive) <= 0) { return APRG_FindPlayerHomeStructure(player); }
    return UnitGroupRandomUnit(targets, c_unitCountAlive);
}

unit APRG_EnemySpearFriendlyTarget(int player) {
    unitgroup targets;
    targets = APRG_EnemyMobileUnits(player);
    if (UnitGroupCount(targets, c_unitCountAlive) <= 0) { return null; }
    return UnitGroupRandomUnit(targets, c_unitCountAlive);
}

bool APRG_TryEnemySpearCast(int player, string keyword, bool friendlyTarget) {
    unit target;
    point p;
    if (g_aprgEnemySpearCaster == null || !UnitIsAlive(g_aprgEnemySpearCaster)) { return false; }
    if (friendlyTarget) { target = APRG_EnemySpearFriendlyTarget(player); }
    else { target = APRG_EnemySpearPlayerTarget(player); }
    if (target != null) { p = UnitGetPosition(target); }
    else { p = UnitGetPosition(g_aprgEnemySpearCaster); }
    if (APRG_TryUnitAbilityKeyword(g_aprgEnemySpearCaster, keyword, target, p)) { return true; }
    if (g_aprgEnemySpearSecondaryCaster != null && UnitIsAlive(g_aprgEnemySpearSecondaryCaster)) {
        return APRG_TryUnitAbilityKeyword(g_aprgEnemySpearSecondaryCaster, keyword, target, p);
    }
    return false;
}

bool APRG_TryEnemySpearNormal(int player, int choice) {
    if (choice == 0) { return APRG_TryEnemySpearCast(player, "Orbital", false); }
    if (choice == 1) { return APRG_TryEnemySpearCast(player, "Shield", true); }
    if (choice == 2) { return APRG_TryEnemySpearCast(player, "Lance", false); }
    if (choice == 3) { return APRG_TryEnemySpearCast(player, "Temporal", false); }
    return APRG_TryEnemySpearCast(player, "Fenix", false);
}

bool APRG_TryEnemySpearSpecial(int player, int choice) {
    if (choice == 0) { return APRG_TryEnemySpearCast(player, "Purifier", false); }
    if (choice == 1) { return APRG_TryEnemySpearCast(player, "Bombard", false); }
    return APRG_TryEnemySpearCast(player, "Time", false);
}

void APRG_TickEnemySpear(int player, fixed now) {
    string casterType;
    string secondaryType;
    point p;
    int owner;
    unit anchor;
    unitgroup created;
    if (!APRG_PlayerMacroBaseReady(player) || g_aprgMacroReadyTime < 0.0) { return; }
    if (g_aprgEnemySpearCaster == null || !UnitIsAlive(g_aprgEnemySpearCaster)) {
        casterType = APRG_EnemySpearCasterType();
        if (casterType == "") { return; }
        p = APRG_FindDeepEnemyAirPoint(player);
        if (p == null) { p = RegionRandomPoint(RegionPlayableMap()); }
        anchor = APRG_RandomHostileBaseAnchor(player);
        owner = APRG_FindHostileOwnerNearPoint(player, p);
        if (owner < 0 && anchor != null) { owner = UnitGetOwner(anchor); }
        if (owner < 0) { return; }
        created = UnitCreate(1, casterType, c_unitCreateIgnorePlacement, owner, p, 270.0);
        g_aprgEnemySpearCaster = UnitGroupUnitFromEnd(created, 1);
        if (g_aprgEnemySpearCaster == null) { return; }
        APRG_PrepareEnemySpearCaster(g_aprgEnemySpearCaster, owner);

        secondaryType = APRG_EnemySpearSecondaryCasterType(casterType);
        if (secondaryType != "") {
            created = UnitCreate(1, secondaryType, c_unitCreateIgnorePlacement, owner, p, 270.0);
            g_aprgEnemySpearSecondaryCaster = UnitGroupUnitFromEnd(created, 1);
            APRG_PrepareEnemySpearCaster(g_aprgEnemySpearSecondaryCaster, owner);
        }
        g_aprgNextEnemySpearNormalTime = g_aprgMacroReadyTime + 30.0;
        g_aprgNextEnemySpearSpecialTime = g_aprgMacroReadyTime + 180.0;
        g_aprgNextEnemyGuardianShellRefresh = now;
    }
    if (now >= g_aprgNextEnemyGuardianShellRefresh) {
        APRG_RefreshEnemyGuardianShell(player);
        g_aprgNextEnemyGuardianShellRefresh = now + 5.0;
    }
    if (now >= g_aprgNextEnemySpearSpecialTime) {
        if (APRG_TryEnemySpearSpecial(player, RandomInt(0, 2))) {
            g_aprgNextEnemySpearSpecialTime = now + 180.0;
            g_aprgNextEnemySpearNormalTime = now + 30.0;
        }
        else {
            g_aprgNextEnemySpearSpecialTime = now + 5.0;
        }
        return;
    }
    if (now >= g_aprgNextEnemySpearNormalTime) {
        if (APRG_TryEnemySpearNormal(player, RandomInt(0, 4))) { g_aprgNextEnemySpearNormalTime = now + 30.0; }
        else { g_aprgNextEnemySpearNormalTime = now + 5.0; }
    }
}

unit APRG_RandomEnemyUnitForOwner(int owner) {
    unitgroup targets;
    targets = UnitGroupAlliance(
        owner,
        c_unitAllianceEnemy,
        RegionPlayableMap(),
        UnitFilter(
            0,
            0,
            (1 << c_targetFilterMissile),
            (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))
        ),
        0
    );
    if (UnitGroupCount(targets, c_unitCountAlive) <= 0) { return null; }
    return UnitGroupRandomUnit(targets, c_unitCountAlive);
}

void APRG_RetargetImmortalZergling(fixed now) {
    unit target;
    if (g_aprgImmortalZergling == null || !UnitIsAlive(g_aprgImmortalZergling)) { return; }
    target = APRG_RandomEnemyUnitForOwner(UnitGetOwner(g_aprgImmortalZergling));
    if (target != null) {
        APRG_OrderAttackMove(g_aprgImmortalZergling, UnitGetPosition(target));
    }
    g_aprgNextImmortalZerglingTargetTime = now + 60.0;
}

void APRG_TickImmortalZergling(int player, fixed now) {
    unit anchor;
    point spawnPoint;
    unitgroup created;
    int owner;
    if (!APRG_PlayerMacroBaseReady(player) || g_aprgMacroReadyTime < 0.0) { return; }
    if (g_aprgImmortalZerglingSpawned && (g_aprgImmortalZergling == null || !UnitIsAlive(g_aprgImmortalZergling))) {
        g_aprgImmortalZergling = null;
        g_aprgImmortalZerglingSpawned = false;
        g_aprgNextImmortalZerglingTargetTime = -1.0;
    }
    if (!g_aprgImmortalZerglingSpawned) {
        if (now < g_aprgMacroReadyTime + 60.0) { return; }
        anchor = APRG_RandomPathableHostileBaseAnchor(player);
        if (anchor == null) { return; }
        spawnPoint = APRG_FindGroundPointNear(UnitGetPosition(anchor), 2.0, 10.0);
        if (spawnPoint == null) { return; }
        owner = UnitGetOwner(anchor);
        created = UnitCreate(1, "Zergling", c_unitCreateIgnorePlacement, owner, spawnPoint, RandomFixed(0.0, 360.0));
        g_aprgImmortalZergling = UnitGroupUnitFromEnd(created, 1);
        if (g_aprgImmortalZergling == null) { return; }
        UnitSetState(g_aprgImmortalZergling, c_unitStateInvulnerable, true);
        UnitSetState(g_aprgImmortalZergling, c_unitStateTargetable, false);
        AISetUnitScriptControlled(g_aprgImmortalZergling, true);
        APRG_RegisterMutationEnemyGroup(created);
        g_aprgImmortalZerglingSpawned = true;
        g_aprgNextImmortalZerglingTargetTime = now;
    }
    if (g_aprgImmortalZergling != null && UnitIsAlive(g_aprgImmortalZergling) && now >= g_aprgNextImmortalZerglingTargetTime) {
        APRG_RetargetImmortalZergling(now);
    }
}

void APRG_LoadTestPotionState(int player) {
    if (g_aprgTestPotionBankLoaded || g_aprgTestPotionRunToken <= 0) { return; }
    g_aprgTestPotionBank = BankLoad("SlayTheStarCraftPotions", player);
    g_aprgTestPotionBankLoaded = true;
    if (
        g_aprgTestPotionBank != null &&
        BankKeyExists(g_aprgTestPotionBank, "Consumables", "TestMineralPotionRunToken") &&
        BankValueGetAsInt(g_aprgTestPotionBank, "Consumables", "TestMineralPotionRunToken") == g_aprgTestPotionRunToken
    ) {
        g_aprgTestPotionConsumed = true;
    }
}

void APRG_HideTestPotionUI(int player) {
    if (g_aprgTestPotionDialog != 0) {
        DialogSetVisible(g_aprgTestPotionDialog, PlayerGroupSingle(player), false);
    }
}

bool APRG_TestPotionClick_Func(bool testConds, bool runActions) {
    int player;
    int minerals;
    if (!runActions) { return true; }
    if (EventDialogControl() != g_aprgTestPotionButton || g_aprgTestPotionConsumed) { return true; }
    player = APRG_GetPrimaryPlayer();
    if (player <= 0) { return true; }
    minerals = PlayerGetPropertyInt(player, c_playerPropMinerals);
    PlayerModifyPropertyInt(player, c_playerPropMinerals, c_playerPropOperSetTo, minerals + 1000);
    g_aprgTestPotionConsumed = true;
    if (g_aprgTestPotionBank != null && g_aprgTestPotionRunToken > 0) {
        BankValueSetFromInt(g_aprgTestPotionBank, "Consumables", "TestMineralPotionRunToken", g_aprgTestPotionRunToken);
        BankSave(g_aprgTestPotionBank);
    }
    APRG_HideTestPotionUI(player);
    return true;
}

void APRG_TickTestPotionUI(int player) {
    playergroup players;
    if (player <= 0 || g_aprgTestPotionRunToken <= 0) { return; }
    APRG_LoadTestPotionState(player);
    if (g_aprgTestPotionConsumed) {
        APRG_HideTestPotionUI(player);
        return;
    }
    if (g_aprgTestPotionDialog != 0 && g_aprgTestPotionButton != 0) { return; }
    players = PlayerGroupSingle(player);
    g_aprgTestPotionDialog = DialogCreate(230, 68, c_anchorTop, 0, 8, false);
    DialogSetTransparency(g_aprgTestPotionDialog, 25.0);
    g_aprgTestPotionButton = DialogControlCreate(g_aprgTestPotionDialog, c_triggerControlTypeButton);
    DialogControlSetSize(g_aprgTestPotionButton, players, 218, 54);
    DialogControlSetPosition(g_aprgTestPotionButton, players, c_anchorCenter, 0, 0);
    DialogControlSetPropertyAsText(g_aprgTestPotionButton, c_triggerControlPropertyText, players, StringToText("TEST CONSUMABLE  |  +1000 MINERALS"));
    DialogControlSetPropertyAsText(g_aprgTestPotionButton, c_triggerControlPropertyTooltip, players, StringToText("Single use. Grants 1000 minerals and is then removed."));
    DialogSetVisible(g_aprgTestPotionDialog, players, true);
    g_aprgTestPotionTrigger = TriggerCreate("APRG_TestPotionClick_Func");
    TriggerAddEventDialogControl(g_aprgTestPotionTrigger, player, g_aprgTestPotionButton, c_triggerControlEventTypeClick);
}

// POTIONS ---------------------------------------------------------------------
// Consumable buttons and native target cursor convey state without a second
// on-screen [Slay] message or a persistent informational notice dialog.
string APRG_PotionName(int kind) {
    if (kind == 1) { return "Mineral Reserves"; }
    if (kind == 2) { return "Gas Reserves"; }
    if (kind == 3) { return "Odin in a Bottle"; }
    if (kind == 4) { return "Leviathan in a Bottle"; }
    if (kind == 5) { return "Hyperion in a Bottle"; }
    if (kind == 6) { return "Drop Pod Wave"; }
    if (kind == 7) { return "Mass EMP"; }
    if (kind == 8) { return "Tactical Nuke"; }
    if (kind == 9) { return "Tosh's Miners"; }
    if (kind == 10) { return "Stealth Protocol"; }
    if (kind == 11) { return "Mass Stimpack"; }
    if (kind == 12) { return "Spear of Adun Recharge"; }
    if (kind == 13) { return "Second Kerrigan"; }
    if (kind == 14) { return "Mercenary Favor"; }
    if (kind == 15) { return "Guardian Matrix"; }
    if (kind == 16) { return "Corruption Spores"; }
    if (kind == 17) { return "Mass Marines"; }
    if (kind == 18) { return "Mass Spellcasters"; }
    if (kind == 1901) { return "Spawn 40 Marines"; }
    if (kind == 1902) { return "Spawn 16 Marauders"; }
    if (kind == 1903) { return "Spawn 20 Reapers"; }
    if (kind == 1904) { return "Spawn 20 Hellions"; }
    if (kind == 1905) { return "Spawn 7 Siege Tanks"; }
    if (kind == 1906) { return "Spawn 8 Vikings"; }
    if (kind == 1907) { return "Spawn 8 Banshees"; }
    if (kind == 1908) { return "Spawn 4 Thors"; }
    if (kind == 1909) { return "Spawn 20 Roaches"; }
    if (kind == 1910) { return "Spawn 13 Hydralisks"; }
    if (kind == 1911) { return "Spawn 10 Mutalisks"; }
    if (kind == 1912) { return "Spawn 4 Ultralisks"; }
    if (kind == 1913) { return "Spawn 20 Zealots"; }
    if (kind == 1914) { return "Spawn 11 Stalkers"; }
    if (kind == 1915) { return "Spawn 5 Immortals"; }
    if (kind == 1916) { return "Spawn 5 Void Rays"; }
    if (kind == 1917) { return "Spawn 4 Colossi"; }
    if (kind == 1918) { return "Spawn 10 High Templar"; }
    return "Empty";
}

bool APRG_PotionNeedsTarget(int kind) {
    return kind == 3 || kind == 4 || kind == 5 || kind == 6 || kind == 8 || kind == 9 || kind == 15 || kind == 16 || (kind >= 1901 && kind <= 1918);
}

void APRG_PotionReadBank(int player) {
    int i;
    string serialKey;
    APRG_LoadTestPotionState(player);
    for (i = 0; i < 2; i += 1) {
        if (g_aprgPotionUsed[i] || g_aprgPotionType[i] <= 0 || g_aprgPotionSerial[i] <= 0) { continue; }
        serialKey = "Serial" + IntToString(g_aprgPotionSerial[i]);
        if (g_aprgTestPotionBank != null && BankKeyExists(g_aprgTestPotionBank, "PotionUses", serialKey)
            && BankValueGetAsInt(g_aprgTestPotionBank, "PotionUses", serialKey) == g_aprgTestPotionRunToken) {
            g_aprgPotionUsed[i] = true;
        }
    }
}

void APRG_PotionRefreshButtons(int player) {
    int i;
    string labelText;
    playergroup players = PlayerGroupSingle(player);
    for (i = 0; i < 2; i += 1) {
        if (g_aprgPotionButton[i] == 0) { continue; }
        // Hide empty or consumed slots entirely, instead of showing disabled
        // placeholders that obscure the top of the mission HUD.
        if (g_aprgPotionUsed[i] || g_aprgPotionType[i] <= 0) {
            DialogControlSetVisible(g_aprgPotionButton[i], players, false);
            continue;
        }
        DialogControlSetVisible(g_aprgPotionButton[i], players, !g_aprgPotionMinimized);
        labelText = APRG_PotionName(g_aprgPotionType[i]);
        if (g_aprgPotionPendingSlot == i) { labelText = labelText + "  [TARGETING]"; }
        DialogControlSetPropertyAsText(g_aprgPotionButton[i], c_triggerControlPropertyText, players, StringToText(labelText));
        DialogControlSetPropertyAsText(g_aprgPotionButton[i], c_triggerControlPropertyTooltip, players,
            StringToText("One-time consumable. Targeted consumables use the native StarCraft II cursor; right-click cancels without spending."));
        DialogControlSetEnabled(g_aprgPotionButton[i], players, !g_aprgPotionUsed[i] && g_aprgPotionType[i] > 0);
    }
    if (g_aprgPotionDialog != 0) {
        DialogSetVisible(g_aprgPotionDialog, players,
            (!g_aprgPotionUsed[0] && g_aprgPotionType[0] > 0) ||
            (!g_aprgPotionUsed[1] && g_aprgPotionType[1] > 0));
    }
}

bool APRG_PotionLiveUpdate_Func(bool testConds, bool runActions) {
    int token;
    int i;
    int kind;
    int serial;
    bool changed = false;
    if (!runActions || !g_aprgStarted || g_aprgTestPotionRunToken <= 0) { return true; }
    token = StringToInt(StringWord(EventChatMessage(false), 2));
    if (token != g_aprgTestPotionRunToken) { return true; }
    for (i = 0; i < 2; i += 1) {
        kind = StringToInt(StringWord(EventChatMessage(false), 3 + 2 * i));
        serial = StringToInt(StringWord(EventChatMessage(false), 4 + 2 * i));
        if (kind < 0 || serial < 0) { continue; }
        if (g_aprgPotionSerial[i] == serial && g_aprgPotionType[i] == kind) { continue; }
        g_aprgPotionSerial[i] = serial;
        g_aprgPotionType[i] = kind;
        g_aprgPotionUsed[i] = false;
        changed = true;
    }
    if (changed) {
        if (g_aprgPotionPendingSlot >= 0) {
            g_aprgPotionPendingSlot = -1;
            UISetTargetingOrder(PlayerGroupSingle(APRG_GetPrimaryPlayer()), g_aprgPotionTargetCasterGroup, null, false);
        }
        APRG_PotionReadBank(APRG_GetPrimaryPlayer());
        APRG_PotionRefreshButtons(APRG_GetPrimaryPlayer());
    }
    return true;
}

void APRG_PotionConsume(int player, int slot) {
    string serialKey;
    if (slot < 0 || slot >= 2 || g_aprgPotionUsed[slot]) { return; }
    g_aprgPotionUsed[slot] = true;
    serialKey = "Serial" + IntToString(g_aprgPotionSerial[slot]);
    if (g_aprgTestPotionBank != null && g_aprgPotionSerial[slot] > 0 && g_aprgTestPotionRunToken > 0) {
        BankValueSetFromInt(g_aprgTestPotionBank, "PotionUses", serialKey, g_aprgTestPotionRunToken);
        BankSave(g_aprgTestPotionBank);
    }
    g_aprgPotionPendingSlot = -1;
    APRG_PotionRefreshButtons(player);
}

// Favor uses the owned-mercenary mask communicated by the Python client. This
// does not touch production abilities, stored charges, or ability cooldowns.
string APRG_PotionMercType(int index) {
    if (index == 0) { return "WarPig"; }
    if (index == 1) { return "DevilDog"; }
    if (index == 2) { return "HammerSecurity"; }
    if (index == 3) { return "SpartanCompany"; }
    if (index == 4) { return "SiegeBreaker"; }
    if (index == 5) { return "HelsAngelFighter"; }
    if (index == 6) { return "DuskWing"; }
    if (index == 7) { return APRG_JacksonsRevengeType(); }
    if (index == 8) { return "SkibisAngel"; }
    if (index == 9) { return "DeathHead"; }
    if (index == 10) { return "WingedNightmare"; }
    if (index == 11) { return "MidnightRider"; }
    if (index == 12) { return "Brynhild"; }
    if (index == 13) { return "Jotun"; }
    if (index == 14) { return "DevouringOne"; }
    if (index == 15) { return "HunterKiller"; }
    if (index == 16) { return "Torrasque"; }
    if (index == 17) { return "CausticHorror"; }
    if (index == 18) { return "Yggdrasil"; }
    if (index == 19) { return "InfestedSiegeBreaker"; }
    if (index == 20) { return "InfestedDuskWing"; }
    return "";
}

// Potion recharges only the Spear energy pool. Do not touch ability or
// player cooldown links: those belong to their native SC2 gameplay timers.
void APRG_PotionRechargeSpearCaster(unit caster, int player) {
    if (caster == null || !UnitIsAlive(caster)) { return; }
    UnitSetPropertyFixed(caster, c_unitPropEnergy,
        UnitGetPropertyFixed(caster, c_unitPropEnergyMax, c_unitPropCurrent));
}

// Spawn a proper *squad* for each unlocked mercenary type. The normal
// train/call-down InfoArray.Count is often 1 even for weak squads; unlike a
// production command, Favor should grant the whole group. Read the original
// mercenary ID before AP variant substitution, which can rename the unit.
int APRG_PotionMercSquadCount(int player, string mercUnitType) {
    if (mercUnitType == "WarPig") { return 4; }
    if (mercUnitType == "DevilDog") { return 2; }
    if (mercUnitType == "HammerSecurity") { return 2; }
    if (mercUnitType == "SpartanCompany") { return 2; }
    if (mercUnitType == "SiegeBreaker") { return 1; }
    if (mercUnitType == "HelsAngelFighter") { return 2; }
    if (mercUnitType == "DuskWing") { return 2; }
    if (mercUnitType == "SkibisAngel") { return 2; }
    if (mercUnitType == "DeathHead") { return 3; }
    if (mercUnitType == "WingedNightmare") { return 2; }
    if (mercUnitType == "MidnightRider") { return 2; }
    if (mercUnitType == "Brynhild") { return 2; }
    if (mercUnitType == "DevouringOne") { return 4; }
    if (mercUnitType == "HunterKiller") { return 3; }
    if (mercUnitType == "CausticHorror") { return 2; }
    if (mercUnitType == "InfestedDuskWing") { return 2; }
    // Jotun, Jackson's Revenge, Wise Old Torrasque, Yggdrasil and
    // infested siege breakers are all major single-unit mercenaries.
    return 1;
}

void APRG_PotionRechargeSpear(int player) {
    unit primary;
    unit autonomous;
    primary = APRG_FindSpearCaster(player);
    autonomous = APRG_FindSpearAutonomousCaster(player);
    APRG_PotionRechargeSpearCaster(primary, player);
    if (autonomous != primary) { APRG_PotionRechargeSpearCaster(autonomous, player); }
}

// Wire variants 1901..1918 are one specific named shop roll; never reroll
// at use-time. These links are vanilla player unit identifiers, resolved through
// the same safe player-unit factory used by other Slay mechanics.
string APRG_PotionRandomUnitType(int kind) {
    if (kind == 1901) { return "Marine"; }
    if (kind == 1902) { return "Marauder"; }
    if (kind == 1903) { return "Reaper"; }
    if (kind == 1904) { return "Hellion"; }
    if (kind == 1905) { return "SiegeTank"; }
    if (kind == 1906) { return "VikingFighter"; }
    if (kind == 1907) { return "Banshee"; }
    if (kind == 1908) { return "Thor"; }
    if (kind == 1909) { return "Roach"; }
    if (kind == 1910) { return "Hydralisk"; }
    if (kind == 1911) { return "Mutalisk"; }
    if (kind == 1912) { return "Ultralisk"; }
    if (kind == 1913) { return "Zealot"; }
    if (kind == 1914) { return "Stalker"; }
    if (kind == 1915) { return "Immortal"; }
    if (kind == 1916) { return "VoidRay"; }
    if (kind == 1917) { return "Colossus"; }
    if (kind == 1918) { return "HighTemplar"; }
    return "";
}

int APRG_PotionRandomUnitQuantity(int kind) {
    if (kind == 1901) { return 40; }
    if (kind == 1902) { return 16; }
    if (kind == 1903) { return 20; }
    if (kind == 1904) { return 20; }
    if (kind == 1905) { return 7; }
    if (kind == 1906) { return 8; }
    if (kind == 1907) { return 8; }
    if (kind == 1908) { return 4; }
    if (kind == 1909) { return 20; }
    if (kind == 1910) { return 13; }
    if (kind == 1911) { return 10; }
    if (kind == 1912) { return 4; }
    if (kind == 1913) { return 20; }
    if (kind == 1914) { return 11; }
    if (kind == 1915) { return 5; }
    if (kind == 1916) { return 5; }
    if (kind == 1917) { return 4; }
    if (kind == 1918) { return 10; }
    return 0;
}

// Follow the Specialists blessing's exact campaign-compatibility spellcasters,
// additionally supporting Brood Queen and Medic. These are combat-capable
// allies driven by the standard Slay spellcaster ability AI.
string APRG_PotionSpellcasterType(int roll) {
    if (roll == 0) { return "Ghost"; }
    if (roll == 1) { return "Raven"; }
    if (roll == 2) { return "ScienceVessel"; }
    if (roll == 3) { return "Infestor"; }
    if (roll == 4) { return "DefilerMP"; }
    if (roll == 5) { return "Spectre"; }
    if (roll == 6) { return "Viper"; }
    if (roll == 7) { return "HighTemplar"; }
    if (roll == 8) { return "Sentry"; }
    if (roll == 9) { return "Oracle"; }
    if (roll == 10) { return "BroodQueen"; }
    if (roll == 11) { return "Medic"; }
    if (roll == 12) { return "HighTemplarShakuras"; }
    if (roll == 13) { return "HighTemplarTaldarim"; }
    return "";
}

// A named-unit consumable is controllable. Resolve its native/AP catalog type
// only once per use rather than scanning all train abilities for every unit.
// Use only units that the player's tech tree reports unlocked; the existing
// production resolver checks the player's actual train and warp-train commands.
string APRG_PotionUnlockedUnitType(int kind, int player) {
    string nativeType = APRG_PotionRandomUnitType(kind);
    string apType;
    string preferred = "";
    if (nativeType == "") { return ""; }
    // These are known default War Council AP variants. Prefer them only if
    // they are unlocked *and* still a healthy combat unit in this campaign.
    if (nativeType == "Stalker") { preferred = "AP_StalkerShakuras"; }
    else if (nativeType == "Zealot") { preferred = "AP_ZealotAiur"; }
    else if (nativeType == "Immortal") { preferred = "AP_ImmortalAiur"; }
    else if (nativeType == "VoidRay") { preferred = "AP_VoidRayShakuras"; }
    if (preferred != "" && APRG_PlayerSpawnCandidateHealthy(player, preferred, true) &&
        APRG_PlayerSpawnSameUnitShape(player, nativeType, preferred) &&
        APRG_PlayerSpawnSamePosture(player, nativeType, preferred)) {
        return preferred;
    }
    // If another variant was actually unlocked, prefer it over a native unit.
    apType = APRG_FindPlayerAPProductionVariant(player, nativeType);
    if (apType != "" && APRG_PlayerSpawnCandidateHealthy(player, apType, true)) { return apType; }
    if (APRG_PlayerSpawnCandidateHealthy(player, nativeType, false)) { return nativeType; }
    return "";
}

bool APRG_PotionStartSpawnQueue(int kind, int quantity, point p, fixed now) {
    int i;
    if (quantity < 1 || p == null) { return false; }
    for (i = 0; i < 2; i += 1) {
        if (g_aprgPotionQueueKind[i] != 0) { continue; }
        if (kind >= 1901 && kind <= 1918) {
            g_aprgPotionQueueResolvedUnitType[i] = APRG_PotionUnlockedUnitType(kind, APRG_GetPrimaryPlayer());
            if (g_aprgPotionQueueResolvedUnitType[i] == "") { return false; }
        } else { g_aprgPotionQueueResolvedUnitType[i] = ""; }
        g_aprgPotionQueueKind[i] = kind;
        g_aprgPotionQueueTotal[i] = quantity;
        g_aprgPotionQueueDone[i] = 0;
        g_aprgPotionQueueStarted[i] = now;
        g_aprgPotionQueuePoint[i] = p;
        return true;
    }
    return false;
}

// Called every 0.1 game seconds. Mass Marines and Mass Spellcasters share
// a global three-spawns-per-tick budget (30/s total, even if both queues run).
// Other spawn consumables retain their existing 20-tick distribution.
void APRG_TickPotionSpawnQueues(int player, fixed now) {
    int slot;
    int kind;
    int expected;
    int count;
    int i;
    int n;
    int active;
    int massBudget;
    unitgroup created;
    unit spawned;
    unit target;
    string unitType;
    point p;
    massBudget = 3;
    for (slot = 0; slot < 2; slot += 1) {
        kind = g_aprgPotionQueueKind[slot];
        if (kind == 0) { continue; }
        if (kind == 17 || kind == 18) {
            // Cumulative 30 per second, divided into three per 0.1s tick.
            // A shared budget prevents two active mass waves from doubling it.
            expected = MinI(g_aprgPotionQueueTotal[slot],
                MaxI(0, FixedToInt((now - g_aprgPotionQueueStarted[slot]) * 30.0) + 3));
            count = MinI(massBudget, expected - g_aprgPotionQueueDone[slot]);
            massBudget -= MaxI(0, count);
        }
        else {
            expected = MinI(g_aprgPotionQueueTotal[slot],
                (MaxI(1, FixedToInt((now - g_aprgPotionQueueStarted[slot]) * 10.0) + 1)
                * g_aprgPotionQueueTotal[slot] + 19) / 20);
            count = MinI(25, expected - g_aprgPotionQueueDone[slot]);
        }
        for (i = 0; i < count; i += 1) {
            unitType = "Marine";
            if (kind == 18) {
                unitType = APRG_PotionSpellcasterType(RandomInt(0, 13));
                if (unitType == "DefilerMP" && !APRG_PlayerSpawnCandidateHealthy(player, "DefilerMP", false)) { unitType = "HighTemplar"; }
                if (!APRG_PlayerSpawnCandidateHealthy(player, unitType, false)) { unitType = "HighTemplar"; }
            }
            else if (kind >= 1901 && kind <= 1918) { unitType = g_aprgPotionQueueResolvedUnitType[slot]; }
            if (unitType == "") { continue; }
            // AP variants sometimes resolve to placeholders on older campaigns;
            // the common player factory applies the known safe substitution rules.
            p = PointWithOffsetPolar(g_aprgPotionQueuePoint[slot], RandomFixed(2.0, 12.0), libNtve_gf_RandomAngle());
            if (!RegionContainsPoint(RegionPlayableMap(), p)) { p = g_aprgPotionQueuePoint[slot]; }
            // Mass waves start inside the player's accessible macro base. Avoid
            // depositing ground spellcasters/Marines across cliffs or impassable
            // terrain while spreading units around the 12-radius arrival area.
            if ((kind == 17 || kind == 18) && !PointPathingPassable(p)) {
                p = g_aprgPotionQueuePoint[slot];
            }
            if (kind == 18) {
                // Exact native Specialists units: AP Infestor aliases can create
                // an Infested Terran instead of an Infestor.
                created = APRG_CreatePlayerUnitsVanillaSafe(1, unitType, player, p, libNtve_gf_RandomAngle());
            } else if (kind >= 1901 && kind <= 1918) {
                // Pre-resolved unlocked AP variant for a *player-controllable* unit.
                created = UnitCreate(1, unitType, c_unitCreateIgnorePlacement, player, p, libNtve_gf_RandomAngle());
                spawned = UnitGroupUnitFromEnd(created, 1);
                if ((spawned == null || !UnitIsAlive(spawned) ||
                    UnitGetPropertyFixed(spawned, c_unitPropLifeMax, c_unitPropCurrent) <= 3.0) &&
                    unitType != APRG_PotionRandomUnitType(kind)) {
                    if (spawned != null) { UnitRemove(spawned); }
                    // A valid but incomplete AP model may return a placeholder.
                    // Fall back to the native combat unit for this same roll.
                    created = UnitCreate(1, APRG_PotionRandomUnitType(kind), c_unitCreateIgnorePlacement,
                        player, p, libNtve_gf_RandomAngle());
                }
            } else {
                created = APRG_CreatePlayerUnitsAtPoint(1, unitType, player, p, libNtve_gf_RandomAngle());
            }
            spawned = UnitGroupUnitFromEnd(created, 1);
            if (spawned == null || !UnitIsAlive(spawned)) { continue; }
            APRG_StripVoidEntityBehavior(spawned);
            if (kind == 18) {
                UnitSetPropertyFixed(spawned, c_unitPropEnergy,
                    UnitGetPropertyFixed(spawned, c_unitPropEnergyMax, c_unitPropCurrent));
            }
            UnitSetState(spawned, c_unitStateUsingSupply, false);
            if (kind == 17 || kind == 18) {
                // Only Mass Marines/Spellcasters are uncontrollable autopatrol
                // waves. All named-unit consumables remain under player control.
                APRG_MakeGroupUncommandable(created);
                UnitGroupAdd(g_aprgPotionAutoUnits, spawned);
                if (kind == 18) { UnitGroupAdd(g_aprgPotionAutoSpellcasters, spawned); }
                target = APRG_NearestPathableEnemyStructure(spawned, player);
                if (target == null) { target = APRG_NearestEligibleEnemyMobileUnit(UnitGetPosition(spawned), player); }
                if (target != null) { APRG_OrderAttackMove(spawned, UnitGetPosition(target)); }
            }
        }
        // Advance even if some unit links are invalid, to avoid an infinite
        // queue when a campaign mod does not contain a particular unit.
        g_aprgPotionQueueDone[slot] += count;
        if (g_aprgPotionQueueDone[slot] >= g_aprgPotionQueueTotal[slot]) {
            g_aprgPotionQueueKind[slot] = 0;
            g_aprgPotionQueueResolvedUnitType[slot] = "";
        }
    }
    // Retarget idle units and run the same cooldown-safe friendly spellcasting AI
    // used by existing boons. Cap per-tick work to avoid scanning huge armies.
    active = UnitGroupCount(g_aprgPotionAutoUnits, c_unitCountAlive);
    if (active <= 0) { g_aprgPotionAutoCursor = 0; return; }
    for (n = 0; n < 6 && n < active; n += 1) {
        i = ((g_aprgPotionAutoCursor + n) % active) + 1;
        spawned = UnitGroupUnitFromEnd(g_aprgPotionAutoUnits, i);
        if (spawned == null || !UnitIsAlive(spawned)) { continue; }
        if (UnitGroupHasUnit(g_aprgPotionAutoSpellcasters, spawned)) {
            APRG_TryFriendlyAutonomousAbility(spawned, player);
        }
        if (UnitOrderCount(spawned) > 0) { continue; }
        target = APRG_NearestPathableEnemyStructure(spawned, player);
        if (target == null) { target = APRG_NearestEligibleEnemyMobileUnit(UnitGetPosition(spawned), player); }
        if (target != null) { APRG_OrderAttackMove(spawned, UnitGetPosition(target)); }
    }
    g_aprgPotionAutoCursor = (g_aprgPotionAutoCursor + n) % active;
}

bool APRG_PotionActivate(int player, int kind, point location, unit target) {
    int i;
    int mercSpawned = 0;
    int resourcePerUnit;
    unit u;
    unitgroup group;
    unitgroup created;
    unit home;
    unit contractBuilding;
    unit mercUnit;
    int mercIndex;
    string resolvedMercType;
    unit spearPrimary;
    unit spearAutonomous;
    point p;
    string unitType;
    fixed shieldMax;
    if (kind == 1 || kind == 2) {
        if (kind == 1) { PlayerModifyPropertyInt(player, c_playerPropMinerals, c_playerPropOperAdd, 1000); }
        else { PlayerModifyPropertyInt(player, c_playerPropVespene, c_playerPropOperAdd, 1000); }
    }
    else if (kind == 3 || kind == 4 || kind == 5) {
        if (location == null) { return false; }
        unitType = "Odin";
        // Reuse the exact boon unit selection. It is known to work in campaign
        // missions; these heroes must be player-owned and player-commandable.
        if (kind == 4) { unitType = APRG_LeviathanBoonType(); }
        if (kind == 5) { unitType = APRG_HyperionBoonType(); }
        if (kind == 5) { APRG_ConfigureHyperionYamato(player); }
        if (unitType == "" || !CatalogEntryIsValid(c_gameCatalogUnit, unitType)) { return false; }
        // Do not pass heroes through generic AP unit-type substitution: the
        // boon uses the *exact* native Leviathan / Hyperion unit type.
        created = UnitCreate(1, unitType, c_unitCreateIgnorePlacement, player, location, 0.0);
        u = UnitGroupUnitFromEnd(created, 1);
        if (u == null || !UnitIsAlive(u)) { return false; }
        APRG_StripVoidEntityBehavior(u);
        if (kind == 4) {
            // Same 60-second native Mutalisk/Brood Lord ability cooldowns as the
            // Leviathan boon. No duplicate periodic scripted unit spawns.
            APRG_NormalizeLeviathanBoon(u, player);
        }
        if (kind == 5) {
            // Same resistance, durability, Yamato cost/cooldown and regeneration
            // normalization as the Hyperion boon, not a separate weaker filter.
            APRG_NormalizeHyperionBoon(u, player);
        }
    }
    else if (kind == 6) {
        if (location == null) { return false; }
        g_aprgPotionDropPoint = location;
        g_aprgPotionDropsLeft = 10;
        g_aprgPotionNextDropTime = GameGetMissionTime();
        APRG_PlayWarfieldVO("054");
    }
    else if (kind == 7) {
        g_aprgPotionDecloakUntil = GameGetMissionTime() + 30.0;
        spearPrimary = APRG_FindSpearCaster(player);
        spearAutonomous = APRG_FindSpearAutonomousCaster(player);
        group = UnitGroup(null, c_playerAny, RegionPlayableMap(),
            UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32))), 0);
        for (i = UnitGroupCount(group, c_unitCountAlive); i > 0; i -= 1) {
            u = UnitGroupUnitFromEnd(group, i);
            if (u == null || !UnitIsAlive(u) || u == spearPrimary || u == spearAutonomous) { continue; }
            UnitSetPropertyFixed(u, c_unitPropShields, 0.0);
            UnitSetPropertyFixed(u, c_unitPropEnergy, 0.0);
            if (!UnitHasBehavior(u, "APRoguePotionDecloak")) {
                UnitBehaviorAdd(u, "APRoguePotionDecloak", u, 1);
                UnitBehaviorSetDuration(u, "APRoguePotionDecloak", 30.0);
            }
        }
    }
    else if (kind == 8) {
        if (location == null || !CatalogEntryIsValid(c_gameCatalogEffect, "NukeDamage")) { return false; }
        PlayerCreateEffectPoint(player, "NukeDamage", location);
    }
    else if (kind == 9) {
        if (location == null || !CatalogEntryIsValid(c_gameCatalogUnit, "CommandCenterFlying")) { return false; }
        created = UnitCreate(1, "CommandCenterFlying", c_unitCreateIgnorePlacement, player, location, 0.0);
        u = UnitGroupUnitFromEnd(created, 1);
        if (u == null) { return false; }
        // A flying command center does not have a transport cargo ability in
        // all campaigns. Deploy the five workers beside it instead of losing
        // the potion or invoking an unsupported cargo order.
        APRG_CreatePlayerUnitsAtPoint(5, "SCV", player, location, 0.0);
    }
    else if (kind == 10) { g_aprgPotionStealthUntil = GameGetMissionTime() + 60.0; }
    else if (kind == 11) { g_aprgPotionStimUntil = GameGetMissionTime() + 60.0; g_aprgPotionStimDrainAt = GameGetMissionTime() + 1.0; }
    else if (kind == 12) {
        if (!APRG_HasProgression(APRG_PROGRESSION_SPEAR)) { return false; }
        if (APRG_FindSpearCaster(player) == null && APRG_FindSpearAutonomousCaster(player) == null) { return false; }
        APRG_PotionRechargeSpear(player);
    }
    else if (kind == 13) {
        if (!APRG_HasProgression(APRG_PROGRESSION_KERRIGAN)) { return false; }
        unitType = APRG_FallbackKerriganType();
        if (unitType == "") { return false; }
        home = APRG_FindPlayerHomeStructure(player);
        if (home == null) { return false; }
        p = APRG_PlayerSafeSpawnPoint(player, UnitGetPosition(home));
        if (p == null) { return false; }
        created = APRG_CreatePlayerUnitsAtPoint(1, unitType, player, p, 0.0);
        if (UnitGroupCount(created, c_unitCountAlive) < 1) { return false; }
    }
    else if (kind == 14) {
        if (g_aprgPotionMercMask == 0) { return false; }
        for (i = 0; i < 21; i += 1) {
            if ((g_aprgPotionMercMask & (1 << i)) == 0) { continue; }
            // Indices 0..13 are Terran; 14..20 are Zerg. Spawn each family at
            // its own *living* building, not at the main town hall. No contract
            // structure is recreated just because Favor was used.
            contractBuilding = g_aprgTerranContractStructure;
            if (i >= 14) { contractBuilding = g_aprgZergContractStructure; }
            if (contractBuilding == null || !UnitIsAlive(contractBuilding)) { continue; }
            p = APRG_FindGroundPointNear(UnitGetPosition(contractBuilding), 3.0, 8.0);
            if (p == null) { p = APRG_PlayerSafeSpawnPoint(player, UnitGetPosition(contractBuilding)); }
            if (p == null) { continue; }
            unitType = APRG_PotionMercType(i);
            if (unitType == "") { continue; }
            resolvedMercType = APRG_PlayerSpawnCatalogTypeForPlayer(unitType, player);
            if (!APRG_PlayerSpawnCandidateHealthy(player, resolvedMercType, false) &&
                !APRG_PlayerSpawnCandidateHealthy(player, unitType, false)) { continue; }
            // Use the common player factory with the *native* ID. It chooses
            // owned AP variants, but recovers from incomplete AP placeholder
            // models. Passing the resolved AP name to VanillaSafe lost that
            // fallback entirely, particularly for Zerg mercenaries.
            created = APRG_CreatePlayerUnitsAtPoint(
                APRG_PotionMercSquadCount(player, unitType), unitType, player, p, 0.0);
            for (mercIndex = UnitGroupCount(created, c_unitCountAlive); mercIndex > 0; mercIndex -= 1) {
                mercUnit = UnitGroupUnitFromEnd(created, mercIndex);
                if (mercUnit == null) { continue; }
                APRG_StripVoidEntityBehavior(mercUnit);
                UnitSetState(mercUnit, c_unitStateUsingSupply, false);
                mercSpawned += 1;
            }
        }
        if (mercSpawned == 0) { return false; } // Nothing eligible spawned; keep consumable.
    }
    else if (kind == 15) {
        if (target == null || UnitGetOwner(target) != player || !UnitIsAlive(target)) { return false; }
        shieldMax = UnitGetPropertyFixed(target, c_unitPropShieldsMax, c_unitPropCurrent);
        DataTableSetFixed(true, "APRG_PotionMatrixShieldMax_" + IntToString(UnitGetTag(target)), shieldMax);
        UnitSetPropertyFixed(target, c_unitPropShieldsMax, shieldMax + 2000.0);
        UnitSetPropertyFixed(target, c_unitPropShields,
            UnitGetPropertyFixed(target, c_unitPropShields, c_unitPropCurrent) + 2000.0);
        UnitGroupAdd(g_aprgPotionMatrixTargets, target);
    }
    else if (kind == 16) {
        if (target == null || !UnitIsAlive(target)) { return false; }
        UnitGroupAdd(g_aprgPotionCorruptTargets, target);
    }
    else if (kind == 17 || kind == 18) {
        home = APRG_FindPlayerHomeStructure(player);
        if (home == null) { return false; }
        p = APRG_PlayerSafeSpawnPoint(player, UnitGetPosition(home));
        if (p == null) { return false; }
        i = PlayerGetPropertyInt(player, c_playerPropMinerals);
        if (kind == 18) { i = PlayerGetPropertyInt(player, c_playerPropVespene); }
        i = MinI(5000, MaxI(0, i));
        if (kind == 17 && i < 10) { return false; }
        if (kind == 18 && i < 20) { return false; }
        resourcePerUnit = 10;
        if (kind == 18) { resourcePerUnit = 20; }
        if (!APRG_PotionStartSpawnQueue(kind, i / resourcePerUnit, p, GameGetMissionTime())) { return false; }
        if (kind == 17) { PlayerModifyPropertyInt(player, c_playerPropMinerals, c_playerPropOperSetTo, PlayerGetPropertyInt(player, c_playerPropMinerals) - i); }
        else { PlayerModifyPropertyInt(player, c_playerPropVespene, c_playerPropOperSetTo, PlayerGetPropertyInt(player, c_playerPropVespene) - i); }
    }
    else if (kind >= 1901 && kind <= 1918) {
        if (location == null) { return false; }
        unitType = APRG_PotionRandomUnitType(kind);
        if (unitType == "" || !CatalogEntryIsValid(c_gameCatalogUnit, unitType)) { return false; }
        if (!APRG_PotionStartSpawnQueue(kind, APRG_PotionRandomUnitQuantity(kind), location, GameGetMissionTime())) { return false; }
    }
    else { return false; }
    return true;
}

bool APRG_PotionDamage_Func(bool testConds, bool runActions) {
    unit victim;
    fixed amount;
    if (!runActions || !g_aprgStarted || g_aprgPotionDamageBusy || g_aprgPotionCorruptTargets == null) { return true; }
    victim = EventUnit();
    if (victim == null || !UnitGroupHasUnit(g_aprgPotionCorruptTargets, victim)) { return true; }
    amount = EventUnitDamageAmount();
    if (amount <= 0.0) { return true; }
    g_aprgPotionDamageBusy = true;
    APRG_DealDirectDamage(victim, amount);
    g_aprgPotionDamageBusy = false;
    return true;
}

// A private potion-targeting actor gives the player the SC2 *native* ability
// targeting cursor without changing selected armies or their command cards.
// Move is a built-in point-or-unit command in all campaign dependencies.
// The order event is intercepted before the dummy walks; actual potion effects
// still run through APRG_PotionActivate and spend only on success.
bool APRG_PotionEnsureNativeCaster(int player) {
    unitgroup spawned;
    if (g_aprgPotionTargetCaster != null && UnitIsAlive(g_aprgPotionTargetCaster)) { return true; }
    if (!CatalogEntryIsValid(c_gameCatalogUnit, "APRoguePotionTargetCaster")) { return false; }
    spawned = UnitCreate(1, "APRoguePotionTargetCaster", c_unitCreateIgnorePlacement, player, Point(0.0, 0.0), 0.0);
    g_aprgPotionTargetCaster = UnitGroupUnitFromEnd(spawned, 1);
    if (g_aprgPotionTargetCaster == null) { return false; }
    // This unit must never count as an army, defend a base or participate in AI.
    UnitSetState(g_aprgPotionTargetCaster, c_unitStateInvulnerable, true);
    UnitSetState(g_aprgPotionTargetCaster, c_unitStateTargetable, false);
    UnitSetState(g_aprgPotionTargetCaster, c_unitStateSelectable, false);
    UnitSetState(g_aprgPotionTargetCaster, c_unitStateHighlightable, false);
    UnitSetState(g_aprgPotionTargetCaster, c_unitStateTooltipable, false);
    g_aprgPotionTargetCasterGroup = UnitGroupEmpty();
    UnitGroupAdd(g_aprgPotionTargetCasterGroup, g_aprgPotionTargetCaster);
    if (g_aprgPotionOrderTrigger == null) {
        g_aprgPotionOrderTrigger = TriggerCreate("APRG_PotionNativeOrder_Func");
        // Galaxy's TriggerAddEventUnitOrder expects a unitref, NOT a unit.
        // Passing the unit variable directly can fail compilation of the whole
        // APRogue library (the three-race critical error). Register all Move
        // orders, then filter EventUnit() to our exact caster in the callback.
        TriggerAddEventUnitOrder(g_aprgPotionOrderTrigger, null, AbilityCommand("move", 0));
    }
    return true;
}

bool APRG_PotionArmNativeTarget(int player) {
    if (!APRG_PotionEnsureNativeCaster(player)) { return false; }
    UISetTargetingOrder(PlayerGroupSingle(player), g_aprgPotionTargetCasterGroup,
        OrderTargetingPoint(AbilityCommand("move", 0), RegionGetCenter(RegionPlayableMap())), false);
    return true;
}

void APRG_PotionEndNativeTarget(int player) {
    UISetTargetingOrder(PlayerGroupSingle(player), g_aprgPotionTargetCasterGroup, null, false);
    if (g_aprgPotionTargetCaster != null && UnitIsAlive(g_aprgPotionTargetCaster)) {
        UnitIssueOrder(g_aprgPotionTargetCaster, Order(AbilityCommand("stop", 0)), c_orderQueueReplace);
    }
}

bool APRG_PotionNativeOrder_Func(bool testConds, bool runActions) {
    order issued;
    point pos;
    unit target;
    int player;
    int slot;
    int kind;
    if (!runActions || g_aprgPotionPendingSlot < 0 || EventUnit() != g_aprgPotionTargetCaster) { return true; }
    player = APRG_GetPrimaryPlayer();
    slot = g_aprgPotionPendingSlot;
    if (slot < 0 || slot >= 2 || g_aprgPotionUsed[slot]) {
        g_aprgPotionPendingSlot = -1;
        APRG_PotionEndNativeTarget(player);
        return true;
    }
    kind = g_aprgPotionType[slot];
    issued = EventUnitOrder();
    target = OrderGetTargetUnit(issued);
    pos = OrderGetTargetPosition(issued);
    if (pos == null || !RegionContainsPoint(RegionPlayableMap(), pos)) {
        APRG_PotionArmNativeTarget(player);
        return true;
    }
    // This is true SC2 unit targeting: do not guess the nearest unit in a
    // three-radius circle. Wrong-side and empty-ground clicks don't spend it.
    if ((kind == 15 || kind == 16) && (target == null || !UnitIsAlive(target) ||
            (kind == 15 && UnitGetOwner(target) != player))) {
        APRG_PotionArmNativeTarget(player);
        return true;
    }
    if (APRG_PotionActivate(player, kind, pos, target)) {
        APRG_PotionConsume(player, slot);
        APRG_PotionEndNativeTarget(player);
    } else {
        APRG_PotionArmNativeTarget(player);
    }
    return true;
}

bool APRG_PotionMinimize_Func(bool testConds, bool runActions) {
    int player;
    playergroup players;
    if (!runActions || EventDialogControl() != g_aprgPotionMinimizeButton || g_aprgPotionDialog == 0) { return true; }
    player = APRG_GetPrimaryPlayer();
    players = PlayerGroupSingle(player);
    g_aprgPotionMinimized = !g_aprgPotionMinimized;
    if (g_aprgPotionMinimized) {
        DialogSetSize(g_aprgPotionDialog, 42, 44);
        DialogControlSetPosition(g_aprgPotionMinimizeButton, players, c_anchorTopLeft, 4, 5);
    }
    else {
        DialogSetSize(g_aprgPotionDialog, 544, 60);
        DialogControlSetPosition(g_aprgPotionMinimizeButton, players, c_anchorTopLeft, 497, 11);
    }
    if (g_aprgPotionMinimized) {
        DialogControlSetPropertyAsText(g_aprgPotionMinimizeButton, c_triggerControlPropertyText, players, StringToText("+"));
        DialogControlSetPropertyAsText(g_aprgPotionMinimizeButton, c_triggerControlPropertyTooltip, players, StringToText("Expand consumables"));
    }
    else {
        DialogControlSetPropertyAsText(g_aprgPotionMinimizeButton, c_triggerControlPropertyText, players, StringToText("-"));
        DialogControlSetPropertyAsText(g_aprgPotionMinimizeButton, c_triggerControlPropertyTooltip, players, StringToText("Minimize consumables"));
    }
    APRG_PotionRefreshButtons(player);
    return true;
}

bool APRG_PotionClick_Func(bool testConds, bool runActions) {
    int player;
    int slot;
    int kind;
    if (!runActions) { return true; }
    player = APRG_GetPrimaryPlayer();
    slot = -1;
    if (EventDialogControl() == g_aprgPotionButton[0]) { slot = 0; }
    if (EventDialogControl() == g_aprgPotionButton[1]) { slot = 1; }
    if (slot < 0 || g_aprgPotionUsed[slot] || g_aprgPotionType[slot] <= 0) { return true; }
    kind = g_aprgPotionType[slot];
    if (APRG_PotionNeedsTarget(kind)) {
        // Native targeting is only armed when a caster is available; a missing
        // mod catalog must never leave the UI stuck or spend the potion.
        if (!APRG_PotionArmNativeTarget(player)) {
            return true;
        }
        g_aprgPotionPendingSlot = slot;
        g_aprgPotionArmedAt = GameGetMissionTime();
        APRG_PotionRefreshButtons(player);
    }
    else if (APRG_PotionActivate(player, kind, null, null)) {
        if (g_aprgPotionPendingSlot >= 0) { APRG_PotionEndNativeTarget(player); }
        APRG_PotionConsume(player, slot);
    }
    return true;
}

bool APRG_PotionCancel_Func(bool testConds, bool runActions) {
    if (!runActions || g_aprgPotionPendingSlot < 0) { return true; }
    g_aprgPotionPendingSlot = -1;
    APRG_PotionEndNativeTarget(APRG_GetPrimaryPlayer());
    APRG_PotionRefreshButtons(APRG_GetPrimaryPlayer());
    return true;
}

void APRG_TickPotionEffects(int player, fixed now) {
    int i;
    unit u;
    unitgroup units;
    point p;
    string key;
    // Native Warfield pods land over ~2 sec, one new pod every 0.2 sec.
    if (g_aprgPotionDropsLeft > 0 && now >= g_aprgPotionNextDropTime) {
        p = PointWithOffsetPolar(g_aprgPotionDropPoint, RandomFixed(0.0, 9.0), libNtve_gf_RandomAngle());
        if (!RegionContainsPoint(RegionPlayableMap(), p)) { p = g_aprgPotionDropPoint; }
        if (!APRG_QueueRealDropPod(APRG_DROP_KIND_WARFIELD_POTION, player, p, null)) { APRG_ResolveWarfieldDrop(player, p); }
        g_aprgPotionDropsLeft -= 1;
        g_aprgPotionNextDropTime = now + 0.2;
    }
    if (g_aprgPotionDecloakUntil > now || g_aprgPotionStealthUntil > now || g_aprgPotionStimUntil > now) {
        units = UnitGroup(null, c_playerAny, RegionPlayableMap(),
            UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32))), 0);
        for (i = UnitGroupCount(units, c_unitCountAlive); i > 0; i -= 1) {
            u = UnitGroupUnitFromEnd(units, i);
            if (u == null || !UnitIsAlive(u)) { continue; }
            if (g_aprgPotionDecloakUntil > now && u != APRG_FindSpearCaster(player) && u != APRG_FindSpearAutonomousCaster(player) && !UnitHasBehavior(u, "APRoguePotionDecloak")) {
                UnitBehaviorAdd(u, "APRoguePotionDecloak", u, 1);
                UnitBehaviorSetDuration(u, "APRoguePotionDecloak", g_aprgPotionDecloakUntil - now);
            }
            if (UnitGetOwner(u) != player) { continue; }
            if (g_aprgPotionStealthUntil > now && !UnitHasBehavior(u, "APRoguePotionStealth")) {
                UnitBehaviorAdd(u, "APRoguePotionStealth", u, 1);
                UnitBehaviorSetDuration(u, "APRoguePotionStealth", g_aprgPotionStealthUntil - now);
            }
            if (g_aprgPotionStimUntil > now && !UnitTypeTestAttribute(UnitGetType(u), c_unitAttributeStructure) && !UnitHasBehavior(u, "APRoguePotionStim")) {
                UnitBehaviorAdd(u, "APRoguePotionStim", u, 1);
                UnitBehaviorSetDuration(u, "APRoguePotionStim", g_aprgPotionStimUntil - now);
            }
            if (g_aprgPotionStimUntil > now && now >= g_aprgPotionStimDrainAt && !UnitTypeTestAttribute(UnitGetType(u), c_unitAttributeStructure)) {
                if (UnitGetPropertyFixed(u, c_unitPropLife, c_unitPropCurrent) <= 1.0) { UnitKill(u); }
                else { UnitSetPropertyFixed(u, c_unitPropLife,
                    UnitGetPropertyFixed(u, c_unitPropLife, c_unitPropCurrent) - 1.0); }
            }
        }
        if (g_aprgPotionStimUntil > now && now >= g_aprgPotionStimDrainAt) { g_aprgPotionStimDrainAt = now + 1.0; }
    }
    if (g_aprgPotionMatrixTargets != null) {
        for (i = UnitGroupCount(g_aprgPotionMatrixTargets, c_unitCountAll); i > 0; i -= 1) {
            u = UnitGroupUnitFromEnd(g_aprgPotionMatrixTargets, i);
            if (u == null || !UnitIsAlive(u)) { UnitGroupRemove(g_aprgPotionMatrixTargets, u); continue; }
            if (UnitGetPropertyFixed(u, c_unitPropShields, c_unitPropCurrent) > 0.0) { continue; }
            key = "APRG_PotionMatrixShieldMax_" + IntToString(UnitGetTag(u));
            UnitSetPropertyFixed(u, c_unitPropShieldsMax, DataTableGetFixed(true, key));
            UnitGroupRemove(g_aprgPotionMatrixTargets, u);
        }
    }
}

void APRG_TickPotions(int player, fixed now) {
    int i;
    playergroup players;
    if (player <= 0 || g_aprgTestPotionRunToken <= 0) { return; }
    APRG_PotionReadBank(player);
    if (g_aprgPotionDialog == 0) {
        players = PlayerGroupSingle(player);
        // Left edge ~15% across a 16:9 SC2 HUD (2133 logical units wide).
        // Keep the controls at the very top, away from the AP chat overlay.
        g_aprgPotionDialog = DialogCreate(544, 60, c_anchorTopLeft, 320, 0, false);
        DialogSetTransparency(g_aprgPotionDialog, 25.0);
        for (i = 0; i < 2; i += 1) {
            g_aprgPotionButton[i] = DialogControlCreate(g_aprgPotionDialog, c_triggerControlTypeButton);
            DialogControlSetSize(g_aprgPotionButton[i], players, 235, 44);
            DialogControlSetPosition(g_aprgPotionButton[i], players, c_anchorTopLeft, 7 + (i * 243), 8);
        }
        g_aprgPotionMinimizeButton = DialogControlCreate(g_aprgPotionDialog, c_triggerControlTypeButton);
        DialogControlSetSize(g_aprgPotionMinimizeButton, players, 34, 34);
        DialogControlSetPosition(g_aprgPotionMinimizeButton, players, c_anchorTopLeft, 497, 11);
        DialogControlSetPropertyAsText(g_aprgPotionMinimizeButton, c_triggerControlPropertyText, players, StringToText("-"));
        DialogControlSetPropertyAsText(g_aprgPotionMinimizeButton, c_triggerControlPropertyTooltip, players,
            StringToText("Minimize consumables"));
        DialogSetVisible(g_aprgPotionDialog, players, true);
        APRG_PotionRefreshButtons(player);
        g_aprgPotionMinimizeTrigger = TriggerCreate("APRG_PotionMinimize_Func");
        TriggerAddEventDialogControl(g_aprgPotionMinimizeTrigger, player, g_aprgPotionMinimizeButton, c_triggerControlEventTypeClick);
        g_aprgPotionClickTrigger = TriggerCreate("APRG_PotionClick_Func");
        for (i = 0; i < 2; i += 1) {
            TriggerAddEventDialogControl(g_aprgPotionClickTrigger, player, g_aprgPotionButton[i], c_triggerControlEventTypeClick);
        }
        // No raw left-click trigger: only a native unit-issued-order event
        // can spend targeted potions. This avoids approximate unit selection.
        g_aprgPotionCancelTrigger = TriggerCreate("APRG_PotionCancel_Func");
        TriggerAddEventMouseClicked(g_aprgPotionCancelTrigger, player, c_mouseButtonRight, true);
        g_aprgPotionDamageTrigger = TriggerCreate("APRG_PotionDamage_Func");
        TriggerAddEventUnitDamaged(g_aprgPotionDamageTrigger, null, c_unitDamageTypeAny, c_unitDamageEither, null);
    }
    APRG_TickPotionEffects(player, now);
}

void APRG_TickAllInEliminationVictory(int player) {
    unitgroup structures;
    if ((g_aprgMissionFlags & APRG_MISSION_FLAG_ALL_IN_ELIMINATION) == 0 || g_aprgAllInVictoryTriggered) { return; }
    structures = APRG_EnemyTargetableStructures(player);
    if (UnitGroupCount(structures, c_unitCountAlive) > 0) {
        g_aprgAllInSawEnemyStructure = true;
        return;
    }
    // Do not instantly win during map initialization; require that Slay has
    // previously observed at least one destroyable hostile structure.
    if (!g_aprgAllInSawEnemyStructure) { return; }
    g_aprgAllInVictoryTriggered = true;
    UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaChat, StringToText("[Slay] All enemy structures destroyed"));
    GameOver(player, c_gameOverVictory, true, false);
}

bool APRG_Tick_Func(bool testConds, bool runActions) {
    int player;
    fixed now;

    if (!runActions || !g_aprgStarted) {
        return true;
    }

    player = APRG_GetPrimaryPlayer();
    now = GameGetMissionTime();
    if (now < g_aprgActivationTime) {
        return true;
    }
    if (!g_aprgEffectsSummaryDisplayed) {
        APRG_DisplayActiveEffects(player);
        g_aprgEffectsSummaryDisplayed = true;
    }

    if ((g_aprgMissionFlags & APRG_MISSION_FLAG_HELLION_RUN_BY) != 0) { APRG_TickHellionRunBy(player, now); }
    if ((g_aprgMissionFlags & APRG_MISSION_FLAG_DIAMONDBACK_WANDERERS) != 0) { APRG_TickDiamondbackWanderers(player, now); }
    if ((g_aprgMissionFlags & APRG_MISSION_FLAG_LEVIATHAN_OUTSIDE_BASE) != 0) { APRG_TickBaseLeviathan(player, now); }
    if ((g_aprgMissionFlags & APRG_MISSION_FLAG_ODIN_DELAYED_ASSAULT) != 0) { APRG_TickDelayedOdin(player, now); }
    if ((g_aprgMissionFlags & APRG_MISSION_FLAG_COMBINED_RAIDS) != 0) { APRG_TickCombinedRaids(player, now); }
    if ((g_aprgMissionFlags & APRG_MISSION_FLAG_BRAKK_PRIMAL_ARMY) != 0) { APRG_TickBrakkArmy(player, now); }
    if ((g_aprgMissionFlags & APRG_MISSION_FLAG_ORLAN_FORTRESS) != 0) { APRG_TickOrlanFortress(player, now); }
    if ((g_aprgMissionFlags & APRG_MISSION_FLAG_TOSH_AND_HIS_BOYS) != 0) { APRG_TickToshAndHisBoys(player, now); }
    // Enemy Spear of Adun is disabled pending a reliable campaign-compatible implementation.

    if ((g_aprgRichMineralsApplied || g_aprgRichVespeneApplied) && now >= g_aprgNextRichResourceRefreshTime) {
        APRG_ApplyRichResources(player, g_aprgRichMineralsApplied, g_aprgRichVespeneApplied);
        g_aprgNextRichResourceRefreshTime = now + 5.0;
    }

    APRG_TickAlwaysVisibleUnits();

    if (!g_aprgEffectsActivated) {
        APRG_ActivateEffects(player);
    }
    APRG_UpdateMacroBaseReady(player);
    APRG_TickPotions(player, now);
    if ((g_aprgMissionFlags & APRG_MISSION_FLAG_IMMORTAL_ZERGLING) != 0) { APRG_TickImmortalZergling(player, now); }
    APRG_HideScvJumpJetsCommandCard(player);
    APRG_EnsureProtossResearchStructures(player);
    APRG_TickAllInEliminationVictory(player);
    APRG_TickPendingDropPods(player, now);
    APRG_TickWarfieldVOQueue(now);
    APRG_TickHeroRegeneration(player, now);
    APRG_TickGeneratedHeroAbilities(player, now);
    APRG_TickGodMode(player);

    if (APRG_HasMutation(APRG_MUT_ENEMY_REGENERATION) && now >= g_aprgNextEnemyRegenerationTime) {
        APRG_ApplyEnemyRegeneration(player);
        g_aprgNextEnemyRegenerationTime = now + 1.0;
    }
    if (
        APRG_HasMutation(APRG_MUT_OCCASIONAL_THOR) &&
        APRG_PlayerMacroBaseReady(player) &&
        now >= g_aprgNextOccasionalThorTime
    ) {
        APRG_ApplyOccasionalEnemyReplacement(player, "Thor");
        g_aprgNextOccasionalThorTime = now + 60.0;
    }
    if (
        APRG_HasMutation(APRG_MUT_OCCASIONAL_ULTRALISK) &&
        APRG_PlayerMacroBaseReady(player) &&
        now >= g_aprgNextOccasionalUltraliskTime
    ) {
        APRG_ApplyOccasionalEnemyReplacement(player, "Ultralisk");
        g_aprgNextOccasionalUltraliskTime = now + 60.0;
    }
    if (
        APRG_HasMutation(APRG_MUT_OCCASIONAL_COLOSSUS) &&
        APRG_PlayerMacroBaseReady(player) &&
        now >= g_aprgNextOccasionalColossusTime
    ) {
        APRG_ApplyOccasionalEnemyReplacement(player, "Colossus");
        g_aprgNextOccasionalColossusTime = now + 60.0;
    }
    if (APRG_HasBlessing(APRG_BLESS_BLINDING_LIGHT)) {
        APRG_ApplyBlindingLight(player);
    }
    if (APRG_HasBlessing(APRG_BLESS_SPECIALISTS)) {
        APRG_GiveSpecialistsIfReady(player);
    }
    if (APRG_HasBlessing(APRG_BLESS_FORTIFICATIONS)) {
        APRG_ApplyFortifications(player);
    }
    if (APRG_HasBlessing(APRG_BLESS_BANELING_STREAM)) {
        APRG_TickBanelingStream(player, now);
    }
    if (APRG_HasBlessing(APRG_BLESS_TYCHUS)) {
        APRG_TickTychus(player, now);
    }
    if (APRG_HasBlessing(APRG_BLESS_ZAGARAS_AID)) {
        APRG_TickZagarasAid(player, now);
    }
    if (APRG_HasBlessing(APRG_BLESS_LOGISTICS)) {
        APRG_ApplyLogistics(player);
    }
    if (APRG_HasExtension(APRG_EXT_BLESS_HORDE_MODE)) {
        APRG_ApplyHordeMode(player);
        APRG_TickHordeLarva(player, now);
    }
    if (
        APRG_HasExtension(APRG_EXT_BLESS_ANOTHER_GORGON) ||
        APRG_HasExtension(APRG_EXT_MUT_ANOTHER_GORGON)
    ) {
        APRG_TickGorgons(player, now);
    }
    if (APRG_HasExtension(APRG_EXT_MUT_BURROWED_ZERGLINGS) && APRG_PlayerMacroBaseReady(player)) {
        APRG_TickBurrowedZerglings(player);
    }
    if (APRG_HasExtension(APRG_EXT_MUT_SNIPER_THOR) && APRG_PlayerMacroBaseReady(player)) {
        APRG_TrySpawnSniperThor(player);
    }
    if (APRG_HasExtension(APRG_EXT_MUT_TOWER_DEFENSE) && APRG_PlayerMacroBaseReady(player)) {
        APRG_TickTowerDefenseProbes(player, now);
        APRG_TryTowerDefense(player, now);
    }
    if (APRG_HasExtension(APRG_EXT_MUT_CLOAKED_NIGHTMARE)) {
        APRG_ApplyCloakedNightmare(player);
    }
    if (APRG_HasExtension(APRG_EXT_BLESS_RAPID_REPAIR)) {
        APRG_ApplyRapidRepair(player);
    }
    if (APRG_HasExtension(APRG_EXT_BLESS_POWER_OVERWHELMING)) {
        APRG_ApplyPowerOverwhelming(player);
    }
    if (APRG_HasExtension(APRG_EXT_BLESS_DRAKKEN_DRILL)) {
        APRG_ApplyDrakkenDrillBlessing(player);
    }
    if (APRG_HasExtension(APRG_EXT_MUT_JETPACKS)) {
        APRG_ApplyJetpacks(player);
    }
    if (APRG_HasExtension(APRG_EXT_BLESS_STEALTH_TUNNELS)) {
        APRG_ApplyStealthTunnels(player);
    }
    if (APRG_HasExtension(APRG_EXT_BLESS_LURKER_DEFENSE)) {
        APRG_GiveLurkerDefenseIfReady(player);
    }
    if (APRG_HasExtension(APRG_EXT_BLESS_COMBAT_WORKERS)) {
        APRG_ApplyCombatWorkers(player);
    }
    if (APRG_HasExtension(APRG_EXT_MUT_RAPID_EVOLUTION) && now >= g_aprgNextEnemyRapidEvolutionTime) {
        APRG_ApplyEnemyRapidEvolution(player);
        g_aprgNextEnemyRapidEvolutionTime = now + 5.0;
    }
    if (APRG_HasExtension(APRG_EXT_BLESS_GLASS_CANNONS)) {
        APRG_ApplyGlassCannons(player);
    }
    if (APRG_HasExtension(APRG_EXT_MUT_NO_DEATHS_ALLOWED)) {
        APRG_TickNoDeathsAllowed(player, now);
    }
    if (APRG_HasExtension(APRG_EXT_MUT_VICTORY_TEMPORARY)) {
        APRG_TickEnemyRespawns(now);
    }
    if (APRG_HasExtension(APRG_EXT_BLESS_ODIN)) {
        APRG_GiveOdinIfReady(player);
    }
    if (APRG_HasExtension(APRG_EXT_MUT_TACTICAL_BINOCULARS)) {
        APRG_ApplyTacticalBinoculars(player);
    }
    if (APRG_HasExtension(APRG_EXT_BLESS_BUILDING_OVERCHARGE)) {
        APRG_ApplyBuildingOvercharge(player);
    }
    if (APRG_HasExtension(APRG_EXT_BLESS_GHOST_REPORTING)) {
        APRG_TickGhostReporting(player);
    }
    if (APRG_HasExtension(APRG_EXT_MUT_TALDARIM_REINFORCEMENTS)) {
        APRG_TickTaldarimReinforcements(player, now);
    }
    if (APRG_HasExtension2(APRG_EXT2_MUT_MIRAS_MERCENARIES)) {
        APRG_TickMiraMercenaries(player);
    }
    if (APRG_HasExtension2(APRG_EXT2_BLESS_GLORIOUS_MARTYRS)) {
        APRG_TickGloriousMartyrs();
    }
    if (APRG_HasExtension2(APRG_EXT2_MUT_DOUBLE_TIME)) {
        APRG_ApplyDoubleTime(player);
    }
    if (APRG_HasExtension2(APRG_EXT2_MUT_SHRINKAGE)) {
        APRG_TickShrinkage(player, now);
    }
    if (APRG_HasExtension2(APRG_EXT2_MUT_MINERAL_THIEVES)) {
        APRG_TickMineralThieves(player, now);
    }
    if (APRG_HasExtension2(APRG_EXT2_MUT_ACTIVE_ENEMIES)) {
        APRG_TickActiveEnemies(player, now);
    }
    if (APRG_HasExtension2(APRG_EXT2_MUT_ZAGARAS_BANELINGS)) {
        APRG_TickZagarasBanelings(player, now);
    }
    if (APRG_HasExtension2(APRG_EXT2_BLESS_INFINITE_LARVA)) {
        APRG_TickInfiniteLarva(player, now);
    }
    if (APRG_HasExtension2(APRG_EXT2_MUT_BUDDY_SYSTEM)) { APRG_TickBuddySystem(player, now); }
    if (APRG_HasExtension2(APRG_EXT2_MUT_TORRASQUE)) { APRG_TickTorrasque(player, now); }
    if (APRG_HasExtension2(APRG_EXT2_MUT_NEXUS_SHIELD)) { APRG_TickNexusShield(player); }
    if (APRG_HasExtension2(APRG_EXT2_MUT_RAYNORS_RAIDERS)) { APRG_TickRaynorsRaiders(player, now); }
    if (APRG_HasExtension3(APRG_EXT3_MUT_PURIFIER)) { APRG_TickPurifier(player, now); }
    if (APRG_HasExtension3(APRG_EXT3_MUT_DEHAKAS_PACK)) { APRG_TickDehakasPack(player, now); }
    if (APRG_HasExtension3(APRG_EXT3_MUT_ARGUMENTS)) { APRG_TickArguments(player, now); }
    if (
        APRG_HasExtension2(APRG_EXT2_BOON_DEADLY_WEAPONS) || APRG_HasExtension2(APRG_EXT2_BOON_AUTO_REPAIR) ||
        APRG_HasExtension2(APRG_EXT2_BOON_RAPID_FIRE) ||
        APRG_HasExtension2(APRG_EXT2_BOON_HEAVY_ARMOR) || APRG_HasExtension2(APRG_EXT2_BOON_INTERPLANETARY_FORTRESS) ||
        APRG_HasExtension2(APRG_EXT2_BOON_DEFENDER) || APRG_HasExtension3(APRG_EXT3_BOON_MISSILE_DEFENSE) ||
        APRG_HasBlessing(APRG_BOON_ADAMANTIUM_BLADES)
     ) {
        if (now >= g_aprgNextBoonCombatStatsTime) {
            APRG_ApplyBoonCombatStats(player);
            g_aprgNextBoonCombatStatsTime = now + 2.0;
        }
    }
    if (APRG_HasExtension2(APRG_EXT2_BOON_FIRE_POWER)) { APRG_ApplyFirePower(player); }
    if (APRG_HasExtension2(APRG_EXT2_BOON_UNLIMITED_BLINK)) { APRG_ApplyUnlimitedBlink(player); }
    if (APRG_HasExtension2(APRG_EXT2_BOON_TOXIC_OBSERVATION)) { APRG_TickToxicObservation(player, now); }
    if (APRG_HasExtension2(APRG_EXT2_BOON_CLONING_TECHNOLOGY)) { APRG_RetargetClonedUnits(player, now); }
    if (APRG_HasBlessing(APRG_BOON_ENLARGED_BANELINGS)) { APRG_ApplyEnlargedBanelings(player); }
    if (APRG_HasExtension(APRG_EXT_BOON_VIKING_ANCHORS)) { APRG_ApplyVikingAnchors(player); }
    if (APRG_HasExtension3(APRG_EXT3_BOON_UNLIMITED_POWER)) {
        APRG_ApplyUnlimitedPowerCatalog(player);
        APRG_TickUnlimitedPower(player);
    }
    if (APRG_HasExtension3(APRG_EXT3_BOON_UNSTABLE_COLOSSI)) { APRG_TickUnstableColossi(player); }
    if (APRG_HasExtension3(APRG_EXT3_BOON_ARCHON_CANNONS)) { APRG_TickArchonCannons(now); }
    if (APRG_HasExtension3(APRG_EXT3_BOON_MADDENING_SHADES)) { APRG_TickMaddeningShadeUnits(now); }
    if (APRG_HasExtension3(APRG_EXT3_BOON_CONCUSSED_SHELLS)) { APRG_ApplyConcussedShells(player); }
    APRG_TickOccasionalReplacementRaids(player, now);
    if (APRG_HasExtension4(APRG_EXT4_BLESS_RESOURCE_PICKUPS)) { APRG_TickResourcePickups(player); }
    if (APRG_HasExtension4(APRG_EXT4_MUT_MARAUDER_KILL_TEAMS)) { APRG_TickMarauderKillTeams(player, now); }
    if (APRG_HasExtension4(APRG_EXT4_BOON_PURIFIER_ALLIANCE)) { APRG_TickPurifierAlliance(player, now); }
    APRG_TickDeadManSwitchNukes(player, now);
    APRG_TickGeneratedHeroNoRevive();

    if (APRG_HasMutation(APRG_MUT_DARKNESS)) {
        APRG_ApplyDarkness(player);
    }
    if (APRG_HasMutation(APRG_MUT_ADRENALINE)) {
        APRG_ApplyAdrenaline(player);
    }
    if (APRG_HasMutation(APRG_MUT_PICKY_EATERS)) {
        APRG_ApplyPickyEaters(player);
    }
    if (APRG_HasMutation(APRG_MUT_SQUISHY)) {
        APRG_ApplySquishy(player);
    }
    if (APRG_HasMutation(APRG_MUT_ARMS_RACE) && now >= g_aprgNextArmsRaceTime) {
        APRG_AdvanceArmsRace(player);
        g_aprgNextArmsRaceTime = now + 120.0;
    }

    if (APRG_HasBlessing(APRG_BLESS_INVESTORS)) {
        APRG_GiveInvestorsIfReady(player);
    }
    if (APRG_HasBlessing(APRG_BLESS_MULTI_CLASS)) {
        APRG_GiveMultiClassIfReady(player);
    }
    if (APRG_HasBlessing(APRG_BLESS_JUGGERNAUT)) {
        APRG_ApplyJuggernaut(player);
    }
    if (APRG_HasBlessing(APRG_BLESS_SPEEDY)) {
        APRG_ApplySpeedy(player);
    }
    if (APRG_HasBlessing(APRG_BLESS_GENERAL)) {
        APRG_GiveGeneralIfReady(player);
    }
    if (APRG_HasBlessing(APRG_BLESS_FARSEERS)) {
        APRG_GiveFarseers(player);
    }
    if (APRG_HasBlessing(APRG_BLESS_FIRE_SQUAD)) {
        APRG_GiveFireSquadIfReady(player);
    }
    if (APRG_HasBlessing(APRG_BLESS_FUEL_PIPELINE)) {
        APRG_GiveFuelPipeline(player);
    }
    if (APRG_HasBlessing(APRG_BLESS_TRANSPORTS)) {
        APRG_GiveTransportsIfReady(player);
    }

    if (APRG_HasMutation(APRG_MUT_CONGA_LINE)) {
        APRG_TickConga(player);
    }
    if (
        APRG_HasMutation(APRG_MUT_DESTRUCTION) &&
        APRG_PlayerMacroBaseReady(player) &&
        now >= g_aprgNextDestructionTime
    ) {
        APRG_DestructionPulse(player);
        g_aprgNextDestructionTime = now + 20.0;
    }
    if (APRG_HasMutation(APRG_MUT_GOLDEN_ARMADA) && APRG_PlayerMacroBaseReady(player)) {
        if (!g_aprgGoldenSpawned) {
            APRG_TrySpawnGoldenArmada(player);
        }
        else {
            if (now >= g_aprgNextGoldenRetargetTime) {
                APRG_RetargetGoldenArmada(player);
                g_aprgNextGoldenRetargetTime = now + 20.0;
            }
        }
    }
    if ((g_aprgMissionFlags & APRG_MISSION_FLAG_TRUE_GOLDEN_ARMADA) != 0) {
        APRG_TickTrueGoldenArmada(player, now);
    }
    if ((APRG_HasMutation(APRG_MUT_SIEGE_MODE) || APRG_HasExtension4(APRG_EXT4_MUT_SIEGE_MODE_X5)) && APRG_PlayerMacroBaseReady(player)) {
        APRG_TrySpawnSiegeMode(player);
    }
    if (APRG_HasMutation(APRG_MUT_DRAKKEN_DRILL) && APRG_PlayerMacroBaseReady(player)) {
        APRG_TrySpawnEnemyDrill(player);
        APRG_TickEnemyDrillTargetLimit(now);
    }
    if (APRG_HasMutation(APRG_MUT_DARK_ARCHONS) || APRG_HasExtension4(APRG_EXT4_MUT_DARK_ARCHONS_X5)) {
        APRG_TrySpawnDarkArchons(player);
    }
    if (
        APRG_HasMutation(APRG_MUT_DROP_PODS) &&
        APRG_PlayerMacroBaseReady(player) &&
        g_aprgMacroReadyTime >= 0.0
    ) {
        if (g_aprgNextDropPodTime < g_aprgMacroReadyTime + 120.0) {
            g_aprgNextDropPodTime = g_aprgMacroReadyTime + 120.0;
        }
        if (now >= g_aprgNextDropPodTime) {
            APRG_SpawnDropPodRaid(player);
            g_aprgNextDropPodTime = now + APRG_DropPodRaidNextInterval(now);
        }
    }
    if (
        APRG_HasMutation(APRG_MUT_DARK_TEMPLAR) &&
        APRG_PlayerMacroBaseReady(player) &&
        now >= g_aprgNextDarkTemplarTime
    ) {
        APRG_SpawnDarkTemplarRaid(player);
        g_aprgNextDarkTemplarTime = now + RandomFixed(60.0, 160.0);
    }
    if (APRG_HasMutation(APRG_MUT_FRAGILE_WORKERS)) {
        APRG_ApplyFragileWorkers(player);
    }
    if (APRG_HasMutation(APRG_MUT_DECAY) && now >= g_aprgNextDecayTime) {
        APRG_TickDecay(player, now);
        g_aprgNextDecayTime = now + 1.0;
    }
    if (APRG_HasMutation(APRG_MUT_LIMITED_BANK)) {
        APRG_EnforceLimitedBank(player);
    }
    if (APRG_HasMutation(APRG_MUT_LEVIATHAN) && APRG_PlayerMacroBaseReady(player)) {
        if (g_aprgLeviathanRampStartTime < 0.0) {
            g_aprgLeviathanRampStartTime = now;
            g_aprgNextLeviathanTime = now + APRG_LeviathanNextInterval(now);
        }
        else if (now >= g_aprgNextLeviathanTime) {
            APRG_SpawnLeviathanRaid(player);
            g_aprgNextLeviathanTime = now + APRG_LeviathanNextInterval(now);
        }
    }

    if (APRG_HasMutation(APRG_MUT_HEROES_OF_STORM) && APRG_PlayerMacroBaseReady(player) && g_aprgHostileHeroesSpawned < 3 + g_aprgMissionLayer) {
        APRG_TrySpawnHostileHero(player);
    }
    if (APRG_HasMutation(APRG_MUT_HEROES_OF_STORM)) {
        if (now >= g_aprgNextHeroesOfStormPatrolTime) {
            if (APRG_RepathRandomHeroesOfStormHero()) {
                g_aprgNextHeroesOfStormPatrolTime = now + 60.0;
            }
            else {
                g_aprgNextHeroesOfStormPatrolTime = now + 5.0;
            }
        }
        if (
            (g_aprgMissionFlags & APRG_MISSION_FLAG_TIMED_DEFENSE) != 0 &&
            now >= g_aprgNextHeroesOfStormDefenseAttackTime
        ) {
            if (APRG_SendRandomHeroesOfStormHeroToPlayerBase(player)) {
                g_aprgNextHeroesOfStormDefenseAttackTime = now + 120.0;
            }
            else {
                g_aprgNextHeroesOfStormDefenseAttackTime = now + 5.0;
            }
        }
    }
    if (
        APRG_HasMutation(APRG_MUT_TOO_MANY_WRAITHS) &&
        now >= g_aprgNextWraithTime
    ) {
        APRG_SpawnWraithRaid(player);
        g_aprgNextWraithTime = now + APRG_WraithRaidNextInterval(now);
    }
    if (APRG_HasMutation(APRG_MUT_NOT_ENOUGH_ENERGY)) {
        APRG_EnforceNotEnoughEnergy(player);
    }
    if (APRG_HasMutation(APRG_MUT_VOID_THRASHERS) && APRG_PlayerMacroBaseReady(player)) {
        APRG_TickVoidThrashers(player, now);
        if (g_aprgNextVoidThrasherTime < 0.0) {
            g_aprgNextVoidThrasherTime = g_aprgMacroReadyTime + 180.0;
        }
        else if (now >= g_aprgNextVoidThrasherTime) {
            APRG_SpawnVoidThrasher(player);
            g_aprgNextVoidThrasherTime = now + RandomFixed(120.0, 180.0);
        }
    }
    if (
        APRG_HasMutation(APRG_MUT_VIKING_RAIDS) &&
        APRG_PlayerMacroBaseReady(player) &&
        now >= g_aprgNextVikingRaidTime
    ) {
        APRG_SpawnVikingRaid(player);
        g_aprgNextVikingRaidTime = now + RandomFixed(20.0, 180.0);
    }
    if (APRG_HasMutation(APRG_MUT_NUCLEAR_ANNIHILATION)) {
        APRG_TickNuclearAnnihilation(player, now);
    }

    if (
        APRG_HasBlessing(APRG_BLESS_AIR_SUPPORT) &&
        APRG_PlayerMacroBaseReady(player) &&
        now >= g_aprgNextAirSupportTime
    ) {
        APRG_SpawnAirSupport(player);
        g_aprgNextAirSupportTime = now + 60.0;
    }
    APRG_ReplenishEnemySelendisInterceptors(player);
    if (APRG_HasBlessing(APRG_BLESS_AIR_SUPPORT) || APRG_HasMutation(APRG_MUT_GOLDEN_ARMADA)) {
        APRG_ReplenishAirSupportCarriers();
    }
    if (APRG_HasBlessing(APRG_BLESS_RAPID_EVOLUTION) && now >= g_aprgNextRapidEvolutionTime) {
        APRG_ApplyRapidEvolution(player);
        g_aprgNextRapidEvolutionTime = now + 5.0;
    }
    if (APRG_HasBlessing(APRG_BLESS_COMPOUNDING_INTEREST) && now >= g_aprgNextCompoundTime) {
        APRG_ApplyCompoundingInterest(player);
        g_aprgNextCompoundTime = now + 30.0;
    }
    if (APRG_HasBlessing(APRG_BLESS_LOST_VIKINGS) && now >= g_aprgNextLostVikingTime) {
        APRG_SpawnLostViking(player);
        g_aprgNextLostVikingTime = now + 60.0;
    }
    if (APRG_HasBlessing(APRG_BLESS_WARFIELD_REINFORCEMENTS) && now >= g_aprgNextWarfieldTime) {
        if (APRG_PlayerMacroBaseReady(player)) {
            APRG_SpawnWarfieldReinforcements(player);
            g_aprgNextWarfieldTime = now + 30.0;
        }
        else {
            g_aprgNextWarfieldTime = now + 1.0;
        }
    }
    if (APRG_HasBlessing(APRG_BLESS_ENERGY_OVERLOAD)) {
        APRG_ApplyEnergyOverload(player);
    }
    if (APRG_HasBlessing(APRG_BLESS_ELITE_SOLDIERS)) {
        APRG_ApplyEliteSoldiers(player);
    }

    if (APRG_HasExtension3(APRG_EXT3_MUT_PURIFIER) && g_aprgPurifier != null && UnitIsAlive(g_aprgPurifier)) {
        UnitSetPropertyFixed(g_aprgPurifier, c_unitPropMovementSpeed, 0.25);
    }

    if (now >= g_aprgNextAlliedTargetRotationTime) {
        APRG_RotateAlliedTargetBlacklist();
        g_aprgNextAlliedTargetRotationTime = now + 180.0;
    }
    if (now >= g_aprgNextRaidRetargetTime) {
        APRG_RetargetRaiders(player);
        APRG_RetargetAlliedZombies(player);
        APRG_RetargetAlliedSupport(player);
        APRG_RetargetPurifierAllianceReinforcements(player);
        APRG_RetargetHostilePatrollers();
        g_aprgNextRaidRetargetTime = now + 20.0;
    }
    return true;
}

void APRogue_Init() {
    g_aprgConfigTrigger = TriggerCreate("APRG_Config_Func");
    TriggerAddEventChatMessage(g_aprgConfigTrigger, c_playerAny, "?APRogue", false);
    g_aprgPotionLiveUpdateTrigger = TriggerCreate("APRG_PotionLiveUpdate_Func");
    TriggerAddEventChatMessage(g_aprgPotionLiveUpdateTrigger, c_playerAny, "?SlayConsumables", false);

    g_aprgSpearGateTrigger = TriggerCreate("APRG_SpearGate_Func");
    TriggerAddEventTimePeriodic(g_aprgSpearGateTrigger, 0.125, c_timeGame);

    g_aprgLoadTrigger = TriggerCreate("APRG_Load_Func");
    TriggerAddEventGeneric(g_aprgLoadTrigger, lib5BD4895D_gv_aP_Core_LOAD_FINISHED_EVENT);
}
