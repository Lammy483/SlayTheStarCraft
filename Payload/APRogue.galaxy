string APRG_FindUnusedValidHostileHeroType() {
    int start = RandomInt(0, APRG_HERO_CANDIDATE_COUNT - 1);
    int step;
    string candidate;
    string fallback = "";
    string family;
    for (step = 0; step < APRG_HERO_CANDIDATE_COUNT; step += 1) {
        candidate = APRG_HeroCandidate((start + step) % APRG_HERO_CANDIDATE_COUNT);
        if (candidate == "" || !CatalogEntryIsValid(c_gameCatalogUnit, candidate)) { continue; }
        if (fallback == "") { fallback = candidate; }
        family = APRG_HostileHeroFamilyKey(candidate);
        if (!DataTableGetBool(true, "APRG_HostileHeroFamily_" + family)) { return candidate; }
    }
    return fallback;
}

void APRG_MarkHostileHeroFamilyUsed(string heroType) {
    string family = APRG_HostileHeroFamilyKey(heroType);
    if (family != "") { DataTableSetBool(true, "APRG_HostileHeroFamily_" + family, true); }
}

string APRG_FindValidHeroType() {
    int start = RandomInt(0, APRG_HERO_CANDIDATE_COUNT - 1);
    int step;
    string candidate;
    for (step = 0; step < APRG_HERO_CANDIDATE_COUNT; step += 1) {
        candidate = APRG_HeroCandidate((start + step) % APRG_HERO_CANDIDATE_COUNT);
        if (candidate != "" && CatalogEntryIsValid(c_gameCatalogUnit, candidate)) {
            return candidate;
        }
    }
    return "";
}

string APRG_CommanderFallbackCandidate(int slot) {
    if (slot == 0) { return "RaynorCommando"; }
    if (slot == 1) { return "Swann"; }
    if (slot == 2) { return "Zeratul"; }
    if (slot == 3) { return "ArtanisVoid"; }
    if (slot == 4) { return APRG_AlarakHeroType(); }
    if (slot == 5) { return "Mohandar"; }
    if (slot == 6) { return "Selendis"; }
    if (slot == 7) { return "Karax"; }
    if (slot == 8) { return "Zagara"; }
    if (slot == 9) { return "Dehaka"; }
    if (slot == 10) { return "Nova"; }
    if (slot == 11) { return "Tosh"; }
    if (slot == 12) { return "Stukov"; }
    if (slot == 13) { return "Fenix"; }
    if (slot == 14) { return APRG_VorazunHeroType(); }
    if (slot == 15) { return "Urun"; }
    if (slot == 16) { return "Niadra"; }
    if (slot == 17) { return "Karass"; }
    return "";
}

string APRG_FindValidCommanderHeroType() {
    int start = RandomInt(0, 17);
    int step;
    string candidate;
    for (step = 0; step < 18; step += 1) {
        candidate = APRG_CommanderFallbackCandidate((start + step) % 18);
        if (candidate != "" && CatalogEntryIsValid(c_gameCatalogUnit, candidate)) {
            return candidate;
        }
    }
    return "";
}

string APRG_FindValidHeroTypeFromIndex(int preferredIndex) {
    string candidate;
    if ((preferredIndex == 0 || preferredIndex == 1) && CatalogEntryIsValid(c_gameCatalogUnit, "RaynorCommando")) {
        return "RaynorCommando";
    }
    if (preferredIndex == 6 && CatalogEntryIsValid(c_gameCatalogUnit, "SwannCommando")) {
        return "SwannCommando";
    }
    if (preferredIndex >= 0 && preferredIndex < APRG_HERO_CANDIDATE_COUNT) {
        candidate = APRG_HeroCandidate(preferredIndex);
        if (candidate != "" && CatalogEntryIsValid(c_gameCatalogUnit, candidate)) { return candidate; }
    }
    // Commander fallback is intentionally restricted to the Commander roster.
    // Tychus is a Heroes of the Storm candidate, not a normal Commander roll.
    return APRG_FindValidCommanderHeroType();
}

bool APRG_IsPlayerHeroUnit(unit u, int player) {
    string unitType;
    if (u == null || !UnitIsAlive(u) || UnitGetOwner(u) != player) { return false; }
    unitType = UnitGetType(u);
    if (DataTableGetBool(true, "APRG_NoHeroRegen_" + IntToString(UnitGetTag(u)))) { return false; }
    return UnitTypeTestAttribute(unitType, c_unitAttributeHeroic) ||
        StringContains(unitType, "Tychus", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Odin", c_stringAnywhere, c_stringNoCase);
}

void APRG_TickHeroRegeneration(int player, fixed now) {
    unitgroup units;
    int i;
    unit u;
    fixed current;
    fixed maximum;
    fixed lastHeal;
    fixed healAmount;
    string key;
    if (now < g_aprgNextHeroRegenerationTime) { return; }
    g_aprgNextHeroRegenerationTime = now + 1.0;
    units = APRG_PlayerMobileUnits(player);
    for (i = UnitGroupCount(units, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (!APRG_IsPlayerHeroUnit(u, player)) { continue; }
        key = "APRG_HeroRegen_" + IntToString(UnitGetTag(u));
        lastHeal = DataTableGetFixed(true, key);
        if (lastHeal > 0.0 && now - lastHeal < 1.0) { continue; }
        DataTableSetFixed(true, key, now);
        current = UnitGetPropertyFixed(u, c_unitPropLife, c_unitPropCurrent);
        maximum = UnitGetPropertyFixed(u, c_unitPropLifeMax, c_unitPropCurrent);
        healAmount = 1.0;
        if (StringContains(UnitGetType(u), "Odin", c_stringAnywhere, c_stringNoCase)) { healAmount = 0.5; }
        if (maximum > 0.0 && current < maximum) {
            UnitSetPropertyFixed(u, c_unitPropLife, MinF(maximum, current + healAmount));
        }
    }
}

void APRG_GiveGeneralIfReady(int player) {
    unit base;
    point p;
    string heroType;
    unitgroup created;
    fixed now;
    if (!APRG_PlayerMacroBaseReady(player)) { return; }
    now = GameGetMissionTime();

    if (g_aprgGeneralGiven) {
        if (g_aprgCommanderHero != null && UnitIsAlive(g_aprgCommanderHero)) {
            g_aprgCommanderHeroDeathTime = -1.0;
            return;
        }
        if (g_aprgCommanderHeroType == "") { return; }
        if (g_aprgCommanderHeroDeathTime < 0.0) {
            g_aprgCommanderHeroDeathTime = now;
            return;
        }
        if (now - g_aprgCommanderHeroDeathTime < 60.0) { return; }
        base = APRG_FindPlayerHomeStructure(player);
        if (base == null) { return; }
        p = APRG_FindGroundPointNear(UnitGetPosition(base), 4.0, 9.0);
        if (p == null) { p = UnitGetPosition(base); }
        if (g_aprgCommanderHeroType == "Nova" || g_aprgCommanderHeroType == "RaynorCommando") {
            created = APRG_CreatePlayerUnitsVanillaSafe(1, g_aprgCommanderHeroType, player, p, libNtve_gf_RandomAngle());
        }
        else {
            created = APRG_CreatePlayerUnitsSafe(1, g_aprgCommanderHeroType, player, p, libNtve_gf_RandomAngle());
        }
        g_aprgCommanderHero = UnitGroupUnitFromEnd(created, 1);
        APRG_RegisterGeneratedHeroGroup(created);
        if (g_aprgCommanderHero != null && UnitIsAlive(g_aprgCommanderHero)) {
            UIDisplayMessage(
                PlayerGroupSingle(player), c_messageAreaChat,
                StringToText(APRG_CommanderHeroDisplayName(g_aprgCommanderHeroType) + " has respawned")
            );
        }
        g_aprgCommanderHeroDeathTime = -1.0;
        return;
    }

    base = APRG_FindPlayerHomeStructure(player);
    if (base == null) { return; }
    p = APRG_FindGroundPointNear(UnitGetPosition(base), 4.0, 9.0);
    if (p == null) { return; }
    heroType = APRG_FindValidHeroTypeFromIndex(g_aprgCommanderHeroIndex);
    if (heroType == "") {
        g_aprgGeneralGiven = true;
        return;
    }
    if (heroType == "Nova" || heroType == "RaynorCommando") {
        created = APRG_CreatePlayerUnitsVanillaSafe(1, heroType, player, p, libNtve_gf_RandomAngle());
    }
    else {
        created = APRG_CreatePlayerUnitsSafe(1, heroType, player, p, libNtve_gf_RandomAngle());
    }
    g_aprgCommanderHero = UnitGroupUnitFromEnd(created, 1);
    g_aprgCommanderHeroType = heroType;
    APRG_RegisterGeneratedHeroGroup(created);
    g_aprgGeneralGiven = true;
}

void APRG_GiveFarseers(int player) {
    if (!g_aprgFarseersGiven) {
        g_aprgFarseerRevealer = VisRevealerCreate(player, RegionPlayableMap());
        g_aprgFarseersGiven = true;
        return;
    }
    if (APRG_PlayerMacroBaseReady(player) && !g_aprgFarseersMacroRefreshGiven) {
        g_aprgFarseerRevealer = VisRevealerCreate(player, RegionPlayableMap());
        g_aprgFarseersMacroRefreshGiven = true;
    }
}

void APRG_EnsurePlayerInterceptorCost(int player) {
    int abilityCount;
    int abilityIndex;
    int infoCount;
    int infoIndex;
    int unitCount;
    int unitIndex;
    bool abilityProducesInterceptor;
    string abilityType;
    string basePath;
    string trainedUnitType;
    fixed maxCount;
    if (CatalogEntryIsValid(c_gameCatalogUnit, "Interceptor")) {
        CatalogFieldValueSet(c_gameCatalogUnit, "Interceptor", "CostResource[0]", player, "15");
    }
    abilityCount = CatalogEntryCount(c_gameCatalogAbil);
    for (abilityIndex = 1; abilityIndex <= abilityCount; abilityIndex += 1) {
        abilityType = CatalogEntryGet(c_gameCatalogAbil, abilityIndex);
        if (abilityType == "" || !CatalogEntryIsValid(c_gameCatalogAbil, abilityType)) { continue; }
        abilityProducesInterceptor = false;
        infoCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, "InfoArray", player);
        for (infoIndex = 0; infoIndex < infoCount; infoIndex += 1) {
            basePath = "InfoArray[" + IntToString(infoIndex) + "]";
            trainedUnitType = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, basePath + ".Unit", player);
            if (StringContains(trainedUnitType, "Interceptor", c_stringAnywhere, c_stringNoCase)) {
                abilityProducesInterceptor = true;
            }
            unitCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, basePath + ".Unit", player);
            for (unitIndex = 0; unitIndex < unitCount && !abilityProducesInterceptor; unitIndex += 1) {
                trainedUnitType = CatalogFieldValueGet(
                    c_gameCatalogAbil,
                    abilityType,
                    basePath + ".Unit[" + IntToString(unitIndex) + "]",
                    player
                );
                if (StringContains(trainedUnitType, "Interceptor", c_stringAnywhere, c_stringNoCase)) {
                    abilityProducesInterceptor = true;
                }
            }
            if (!abilityProducesInterceptor) { continue; }
            CatalogFieldValueSet(c_gameCatalogAbil, abilityType, basePath + ".Resource[0]", player, "15");
            CatalogFieldValueSet(c_gameCatalogAbil, abilityType, basePath + ".Cost.Resource[0]", player, "15");
            if (!APRG_HasExtension4(APRG_EXT4_BOON_TRUE_CARRIERS)) {
                CatalogFieldValueSet(c_gameCatalogAbil, abilityType, basePath + ".MaxCount", player, "8");
            }
        }
        if (abilityProducesInterceptor) {
            CatalogFieldValueSet(c_gameCatalogAbil, abilityType, "Cost.Resource[0]", player, "15");
            maxCount = StringToFixed(CatalogFieldValueGet(c_gameCatalogAbil, abilityType, "MaxCount", player));
            if (!APRG_HasExtension4(APRG_EXT4_BOON_TRUE_CARRIERS) && maxCount > 8.0) {
                CatalogFieldValueSet(c_gameCatalogAbil, abilityType, "MaxCount", player, "8");
            }
        }
    }
}

bool APRG_CarrierGetsFreeInterceptors(unit carrier) {
    int player;
    if (carrier == null || !UnitIsAlive(carrier)) { return false; }
    player = APRG_GetPrimaryPlayer();
    if (UnitGetOwner(carrier) != player) { return true; }
    return DataTableGetBool(true, "APRG_Uncommandable_" + IntToString(UnitGetTag(carrier)));
}

bool APRG_IsFriendlyCarrierOwner(int owner, int player) {
    if (owner == player) { return true; }
    if (owner <= 0) { return false; }
    return !libNtve_gf_PlayerIsEnemy(owner, player, libNtve_ge_PlayerRelation_Enemy);
}

bool APRG_InterceptorFamilyType(string unitType) {
    return unitType != "" && StringContains(unitType, "Interceptor", c_stringAnywhere, c_stringNoCase);
}

bool APRG_InterceptorInfoProducesUnit(int player, string abilityType, int infoIndex) {
    string basePath;
    string producedUnit;
    int unitCount;
    int unitIndex;
    if (abilityType == "" || !CatalogEntryIsValid(c_gameCatalogAbil, abilityType) || infoIndex < 0) { return false; }
    basePath = "InfoArray[" + IntToString(infoIndex) + "]";
    producedUnit = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, basePath + ".Unit", player);
    if (APRG_InterceptorFamilyType(producedUnit)) { return true; }
    unitCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, basePath + ".Unit", player);
    for (unitIndex = 0; unitIndex < unitCount; unitIndex += 1) {
        producedUnit = CatalogFieldValueGet(
            c_gameCatalogAbil,
            abilityType,
            basePath + ".Unit[" + IntToString(unitIndex) + "]",
            player
        );
        if (APRG_InterceptorFamilyType(producedUnit)) { return true; }
    }
    return false;
}

void APRG_SetTrueCarrierAbilityCapacity(int owner, string abilityType) {
    int infoCount;
    int infoIndex;
    string basePath;
    string key;
    if (owner <= 0 || abilityType == "" || !CatalogEntryIsValid(c_gameCatalogAbil, abilityType)) { return; }
    key = "APRG_TrueCarrierAbility_" + IntToString(owner) + "_" + abilityType;
    if (DataTableGetBool(true, key)) { return; }
    infoCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, "InfoArray", owner);
    for (infoIndex = 0; infoIndex < infoCount; infoIndex += 1) {
        if (!APRG_InterceptorInfoProducesUnit(owner, abilityType, infoIndex)) { continue; }
        basePath = "InfoArray[" + IntToString(infoIndex) + "]";
        CatalogFieldValueSet(c_gameCatalogAbil, abilityType, basePath + ".MaxCount", owner, "100");
        CatalogFieldValueSet(c_gameCatalogAbil, abilityType, basePath + ".Button.Requirements", owner, "");
        CatalogFieldValueSet(c_gameCatalogAbil, abilityType, "MaxCount", owner, "100");
    }
    DataTableSetBool(true, key, true);
}

void APRG_SetTrueCarrierCapacityForOwner(int owner) {
    unitgroup units;
    unit u;
    int i;
    int abilityCount;
    int abilityIndex;
    string unitType;
    string abilityType;
    if (owner <= 0) { return; }
    units = UnitGroup(
        null, owner, RegionPlayableMap(),
        UnitFilter(0, 0, (1 << c_targetFilterStructure) | (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32))), 0
    );
    for (i = UnitGroupCount(units, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null) { continue; }
        unitType = UnitGetType(u);
        if (!StringContains(unitType, "Carrier", c_stringAnywhere, c_stringNoCase)) { continue; }
        abilityCount = UnitAbilityCount(u);
        for (abilityIndex = 1; abilityIndex <= abilityCount; abilityIndex += 1) {
            abilityType = UnitAbilityGet(u, abilityIndex);
            APRG_SetTrueCarrierAbilityCapacity(owner, abilityType);
        }
    }
}

void APRG_ApplyTrueCarriersToFriendlyOwners(int player) {
    unitgroup carriers;
    unit u;
    int i;
    int owner;
    string unitType;
    if (!APRG_HasExtension4(APRG_EXT4_BOON_TRUE_CARRIERS)) { return; }
    carriers = UnitGroup(
        null, c_playerAny, RegionPlayableMap(),
        UnitFilter(0, 0, (1 << c_targetFilterStructure) | (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0
    );
    for (i = UnitGroupCount(carriers, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(carriers, i);
        if (u == null) { continue; }
        unitType = UnitGetType(u);
        if (!StringContains(unitType, "Carrier", c_stringAnywhere, c_stringNoCase)) { continue; }
        owner = UnitGetOwner(u);
        if (APRG_IsFriendlyCarrierOwner(owner, player)) { APRG_SetTrueCarrierCapacityForOwner(owner); }
    }
}

bool APRG_ArmInterceptorMagazineToCap(unit carrier, int cap) {
    int abilityCount;
    int abilityIndex;
    int infoCount;
    int infoIndex;
    int current;
    int owner;
    string abilityType;
    string basePath;
    if (carrier == null || !UnitIsAlive(carrier) || cap <= 0) { return false; }
    owner = UnitGetOwner(carrier);
    abilityCount = UnitAbilityCount(carrier);
    for (abilityIndex = 1; abilityIndex <= abilityCount; abilityIndex += 1) {
        abilityType = UnitAbilityGet(carrier, abilityIndex);
        if (abilityType == "" || !CatalogEntryIsValid(c_gameCatalogAbil, abilityType)) { continue; }
        infoCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, "InfoArray", owner);
        for (infoIndex = 0; infoIndex < infoCount; infoIndex += 1) {
            if (!APRG_InterceptorInfoProducesUnit(owner, abilityType, infoIndex)) { continue; }
            basePath = "InfoArray[" + IntToString(infoIndex) + "]";
            CatalogFieldValueSet(c_gameCatalogAbil, abilityType, basePath + ".MaxCount", owner, IntToString(cap));
            CatalogFieldValueSet(c_gameCatalogAbil, abilityType, "MaxCount", owner, IntToString(cap));
            current = UnitMagazineCount(carrier, abilityType);
            if (current < cap) {
                UnitMagazineArm(carrier, AbilityCommand(abilityType, infoIndex), cap - current);
            }
            return true;
        }
    }
    return false;
}

void APRG_ReplenishEnemySelendisInterceptors(int player) {
    unitgroup units;
    unit u;
    int i;
    int owner;
    string unitType;
    units = UnitGroup(
        null, c_playerAny, RegionPlayableMap(),
        UnitFilter(0, 0, (1 << c_targetFilterStructure) | (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0
    );
    for (i = UnitGroupCount(units, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null || !UnitIsAlive(u)) { continue; }
        unitType = UnitGetType(u);
        if (!StringContains(unitType, "Selendis", c_stringAnywhere, c_stringNoCase)) { continue; }
        owner = UnitGetOwner(u);
        if (owner <= 0 || !libNtve_gf_PlayerIsEnemy(owner, player, libNtve_ge_PlayerRelation_Enemy)) { continue; }
        APRG_ArmInterceptorMagazineToCap(u, 8);
    }
}

string APRG_AirSupportType(int index) {
    if (index == 0) { return "Scout"; }
    if (index == 1) { return "VoidRay"; }
    if (index == 2) { return "Battlecruiser"; }
    if (index == 3) { return "Carrier"; }
    if (index == 4) { return "Tempest"; }
    if (index == 5) { return "Banshee"; }
    if (index == 6) { return "BroodLord"; }
    if (index == 7) { return "Guardian"; }
    if (index == 8) { return "Mutalisk"; }
    if (index == 9) { return "Mothership"; }
    if (index == 10) { return "Raven"; }
    return "";
}

void APRG_SpawnAirSupport(int player) {
    unit base;
    point p;
    string unitType;
    int attempt;
    unitgroup created;
    unit supportUnit;
    if (!APRG_PlayerMacroBaseReady(player)) {
        return;
    }
    base = APRG_FindPlayerHomeStructure(player);
    if (base == null) {
        return;
    }
    p = PointWithOffsetPolar(UnitGetPosition(base), 6.0, libNtve_gf_RandomAngle());
    for (attempt = 0; attempt < 10; attempt += 1) {
        unitType = APRG_AirSupportType(RandomInt(0, 10));
        if (CatalogEntryIsValid(c_gameCatalogUnit, unitType)) {
            if (unitType == "Scout" || unitType == "Mothership") {
                created = APRG_CreatePlayerUnitsVanillaSafe(1, unitType, player, p, libNtve_gf_RandomAngle());
            }
            else {
                created = APRG_CreatePlayerUnitsSafe(1, unitType, player, p, libNtve_gf_RandomAngle());
            }
            if (unitType == "Raven" && created != null && UnitGroupCount(created, c_unitCountAlive) > 0) {
                supportUnit = UnitGroupUnitFromEnd(created, 1);
                if (supportUnit != null) { UnitSetPropertyFixed(supportUnit, c_unitPropEnergy, UnitGetPropertyFixed(supportUnit, c_unitPropEnergyMax, c_unitPropCurrent)); }
            }
            if (unitType == "Carrier" && created != null && UnitGroupCount(created, c_unitCountAlive) > 0) {
                supportUnit = UnitGroupUnitFromEnd(created, 1);
                if (supportUnit != null) {
                    UnitGroupAdd(g_aprgAirSupportCarriers, supportUnit);
                    APRG_ArmInterceptorMagazineToCap(supportUnit, 8);
                }
            }
            UnitGroupAddUnitGroup(g_aprgAirSupportUnits, created);
            APRG_AddAlliedSupport(created, p, player, true);
            return;
        }
    }
}

void APRG_ReplenishAirSupportCarriers() {
    int i;
    int count;
    int cap;
    int owner;
    int player;
    unit u;
    player = APRG_GetPrimaryPlayer();
    i = UnitGroupCount(g_aprgAirSupportCarriers, c_unitCountAlive);
    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(g_aprgAirSupportCarriers, i);
        if (u == null) { break; }
        if (!APRG_CarrierGetsFreeInterceptors(u)) { continue; }
        owner = UnitGetOwner(u);
        cap = 8;
        if (
            APRG_HasExtension4(APRG_EXT4_BOON_TRUE_CARRIERS) &&
            APRG_IsFriendlyCarrierOwner(owner, player)
        ) {
            APRG_SetTrueCarrierCapacityForOwner(owner);
            cap = 100;
        }
        if (APRG_IsFriendlyCarrierOwner(owner, player) && !APRG_HasExtension4(APRG_EXT4_BOON_TRUE_CARRIERS)) { continue; }
        APRG_ArmInterceptorMagazineToCap(u, cap);
    }
}

void APRG_GiveFireSquadIfReady(int player) {
    point p;
    unit home;
    string colossusType = "";
    if (g_aprgFireSquadGiven || !APRG_PlayerMacroBaseReady(player)) { return; }
    home = APRG_FindPlayerHomeStructure(player);
    if (home == null) { return; }
    p = APRG_PlayerSafeSpawnPoint(player, PointWithOffsetPolar(UnitGetPosition(home), 7.0, libNtve_gf_RandomAngle()));
    if (p == null) { return; }
    APRG_CreatePlayerUnitsSafe(3, "Firebat", player, p, libNtve_gf_RandomAngle());
    APRG_CreatePlayerUnitsSafe(2, "Hellion", player, p, libNtve_gf_RandomAngle());
    if (APRG_PlayerSpawnCandidateHealthy(player, "HellionTank", false)) {
        APRG_CreatePlayerUnitsSafe(2, "HellionTank", player, p, libNtve_gf_RandomAngle());
    }
    else if (APRG_PlayerSpawnCandidateHealthy(player, "Hellbat", false)) {
        APRG_CreatePlayerUnitsSafe(2, "Hellbat", player, p, libNtve_gf_RandomAngle());
    }
    else {
        APRG_CreatePlayerUnitsSafe(2, "Hellion", player, p, libNtve_gf_RandomAngle());
    }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "ColossusPurifier")) { colossusType = "ColossusPurifier"; }
    else if (CatalogEntryIsValid(c_gameCatalogUnit, "PurifierColossus")) { colossusType = "PurifierColossus"; }
    else if (CatalogEntryIsValid(c_gameCatalogUnit, "Colossus")) { colossusType = "Colossus"; }
    if (colossusType != "") { APRG_CreatePlayerUnitsSafe(1, colossusType, player, p, libNtve_gf_RandomAngle()); }
    g_aprgFireSquadGiven = true;
}

void APRG_GiveFuelPipeline(int player) {
    if (!APRG_PlayerMacroBaseReady(player)) {
        return;
    }
    PlayerModifyPropertyInt(player, c_playerPropVespene, c_playerPropOperSetTo, PlayerGetPropertyInt(player, c_playerPropVespene) + 3);
}

void APRG_ApplyRapidEvolution(int player) {
    unitgroup units;
    int i;
    unit u;
    fixed hp;
    if (!APRG_PlayerMacroBaseReady(player)) { return; }
    units = APRG_PlayerMobileUnits(player);
    i = UnitGroupCount(units, c_unitCountAlive);
    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null) { break; }
        hp = UnitGetPropertyFixed(u, c_unitPropLifeMax, c_unitPropCurrent);
        UnitSetPropertyFixed(u, c_unitPropLifeMax, hp + 1.0);
    }
}

void APRG_ApplyCompoundingInterest(int player) {
    int minerals;
    if (!APRG_PlayerMacroBaseReady(player)) {
        return;
    }
    minerals = PlayerGetPropertyInt(player, c_playerPropMinerals);
    PlayerModifyPropertyInt(player, c_playerPropMinerals, c_playerPropOperSetTo, (minerals * 11) / 10);
}

void APRG_SetTransportLife(unitgroup created, fixed life) {
    int i;
    unit transport;
    if (created == null) { return; }
    for (i = UnitGroupCount(created, c_unitCountAlive); i > 0; i -= 1) {
        transport = UnitGroupUnitFromEnd(created, i);
        if (transport == null) { continue; }
        UnitSetPropertyFixed(transport, c_unitPropLifeMax, life);
        UnitSetPropertyFixed(transport, c_unitPropLife, life);
    }
}

void APRG_EnsureDropperlordTransport(unitgroup created) {
    int i;
    unit transport;
    if (created == null || !CatalogEntryIsValid(c_gameCatalogAbil, "OverlordTransport")) { return; }
    for (i = UnitGroupCount(created, c_unitCountAlive); i > 0; i -= 1) {
        transport = UnitGroupUnitFromEnd(created, i);
        if (transport == null) { continue; }
        if (!UnitAbilityExists(transport, "OverlordTransport")) { UnitAbilityAdd(transport, "OverlordTransport"); }
        UnitAbilityShow(transport, "OverlordTransport", true);
        UnitAbilityEnable(transport, "OverlordTransport", true);
    }
}

void APRG_GiveTransportsIfReady(int player) {
    unit base;
    point p;
    unitgroup created;
    if (g_aprgTransportsGiven || !APRG_PlayerMacroBaseReady(player)) { return; }
    base = APRG_FindPlayerHomeStructure(player);
    if (base == null) { return; }
    p = PointWithOffsetPolar(UnitGetPosition(base), 7.0, libNtve_gf_RandomAngle());

    if (CatalogEntryIsValid(c_gameCatalogUnit, "Hercules")) {
        created = APRG_CreatePlayerUnitsSafe(1, "Hercules", player, p, libNtve_gf_RandomAngle());
        APRG_SetTransportLife(created, 1000.0);
    }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "Medivac")) {
        created = APRG_CreatePlayerUnitsSafe(1, "Medivac", player, p, libNtve_gf_RandomAngle());
        APRG_SetTransportLife(created, 500.0);
    }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "OverlordTransport")) {
        created = APRG_CreatePlayerUnitsSafe(1, "OverlordTransport", player, p, libNtve_gf_RandomAngle());
        APRG_SetTransportLife(created, 500.0);
        APRG_EnsureDropperlordTransport(created);
    }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "WarpPrism")) {
        created = APRG_CreatePlayerUnitsSafe(1, "WarpPrism", player, p, libNtve_gf_RandomAngle());
        APRG_SetTransportLife(created, 500.0);
    }
    g_aprgTransportsGiven = true;
}

void APRG_SpawnLostViking(int player) {
    point p;
    string unitType = "VikingFighter";
    if (!APRG_PlayerMacroBaseReady(player)) {
        return;
    }
    p = RegionRandomPoint(RegionPlayableMap());
    if (p == null) {
        return;
    }
    if (!CatalogEntryIsValid(c_gameCatalogUnit, unitType)) {
        unitType = "Viking";
    }
    if (CatalogEntryIsValid(c_gameCatalogUnit, unitType)) {
        APRG_CreatePlayerUnitsSafe(1, unitType, player, p, libNtve_gf_RandomAngle());
    }
}

void APRG_SpawnWarfieldOmegaCluster(int player, point center) {
    int i;
    point p;
    APRG_PlayWarfieldVO("029");
    for (i = 0; i < 3; i += 1) {
        p = PointWithOffsetPolar(center, RandomFixed(1.0, 4.0), libNtve_gf_RandomAngle());
        if (p == null || !RegionContainsPoint(RegionPlayableMap(), p)) { p = center; }
        if (!APRG_QueueRealDropPod(APRG_DROP_KIND_WARFIELD_OMEGA, player, p, null)) {
            APRG_ResolveWarfieldOmegaDrop(player, p);
        }
    }
}

void APRG_SpawnWarfieldReinforcements(int player) {
    point p;
    int i;
    for (i = 0; i < 2; i += 1) {
        p = APRG_FindAlliedRaidOriginGroundPoint(player);
        if (p == null) { continue; }
        if (RandomInt(1, 100) <= 5) { APRG_SpawnWarfieldOmegaCluster(player, p); continue; }
        if (!APRG_QueueRealDropPod(APRG_DROP_KIND_WARFIELD, player, p, null)) {
            APRG_ResolveWarfieldDrop(player, p);
            g_aprgWarfieldNormalDropCount += 1;
        }
    }
}

void APRG_TickWarfieldBurst(int player, fixed now) {
    return;
}


void APRG_ApplyDarkness(int player) {
    unitgroup units = APRG_PlayerAllUnits(player);
    int i = UnitGroupCount(units, c_unitCountAlive);
    unit u;
    string unitType;
    string key;
    fixed sight;
    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null) { break; }
        unitType = UnitGetType(u);
        key = "APRG_Darkness_" + IntToString(player) + "_" + unitType;
        if (DataTableGetBool(true, key)) { continue; }
        sight = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "Sight", player));
        sight = MaxF(0.0, sight - 4.0);
        CatalogFieldValueSet(c_gameCatalogUnit, unitType, "Sight", player, FixedToString(sight, c_fixedPrecisionAny));
        DataTableSetBool(true, key, true);
    }
}

void APRG_ApplyAdrenaline(int player) {
    unitgroup units = APRG_EnemyAllUnits(player);
    int i = UnitGroupCount(units, c_unitCountAlive);
    unit u;
    int owner;
    string unitType;
    string unitKey;
    fixed speed;
    int weaponIndex;
    int weaponCount;
    string weaponType;
    string weaponKey;
    fixed period;
    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null) { break; }
        owner = UnitGetOwner(u);
        if (owner < 0) { continue; }
        unitType = UnitGetType(u);
        unitKey = "APRG_AdrenalineUnit_" + IntToString(owner) + "_" + unitType;
        if (!DataTableGetBool(true, unitKey)) {
            speed = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "Speed", owner));
            if (speed > 0.0) {
                CatalogFieldValueSet(c_gameCatalogUnit, unitType, "Speed", owner, FixedToString(speed * 1.3, c_fixedPrecisionAny));
            }
            DataTableSetBool(true, unitKey, true);
        }

        weaponCount = UnitWeaponCount(u);
        weaponIndex = 1;
        for (; weaponIndex <= weaponCount; weaponIndex += 1) {
            weaponType = UnitWeaponGet(u, weaponIndex);
            if (weaponType == "") { continue; }
            weaponKey = "APRG_AdrenalineWeapon_" + IntToString(owner) + "_" + weaponType;
            if (DataTableGetBool(true, weaponKey)) { continue; }
            period = StringToFixed(CatalogFieldValueGet(c_gameCatalogWeapon, weaponType, "Period", owner));
            if (period > 0.0) {
                CatalogFieldValueSet(c_gameCatalogWeapon, weaponType, "Period", owner, FixedToString(period / 1.3, c_fixedPrecisionAny));
            }
            DataTableSetBool(true, weaponKey, true);
        }
    }
}

void APRG_ApplyPickyEaters(int player) {
    int count;
    int i;
    string unitType;
    fixed made;
    if (g_aprgPickyCatalogApplied) { return; }

    count = CatalogEntryCount(c_gameCatalogUnit);
    if (count > 4096) { count = 4096; }
    for (i = 1; i <= count; i += 1) {
        unitType = CatalogEntryGet(c_gameCatalogUnit, i);
        if (unitType == "") { continue; }
        made = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "Food", player));
        if (made > 4.0) {
            CatalogFieldValueSet(c_gameCatalogUnit, unitType, "Food", player, "4");
        }
    }
    g_aprgPickyCatalogApplied = true;
}


void APRG_ApplyRisingGasPrices(int player) {
    int count;
    int i;
    string unitType;
    if (g_aprgRisingGasApplied) { return; }

    count = CatalogEntryCount(c_gameCatalogUnit);
    if (count > 4096) { count = 4096; }
    i = 1;
    for (; i <= count; i += 1) {
        unitType = CatalogEntryGet(c_gameCatalogUnit, i);
        if (unitType == "") { continue; }
        libNtve_gf_CatalogFieldValueModifyBasedOnDefaultValue(
            c_gameCatalogUnit,
            unitType,
            "CostResource[" + IntToString(1) + "]",
            player,
            1.5,
            c_upgradeOperationMultiply
        );
    }
    g_aprgRisingGasApplied = true;
}

void APRG_AdvanceArmsRace(int player) {
    unitgroup enemies = APRG_EnemyAllUnits(player);
    int i = UnitGroupCount(enemies, c_unitCountAlive);
    unit u;
    int owner;
    string key;
    string weaponType;
    string effectType;
    int weaponIndex;
    int weaponCount;
    fixed currentAmount;
    fixed priorMultiplier;
    fixed baseEstimate;
    fixed increment;

    g_aprgArmsRaceStacks += 1;

    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(enemies, i);
        if (u == null) { break; }
        owner = UnitGetOwner(u);
        if (owner < 0) { continue; }
        weaponCount = UnitWeaponCount(u);
        weaponIndex = 1;
        for (; weaponIndex <= weaponCount; weaponIndex += 1) {
            weaponType = UnitWeaponGet(u, weaponIndex);
            if (weaponType == "") { continue; }
            effectType = CatalogFieldValueGet(c_gameCatalogWeapon, weaponType, "DisplayEffect", owner);
            if (effectType == "" || !CatalogEntryIsValid(c_gameCatalogEffect, effectType)) { continue; }
            key = "APRG_ArmsDamage_" + IntToString(g_aprgArmsRaceStacks) + "_" + IntToString(owner) + "_" + effectType;
            if (DataTableGetBool(true, key)) { continue; }
            currentAmount = StringToFixed(CatalogFieldValueGet(c_gameCatalogEffect, effectType, "Amount", owner));
            if (currentAmount <= 0.0) { continue; }
            priorMultiplier = 1.0 + (0.1 * (g_aprgArmsRaceStacks - 1));
            baseEstimate = currentAmount / priorMultiplier;
            increment = baseEstimate * 0.1;
            CatalogFieldValueModify(c_gameCatalogEffect, effectType, "Amount", owner, FixedToString(increment, c_fixedPrecisionAny), c_upgradeOperationAdd);
            DataTableSetBool(true, key, true);
        }
    }
}

void APRG_ApplyJuggernaut(int player) {
    unitgroup units = APRG_PlayerMobileUnits(player);
    unitgroup workers = APRG_PlayerWorkers(player);
    int i = UnitGroupCount(units, c_unitCountAlive);
    unit u;
    string unitType;
    string key;
    fixed supply;
    bool isWorker;

    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null) { break; }
        unitType = UnitGetType(u);
        isWorker = UnitGroupHasUnit(workers, u);

        key = "APRG_JuggernautArmor_" + IntToString(player) + "_" + unitType;
        if (!DataTableGetBool(true, key)) {
            supply = DataTableGetFixed(true, "APRG_HordeOriginalSupply_" + IntToString(player) + "_" + unitType);
            if (supply <= 0.0) { supply = UnitTypeGetProperty(unitType, c_unitPropSuppliesUsed); }
            if (supply > 0.0) {
                CatalogFieldValueModify(c_gameCatalogUnit, unitType, "LifeArmor", player, FixedToString(supply, c_fixedPrecisionAny), c_upgradeOperationAdd);
                CatalogFieldValueModify(c_gameCatalogUnit, unitType, "ShieldArmor", player, FixedToString(supply, c_fixedPrecisionAny), c_upgradeOperationAdd);
            }
            DataTableSetBool(true, key, true);
        }

        if (!isWorker && !UnitHasBehavior(u, "APRogueJuggernautSlow")) {
            UnitBehaviorAdd(u, "APRogueJuggernautSlow", u, 1);
        }
    }
}

void APRG_ApplyAssemblyCatalog(int player) {
    int count;
    int i;
    int infoCount;
    int infoIndex;
    string unitType;
    string abilityType;
    string basePath;
    string producedUnit;
    string researchedUpgrade;
    fixed buildTime;
    fixed entryTime;
    if (g_aprgAssemblyCatalogApplied) { return; }

    count = CatalogEntryCount(c_gameCatalogUnit);
    if (count > 4096) { count = 4096; }
    for (i = 1; i <= count; i += 1) {
        unitType = CatalogEntryGet(c_gameCatalogUnit, i);
        if (unitType == "") { continue; }
        buildTime = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "BuildTime", player));
        if (buildTime > 0.0) {
            CatalogFieldValueSet(c_gameCatalogUnit, unitType, "BuildTime", player, FixedToString(buildTime * 0.5, c_fixedPrecisionAny));
        }
    }

    count = CatalogEntryCount(c_gameCatalogAbil);
    if (count > 4096) { count = 4096; }
    for (i = 1; i <= count; i += 1) {
        abilityType = CatalogEntryGet(c_gameCatalogAbil, i);
        if (abilityType == "") { continue; }
        infoCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, "InfoArray", player);
            for (infoIndex = 0; infoIndex < infoCount; infoIndex += 1) {
            basePath = "InfoArray[" + IntToString(infoIndex) + "]";
            producedUnit = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, basePath + ".Unit", player);
            researchedUpgrade = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, basePath + ".Upgrade", player);
            if (producedUnit == "" && researchedUpgrade == "") { continue; }
            entryTime = StringToFixed(CatalogFieldValueGet(c_gameCatalogAbil, abilityType, basePath + ".Time", player));
            if (entryTime > 0.0) {
                CatalogFieldValueSet(c_gameCatalogAbil, abilityType, basePath + ".Time", player, FixedToString(entryTime * 0.5, c_fixedPrecisionAny));
            }
        }
    }
    g_aprgAssemblyCatalogApplied = true;
}

void APRG_ApplyEliteToGroup(int player, unitgroup units, bool allowMovement) {
    int i = UnitGroupCount(units, c_unitCountAlive);
    unit u;
    string unitType;
    string trainedKey;
    fixed value;
    fixed oldMax;
    fixed oldCurrent;
    fixed ratio;
    fixed maxRange;
    fixed weaponRange;
    fixed lifeArmor;
    fixed shieldArmor;
    int wi;
    int wc;
    int stacks;

    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null) { break; }
        if (UnitGroupHasUnit(g_aprgEliteProcessed, u)) { continue; }
        unitType = UnitGetType(u);

        if (allowMovement) {
            trainedKey = "APRG_EliteTrained_" + IntToString(UnitGetTag(u));
            if (!DataTableGetBool(true, trainedKey)) { continue; }
        }

        oldMax = UnitGetPropertyFixed(u, c_unitPropLifeMax, c_unitPropCurrent);
        oldCurrent = UnitGetPropertyFixed(u, c_unitPropLife, c_unitPropCurrent);
        if (oldMax > 0.0) {
            ratio = oldCurrent / oldMax;
            UnitSetPropertyFixed(u, c_unitPropLifeMax, oldMax * 1.15);
            UnitSetPropertyFixed(u, c_unitPropLife, oldMax * 1.15 * ratio);
        }
        oldMax = UnitGetPropertyFixed(u, c_unitPropShieldsMax, c_unitPropCurrent);
        oldCurrent = UnitGetPropertyFixed(u, c_unitPropShields, c_unitPropCurrent);
        if (oldMax > 0.0) {
            ratio = oldCurrent / oldMax;
            UnitSetPropertyFixed(u, c_unitPropShieldsMax, oldMax * 1.15);
            UnitSetPropertyFixed(u, c_unitPropShields, oldMax * 1.15 * ratio);
        }
        oldMax = UnitGetPropertyFixed(u, c_unitPropEnergyMax, c_unitPropCurrent);
        oldCurrent = UnitGetPropertyFixed(u, c_unitPropEnergy, c_unitPropCurrent);
        if (oldMax > 0.0) {
            ratio = oldCurrent / oldMax;
            UnitSetPropertyFixed(u, c_unitPropEnergyMax, oldMax * 1.15);
            UnitSetPropertyFixed(u, c_unitPropEnergy, oldMax * 1.15 * ratio);
        }

        value = UnitGetPropertyFixed(u, c_unitPropLifeRegen, c_unitPropCurrent);
        if (value > 0.0) { UnitSetPropertyFixed(u, c_unitPropLifeRegen, value * 1.15); }
        value = UnitGetPropertyFixed(u, c_unitPropShieldsRegen, c_unitPropCurrent);
        if (value > 0.0) { UnitSetPropertyFixed(u, c_unitPropShieldsRegen, value * 1.15); }
        value = UnitGetPropertyFixed(u, c_unitPropEnergyRegen, c_unitPropCurrent);
        if (value > 0.0) { UnitSetPropertyFixed(u, c_unitPropEnergyRegen, value * 1.15); }

        if (CatalogEntryIsValid(c_gameCatalogBehavior, "APRogueEliteTrainedCore")) {
            UnitBehaviorAdd(u, "APRogueEliteTrainedCore", u, 1);
        }

        maxRange = 0.0;
        wc = UnitWeaponCount(u);
        for (wi = 1; wi <= wc; wi += 1) {
            weaponRange = UnitWeaponRange(u, wi);
            if (weaponRange > maxRange) { maxRange = weaponRange; }
        }
        if (maxRange > 0.0 && CatalogEntryIsValid(c_gameCatalogBehavior, "APRogueEliteRange005")) {
            stacks = MaxI(1, FixedToInt(RoundI(maxRange * 3.0)));
            UnitBehaviorAdd(u, "APRogueEliteRange005", u, stacks);
        }

        lifeArmor = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "LifeArmor", player));
        if (lifeArmor > 0.0 && CatalogEntryIsValid(c_gameCatalogBehavior, "APRogueEliteLifeArmor005")) {
            stacks = MaxI(1, FixedToInt(RoundI(lifeArmor * 3.0)));
            UnitBehaviorAdd(u, "APRogueEliteLifeArmor005", u, stacks);
        }
        shieldArmor = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "ShieldArmor", player));
        if (shieldArmor > 0.0 && CatalogEntryIsValid(c_gameCatalogBehavior, "APRogueEliteShieldArmor005")) {
            stacks = MaxI(1, FixedToInt(RoundI(shieldArmor * 3.0)));
            UnitBehaviorAdd(u, "APRogueEliteShieldArmor005", u, stacks);
        }

        UnitGroupAdd(g_aprgEliteProcessed, u);
    }
}

void APRG_ApplyEliteSoldiers(int player) {
    APRG_ApplyEliteToGroup(player, APRG_PlayerMobileUnits(player), true);
    APRG_ApplyEliteToGroup(player, APRG_PlayerStructures(player), false);
}

void APRG_DealExplosiveArmorDamage(point p, int player, fixed damage, fixed radius) {
    unitgroup enemies;
    int i;
    unit target;
    fixed shields;
    fixed life;
    fixed remaining;
    if (p == null || damage <= 0.0 || radius <= 0.0) { return; }
    enemies = UnitGroupAlliance(player, c_unitAllianceEnemy, RegionCircle(p, radius),
        UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    for (i = UnitGroupCount(enemies, c_unitCountAlive); i > 0; i -= 1) {
        target = UnitGroupUnitFromEnd(enemies, i); if (target == null) { break; }
        remaining = damage;
        shields = UnitGetPropertyFixed(target, c_unitPropShields, c_unitPropCurrent);
        if (shields > 0.0) { if (shields >= remaining) { UnitSetPropertyFixed(target, c_unitPropShields, shields - remaining); remaining = 0.0; } else { UnitSetPropertyFixed(target, c_unitPropShields, 0.0); remaining -= shields; } }
        if (remaining > 0.0) { life = UnitGetPropertyFixed(target, c_unitPropLife, c_unitPropCurrent); if (life <= remaining) { UnitKill(target); } else { UnitSetPropertyFixed(target, c_unitPropLife, life - remaining); } }
    }
}

bool APRG_InstantWorkers_Func(bool testConds, bool runActions) {
    string unitType;
    if (!runActions || !g_aprgStarted || !APRG_HasBlessing(APRG_BLESS_INSTANT_WORKERS)) {
        return true;
    }
    if (EventPlayer() != APRG_GetPrimaryPlayer()) {
        return true;
    }
    unitType = libNtve_gf_TriggeringProgressUnitType();
    if (
        unitType == "SCV" || unitType == "Drone" || unitType == "Probe" ||
        unitType == "AP_SCV" || unitType == "AP_Drone" || unitType == "AP_Probe"
    ) {
        UnitSetProgressComplete(EventUnit(), 1, 100);
    }
    return true;
}

void APRG_SpawnZombie(point p, int owner, bool allied, int player) {
    unitgroup created;
    if (!CatalogEntryIsValid(c_gameCatalogUnit, "InfestedCivilian")) {
        return;
    }
    created = UnitCreate(1, "InfestedCivilian", c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
    if (UnitGroupCount(created, c_unitCountAlive) > 0) {
        DataTableSetBool(true, "APRG_BasicZombie_" + IntToString(UnitGetTag(UnitGroupUnitFromEnd(created, 1))), true);
    }
    if (allied) {
        APRG_AddAlliedZombies(created, player);
    }
    else {
        APRG_AddHostileRaiders(created, p, player);
    }
}

void APRG_QueueEnemyRespawn(unit dead, int player, fixed now) {
    int i;
    int owner;
    string unitType;
    fixed speed;
    if (dead == null || RandomInt(1, 100) > 50) { return; }
    owner = UnitGetOwner(dead);
    if (owner < 0 || !libNtve_gf_PlayerIsEnemy(owner, player, libNtve_ge_PlayerRelation_Enemy)) { return; }
    unitType = UnitGetType(dead);
    if (unitType == "" || !CatalogEntryIsValid(c_gameCatalogUnit, unitType)) { return; }
    if (StringContains(unitType, "Interceptor", c_stringAnywhere, c_stringNoCase)) { return; }
    speed = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "Speed", owner));
    if (speed <= 0.0) { return; }
    for (i = 0; i < APRG_MAX_RESPAWN_QUEUE; i += 1) {
        if (g_aprgRespawnState[i] != 0) { continue; }
        g_aprgRespawnState[i] = 1;
        g_aprgRespawnType[i] = unitType;
        g_aprgRespawnOwner[i] = owner;
        g_aprgRespawnPoint[i] = UnitGetPosition(dead);
        g_aprgRespawnTime[i] = now + 60.0;
        return;
    }
}

bool APRG_IsForAiurZealotType(string unitType) {
    if (unitType == "") { return false; }
    return StringContains(unitType, "Zealot", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Sentinel", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Centurion", c_stringAnywhere, c_stringNoCase);
}

bool APRG_IsReaperBoonType(string unitType) {
    if (unitType == "") { return false; }
    return StringContains(unitType, "Reaper", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "DeathHead", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Death Head", c_stringAnywhere, c_stringNoCase);
}

bool APRG_IsMarineBoonType(string unitType) {
    if (unitType == "") { return false; }
    return StringContains(unitType, "Marine", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "WarPig", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "War Pig", c_stringAnywhere, c_stringNoCase);
}

string APRG_CanonicalProtossReinforcementType(string requested) {
    if (StringContains(requested, "Zealot", c_stringAnywhere, c_stringNoCase) ||
        StringContains(requested, "Sentinel", c_stringAnywhere, c_stringNoCase) ||
        StringContains(requested, "Centurion", c_stringAnywhere, c_stringNoCase)) { return "Zealot"; }
    if (requested == "Stalker") { return "Stalker"; }
    if (requested == "Adept") { return "Adept"; }
    if (requested == "Sentry") { return "Sentry"; }
    if (requested == "HighTemplar") { return "HighTemplar"; }
    if (requested == "DarkTemplar") { return "DarkTemplar"; }
    if (requested == "Immortal") { return "Immortal"; }
    if (requested == "Colossus") { return "Colossus"; }
    if (requested == "Archon") { return "Archon"; }
    if (requested == "Dragoon") { return "Dragoon"; }
    if (requested == "Reaver") { return "Reaver"; }
    if (requested == "Scout") { return "Scout"; }
    if (requested == "Phoenix") { return "Phoenix"; }
    if (requested == "VoidRay") { return "VoidRay"; }
    if (requested == "Carrier") { return "Carrier"; }
    if (requested == "Tempest") { return "Tempest"; }
    if (requested == "Observer") { return "Observer"; }
    if (requested == "WarpPrism") { return "WarpPrism"; }
    if (requested == "Oracle") { return "Oracle"; }
    if (requested == "Arbiter") { return "Arbiter"; }
    return requested;
}

actor APRG_CreateWarpVisual(unit u, point at) {
    actor fx;
    if (u == null || at == null) { return null; }
    // AP's LotV campaign missions attach the actual ProtossGenericWarpInOut
    // model at Ref_Center/Ref_Origin. The previous point-only FastWarpinMarker
    // could exist without ever driving a unit's warp-in visual. Use the shipped
    // model directly so its animated flash is visible alongside the 5s fade.
    if (CatalogEntryIsValid(c_gameCatalogModel, "ProtossGenericWarpInOut")) {
        libNtve_gf_AttachModelToUnit(u, "ProtossGenericWarpInOut", "Ref_Center");
        fx = libNtve_gf_ActorLastCreated();
        if (fx != null) { return fx; }
    }
    // Older campaign dependencies may not contain the generic model.
    return libNtve_gf_CreateActorAtPoint("ProtossFastWarpinMarker", at);
}

bool APRG_QueueAllyWarp(string unitType, int owner, point center, fixed when) {
    int i;
    if (unitType == "" || center == null || owner < 0) { return false; }
    unitType = APRG_CanonicalProtossReinforcementType(unitType);
    for (i = 0; i < 512; i += 1) {
        if (g_aprgAllyWarpState[i] != 0) { continue; }
        g_aprgAllyWarpState[i] = 1;
        g_aprgAllyWarpOwner[i] = owner;
        g_aprgAllyWarpType[i] = unitType;
        g_aprgAllyWarpPoint[i] = center;
        g_aprgAllyWarpTime[i] = when;
        g_aprgAllyWarpActor[i] = null;
        g_aprgAllyWarpUnit[i] = null;
        g_aprgAllyWarpPurifierAlliance[i] = (g_aprgPurifierAlliance != null && UnitIsAlive(g_aprgPurifierAlliance) && owner == UnitGetOwner(g_aprgPurifierAlliance));
        return true;
    }
    return false;
}

void APRG_ProcessAllyWarpQueue(int player, fixed now) {
    int i;
    int best = -1;
    fixed bestTime = 99999999.0;
    point spawnPoint;
    unitgroup created;
    unitgroup ready;
    unit u;
    int j;
    actor mainActor;
    for (i = 0; i < 512; i += 1) {
        if (g_aprgAllyWarpState[i] == 0 || g_aprgAllyWarpTime[i] > now) { continue; }
        if (best < 0 || g_aprgAllyWarpTime[i] < bestTime) {
            best = i;
            bestTime = g_aprgAllyWarpTime[i];
        }
    }
    if (best < 0) { return; }

    if (g_aprgAllyWarpState[best] == 1) {
        spawnPoint = APRG_FindGroundPointNear(g_aprgAllyWarpPoint[best], 1.0, 7.0);
        if (spawnPoint == null) { spawnPoint = g_aprgAllyWarpPoint[best]; }
        g_aprgAllyWarpPoint[best] = spawnPoint;
        if (!CatalogEntryIsValid(c_gameCatalogUnit, g_aprgAllyWarpType[best])) {
            g_aprgAllyWarpState[best] = 0;
            return;
        }
        created = UnitCreate(1, g_aprgAllyWarpType[best], c_unitCreateIgnorePlacement,
            g_aprgAllyWarpOwner[best], spawnPoint, libNtve_gf_RandomAngle());
        if (created == null || UnitGroupCount(created, c_unitCountAlive) <= 0) {
            g_aprgAllyWarpState[best] = 0;
            return;
        }
        u = UnitGroupUnitFromEnd(created, 1);
        if (u == null) { g_aprgAllyWarpState[best] = 0; return; }
        g_aprgAllyWarpUnit[best] = u;
        APRG_MakeGroupUncommandable(created);
        for (j = UnitGroupCount(created, c_unitCountAlive); j > 0; j -= 1) {
            u = UnitGroupUnitFromEnd(created, j);
            if (u != null) {
                UnitSetState(u, c_unitStateUsingSupply, false);
                UnitGroupAdd(g_aprgClonedUnits, u);
            }
        }

        u = g_aprgAllyWarpUnit[best];
        libNtve_gf_PauseUnit(u, true);
        mainActor = libNtve_gf_MainActorofUnit(u);
        if (mainActor != null) {
            ActorSend(mainActor, libNtve_gf_SetOpacity(0.0, 0.0));
            ActorSend(mainActor, libNtve_gf_SetOpacity(1.0, 5.0));
        }
        g_aprgAllyWarpActor[best] = APRG_CreateWarpVisual(u, spawnPoint);
        if (CatalogEntryIsValid(c_gameCatalogBehavior, "ProtossGenericWarpInOut")) {
            UnitBehaviorAdd(u, "ProtossGenericWarpInOut", u, 1);
        }
        g_aprgAllyWarpState[best] = 2;
        g_aprgAllyWarpTime[best] = now + 5.0;
        return;
    }

    u = g_aprgAllyWarpUnit[best];
    if (u != null && UnitIsAlive(u)) {
        if (CatalogEntryIsValid(c_gameCatalogBehavior, "ProtossGenericWarpInOut")) {
            UnitBehaviorRemove(u, "ProtossGenericWarpInOut", 1);
        }
        mainActor = libNtve_gf_MainActorofUnit(u);
        if (mainActor != null) { ActorSend(mainActor, libNtve_gf_SetOpacity(1.0, 0.0)); }
        libNtve_gf_PauseUnit(u, false);
        ready = UnitGroupEmpty();
        UnitGroupAdd(ready, u);
        // Both Purifier Alliance and For Aiur units are uncommandable AI allies.
        // Keep them in the recurring support/ability-AI pool after the warp stun.
        UnitGroupAdd(g_aprgAlliedSupport, u);
        if (g_aprgAllyWarpPurifierAlliance[best]) { UnitGroupAdd(g_aprgPurifierAllianceReinforcements, u); }
        APRG_OrderGroupTowardNearestEnemyStructure(ready, UnitGetPosition(u), player);
    }
    if (g_aprgAllyWarpActor[best] != null) { ActorSend(g_aprgAllyWarpActor[best], "Destroy"); }
    g_aprgAllyWarpState[best] = 0;
    g_aprgAllyWarpOwner[best] = -1;
    g_aprgAllyWarpType[best] = "";
    g_aprgAllyWarpPoint[best] = null;
    g_aprgAllyWarpTime[best] = 0.0;
    g_aprgAllyWarpActor[best] = null;
    g_aprgAllyWarpUnit[best] = null;
    g_aprgAllyWarpPurifierAlliance[best] = false;
}

void APRG_QueueForAiurDeath(unit dead, point p) {
    int i;
    if (dead == null || p == null) { return; }
    for (i = 0; i < 128; i += 1) {
        if (g_aprgForAiurPendingState[i] != 0) { continue; }
        g_aprgForAiurPendingState[i] = 1;
        g_aprgForAiurPendingUnit[i] = dead;
        g_aprgForAiurPendingOwner[i] = UnitGetOwner(dead);
        g_aprgForAiurPendingType[i] = UnitGetType(dead);
        g_aprgForAiurPendingPoint[i] = p;
        g_aprgForAiurPendingTime[i] = GameGetMissionTime() + 1.0;
        return;
    }
}

bool APRG_ForAiurPendingWasSaved(int slot) {
    unit original;
    unitgroup rebound;
    unit candidate;
    int i;
    original = g_aprgForAiurPendingUnit[slot];
    if (original != null && UnitIsAlive(original) && UnitGetOwner(original) == g_aprgForAiurPendingOwner[slot]) {
        return true;
    }
    if (!StringContains(g_aprgForAiurPendingType[slot], "Sentinel", c_stringAnywhere, c_stringNoCase)) { return false; }
    rebound = UnitGroup(
        g_aprgForAiurPendingType[slot],
        g_aprgForAiurPendingOwner[slot],
        RegionCircle(g_aprgForAiurPendingPoint[slot], 0.55),
        UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))),
        0
    );
    for (i = UnitGroupCount(rebound, c_unitCountAlive); i > 0; i -= 1) {
        candidate = UnitGroupUnitFromEnd(rebound, i);
        if (candidate != null && UnitIsAlive(candidate)) { return true; }
    }
    return false;
}

void APRG_CreateForAiurWave(string deadType, point p, int player, fixed now) {
    int i;
    int count;
    int queued = 0;
    string supportType;
    string heavyType;
    if (p == null || deadType == "") { return; }

    count = RandomInt(3, 6);
    for (i = 0; i < count; i += 1) {
        if (APRG_QueueAllyWarp(deadType, player, p, now + 0.2 * IntToFixed(queued))) { queued += 1; }
    }
    count = RandomInt(0, 4);
    for (i = 0; i < count; i += 1) {
        if (APRG_QueueAllyWarp("Stalker", player, p, now + 0.2 * IntToFixed(queued))) { queued += 1; }
    }
    count = RandomInt(0, 4);
    for (i = 0; i < count; i += 1) {
        if (APRG_QueueAllyWarp("Adept", player, p, now + 0.2 * IntToFixed(queued))) { queued += 1; }
    }
    if (RandomInt(0, 1) == 0) { supportType = "Sentry"; }
    else { supportType = "HighTemplar"; }
    if (APRG_QueueAllyWarp(supportType, player, p, now + 0.2 * IntToFixed(queued))) { queued += 1; }
    i = RandomInt(0, 2);
    if (i == 0) { heavyType = "Immortal"; }
    else if (i == 1) { heavyType = "Colossus"; }
    else { heavyType = "Archon"; }
    APRG_QueueAllyWarp(heavyType, player, p, now + 0.2 * IntToFixed(queued));
}

void APRG_TickForAiurPending(int player, fixed now) {
    int i;
    for (i = 0; i < 128; i += 1) {
        if (g_aprgForAiurPendingState[i] == 0 || now < g_aprgForAiurPendingTime[i]) { continue; }
        if (!APRG_ForAiurPendingWasSaved(i)) {
            APRG_CreateForAiurWave(g_aprgForAiurPendingType[i], g_aprgForAiurPendingPoint[i], player, now);
        }
        g_aprgForAiurPendingState[i] = 0;
        g_aprgForAiurPendingUnit[i] = null;
        g_aprgForAiurPendingOwner[i] = -1;
        g_aprgForAiurPendingType[i] = "";
        g_aprgForAiurPendingPoint[i] = null;
        g_aprgForAiurPendingTime[i] = 0.0;
    }
}

void APRG_TickHitAndRun(int player) {
    unitgroup units;
    unit u;
    string unitType;
    string key;
    point current;
    point previous;
    int i;
    units = APRG_PlayerMobileUnits(player);
    for (i = UnitGroupCount(units, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null) { continue; }
        unitType = UnitGetType(u);
        if (!APRG_IsReaperBoonType(unitType)) { continue; }
        key = "APRG_HitRun_" + IntToString(UnitGetTag(u));
        current = UnitGetPosition(u);
        if (!DataTableGetBool(true, key + "_Init")) {
            DataTableSetFixed(true, key + "_X", PointGetX(current));
            DataTableSetFixed(true, key + "_Y", PointGetY(current));
            DataTableSetBool(true, key + "_Init", true);
            continue;
        }
        previous = Point(DataTableGetFixed(true, key + "_X"), DataTableGetFixed(true, key + "_Y"));
        if (DistanceBetweenPoints(previous, current) >= 0.08) {
            if (!UnitHasBehavior(u, "APRogueHitAndRun")) { UnitBehaviorAdd(u, "APRogueHitAndRun", u, 1); }
        }
        else if (UnitHasBehavior(u, "APRogueHitAndRun")) {
            UnitBehaviorRemove(u, "APRogueHitAndRun", c_unitBehaviorCountAll);
        }
        DataTableSetFixed(true, key + "_X", PointGetX(current));
        DataTableSetFixed(true, key + "_Y", PointGetY(current));
    }
}

void APRG_SpawnNoDeathsUltralisk(point p, int player) {
    int owner;
    unitgroup created;
    unit punishment;
    if (p == null || !CatalogEntryIsValid(c_gameCatalogUnit, "Ultralisk")) { return; }
    owner = APRG_FindHostileOwnerNearPoint(player, p);
    if (owner < 0) { return; }
    created = UnitCreate(1, "Ultralisk", c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
    if (created != null && UnitGroupCount(created, c_unitCountAlive) > 0 && CatalogEntryIsValid(c_gameCatalogBehavior, "AutoTurretTimedLife")) {
        punishment = UnitGroupUnitFromEnd(created, 1);
        if (punishment != null) {
            UnitBehaviorAdd(punishment, "AutoTurretTimedLife", punishment, 1);
            UnitBehaviorSetDuration(punishment, "AutoTurretTimedLife", 10.0);
            UnitBehaviorSetDurationRemaining(punishment, "AutoTurretTimedLife", 10.0);
        }
    }
    APRG_AddHostileRaiders(created, p, player);
}

void APRG_QueueNoDeathsUltralisk(unit dead, point p) {
    int i;
    if (dead == null || p == null) { return; }
    for (i = 0; i < 512; i += 1) {
        if (g_aprgNoDeathsPendingState[i] != 0) { continue; }
        g_aprgNoDeathsPendingState[i] = 1;
        g_aprgNoDeathsPendingUnit[i] = dead;
        g_aprgNoDeathsPendingOwner[i] = UnitGetOwner(dead);
        g_aprgNoDeathsPendingType[i] = UnitGetType(dead);
        g_aprgNoDeathsPendingPoint[i] = p;
        g_aprgNoDeathsPendingTime[i] = GameGetMissionTime() + 1.0;
        return;
    }
}

bool APRG_NoDeathsPendingUnitWasSaved(int slot) {
    unit original;
    unitgroup rebound;
    unit candidate;
    int i;
    original = g_aprgNoDeathsPendingUnit[slot];
    if (original != null && UnitIsAlive(original) && UnitGetOwner(original) == g_aprgNoDeathsPendingOwner[slot]) {
        return true;
    }
    if (g_aprgNoDeathsPendingType[slot] == "" || g_aprgNoDeathsPendingPoint[slot] == null) { return false; }
    rebound = UnitGroup(
        g_aprgNoDeathsPendingType[slot],
        g_aprgNoDeathsPendingOwner[slot],
        RegionCircle(g_aprgNoDeathsPendingPoint[slot], 0.55),
        UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))),
        0
    );
    for (i = UnitGroupCount(rebound, c_unitCountAlive); i > 0; i -= 1) {
        candidate = UnitGroupUnitFromEnd(rebound, i);
        if (candidate != null && UnitIsAlive(candidate)) { return true; }
    }
    return false;
}

void APRG_TickNoDeathsAllowed(int player, fixed now) {
    int i;
    for (i = 0; i < 512; i += 1) {
        if (g_aprgNoDeathsPendingState[i] == 0 || now < g_aprgNoDeathsPendingTime[i]) { continue; }
        if (!APRG_NoDeathsPendingUnitWasSaved(i)) {
            APRG_SpawnNoDeathsUltralisk(g_aprgNoDeathsPendingPoint[i], player);
        }
        g_aprgNoDeathsPendingState[i] = 0;
        g_aprgNoDeathsPendingUnit[i] = null;
        g_aprgNoDeathsPendingOwner[i] = -1;
        g_aprgNoDeathsPendingType[i] = "";
        g_aprgNoDeathsPendingPoint[i] = null;
        g_aprgNoDeathsPendingTime[i] = 0.0;
    }
}

void APRG_NuclearWorkerDeath(point p, int player) {
    int owner;
    if (p == null || !CatalogEntryIsValid(c_gameCatalogEffect, "NukeDamage")) { return; }
    owner = APRG_FindHostileOwnerNearPoint(player, p);
    if (owner < 0) { return; }
    PlayerCreateEffectPoint(owner, "NukeDamage", p);
}

bool APRG_IsWorkerTypeForDeath(string unitType) {
    if (unitType == "") { return false; }
    return StringContains(unitType, "SCV", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Drone", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Probe", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "MULE", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Worker", c_stringAnywhere, c_stringNoCase);
}

bool APRG_KillTrackerDamage_Func(bool testConds, bool runActions) {
    unit victim;
    unit source;
    int player;
    int owner;
    if (!runActions || !g_aprgStarted) { return true; }
    victim = EventUnit();
    source = EventUnitDamageSourceUnit();
    if (victim == null || source == null || victim == source) { return true; }
    player = APRG_GetPrimaryPlayer();
    if (UnitGetOwner(source) != player) { return true; }
    owner = UnitGetOwner(victim);
    if (owner < 0 || !libNtve_gf_PlayerIsEnemy(owner, player, libNtve_ge_PlayerRelation_Enemy)) { return true; }
    DataTableSetUnit(true, "APRG_LastAttacker_" + IntToString(UnitGetTag(victim)), source);
    return true;
}

string APRG_MaddeningShadeCandidate(int index) {
    if (index == 0) { return "Marine"; }
    if (index == 1) { return "Marauder"; }
    if (index == 2) { return "Zealot"; }
    if (index == 3) { return "Stalker"; }
    if (index == 4) { return "Zergling"; }
    if (index == 5) { return "Roach"; }
    if (index == 6) { return "Hydralisk"; }
    if (index == 7) { return "Mutalisk"; }
    if (index == 8) { return "VikingFighter"; }
    if (index == 9) { return "Banshee"; }
    if (index == 10) { return "Immortal"; }
    if (index == 11) { return "Archon"; }
    if (index == 12) { return "Thor"; }
    if (index == 13) { return "Ultralisk"; }
    return "";
}

bool APRG_MaddeningShadeCompletedNear(point p, int player) {
    unitgroup nearby;
    int i;
    unit u;
    string unitType;
    if (p == null) { return false; }
    nearby = UnitGroup(null, player, RegionCircle(p, 2.5), UnitFilter(0, 0, (1 << c_targetFilterStructure) | (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    for (i = UnitGroupCount(nearby, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(nearby, i);
        if (u == null) { continue; }
        unitType = UnitGetType(u);
        if (StringContains(unitType, "Adept", c_stringAnywhere, c_stringNoCase) && !StringContains(unitType, "PhaseShift", c_stringAnywhere, c_stringNoCase)) { return true; }
    }
    return false;
}

void APRG_SpawnMaddeningShadeReward(point p, int player, fixed now) {
    int start;
    int step;
    string unitType;
    unitgroup created;
    unit u;
    string key;
    if (p == null || g_aprgMaddeningShadeUnits == null) { return; }
    if (UnitGroupCount(g_aprgMaddeningShadeUnits, c_unitCountAlive) >= 128) { return; }
    start = RandomInt(0, 13);
    unitType = "";
    for (step = 0; step < 14; step += 1) {
        unitType = APRG_MaddeningShadeCandidate((start + step) % 14);
        if (unitType != "" && CatalogEntryIsValid(c_gameCatalogUnit, unitType)) { break; }
        unitType = "";
    }
    if (unitType == "") { return; }
    created = APRG_CreatePlayerUnitsSafe(1, unitType, player, p, libNtve_gf_RandomAngle());
    u = UnitGroupUnitFromEnd(created, 1);
    if (u == null) { return; }
    UnitSetState(u, c_unitStateUsingSupply, false);
    UnitGroupAdd(g_aprgMaddeningShadeUnits, u);
    key = "APRG_MaddeningShadeExpire_" + IntToString(UnitGetTag(u));
    DataTableSetFixed(true, key, now + 15.0);
}

void APRG_TickMaddeningShadeUnits(fixed now) {
    int i;
    unit u;
    string key;
    fixed expires;
    if (g_aprgMaddeningShadeUnits == null) { return; }
    for (i = UnitGroupCount(g_aprgMaddeningShadeUnits, c_unitCountAll); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(g_aprgMaddeningShadeUnits, i);
        if (u == null || !UnitIsAlive(u)) {
            if (u != null) { UnitGroupRemove(g_aprgMaddeningShadeUnits, u); }
            continue;
        }
        key = "APRG_MaddeningShadeExpire_" + IntToString(UnitGetTag(u));
        expires = DataTableGetFixed(true, key);
        if (expires > 0.0 && now >= expires) {
            UnitGroupRemove(g_aprgMaddeningShadeUnits, u);
            UnitRemove(u);
        }
    }
}

int APRG_FindAnyHostileOwner(int player, point p) {
    int owner;
    unitgroup enemies;
    unit anchor;
    owner = APRG_FindHostileOwnerNearPoint(player, p);
    if (owner >= 0) { return owner; }
    enemies = APRG_EnemyAllUnits(player);
    if (UnitGroupCount(enemies, c_unitCountAlive) <= 0) { return -1; }
    anchor = UnitGroupClosestToPoint(enemies, p);
    if (anchor == null) { return -1; }
    return UnitGetOwner(anchor);
}

bool APRG_UnitHasTimedLife(unit u) {
    int i;
    string behavior;
    if (u == null) { return false; }
    if (DataTableGetBool(true, "APRG_HadTimedLife_" + IntToString(UnitGetTag(u)))) { return true; }
    if (StringContains(UnitGetType(u), "MULE", c_stringAnywhere, c_stringNoCase)) { return true; }
    for (i = UnitBehaviorCountAll(u); i >= 1; i -= 1) {
        behavior = UnitBehaviorGet(u, i);
        if (behavior != "" && UnitBehaviorHasFlag(behavior, c_unitBehaviorFlagTimedLife)) { return true; }
    }
    return false;
}

void APRG_RecordTimedLifeUnit(unit u) {
    int i;
    string behavior;
    if (u == null) { return; }
    if (StringContains(UnitGetType(u), "MULE", c_stringAnywhere, c_stringNoCase)) {
        DataTableSetBool(true, "APRG_HadTimedLife_" + IntToString(UnitGetTag(u)), true);
        return;
    }
    for (i = UnitBehaviorCountAll(u); i >= 1; i -= 1) {
        behavior = UnitBehaviorGet(u, i);
        if (behavior != "" && UnitBehaviorHasFlag(behavior, c_unitBehaviorFlagTimedLife)) {
            DataTableSetBool(true, "APRG_HadTimedLife_" + IntToString(UnitGetTag(u)), true);
            return;
        }
    }
}

bool APRG_TimedLifeCreated_Func(bool testConds, bool runActions) {
    unit created;
    if (!runActions || !g_aprgStarted) { return true; }
    created = EventUnitCreatedUnit();
    APRG_RecordTimedLifeUnit(created);
    return true;
}

bool APRG_DeathSpawnExcluded(unit dead, string unitType) {
    string tag;
    if (dead == null || unitType == "") { return true; }

    // All death-spawn mechanics share this definition of a "real" unit death.
    // Disposable summons, temporary/fake units, workers, and Slay-created free
    // units must never recursively create zombies or No Deaths Allowed ultralisks.
    if (APRG_UnitHasTimedLife(dead)) { return true; }
    if (APRG_IsWorkerTypeForDeath(unitType)) { return true; }
    tag = IntToString(UnitGetTag(dead));
    if (DataTableGetBool(true, "APRG_Uncommandable_" + tag)) { return true; }

    if (StringContains(unitType, "Larva", c_stringAnywhere, c_stringNoCase)) { return true; }
    if (StringContains(unitType, "Egg", c_stringAnywhere, c_stringNoCase)) { return true; }
    if (StringContains(unitType, "Cocoon", c_stringAnywhere, c_stringNoCase)) { return true; }
    if (StringContains(unitType, "Chrysalis", c_stringAnywhere, c_stringNoCase)) { return true; }
    if (StringContains(unitType, "Broodling", c_stringAnywhere, c_stringNoCase)) { return true; }
    if (StringContains(unitType, "Locust", c_stringAnywhere, c_stringNoCase)) { return true; }
    if (StringContains(unitType, "Interceptor", c_stringAnywhere, c_stringNoCase)) { return true; }
    if (StringContains(unitType, "Changeling", c_stringAnywhere, c_stringNoCase)) { return true; }
    if (StringContains(unitType, "Hallucination", c_stringAnywhere, c_stringNoCase)) { return true; }
    if (StringContains(unitType, "HoloDecoy", c_stringAnywhere, c_stringNoCase)) { return true; }
    if (StringContains(unitType, "Decoy", c_stringAnywhere, c_stringNoCase)) { return true; }
    if (StringContains(unitType, "Dummy", c_stringAnywhere, c_stringNoCase)) { return true; }
    return false;
}

bool APRG_BasicZombieDeathExcluded(unit dead, string unitType) {
    string tag;
    if (APRG_DeathSpawnExcluded(dead, unitType)) { return true; }
    tag = IntToString(UnitGetTag(dead));
    // Never cross-trigger another zombie mechanic's own free spawns.
    return DataTableGetBool(true, "APRG_BasicZombie_" + tag) ||
        DataTableGetBool(true, "APRG_ZombieApocalypse_" + tag);
}

bool APRG_ZombieApocalypseDeathExcluded(unit dead, string unitType) {
    string tag;
    if (dead == null || APRG_DeathSpawnExcluded(dead, unitType)) { return true; }
    tag = IntToString(UnitGetTag(dead));
    // Only exclude zombies we created. Natural or purchased Infested Terran
    // must remain eligible, but zombies from either effect never recurse.
    return DataTableGetBool(true, "APRG_ZombieApocalypse_" + tag) ||
        DataTableGetBool(true, "APRG_BasicZombie_" + tag);
}

void APRG_TagZombieApocalypseGroup(unitgroup created) {
    int i;
    unit u;
    string key;
    for (i = UnitGroupCount(created, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(created, i);
        if (u == null) { continue; }
        key = "APRG_ZombieApocalypse_" + IntToString(UnitGetTag(u));
        DataTableSetBool(true, key, true);
    }
}

void APRG_SpawnZombieApocalypse(point p, int player) {
    int owner;
    int meleeCount;
    string rangedType;
    unitgroup created;
    unitgroup rangedCreated;
    if (p == null) { return; }
    owner = APRG_FindAnyHostileOwner(player, p);
    if (owner < 0) { return; }
    meleeCount = RandomInt(1, 3);
    if (CatalogEntryIsValid(c_gameCatalogUnit, "InfestedCivilian")) {
        created = UnitCreate(meleeCount, "InfestedCivilian", c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
        APRG_TagZombieApocalypseGroup(created);
        APRG_AddHostileRaiders(created, p, player);
    }
    if (RandomInt(1, 100) > 20) { return; }
    rangedType = "";
    if (CatalogEntryIsValid(c_gameCatalogUnit, "InfestedTerranCampaign")) { rangedType = "InfestedTerranCampaign"; }
    else if (CatalogEntryIsValid(c_gameCatalogUnit, "InfestedTerran")) { rangedType = "InfestedTerran"; }
    if (rangedType == "") { return; }
    rangedCreated = UnitCreate(1, rangedType, c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
    APRG_TagZombieApocalypseGroup(rangedCreated);
    APRG_AddHostileRaiders(rangedCreated, p, player);
}

bool APRG_QueueZombieSpawnJob(int kind, point p, int owner) {
    int slot;
    if (p == null || kind <= 0) { return false; }
    if (g_aprgZombieSpawnCount >= APRG_MAX_ZOMBIE_SPAWN_JOBS) { return false; }
    slot = g_aprgZombieSpawnTail;
    g_aprgZombieSpawnPoint[slot] = Point(PointGetX(p), PointGetY(p));
    g_aprgZombieSpawnKind[slot] = kind;
    g_aprgZombieSpawnOwner[slot] = owner;
    g_aprgZombieSpawnTail = (g_aprgZombieSpawnTail + 1) % APRG_MAX_ZOMBIE_SPAWN_JOBS;
    g_aprgZombieSpawnCount += 1;
    return true;
}

void APRG_ProcessZombieSpawnQueue(int player) {
    int processed = 0;
    int slot;
    int kind;
    int owner;
    point p;
    while (g_aprgZombieSpawnCount > 0 && processed < APRG_ZOMBIE_JOBS_PER_FAST_TICK) {
        slot = g_aprgZombieSpawnHead;
        p = g_aprgZombieSpawnPoint[slot];
        kind = g_aprgZombieSpawnKind[slot];
        owner = g_aprgZombieSpawnOwner[slot];
        g_aprgZombieSpawnPoint[slot] = null;
        g_aprgZombieSpawnKind[slot] = 0;
        g_aprgZombieSpawnOwner[slot] = -1;
        g_aprgZombieSpawnHead = (g_aprgZombieSpawnHead + 1) % APRG_MAX_ZOMBIE_SPAWN_JOBS;
        g_aprgZombieSpawnCount -= 1;
        processed += 1;

        if (kind == APRG_ZOMBIE_JOB_ALLIED) {
            APRG_SpawnZombie(p, player, true, player);
        }
        else if (kind == APRG_ZOMBIE_JOB_HOSTILE) {
            if (owner < 0) { owner = APRG_FindHostileOwnerNearPoint(player, p); }
            if (owner >= 0) { APRG_SpawnZombie(p, owner, false, player); }
        }
        else if (kind == APRG_ZOMBIE_JOB_APOCALYPSE) {
            APRG_SpawnZombieApocalypse(p, player);
        }
    }
}

void APRG_NuclearStructureDeath(point p, int player) {
    if (p == null || !CatalogEntryIsValid(c_gameCatalogEffect, "NukeDamage")) { return; }
    PlayerCreateEffectPoint(player, "NukeDamage", p);
}

string APRG_RichGasStructureReplacement(string unitType) {
    if (unitType == "Refinery" && CatalogEntryIsValid(c_gameCatalogUnit, "RefineryRich")) { return "RefineryRich"; }
    if (unitType == "Assimilator" && CatalogEntryIsValid(c_gameCatalogUnit, "AssimilatorRich")) { return "AssimilatorRich"; }
    if (unitType == "Extractor" && CatalogEntryIsValid(c_gameCatalogUnit, "ExtractorRich")) { return "ExtractorRich"; }
    return "";
}

bool APRG_PointHasGasStructure(point p) {
    unitgroup structures;
    int i;
    unit u;
    string unitType;
    structures = UnitGroup(
        null,
        c_playerAny,
        RegionPlayableMap(),
        UnitFilter((1 << c_targetFilterStructure), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32))),
        0
    );
    for (i = UnitGroupCount(structures, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(structures, i);
        if (u == null || DistanceBetweenPoints(p, UnitGetPosition(u)) > 2.0) { continue; }
        unitType = UnitGetType(u);
        if (
            StringContains(unitType, "Refinery", c_stringAnywhere, c_stringNoCase) ||
            StringContains(unitType, "Assimilator", c_stringAnywhere, c_stringNoCase) ||
            StringContains(unitType, "Extractor", c_stringAnywhere, c_stringNoCase)
        ) { return true; }
    }
    return false;
}

void APRG_ApplyRichResources(int player, bool minerals, bool vespene) {
    unitgroup resources;
    unitgroup playerUnits;
    int pass;
    int i;
    unit u;
    string unitType;
    string resourceType;
    string replacementType;
    bool replaced;

    if (vespene) {
        playerUnits = APRG_PlayerAllUnits(player);
        for (i = UnitGroupCount(playerUnits, c_unitCountAlive); i > 0; i -= 1) {
            u = UnitGroupUnitFromEnd(playerUnits, i);
            if (u == null || !UnitTypeTestAttribute(UnitGetType(u), c_unitAttributeStructure)) { continue; }
            unitType = UnitGetType(u);
            replacementType = APRG_RichGasStructureReplacement(unitType);
            if (replacementType != "") {
                libNtve_gf_ReplaceUnit(u, replacementType, libNtve_ge_ReplaceUnitOptions_OldUnitsRelative);
            }
        }
    }

    for (pass = 0; pass < 512; pass += 1) {
        replaced = false;
        resources = UnitGroup(
            null,
            c_playerAny,
            RegionPlayableMap(),
            UnitFilter((1 << c_targetFilterHarvestableResource), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32))),
            0
        );
        for (i = UnitGroupCount(resources, c_unitCountAlive); i > 0; i -= 1) {
            u = UnitGroupUnitFromEnd(resources, i);
            if (u == null) { continue; }
            unitType = UnitGetType(u);
            resourceType = CatalogFieldValueGet(c_gameCatalogUnit, unitType, "ResourceType", c_playerAny);
            if (minerals && resourceType == "Minerals" && !StringContains(unitType, "RichMineralField", c_stringAnywhere, c_stringNoCase)) {
                if (CatalogEntryIsValid(c_gameCatalogUnit, "RichMineralField")) {
                    libNtve_gf_ReplaceUnit(u, "RichMineralField", libNtve_ge_ReplaceUnitOptions_OldUnitsRelative);
                    replaced = true;
                    break;
                }
            }
            else if (
                vespene &&
                resourceType == "Vespene" &&
                !StringContains(unitType, "RichVespeneGeyser", c_stringAnywhere, c_stringNoCase) &&
                !APRG_PointHasGasStructure(UnitGetPosition(u))
            ) {
                if (CatalogEntryIsValid(c_gameCatalogUnit, "RichVespeneGeyser")) {
                    libNtve_gf_ReplaceUnit(u, "RichVespeneGeyser", libNtve_ge_ReplaceUnitOptions_OldUnitsRelative);
                    replaced = true;
                    break;
                }
            }
        }
        if (!replaced) { break; }
    }
}

void APRG_InitializeResourceSwap(int player) {
    int minerals;
    int vespene;
    if (g_aprgResourceSwapInitialized) { return; }
    minerals = PlayerGetPropertyInt(player, c_playerPropMinerals);
    vespene = PlayerGetPropertyInt(player, c_playerPropVespene);
    g_aprgResourceSwapBusy = true;
    PlayerModifyPropertyInt(player, c_playerPropMinerals, c_playerPropOperSetTo, vespene);
    PlayerModifyPropertyInt(player, c_playerPropVespene, c_playerPropOperSetTo, minerals);
    g_aprgResourceSwapBusy = false;
    g_aprgResourceSwapMinerals = PlayerGetPropertyInt(player, c_playerPropMinerals);
    g_aprgResourceSwapVespene = PlayerGetPropertyInt(player, c_playerPropVespene);
    g_aprgResourceSwapInitialized = true;
}

bool APRG_ResourceSwap_Func(bool testConds, bool runActions) {
    int player;
    int property;
    int minerals;
    int vespene;
    int delta;
    if (!runActions || !g_aprgStarted || !APRG_HasExtension3(APRG_EXT3_MUT_RESOURCE_SWAP)) { return true; }
    if (g_aprgResourceSwapBusy) { return true; }
    player = APRG_GetPrimaryPlayer();
    if (EventPlayer() != player) { return true; }
    property = EventPlayerProperty();
    minerals = PlayerGetPropertyInt(player, c_playerPropMinerals);
    vespene = PlayerGetPropertyInt(player, c_playerPropVespene);
    g_aprgResourceSwapBusy = true;
    if (property == c_playerPropMinerals && minerals > g_aprgResourceSwapMinerals) {
        delta = minerals - g_aprgResourceSwapMinerals;
        PlayerModifyPropertyInt(player, c_playerPropMinerals, c_playerPropOperSetTo, g_aprgResourceSwapMinerals);
        PlayerModifyPropertyInt(player, c_playerPropVespene, c_playerPropOperSetTo, vespene + delta);
    }
    else if (property == c_playerPropVespene && vespene > g_aprgResourceSwapVespene) {
        delta = vespene - g_aprgResourceSwapVespene;
        PlayerModifyPropertyInt(player, c_playerPropVespene, c_playerPropOperSetTo, g_aprgResourceSwapVespene);
        PlayerModifyPropertyInt(player, c_playerPropMinerals, c_playerPropOperSetTo, minerals + delta);
    }
    g_aprgResourceSwapBusy = false;
    g_aprgResourceSwapMinerals = PlayerGetPropertyInt(player, c_playerPropMinerals);
    g_aprgResourceSwapVespene = PlayerGetPropertyInt(player, c_playerPropVespene);
    return true;
}

bool APRG_IsKnownTerranBiologicalFamily(string unitType) {
    if (unitType == "") { return false; }
    return StringContains(unitType, "Marine", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Marauder", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Reaper", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Firebat", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Medic", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Ghost", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Spectre", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "WarPig", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "DevilDog", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "HammerSecur", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Tychus", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Raynor", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Warfield", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Nova", c_stringAnywhere, c_stringNoCase);
}

bool APRG_IsInfantryBoonType(string unitType, int player) {
    string race;
    if (unitType == "" || !CatalogEntryIsValid(c_gameCatalogUnit, unitType)) { return false; }
    if (APRG_IsWorkerTypeForDeath(unitType) || UnitTypeTestAttribute(unitType, c_unitAttributeStructure)) { return false; }
    if (!UnitTypeTestAttribute(unitType, c_unitAttributeBiological)) { return false; }
    race = CatalogFieldValueGet(c_gameCatalogUnit, unitType, "Race", player);
    if (StringContains(race, "Terr", c_stringAnywhere, c_stringNoCase)) { return true; }
    return race == "" && APRG_IsKnownTerranBiologicalFamily(unitType);
}

void APRG_BeginDeadManSwitch(point center, int player, fixed now) {
    int n;
    int slot;
    int scan;
    fixed angle;
    point p;
    actor indicator;
    if (center == null || !CatalogEntryIsValid(c_gameCatalogEffect, "NukeDamage")) { return; }
    for (n = 0; n < 6; n += 1) {
        slot = -1;
        for (scan = 0; scan < APRG_MAX_DEAD_MAN_NUKES; scan += 1) {
            if (g_aprgDeadManNukeState[scan] == 0) { slot = scan; break; }
        }
        if (slot < 0) { return; }
        angle = IntToFixed(n) * 60.0;
        p = PointWithOffsetPolar(center, 10.0, angle);
        indicator = null;
        if (CatalogEntryIsValid(c_gameCatalogModel, "GhostNukeIndicator")) {
            indicator = libNtve_gf_CreateModelAtPoint("GhostNukeIndicator", p);
        }
        PingCreate(PlayerGroupSingle(player), "PingWarning", p, ColorWithAlpha(100.00, 0.00, 0.00, 0.00), 8.0);
        PingSetScale(PingLastCreated(), 1.25);
        g_aprgDeadManNukePoint[slot] = p;
        g_aprgDeadManNukeTime[slot] = now + 8.0;
        g_aprgDeadManNukeIndicator[slot] = indicator;
        g_aprgDeadManNukeState[slot] = 1;
    }
}

void APRG_TickDeadManSwitchNukes(int player, fixed now) {
    int i;
    if (!APRG_HasExtension4(APRG_EXT4_BOON_DEAD_MAN_SWITCH)) { return; }
    for (i = 0; i < APRG_MAX_DEAD_MAN_NUKES; i += 1) {
        if (g_aprgDeadManNukeState[i] != 1 || now < g_aprgDeadManNukeTime[i]) { continue; }
        PlayerCreateEffectPoint(player, "NukeDamage", g_aprgDeadManNukePoint[i]);
        if (g_aprgDeadManNukeIndicator[i] != null) { ActorSend(g_aprgDeadManNukeIndicator[i], "Destroy"); }
        g_aprgDeadManNukeState[i] = 0;
        g_aprgDeadManNukePoint[i] = null;
        g_aprgDeadManNukeTime[i] = 0.0;
        g_aprgDeadManNukeIndicator[i] = null;
    }
}

void APRG_ApplyGloriousMartyrs(point deathPoint, int player);
bool APRG_IsFieryUnitType(string unitType);

bool APRG_Death_Func(bool testConds, bool runActions) {
    unit dead;
    point p;
    int player;
    int owner;
    int killer;
    string unitType;
    fixed speed;
    fixed now;
    unitgroup chainCreated;
    unit chainBaneling;
    unit home;
    unit killingUnit;
    unitgroup evoCreated;
    unit evolvedUnit;
    string killerType;
    bool deathSpawnExcluded;
    if (!runActions || !g_aprgStarted) {
        return true;
    }
    dead = EventUnit();
    if (dead == null) {
        return true;
    }
    p = UnitGetPosition(dead);
    player = APRG_GetPrimaryPlayer();
    owner = UnitGetOwner(dead);
    unitType = UnitGetType(dead);
    deathSpawnExcluded = APRG_DeathSpawnExcluded(dead, unitType);
    speed = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "Speed", owner));
    now = GameGetMissionTime();
    killingUnit = DataTableGetUnit(true, "APRG_LastAttacker_" + IntToString(UnitGetTag(dead)));
    DataTableValueRemove(true, "APRG_LastAttacker_" + IntToString(UnitGetTag(dead)));

    if (DataTableGetBool(true, "APRG_WarfieldGorgon_" + IntToString(UnitGetTag(dead)))) {
        DataTableSetBool(true, "APRG_WarfieldGorgon_" + IntToString(UnitGetTag(dead)), false);
        APRG_PlayRandomWarfieldGorgonDeath();
    }

    if (APRG_HasExtension2(APRG_EXT2_BLESS_GLORIOUS_MARTYRS) && owner == player) {
        APRG_ApplyGloriousMartyrs(p, player);
    }
    if (APRG_HasBlessing(APRG_BLESS_EXPLOSIVE_ARMOR) && owner == player) {
        APRG_DealExplosiveArmorDamage(
            p,
            player,
            20.0 * UnitTypeGetProperty(unitType, c_unitPropSuppliesUsed),
            2.5 + MaxF(0.0, UnitTypeGetProperty(unitType, c_unitPropSuppliesUsed) - 1.0)
        );
    }
    if (
        APRG_PlayerMacroBaseReady(player) &&
        APRG_HasExtension(APRG_EXT_MUT_NO_DEATHS_ALLOWED) &&
        owner == player &&
        !deathSpawnExcluded &&
        speed > 0.0 &&
        !DataTableGetBool(true, "APRG_Uncommandable_" + IntToString(UnitGetTag(dead)))
    ) {
        APRG_QueueNoDeathsUltralisk(dead, p);
    }
    if (APRG_HasExtension(APRG_EXT_MUT_NUCLEAR_WORKERS) && owner == player && APRG_IsWorkerTypeForDeath(unitType)) {
        APRG_NuclearWorkerDeath(p, player);
    }
    if (
        APRG_HasExtension3(APRG_EXT3_MUT_NUCLEAR_STRUCTURES) &&
        owner >= 0 &&
        libNtve_gf_PlayerIsEnemy(owner, player, libNtve_ge_PlayerRelation_Enemy) &&
        UnitTypeTestAttribute(unitType, c_unitAttributeStructure) &&
        !APRG_IsCreepTumorType(unitType)
    ) {
        APRG_NuclearStructureDeath(p, player);
    }
    if (
        APRG_PlayerMacroBaseReady(player) &&
        APRG_HasExtension3(APRG_EXT3_MUT_ZOMBIE_APOCALYPSE) &&
        (owner == player || (owner >= 0 && libNtve_gf_PlayerIsEnemy(owner, player, libNtve_ge_PlayerRelation_Enemy))) &&
        !APRG_ZombieApocalypseDeathExcluded(dead, unitType)
    ) {
        if (!APRG_QueueZombieSpawnJob(APRG_ZOMBIE_JOB_APOCALYPSE, p, -1)) {
            APRG_SpawnZombieApocalypse(p, player);
        }
    }
    if (
        APRG_HasExtension4(APRG_EXT4_BOON_KILL_STREAK) && killingUnit != null &&
        owner >= 0 && libNtve_gf_PlayerIsEnemy(owner, player, libNtve_ge_PlayerRelation_Enemy) &&
        UnitGetOwner(killingUnit) == player && UnitIsAlive(killingUnit) &&
        (StringContains(UnitGetType(killingUnit), "Ghost", c_stringAnywhere, c_stringNoCase) || StringContains(UnitGetType(killingUnit), "Spectre", c_stringAnywhere, c_stringNoCase)) &&
        CatalogEntryIsValid(c_gameCatalogBehavior, "APRogueKillStreak")
    ) {
        UnitBehaviorAdd(killingUnit, "APRogueKillStreak", killingUnit, 1);
    }
    if (owner == player && !deathSpawnExcluded && APRG_HasExtension4(APRG_EXT4_BOON_INFANTRY_REINFORCEMENTS) && APRG_IsInfantryBoonType(unitType, player)) {
        killer = FixedToInt(UnitTypeGetProperty(unitType, c_unitPropSuppliesUsed) * 7.0);
        if (killer > 100) { killer = 100; }
        if (killer > 0 && RandomInt(1, 100) <= killer) {
            APRG_QueueRealDropPod(APRG_DROP_KIND_INFANTRY_REINFORCEMENTS, player, p, null);
        }
    }
    if (
        owner == player && !deathSpawnExcluded && APRG_HasExtension4(APRG_EXT4_BOON_ACIDIC_LANDING_MARKERS) &&
        StringContains(unitType, "Baneling", c_stringAnywhere, c_stringNoCase) && RandomInt(1, 100) <= 20
    ) {
        APRG_QueueRealDropPod(APRG_DROP_KIND_ACIDIC_LANDING, player, p, null);
    }
    if (owner == player && APRG_HasExtension4(APRG_EXT4_BOON_RECYCLED_ARMOR) && APRG_IsInfantryBoonType(unitType, player)) {
        PlayerModifyPropertyInt(player, c_playerPropMinerals, c_playerPropOperSetTo, PlayerGetPropertyInt(player, c_playerPropMinerals) + 25);
        PlayerModifyPropertyInt(player, c_playerPropVespene, c_playerPropOperSetTo, PlayerGetPropertyInt(player, c_playerPropVespene) + 10);
    }
    if (
        owner == player && APRG_HasExtension4(APRG_EXT4_BOON_DEAD_MAN_SWITCH) &&
        StringContains(unitType, "Spectre", c_stringAnywhere, c_stringNoCase)
    ) {
        APRG_BeginDeadManSwitch(p, player, now);
    }
    if (
        owner == player && !deathSpawnExcluded && APRG_HasExtension4(APRG_EXT4_BOON_CELL_DIVISION) &&
        (StringContains(unitType, "Ultralisk", c_stringAnywhere, c_stringNoCase) ||
         StringContains(unitType, "Torrasque", c_stringAnywhere, c_stringNoCase)) &&
        CatalogEntryIsValid(c_gameCatalogUnit, "Roach")
    ) {
        evoCreated = APRG_CreatePlayerUnitsSafe(6, "Roach", player, p, libNtve_gf_RandomAngle());
    }
    if (
        owner >= 0 && libNtve_gf_PlayerIsEnemy(owner, player, libNtve_ge_PlayerRelation_Enemy) &&
        !deathSpawnExcluded &&
        APRG_HasExtension4(APRG_EXT4_BOON_ZERGLING_INFESTATION) &&
        DataTableGetFixed(true, "APRG_ZerglingInfestUntil_" + IntToString(UnitGetTag(dead))) >= now
    ) {
        killer = FixedToInt(UnitTypeGetProperty(unitType, c_unitPropSuppliesUsed));
        if (killer > 0 && CatalogEntryIsValid(c_gameCatalogUnit, "Zergling")) {
            evoCreated = APRG_CreatePlayerUnitsSafe(killer, "Zergling", player, p, libNtve_gf_RandomAngle());
        }
        DataTableValueRemove(true, "APRG_ZerglingInfestUntil_" + IntToString(UnitGetTag(dead)));
    }
    if (!deathSpawnExcluded && APRG_PlayerMacroBaseReady(player) && APRG_HasExtension(APRG_EXT_MUT_VICTORY_TEMPORARY)) {
        APRG_QueueEnemyRespawn(dead, player, now);
    }
    if (APRG_HasExtension(APRG_EXT_BLESS_BOUNTY_KILLS)) {
        killer = libNtve_gf_KillingPlayer();
        if (killer == player && owner >= 0 && libNtve_gf_PlayerIsEnemy(owner, player, libNtve_ge_PlayerRelation_Enemy)) {
            PlayerModifyPropertyInt(player, c_playerPropMinerals, c_playerPropOperSetTo, PlayerGetPropertyInt(player, c_playerPropMinerals) + 4);
            PlayerModifyPropertyInt(player, c_playerPropVespene, c_playerPropOperSetTo, PlayerGetPropertyInt(player, c_playerPropVespene) + 3);
        }
    }
    if (APRG_HasExtension3(APRG_EXT3_MUT_COMBAT_PAY)) {
        killer = libNtve_gf_KillingPlayer();
        if (killer == player && owner >= 0 && libNtve_gf_PlayerIsEnemy(owner, player, libNtve_ge_PlayerRelation_Enemy)) {
            PlayerModifyPropertyInt(
                player,
                c_playerPropMinerals,
                c_playerPropOperSetTo,
                MaxI(0, PlayerGetPropertyInt(player, c_playerPropMinerals) - 4)
            );
        }
    }
    if (!deathSpawnExcluded && APRG_HasExtension2(APRG_EXT2_BOON_CHAIN_REACTION) && owner >= 0 && libNtve_gf_PlayerIsEnemy(owner, player, libNtve_ge_PlayerRelation_Enemy) && CatalogEntryIsValid(c_gameCatalogUnit,"Baneling")) {
        chainCreated = APRG_CreatePlayerUnitsSafe(1,"Baneling",player,p,libNtve_gf_RandomAngle());
        chainBaneling = UnitGroupUnitFromEnd(chainCreated,1);
        if (chainBaneling != null) { UnitSetState(chainBaneling,c_unitStateUsingSupply,false); }
    }
    if (
        !deathSpawnExcluded && APRG_HasExtension2(APRG_EXT2_BOON_AIUR_RECRUITMENT) && owner == player &&
        APRG_IsForAiurZealotType(unitType) && RandomInt(1, 100) <= 10
    ) {
        APRG_QueueForAiurDeath(dead, p);
    }
    if (
        APRG_HasExtension3(APRG_EXT3_BOON_MADDENING_SHADES) &&
        owner == player &&
        StringContains(unitType, "AdeptPhaseShift", c_stringAnywhere, c_stringNoCase) &&
        APRG_MaddeningShadeCompletedNear(p, player)
    ) {
        APRG_SpawnMaddeningShadeReward(p, player, now);
    }

    if (
        APRG_HasExtension3(APRG_EXT3_BOON_STRETCHY_SPINES) &&
        owner >= 0 &&
        libNtve_gf_PlayerIsEnemy(owner, player, libNtve_ge_PlayerRelation_Enemy) &&
        killingUnit != null &&
        UnitGetOwner(killingUnit) == player &&
        UnitIsAlive(killingUnit) &&
        StringContains(UnitGetType(killingUnit), "SpineCrawler", c_stringAnywhere, c_stringNoCase)
    ) {
        UnitBehaviorAdd(killingUnit, "APRogueStretchySpines", killingUnit, 1);
    }
    if (
        APRG_HasExtension2(APRG_EXT2_BOON_FIRE_POWER) &&
        owner >= 0 &&
        libNtve_gf_PlayerIsEnemy(owner, player, libNtve_ge_PlayerRelation_Enemy) &&
        killingUnit != null &&
        UnitGetOwner(killingUnit) == player &&
        APRG_IsFieryUnitType(UnitGetType(killingUnit))
    ) {
        if (g_aprgFirePowerStacks < 100) { g_aprgFirePowerStacks += 1; }
    }
    if (
        !deathSpawnExcluded && APRG_HasExtension2(APRG_EXT2_BOON_ROACHLING_MINES) &&
        owner == player &&
        StringContains(unitType, "SpiderMine", c_stringAnywhere, c_stringNoCase) &&
        CatalogEntryIsValid(c_gameCatalogUnit, "Roachling")
    ) {
        evoCreated = APRG_CreatePlayerUnitsSafe(5, "Roachling", player, p, libNtve_gf_RandomAngle());
        for (killer = UnitGroupCount(evoCreated, c_unitCountAlive); killer > 0; killer -= 1) {
            evolvedUnit = UnitGroupUnitFromEnd(evoCreated, killer);
            if (evolvedUnit != null) { UnitSetState(evolvedUnit, c_unitStateUsingSupply, false); }
        }
    }
    if (
        !deathSpawnExcluded && APRG_HasExtension2(APRG_EXT2_BOON_BROODLING_EVOLUTION) &&
        owner >= 0 &&
        libNtve_gf_PlayerIsEnemy(owner, player, libNtve_ge_PlayerRelation_Enemy) &&
        killingUnit != null &&
        UnitGetOwner(killingUnit) == player &&
        UnitIsAlive(killingUnit)
    ) {
        killerType = UnitGetType(killingUnit);
        if (
            StringContains(killerType, "Broodling", c_stringAnywhere, c_stringNoCase) &&
            CatalogEntryIsValid(c_gameCatalogUnit, "Zergling")
        ) {
            evoCreated = APRG_CreatePlayerUnitsSafe(1, "Zergling", player, UnitGetPosition(killingUnit), UnitGetFacing(killingUnit));
            evolvedUnit = UnitGroupUnitFromEnd(evoCreated, 1);
            if (evolvedUnit != null) {
                UnitSetState(evolvedUnit, c_unitStateUsingSupply, false);
                UnitGroupAdd(g_aprgBroodEvolutionStage1, evolvedUnit);
                UnitRemove(killingUnit);
            }
        }
        else if (UnitGroupHasUnit(g_aprgBroodEvolutionStage1, killingUnit) && CatalogEntryIsValid(c_gameCatalogUnit, "Roach")) {
            evoCreated = APRG_CreatePlayerUnitsSafe(1, "Roach", player, UnitGetPosition(killingUnit), UnitGetFacing(killingUnit));
            evolvedUnit = UnitGroupUnitFromEnd(evoCreated, 1);
            if (evolvedUnit != null) {
                UnitSetState(evolvedUnit, c_unitStateUsingSupply, false);
                UnitGroupAdd(g_aprgBroodEvolutionStage2, evolvedUnit);
                UnitGroupRemove(g_aprgBroodEvolutionStage1, killingUnit);
                UnitRemove(killingUnit);
            }
        }
        else if (UnitGroupHasUnit(g_aprgBroodEvolutionStage2, killingUnit) && CatalogEntryIsValid(c_gameCatalogUnit, "Ultralisk")) {
            evoCreated = APRG_CreatePlayerUnitsSafe(1, "Ultralisk", player, UnitGetPosition(killingUnit), UnitGetFacing(killingUnit));
            evolvedUnit = UnitGroupUnitFromEnd(evoCreated, 1);
            if (evolvedUnit != null) {
                UnitSetState(evolvedUnit, c_unitStateUsingSupply, false);
                UnitGroupRemove(g_aprgBroodEvolutionStage2, killingUnit);
                UnitRemove(killingUnit);
            }
        }
    }
    if (APRG_PlayerMacroBaseReady(player) && APRG_HasMutation(APRG_MUT_ZOMBIES) && !APRG_BasicZombieDeathExcluded(dead, unitType)) {
        if (!APRG_QueueZombieSpawnJob(APRG_ZOMBIE_JOB_HOSTILE, p, -1)) {
            owner = APRG_FindHostileOwnerNearPoint(player, p);
            if (owner >= 0) { APRG_SpawnZombie(p, owner, false, player); }
        }
    }
    if (APRG_PlayerMacroBaseReady(player) && APRG_HasBlessing(APRG_BLESS_ZOMBIES) && !APRG_BasicZombieDeathExcluded(dead, unitType)) {
        if (!APRG_QueueZombieSpawnJob(APRG_ZOMBIE_JOB_ALLIED, p, player)) {
            APRG_SpawnZombie(p, player, true, player);
        }
    }
    return true;
}

void APRG_TrySpawnHostileHero(int player) {
    point p;
    int owner;
    string heroType;
    unitgroup created;
    int attempt;
    point candidate;
    if (g_aprgHostileHeroesSpawned >= 7 || g_aprgHostileHeroRetries >= APRG_STATIC_SPAWN_MAX_RETRIES) { return; }
    g_aprgHostileHeroRetries += 1;
    // Heroes of the Storm must never materialize within 20 range of a
    // player-owned or allied structure, even after the early-game grace period.
    p = null;
    for (attempt = 0; attempt < 12; attempt += 1) {
        candidate = APRG_FindHeroPatrolOrigin(player);
        if (candidate == null) { break; }
        if (APRG_PointNearPlayerOrAlliedBuilding(candidate, player, 20.0)) { continue; }
        p = candidate;
        break;
    }
    if (p == null) { return; }
    owner = APRG_FindHostileOwnerNearPoint(player, p);
    if (owner < 0) { return; }
    heroType = APRG_FindUnusedValidHostileHeroType();
    if (heroType == "") { return; }
    created = UnitCreate(1, heroType, c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
    if (UnitGroupCount(created, c_unitCountAlive) > 0) {
        APRG_MarkHostileHeroFamilyUsed(heroType);
        APRG_RegisterGeneratedHeroGroup(created);
        AISetUnitScriptControlled(UnitGroupUnitFromEnd(created, 1), false);
        UnitGroupAddUnitGroup(g_aprgHostilePatrollers, created);
        UnitGroupAddUnitGroup(g_aprgHeroesOfStormUnits, created);
        g_aprgHostileHeroesSpawned += 1;
        APRG_OrderHeroesOfStormRandomPatrol(UnitGroupUnitFromEnd(created, 1));
    }
}

void APRG_SpawnWraithRaid(int player) {
    point p = APRG_FindRandomMapEdgePoint();
    int owner;
    unitgroup created;
    if (p == null || !CatalogEntryIsValid(c_gameCatalogUnit, "Wraith")) { return; }
    owner = APRG_FindHostileOwnerNearPoint(player, p);
    if (owner < 0) { return; }
    created = UnitCreate(1, "Wraith", c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
    APRG_AddHostileRaiders(created, p, player);
}

fixed APRG_WraithRaidNextInterval(fixed now) {
    fixed progress;
    fixed minimum;
    fixed maximum;
    if (now <= 60.0) { return RandomFixed(10.0, 60.0); }
    if (now >= 720.0) { return RandomFixed(2.0, 10.0); }
    progress = (now - 60.0) / 660.0;
    minimum = 10.0 - (8.0 * progress);
    maximum = 60.0 - (50.0 * progress);
    return RandomFixed(minimum, maximum);
}


point APRG_FindPlayerMineralLinePoint(int player) {
    unit base = APRG_FindPlayerHomeStructure(player);
    unitgroup resources;
    unitgroup minerals = UnitGroupEmpty();
    int i;
    unit u;
    unit nearest;

    if (base == null) { return null; }
    resources = UnitGroup(
        null,
        c_playerAny,
        RegionPlayableMap(),
        UnitFilter(
            (1 << c_targetFilterHarvestableResource),
            0,
            (1 << c_targetFilterMissile),
            (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))
        ),
        0
    );
    i = UnitGroupCount(resources, c_unitCountAlive);
    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(resources, i);
        if (u == null) { break; }
        if (CatalogFieldValueGet(c_gameCatalogUnit, UnitGetType(u), "ResourceType", c_playerAny) == "Minerals") {
            UnitGroupAdd(minerals, u);
        }
    }
    if (UnitGroupCount(minerals, c_unitCountAlive) <= 0) {
        return UnitGetPosition(base);
    }
    nearest = UnitGroupClosestToPoint(minerals, UnitGetPosition(base));
    if (nearest == null) { return UnitGetPosition(base); }
    return UnitGetPosition(nearest);
}

void APRG_SpawnVikingRaid(int player) {
    point spawnPoint;
    point mineralLine;
    int owner;
    int count;
    int minutes;
    int lower;
    int upper;
    unitgroup created;

    if (!CatalogEntryIsValid(c_gameCatalogUnit, "VikingFighter")) { return; }
    spawnPoint = APRG_FindRaidOriginAirPoint(player);
    mineralLine = APRG_FindPlayerMineralLinePoint(player);
    if (spawnPoint == null || mineralLine == null) { return; }
    owner = APRG_FindHostileOwnerNearPoint(player, spawnPoint);
    if (owner < 0) { return; }
    minutes = FixedToInt(GameGetMissionTime() / 60.0);
    lower = 1 + (minutes / 3);
    upper = 3 + (minutes / 2);
    if (upper < lower) { upper = lower; }
    count = RandomInt(lower, upper);
    created = UnitCreate(count, "VikingFighter", c_unitCreateIgnorePlacement, owner, spawnPoint, libNtve_gf_RandomAngle());
    if (created == null || UnitGroupCount(created, c_unitCountAlive) <= 0) { return; }
    APRG_RegisterMutationEnemyGroup(created);
    UnitGroupIssueOrder(created, OrderTargetingPoint(AbilityCommand("move", 0), mineralLine), c_orderQueueReplace);
    UnitGroupIssueOrder(created, Order(AbilityCommand("AssaultMode", 0)), c_orderQueueAddToEnd);
    UnitGroupIssueOrder(created, OrderTargetingPoint(AbilityCommand("attack", 0), mineralLine), c_orderQueueAddToEnd);
}

bool APRG_VoidThrasherPointNearFriendlyUnits(point candidate, int player) {
    unitgroup ownUnits;
    unitgroup alliedUnits;
    int i;
    unit u;
    if (candidate == null) { return true; }
    ownUnits = UnitGroup(
        null, player, RegionCircle(candidate, 20.0),
        UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0
    );
    if (UnitGroupCount(ownUnits, c_unitCountAlive) > 0) { return true; }
    alliedUnits = UnitGroupAlliance(
        player, c_unitAllianceAlly, RegionCircle(candidate, 20.0),
        UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0
    );
    for (i = UnitGroupCount(alliedUnits, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(alliedUnits, i);
        if (u != null && UnitGetOwner(u) != player) { return true; }
    }
    return false;
}

point APRG_FindVoidThrasherPoint(int player) {
    unit base;
    int attempt;
    point candidate;
    point bestPoint;
    unit nearestPlayerStructure;
    fixed nearestDistance;
    fixed homeDistance;
    fixed bestHomeDistance;
    base = APRG_FindPlayerHomeStructure(player);
    if (base == null) { return null; }
    bestPoint = null;
    bestHomeDistance = 99999.0;

    for (attempt = 0; attempt < 128; attempt += 1) {
        candidate = PointWithOffsetPolar(UnitGetPosition(base), RandomFixed(30.0, 70.0), libNtve_gf_RandomAngle());
        if (!RegionContainsPoint(RegionPlayableMap(), candidate) || !PointPathingPassable(candidate)) { continue; }
        if (APRG_GroundSpawnsNeedPlayerPathing() && !PointPathingIsConnected(candidate, UnitGetPosition(base))) { continue; }
        if (APRG_VoidThrasherPointNearFriendlyUnits(candidate, player)) { continue; }
        nearestPlayerStructure = APRG_NearestPlayerStructure(candidate, player);
        if (nearestPlayerStructure == null) { continue; }
        nearestDistance = DistanceBetweenPoints(candidate, UnitGetPosition(nearestPlayerStructure));
        if (nearestDistance < 30.0) { continue; }
        homeDistance = DistanceBetweenPoints(candidate, UnitGetPosition(base));
        if (homeDistance < bestHomeDistance) {
            bestHomeDistance = homeDistance;
            bestPoint = candidate;
        }
    }
    return bestPoint;
}

unitgroup APRG_CreateVoidThrasher(int owner, point p) {
    unitgroup created = UnitGroupEmpty();
    if (CatalogEntryIsValid(c_gameCatalogUnit, "VoidThrasherWalker")) {
        created = UnitCreate(1, "VoidThrasherWalker", c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
        if (created != null && UnitGroupCount(created, c_unitCountAlive) > 0) { return created; }
    }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "VoidThrasher")) {
        created = UnitCreate(1, "VoidThrasher", c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
    }
    return created;
}

unitgroup APRG_PlayerTargetableStructures(int player) {
    return UnitGroup(
        null,
        player,
        RegionPlayableMap(),
        UnitFilter(
            (1 << c_targetFilterStructure),
            0,
            (1 << c_targetFilterMissile) | (1 << c_targetFilterCloaked),
            (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)) | (1 << (c_targetFilterInvulnerable - 32))
        ),
        0
    );
}

void APRG_RegisterVoidThrasherMapVision(unit thrasher, int owner, int player) {
    int slot;
    if (thrasher == null || !UnitIsAlive(thrasher)) { return; }
    APRG_RegisterAlwaysVisibleUnit(thrasher, player);
    for (slot = 0; slot < 32; slot += 1) {
        if (g_aprgVoidThrasherVisionUnits[slot] == null || !UnitIsAlive(g_aprgVoidThrasherVisionUnits[slot])) {
            if (g_aprgVoidThrasherEnemyRevealers[slot] != null) {
                VisRevealerDestroy(g_aprgVoidThrasherEnemyRevealers[slot]);
            }
            g_aprgVoidThrasherVisionUnits[slot] = thrasher;
            g_aprgVoidThrasherEnemyRevealers[slot] = VisRevealerCreate(owner, RegionPlayableMap());
            if (slot >= g_aprgVoidThrasherVisionCount) { g_aprgVoidThrasherVisionCount = slot + 1; }
            return;
        }
    }
}

void APRG_TickVoidThrasherMapVision() {
    int slot;
    for (slot = 0; slot < g_aprgVoidThrasherVisionCount; slot += 1) {
        if (g_aprgVoidThrasherVisionUnits[slot] != null && UnitIsAlive(g_aprgVoidThrasherVisionUnits[slot])) { continue; }
        if (g_aprgVoidThrasherEnemyRevealers[slot] != null) {
            VisRevealerDestroy(g_aprgVoidThrasherEnemyRevealers[slot]);
        }
        g_aprgVoidThrasherVisionUnits[slot] = null;
        g_aprgVoidThrasherEnemyRevealers[slot] = null;
    }
}

void APRG_SpawnVoidThrasher(int player) {
    point p;
    int owner;
    unitgroup created;
    unit thrasher;
    p = APRG_FindVoidThrasherPoint(player);
    if (p == null) { return; }
    owner = APRG_FindHostileOwnerNearPoint(player, p);
    if (owner < 0) { return; }
    created = APRG_CreateVoidThrasher(owner, p);
    if (created == null || UnitGroupCount(created, c_unitCountAlive) <= 0) { return; }
    UnitGroupAddUnitGroup(g_aprgVoidThrashers, created);
    if (UnitGroupUnitFromEnd(created, 1) != null) {
        thrasher = UnitGroupUnitFromEnd(created, 1);
        APRG_StripVoidEntityBehavior(thrasher);
        AISetUnitScriptControlled(thrasher, true);
        UnitSetPropertyFixed(thrasher, c_unitPropMovementSpeed, 0.0);
        DataTableSetFixed(true, "APRG_VoidThrasherNextShot_" + IntToString(UnitGetTag(thrasher)), 0.0);
        APRG_RegisterVoidThrasherMapVision(thrasher, owner, player);
        if (CatalogEntryIsValid(c_gameCatalogAbil, "KaiserWormScourgeMissile")) {
            CatalogFieldValueSet(c_gameCatalogAbil, "KaiserWormScourgeMissile", "Range", owner, "500.0");
        }
    }
    MinimapPing(PlayerGroupSingle(player), p, 6.0, Color(100.0, 0.0, 0.0));
    UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaChat, StringToText("[Slay] Void Thrasher detected."));
}

bool APRG_TryVoidThrasherLocalAbility(unit thrasher, int player) {
    unit target;
    int abilityIndex;
    int abilityCount;
    int commandIndex;
    string abilityType;
    order castOrder;
    if (thrasher == null || !UnitIsAlive(thrasher)) { return false; }
    target = APRG_NearestPlayerHeroAbilityTarget(thrasher, player, 12.0);
    if (target == null) { return false; }

    if (CatalogEntryIsValid(c_gameCatalogAbil, "KaiserWormScourgeMissile")) {
        castOrder = OrderTargetingUnit(AbilityCommand("KaiserWormScourgeMissile", 0), target);
        if (UnitOrderIsValid(thrasher, castOrder)) {
            UnitIssueOrder(thrasher, castOrder, c_orderQueueReplace);
            return true;
        }
        castOrder = OrderTargetingPoint(AbilityCommand("KaiserWormScourgeMissile", 0), UnitGetPosition(target));
        if (UnitOrderIsValid(thrasher, castOrder)) {
            UnitIssueOrder(thrasher, castOrder, c_orderQueueReplace);
            return true;
        }
    }

    abilityCount = MinI(64, UnitAbilityCount(thrasher));
    for (abilityIndex = 1; abilityIndex <= abilityCount; abilityIndex += 1) {
        abilityType = UnitAbilityGet(thrasher, abilityIndex);
        if (abilityType == "" || abilityType == "KaiserWormScourgeMissile" || !APRG_IsCombatHeroAbility(abilityType)) { continue; }
        for (commandIndex = 0; commandIndex < 4; commandIndex += 1) {
            castOrder = OrderTargetingUnit(AbilityCommand(abilityType, commandIndex), target);
            if (UnitOrderIsValid(thrasher, castOrder)) { UnitIssueOrder(thrasher, castOrder, c_orderQueueReplace); return true; }
            castOrder = OrderTargetingPoint(AbilityCommand(abilityType, commandIndex), UnitGetPosition(target));
            if (UnitOrderIsValid(thrasher, castOrder)) { UnitIssueOrder(thrasher, castOrder, c_orderQueueReplace); return true; }
            castOrder = Order(AbilityCommand(abilityType, commandIndex));
            if (UnitOrderIsValid(thrasher, castOrder)) { UnitIssueOrder(thrasher, castOrder, c_orderQueueReplace); return true; }
        }
    }
    return false;
}

void APRG_TickVoidThrashers(int player, fixed now) {
    int i;
    unit thrasher;
    unit target;
    unitgroup structures;
    fixed nextShot;
    string key;
    APRG_TickVoidThrasherMapVision();
    structures = APRG_PlayerTargetableStructures(player);
    if (UnitGroupCount(structures, c_unitCountAlive) <= 0) { return; }
    for (i = UnitGroupCount(g_aprgVoidThrashers, c_unitCountAlive); i > 0; i -= 1) {
        thrasher = UnitGroupUnitFromEnd(g_aprgVoidThrashers, i);
        if (thrasher == null || !UnitIsAlive(thrasher)) { continue; }
        target = UnitGroupClosestToPoint(structures, UnitGetPosition(thrasher));
        if (target == null) { continue; }
        key = "APRG_VoidThrasherNextShot_" + IntToString(UnitGetTag(thrasher));
        nextShot = DataTableGetFixed(true, key);

        UnitSetPropertyFixed(thrasher, c_unitPropMovementSpeed, 0.0);
        if (now < nextShot) { continue; }
        if (APRG_TryVoidThrasherLocalAbility(thrasher, player)) {
            DataTableSetFixed(true, key, now + 4.0);
            continue;
        }
        if (CatalogEntryIsValid(c_gameCatalogAbil, "KaiserWormScourgeMissile")) {
            UnitIssueOrder(thrasher, OrderTargetingUnit(AbilityCommand("KaiserWormScourgeMissile", 0), target), c_orderQueueReplace);
        }
        else {
            UnitIssueOrder(thrasher, OrderTargetingUnit(AbilityCommand("attack", 0), target), c_orderQueueReplace);
        }
        DataTableSetFixed(true, key, now + 4.0);
    }
}

void APRG_ApplySquishy(int player) {
    unitgroup units = APRG_PlayerAllUnits(player);
    int i = UnitGroupCount(units, c_unitCountAlive);
    unit u;
    string unitType;
    string key;

    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null) { break; }
        unitType = UnitGetType(u);
        key = "APRG_Squishy_" + IntToString(player) + "_" + unitType;
        CatalogFieldValueSet(c_gameCatalogUnit, unitType, "LifeArmor", player, "0");
        CatalogFieldValueSet(c_gameCatalogUnit, unitType, "ShieldArmor", player, "0");
        DataTableSetBool(true, key, true);
    }
}

bool APRG_ForcedVariety_Func(bool testConds, bool runActions) {
    string unitType;
    fixed mineralCost;
    fixed gasCost;
    int player;

    if (!runActions || !g_aprgStarted || !APRG_HasMutation(APRG_MUT_FORCED_VARIETY)) { return true; }
    player = APRG_GetPrimaryPlayer();
    if (EventPlayer() != player) { return true; }
    unitType = libNtve_gf_TriggeringProgressUnitType();
    if (unitType == "" || !CatalogEntryIsValid(c_gameCatalogUnit, unitType)) { return true; }

    mineralCost = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "CostResource[0]", player));
    gasCost = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "CostResource[1]", player));
    if (mineralCost > 0.0) {
        CatalogFieldValueSet(
            c_gameCatalogUnit, unitType, "CostResource[0]", player,
            IntToString(FixedToInt(RoundI(mineralCost * 1.02)))
        );
    }
    if (gasCost > 0.0) {
        CatalogFieldValueSet(
            c_gameCatalogUnit, unitType, "CostResource[1]", player,
            IntToString(FixedToInt(RoundI(gasCost * 1.02)))
        );
    }
    return true;
}




const int APRG_UNEXPECTED_CANDIDATE_COUNT = 30;

string APRG_UnexpectedCandidate(int index) {
    if (index == 0) { return "Marine"; }
    if (index == 1) { return "Marauder"; }
    if (index == 2) { return "Firebat"; }
    if (index == 3) { return "Hellion"; }
    if (index == 4) { return "Goliath"; }
    if (index == 5) { return "SiegeTank"; }
    if (index == 6) { return "VikingFighter"; }
    if (index == 7) { return "Banshee"; }
    if (index == 8) { return "Battlecruiser"; }
    if (index == 9) { return "Thor"; }
    if (index == 10) { return "Zergling"; }
    if (index == 11) { return "Roach"; }
    if (index == 12) { return "Hydralisk"; }
    if (index == 13) { return "Mutalisk"; }
    if (index == 14) { return "Infestor"; }
    if (index == 15) { return "Ultralisk"; }
    if (index == 16) { return "BroodLord"; }
    if (index == 17) { return "Zealot"; }
    if (index == 18) { return "Stalker"; }
    if (index == 19) { return "Dragoon"; }
    if (index == 20) { return "Sentry"; }
    if (index == 21) { return "HighTemplar"; }
    if (index == 22) { return "Immortal"; }
    if (index == 23) { return "Colossus"; }
    if (index == 24) { return "VoidRay"; }
    if (index == 25) { return "Carrier"; }
    if (index == 26) { return "Tempest"; }
    if (index == 27) { return "Archon"; }
    if (index == 28) { return "Diamondback"; }
    if (index == 29) { return "Lurker"; }
    return "";
}

fixed APRG_UnitResourceCost(string unitType, int player) {
    fixed minerals;
    fixed gas;
    if (unitType == "" || !CatalogEntryIsValid(c_gameCatalogUnit, unitType)) { return -1.0; }
    minerals = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "CostResource[0]", player));
    gas = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "CostResource[1]", player));
    return minerals + gas;
}

string APRG_UnexpectedEvolutionCanonicalType(int player, string candidate) {
    if (
        candidate == "Stalker" &&
        CatalogEntryIsValid(c_gameCatalogUnit, "StalkerShakuras") &&
        APRG_PlayerSpawnCandidateHealthy(player, "StalkerShakuras", false)
    ) { return "StalkerShakuras"; }
    return candidate;
}

string APRG_FindUnexpectedEvolutionReplacement(int player, string trainedType) {
    fixed trainedCost;
    fixed candidateCost;
    int eligibleCount;
    int targetEligible;
    int i;
    string candidate;

    trainedCost = APRG_UnitResourceCost(trainedType, player);
    if (trainedCost < 0.0) { return ""; }

    eligibleCount = 0;
    for (i = 0; i < APRG_UNEXPECTED_CANDIDATE_COUNT; i += 1) {
        candidate = APRG_UnexpectedCandidate(i);
        if (candidate == "" || candidate == trainedType || !CatalogEntryIsValid(c_gameCatalogUnit, candidate)) { continue; }
        candidateCost = APRG_UnitResourceCost(candidate, player);
        if (candidateCost > trainedCost) { eligibleCount += 1; }
    }
    if (eligibleCount <= 0) { return ""; }

    targetEligible = RandomInt(1, eligibleCount);
    eligibleCount = 0;
    for (i = 0; i < APRG_UNEXPECTED_CANDIDATE_COUNT; i += 1) {
        candidate = APRG_UnexpectedCandidate(i);
        if (candidate == "" || candidate == trainedType || !CatalogEntryIsValid(c_gameCatalogUnit, candidate)) { continue; }
        candidateCost = APRG_UnitResourceCost(candidate, player);
        if (candidateCost <= trainedCost) { continue; }
        eligibleCount += 1;
        if (eligibleCount == targetEligible) { return APRG_UnexpectedEvolutionCanonicalType(player, candidate); }
    }
    return "";
}

void APRG_EnsureBlinkOnUnit(int player, unit u);

bool APRG_OccasionalBlessing_Func(bool testConds, bool runActions) {
    int player;
    int roll;
    int threshold;
    unit trained;
    string trainedType;
    string replacementType;
    point p;
    fixed facing;
    unitgroup created;
    unit replacement;

    if (!runActions || !g_aprgStarted) { return true; }
    if (
        !APRG_HasExtension(APRG_EXT_BLESS_OCCASIONAL_THOR) &&
        !APRG_HasExtension(APRG_EXT_BLESS_OCCASIONAL_ULTRALISK) &&
        !APRG_HasExtension(APRG_EXT_BLESS_OCCASIONAL_COLOSSUS) &&
        !APRG_HasExtension(APRG_EXT_BLESS_UNEXPECTED_EVOLUTION)
    ) {
        return true;
    }

    player = APRG_GetPrimaryPlayer();
    if (EventPlayer() != player) { return true; }
    trained = EventUnitProgressUnit();
    if (trained == null || !UnitIsAlive(trained)) { return true; }
    trainedType = UnitGetType(trained);

    roll = RandomInt(1, 10000);
    threshold = 0;
    replacementType = "";

    if (APRG_HasExtension(APRG_EXT_BLESS_OCCASIONAL_THOR)) {
        threshold += 400;
        if (roll <= threshold) { replacementType = "Thor"; }
    }
    if (replacementType == "" && APRG_HasExtension(APRG_EXT_BLESS_OCCASIONAL_ULTRALISK)) {
        threshold += 400;
        if (roll <= threshold) { replacementType = "Ultralisk"; }
    }
    if (replacementType == "" && APRG_HasExtension(APRG_EXT_BLESS_OCCASIONAL_COLOSSUS)) {
        threshold += 400;
        if (roll <= threshold) { replacementType = "Colossus"; }
    }
    if (replacementType == "" && APRG_HasExtension(APRG_EXT_BLESS_UNEXPECTED_EVOLUTION)) {
        threshold += 2000;
        if (roll <= threshold) {
            replacementType = APRG_FindUnexpectedEvolutionReplacement(player, trainedType);
        }
    }
    if (
        replacementType == "" ||
        !CatalogEntryIsValid(c_gameCatalogUnit, replacementType) ||
        trainedType == replacementType
    ) {
        return true;
    }

    replacementType = APRG_PlayerSpawnCatalogTypeForPlayer(replacementType, player);
    p = UnitGetPosition(trained);
    facing = UnitGetFacing(trained);

    libNtve_gf_ReplaceUnit(trained, replacementType, libNtve_ge_ReplaceUnitOptions_OldUnitsRelative);
    replacement = libNtve_gf_LastReplacedUnit();
    if (replacement != null && APRG_HasExtension(APRG_EXT_BLESS_BLINK)) { APRG_EnsureBlinkOnUnit(player, replacement); }
    return true;
}


bool APRG_IsOccasionalReplacementSource(string unitType) {
    return (
        unitType == "Marine" ||
        unitType == "Zealot" ||
        unitType == "Zergling" ||
        unitType == "Marauder" ||
        unitType == "Firebat" ||
        unitType == "Hellion" ||
        unitType == "Goliath" ||
        unitType == "Stalker" ||
        unitType == "Dragoon" ||
        unitType == "Roach" ||
        unitType == "Hydralisk"
    );
}

void APRG_ApplyOccasionalEnemyReplacement(int player, string replacementType) {
    unitgroup enemies;
    unitgroup created;
    int i;
    int slot;
    unit u;
    unit replacement;
    string unitType;
    point p;
    int owner;
    if (!CatalogEntryIsValid(c_gameCatalogUnit, replacementType)) { return; }
    enemies = APRG_EnemyMobileUnits(player);
    for (i = UnitGroupCount(enemies, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(enemies, i); if (u == null) { break; }
        unitType = UnitGetType(u);
        if (!APRG_IsOccasionalReplacementSource(unitType) || RandomInt(1, 80) > 1) { continue; }
        p = UnitGetPosition(u); owner = UnitGetOwner(u); UnitRemove(u);
        created = UnitCreate(1, replacementType, c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
        replacement = UnitGroupUnitFromEnd(created, 1);
        if (replacement != null && g_aprgOccasionalRaidCount < 128) {
            slot = g_aprgOccasionalRaidCount; g_aprgOccasionalRaidUnits[slot] = replacement;
            g_aprgOccasionalRaidTimes[slot] = GameGetMissionTime() + 300.0; g_aprgOccasionalRaidCount += 1;
        }
    }
}

void APRG_ApplyEnemyRegeneration(int player) {
    unitgroup enemies = APRG_EnemyAllUnits(player);
    int i = UnitGroupCount(enemies, c_unitCountAlive);
    unit u;
    fixed current;
    fixed maximum;
    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(enemies, i);
        if (u == null) { break; }

        maximum = UnitGetPropertyFixed(u, c_unitPropLifeMax, c_unitPropCurrent);
        current = UnitGetPropertyFixed(u, c_unitPropLife, c_unitPropCurrent);
        if (maximum > 0.0 && current < maximum) {
            UnitSetPropertyFixed(u, c_unitPropLife, MinF(maximum, current + 5.0));
        }

        maximum = UnitGetPropertyFixed(u, c_unitPropShieldsMax, c_unitPropCurrent);
        current = UnitGetPropertyFixed(u, c_unitPropShields, c_unitPropCurrent);
        if (maximum > 0.0 && current < maximum) {
            UnitSetPropertyFixed(u, c_unitPropShields, MinF(maximum, current + 5.0));
        }
    }
}

void APRG_ApplyBlindingLight(int player) {
    unitgroup enemies = APRG_EnemyAllUnits(player);
    int i = UnitGroupCount(enemies, c_unitCountAlive);
    unit u;
    int owner;
    string unitType;
    string key;
    fixed sight;
    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(enemies, i);
        if (u == null) { break; }
        if (APRG_IsRakShirObjectiveUnit(u)) { continue; }
        owner = UnitGetOwner(u);
        if (owner < 0) { continue; }
        unitType = UnitGetType(u);
        key = "APRG_BlindingLight_" + IntToString(owner) + "_" + unitType;
        if (DataTableGetBool(true, key)) { continue; }
        sight = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "Sight", owner));
        sight = MaxF(0.0, sight - 4.0);
        CatalogFieldValueSet(c_gameCatalogUnit, unitType, "Sight", owner, FixedToString(sight, c_fixedPrecisionAny));
        DataTableSetBool(true, key, true);
    }
}

void APRG_GiveSpecialistsIfReady(int player) {
    unit home;
    point p;
    string unitType;
    string preferredType;
    int i;
    unitgroup created;
    unit specialist;
    if (g_aprgSpecialistsGiven || !APRG_PlayerMacroBaseReady(player)) { return; }
    home = APRG_FindPlayerHomeStructure(player);
    if (home == null) { return; }
    p = APRG_FindGroundPointNear(UnitGetPosition(home), 4.0, 9.0);
    if (p == null) { return; }

    for (i = 0; i < 10; i += 1) {
        unitType = "";
        preferredType = "";
        if (i == 0) {
            unitType = "Ghost";
            preferredType = "AP_Ghost";
        }
        else if (i == 1) { unitType = "Raven"; }
        else if (i == 2) { unitType = "ScienceVessel"; }
        else if (i == 3) {
            unitType = "Infestor";
            preferredType = "AP_Infestor";
        }
        else if (i == 4) {
            if (APRG_PlayerSpawnCandidateHealthy(player, "DefilerMP", false)) { unitType = "DefilerMP"; }
        }
        else if (i == 5) {
            unitType = "Spectre";
            preferredType = "AP_Spectre";
        }
        else if (i == 6) { unitType = "Viper"; }
        else if (i == 7) {
            if (CatalogEntryIsValid(c_gameCatalogUnit, "AP_HighTemplar")) { unitType = "AP_HighTemplar"; }
            else if (CatalogEntryIsValid(c_gameCatalogUnit, "HighTemplar")) { unitType = "HighTemplar"; }
            else if (CatalogEntryIsValid(c_gameCatalogUnit, "HighTemplarShakuras")) { unitType = "HighTemplarShakuras"; }
        }
        else if (i == 8) {
            unitType = "Sentry";
            preferredType = "AP_SentryAiur";
        }
        else if (i == 9) {
            unitType = "Oracle";
            preferredType = "AP_Oracle";
        }
        if (unitType != "" && CatalogEntryIsValid(c_gameCatalogUnit, unitType)) {
            if (unitType == "DefilerMP") {
                created = APRG_CreatePlayerUnitsVanillaSafe(1, unitType, player, p, libNtve_gf_RandomAngle());
            }
            else if (preferredType != "") {
                created = APRG_CreatePreferredPlayerUnitsSafe(1, preferredType, unitType, player, p, libNtve_gf_RandomAngle());
            }
            else {
                created = APRG_CreatePlayerUnitsSafe(1, unitType, player, p, libNtve_gf_RandomAngle());
            }
            specialist = UnitGroupUnitFromEnd(created, 1);
        }
    }
    g_aprgSpecialistsGiven = true;
}

void APRG_ApplyFortifications(int player) {
    unitgroup structures = APRG_PlayerStructures(player);
    int i = UnitGroupCount(structures, c_unitCountAlive);
    unit u;
    string unitType;
    string key;
    fixed armor;
    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(structures, i);
        if (u == null) { break; }
        unitType = UnitGetType(u);
        key = "APRG_Fortifications_" + IntToString(player) + "_" + unitType;
        if (DataTableGetBool(true, key)) { continue; }

        armor = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "LifeArmor", player));
        CatalogFieldValueSet(c_gameCatalogUnit, unitType, "LifeArmor", player, FixedToString(armor + 5.0, c_fixedPrecisionAny));
        armor = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "ShieldArmor", player));
        CatalogFieldValueSet(c_gameCatalogUnit, unitType, "ShieldArmor", player, FixedToString(armor + 5.0, c_fixedPrecisionAny));
        DataTableSetBool(true, key, true);
    }
}

int APRG_FindBanelingSource(unit base) {
    int i;
    for (i = 0; i < APRG_MAX_CONGA_SOURCES; i += 1) {
        if (g_aprgBanelingSources[i] == base) { return i; }
    }
    return -1;
}

int APRG_FindFreeBanelingSource() {
    int i;
    for (i = 0; i < APRG_MAX_CONGA_SOURCES; i += 1) {
        if (g_aprgBanelingSources[i] == null) { return i; }
    }
    return -1;
}

void APRG_RegisterBanelingSource(unit base, fixed now) {
    int slot;
    if (base == null || !UnitIsAlive(base) || !APRG_IsTownHallType(UnitGetType(base))) { return; }
    if (APRG_FindBanelingSource(base) >= 0) { return; }
    slot = APRG_FindFreeBanelingSource();
    if (slot < 0) { return; }
    g_aprgBanelingSources[slot] = base;
    g_aprgBanelingNextTime[slot] = now + RandomFixed(5.0, 15.0);
}

void APRG_RegisterBanelingSources(int player, fixed now) {
    unitgroup structures = APRG_PlayerStructures(player);
    int i = UnitGroupCount(structures, c_unitCountAlive);
    unit base;

    for (; i > 0; i -= 1) {
        base = UnitGroupUnitFromEnd(structures, i);
        if (base == null) { break; }
        if (APRG_IsTownHallType(UnitGetType(base))) {
            APRG_RegisterBanelingSource(base, now);
        }
    }
}

unitgroup APRG_CreatePlayerBaneling(int player, point p) {
    unitgroup created;
    if (!CatalogEntryIsValid(c_gameCatalogUnit, "Baneling")) { return UnitGroupEmpty(); }
    // Baneling Stream is intentionally a self-guided combat unit. Some AP
    // production variants lack the normal suicide attack order, so spawn the
    // campaign Baneling directly instead of substituting an AP alias.
    created = APRG_CreatePlayerUnitsVanillaSafe(1, "Baneling", player, p, libNtve_gf_RandomAngle());
    if (created != null && UnitGroupCount(created, c_unitCountAlive) > 0) { return created; }
    return UnitCreate(1, "Baneling", c_unitCreateIgnorePlacement, player, p, libNtve_gf_RandomAngle());
}

unit APRG_NearestEnemyGroundMobile(point fromPoint, int player) {
    unitgroup units = UnitGroupFilterPlane(APRG_EnemyMobileUnits(player), c_planeGround, 0);
    if (UnitGroupCount(units, c_unitCountAlive) <= 0) { return null; }
    return UnitGroupClosestToPoint(units, fromPoint);
}

void APRG_OrderBanelingStreamUnit(unit u, int player) {
    unit target;
    unit building;
    point destination;
    if (u == null || !UnitIsAlive(u)) { return; }
    // Prefer mobile ground units for a suicide unit, but attack-move TOWARD
    // the target (not a unit-target attack command that can stop on the way).
    target = APRG_NearestEnemyGroundMobile(UnitGetPosition(u), player);
    if (RandomInt(0, 1) == 0 || target == null) {
        building = APRG_NearestPathableEnemyStructure(u, player);
        if (building != null) { target = building; }
    }
    if (target != null && !UnitPathableToPoint(u, UnitGetPosition(target), 3.0, 100000.0)) { target = null; }
    if (target != null) {
        destination = UnitGetPosition(target);
        if (APRG_OrderAttackMove(u, destination)) { return; }
    }
    // No target or temporarily unavailable attack ability: keep looking for
    // targets along a pathable attack-move patrol instead of standing idle.
    destination = APRG_RandomFixedPatrolPointForUnit(u, player, true);
    if (destination != null) { APRG_OrderAttackMove(u, destination); }
}

void APRG_TickBanelingStream(int player, fixed now) {
    int i;
    unit base;
    point p;
    unitgroup created;

    APRG_RegisterBanelingSources(player, now);
    for (i = 0; i < APRG_MAX_CONGA_SOURCES; i += 1) {
        base = g_aprgBanelingSources[i];
        if (base == null) { continue; }
        if (!UnitIsAlive(base) || UnitGetOwner(base) != player || !APRG_IsTownHallType(UnitGetType(base))) {
            g_aprgBanelingSources[i] = null;
            g_aprgBanelingNextTime[i] = 0.0;
            continue;
        }
        if (now < g_aprgBanelingNextTime[i]) { continue; }
        p = APRG_FindGroundPointNear(UnitGetPosition(base), 3.0, 8.0);
        if (p == null) { p = UnitGetPosition(base); }
        created = APRG_CreatePlayerBaneling(player, p);
        if (created != null && UnitGroupCount(created, c_unitCountAlive) > 0) {
            APRG_MakeGroupUncommandable(created);
            UnitGroupAddUnitGroup(g_aprgBanelingStreamUnits, created);
            APRG_OrderBanelingStreamUnit(UnitGroupUnitFromEnd(created, 1), player);
        }
        g_aprgBanelingNextTime[i] = now + RandomFixed(5.0, 15.0);
    }

    if (now >= g_aprgNextBanelingStreamRetargetTime) {
        for (i = UnitGroupCount(g_aprgBanelingStreamUnits, c_unitCountAlive); i > 0; i -= 1) {
            APRG_OrderBanelingStreamUnit(UnitGroupUnitFromEnd(g_aprgBanelingStreamUnits, i), player);
        }
        g_aprgNextBanelingStreamRetargetTime = now + 8.0;
    }
}

unit APRG_CreateTychusAtHome(int player) {
    unit home;
    point p;
    unitgroup created;
    if (!CatalogEntryIsValid(c_gameCatalogUnit, "TychusCommando")) { return null; }
    home = APRG_FindPlayerHomeStructure(player);
    if (home == null) { return null; }
    p = APRG_FindGroundPointNear(UnitGetPosition(home), 4.0, 8.0);
    if (p == null) { return null; }
    created = APRG_CreatePlayerUnitsSafe(1, "TychusCommando", player, p, libNtve_gf_RandomAngle());
    if (created == null || UnitGroupCount(created, c_unitCountAlive) <= 0) { return null; }
    return UnitGroupUnitFromEnd(created, 1);
}

void APRG_GiveTychusIfReady(int player, fixed now) {
    if (g_aprgTychusGiven || !APRG_PlayerMacroBaseReady(player)) { return; }
    if (!CatalogEntryIsValid(c_gameCatalogUnit, "TychusCommando")) {
        g_aprgTychusGiven = true;
        return;
    }
    g_aprgTychus = APRG_CreateTychusAtHome(player);
    if (g_aprgTychus != null) {
        g_aprgNextTychusOrderTime = now;
        g_aprgTychusDeathTime = -1.0;
    }
    g_aprgTychusGiven = true;
}

void APRG_TickTychus(int player, fixed now) {
    unit target;
    if (!g_aprgTychusGiven) { APRG_GiveTychusIfReady(player, now); }
    if (!g_aprgTychusGiven) { return; }

    if (g_aprgTychus == null) {
        if (g_aprgTychusDeathTime < 0.0) { g_aprgTychusDeathTime = now; }
        if (now - g_aprgTychusDeathTime >= 15.0) {
            g_aprgTychus = APRG_CreateTychusAtHome(player);
            if (g_aprgTychus != null) {
                g_aprgTychusDeathTime = -1.0;
                g_aprgNextTychusOrderTime = now + RandomFixed(10.0, 25.0);
            }
        }
        return;
    }
    if (!UnitIsAlive(g_aprgTychus)) {
        if (g_aprgTychusDeathTime < 0.0) { g_aprgTychusDeathTime = now; }
        if (now - g_aprgTychusDeathTime >= 15.0) {
            UnitRevive(g_aprgTychus);
            if (UnitIsAlive(g_aprgTychus)) {
                UnitSetPropertyFixed(g_aprgTychus, c_unitPropLifePercent, 100.0);
                g_aprgTychusDeathTime = -1.0;
                g_aprgNextTychusOrderTime = now + RandomFixed(10.0, 25.0);
            }
        }
        return;
    }
    g_aprgTychusDeathTime = -1.0;
    if (now < g_aprgNextTychusOrderTime) { return; }
    target = APRG_NearestEligibleEnemyStructure(UnitGetPosition(g_aprgTychus), player);
    if (target != null) {
        APRG_OrderAttackMove(g_aprgTychus, UnitGetPosition(target));
    }
    g_aprgNextTychusOrderTime = now + RandomFixed(10.0, 25.0);
}

void APRG_TickZagarasAid(int player, fixed now) {
    unit home;
    point p;
    if (!APRG_PlayerMacroBaseReady(player) || now < g_aprgNextZagaraAidTime) { return; }
    if (!CatalogEntryIsValid(c_gameCatalogUnit, "Baneling")) {
        g_aprgNextZagaraAidTime = now + 600.0;
        return;
    }
    home = APRG_FindPlayerHomeStructure(player);
    if (home == null) {
        g_aprgNextZagaraAidTime = now + 1.0;
        return;
    }
    p = APRG_FindGroundPointNear(UnitGetPosition(home), 4.0, 10.0);
    if (p == null) {
        g_aprgNextZagaraAidTime = now + 1.0;
        return;
    }
    APRG_CreatePlayerUnitsSafe(100, "Baneling", player, p, libNtve_gf_RandomAngle());
    g_aprgNextZagaraAidTime = now + 600.0;
}

void APRG_ApplyLogistics(int player) {
    PlayerModifyPropertyFixed(player, c_playerPropSuppliesLimit, c_playerPropOperSetTo, 400.0);
}

void APRG_BeginNuclearAnnihilation(int player, fixed now) {
    point p;
    int owner;

    if (g_aprgNukePending) { return; }
    if (
        !CatalogEntryIsValid(c_gameCatalogModel, "GhostNukeIndicator") ||
        !CatalogEntryIsValid(c_gameCatalogEffect, "NukeDamage")
    ) { return; }

    p = RegionRandomPoint(RegionPlayableMap());
    if (p == null) { return; }
    owner = APRG_FindHostileOwnerNearPoint(player, p);
    if (owner < 0) { return; }

    g_aprgNukeIndicator = libNtve_gf_CreateModelAtPoint("GhostNukeIndicator", p);
    PingCreate(PlayerGroupAll(), "PingWarning", p, ColorWithAlpha(100.00, 0.00, 0.00, 0.00), 16.0);
    PingSetScale(PingLastCreated(), 1.5);
    g_aprgPendingNukePoint = p;
    g_aprgPendingNukeOwner = owner;
    g_aprgNukeDetonateTime = now + 19.0;
    g_aprgNukeFinalWarningShown = false;
    g_aprgNukePending = true;
}

void APRG_TickNuclearAnnihilation(int player, fixed now) {
    if (!APRG_PlayerMacroBaseReady(player) || g_aprgMacroReadyTime < 0.0) {
        if (g_aprgNukePending) {
            if (g_aprgNukeIndicator != null) { ActorSend(g_aprgNukeIndicator, "Destroy"); }
            g_aprgNukePending = false;
            g_aprgNukeFinalWarningShown = false;
            g_aprgPendingNukePoint = null;
            g_aprgPendingNukeOwner = -1;
            g_aprgNukeIndicator = null;
        }
        return;
    }
    if (g_aprgNextNukeTime < g_aprgMacroReadyTime + 30.0) {
        g_aprgNextNukeTime = g_aprgMacroReadyTime + 30.0;
    }
    if (
        g_aprgNukePending &&
        !g_aprgNukeFinalWarningShown &&
        now >= g_aprgNukeDetonateTime - 5.0
    ) {
        PingCreate(
            PlayerGroupAll(), "PingWarning", g_aprgPendingNukePoint,
            ColorWithAlpha(100.00, 0.00, 0.00, 0.00), 5.0
        );
        PingSetScale(PingLastCreated(), 2.0);
        g_aprgNukeFinalWarningShown = true;
    }
    if (g_aprgNukePending && now >= g_aprgNukeDetonateTime) {
        PlayerCreateEffectPoint(g_aprgPendingNukeOwner, "NukeDamage", g_aprgPendingNukePoint);
        if (g_aprgNukeIndicator != null) {
            ActorSend(g_aprgNukeIndicator, "Destroy");
        }
        g_aprgNukePending = false;
        g_aprgNukeFinalWarningShown = false;
        g_aprgPendingNukePoint = null;
        g_aprgPendingNukeOwner = -1;
        g_aprgNukeIndicator = null;
    }
    if (!g_aprgNukePending && now >= g_aprgNextNukeTime) {
        APRG_BeginNuclearAnnihilation(player, now);
        g_aprgNextNukeTime = now + 30.0;
    }
}

void APRG_EnforceNotEnoughEnergy(int player) {
    unitgroup units;
    int i;
    unit u;
    fixed energy;
    fixed now = GameGetMissionTime();
    if (now < g_aprgNextEnergyLeakTime) { return; }
    g_aprgNextEnergyLeakTime = now + 3.0;
    units = APRG_PlayerAllUnits(player);
    for (i = UnitGroupCount(units, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null) { break; }
        energy = UnitGetPropertyFixed(u, c_unitPropEnergy, c_unitPropCurrent);
        if (energy > 0.0) { UnitSetPropertyFixed(u, c_unitPropEnergy, MaxF(0.0, energy - 1.0)); }
    }
}

void APRG_ApplyEnergyOverload(int player) {
    unitgroup units = APRG_PlayerMobileUnits(player);
    int i = UnitGroupCount(units, c_unitCountAlive);
    unit u;
    fixed regen;
    fixed maxEnergy;
    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null) {
            break;
        }
        if (UnitGroupHasUnit(g_aprgEnergyOverloadProcessed, u)) {
            continue;
        }
        maxEnergy = UnitGetPropertyFixed(u, c_unitPropEnergyMax, c_unitPropCurrent);
        regen = UnitGetPropertyFixed(u, c_unitPropEnergyRegen, c_unitPropNormal);
        if (maxEnergy > 0.0 && regen > 0.0) {
            UnitSetPropertyFixed(u, c_unitPropEnergyRegen, regen * 3.0);
        }
        UnitGroupAdd(g_aprgEnergyOverloadProcessed, u);
    }
}



void APRG_SetGroupLife(unitgroup group, fixed life) {
    int i;
    unit u;
    if (group == null || life <= 0.0) { return; }
    i = UnitGroupCount(group, c_unitCountAlive);
    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(group, i);
        if (u == null) { break; }
        UnitSetPropertyFixed(u, c_unitPropLifeMax, life);
        UnitSetPropertyFixed(u, c_unitPropLife, life);
    }
}

unitgroup APRG_CreateRealGorgon(int owner, point p) {
    unitgroup created;
    unit u;
    if (owner < 0 || p == null) { return UnitGroupEmpty(); }
    if (!CatalogEntryIsValid(c_gameCatalogUnit, "GehennaCruiser")) { return UnitGroupEmpty(); }
    created = UnitCreate(1, "GehennaCruiser", c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
    if (created == null || UnitGroupCount(created, c_unitCountAlive) <= 0) { return UnitGroupEmpty(); }
    u = UnitGroupUnitFromEnd(created, 1);
    if (u != null) {
        libNtve_gf_SendActorMessageToUnit(u, "AnimCopy ::external.GorgonFinderTag");
    }
    return created;
}

void APRG_SpawnAlliedGorgon(int player) {
    unit home;
    point p;
    unitgroup created;
    home = APRG_FindPlayerHomeStructure(player);
    if (home == null) { return; }

    p = PointWithOffsetPolar(UnitGetPosition(home), RandomFixed(5.0, 10.0), libNtve_gf_RandomAngle());
    if (p == null || !RegionContainsPoint(RegionPlayableMap(), p)) { p = UnitGetPosition(home); }
    created = APRG_CreateRealGorgon(player, p);
    if (created == null || UnitGroupCount(created, c_unitCountAlive) <= 0) { return; }
    APRG_SetGroupLife(created, 100.0);
    if (UnitGroupUnitFromEnd(created, 1) != null) {
        DataTableSetBool(true, "APRG_WarfieldGorgon_" + IntToString(UnitGetTag(UnitGroupUnitFromEnd(created, 1))), true);
    }
    APRG_AddAlliedSupport(created, p, player, true);
    APRG_PlayRandomWarfieldGorgonCall();
}

void APRG_SpawnEnemyGorgon(int player) {
    point p;
    int owner;
    unitgroup created;
    p = APRG_FindRaidOriginAirPoint(player);
    if (p == null) { return; }
    owner = APRG_FindHostileOwnerNearPoint(player, p);
    if (owner < 0) { return; }
    created = APRG_CreateRealGorgon(owner, p);
    if (created == null || UnitGroupCount(created, c_unitCountAlive) <= 0) { return; }
    APRG_EnsureAirReachableToPlayer(UnitGroupUnitFromEnd(created, 1), player);
    APRG_SetGroupLife(created, 100.0);
    if (UnitGroupUnitFromEnd(created, 1) != null) {
        DataTableSetBool(true, "APRG_WarfieldGorgon_" + IntToString(UnitGetTag(UnitGroupUnitFromEnd(created, 1))), true);
    }
    APRG_AddHostileRaiders(created, p, player);
    APRG_PlayRandomWarfieldGorgonCall();
}

void APRG_TickGorgons(int player, fixed now) {
    if (APRG_HasExtension(APRG_EXT_BLESS_ANOTHER_GORGON) && now >= g_aprgNextGorgonBlessingTime) {
        APRG_SpawnAlliedGorgon(player); g_aprgNextGorgonBlessingTime = now + 60.0;
    }
    if (APRG_HasExtension(APRG_EXT_MUT_ANOTHER_GORGON) && APRG_PlayerMacroBaseReady(player)) {
        if (g_aprgMacroReadyTime >= 0.0 && g_aprgNextGorgonMutationTime < g_aprgMacroReadyTime + 120.0) { g_aprgNextGorgonMutationTime = g_aprgMacroReadyTime + 120.0; }
        if (now >= g_aprgNextGorgonMutationTime) { APRG_SpawnEnemyGorgon(player); g_aprgNextGorgonMutationTime = now + 60.0; }
    }
}


void APRG_TickBurrowedZerglings(int player) {
    int burst;
    point p;
    unit base;
    unitgroup created;
    unitgroup playerUnits;
    int i;
    unit u;
    unit nearest;
    unit target;
    int owner;

    if (!CatalogEntryIsValid(c_gameCatalogUnit, "ZerglingBurrowed")) { return; }

    base = APRG_FindPlayerHomeStructure(player);
    if (!APRG_PlayerMacroBaseReady(player) || base == null) { return; }
    burst = 0;
    while (
        burst < 10 &&
        g_aprgBurrowedZerglingsSpawned < 150 &&
        g_aprgBurrowedZerglingAttempts < 1000
    ) {
        burst += 1;
        g_aprgBurrowedZerglingAttempts += 1;
        p = APRG_FindRandomGroundPoint();
        if (p == null) { continue; }
        if (!PointPathingIsConnected(p, UnitGetPosition(base))) { continue; }
        if (DistanceBetweenPoints(p, UnitGetPosition(base)) < 30.0) { continue; }
        owner = APRG_FindHostileOwnerNearPoint(player, p);
        if (owner < 0) { continue; }
        created = UnitCreate(1, "ZerglingBurrowed", c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
        u = UnitGroupUnitFromEnd(created, 1);
        if (u != null) {
            UnitIssueOrder(u, OrderSetAutoCast(AbilityCommand("BurrowZerglingUp", 0), true), c_orderQueueReplace);
            UnitGroupAdd(g_aprgBurrowedZerglings, u);
            g_aprgBurrowedZerglingsSpawned += 1;
        }
    }

    playerUnits = APRG_PlayerMobileUnits(player);
    i = UnitGroupCount(g_aprgBurrowedZerglings, c_unitCountAlive);
    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(g_aprgBurrowedZerglings, i);
        if (u == null || !UnitIsAlive(u)) { continue; }
        nearest = UnitGroupClosestToPoint(playerUnits, UnitGetPosition(u));
        if (nearest == null || DistanceBetweenPoints(UnitGetPosition(u), UnitGetPosition(nearest)) > 8.0) { continue; }

        UnitIssueOrder(u, Order(AbilityCommand("BurrowZerglingUp", 0)), c_orderQueueReplace);
        target = APRG_NearestPlayerStructure(UnitGetPosition(u), player);
        if (target != null) {
            UnitIssueOrder(
                u,
                OrderTargetingPoint(AbilityCommand("attack", 0), UnitGetPosition(target)),
                c_orderQueueAddToEnd
            );
        }
        UnitGroupAdd(g_aprgHostileRaiders, u);
        UnitGroupRemove(g_aprgBurrowedZerglings, u);
    }
}

bool APRG_AddBestDonorWeapon(unit target, string donorType, point p, int owner, fixed minimumRange) {
    unitgroup donorGroup;
    unit donor;
    int count;
    int i;
    int bestIndex;
    fixed bestRange;
    fixed range;
    string weaponType;

    if (target == null || p == null || !CatalogEntryIsValid(c_gameCatalogUnit, donorType)) { return false; }
    donorGroup = UnitCreate(1, donorType, c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
    donor = UnitGroupUnitFromEnd(donorGroup, 1);
    if (donor == null) { return false; }
    count = UnitWeaponCount(donor);
    bestIndex = 0;
    bestRange = minimumRange;
    for (i = 1; i <= count; i += 1) {
        if (!UnitWeaponIsEnabled(donor, i)) { continue; }
        range = UnitWeaponRange(donor, i);
        if (range > bestRange) {
            bestRange = range;
            bestIndex = i;
        }
    }
    if (bestIndex > 0) {
        weaponType = UnitWeaponGet(donor, bestIndex);
        if (weaponType != "") {
            UnitWeaponAdd(target, weaponType, null);
        }
    }
    UnitRemove(donor);
    return bestIndex > 0;
}

bool APRG_AddBestDonorWeaponAnyState(unit target, string donorType, point p, int owner) {
    unitgroup donorGroup;
    unit donor;
    int count;
    int i;
    int bestIndex = 0;
    fixed bestRange = -1.0;
    fixed range;
    string weaponType;
    if (target == null || p == null || !CatalogEntryIsValid(c_gameCatalogUnit, donorType)) { return false; }
    donorGroup = UnitCreate(1, donorType, c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
    donor = UnitGroupUnitFromEnd(donorGroup, 1);
    if (donor == null) { return false; }
    count = UnitWeaponCount(donor);
    for (i = 1; i <= count; i += 1) {
        range = UnitWeaponRange(donor, i);
        if (range > bestRange) { bestRange = range; bestIndex = i; }
    }
    if (bestIndex > 0) {
        weaponType = UnitWeaponGet(donor, bestIndex);
        if (weaponType != "") { UnitWeaponAdd(target, weaponType, null); }
    }
    UnitRemove(donor);
    return bestIndex > 0;
}

bool APRG_AddGoliathAirWeapon(unit target, point p, int owner) {
    unitgroup donorGroup;
    unit donor;
    int count;
    int i;
    int bestIndex;
    int fallbackIndex;
    fixed bestRange;
    fixed fallbackRange;
    fixed range;
    string weaponType;
    bool preferred;
    if (target == null || p == null || !CatalogEntryIsValid(c_gameCatalogUnit, "Goliath")) { return false; }
    donorGroup = UnitCreate(1, "Goliath", c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
    donor = UnitGroupUnitFromEnd(donorGroup, 1);
    if (donor == null) { return false; }
    count = UnitWeaponCount(donor);
    bestIndex = 0;
    fallbackIndex = 0;
    bestRange = -1.0;
    fallbackRange = -1.0;
    for (i = 1; i <= count; i += 1) {
        weaponType = UnitWeaponGet(donor, i);
        range = UnitWeaponRange(donor, i);
        if (range > fallbackRange) { fallbackRange = range; fallbackIndex = i; }
        preferred = (
            StringContains(weaponType, "Missile", c_stringAnywhere, c_stringNoCase) ||
            StringContains(weaponType, "Hellfire", c_stringAnywhere, c_stringNoCase) ||
            StringContains(weaponType, "Air", c_stringAnywhere, c_stringNoCase)
        );
        if (preferred && range >= bestRange) { bestRange = range; bestIndex = i; }
    }
    if (bestIndex <= 0) { bestIndex = fallbackIndex; }
    if (bestIndex > 0) {
        weaponType = UnitWeaponGet(donor, bestIndex);
        if (weaponType != "") { UnitWeaponAdd(target, weaponType, null); }
    }
    UnitRemove(donor);
    return bestIndex > 0;
}

point APRG_FindSniperThorPoint(int player) {
    unit home;
    point homePoint;
    point p;
    fixed distance;
    int attempts;
    home = APRG_FindPlayerHomeStructure(player);
    if (home == null) { return null; }
    homePoint = UnitGetPosition(home);
    for (attempts = 0; attempts < APRG_MAX_POINT_ATTEMPTS * 4; attempts += 1) {
        p = PointWithOffsetPolar(homePoint, RandomFixed(30.0, 50.0), libNtve_gf_RandomAngle());
        if (p == null || !RegionContainsPoint(RegionPlayableMap(), p) || !PointPathingPassable(p)) { continue; }
        if (APRG_PointNearRakShirDuel(p, 24.0)) { continue; }
        distance = DistanceBetweenPoints(p, homePoint);
        if (distance < 30.0 || distance > 50.0) { continue; }
        if (APRG_GroundSpawnsNeedPlayerPathing() && !PointPathingIsConnected(p, homePoint)) { continue; }
        return p;
    }
    return null;
}

void APRG_TrySpawnSniperThor(int player) {
    point p;
    int owner;
    unitgroup created;
    unit thor;
    fixed life;
    int weaponCount;
    int weaponIndex;
    fixed bestThorRange = 0.0;
    fixed range;
    int rangeStacks;
    if (g_aprgSniperThorSpawned || g_aprgSniperThorRetries >= APRG_STATIC_SPAWN_MAX_RETRIES) { return; }
    if (!CatalogEntryIsValid(c_gameCatalogUnit, "Thor")) { g_aprgSniperThorRetries = APRG_STATIC_SPAWN_MAX_RETRIES; return; }
    g_aprgSniperThorRetries += 1;
    p = APRG_FindSniperThorPoint(player); if (p == null) { return; }
    owner = APRG_FindHostileOwnerNearPoint(player, p); if (owner < 0) { return; }
    created = UnitCreate(1, "Thor", c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
    if (created == null || UnitGroupCount(created, c_unitCountAlive) <= 0) { return; }
    APRG_RegisterMutationEnemyGroup(created);
    thor = UnitGroupUnitFromEnd(created, 1); if (thor == null) { return; }
    life = UnitGetPropertyFixed(thor, c_unitPropLifeMax, c_unitPropCurrent);
    if (life > 0.0) { UnitSetPropertyFixed(thor, c_unitPropLifeMax, life * 3.0); UnitSetPropertyFixed(thor, c_unitPropLife, life * 3.0); }
    if (CatalogEntryIsValid(c_gameCatalogBehavior, "APRogueSniperThorDamage")) { UnitBehaviorAdd(thor, "APRogueSniperThorDamage", thor, 1); }
    weaponCount = UnitWeaponCount(thor);
    for (weaponIndex = 1; weaponIndex <= weaponCount; weaponIndex += 1) {
        if (!UnitWeaponIsEnabled(thor, weaponIndex)) { continue; }
        range = UnitWeaponRange(thor, weaponIndex); if (range > bestThorRange) { bestThorRange = range; }
    }
    if (bestThorRange > 0.0 && CatalogEntryIsValid(c_gameCatalogBehavior, "APRogueSniperThorRangeQuarter")) {
        rangeStacks = MaxI(1, FixedToInt(RoundI(bestThorRange * 8.0)));
        UnitBehaviorAdd(thor, "APRogueSniperThorRangeQuarter", thor, rangeStacks);
    }
    g_aprgSniperThorSpawned = true;
}

point APRG_TowerDefenseFrontPoint(point enemyHome, point playerHome, int attempt) {
    fixed progress;
    fixed x;
    fixed y;
    point center;
    point candidate;
    progress = MinF(0.90, 0.10 + IntToFixed(attempt) * 0.065);
    x = PointGetX(enemyHome) + (PointGetX(playerHome) - PointGetX(enemyHome)) * progress;
    y = PointGetY(enemyHome) + (PointGetY(playerHome) - PointGetY(enemyHome)) * progress;
    center = Point(x, y);
    candidate = APRG_FindGroundPointNear(center, 0.0, 6.0);
    if (candidate != null) { return candidate; }
    if (RegionContainsPoint(RegionPlayableMap(), center) && PointPathingPassable(center)) { return center; }
    return null;
}

string APRG_TowerDefenseBuildCommandString(int owner, string face) {
    int cardCount;
    int cardIndex;
    int buttonCount;
    int buttonIndex;
    string path;
    string candidateFace;
    string abilCmd;
    if (owner < 0 || face == "" || !CatalogEntryIsValid(c_gameCatalogUnit, "Probe")) { return ""; }
    cardCount = CatalogFieldValueCount(c_gameCatalogUnit, "Probe", "CardLayouts", owner);
    for (cardIndex = 0; cardIndex < cardCount; cardIndex += 1) {
        path = "CardLayouts[" + IntToString(cardIndex) + "].LayoutButtons";
        buttonCount = CatalogFieldValueCount(c_gameCatalogUnit, "Probe", path, owner);
        for (buttonIndex = 0; buttonIndex < buttonCount; buttonIndex += 1) {
            candidateFace = CatalogFieldValueGet(c_gameCatalogUnit, "Probe", path + "[" + IntToString(buttonIndex) + "].Face", owner);
            if (candidateFace != face) { continue; }
            abilCmd = CatalogFieldValueGet(c_gameCatalogUnit, "Probe", path + "[" + IntToString(buttonIndex) + "].AbilCmd", owner);
            if (abilCmd != "") { return abilCmd; }
        }
    }
    return "";
}

bool APRG_TowerDefenseStructureNear(int owner, point p, string typeNeedle, fixed radius) {
    unitgroup nearby;
    int i;
    unit u;
    if (owner < 0 || p == null || typeNeedle == "") { return false; }
    nearby = UnitGroup(null, owner, RegionCircle(p, radius), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    for (i = UnitGroupCount(nearby, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(nearby, i);
        if (u != null && StringContains(UnitGetType(u), typeNeedle, c_stringAnywhere, c_stringNoCase)) { return true; }
    }
    return false;
}

bool APRG_IssueTowerDefenseBuild(unit probe, string face, point center, fixed minRadius, fixed maxRadius) {
    int owner;
    int attempt;
    int oldMinerals;
    int oldGas;
    bool requirementsEnabled;
    bool restrictionsEnabled;
    bool issued;
    string abilCmdText;
    point buildPoint;
    order buildOrder;
    if (probe == null || !UnitIsAlive(probe) || center == null || face == "") { return false; }
    owner = UnitGetOwner(probe);
    if (owner < 0) { return false; }
    abilCmdText = APRG_TowerDefenseBuildCommandString(owner, face);
    if (abilCmdText == "") { return false; }

    oldMinerals = PlayerGetPropertyInt(owner, c_playerPropMinerals);
    oldGas = PlayerGetPropertyInt(owner, c_playerPropVespene);
    requirementsEnabled = TechTreeRequirementsEnabled(owner);
    restrictionsEnabled = TechTreeRestrictionsEnabled(owner);
    PlayerModifyPropertyInt(owner, c_playerPropMinerals, c_playerPropOperSetTo, MaxI(oldMinerals, 1000));
    PlayerModifyPropertyInt(owner, c_playerPropVespene, c_playerPropOperSetTo, MaxI(oldGas, 1000));
    TechTreeRequirementsEnable(owner, false);
    TechTreeRestrictionsEnable(owner, false);

    issued = false;
    for (attempt = 0; attempt < 10; attempt += 1) {
        buildPoint = APRG_FindGroundPointNear(center, minRadius, maxRadius);
        if (buildPoint == null) { continue; }
        if (face == "Pylon" && APRG_TowerDefenseStructureNear(owner, buildPoint, "Pylon", 3.0)) { continue; }
        if (face == "ShieldBattery" && !APRG_TowerDefenseStructureNear(owner, buildPoint, "PhotonCannon", 6.0)) { continue; }
        buildOrder = OrderTargetingPoint(StringToAbilCmd(abilCmdText), buildPoint);
        if (!UnitOrderIsValid(probe, buildOrder)) { continue; }
        if (UnitIssueOrder(probe, buildOrder, c_orderQueueReplace)) {
            issued = true;
            break;
        }
    }

    TechTreeRequirementsEnable(owner, requirementsEnabled);
    TechTreeRestrictionsEnable(owner, restrictionsEnabled);
    PlayerModifyPropertyInt(owner, c_playerPropMinerals, c_playerPropOperSetTo, oldMinerals);
    PlayerModifyPropertyInt(owner, c_playerPropVespene, c_playerPropOperSetTo, oldGas);
    return issued;
}

point APRG_TowerDefenseCreepTarget(point current, int player) {
    unit home;
    point homePoint;
    point center;
    point candidate;
    fixed x;
    fixed y;
    if (current == null) { return null; }
    home = APRG_FindPlayerHomeStructure(player);
    if (home == null) { return current; }
    homePoint = UnitGetPosition(home);
    x = PointGetX(current) + (PointGetX(homePoint) - PointGetX(current)) * 0.15;
    y = PointGetY(current) + (PointGetY(homePoint) - PointGetY(current)) * 0.15;
    center = Point(x, y);
    candidate = APRG_FindGroundPointNear(center, 0.0, 6.0);
    if (candidate != null) { return candidate; }
    if (RegionContainsPoint(RegionPlayableMap(), center) && PointPathingPassable(center)) { return center; }
    return current;
}

void APRG_StartTowerDefenseConstruction(unit probe, point target, fixed now) {
    string key;
    if (probe == null || !UnitIsAlive(probe) || target == null) { return; }
    key = "APRG_TowerDefenseProbe_" + IntToString(UnitGetTag(probe));
    DataTableSetInt(true, key + "_Stage", 1);
    DataTableSetInt(true, key + "_Failures", 0);
    DataTableSetFixed(true, key + "_SearchStart", -1.0);
    DataTableSetFixed(true, key + "_Next", now);
}

void APRG_TickTowerDefenseProbes(int player, fixed now) {
    int i;
    unit probe;
    string key;
    point target;
    point creepTarget;
    fixed started;
    fixed nextStage;
    fixed searchStart;
    fixed minRadius;
    fixed maxRadius;
    int stage;
    int buildIndex;
    int failures;
    int clusters;
    int owner;
    string face;
    bool issued;
    if (g_aprgTowerDefenseProbes == null) { return; }
    for (i = UnitGroupCount(g_aprgTowerDefenseProbes, c_unitCountAll); i > 0; i -= 1) {
        probe = UnitGroupUnitFromEnd(g_aprgTowerDefenseProbes, i);
        if (probe == null || !UnitIsAlive(probe)) {
            if (probe != null) { UnitGroupRemove(g_aprgTowerDefenseProbes, probe); }
            continue;
        }
        owner = UnitGetOwner(probe);
        key = "APRG_TowerDefenseProbe_" + IntToString(UnitGetTag(probe));
        target = Point(DataTableGetFixed(true, key + "_X"), DataTableGetFixed(true, key + "_Y"));
        started = DataTableGetFixed(true, key + "_Start");
        stage = DataTableGetInt(true, key + "_Stage");
        nextStage = DataTableGetFixed(true, key + "_Next");
        if (stage == 0) {
            if (DistanceBetweenPoints(UnitGetPosition(probe), target) <= 3.5) {
                APRG_StartTowerDefenseConstruction(probe, target, now);
            }
            else if (now - started >= 30.0) {
                creepTarget = APRG_TowerDefenseCreepTarget(target, player);
                if (creepTarget != null) {
                    target = creepTarget;
                    DataTableSetFixed(true, key + "_X", PointGetX(target));
                    DataTableSetFixed(true, key + "_Y", PointGetY(target));
                    DataTableSetFixed(true, key + "_Start", now);
                    UnitIssueOrder(probe, OrderTargetingPoint(AbilityCommand("move", 0), target), c_orderQueueReplace);
                }
            }
        }
        else if (stage == 1 && now >= nextStage) {
            if (UnitOrderCount(probe) > 0) {
                DataTableSetFixed(true, key + "_Next", now + 0.75);
                continue;
            }
            buildIndex = DataTableGetInt(true, key + "_BuildIndex");
            failures = DataTableGetInt(true, key + "_Failures");
            clusters = DataTableGetInt(true, key + "_Clusters");

            if (buildIndex >= 13) {
                clusters += 1;
                DataTableSetInt(true, key + "_Clusters", clusters);
                if (clusters >= 3) {
                    UnitGroupRemove(g_aprgTowerDefenseProbes, probe);
                    UnitRemove(probe);
                    continue;
                }
                creepTarget = APRG_TowerDefenseCreepTarget(target, player);
                if (creepTarget != null) {
                    target = creepTarget;
                    DataTableSetFixed(true, key + "_X", PointGetX(target));
                    DataTableSetFixed(true, key + "_Y", PointGetY(target));
                    DataTableSetFixed(true, key + "_Start", now);
                    DataTableSetFixed(true, key + "_SearchStart", -1.0);
                    DataTableSetInt(true, key + "_BuildIndex", 0);
                    DataTableSetInt(true, key + "_Failures", 0);
                    DataTableSetInt(true, key + "_Stage", 0);
                    UnitIssueOrder(probe, OrderTargetingPoint(AbilityCommand("move", 0), target), c_orderQueueReplace);
                }
                continue;
            }

            face = "PhotonCannon";
            minRadius = 2.5;
            maxRadius = 8.0;
            if (buildIndex == 0) {
                face = "Pylon";
                minRadius = 0.0;
                maxRadius = 2.0;
            }
            else if (buildIndex == 6) {
                face = "ShieldBattery";
                minRadius = 2.0;
                maxRadius = 6.0;
            }
            else if (buildIndex == 7) {
                face = "Pylon";
                minRadius = 4.0;
                maxRadius = 8.0;
            }

            if (face == "Pylon" && APRG_TowerDefenseStructureNear(owner, target, "Pylon", 3.0)) {
                issued = true;
            }
            else {
                if (face == "ShieldBattery" && !APRG_TowerDefenseStructureNear(owner, target, "PhotonCannon", 8.0)) {
                    face = "PhotonCannon";
                    minRadius = 2.5;
                    maxRadius = 8.0;
                }
                issued = APRG_IssueTowerDefenseBuild(probe, face, target, minRadius, maxRadius);
            }

            if (issued) {
                buildIndex += 1;
                failures = 0;
                DataTableSetInt(true, key + "_BuildIndex", buildIndex);
                DataTableSetInt(true, key + "_Failures", failures);
                DataTableSetFixed(true, key + "_SearchStart", -1.0);
                DataTableSetFixed(true, key + "_Next", now + 0.75);
            }
            else {
                failures += 1;
                DataTableSetInt(true, key + "_Failures", failures);
                searchStart = DataTableGetFixed(true, key + "_SearchStart");
                if (searchStart < 0.0) {
                    searchStart = now;
                    DataTableSetFixed(true, key + "_SearchStart", searchStart);
                }
                if (now - searchStart >= 30.0) {
                    creepTarget = APRG_TowerDefenseCreepTarget(target, player);
                    if (creepTarget != null) {
                        target = creepTarget;
                        DataTableSetFixed(true, key + "_X", PointGetX(target));
                        DataTableSetFixed(true, key + "_Y", PointGetY(target));
                        DataTableSetFixed(true, key + "_Start", now);
                        DataTableSetFixed(true, key + "_SearchStart", -1.0);
                        DataTableSetInt(true, key + "_Stage", 0);
                        DataTableSetInt(true, key + "_Failures", 0);
                        UnitIssueOrder(probe, OrderTargetingPoint(AbilityCommand("move", 0), target), c_orderQueueReplace);
                    }
                }
                else {
                    DataTableSetFixed(true, key + "_Next", now + 2.0);
                }
            }
        }
    }
}

void APRG_TryTowerDefense(int player, fixed now) {
    point spawnPoint;
    point targetPoint;
    unit home;
    unit enemyHome;
    int owner;
    unitgroup created;
    unit probe;

    if (!APRG_PlayerMacroBaseReady(player) || now < g_aprgNextTowerDefenseTime) { return; }
    g_aprgNextTowerDefenseTime = now + 30.0;
    if (g_aprgTowerDefenseAttempts >= 80) { return; }
    g_aprgTowerDefenseAttempts += 1;
    if (!CatalogEntryIsValid(c_gameCatalogUnit, "Probe")) { return; }
    home = APRG_FindPlayerHomeStructure(player);
    if (home == null) { return; }
    enemyHome = APRG_RandomPathableHostileBaseAnchor(player);
    if (enemyHome == null) { return; }
    spawnPoint = APRG_FindGroundPointNear(UnitGetPosition(enemyHome), 3.0, 8.0);
    if (spawnPoint == null) { spawnPoint = UnitGetPosition(enemyHome); }
    targetPoint = APRG_TowerDefenseFrontPoint(UnitGetPosition(enemyHome), UnitGetPosition(home), g_aprgTowerDefenseAttempts);
    if (targetPoint == null) { return; }
    owner = UnitGetOwner(enemyHome);
    if (owner < 0) { return; }

    created = UnitCreate(1, "Probe", c_unitCreateIgnorePlacement, owner, spawnPoint, libNtve_gf_RandomAngle());
    APRG_RegisterMutationEnemyGroup(created);
    probe = UnitGroupUnitFromEnd(created, 1);
    if (probe == null) { return; }
    AISetUnitScriptControlled(probe, true);
    DataTableSetFixed(true, "APRG_TowerDefenseProbe_" + IntToString(UnitGetTag(probe)) + "_X", PointGetX(targetPoint));
    DataTableSetFixed(true, "APRG_TowerDefenseProbe_" + IntToString(UnitGetTag(probe)) + "_Y", PointGetY(targetPoint));
    DataTableSetFixed(true, "APRG_TowerDefenseProbe_" + IntToString(UnitGetTag(probe)) + "_Start", now);
    DataTableSetFixed(true, "APRG_TowerDefenseProbe_" + IntToString(UnitGetTag(probe)) + "_SearchStart", -1.0);
    DataTableSetInt(true, "APRG_TowerDefenseProbe_" + IntToString(UnitGetTag(probe)) + "_BuildIndex", 0);
    DataTableSetInt(true, "APRG_TowerDefenseProbe_" + IntToString(UnitGetTag(probe)) + "_Clusters", 0);
    DataTableSetInt(true, "APRG_TowerDefenseProbe_" + IntToString(UnitGetTag(probe)) + "_Stage", 0);
    UnitGroupAdd(g_aprgTowerDefenseProbes, probe);
    UnitIssueOrder(probe, OrderTargetingPoint(AbilityCommand("move", 0), targetPoint), c_orderQueueReplace);
}

void APRG_ApplyCloakedNightmare(int player) {
    unitgroup enemies;
    int i;
    unit u;
    if (!APRG_PlayerMacroBaseReady(player)) { return; }
    enemies = APRG_EnemyMobileUnits(player);
    UnitGroupAddUnitGroup(enemies, APRG_EnemyStructures(player));
    i = UnitGroupCount(enemies, c_unitCountAlive);
    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(enemies, i);
        if (u == null) { break; }
        if (!UnitHasBehavior(u, "APRogueCloakedNightmare")) {
            UnitBehaviorAdd(u, "APRogueCloakedNightmare", u, 1);
        }
    }
}

void APRG_ApplyRapidRepair(int player) {
    unitgroup owned;
    int i;
    unit u;
    string unitType;
    string key;
    fixed repairTime;

    owned = APRG_PlayerMobileUnits(player);
    UnitGroupAddUnitGroup(owned, APRG_PlayerStructures(player));
    i = UnitGroupCount(owned, c_unitCountAlive);
    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(owned, i);
        if (u == null) { break; }
        unitType = UnitGetType(u);
        key = "APRG_RapidRepair_" + IntToString(player) + "_" + unitType;
        if (DataTableGetBool(true, key)) { continue; }
        repairTime = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "RepairTime", player));
        if (repairTime > 0.0) {
            CatalogFieldValueModify(c_gameCatalogUnit, unitType, "RepairTime", player, "0.2", c_upgradeOperationMultiply);
        }
        DataTableSetBool(true, key, true);
    }
}

bool APRG_IsConcussedShellUnitType(string unitType) {
    if (unitType == "") { return false; }
    return StringContains(unitType, "Marauder", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Hammer", c_stringAnywhere, c_stringNoCase);
}

void APRG_BuffConcussedDamageEffect(string effectType, int player) {
    string key;
    fixed amount;
    fixed armored;
    if (effectType == "" || !CatalogEntryIsValid(c_gameCatalogEffect, effectType)) { return; }
    key = "APRG_ConcussedDamage_" + IntToString(player) + "_" + effectType;
    if (DataTableGetBool(true, key)) { return; }
    amount = StringToFixed(CatalogFieldValueGet(c_gameCatalogEffect, effectType, "Amount", player));
    if (amount > 0.0) {
        CatalogFieldValueModify(c_gameCatalogEffect, effectType, "Amount", player, "10.0", c_upgradeOperationMultiply);
    }
    armored = StringToFixed(CatalogFieldValueGet(c_gameCatalogEffect, effectType, "AttributeBonus[Armored]", player));
    if (armored > 0.0) {
        CatalogFieldValueModify(c_gameCatalogEffect, effectType, "AttributeBonus[Armored]", player, "10.0", c_upgradeOperationMultiply);
    }
    DataTableSetBool(true, key, true);
}

void APRG_UseConcussedShellMover(string launchEffect, int player) {
    int moverCount;
    int moverIndex;
    string path;
    if (launchEffect == "" || !CatalogEntryIsValid(c_gameCatalogEffect, launchEffect)) { return; }
    if (!CatalogEntryIsValid(c_gameCatalogMover, "APRogueConcussedShellMover")) { return; }
    moverCount = CatalogFieldValueCount(c_gameCatalogEffect, launchEffect, "Movers", player);
    if (moverCount <= 0) { return; }
    if (moverCount > 8) { moverCount = 8; }
    for (moverIndex = 0; moverIndex < moverCount; moverIndex += 1) {
        path = "Movers[" + IntToString(moverIndex) + "].Link";
        CatalogReferenceSet(
            "Effect," + launchEffect + "," + path,
            player,
            "APRogueConcussedShellMover"
        );
    }
}

string APRG_ConcussedChildEffect(string effectType, int player, int childIndex) {
    if (effectType == "" || !CatalogEntryIsValid(c_gameCatalogEffect, effectType)) { return ""; }
    if (childIndex == 0) { return CatalogFieldValueGet(c_gameCatalogEffect, effectType, "Effect", player); }
    if (childIndex == 1) { return CatalogFieldValueGet(c_gameCatalogEffect, effectType, "ImpactEffect", player); }
    if (childIndex == 2) { return CatalogFieldValueGet(c_gameCatalogEffect, effectType, "FinalEffect", player); }
    if (childIndex == 3) { return CatalogFieldValueGet(c_gameCatalogEffect, effectType, "LaunchEffect", player); }
    if (childIndex == 4) { return CatalogFieldValueGet(c_gameCatalogEffect, effectType, "InitialEffect", player); }
    if (childIndex == 5) { return CatalogFieldValueGet(c_gameCatalogEffect, effectType, "PeriodicEffect", player); }
    if (childIndex >= 6 && childIndex < 22) {
        return CatalogFieldValueGet(c_gameCatalogEffect, effectType, "EffectArray[" + IntToString(childIndex - 6) + "]", player);
    }
    return "";
}

void APRG_UseConcussedShellMoverGraph(string rootEffect, int player) {
    string key;
    string child;
    string grandchild;
    int ci;
    int gi;
    if (rootEffect == "" || !CatalogEntryIsValid(c_gameCatalogEffect, rootEffect)) { return; }
    key = "APRG_ConcussedMoverGraph_" + IntToString(player) + "_" + rootEffect;
    if (DataTableGetBool(true, key)) { return; }
    APRG_UseConcussedShellMover(rootEffect, player);
    for (ci = 0; ci < 22; ci += 1) {
        child = APRG_ConcussedChildEffect(rootEffect, player, ci);
        if (child == "" || !CatalogEntryIsValid(c_gameCatalogEffect, child)) { continue; }
        APRG_UseConcussedShellMover(child, player);
        for (gi = 0; gi < 22; gi += 1) {
            grandchild = APRG_ConcussedChildEffect(child, player, gi);
            if (grandchild == "" || !CatalogEntryIsValid(c_gameCatalogEffect, grandchild)) { continue; }
            APRG_UseConcussedShellMover(grandchild, player);
        }
    }
    DataTableSetBool(true, key, true);
}

void APRG_ApplyConcussedShells(int player) {
    unitgroup units;
    unit u;
    int i;
    int wi;
    int wc;
    string unitType;
    string weaponType;
    string displayEffect;
    string launchEffect;

    APRG_BuffConcussedDamageEffect("PunisherGrenadesU", player);
    APRG_BuffConcussedDamageEffect("PunisherGrenadesU2", player);
    APRG_BuffConcussedDamageEffect("PunisherGrenadesU3", player);
    APRG_UseConcussedShellMoverGraph("PunisherGrenadesLM", player);

    units = APRG_PlayerMobileUnits(player);
    for (i = UnitGroupCount(units, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null || !UnitIsAlive(u)) { continue; }
        unitType = UnitGetType(u);
        wc = UnitWeaponCount(u);
        for (wi = 1; wi <= wc; wi += 1) {
            weaponType = UnitWeaponGet(u, wi);
            if (weaponType == "") { continue; }
            if (!APRG_IsConcussedShellUnitType(unitType) && !StringContains(weaponType, "Punisher", c_stringAnywhere, c_stringNoCase)) { continue; }
            displayEffect = CatalogFieldValueGet(c_gameCatalogWeapon, weaponType, "DisplayEffect", player);
            APRG_BuffConcussedDamageEffect(displayEffect, player);
            launchEffect = CatalogFieldValueGet(c_gameCatalogWeapon, weaponType, "Effect", player);
            if (launchEffect == "" || !CatalogEntryIsValid(c_gameCatalogEffect, launchEffect)) { continue; }
            APRG_UseConcussedShellMoverGraph(launchEffect, player);
        }
    }
    g_aprgConcussedShellsApplied = true;
}

bool APRG_IsThorFamilyType(string unitType) {
    if (unitType == "") { return false; }
    return StringContains(unitType, "Thor", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Jotun", c_stringAnywhere, c_stringNoCase);
}

bool APRG_IsUltraliskFamilyType(string unitType) {
    if (unitType == "") { return false; }
    return StringContains(unitType, "Ultralisk", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Torrasque", c_stringAnywhere, c_stringNoCase);
}

bool APRG_IsGoliathFamilyType(string unitType) {
    if (unitType == "") { return false; }
    return StringContains(unitType, "Goliath", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Spartan", c_stringAnywhere, c_stringNoCase);
}

bool APRG_IsMercenaryUnitType(string unitType) {
    if (unitType == "") { return false; }
    if (
        StringContains(unitType, "Compound", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "PredatorNest", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "MercenaryStructure", c_stringAnywhere, c_stringNoCase)
    ) { return false; }
    return StringContains(unitType, "Merc", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "WarPig", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "DevilDog", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Hammer", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Spartan", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "SiegeBreaker", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "HelsAngel", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "DuskWing", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Jackson", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "DukesRevenge", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Skibi", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "DeathHead", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "WingedNightmare", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "MidnightRider", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Brynhild", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Jotun", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "InfestedMedic", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "InfestedSiegeBreaker", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "InfestedDuskWing", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "DevouringOne", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "HunterKiller", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Torrasque", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Hunterling", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Yggdrasil", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "CausticHorror", c_stringAnywhere, c_stringNoCase);
}

bool APRG_MercenaryCommandProducesUnit(string abilityType, int commandIndex, int player) {
    string basePath;
    string candidateUnitType;
    int producedCount;
    int producedIndex;
    bool namedMercAbility;
    bool sawNonStructure = false;
    if (
        abilityType == "" || commandIndex < 0 ||
        !CatalogEntryIsValid(c_gameCatalogAbil, abilityType)
    ) { return false; }

    basePath = "InfoArray[" + IntToString(commandIndex) + "]";
    namedMercAbility =
        StringContains(abilityType, "Hire", c_stringAnywhere, c_stringNoCase) ||
        StringContains(abilityType, "Recruit", c_stringAnywhere, c_stringNoCase) ||
        StringContains(abilityType, "Merc", c_stringAnywhere, c_stringNoCase) ||
        StringContains(abilityType, "Mercenary", c_stringAnywhere, c_stringNoCase);

    candidateUnitType = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, basePath + ".Unit", player);
    if (candidateUnitType != "" && CatalogEntryIsValid(c_gameCatalogUnit, candidateUnitType)) {
        if (APRG_IsMercenaryUnitType(candidateUnitType)) { return true; }
        if (!UnitTypeTestAttribute(candidateUnitType, c_unitAttributeStructure)) { sawNonStructure = true; }
    }

    producedCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, basePath + ".Unit", player);
    for (producedIndex = 0; producedIndex < producedCount; producedIndex += 1) {
        candidateUnitType = CatalogFieldValueGet(
            c_gameCatalogAbil, abilityType,
            basePath + ".Unit[" + IntToString(producedIndex) + "]", player
        );
        if (candidateUnitType == "" || !CatalogEntryIsValid(c_gameCatalogUnit, candidateUnitType)) { continue; }
        if (APRG_IsMercenaryUnitType(candidateUnitType)) { return true; }
        if (!UnitTypeTestAttribute(candidateUnitType, c_unitAttributeStructure)) { sawNonStructure = true; }
    }

    return namedMercAbility && sawNonStructure;
}

bool APRG_IsMercenaryRecruitAbility(string abilityType, int player) {
    int infoCount;
    int infoIndex;
    if (abilityType == "" || !CatalogEntryIsValid(c_gameCatalogAbil, abilityType)) { return false; }
    infoCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, "InfoArray", player);
    if (infoCount > 64) { infoCount = 64; }
    for (infoIndex = 0; infoIndex < infoCount; infoIndex += 1) {
        if (APRG_MercenaryCommandProducesUnit(abilityType, infoIndex, player)) { return true; }
    }
    return false;
}

int APRG_MercenaryUpgradeStacks(int slot) {
    int divisor = 1;
    int i = 0;
    int packed = g_aprgMercenaryUpgradePacked;
    if (slot < 0 || slot > 7) { return 0; }
    if (slot >= 6) {
        slot -= 6;
        packed = g_aprgMercenaryUpgradePacked2;
    }
    for (; i < slot; i += 1) { divisor *= 32; }
    return (packed / divisor) % 32;
}

void APRG_ReduceMercenaryCooldownField(int player, string abilityType, string field, fixed reduction) {
    fixed value;
    if (abilityType == "" || field == "") { return; }
    value = StringToFixed(CatalogFieldValueGet(c_gameCatalogAbil, abilityType, field, player));
    // Some campaign mercenary abilities can surface a wrapped/sentinel timer as
    // a many-thousand-second cooldown after catalog edits. No Slay mercenary
    // cooldown is intended to exceed 500 seconds, so treat that as invalid.
    if (value > 500.0) {
        CatalogFieldValueSet(c_gameCatalogAbil, abilityType, field, player, "0");
        return;
    }
    if (reduction > 0.0 && value > 0.0) {
        CatalogFieldValueSet(
            c_gameCatalogAbil, abilityType, field, player,
            FixedToString(MaxF(0.0, value - reduction), c_fixedPrecisionAny)
        );
    }
}

void APRG_ApplyRepeatContractorCooldowns(int player, int repeatStacks) {
    int count;
    int i;
    int infoCount;
    int infoIndex;
    int producedCount;
    int producedIndex;
    int costCount;
    int costIndex;
    string abilityType;
    string basePath;
    string costPath;
    string trainedUnitType;
    string candidateUnitType;
    fixed reduction;
    bool mercAbility;
    bool infoProducesMerc;
    reduction = 30.0 * IntToFixed(MaxI(0, repeatStacks));

    count = CatalogEntryCount(c_gameCatalogAbil);
    for (i = 1; i <= count; i += 1) {
        abilityType = CatalogEntryGet(c_gameCatalogAbil, i);
        if (abilityType == "" || !CatalogEntryIsValid(c_gameCatalogAbil, abilityType)) { continue; }
        mercAbility = APRG_IsMercenaryRecruitAbility(abilityType, player);
        if (!mercAbility) { continue; }
        infoCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, "InfoArray", player);
        for (infoIndex = 0; infoIndex < infoCount; infoIndex += 1) {
            basePath = "InfoArray[" + IntToString(infoIndex) + "]";
            infoProducesMerc = APRG_MercenaryCommandProducesUnit(abilityType, infoIndex, player);
            if (!infoProducesMerc) { continue; }
            APRG_ReduceMercenaryCooldownField(player, abilityType, basePath + ".Cooldown.TimeUse", reduction);
            APRG_ReduceMercenaryCooldownField(player, abilityType, basePath + ".Cooldown.TimeStart", reduction);
            APRG_ReduceMercenaryCooldownField(player, abilityType, basePath + ".Cost.Cooldown.TimeUse", reduction);
            APRG_ReduceMercenaryCooldownField(player, abilityType, basePath + ".Cost.Cooldown.TimeStart", reduction);
            APRG_ReduceMercenaryCooldownField(player, abilityType, basePath + ".Charge.TimeUse", reduction);
            APRG_ReduceMercenaryCooldownField(player, abilityType, basePath + ".Charge.TimeStart", reduction);
            APRG_ReduceMercenaryCooldownField(player, abilityType, basePath + ".Cost.Charge.TimeUse", reduction);
            APRG_ReduceMercenaryCooldownField(player, abilityType, basePath + ".Cost.Charge.TimeStart", reduction);
        }
        if (!mercAbility) { continue; }
        APRG_ReduceMercenaryCooldownField(player, abilityType, "Cooldown.TimeUse", reduction);
        APRG_ReduceMercenaryCooldownField(player, abilityType, "Cooldown.TimeStart", reduction);
        APRG_ReduceMercenaryCooldownField(player, abilityType, "Cost.Cooldown.TimeUse", reduction);
        APRG_ReduceMercenaryCooldownField(player, abilityType, "Cost.Cooldown.TimeStart", reduction);
        APRG_ReduceMercenaryCooldownField(player, abilityType, "Charge.TimeUse", reduction);
        APRG_ReduceMercenaryCooldownField(player, abilityType, "Charge.TimeStart", reduction);
        APRG_ReduceMercenaryCooldownField(player, abilityType, "Cost.Charge.TimeUse", reduction);
        APRG_ReduceMercenaryCooldownField(player, abilityType, "Cost.Charge.TimeStart", reduction);
        costCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, "Cost", player);
        for (costIndex = 0; costIndex < costCount; costIndex += 1) {
            costPath = "Cost[" + IntToString(costIndex) + "]";
            APRG_ReduceMercenaryCooldownField(player, abilityType, costPath + ".Cooldown.TimeUse", reduction);
            APRG_ReduceMercenaryCooldownField(player, abilityType, costPath + ".Cooldown.TimeStart", reduction);
            APRG_ReduceMercenaryCooldownField(player, abilityType, costPath + ".Charge.TimeUse", reduction);
            APRG_ReduceMercenaryCooldownField(player, abilityType, costPath + ".Charge.TimeStart", reduction);
        }
    }
}

void APRG_ClearSuspiciousMercenaryTimerLink(unit structure, int player, string abilityType, string field) {
    string link;
    fixed remaining;
    if (structure == null || !UnitIsAlive(structure) || abilityType == "" || field == "") { return; }
    link = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, field, player);
    if (link == "") { return; }

    remaining = UnitAbilityGetCooldown(structure, abilityType, link);
    if (remaining > 500.0) {
        UnitModifyCooldown(structure, link, 0.0, c_cooldownOperationSet);
    }

    remaining = UnitAbilityGetChargeRegen(structure, abilityType, link);
    if (remaining > 500.0) {
        UnitAbilityAddChargeRegen(structure, abilityType, link, -remaining);
    }
}

void APRG_SanitizeContractStructureTimers(unit structure, int player) {
    int abilityCount;
    int abilityIndex;
    int infoCount;
    int infoIndex;
    int costCount;
    int costIndex;
    string abilityType;
    string basePath;
    string costPath;
    if (structure == null || !UnitIsAlive(structure)) { return; }

    abilityCount = MinI(64, UnitAbilityCount(structure));
    for (abilityIndex = 1; abilityIndex <= abilityCount; abilityIndex += 1) {
        abilityType = UnitAbilityGet(structure, abilityIndex);
        if (abilityType == "" || !APRG_IsMercenaryRecruitAbility(abilityType, player)) { continue; }

        APRG_ClearSuspiciousMercenaryTimerLink(structure, player, abilityType, "Cooldown.Link");
        APRG_ClearSuspiciousMercenaryTimerLink(structure, player, abilityType, "Charge.Link");
        APRG_ClearSuspiciousMercenaryTimerLink(structure, player, abilityType, "Cost.Cooldown.Link");
        APRG_ClearSuspiciousMercenaryTimerLink(structure, player, abilityType, "Cost.Charge.Link");

        costCount = MinI(8, CatalogFieldValueCount(c_gameCatalogAbil, abilityType, "Cost", player));
        for (costIndex = 0; costIndex < costCount; costIndex += 1) {
            costPath = "Cost[" + IntToString(costIndex) + "]";
            APRG_ClearSuspiciousMercenaryTimerLink(structure, player, abilityType, costPath + ".Cooldown.Link");
            APRG_ClearSuspiciousMercenaryTimerLink(structure, player, abilityType, costPath + ".Charge.Link");
        }

        infoCount = MinI(64, CatalogFieldValueCount(c_gameCatalogAbil, abilityType, "InfoArray", player));
        for (infoIndex = 0; infoIndex < infoCount; infoIndex += 1) {
            if (!APRG_MercenaryCommandProducesUnit(abilityType, infoIndex, player)) { continue; }
            basePath = "InfoArray[" + IntToString(infoIndex) + "]";
            APRG_ClearSuspiciousMercenaryTimerLink(structure, player, abilityType, basePath + ".Cooldown.Link");
            APRG_ClearSuspiciousMercenaryTimerLink(structure, player, abilityType, basePath + ".Charge.Link");
            APRG_ClearSuspiciousMercenaryTimerLink(structure, player, abilityType, basePath + ".Cost.Cooldown.Link");
            APRG_ClearSuspiciousMercenaryTimerLink(structure, player, abilityType, basePath + ".Cost.Charge.Link");
            costCount = MinI(8, CatalogFieldValueCount(c_gameCatalogAbil, abilityType, basePath + ".Cost", player));
            for (costIndex = 0; costIndex < costCount; costIndex += 1) {
                costPath = basePath + ".Cost[" + IntToString(costIndex) + "]";
                APRG_ClearSuspiciousMercenaryTimerLink(structure, player, abilityType, costPath + ".Cooldown.Link");
                APRG_ClearSuspiciousMercenaryTimerLink(structure, player, abilityType, costPath + ".Charge.Link");
            }
        }
    }
}

void APRG_ScaleMercenaryUnitCost(int player, string unitType, fixed factor) {
    int resourceIndex;
    fixed value;
    string field;
    string key;
    if (unitType == "" || factor >= 1.0 || !CatalogEntryIsValid(c_gameCatalogUnit, unitType)) { return; }
    key = "APRG_AffordableMercUnit_" + IntToString(player) + "_" + unitType;
    if (DataTableGetBool(true, key)) { return; }
    for (resourceIndex = 0; resourceIndex < 2; resourceIndex += 1) {
        field = "CostResource[" + IntToString(resourceIndex) + "]";
        value = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, field, player));
        if (value > 0.0) {
            CatalogFieldValueSet(
                c_gameCatalogUnit, unitType, field, player,
                IntToString(MaxI(1, FixedToInt(RoundI(value * factor))))
            );
        }
    }
    DataTableSetBool(true, key, true);
}

void APRG_ScaleMercenaryAbilityResourceField(int player, string abilityType, string field, fixed factor) {
    fixed value;
    if (abilityType == "" || field == "" || factor >= 1.0) { return; }
    value = StringToFixed(CatalogFieldValueGet(c_gameCatalogAbil, abilityType, field, player));
    if (value <= 0.0) { return; }
    CatalogFieldValueSet(
        c_gameCatalogAbil, abilityType, field, player,
        IntToString(MaxI(1, FixedToInt(RoundI(value * factor))))
    );
}

void APRG_ApplyMercenaryRecruitCatalog(int player) {
    int affordableStacks = APRG_MercenaryUpgradeStacks(4);
    int repeatStacks = APRG_MercenaryUpgradeStacks(5);
    int count;
    int i;
    int infoCount;
    int infoIndex;
    int producedCount;
    int producedIndex;
    int costCount;
    int costIndex;
    string unitType;
    string abilityType;
    string candidateUnitType;
    string basePath;
    string costPath;
    fixed factor = 1.0;
    fixed value;
    if (g_aprgMercenaryCatalogApplied) { return; }

    for (i = 0; i < affordableStacks; i += 1) { factor *= 0.5; }

    if (affordableStacks > 0) {
        count = CatalogEntryCount(c_gameCatalogUnit);
        if (count > 4096) { count = 4096; }
        for (i = 1; i <= count; i += 1) {
            unitType = CatalogEntryGet(c_gameCatalogUnit, i);
            if (!APRG_IsMercenaryUnitType(unitType)) { continue; }
            APRG_ScaleMercenaryUnitCost(player, unitType, factor);
        }

        count = CatalogEntryCount(c_gameCatalogAbil);
        if (count > 4096) { count = 4096; }
        for (i = 1; i <= count; i += 1) {
            abilityType = CatalogEntryGet(c_gameCatalogAbil, i);
            if (!APRG_IsMercenaryRecruitAbility(abilityType, player)) { continue; }
            infoCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, "InfoArray", player);
            if (infoCount > 64) { infoCount = 64; }
            for (infoIndex = 0; infoIndex < infoCount; infoIndex += 1) {
                basePath = "InfoArray[" + IntToString(infoIndex) + "]";
                if (!APRG_MercenaryCommandProducesUnit(abilityType, infoIndex, player)) { continue; }
                APRG_ScaleMercenaryAbilityResourceField(player, abilityType, basePath + ".Resource[0]", factor);
                APRG_ScaleMercenaryAbilityResourceField(player, abilityType, basePath + ".Resource[1]", factor);
                APRG_ScaleMercenaryAbilityResourceField(player, abilityType, basePath + ".Cost.Resource[0]", factor);
                APRG_ScaleMercenaryAbilityResourceField(player, abilityType, basePath + ".Cost.Resource[1]", factor);

                candidateUnitType = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, basePath + ".Unit", player);
                if (candidateUnitType != "") { APRG_ScaleMercenaryUnitCost(player, candidateUnitType, factor); }
                producedCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, basePath + ".Unit", player);
                if (producedCount > 16) { producedCount = 16; }
                for (producedIndex = 0; producedIndex < producedCount; producedIndex += 1) {
                    candidateUnitType = CatalogFieldValueGet(
                        c_gameCatalogAbil, abilityType,
                        basePath + ".Unit[" + IntToString(producedIndex) + "]", player
                    );
                    if (candidateUnitType != "") { APRG_ScaleMercenaryUnitCost(player, candidateUnitType, factor); }
                }

                costCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, basePath + ".Cost", player);
                if (costCount > 8) { costCount = 8; }
                for (costIndex = 0; costIndex < costCount; costIndex += 1) {
                    costPath = basePath + ".Cost[" + IntToString(costIndex) + "]";
                    APRG_ScaleMercenaryAbilityResourceField(player, abilityType, costPath + ".Resource[0]", factor);
                    APRG_ScaleMercenaryAbilityResourceField(player, abilityType, costPath + ".Resource[1]", factor);
                }
            }
            APRG_ScaleMercenaryAbilityResourceField(player, abilityType, "Resource[0]", factor);
            APRG_ScaleMercenaryAbilityResourceField(player, abilityType, "Resource[1]", factor);
            APRG_ScaleMercenaryAbilityResourceField(player, abilityType, "Cost.Resource[0]", factor);
            APRG_ScaleMercenaryAbilityResourceField(player, abilityType, "Cost.Resource[1]", factor);
            costCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, "Cost", player);
            if (costCount > 8) { costCount = 8; }
            for (costIndex = 0; costIndex < costCount; costIndex += 1) {
                costPath = "Cost[" + IntToString(costIndex) + "]";
                APRG_ScaleMercenaryAbilityResourceField(player, abilityType, costPath + ".Resource[0]", factor);
                APRG_ScaleMercenaryAbilityResourceField(player, abilityType, costPath + ".Resource[1]", factor);
            }
        }
    }

    APRG_ApplyRepeatContractorCooldowns(player, repeatStacks);
    g_aprgMercenaryCatalogApplied = true;
}

void APRG_ApplyMercenaryUnitUpgrades(unit u, int player) {
    int eliteStacks = APRG_MercenaryUpgradeStacks(0);
    int armoredStacks = APRG_MercenaryUpgradeStacks(1);
    int regenStacks = APRG_MercenaryUpgradeStacks(2);
    int sniperStacks = APRG_MercenaryUpgradeStacks(3);
    int spotterStacks = APRG_MercenaryUpgradeStacks(6);
    string unitType;
    string weaponType;
    string key;
    int wi;
    int wc;
    fixed maximum;
    fixed life;
    fixed ratio;
    fixed value;
    if (u == null || !UnitIsAlive(u)) { return; }
    unitType = UnitGetType(u);
    if (!APRG_IsMercenaryUnitType(unitType)) { return; }

    if (spotterStacks > 0) {
        key = "APRG_MercSight_" + IntToString(player) + "_" + unitType;
        if (!DataTableGetBool(true, key)) {
            value = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "Sight", player));
            if (value > 0.0) {
                CatalogFieldValueSet(
                    c_gameCatalogUnit, unitType, "Sight", player,
                    FixedToString(value + 5.0 * IntToFixed(spotterStacks), c_fixedPrecisionAny)
                );
            }
            DataTableSetBool(true, key, true);
        }
    }

    if (armoredStacks > 0) {
        key = "APRG_MercArmor_" + IntToString(player) + "_" + unitType;
        if (!DataTableGetBool(true, key)) {
            CatalogFieldValueModify(c_gameCatalogUnit, unitType, "LifeArmor", player, FixedToString(1.0 * IntToFixed(armoredStacks), c_fixedPrecisionAny), c_upgradeOperationAdd);
            DataTableSetBool(true, key, true);
        }
    }
    if (sniperStacks > 0) {
        wc = UnitWeaponCount(u);
        for (wi = 1; wi <= wc; wi += 1) {
            weaponType = UnitWeaponGet(u, wi);
            if (weaponType == "") { continue; }
            key = "APRG_MercRange_" + IntToString(player) + "_" + weaponType;
            if (DataTableGetBool(true, key)) { continue; }
            value = StringToFixed(CatalogFieldValueGet(c_gameCatalogWeapon, weaponType, "Range", player));
            if (value > 0.0) {
                CatalogFieldValueModify(c_gameCatalogWeapon, weaponType, "Range", player, FixedToString(value * 0.5 * IntToFixed(sniperStacks), c_fixedPrecisionAny), c_upgradeOperationAdd);
            }
            DataTableSetBool(true, key, true);
        }
    }
    if (eliteStacks > 0 && !UnitGroupHasUnit(g_aprgMercenaryHpProcessed, u)) {
        maximum = UnitGetPropertyFixed(u, c_unitPropLifeMax, c_unitPropCurrent);
        life = UnitGetPropertyFixed(u, c_unitPropLife, c_unitPropCurrent);
        if (maximum > 0.0) {
            ratio = life / maximum;
            maximum = maximum * (1.0 + 0.25 * IntToFixed(eliteStacks));
            UnitSetPropertyFixed(u, c_unitPropLifeMax, maximum);
            UnitSetPropertyFixed(u, c_unitPropLife, maximum * ratio);
        }
        UnitGroupAdd(g_aprgMercenaryHpProcessed, u);
    }
    if (regenStacks > 0) {
        maximum = UnitGetPropertyFixed(u, c_unitPropLifeMax, c_unitPropCurrent);
        life = UnitGetPropertyFixed(u, c_unitPropLife, c_unitPropCurrent);
        if (maximum > 0.0 && life < maximum) {
            UnitSetPropertyFixed(u, c_unitPropLife, MinF(maximum, life + 1.0 * IntToFixed(regenStacks)));
        }
    }
}

bool APRG_UnitNearMercenary(unit target, unitgroup playerUnits) {
    int i;
    unit candidate;
    if (target == null || playerUnits == null) { return false; }
    for (i = UnitGroupCount(playerUnits, c_unitCountAlive); i > 0; i -= 1) {
        candidate = UnitGroupUnitFromEnd(playerUnits, i);
        if (candidate == null || candidate == target || !UnitIsAlive(candidate)) { continue; }
        if (!APRG_IsMercenaryUnitType(UnitGetType(candidate))) { continue; }
        if (DistanceBetweenPoints(UnitGetPosition(target), UnitGetPosition(candidate)) <= 8.0) { return true; }
    }
    return false;
}

void APRG_SetSupportCrewAura(unit u, int player, int supportStacks, bool shouldHave) {
    string key;
    string unitType;
    bool hasAura;
    fixed factor;
    fixed maximum;
    fixed current;
    fixed ratio;
    fixed maxRange = 0.0;
    fixed weaponRange;
    fixed lifeArmor;
    fixed shieldArmor;
    int wi;
    int wc;
    int behaviorStacks;
    if (u == null || !UnitIsAlive(u) || supportStacks <= 0) { return; }
    if (APRG_IsMercenaryUnitType(UnitGetType(u))) { return; }
    key = "APRG_SupportCrewActive_" + IntToString(UnitGetTag(u));
    hasAura = DataTableGetBool(true, key);
    if (hasAura == shouldHave) { return; }
    factor = 1.0 + 0.15 * IntToFixed(supportStacks);
    unitType = UnitGetType(u);

    maximum = UnitGetPropertyFixed(u, c_unitPropLifeMax, c_unitPropCurrent);
    current = UnitGetPropertyFixed(u, c_unitPropLife, c_unitPropCurrent);
    if (maximum > 0.0) {
        ratio = current / maximum;
        if (shouldHave) { maximum *= factor; }
        else { maximum /= factor; }
        UnitSetPropertyFixed(u, c_unitPropLifeMax, maximum);
        UnitSetPropertyFixed(u, c_unitPropLife, MinF(maximum, maximum * ratio));
    }

    if (shouldHave) {
        if (CatalogEntryIsValid(c_gameCatalogBehavior, "APRogueSupportCrewDamage")) {
            UnitBehaviorAdd(u, "APRogueSupportCrewDamage", u, supportStacks);
        }
        wc = UnitWeaponCount(u);
        for (wi = 1; wi <= wc; wi += 1) {
            weaponRange = UnitWeaponRange(u, wi);
            if (weaponRange > maxRange) { maxRange = weaponRange; }
        }
        if (maxRange > 0.0 && CatalogEntryIsValid(c_gameCatalogBehavior, "APRogueSupportCrewRange005")) {
            behaviorStacks = MaxI(1, FixedToInt(RoundI(maxRange * 3.0 * IntToFixed(supportStacks))));
            UnitBehaviorAdd(u, "APRogueSupportCrewRange005", u, behaviorStacks);
        }
        lifeArmor = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "LifeArmor", player));
        if (lifeArmor > 0.0 && CatalogEntryIsValid(c_gameCatalogBehavior, "APRogueSupportCrewLifeArmor005")) {
            behaviorStacks = MaxI(1, FixedToInt(RoundI(lifeArmor * 3.0 * IntToFixed(supportStacks))));
            UnitBehaviorAdd(u, "APRogueSupportCrewLifeArmor005", u, behaviorStacks);
        }
        shieldArmor = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "ShieldArmor", player));
        if (shieldArmor > 0.0 && CatalogEntryIsValid(c_gameCatalogBehavior, "APRogueSupportCrewShieldArmor005")) {
            behaviorStacks = MaxI(1, FixedToInt(RoundI(shieldArmor * 3.0 * IntToFixed(supportStacks))));
            UnitBehaviorAdd(u, "APRogueSupportCrewShieldArmor005", u, behaviorStacks);
        }
        DataTableSetBool(true, key, true);
    }
    else {
        UnitBehaviorRemove(u, "APRogueSupportCrewDamage", c_unitBehaviorCountAll);
        UnitBehaviorRemove(u, "APRogueSupportCrewRange005", c_unitBehaviorCountAll);
        UnitBehaviorRemove(u, "APRogueSupportCrewLifeArmor005", c_unitBehaviorCountAll);
        UnitBehaviorRemove(u, "APRogueSupportCrewShieldArmor005", c_unitBehaviorCountAll);
        DataTableSetBool(true, key, false);
    }
}

void APRG_TickSupportCrew(int player, unitgroup playerUnits) {
    int supportStacks = APRG_MercenaryUpgradeStacks(7);
    int i;
    unit u;
    bool nearMerc;
    if (supportStacks <= 0 || playerUnits == null) { return; }
    for (i = UnitGroupCount(playerUnits, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(playerUnits, i);
        if (u == null || !UnitIsAlive(u) || APRG_IsMercenaryUnitType(UnitGetType(u))) { continue; }
        nearMerc = APRG_UnitNearMercenary(u, playerUnits);
        APRG_SetSupportCrewAura(u, player, supportStacks, nearMerc);
    }
}

void APRG_TickMercenaryUpgrades(int player) {
    unitgroup units;
    int i;
    unit u;
    if (g_aprgMercenaryUpgradePacked <= 0 && g_aprgMercenaryUpgradePacked2 <= 0) { return; }
    APRG_ApplyMercenaryRecruitCatalog(player);
    units = APRG_PlayerMobileUnits(player);
    for (i = UnitGroupCount(units, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        APRG_ApplyMercenaryUnitUpgrades(u, player);
    }
    APRG_TickSupportCrew(player, units);
}

void APRG_DealDirectDamage(unit target, fixed damage) {
    fixed shields;
    fixed life;
    fixed remaining;
    if (target == null || !UnitIsAlive(target) || damage <= 0.0) { return; }
    remaining = damage;
    shields = UnitGetPropertyFixed(target, c_unitPropShields, c_unitPropCurrent);
    if (shields > 0.0) {
        if (shields >= remaining) {
            UnitSetPropertyFixed(target, c_unitPropShields, shields - remaining);
            return;
        }
        UnitSetPropertyFixed(target, c_unitPropShields, 0.0);
        remaining -= shields;
    }
    life = UnitGetPropertyFixed(target, c_unitPropLife, c_unitPropCurrent);
    if (life <= remaining) { UnitKill(target); }
    else { UnitSetPropertyFixed(target, c_unitPropLife, life - remaining); }
}

bool APRG_MercenaryDamage_Func(bool testConds, bool runActions) {
    int eliteStacks;
    int player;
    int owner;
    unit source;
    unit victim;
    fixed damage;
    if (!runActions || !g_aprgStarted || g_aprgMercenaryDamageBusy) { return true; }
    eliteStacks = APRG_MercenaryUpgradeStacks(0);
    if (eliteStacks <= 0) { return true; }
    source = EventUnitDamageSourceUnit();
    victim = EventUnit();
    if (source == null || victim == null || source == victim || !APRG_IsMercenaryUnitType(UnitGetType(source))) { return true; }
    player = APRG_GetPrimaryPlayer();
    if (UnitGetOwner(source) != player) { return true; }
    owner = UnitGetOwner(victim);
    if (owner < 0 || !libNtve_gf_PlayerIsEnemy(owner, player, libNtve_ge_PlayerRelation_Enemy)) { return true; }
    damage = EventUnitDamageAmount();
    if (damage <= 0.0) { return true; }
    g_aprgMercenaryDamageBusy = true;
    APRG_DealDirectDamage(victim, damage * 0.25 * IntToFixed(eliteStacks));
    g_aprgMercenaryDamageBusy = false;
    return true;
}

unit APRG_FindSpearCaster(int player);
unit APRG_FindSpearAutonomousCaster(int player);

bool APRG_IsSpearCasterType(string unitType) {
    return (
        unitType == "AP_SoACaster" || unitType == "AP_SoAAutonomousCaster" ||
        unitType == "SoACaster" || unitType == "SOACaster" ||
        unitType == "SpearOfAdunCaster" || unitType == "VoidSpearofAdun"
    );
}

int APRG_MarkUnlimitedPowerSpearAbilities(unit caster) {
    int abilityCount;
    int abilityIndex;
    int marked = 0;
    string abilityType;
    if (caster == null) { return 0; }
    abilityCount = MinI(64, UnitAbilityCount(caster));
    for (abilityIndex = 1; abilityIndex <= abilityCount; abilityIndex += 1) {
        abilityType = UnitAbilityGet(caster, abilityIndex);
        if (abilityType == "") { continue; }
        DataTableSetBool(true, "APRG_UnlimitedPowerExclude_" + abilityType, true);
        marked += 1;
    }
    return marked;
}

bool APRG_PrepareUnlimitedPowerSpearExclusions(int player) {
    unit caster;
    unit autonomousCaster;
    bool spearExpected;
    int marked;
    caster = APRG_FindSpearCaster(player);
    autonomousCaster = APRG_FindSpearAutonomousCaster(player);
    marked = APRG_MarkUnlimitedPowerSpearAbilities(caster);
    marked += APRG_MarkUnlimitedPowerSpearAbilities(autonomousCaster);

    spearExpected = (
        APRG_HasProgression(APRG_PROGRESSION_SPEAR) ||
        APRG_HasExtension3(APRG_EXT3_BLESS_SPEAR_OF_ADUN) ||
        APRG_HasExtension3(APRG_EXT3_BLESS_SPEAR_OVERCHARGE)
    );
    if (spearExpected && (caster == null && autonomousCaster == null || marked <= 0)) { return false; }
    return true;
}

bool APRG_UnlimitedPowerAbilityExcluded(string abilityType) {
    if (abilityType == "") { return false; }
    return DataTableGetBool(true, "APRG_UnlimitedPowerExclude_" + abilityType);
}

void APRG_UnlimitedPowerZeroCostPath(int player, string abilityType, string basePath) {
    string field;
    string value;
    fixed numeric;
    if (abilityType == "" || basePath == "" || !CatalogEntryIsValid(c_gameCatalogAbil, abilityType)) { return; }
    field = basePath + ".Vital[Energy]";
    value = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, field, player);
    numeric = StringToFixed(value); if (value != "" && numeric > 0.0) { CatalogFieldValueSet(c_gameCatalogAbil, abilityType, field, player, FixedToString(numeric * 0.5, c_fixedPrecisionAny)); }
    field = basePath + ".VitalFraction[Energy]";
    value = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, field, player);
    numeric = StringToFixed(value); if (value != "" && numeric > 0.0) { CatalogFieldValueSet(c_gameCatalogAbil, abilityType, field, player, FixedToString(numeric * 0.5, c_fixedPrecisionAny)); }
    field = basePath + ".Cooldown.TimeStart";
    value = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, field, player);
    numeric = StringToFixed(value); if (value != "" && numeric > 0.0) { CatalogFieldValueSet(c_gameCatalogAbil, abilityType, field, player, FixedToString(numeric * 0.5, c_fixedPrecisionAny)); }
    field = basePath + ".Cooldown.TimeUse";
    value = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, field, player);
    numeric = StringToFixed(value); if (value != "" && numeric > 0.0) { CatalogFieldValueSet(c_gameCatalogAbil, abilityType, field, player, FixedToString(numeric * 0.5, c_fixedPrecisionAny)); }
    field = basePath + ".Charge.TimeStart";
    value = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, field, player);
    numeric = StringToFixed(value); if (value != "" && numeric > 0.0) { CatalogFieldValueSet(c_gameCatalogAbil, abilityType, field, player, FixedToString(numeric * 0.5, c_fixedPrecisionAny)); }
    field = basePath + ".Charge.TimeUse";
    value = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, field, player);
    numeric = StringToFixed(value); if (value != "" && numeric > 0.0) { CatalogFieldValueSet(c_gameCatalogAbil, abilityType, field, player, FixedToString(numeric * 0.5, c_fixedPrecisionAny)); }
}

void APRG_ApplyUnlimitedPowerAbility(int player, string abilityType) {
    int costCount;
    int costIndex;
    int infoCount;
    int infoIndex;
    int nestedCostCount;
    int nestedCostIndex;
    string infoPath;
    if (
        abilityType == "" || !CatalogEntryIsValid(c_gameCatalogAbil, abilityType) ||
        APRG_UnlimitedPowerAbilityExcluded(abilityType)
    ) { return; }

    APRG_UnlimitedPowerZeroCostPath(player, abilityType, "Cost");
    costCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, "Cost", player);
    for (costIndex = 0; costIndex < costCount; costIndex += 1) {
        APRG_UnlimitedPowerZeroCostPath(player, abilityType, "Cost[" + IntToString(costIndex) + "]");
    }

    infoCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, "InfoArray", player);
    for (infoIndex = 0; infoIndex < infoCount; infoIndex += 1) {
        infoPath = "InfoArray[" + IntToString(infoIndex) + "]";
        APRG_UnlimitedPowerZeroCostPath(player, abilityType, infoPath);
        APRG_UnlimitedPowerZeroCostPath(player, abilityType, infoPath + ".Cost");
        nestedCostCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, infoPath + ".Cost", player);
        for (nestedCostIndex = 0; nestedCostIndex < nestedCostCount; nestedCostIndex += 1) {
            APRG_UnlimitedPowerZeroCostPath(
                player,
                abilityType,
                infoPath + ".Cost[" + IntToString(nestedCostIndex) + "]"
            );
        }
    }
}

void APRG_ApplyUnlimitedPowerCatalog(int player) {
    int count;
    int i;
    string abilityType;
    if (g_aprgUnlimitedPowerCatalogApplied) { return; }
    if (!APRG_PrepareUnlimitedPowerSpearExclusions(player)) { return; }
    count = CatalogEntryCount(c_gameCatalogAbil);
    for (i = 1; i <= count; i += 1) {
        abilityType = CatalogEntryGet(c_gameCatalogAbil, i);
        APRG_ApplyUnlimitedPowerAbility(player, abilityType);
    }
    g_aprgUnlimitedPowerCatalogApplied = true;
}

void APRG_TickUnlimitedPower(int player) {
    APRG_ApplyUnlimitedPowerCatalog(player);
}

bool APRG_IsColossusFamilyType(string unitType) {
    return unitType != "" && StringContains(unitType, "Colossus", c_stringAnywhere, c_stringNoCase);
}

void APRG_TickUnstableColossi(int player) {
    unitgroup units;
    int i;
    unit u;
    string unitType;
    string key;
    string oldBehavior;
    string newBehavior;
    int oldStage;
    int newStage;
    fixed life;
    fixed maxLife;
    fixed ratio;

    units = APRG_PlayerMobileUnits(player);
    i = UnitGroupCount(units, c_unitCountAlive);
    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null) { break; }
        unitType = UnitGetType(u);
        if (!APRG_IsColossusFamilyType(unitType)) { continue; }
        maxLife = UnitGetPropertyFixed(u, c_unitPropLifeMax, c_unitPropCurrent);
        life = UnitGetPropertyFixed(u, c_unitPropLife, c_unitPropCurrent);
        if (maxLife <= 0.0) { continue; }
        ratio = life / maxLife;
        if (ratio < 0.0) { ratio = 0.0; }
        if (ratio > 1.0) { ratio = 1.0; }
        newStage = FixedToInt((1.0 - ratio) * 15.99);
        if (newStage < 0) { newStage = 0; }
        if (newStage > 15) { newStage = 15; }
        key = "APRG_UnstableColossiStage_" + IntToString(UnitGetTag(u));
        oldStage = DataTableGetInt(true, key);
        if (oldStage == newStage) { continue; }
        if (oldStage > 0) {
            oldBehavior = "APRogueUnstableColossi" + IntToString(oldStage);
            UnitBehaviorRemove(u, oldBehavior, c_unitBehaviorCountAll);
        }
        if (newStage > 0) {
            newBehavior = "APRogueUnstableColossi" + IntToString(newStage);
            UnitBehaviorAdd(u, newBehavior, u, 1);
        }
        DataTableSetInt(true, key, newStage);
    }
}

bool APRG_HordeUnitTypeQualifies(int player, string unitType) {
    if (unitType == "" || !CatalogEntryIsValid(c_gameCatalogUnit, unitType)) { return false; }
    return !UnitTypeTestAttribute(unitType, c_unitAttributeStructure);
}

bool APRG_HordeProductionIntermediateType(string unitType) {
    return StringContains(unitType, "Larva", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Egg", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Cocoon", c_stringAnywhere, c_stringNoCase);
}

bool APRG_HordeAbilityInfoProducesUnit(int player, string abilityType, string unitType) {
    int infoCount;
    int infoIndex;
    int unitCount;
    int unitIndex;
    string basePath;
    string producedUnit;
    if (abilityType == null || abilityType == "" || unitType == "" || !CatalogEntryIsValid(c_gameCatalogAbil, abilityType)) { return false; }
    infoCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, "InfoArray", player);
    for (infoIndex = 0; infoIndex < infoCount; infoIndex += 1) {
        basePath = "InfoArray[" + IntToString(infoIndex) + "]";
        producedUnit = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, basePath + ".Unit", player);
        if (producedUnit == unitType) { return true; }
        unitCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, basePath + ".Unit", player);
        for (unitIndex = 0; unitIndex < unitCount; unitIndex += 1) {
            producedUnit = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, basePath + ".Unit[" + IntToString(unitIndex) + "]", player);
            if (producedUnit == unitType) { return true; }
        }
    }
    return false;
}

void APRG_ApplyHordeProducedUnit(unit u, int player) {
    string unitType;
    string tagKey;
    string processedType;
    string lifeBaseKey;
    string lifeTargetKey;
    string shieldBaseKey;
    string shieldTargetKey;
    fixed oldMax;
    fixed oldCurrent;
    fixed baseline;
    fixed target;
    fixed ratio;
    if (u == null || UnitGetOwner(u) != player || !UnitIsAlive(u)) { return; }
    unitType = UnitGetType(u);
    if (!APRG_HordeUnitTypeQualifies(player, unitType) || APRG_HordeProductionIntermediateType(unitType)) { return; }

    tagKey = IntToString(UnitGetTag(u));
    processedType = DataTableGetString(true, "APRG_HordeProducedType_" + tagKey);
    lifeBaseKey = "APRG_HordeLifeBase_" + tagKey;
    lifeTargetKey = "APRG_HordeLifeTarget_" + tagKey;
    shieldBaseKey = "APRG_HordeShieldBase_" + tagKey;
    shieldTargetKey = "APRG_HordeShieldTarget_" + tagKey;

    oldMax = UnitGetPropertyFixed(u, c_unitPropLifeMax, c_unitPropCurrent);
    oldCurrent = UnitGetPropertyFixed(u, c_unitPropLife, c_unitPropCurrent);
    if (oldMax > 0.0) {
        if (processedType != unitType) {
            baseline = oldMax;
            DataTableSetFixed(true, lifeBaseKey, baseline);
            DataTableSetFixed(true, lifeTargetKey, baseline * 0.75);
        }
        else {
            baseline = DataTableGetFixed(true, lifeBaseKey);
            target = DataTableGetFixed(true, lifeTargetKey);
            if (target > 0.0 && oldMax > target + 0.05) {
                baseline = oldMax;
                DataTableSetFixed(true, lifeBaseKey, baseline);
                DataTableSetFixed(true, lifeTargetKey, baseline * 0.75);
            }
        }
        target = DataTableGetFixed(true, lifeTargetKey);
        if (target <= 0.0) { target = oldMax * 0.75; }
        if (oldMax > target + 0.05 || oldMax < target - 0.05) {
            ratio = oldCurrent / oldMax;
            if (ratio < 0.0) { ratio = 0.0; }
            if (ratio > 1.0) { ratio = 1.0; }
            UnitSetPropertyFixed(u, c_unitPropLifeMax, target);
            UnitSetPropertyFixed(u, c_unitPropLife, target * ratio);
        }
    }

    oldMax = UnitGetPropertyFixed(u, c_unitPropShieldsMax, c_unitPropCurrent);
    oldCurrent = UnitGetPropertyFixed(u, c_unitPropShields, c_unitPropCurrent);
    if (oldMax > 0.0) {
        if (processedType != unitType) {
            baseline = oldMax;
            DataTableSetFixed(true, shieldBaseKey, baseline);
            DataTableSetFixed(true, shieldTargetKey, baseline * 0.75);
        }
        else {
            baseline = DataTableGetFixed(true, shieldBaseKey);
            target = DataTableGetFixed(true, shieldTargetKey);
            if (target > 0.0 && oldMax > target + 0.05) {
                baseline = oldMax;
                DataTableSetFixed(true, shieldBaseKey, baseline);
                DataTableSetFixed(true, shieldTargetKey, baseline * 0.75);
            }
        }
        target = DataTableGetFixed(true, shieldTargetKey);
        if (target <= 0.0) { target = oldMax * 0.75; }
        if (oldMax > target + 0.05 || oldMax < target - 0.05) {
            ratio = oldCurrent / oldMax;
            if (ratio < 0.0) { ratio = 0.0; }
            if (ratio > 1.0) { ratio = 1.0; }
            UnitSetPropertyFixed(u, c_unitPropShieldsMax, target);
            UnitSetPropertyFixed(u, c_unitPropShields, target * ratio);
        }
    }
    UnitSetScale(u, 75.0, 75.0, 75.0);
    DataTableSetString(true, "APRG_HordeProducedType_" + tagKey, unitType);
}

bool APRG_HordeTrain_Func(bool testConds, bool runActions) {
    int player;
    unit trained;
    if (!runActions || !g_aprgStarted || !APRG_HasExtension(APRG_EXT_BLESS_HORDE_MODE)) { return true; }
    player = APRG_GetPrimaryPlayer();
    if (EventPlayer() != player) { return true; }
    trained = EventUnitProgressUnit();
    APRG_ApplyHordeProducedUnit(trained, player);
    return true;
}

bool APRG_HordeCreated_Func(bool testConds, bool runActions) {
    int player;
    unit creator;
    unit created;
    string createdType;
    string abilityType;
    bool structureSource = false;
    bool mercenarySource = false;
    if (!runActions || !g_aprgStarted || !APRG_HasExtension(APRG_EXT_BLESS_HORDE_MODE)) { return true; }
    player = APRG_GetPrimaryPlayer();
    created = EventUnitCreatedUnit();
    creator = EventUnit();
    if (created == null || UnitGetOwner(created) != player) { return true; }
    createdType = UnitGetType(created);
    if (!APRG_HordeUnitTypeQualifies(player, createdType) || APRG_HordeProductionIntermediateType(createdType)) { return true; }

    abilityType = EventUnitCreatedAbil();
    if (creator != null && UnitGetOwner(creator) == player && UnitTypeTestAttribute(UnitGetType(creator), c_unitAttributeStructure)) {
        structureSource = true;
    }
    mercenarySource = APRG_IsMercenaryRecruitAbility(abilityType, player);
    if (!structureSource && !mercenarySource) { return true; }
    APRG_ApplyHordeProducedUnit(created, player);
    return true;
}

void APRG_HordeHalveAbilityField(int player, string abilityType, string fieldPath) {
    fixed value;
    value = StringToFixed(CatalogFieldValueGet(c_gameCatalogAbil, abilityType, fieldPath, player));
    if (value > 0.0) {
        CatalogFieldValueSet(c_gameCatalogAbil, abilityType, fieldPath, player, FixedToString(value * 0.5, c_fixedPrecisionAny));
    }
}

void APRG_HordeHalveAbilityResourceField(int player, string abilityType, string fieldPath) {
    fixed value;
    int halved;
    value = StringToFixed(CatalogFieldValueGet(c_gameCatalogAbil, abilityType, fieldPath, player));
    if (value <= 0.0) { return; }
    halved = FixedToInt(RoundI(value * 0.5));
    if (halved < 1) { halved = 1; }
    CatalogFieldValueSet(c_gameCatalogAbil, abilityType, fieldPath, player, IntToString(halved));
}

void APRG_ApplyHordeCatalog(int player) {
    int count;
    int i;
    int infoCount;
    int infoIndex;
    int producedCount;
    int producedIndex;
    int sectionCount;
    int sectionIndex;
    int durationCount;
    int durationIndex;
    int costCount;
    int costIndex;
    string unitType;
    string abilityType;
    string trainedUnitType;
    string candidateUnitType;
    string basePath;
    string sectionPath;
    string durationPath;
    string costPath;
    fixed food;
    fixed mineralCost;
    fixed gasCost;
    fixed unitBuildTime;
    fixed originalSupply;
    bool infoProducesUnit;
    bool producesUnit;
    bool mercAbility;
    if (g_aprgHordeCatalogApplied) { return; }

    count = CatalogEntryCount(c_gameCatalogUnit);
    for (i = 1; i <= count; i += 1) {
        unitType = CatalogEntryGet(c_gameCatalogUnit, i);
        if (!APRG_HordeUnitTypeQualifies(player, unitType)) { continue; }

        originalSupply = UnitTypeGetProperty(unitType, c_unitPropSuppliesUsed);
        if (originalSupply > 0.0) {
            DataTableSetFixed(true, "APRG_HordeOriginalSupply_" + IntToString(player) + "_" + unitType, originalSupply);
        }

        mineralCost = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "CostResource[0]", player));
        gasCost = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "CostResource[1]", player));
        if (mineralCost > 0.0) { CatalogFieldValueSet(c_gameCatalogUnit, unitType, "CostResource[0]", player, IntToString(MaxI(1, FixedToInt(RoundI(mineralCost * 0.5))))); }
        if (gasCost > 0.0) { CatalogFieldValueSet(c_gameCatalogUnit, unitType, "CostResource[1]", player, IntToString(MaxI(1, FixedToInt(RoundI(gasCost * 0.5))))); }

        food = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "Food", player));
        if (food < 0.0) { CatalogFieldValueSet(c_gameCatalogUnit, unitType, "Food", player, FixedToString(food * 0.5, c_fixedPrecisionAny)); }

        unitBuildTime = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "BuildTime", player));
        if (unitBuildTime > 0.0) {
            CatalogFieldValueSet(c_gameCatalogUnit, unitType, "BuildTime", player, FixedToString(unitBuildTime * 0.5, c_fixedPrecisionAny));
        }
    }

    count = CatalogEntryCount(c_gameCatalogAbil);
    for (i = 1; i <= count; i += 1) {
        abilityType = CatalogEntryGet(c_gameCatalogAbil, i);
        if (abilityType == "" || !CatalogEntryIsValid(c_gameCatalogAbil, abilityType)) { continue; }
        // ArchonWarp consumes/merges units rather than training a normal unit.
        // Halving its resource/cost fields can create refunds when Horde Mode
        // and Power Overwhelming are combined, so leave this ability untouched.
        if (abilityType == "ArchonWarp") { continue; }
        producesUnit = false;
        mercAbility = StringContains(abilityType, "Hire", c_stringAnywhere, c_stringNoCase) ||
            StringContains(abilityType, "Merc", c_stringAnywhere, c_stringNoCase) ||
            StringContains(abilityType, "Mercenary", c_stringAnywhere, c_stringNoCase);
        infoCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, "InfoArray", player);
        for (infoIndex = 0; infoIndex < infoCount; infoIndex += 1) {
            basePath = "InfoArray[" + IntToString(infoIndex) + "]";
            infoProducesUnit = false;

            trainedUnitType = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, basePath + ".Unit", player);
            if (APRG_HordeUnitTypeQualifies(player, trainedUnitType)) {
                infoProducesUnit = true;
                if (APRG_IsMercenaryUnitType(trainedUnitType)) { mercAbility = true; }
            }
            producedCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, basePath + ".Unit", player);
            for (producedIndex = 0; producedIndex < producedCount; producedIndex += 1) {
                candidateUnitType = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, basePath + ".Unit[" + IntToString(producedIndex) + "]", player);
                if (!APRG_HordeUnitTypeQualifies(player, candidateUnitType)) { continue; }
                infoProducesUnit = true;
                if (APRG_IsMercenaryUnitType(candidateUnitType)) { mercAbility = true; }
            }
            if (!infoProducesUnit) { continue; }
            producesUnit = true;

            APRG_HordeHalveAbilityField(player, abilityType, basePath + ".Time");

            sectionCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, basePath + ".SectionArray", player);
            for (sectionIndex = 0; sectionIndex < sectionCount; sectionIndex += 1) {
                sectionPath = basePath + ".SectionArray[" + IntToString(sectionIndex) + "]";
                durationCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, sectionPath + ".DurationArray", player);
                for (durationIndex = 0; durationIndex < durationCount; durationIndex += 1) {
                    durationPath = sectionPath + ".DurationArray[" + IntToString(durationIndex) + "]";
                    APRG_HordeHalveAbilityField(player, abilityType, durationPath);
                }
            }

            APRG_HordeHalveAbilityResourceField(player, abilityType, basePath + ".Resource[0]");
            APRG_HordeHalveAbilityResourceField(player, abilityType, basePath + ".Resource[1]");
            APRG_HordeHalveAbilityResourceField(player, abilityType, basePath + ".Cost.Resource[0]");
            APRG_HordeHalveAbilityResourceField(player, abilityType, basePath + ".Cost.Resource[1]");

            APRG_HordeHalveAbilityField(player, abilityType, basePath + ".Cooldown.TimeUse");
            APRG_HordeHalveAbilityField(player, abilityType, basePath + ".Cooldown.TimeStart");
            APRG_HordeHalveAbilityField(player, abilityType, basePath + ".Cost.Cooldown.TimeUse");
            APRG_HordeHalveAbilityField(player, abilityType, basePath + ".Cost.Cooldown.TimeStart");
            APRG_HordeHalveAbilityField(player, abilityType, basePath + ".Charge.TimeUse");
            APRG_HordeHalveAbilityField(player, abilityType, basePath + ".Charge.TimeStart");
            APRG_HordeHalveAbilityField(player, abilityType, basePath + ".Cost.Charge.TimeUse");
            APRG_HordeHalveAbilityField(player, abilityType, basePath + ".Cost.Charge.TimeStart");
        }

        if (producesUnit || mercAbility) {
            APRG_HordeHalveAbilityResourceField(player, abilityType, "Resource[0]");
            APRG_HordeHalveAbilityResourceField(player, abilityType, "Resource[1]");
            APRG_HordeHalveAbilityResourceField(player, abilityType, "Cost.Resource[0]");
            APRG_HordeHalveAbilityResourceField(player, abilityType, "Cost.Resource[1]");
            APRG_HordeHalveAbilityField(player, abilityType, "Cost.Cooldown.TimeUse");
            APRG_HordeHalveAbilityField(player, abilityType, "Cost.Cooldown.TimeStart");
            APRG_HordeHalveAbilityField(player, abilityType, "Cost.Charge.TimeUse");
            APRG_HordeHalveAbilityField(player, abilityType, "Cost.Charge.TimeStart");

            costCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, "Cost", player);
            for (costIndex = 0; costIndex < costCount; costIndex += 1) {
                costPath = "Cost[" + IntToString(costIndex) + "]";
                APRG_HordeHalveAbilityResourceField(player, abilityType, costPath + ".Resource[0]");
                APRG_HordeHalveAbilityResourceField(player, abilityType, costPath + ".Resource[1]");
                APRG_HordeHalveAbilityField(player, abilityType, costPath + ".Cooldown.TimeUse");
                APRG_HordeHalveAbilityField(player, abilityType, costPath + ".Cooldown.TimeStart");
                APRG_HordeHalveAbilityField(player, abilityType, costPath + ".Charge.TimeUse");
                APRG_HordeHalveAbilityField(player, abilityType, costPath + ".Charge.TimeStart");
            }
        }
    }
    g_aprgHordeCatalogApplied = true;
}


bool APRG_HordeLarvaBaseType(string unitType) {
    if (StringContains(unitType, "HiveMindEmulator", c_stringAnywhere, c_stringNoCase)) { return false; }
    return StringContains(unitType, "Hatchery", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Lair", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Hive", c_stringAnywhere, c_stringNoCase);
}

int APRG_CountNearbyLarva(unit base, int player, fixed radius) {
    unitgroup nearby;
    int i;
    int count;
    unit u;
    if (base == null) { return 0; }
    nearby = UnitGroup(
        null, player, RegionCircle(UnitGetPosition(base), radius),
        UnitFilter(0, 0, (1 << c_targetFilterStructure) | (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0
    );
    count = 0;
    for (i = UnitGroupCount(nearby, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(nearby, i);
        if (u != null && StringContains(UnitGetType(u), "Larva", c_stringAnywhere, c_stringNoCase)) { count += 1; }
    }
    return count;
}

bool APRG_TriggerNativeLarvaInjection(unit base) {
    if (base == null || !UnitIsAlive(base)) { return false; }
    if (CatalogEntryIsValid(c_gameCatalogBehavior, "QueenSpawnLarvaTimer")) {
        UnitBehaviorAdd(base, "QueenSpawnLarvaTimer", base, 1);
        UnitBehaviorSetDurationRemaining(base, "QueenSpawnLarvaTimer", 0.25);
        return true;
    }
    if (CatalogEntryIsValid(c_gameCatalogBehavior, "SpawnLarva")) {
        UnitBehaviorSpawn(base, "SpawnLarva", 3);
        return true;
    }
    return false;
}

void APRG_TickHordeLarva(int player, fixed now) {
    unitgroup bases;
    int i;
    unit base;
    if (!APRG_PlayerMacroBaseReady(player) || now < g_aprgNextHordeLarvaTime) { return; }
    if (APRG_HasExtension2(APRG_EXT2_BLESS_INFINITE_LARVA)) { return; }
    g_aprgNextHordeLarvaTime = now + 33.0;
    bases = APRG_PlayerStructures(player);
    for (i = UnitGroupCount(bases, c_unitCountAlive); i > 0; i -= 1) {
        base = UnitGroupUnitFromEnd(bases, i);
        if (base == null || UnitGetOwner(base) != player || !APRG_HordeLarvaBaseType(UnitGetType(base))) { continue; }
        APRG_TriggerNativeLarvaInjection(base);
    }
}

void APRG_ApplyHordeMode(int player) {
    APRG_ApplyHordeCatalog(player);
}

void APRG_AddCommandCardButton(int player, string unitType, string face, string abilCmd, int row, int column) {
    int count;
    int i;
    int r;
    int c;
    string basePath;
    bool occupied;
    if (!CatalogEntryIsValid(c_gameCatalogUnit, unitType)) { return; }
    count = CatalogFieldValueCount(c_gameCatalogUnit, unitType, "CardLayouts[0].LayoutButtons", player);
    for (i = 0; i < count; i += 1) {
        basePath = "CardLayouts[0].LayoutButtons[" + IntToString(i) + "]";
        if (CatalogFieldValueGet(c_gameCatalogUnit, unitType, basePath + ".Face", player) == face) { return; }
    }

    occupied = false;
    for (i = 0; i < count; i += 1) {
        basePath = "CardLayouts[0].LayoutButtons[" + IntToString(i) + "]";
        if (CatalogFieldValueGet(c_gameCatalogUnit, unitType, basePath + ".Row", player) == IntToString(row)
            && CatalogFieldValueGet(c_gameCatalogUnit, unitType, basePath + ".Column", player) == IntToString(column)) {
            occupied = true;
            break;
        }
    }
    if (occupied) {
        for (r = 2; r >= 0; r -= 1) {
            for (c = 4; c >= 0; c -= 1) {
                occupied = false;
                for (i = 0; i < count; i += 1) {
                    basePath = "CardLayouts[0].LayoutButtons[" + IntToString(i) + "]";
                    if (CatalogFieldValueGet(c_gameCatalogUnit, unitType, basePath + ".Row", player) == IntToString(r)
                        && CatalogFieldValueGet(c_gameCatalogUnit, unitType, basePath + ".Column", player) == IntToString(c)) {
                        occupied = true;
                        break;
                    }
                }
                if (!occupied) {
                    row = r;
                    column = c;
                    r = -1;
                    break;
                }
            }
        }
    }

    basePath = "CardLayouts[0].LayoutButtons[" + IntToString(count) + "]";
    CatalogFieldValueSet(c_gameCatalogUnit, unitType, basePath + ".Face", player, face);
    CatalogFieldValueSet(c_gameCatalogUnit, unitType, basePath + ".Type", player, "AbilCmd");
    CatalogFieldValueSet(c_gameCatalogUnit, unitType, basePath + ".AbilCmd", player, abilCmd);
    CatalogFieldValueSet(c_gameCatalogUnit, unitType, basePath + ".Row", player, IntToString(row));
    CatalogFieldValueSet(c_gameCatalogUnit, unitType, basePath + ".Column", player, IntToString(column));
}

bool APRG_HideScvJumpJetsButtonsForType(int player, string unitType) {
    int count;
    int i;
    string basePath;
    string face;
    string abilCmd;
    bool changed = false;
    bool faceMatches;
    bool abilMatches;
    if (!CatalogEntryIsValid(c_gameCatalogUnit, unitType)) { return false; }
    count = CatalogFieldValueCount(c_gameCatalogUnit, unitType, "CardLayouts[0].LayoutButtons", player);
    for (i = 0; i < count; i += 1) {
        basePath = "CardLayouts[0].LayoutButtons[" + IntToString(i) + "]";
        face = CatalogFieldValueGet(c_gameCatalogUnit, unitType, basePath + ".Face", player);
        abilCmd = CatalogFieldValueGet(c_gameCatalogUnit, unitType, basePath + ".AbilCmd", player);
        faceMatches = StringContains(face, "Jump", c_stringAnywhere, c_stringNoCase) && StringContains(face, "Jet", c_stringAnywhere, c_stringNoCase);
        abilMatches = StringContains(abilCmd, "Jump", c_stringAnywhere, c_stringNoCase) && StringContains(abilCmd, "Jet", c_stringAnywhere, c_stringNoCase);
        if (!faceMatches && !abilMatches) { continue; }
        // Construction Jump Jets is passive. Keep the underlying upgrade/ability,
        // but remove its redundant command-card button so Slay's Archon Merge
        // button cannot share the same slot or tooltip.
        CatalogFieldValueSet(c_gameCatalogUnit, unitType, basePath + ".Face", player, "");
        CatalogFieldValueSet(c_gameCatalogUnit, unitType, basePath + ".Type", player, "");
        CatalogFieldValueSet(c_gameCatalogUnit, unitType, basePath + ".AbilCmd", player, "");
        changed = true;
    }
    return changed;
}

void APRG_HideScvJumpJetsCommandCard(int player) {
    APRG_HideScvJumpJetsButtonsForType(player, "SCV");
    APRG_HideScvJumpJetsButtonsForType(player, "AP_SCV");
}

string APRG_ArchonWarpButtonFace(int player) {
    string sourceUnitType = "";
    int count;
    int i;
    string basePath;
    string abilCmd;
    string face;
    if (CatalogEntryIsValid(c_gameCatalogUnit, "HighTemplar")) { sourceUnitType = "HighTemplar"; }
    else if (CatalogEntryIsValid(c_gameCatalogUnit, "DarkTemplar")) { sourceUnitType = "DarkTemplar"; }
    if (sourceUnitType == "") { return "AWrp"; }
    count = CatalogFieldValueCount(c_gameCatalogUnit, sourceUnitType, "CardLayouts[0].LayoutButtons", player);
    for (i = 0; i < count; i += 1) {
        basePath = "CardLayouts[0].LayoutButtons[" + IntToString(i) + "]";
        abilCmd = CatalogFieldValueGet(c_gameCatalogUnit, sourceUnitType, basePath + ".AbilCmd", player);
        if (!StringContains(abilCmd, "ArchonWarp", c_stringAnywhere, c_stringNoCase)) { continue; }
        face = CatalogFieldValueGet(c_gameCatalogUnit, sourceUnitType, basePath + ".Face", player);
        if (face != "") { return face; }
    }
    return "AWrp";
}

bool APRG_CopyArchonWarpButton(int player, string targetUnitType) {
    string sourceUnitType = "";
    int count;
    int i;
    string basePath;
    string abilCmd;
    string face;
    if (CatalogEntryIsValid(c_gameCatalogUnit, "HighTemplar")) { sourceUnitType = "HighTemplar"; }
    else if (CatalogEntryIsValid(c_gameCatalogUnit, "DarkTemplar")) { sourceUnitType = "DarkTemplar"; }
    if (sourceUnitType == "") { return false; }
    count = CatalogFieldValueCount(c_gameCatalogUnit, sourceUnitType, "CardLayouts[0].LayoutButtons", player);
    for (i = 0; i < count; i += 1) {
        basePath = "CardLayouts[0].LayoutButtons[" + IntToString(i) + "]";
        abilCmd = CatalogFieldValueGet(c_gameCatalogUnit, sourceUnitType, basePath + ".AbilCmd", player);
        if (!StringContains(abilCmd, "ArchonWarp", c_stringAnywhere, c_stringNoCase)) { continue; }
        face = CatalogFieldValueGet(c_gameCatalogUnit, sourceUnitType, basePath + ".Face", player);
        if (face == "" || abilCmd == "") { continue; }
        APRG_AddCommandCardButton(player, targetUnitType, face, abilCmd, 1, 3);
        return true;
    }
    return false;
}

void APRG_ApplyPowerOverwhelming(int player) {
    unitgroup workers;
    int i;
    unit u;
    string workerType;
    if (!APRG_PlayerMacroBaseReady(player) || !CatalogEntryIsValid(c_gameCatalogAbil, "ArchonWarp")) { return; }

    TechTreeAbilityAllow(player, AbilityCommand("ArchonWarp", 0), true);
    workers = APRG_PlayerWorkers(player);
    i = UnitGroupCount(workers, c_unitCountAlive);
    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(workers, i);
        if (u == null) { break; }
        workerType = UnitGetType(u);
        if (UnitGroupHasUnit(g_aprgPowerOverwhelmingProcessed, u)) { continue; }
        UnitAbilityAdd(u, "ArchonWarp");
        UnitAbilityShow(u, "ArchonWarp", true);
        UnitAbilityEnable(u, "ArchonWarp", true);
        APRG_HideScvJumpJetsButtonsForType(player, workerType);
        APRG_CopyArchonWarpButton(player, workerType);
        UnitGroupAdd(g_aprgPowerOverwhelmingProcessed, u);
    }
}

void APRG_ApplyDrakkenDrillBlessing(int player) {
    unitgroup workers;
    int i;
    unit u;
    string workerType;
    string drillType;
    if (!APRG_PlayerMacroBaseReady(player) || !CatalogEntryIsValid(c_gameCatalogAbil, "APRogueBuildDrakkenLaserDrill")) { return; }
    drillType = APRG_DrillUnitType();
    if (drillType == "") { return; }
    CatalogFieldValueSet(c_gameCatalogUnit, drillType, "CostResource[0]", player, "800");
    CatalogFieldValueSet(c_gameCatalogUnit, drillType, "CostResource[1]", player, "800");
    CatalogFieldValueSet(c_gameCatalogUnit, drillType, "BuildTime", player, "30");
    CatalogFieldValueSet(c_gameCatalogAbil, "APRogueBuildDrakkenLaserDrill", "InfoArray[Build1].Unit", player, drillType);
    CatalogFieldValueSet(c_gameCatalogAbil, "APRogueBuildDrakkenLaserDrill", "InfoArray[Build1].Time", player, "30");
    if (!g_aprgDrakkenDataUnlocked && CatalogEntryIsValid(c_gameCatalogUpgrade, "APRogueDrakkenUnlocked")) {
        TechTreeUpgradeAddLevel(player, "APRogueDrakkenUnlocked", 1);
        g_aprgDrakkenDataUnlocked = true;
    }
    TechTreeAbilityAllow(player, AbilityCommand("APRogueBuildDrakkenLaserDrill", 0), true);
    TechTreeAbilityAllow(player, AbilityCommand("APRogueBuildDrakkenLaserDrill", 1), true);
    workers = APRG_PlayerWorkers(player);
    i = UnitGroupCount(workers, c_unitCountAlive);
    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(workers, i);
        if (u == null) { break; }
        workerType = UnitGetType(u);
        if (UnitGroupHasUnit(g_aprgDrakkenDrillProcessed, u)) { continue; }
        UnitAbilityAdd(u, "APRogueBuildDrakkenLaserDrill");
        UnitAbilityShow(u, "APRogueBuildDrakkenLaserDrill", true);
        UnitAbilityEnable(u, "APRogueBuildDrakkenLaserDrill", true);
        APRG_AddCommandCardButton(player, workerType, "APRogueBuildDrakkenLaserDrillButton", "APRogueBuildDrakkenLaserDrill,Build1", 1, 4);
        UnitGroupAdd(g_aprgDrakkenDrillProcessed, u);
    }
}

string APRG_JetpacksModelForType(string unitType) {
    if (StringContains(unitType, "Marine", c_stringAnywhere, c_stringNoCase)) { return "Marine"; }
    if (StringContains(unitType, "Zealot", c_stringAnywhere, c_stringNoCase)) { return "Zealot"; }
    if (StringContains(unitType, "Zergling", c_stringAnywhere, c_stringNoCase)) { return "Zergling"; }
    return "";
}

string APRG_JetpacksShellForType(string unitType) {
    if (StringContains(unitType, "Burrowed", c_stringAnywhere, c_stringNoCase)
        || StringContains(unitType, "Egg", c_stringAnywhere, c_stringNoCase)
        || StringContains(unitType, "Cocoon", c_stringAnywhere, c_stringNoCase)
        || StringContains(unitType, "Respawn", c_stringAnywhere, c_stringNoCase)
        || StringContains(unitType, "Missile", c_stringAnywhere, c_stringNoCase)) {
        return "";
    }
    if (StringContains(unitType, "Marine", c_stringAnywhere, c_stringNoCase)
        || StringContains(unitType, "Zealot", c_stringAnywhere, c_stringNoCase)
        || StringContains(unitType, "Zergling", c_stringAnywhere, c_stringNoCase)) {
        return "Mutalisk";
    }
    return "";
}

void APRG_ConvertJetpacksUnit(unit source) {
    unit replacement;
    int owner;
    int weaponCount;
    int wi;
    fixed oldLifeMax;
    fixed oldLife;
    fixed oldShieldMax;
    fixed oldShields;
    fixed oldEnergyMax;
    fixed oldEnergy;
    fixed oldSpeed;
    fixed lifeRatio;
    fixed shieldRatio;
    fixed energyRatio;
    string sourceType;
    string sourceWeapon;
    string removeWeapon;
    string fallbackWeapon;
    string modelType;
    string shellType;
    order priorOrder;
    bool hadIssuedOrder;

    if (source == null || !UnitIsAlive(source)) { return; }
    sourceType = UnitGetType(source);
    shellType = APRG_JetpacksShellForType(sourceType);
    if (shellType == "" || !CatalogEntryIsValid(c_gameCatalogUnit, shellType)) { return; }
    owner = UnitGetOwner(source);
    if (owner < 0) { return; }

    hadIssuedOrder = false;
    if (UnitOrderCount(source) > 0 && !UnitOrderIsAcquired(source, 0)) {
        priorOrder = UnitOrder(source, 0);
        hadIssuedOrder = true;
    }

    oldLifeMax = UnitGetPropertyFixed(source, c_unitPropLifeMax, c_unitPropCurrent);
    oldLife = UnitGetPropertyFixed(source, c_unitPropLife, c_unitPropCurrent);
    oldShieldMax = UnitGetPropertyFixed(source, c_unitPropShieldsMax, c_unitPropCurrent);
    oldShields = UnitGetPropertyFixed(source, c_unitPropShields, c_unitPropCurrent);
    oldEnergyMax = UnitGetPropertyFixed(source, c_unitPropEnergyMax, c_unitPropCurrent);
    oldEnergy = UnitGetPropertyFixed(source, c_unitPropEnergy, c_unitPropCurrent);
    oldSpeed = UnitGetPropertyFixed(source, c_unitPropMovementSpeed, c_unitPropCurrent);
    lifeRatio = 1.0;
    shieldRatio = 1.0;
    energyRatio = 1.0;
    if (oldLifeMax > 0.0) { lifeRatio = oldLife / oldLifeMax; }
    if (oldShieldMax > 0.0) { shieldRatio = oldShields / oldShieldMax; }
    if (oldEnergyMax > 0.0) { energyRatio = oldEnergy / oldEnergyMax; }

    sourceWeapon = "";
    weaponCount = UnitWeaponCount(source);
    for (wi = 1; wi <= weaponCount; wi += 1) {
        if (sourceWeapon == "" && UnitWeaponIsEnabled(source, wi)) { sourceWeapon = UnitWeaponGet(source, wi); }
    }
    if (sourceWeapon == "" && weaponCount > 0) { sourceWeapon = UnitWeaponGet(source, 1); }

    libNtve_gf_ReplaceUnit(source, shellType, libNtve_ge_ReplaceUnitOptions_OldUnitsRelative);
    replacement = libNtve_gf_LastReplacedUnit();
    if (replacement == null) { return; }

    fallbackWeapon = "";
    if (sourceWeapon != "" && CatalogEntryIsValid(c_gameCatalogWeapon, sourceWeapon)) {
        weaponCount = UnitWeaponCount(replacement);
        if (weaponCount > 0) { fallbackWeapon = UnitWeaponGet(replacement, 1); }
        for (wi = weaponCount; wi >= 1; wi -= 1) {
            removeWeapon = UnitWeaponGet(replacement, wi);
            if (removeWeapon != "") { UnitWeaponRemove(replacement, removeWeapon); }
        }
        UnitWeaponAdd(replacement, sourceWeapon, null);
        if (UnitWeaponCount(replacement) <= 0 && fallbackWeapon != ""
            && CatalogEntryIsValid(c_gameCatalogWeapon, fallbackWeapon)) {
            UnitWeaponAdd(replacement, fallbackWeapon, null);
        }
    }

    if (oldLifeMax > 0.0) {
        UnitSetPropertyFixed(replacement, c_unitPropLifeMax, oldLifeMax);
        UnitSetPropertyFixed(replacement, c_unitPropLife, MaxF(1.0, oldLifeMax * lifeRatio));
    }
    if (oldShieldMax > 0.0) {
        UnitSetPropertyFixed(replacement, c_unitPropShieldsMax, oldShieldMax);
        UnitSetPropertyFixed(replacement, c_unitPropShields, oldShieldMax * shieldRatio);
    }
    if (oldEnergyMax > 0.0) {
        UnitSetPropertyFixed(replacement, c_unitPropEnergyMax, oldEnergyMax);
        UnitSetPropertyFixed(replacement, c_unitPropEnergy, oldEnergyMax * energyRatio);
    }
    if (oldSpeed > 0.0) { UnitSetPropertyFixed(replacement, c_unitPropMovementSpeed, oldSpeed); }

    modelType = APRG_JetpacksModelForType(sourceType);
    if (modelType != "" && CatalogEntryIsValid(c_gameCatalogModel, modelType)) {
        libNtve_gf_SendActorMessageToUnit(replacement, libNtve_gf_ModelSwap(modelType, 0));
    }
    UnitSetInfoText2(replacement, UnitTypeGetName(sourceType));
    DataTableSetString(true, "APRG_JetpacksSourceType_" + IntToString(UnitGetTag(replacement)), sourceType);
    UnitGroupAdd(g_aprgJetpacksProcessed, replacement);

    AISetUnitScriptControlled(replacement, false);
    if (hadIssuedOrder && UnitOrderIsValid(replacement, priorOrder)) {
        UnitIssueOrder(replacement, priorOrder, c_orderQueueReplace);
    }
}

fixed APRG_JetpackMineralValue(unit u) {
    string sourceType;
    string key;
    fixed value;
    int owner;
    if (u == null || !UnitIsAlive(u)) { return 0.0; }
    key = "APRG_JetpacksSourceType_" + IntToString(UnitGetTag(u));
    sourceType = DataTableGetString(true, key);
    if (sourceType == "") { return 0.0; }
    owner = UnitGetOwner(u);
    value = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, sourceType, "CostResource[0]", owner));
    if (value <= 0.0) {
        if (StringContains(sourceType, "Marine", c_stringAnywhere, c_stringNoCase)) { return 50.0; }
        if (StringContains(sourceType, "Zealot", c_stringAnywhere, c_stringNoCase)) { return 100.0; }
        if (StringContains(sourceType, "Zergling", c_stringAnywhere, c_stringNoCase)) { return 25.0; }
    }
    return value;
}

void APRG_TickJetpackAttackWaves(int player, fixed now) {
    unitgroup candidates;
    unitgroup attackers;
    unit target;
    unit u;
    fixed targetValue;
    fixed selectedValue;
    fixed cost;
    point destination;
    int cap;

    if (now < g_aprgNextJetpackWaveTime) { return; }
    cap = 50 * (g_aprgJetpackWaveIndex + 1);
    if (cap > 1000) { cap = 1000; }
    targetValue = IntToFixed(cap);
    selectedValue = 0.0;
    candidates = UnitGroupEmpty();
    UnitGroupAddUnitGroup(candidates, g_aprgJetpacksProcessed);
    attackers = UnitGroupEmpty();

    while (selectedValue < targetValue && UnitGroupCount(candidates, c_unitCountAlive) > 0) {
        u = UnitGroupRandomUnit(candidates, c_unitCountAlive);
        if (u == null) { break; }
        UnitGroupRemove(candidates, u);
        if (!UnitIsAlive(u)) { continue; }
        cost = APRG_JetpackMineralValue(u);
        if (cost <= 0.0) { continue; }
        UnitGroupAdd(attackers, u);
        selectedValue += cost;
    }

    target = APRG_FindPlayerHomeStructure(player);
    if (target != null && UnitGroupCount(attackers, c_unitCountAlive) > 0) {
        destination = UnitGetPosition(target);
        UnitGroupIssueOrder(attackers, OrderTargetingPoint(AbilityCommand("attack", 0), destination), c_orderQueueReplace);
    }
    g_aprgJetpackWaveIndex += 1;
    if (g_aprgJetpackWaveIndex == 1) { g_aprgNextJetpackWaveTime = 240.0; }
    else { g_aprgNextJetpackWaveTime += 60.0; }
}

void APRG_ApplyJetpacks(int player) {
    unitgroup enemies;
    int i;
    unit u;
    string unitType;
    enemies = APRG_EnemyAllUnits(player);
    i = UnitGroupCount(enemies, c_unitCountAlive);
    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(enemies, i);
        if (u == null) { break; }
        unitType = UnitGetType(u);
        if (APRG_JetpacksShellForType(unitType) == "") { continue; }
        APRG_ConvertJetpacksUnit(u);
    }
    APRG_TickJetpackAttackWaves(player, GameGetMissionTime());
}

void APRG_EnableStealthTunnelType(int player, string unitType) {
    string key;
    string mover;
    fixed fallbackSpeed;
    if (!CatalogEntryIsValid(c_gameCatalogUnit, unitType) || !CatalogEntryIsValid(c_gameCatalogUnit, "InfestorBurrowed")) { return; }
    key = "APRG_StealthTunnelType_" + IntToString(player) + "_" + unitType;
    if (DataTableGetBool(true, key)) { return; }
    mover = CatalogFieldValueGet(c_gameCatalogUnit, "InfestorBurrowed", "Mover", player);
    fallbackSpeed = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, "InfestorBurrowed", "Speed", player));
    if (mover != "") { CatalogFieldValueSet(c_gameCatalogUnit, unitType, "Mover", player, mover); }
    if (fallbackSpeed > 0.0) { CatalogFieldValueSet(c_gameCatalogUnit, unitType, "Speed", player, FixedToString(fallbackSpeed, c_fixedPrecisionAny)); }
    CatalogFieldValueSet(c_gameCatalogUnit, unitType, "Collide[Burrow]", player, "0");
    CatalogFieldValueSet(c_gameCatalogUnit, unitType, "Collide[RoachBurrow]", player, "1");
    APRG_AddCommandCardButton(player, unitType, "Move", "move,Move", 0, 0);
    APRG_AddCommandCardButton(player, unitType, "Stop", "stop,Stop", 0, 1);
    DataTableSetBool(true, key, true);
}

void APRG_ApplyStealthTunnels(int player) {
    unitgroup units;
    int i;
    unit u;
    string unitType;
    string speedKey;
    fixed speed;
    fixed cachedSpeed;
    bool buried;
    units = APRG_PlayerAllUnits(player);
    i = UnitGroupCount(units, c_unitCountAlive);
    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null) { break; }
        unitType = UnitGetType(u);
        speedKey = "APRG_StealthTunnelSpeed_" + IntToString(UnitGetTag(u));
        buried = CatalogFieldValueGet(c_gameCatalogUnit, unitType, "FlagArray[Buried]", player) == "1";
        if (!buried) {
            speed = UnitGetPropertyFixed(u, c_unitPropMovementSpeed, c_unitPropCurrent);
            if (speed > 0.0) { DataTableSetFixed(true, speedKey, speed); }
            continue;
        }
        APRG_EnableStealthTunnelType(player, unitType);
        UnitAbilityAdd(u, "move");
        UnitAbilityAdd(u, "stop");
        cachedSpeed = DataTableGetFixed(true, speedKey);
        if (cachedSpeed > 0.0) { UnitSetPropertyFixed(u, c_unitPropMovementSpeed, cachedSpeed); }
    }
}

void APRG_EnsureBlinkOnUnit(int player, unit u) {
    string unitType;
    if (u == null || !UnitIsAlive(u) || !CatalogEntryIsValid(c_gameCatalogAbil, "APRogueBlink")) { return; }
    unitType = UnitGetType(u);
    if (APRG_IsSpearCasterType(unitType)) {
        if (UnitAbilityExists(u, "APRogueBlink")) {
            UnitAbilityShow(u, "APRogueBlink", false);
            UnitAbilityEnable(u, "APRogueBlink", false);
            UnitAbilityRemove(u, "APRogueBlink");
        }
        return;
    }
    if (UnitTypeTestAttribute(unitType, c_unitAttributeStructure)) {
        if (UnitAbilityExists(u, "APRogueBlink")) {
            UnitAbilityShow(u, "APRogueBlink", false);
            UnitAbilityEnable(u, "APRogueBlink", false);
        }
        return;
    }

    if (UnitAbilityExists(u, "Blink")) { UnitAbilityRemove(u, "Blink"); }
    if (UnitAbilityExists(u, "AP_Blink")) { UnitAbilityRemove(u, "AP_Blink"); }
    if (UnitAbilityExists(u, "AP_BlinkMultiple")) { UnitAbilityRemove(u, "AP_BlinkMultiple"); }
    if (!UnitAbilityExists(u, "APRogueBlink")) { UnitAbilityAdd(u, "APRogueBlink"); }
    UnitAbilityShow(u, "APRogueBlink", true);
    UnitAbilityEnable(u, "APRogueBlink", true);
}

void APRG_PrepareBlinkCatalog(int player) {
    g_aprgBlinkCatalogPrepared = true;
}

void APRG_ApplyBlinkBlessing(int player) {
    unitgroup units;
    int i;
    unit u;
    if (!CatalogEntryIsValid(c_gameCatalogAbil, "APRogueBlink")) { return; }
    APRG_PrepareBlinkCatalog(player);
    if (CatalogEntryIsValid(c_gameCatalogUpgrade, "APRogueBlinkUnlocked")
        && TechTreeUpgradeCount(player, "APRogueBlinkUnlocked", c_techCountCompleteOnly) <= 0) {
        TechTreeUpgradeAddLevel(player, "APRogueBlinkUnlocked", 1);
    }
    TechTreeAbilityAllow(player, AbilityCommand("APRogueBlink", 0), true);

    units = UnitGroup(
        null, player, RegionPlayableMap(),
        UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0
    );
    for (i = UnitGroupCount(units, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null) { break; }
        APRG_EnsureBlinkOnUnit(player, u);
    }
}

string APRG_ZagaraBanelingSoundId(string suffix) {
    string cacheKey;
    string cached;
    string token;
    string entry;
    string assetFile;
    int count;
    int i;
    cacheKey = "APRG_ZagaraBanelingSound_" + suffix;
    cached = DataTableGetString(true, cacheKey);
    if (cached != "" && CatalogEntryIsValid(c_gameCatalogSound, cached)) { return cached; }
    token = "_roguequeen_" + suffix + ".ogg";
    count = CatalogEntryCount(c_gameCatalogSound);
    for (i = 1; i <= count; i += 1) {
        entry = CatalogEntryGet(c_gameCatalogSound, i);
        if (entry == "" || !CatalogEntryIsValid(c_gameCatalogSound, entry)) { continue; }
        assetFile = CatalogFieldValueGet(c_gameCatalogSound, entry, "AssetArray[0].File", c_playerAny);
        if (StringContains(assetFile, token, c_stringEnd, c_stringNoCase)) {
            DataTableSetString(true, cacheKey, entry);
            return entry;
        }
    }
    return "";
}

void APRG_PlayZagaraBanelingVO(int player, int waveIndex) {
    string suffix = "";
    string soundId;
    if (waveIndex == 1) { suffix = "091"; }
    else if (waveIndex == 2) { suffix = "056"; }
    else if (waveIndex == 3) { suffix = "057"; }
    if (suffix == "") { return; }
    soundId = APRG_ZagaraBanelingSoundId(suffix);
    if (soundId != "") {
        SoundPlay(SoundLink(soundId, c_soundIndexAny), PlayerGroupSingle(player), 100.0, 0.0);
    }
}

void APRG_RetargetZagaraBanelings(int player) {
    int i;
    unit baneling;
    unit target;
    for (i = UnitGroupCount(g_aprgZagaraBanelingUnits, c_unitCountAlive); i > 0; i -= 1) {
        baneling = UnitGroupUnitFromEnd(g_aprgZagaraBanelingUnits, i);
        if (baneling == null || !UnitIsAlive(baneling)) { continue; }
        target = APRG_NearestPathablePlayerStructure(baneling, player);
        if (target != null) { APRG_OrderAttackMove(baneling, UnitGetPosition(target)); }
    }
}

void APRG_TickZagarasBanelings(int player, fixed now) {
    unit enemyBase;
    unit home;
    unitgroup created;
    int enemyOwner;
    point spawnPoint;
    if (!APRG_PlayerMacroBaseReady(player)) { return; }
    if (now >= g_aprgNextZagaraBanelingRetargetTime) {
        APRG_RetargetZagaraBanelings(player);
        g_aprgNextZagaraBanelingRetargetTime = now + 4.0;
    }
    if (now < g_aprgNextZagaraBanelingTime) { return; }
    if (!CatalogEntryIsValid(c_gameCatalogUnit, "Baneling")) { g_aprgNextZagaraBanelingTime = now + 1.0; return; }
    enemyBase = APRG_RandomPathableHostileBaseAnchor(player);
    home = APRG_FindPlayerHomeStructure(player);
    if (enemyBase == null || home == null) { g_aprgNextZagaraBanelingTime = now + 1.0; return; }
    enemyOwner = UnitGetOwner(enemyBase);
    if (enemyOwner < 0) { g_aprgNextZagaraBanelingTime = now + 1.0; return; }
    spawnPoint = UnitGetPosition(enemyBase);
    created = UnitCreate(100, "Baneling", c_unitCreateIgnorePlacement, enemyOwner, spawnPoint, libNtve_gf_RandomAngle());
    if (UnitGroupCount(created, c_unitCountAlive) <= 0) { g_aprgNextZagaraBanelingTime = now + 1.0; return; }
    g_aprgZagaraBanelingWaveIndex += 1;
    UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaChat, StringToText("BANELINGS INCOMING"));
    APRG_PlayZagaraBanelingVO(player, g_aprgZagaraBanelingWaveIndex);
    UnitGroupAddUnitGroup(g_aprgZagaraBanelingUnits, created);
    APRG_RetargetZagaraBanelings(player);
    g_aprgNextZagaraBanelingRetargetTime = now + 4.0;
    g_aprgNextZagaraBanelingTime += 600.0;
}


void APRG_GiveLurkerDefenseIfReady(int player) {
    unit home;
    unit u;
    unitgroup created;
    point p;
    string lurkerType;
    int i;
    fixed speed;

    if (g_aprgLurkerDefenseGiven || !APRG_PlayerMacroBaseReady(player)) { return; }
    home = APRG_FindPlayerHomeStructure(player);
    if (home == null) { return; }
    p = APRG_FindGroundPointNear(UnitGetPosition(home), 4.0, 10.0);
    if (p == null) { return; }

    lurkerType = "";
    if (CatalogEntryIsValid(c_gameCatalogUnit, "Lurker")) { lurkerType = "Lurker"; }
    else if (CatalogEntryIsValid(c_gameCatalogUnit, "LurkerMP")) { lurkerType = "LurkerMP"; }
    if (lurkerType != "") {
        created = APRG_CreatePlayerUnitsSafe(4, lurkerType, player, p, libNtve_gf_RandomAngle());
        i = UnitGroupCount(created, c_unitCountAlive);
        for (; i > 0; i -= 1) {
            u = UnitGroupUnitFromEnd(created, i);
            if (u == null) { break; }
            speed = UnitGetPropertyFixed(u, c_unitPropMovementSpeed, c_unitPropCurrent);
            if (speed > 0.0) { UnitSetPropertyFixed(u, c_unitPropMovementSpeed, speed * 0.5); }
        }
    }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "Impaler")) {
        created = APRG_CreatePlayerUnitsSafe(4, "Impaler", player, p, libNtve_gf_RandomAngle());
        i = UnitGroupCount(created, c_unitCountAlive);
        for (; i > 0; i -= 1) {
            u = UnitGroupUnitFromEnd(created, i);
            if (u == null) { break; }
            speed = UnitGetPropertyFixed(u, c_unitPropMovementSpeed, c_unitPropCurrent);
            if (speed > 0.0) { UnitSetPropertyFixed(u, c_unitPropMovementSpeed, speed * 0.5); }
        }
    }
    g_aprgLurkerDefenseGiven = true;
}

void APRG_ApplyCombatWorkers(int player) {
    unitgroup workers;
    unit u;
    int i;
    int weaponIndex;
    int weaponCount;
    string unitType;
    string weaponType;
    string effectType;
    string key;
    fixed oldMax;
    fixed oldCurrent;
    fixed ratio;
    fixed speed;

    workers = APRG_PlayerWorkers(player);
    i = UnitGroupCount(workers, c_unitCountAlive);
    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(workers, i);
        if (u == null) { break; }
        if (UnitGroupHasUnit(g_aprgCombatWorkersProcessed, u)) { continue; }
        unitType = UnitGetType(u);

        oldMax = UnitGetPropertyFixed(u, c_unitPropLifeMax, c_unitPropCurrent);
        oldCurrent = UnitGetPropertyFixed(u, c_unitPropLife, c_unitPropCurrent);
        if (oldMax > 0.0) {
            ratio = oldCurrent / oldMax;
            UnitSetPropertyFixed(u, c_unitPropLifeMax, oldMax * 3.0);
            UnitSetPropertyFixed(u, c_unitPropLife, oldMax * 3.0 * ratio);
        }
        oldMax = UnitGetPropertyFixed(u, c_unitPropShieldsMax, c_unitPropCurrent);
        oldCurrent = UnitGetPropertyFixed(u, c_unitPropShields, c_unitPropCurrent);
        if (oldMax > 0.0) {
            ratio = oldCurrent / oldMax;
            UnitSetPropertyFixed(u, c_unitPropShieldsMax, oldMax * 3.0);
            UnitSetPropertyFixed(u, c_unitPropShields, oldMax * 3.0 * ratio);
        }
        key = "APRG_CombatWorkerSpeed_" + IntToString(player) + "_" + unitType;
        if (!DataTableGetBool(true, key)) {
            speed = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "Speed", player));
            if (speed > 0.0) { CatalogFieldValueSet(c_gameCatalogUnit, unitType, "Speed", player, FixedToString(speed * 3.0, c_fixedPrecisionAny)); }
            DataTableSetBool(true, key, true);
        }

        weaponCount = UnitWeaponCount(u);
        for (weaponIndex = 1; weaponIndex <= weaponCount; weaponIndex += 1) {
            weaponType = UnitWeaponGet(u, weaponIndex);
            if (weaponType == "") { continue; }
            key = "APRG_CombatWorkerWeapon_" + IntToString(player) + "_" + weaponType;
            if (!DataTableGetBool(true, key)) {
                CatalogFieldValueModify(c_gameCatalogWeapon, weaponType, "Period", player, FixedToString(1.0 / 3.0, c_fixedPrecisionAny), c_upgradeOperationMultiply);
                DataTableSetBool(true, key, true);
            }
            effectType = CatalogFieldValueGet(c_gameCatalogWeapon, weaponType, "DisplayEffect", player);
            if (effectType == "" || !CatalogEntryIsValid(c_gameCatalogEffect, effectType)) { continue; }
            key = "APRG_CombatWorkerDamage_" + IntToString(player) + "_" + effectType;
            if (!DataTableGetBool(true, key)) {
                CatalogFieldValueModify(c_gameCatalogEffect, effectType, "Amount", player, "3.0", c_upgradeOperationMultiply);
                DataTableSetBool(true, key, true);
            }
        }
        UnitGroupAdd(g_aprgCombatWorkersProcessed, u);
    }
}

void APRG_ApplyEnemyRapidEvolution(int player) {
    unitgroup units;
    unit u;
    int i;
    fixed hp;
    fixed shields;
    units = APRG_EnemyMobileUnits(player);
    i = UnitGroupCount(units, c_unitCountAlive);
    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null) { break; }
        hp = UnitGetPropertyFixed(u, c_unitPropLifeMax, c_unitPropCurrent);
        if (hp > 0.0) { UnitSetPropertyFixed(u, c_unitPropLifeMax, hp + 1.0); }
        shields = UnitGetPropertyFixed(u, c_unitPropShieldsMax, c_unitPropCurrent);
        if (shields > 0.0) { UnitSetPropertyFixed(u, c_unitPropShieldsMax, shields + 1.0); }
    }
}

void APRG_ScaleUnitShields(unit u, fixed factor) {
    fixed maximum;
    fixed current;
    fixed ratio;
    fixed newMaximum;
    if (u == null || factor <= 0.0) { return; }
    maximum = UnitGetPropertyFixed(u, c_unitPropShieldsMax, c_unitPropCurrent);
    if (maximum <= 0.0) { return; }
    current = UnitGetPropertyFixed(u, c_unitPropShields, c_unitPropCurrent);
    ratio = current / maximum;
    newMaximum = MaxF(1.0, maximum * factor);
    UnitSetPropertyFixed(u, c_unitPropShieldsMax, newMaximum);
    UnitSetPropertyFixed(u, c_unitPropShields, MaxF(0.0, newMaximum * ratio));
}

void APRG_ApplyGlassCannons(int player) {
    unitgroup units;
    unit u;
    int i;
    int weaponIndex;
    int weaponCount;
    string weaponType;
    string effectType;
    string key;
    fixed oldMax;
    fixed oldCurrent;
    fixed ratio;

    units = APRG_PlayerMobileUnits(player);
    i = UnitGroupCount(units, c_unitCountAlive);
    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null) { break; }
        if (UnitGroupHasUnit(g_aprgGlassCannonsProcessed, u)) { continue; }
        oldMax = UnitGetPropertyFixed(u, c_unitPropLifeMax, c_unitPropCurrent);
        oldCurrent = UnitGetPropertyFixed(u, c_unitPropLife, c_unitPropCurrent);
        if (oldMax > 0.0) {
            ratio = oldCurrent / oldMax;
            UnitSetPropertyFixed(u, c_unitPropLifeMax, MaxF(1.0, oldMax * 0.65));
            UnitSetPropertyFixed(u, c_unitPropLife, MaxF(1.0, oldMax * 0.65) * ratio);
        }
        APRG_ScaleUnitShields(u, 0.65);
        weaponCount = UnitWeaponCount(u);
        for (weaponIndex = 1; weaponIndex <= weaponCount; weaponIndex += 1) {
            weaponType = UnitWeaponGet(u, weaponIndex);
            if (weaponType == "") { continue; }
            effectType = CatalogFieldValueGet(c_gameCatalogWeapon, weaponType, "DisplayEffect", player);
            if (effectType == "" || !CatalogEntryIsValid(c_gameCatalogEffect, effectType)) { continue; }
            key = "APRG_GlassDamage_" + IntToString(player) + "_" + effectType;
            if (!DataTableGetBool(true, key)) {
                CatalogFieldValueModify(c_gameCatalogEffect, effectType, "Amount", player, "2.0", c_upgradeOperationMultiply);
                DataTableSetBool(true, key, true);
            }
        }
        UnitGroupAdd(g_aprgGlassCannonsProcessed, u);
    }
}

void APRG_EnsureProtossResearchStructures(int player) {
    if (CatalogEntryIsValid(c_gameCatalogUnit, "Forge")) {
        TechTreeUnitAllow(player, "Forge", true);
    }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "CyberneticsCore")) {
        TechTreeUnitAllow(player, "CyberneticsCore", true);
    }
}

void APRG_GiveOdinIfReady(int player) {
    unit home;
    point p;
    unitgroup created;
    if (g_aprgOdinGiven || !APRG_PlayerMacroBaseReady(player)) { return; }
    if (!CatalogEntryIsValid(c_gameCatalogUnit, "Odin")) { return; }
    home = APRG_FindPlayerHomeStructure(player);
    if (home == null) { return; }
    p = APRG_PlayerBuildingSpawnPoint(player, UnitGetPosition(home), 5.0, 12.0);
    if (p == null) { return; }
    created = APRG_CreatePlayerUnitsSafe(1, "Odin", player, p, libNtve_gf_RandomAngle());
    APRG_RegisterGeneratedHeroGroup(created);
