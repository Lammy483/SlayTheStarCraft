        else if (i==86) { nativeType="WarpPrism"; }
        else if (i==87) { nativeType="Colossus"; }
        else if (i==88) { nativeType="VoidRay"; }
        else if (i==89) { nativeType="Carrier"; }
        else if (i==90) { nativeType="Predator"; }
        else if (i==91) { nativeType="Hercules"; }
        else if (i==92) { nativeType="Bullfrog"; }
        else if (i==93) { nativeType="TaurenMarine"; }
        else if (i==94) { nativeType="Lurker"; }
        else if (i==95) { nativeType="Impaler"; }
        else if (i==96) { nativeType="Viper"; }
        else if (i==97) { nativeType="SwarmHost"; }
        else if (i==98) { nativeType="Infestor"; }
        else if (i==99) { nativeType="Overseer"; }
        else if (i==100) { nativeType="BroodLord"; }
        else if (i==101) { nativeType="Guardian"; }
        else if (i==102) { nativeType="Devourer"; }
        else if (i==103) { nativeType="Scourge"; }
        else if (i==104) { nativeType="Ravager"; }
        else if (i==105) { nativeType="Defiler"; }
        else if (i==106) { nativeType="Aberration"; }
        else if (i==107) { nativeType="Dragoon"; }
        else if (i==108) { nativeType="HighTemplar"; }
        else if (i==109) { nativeType="DarkTemplar"; }
        else if (i==110) { nativeType="Archon"; }
        else if (i==111) { nativeType="DarkArchon"; }
        else if (i==112) { nativeType="Phoenix"; }
        else if (i==113) { nativeType="Scout"; }
        else if (i==114) { nativeType="Oracle"; }
        else if (i==115) { nativeType="Disruptor"; }
        else if (i==116) { nativeType="Reaver"; }
        else if (i==117) { nativeType="Arbiter"; }
        else if (i==118) { nativeType="Corsair"; }
        else if (i==119) { nativeType="Tempest"; }
        else if (i==120) { nativeType="Mothership"; }
        else if (i==121) { nativeType="Mirage"; }
        else if (i==122) { nativeType="Centurion"; }
        else if (i==123) { nativeType="Instigator"; }
        else if (i==124) { nativeType="Avenger"; }
        else if (i==125) { nativeType="Slicer"; }
        else if (i==126) { nativeType="Vanguard"; }
        else if (i==127) { nativeType="Wrathwalker"; }
        else if (i==128) { nativeType="Ascendant"; }
        else if (i==129) { nativeType="Slayer"; }
        else if (i==130) { nativeType="Annihilator"; }
        else if (i==131) { nativeType="Energizer"; }

        else if (i==132) { nativeType="AegisGuard"; }
        else if (i==133) { nativeType="EmperorsShadow"; }
        else if (i==134) { nativeType="FieldResponseTheta"; }
        else if (i==135) { nativeType="SonOfKorhal"; }
        else if (i==136) { nativeType="Blackhammer"; }
        else if (i==137) { nativeType="BulwarkCompany"; }
        else if (i==138) { nativeType="ShockDivision"; }
        else if (i==139) { nativeType="BloodHunter"; }
        else if (i==140) { nativeType="Havoc"; }
        else if (i==141) { nativeType="Sentinel"; }
        else if (i==142) { nativeType="Signifier"; }
        else if (i==143) { nativeType="Supplicant"; }
        else if (i==144) { nativeType="Caladrius"; }
        else if (i==145) { nativeType="Dawnbringer"; }
        else if (i==146) { nativeType="Destroyer"; }
        else if (i==147) { nativeType="MistWing"; }
        else if (i==148) { nativeType="Oppressor"; }
        else if (i==149) { nativeType="Pulsar"; }
        else if (i==150) { nativeType="Skirmisher"; }
        else if (i==151) { nativeType="Skylord"; }
        else if (i==152) { nativeType="Trireme"; }
        APRG_CrewProdZeroOne(player,nativeType);
        APRG_CrewProdZeroOne(player,"AP_"+nativeType);
    }
    APRG_CrewProdZeroOne(player,"BarracksTechLab");
    APRG_CrewProdZeroOne(player,"FactoryTechLab");
    APRG_CrewProdZeroOne(player,"StarportTechLab");
    APRG_CrewProdZeroOne(player,"AP_BarracksTechLab");
    APRG_CrewProdZeroOne(player,"AP_FactoryTechLab");
    APRG_CrewProdZeroOne(player,"AP_StarportTechLab");
    // Command Center Lift Off / Land target flying/grounded CUnits. Some
    // campaign catalogs inherit the target unit's 400-mineral CUnit price
    // instead of the Morph ability's own Resource field.
    APRG_CrewProdZeroOne(player,"CommandCenterFlying");
    APRG_CrewProdZeroOne(player,"AP_CommandCenterFlying");
    APRG_CrewProdZeroOne(player,"OrbitalCommandFlying");
    APRG_CrewProdZeroOne(player,"AP_OrbitalCommandFlying");
    // Liftoff/landing in all Terran production buildings uses native target
    // CUnit costs just as Command Centers do. Cover each AP variant too.
    APRG_CrewProdZeroOne(player,"BarracksFlying");
    APRG_CrewProdZeroOne(player,"AP_BarracksFlying");
    APRG_CrewProdZeroOne(player,"FactoryFlying");
    APRG_CrewProdZeroOne(player,"AP_FactoryFlying");
    APRG_CrewProdZeroOne(player,"StarportFlying");
    APRG_CrewProdZeroOne(player,"AP_StarportFlying");
    DataTableSetBool(true,"APRG_CrewZeroPrices_"+IntToString(player),true);
}

// Crew repair economy: original CUnit prices are cached before the native
// production-price overlay. Vanilla SCV repairs use that CUnit price, so once
// construction/training is free the native engine no longer charges repairs.
// Restore the standard 25% of full unit cost, prorated by actual life restored.
// Only player-owned targets with an observed SCV/MULE Repair order are billed;
// an ordinary heal, regenerative blessing, or free production isn't billed.
// Fractional mineral/gas charges accumulate independently per unit-tag.
void APRG_CrewTickRepairCharges(int player) {
    unitgroup all;
    unit u;
    unit target;
    order ord;
    int i;
    int tag;
    int tick;
    int chargeM;
    int chargeG;
    fixed hp;
    fixed oldHP;
    fixed lifeMax;
    fixed delta;
    fixed fullM;
    fixed fullG;
    fixed dueM;
    fixed dueG;
    string ability;
    string key;
    string priceKey;
    string nativeType;
    if ((g_aprgMissionFlags & APRG_MISSION_FLAG_CREW_CHALLENGE)==0 || player<=0) { return; }
    if (!g_aprgCrewProdReady) { return; }
    all=APRG_PlayerAllUnits(player);
    tick=FixedToInt(GameGetMissionTime())+1;
    // Mark the unit currently targeted by a real Repair order. No blanket
    // health regeneration charge, and never bill non-owned allied units.
    for (i=UnitGroupCount(all,c_unitCountAlive);i>0;i-=1) {
        u=UnitGroupUnitFromEnd(all,i);
        if (u==null || !UnitIsAlive(u) || UnitGetOwner(u)!=player || UnitOrderCount(u)<1) { continue; }
        nativeType=APRG_CrewProdCanonical(UnitGetType(u));
        if (nativeType!="SCV" && nativeType!="MULE") { continue; }
        ord=UnitOrder(u,0);
        if (ord==null) { continue; }
        ability=AbilityCommandGetAbility(OrderGetAbilityCommand(ord));
        if (!StringContains(ability,"Repair",c_stringAnywhere,c_stringNoCase)) { continue; }
        target=OrderGetTargetUnit(ord);
        if (target==null || !UnitIsAlive(target) || UnitGetOwner(target)!=player) { continue; }
        DataTableSetInt(true,"APRG_CrewRepairTick_"+IntToString(UnitGetTag(target)),tick);
    }
    // Snapshot ALL owned actors on each 1-second tick. This prevents charging
    // a later healing event merely because an SCV once repaired that unit.
    for (i=UnitGroupCount(all,c_unitCountAlive);i>0;i-=1) {
        u=UnitGroupUnitFromEnd(all,i);
        if (u==null || !UnitIsAlive(u) || UnitGetOwner(u)!=player) { continue; }
        tag=UnitGetTag(u);
        if (tag<=0) { continue; }
        key="APRG_CrewRepair_"+IntToString(tag);
        hp=UnitGetPropertyFixed(u,c_unitPropLife,c_unitPropCurrent);
        oldHP=DataTableGetFixed(true,key+"_HP");
        if (!DataTableGetBool(true,key+"_Seen")) {
            DataTableSetBool(true,key+"_Seen",true);
            DataTableSetFixed(true,key+"_HP",hp);
            continue;
        }
        DataTableSetFixed(true,key+"_HP",hp);
        delta=hp-oldHP;
        if (delta<=0.0 || DataTableGetInt(true,"APRG_CrewRepairTick_"+IntToString(tag))!=tick) { continue; }
        nativeType=UnitGetType(u);
        priceKey="APRG_CrewRepairPrice_"+IntToString(player)+"_"+nativeType;
        if (!DataTableGetBool(true,priceKey+"_Saved")) {
            // A few AP morph variants have no individually costed CUnit.
            // Resolve their canonical base type before giving up.
            nativeType=APRG_CrewProdCanonical(nativeType);
            priceKey="APRG_CrewRepairPrice_"+IntToString(player)+"_"+nativeType;
        }
        if (!DataTableGetBool(true,priceKey+"_Saved")) { continue; }
        fullM=DataTableGetFixed(true,priceKey+"_M");
        fullG=DataTableGetFixed(true,priceKey+"_G");
        if (fullM<=0.0 && fullG<=0.0) { continue; }
        lifeMax=UnitGetPropertyFixed(u,c_unitPropLifeMax,c_unitPropCurrent);
        if (lifeMax<=0.0) { continue; }
        dueM=DataTableGetFixed(true,key+"_M")+fullM*delta*0.25/lifeMax;
        dueG=DataTableGetFixed(true,key+"_G")+fullG*delta*0.25/lifeMax;
        chargeM=FixedToInt(dueM);
        chargeG=FixedToInt(dueG);
        // Insufficient funds: reject this sample of free repair HP. This is
        // Crew-only and prevents infinite repairs when minerals or gas are 0.
        if ((fullM>0.0 && PlayerGetPropertyInt(player,c_playerPropMinerals)<=0) ||
            (fullG>0.0 && PlayerGetPropertyInt(player,c_playerPropVespene)<=0) ||
            chargeM>PlayerGetPropertyInt(player,c_playerPropMinerals) ||
            chargeG>PlayerGetPropertyInt(player,c_playerPropVespene)) {
            UnitSetPropertyFixed(u,c_unitPropLife,MaxF(1.0,hp-delta));
            DataTableSetFixed(true,key+"_HP",MaxF(1.0,hp-delta));
            continue;
        }
        if (chargeM>0) {
            PlayerModifyPropertyInt(player,c_playerPropMinerals,c_playerPropOperAdd,-chargeM);
        }
        if (chargeG>0) {
            PlayerModifyPropertyInt(player,c_playerPropVespene,c_playerPropOperAdd,-chargeG);
        }
        DataTableSetFixed(true,key+"_M",dueM-IntToFixed(chargeM));
        DataTableSetFixed(true,key+"_G",dueG-IntToFixed(chargeG));
    }
}

// Dev48c only re-enabled an ability when InfoArray.Unit could be resolved.
// A campaign-specific/AP recipe without that exact field shape therefore left
// an SCV's Build or a Barracks' Train ability disabled and its buttons absent.
// This affects Crew only and runs after the verified End handshake.
// Ensure addon costs and fallback times are always set for a Crew player,
// even when the addon uses a Morph rather than a Build recipe.
void APRG_CrewProdAddonFallback(int player) {
    int k;
    string addonType;
    for (k=0;k<6;k+=1) {
        if (k==0) { addonType="BarracksTechLab"; }
        else if (k==1) { addonType="FactoryTechLab"; }
        else if (k==2) { addonType="StarportTechLab"; }
        else if (k==3) { addonType="AP_BarracksTechLab"; }
        else if (k==4) { addonType="AP_FactoryTechLab"; }
        else { addonType="AP_StarportTechLab"; }
        if (!CatalogEntryIsValid(c_gameCatalogUnit,addonType)) { continue; }
        // Specialized addon construction also requires CUnit free price.
        // Cache its original price for the Crew SCV-repair charge path.
        APRG_CrewProdZeroOne(player,addonType);
        TechTreeUnitAllow(player,addonType,true);
    }
    // Reactor addons are intentionally UNSUPPORTED in Crew. Leave the native
    // command card alone, but do not sell or authorize a Reactor copy. Every
    // normal/AP reactor variant has a 1000-second CUnit fallback build time.
    for (k=0;k<6;k+=1) {
        if (k==0) { addonType="BarracksReactor"; }
        else if (k==1) { addonType="FactoryReactor"; }
        else if (k==2) { addonType="StarportReactor"; }
        else if (k==3) { addonType="AP_BarracksReactor"; }
        else if (k==4) { addonType="AP_FactoryReactor"; }
        else { addonType="AP_StarportReactor"; }
        if (CatalogEntryIsValid(c_gameCatalogUnit,addonType)) {
            CatalogFieldValueSet(c_gameCatalogUnit,addonType,"BuildTime",player,"1000");
        }
    }
}

// Apply free, deliberately very slow NATIVE orders. Both CUnit and CAbil
// cost overlays are needed across vanilla and AP variants; native repair costs
// are recovered separately from the originals captured in ZeroOne.
void APRG_CrewProdConfigure(unit u,int player) {
    int i;
    int j;
    int count;
    int infoCount;
    int classId;
    int sectionCount;
    int sectionIndex;
    int durationCount;
    int durationIndex;
    int unitCount;
    int costCount;
    int costIndex;
    string unitPath;
    string costPath;
    string sectionPath;
    string durationPath;
    string ability;
    string info;
    string produces;
    string apUnit;
    bool allowed;
    bool planetaryOnly;
    bool planetaryEntry;
    bool hasPlanetaryEntry;
    if (u==null || !UnitIsAlive(u) || UnitGetOwner(u)!=player ||
        !APRG_CrewProductionHostType(UnitGetType(u))) { return; }
    // Commands are never disabled at startup. Preserve the original command cards.
    APRG_CrewProdZeroAllPrices(player);
    APRG_CrewProdAddonFallback(player);
    count=MinI(96,UnitAbilityCount(u));
    for (i=1;i<=count;i+=1) {
        ability=UnitAbilityGet(u,i);
        if (ability=="" || !CatalogEntryIsValid(c_gameCatalogAbil,ability)) { continue; }
        classId=AbilityClass(ability);
        // Crew Command Center takeoff/landing is a tactical move, not a
        // purchased new building. Its native Morph/Effect costs must be zero.
        if (APRG_CrewEconomyType(UnitGetType(u))=="CommandCenter" ||
            APRG_CrewEconomyType(UnitGetType(u))=="OrbitalCommand") {
            if (StringContains(ability,"Lift",c_stringAnywhere,c_stringNoCase) ||
                StringContains(ability,"Land",c_stringAnywhere,c_stringNoCase)) {
                CatalogFieldValueSet(c_gameCatalogAbil,ability,"Cost.Resource[0]",player,"0");
                CatalogFieldValueSet(c_gameCatalogAbil,ability,"Cost.Resource[1]",player,"0");
                CatalogFieldValueSet(c_gameCatalogAbil,ability,"Cost[0].Resource[0]",player,"0");
                CatalogFieldValueSet(c_gameCatalogAbil,ability,"Cost[0].Resource[1]",player,"0");
                CatalogFieldValueSet(c_gameCatalogAbil,ability,"Resource[0]",player,"0");
                CatalogFieldValueSet(c_gameCatalogAbil,ability,"Resource[1]",player,"0");
            }
        }
        // A purchased Planetary Fortress is a one-use specialization of a
        // Command Center, not a free SCV-placed building. Normal CAbilMorph
        // commands are excluded from the build/train overlay above. Configure
        // only its native Planetary command; never touch tactical morphs,
        // Orbital Command, or any other game mode.
        if (APRG_CrewEconomyType(UnitGetType(u))=="CommandCenter") {
            // Some campaign versions use a named Planetary ability; others
            // keep both Orbital and Planetary under one Specialize InfoArray.
            // Do not overwrite the Orbital command of a shared ability.
            planetaryOnly=StringContains(ability,"Planetary",c_stringAnywhere,c_stringNoCase);
            hasPlanetaryEntry=false;
            infoCount=MinI(96,CatalogFieldValueCount(c_gameCatalogAbil,ability,"InfoArray",player));
            for (j=0;j<infoCount;j+=1) {
                info="InfoArray["+IntToString(j)+"]";
                produces=CatalogFieldValueGet(c_gameCatalogAbil,ability,info+".Unit",player);
                if (produces=="") {
                    produces=CatalogFieldValueGet(c_gameCatalogAbil,ability,info+".Unit[0]",player);
                }
                planetaryEntry=APRG_CrewProdCanonical(produces)=="PlanetaryFortress";
                if (!planetaryEntry && !planetaryOnly) { continue; }
                hasPlanetaryEntry=true;
                CatalogFieldValueSet(c_gameCatalogAbil,ability,info+".Resource[0]",player,"0");
                CatalogFieldValueSet(c_gameCatalogAbil,ability,info+".Resource[1]",player,"0");
                CatalogFieldValueSet(c_gameCatalogAbil,ability,info+".Cost.Resource[0]",player,"0");
                CatalogFieldValueSet(c_gameCatalogAbil,ability,info+".Cost.Resource[1]",player,"0");
                CatalogFieldValueSet(c_gameCatalogAbil,ability,info+".Cost[0].Resource[0]",player,"0");
                CatalogFieldValueSet(c_gameCatalogAbil,ability,info+".Cost[0].Resource[1]",player,"0");
                CatalogFieldValueSet(c_gameCatalogAbil,ability,info+".Time",player,"1000");
            }
            if (planetaryOnly || hasPlanetaryEntry) {
                // Shared abilities can represent Orbital too: only rewrite
                // their top-level cost when this is specifically PF's ability.
                if (planetaryOnly) {
                    CatalogFieldValueSet(c_gameCatalogAbil,ability,"Resource[0]",player,"0");
                    CatalogFieldValueSet(c_gameCatalogAbil,ability,"Resource[1]",player,"0");
                    CatalogFieldValueSet(c_gameCatalogAbil,ability,"Cost.Resource[0]",player,"0");
                    CatalogFieldValueSet(c_gameCatalogAbil,ability,"Cost.Resource[1]",player,"0");
                    CatalogFieldValueSet(c_gameCatalogAbil,ability,"Time",player,"1000");
                    costCount=MinI(8,CatalogFieldValueCount(c_gameCatalogAbil,ability,"Cost",player));
                    for (costIndex=0;costIndex<costCount;costIndex+=1) {
                        costPath="Cost["+IntToString(costIndex)+"]";
                        CatalogFieldValueSet(c_gameCatalogAbil,ability,costPath+".Resource[0]",player,"0");
                        CatalogFieldValueSet(c_gameCatalogAbil,ability,costPath+".Resource[1]",player,"0");
                    }
                }
                UnitAbilityEnable(u,ability,true);
                UnitAbilityShow(u,ability,true);
                continue;
            }
        }
        if (classId!=c_classIdCAbilBuild && classId!=c_classIdCAbilTrain) { continue; }
        allowed=true;
        infoCount=MinI(96,CatalogFieldValueCount(c_gameCatalogAbil,ability,"InfoArray",player));
        for (j=0;j<infoCount;j+=1) {
            info="InfoArray["+IntToString(j)+"]";
            // Restrict ALL native build/train orders to long fallback time,
            // including unusual campaign variants without a resolvable
            // single-Unit field. Their buttons should still be visible.
            CatalogFieldValueSet(c_gameCatalogAbil,ability,info+".Time",player,"1000");
            CatalogFieldValueSet(c_gameCatalogAbil,ability,info+".Resource[0]",player,"0");
            CatalogFieldValueSet(c_gameCatalogAbil,ability,info+".Resource[1]",player,"0");
            CatalogFieldValueSet(c_gameCatalogAbil,ability,info+".Cost.Resource[0]",player,"0");
            CatalogFieldValueSet(c_gameCatalogAbil,ability,info+".Cost.Resource[1]",player,"0");
            unitPath=info+".Unit";
            produces=CatalogFieldValueGet(c_gameCatalogAbil,ability,unitPath,player);
            if (produces=="") {
                // Some AP recipes expose only an indexed Unit list. Handle
                // single-output recipes, not multi-output orders whose
                // individual actors require separate entitlement receipts.
                unitCount=CatalogFieldValueCount(c_gameCatalogAbil,ability,unitPath,player);
                if (unitCount!=1) { continue; }
                unitPath=info+".Unit[0]";
                produces=CatalogFieldValueGet(c_gameCatalogAbil,ability,unitPath,player);
            }
            // Always slow the native recipe, including Reactor and campaign
            // variants without a Crew type code. Only recognized purchases can
            // subsequently be completed via APRG_CrewProdClaim.
            sectionCount=MinI(16,CatalogFieldValueCount(c_gameCatalogAbil,ability,
                info+".SectionArray",player));
            for (sectionIndex=0;sectionIndex<sectionCount;sectionIndex+=1) {
                sectionPath=info+".SectionArray["+IntToString(sectionIndex)+"]";
                durationCount=MinI(16,CatalogFieldValueCount(c_gameCatalogAbil,ability,
                    sectionPath+".DurationArray",player));
                for (durationIndex=0;durationIndex<durationCount;durationIndex+=1) {
                    durationPath=sectionPath+".DurationArray["+
                        IntToString(durationIndex)+"]";
                    CatalogFieldValueSet(c_gameCatalogAbil,ability,durationPath,player,"1000");
                }
            }
            if (produces=="" || !APRG_CrewProdUnitType(APRG_CrewProdCanonical(produces))) { continue; }
            // Prefer the real installed Archipelago CUnit on native orders:
            // normal SC2 CUnits won't inherit AP campaign upgrade changes.
            // Never fabricate a missing AP type or alter Tech Lab addon IDs.
            if (StringFind(produces,"AP_",c_stringCase)!=1 &&
                APRG_CrewProdCanonical(produces)!="TechLab") {
                apUnit="AP_"+produces;
                if (CatalogEntryIsValid(c_gameCatalogUnit,apUnit)) {
                    CatalogFieldValueSet(c_gameCatalogAbil,ability,unitPath,player,apUnit);
                    produces=apUnit;
                }
            }
            CatalogFieldValueSet(c_gameCatalogAbil,ability,info+".Resource[0]",player,"0");
            CatalogFieldValueSet(c_gameCatalogAbil,ability,info+".Resource[1]",player,"0");
            CatalogFieldValueSet(c_gameCatalogAbil,ability,info+".Cost.Resource[0]",player,"0");
            CatalogFieldValueSet(c_gameCatalogAbil,ability,info+".Cost.Resource[1]",player,"0");
            // Addons often advertise the price in a per-command Cost node;
            // clear that ability-level node as well, not the CUnit cost used
            // for ordinary repairs. The selected command remains gated by
            // the purchased-copy receipt, never the mineral stockpile.
            CatalogFieldValueSet(c_gameCatalogAbil,ability,info+".Cost[0].Resource[0]",player,"0");
            CatalogFieldValueSet(c_gameCatalogAbil,ability,info+".Cost[0].Resource[1]",player,"0");
            CatalogFieldValueSet(c_gameCatalogAbil,ability,info+".Time",player,"1000");
            // Native SC2 recipes frequently use nested SectionArray durations.
            // Without these overrides, an unpurchased order can still finish
            // at its normal speed despite changing InfoArray.Time alone.
            // CUnit prices are ALSO zeroed (otherwise many native orders
            // still demand minerals/gas). Crew repair debits are independent.
            // Gate all paid training with native session receipts instead.
            APRG_CrewProdZeroOne(player,produces);
            // Respect Archipelago's native command-card unlock gating.
            // Catalog price/time edits must NEVER globally unlock all train
            // commands. Individual owned Crew types are authorized in the
            // purchased-stock handler; AP owns actual card prerequisites.
            allowed=true;
        }
        if (allowed) {
            // Native abilities also carry top-level/indexed Cost values;
            // zero those as well as the captured CUnit costs.
            CatalogFieldValueSet(c_gameCatalogAbil,ability,"Resource[0]",player,"0");
            CatalogFieldValueSet(c_gameCatalogAbil,ability,"Resource[1]",player,"0");
            CatalogFieldValueSet(c_gameCatalogAbil,ability,"Cost.Resource[0]",player,"0");
            CatalogFieldValueSet(c_gameCatalogAbil,ability,"Cost.Resource[1]",player,"0");
            costCount=MinI(8,CatalogFieldValueCount(c_gameCatalogAbil,ability,"Cost",player));
            for (costIndex=0;costIndex<costCount;costIndex+=1) {
                costPath="Cost["+IntToString(costIndex)+"]";
                CatalogFieldValueSet(c_gameCatalogAbil,ability,costPath+".Resource[0]",player,"0");
                CatalogFieldValueSet(c_gameCatalogAbil,ability,costPath+".Resource[1]",player,"0");
            }
            UnitAbilityEnable(u,ability,true);
            UnitAbilityShow(u,ability,true);
        }
    }
}


// Crew Dev67: native addons and Command Center conversions do not reliably
// generate ordinary ConstructProgress events. Observe the *SpecializeProgress*
// event on their original producer, without touching Marine TrainProgress.
// Only a bank-authorized purchased copy can be advanced.
// One purchased addon may NEVER accelerate an unrelated Marine queued on
// another progress slot. Prefer an exact queued CUnit. Fallback to an empty
// single active slot or to slot 1 only while the verified native order remains.
string APRG_CrewProdOrderedSpecialization(unit producer);
void APRG_CrewProdAdvanceSpecialization(unit producer,string expected) {
    int slot;
    int matchingSlot=0;
    int anonymousSlot=0;
    int anonymousCount=0;
    int competingCount=0;
    string queued;
    if (producer==null || !UnitIsValid(producer) || expected=="") { return; }
    for (slot=1;slot<=4;slot+=1) {
        if (!UnitCheckProgressState(producer,slot,c_unitProgressStateActive)) { continue; }
        queued="";
        if (UnitQueueItemCount(producer,slot)>0) {
            queued=UnitQueueItemGet(producer,1,slot);
        }
        if (queued!="") {
            if (APRG_CrewProdCanonical(queued)==expected) { matchingSlot=slot; break; }
            competingCount+=1;
        }
        else { anonymousSlot=slot; anonymousCount+=1; }
    }
    if (matchingSlot==0 && anonymousCount==1 && competingCount==0) {
        matchingSlot=anonymousSlot;
    }
    if (matchingSlot==0 && anonymousCount==0 && competingCount==0 &&
        APRG_CrewProdOrderedSpecialization(producer)==expected) {
        // Campaign addons can have an order but no visible active progress.
        matchingSlot=1;
    }
    if (matchingSlot==0) {
        APRG_CrewProdDiagnostic("SpecialSlotAmbiguous",APRG_CrewNativeTypeCode(expected));
        return;
    }
    UnitSetProgressComplete(producer,matchingSlot,100);
    if (UnitCheckProgressState(producer,matchingSlot,c_unitProgressStateActive)) {
        UnitSetProgressStage(producer,matchingSlot,c_unitProgressStageComplete);
    }
    APRG_CrewProdDiagnostic("SpecialAdvance",APRG_CrewNativeTypeCode(expected));
}

bool APRG_CrewAddonStillBuilding(unit addon) {
    int slot;
    if (addon==null || !UnitIsValid(addon)) { return false; }
    if (libNtve_gf_UnitIsUnderConstruction(addon)) { return true; }
    // Finished Barracks/Factories can simultaneously be training units.
    // Only addons can have progress-only construction with no build flag.
    if (APRG_CrewProdCanonical(UnitGetType(addon))!="TechLab") { return false; }
    for (slot=0;slot<4;slot+=1) {
        if (UnitCheckProgressState(addon,slot,c_unitProgressStateActive)) { return true; }
    }
    return false;
}

unit APRG_CrewProdCompletedAddonNear(unit producer) {
    unitgroup near;
    unit candidate;
    unit found=null;
    int j;
    if (producer==null || !UnitIsValid(producer)) { return null; }
    // AP addons can be hidden while attaching, including at the moment
    // construction completes. The normal player unit view omits those actors.
    near=UnitGroup(null,UnitGetOwner(producer),
        RegionCircle(UnitGetPosition(producer),5.0),UnitFilter(0,0,0,0),0);
    for (j=UnitGroupCount(near,c_unitCountAlive);j>0;j-=1) {
        candidate=UnitGroupUnitFromEnd(near,j);
        if (candidate!=null && candidate!=producer &&
            UnitGetOwner(candidate)==UnitGetOwner(producer) &&
            APRG_CrewProdCanonical(UnitGetType(candidate))=="TechLab" &&
            !DataTableGetBool(true,"APRG_CrewNativeStart_"+
                IntToString(g_aprgCrewDeathToken)+"_"+IntToString(UnitGetTag(candidate))) &&
            !DataTableGetBool(true,"APRG_CrewProdBuilt_"+IntToString(UnitGetTag(candidate))) &&
            !APRG_CrewAddonStillBuilding(candidate)) {
            if (found!=null && found!=candidate) { return null; }
            found=candidate;
        }
    }
    return found;
}

bool APRG_CrewProdSpecialStart_Func(bool testConds,bool runActions) {
    unit producer;
    string kind;
    string host;
    int tag;
    int number;
    if (!runActions || !g_aprgCrewProdReady ||
        (g_aprgMissionFlags & APRG_MISSION_FLAG_CREW_CHALLENGE)==0) { return true; }
    producer=EventUnit();
    if (producer==null || UnitGetOwner(producer)!=APRG_GetPrimaryPlayer()) { return true; }
    kind=APRG_CrewProdCanonical(EventUnitProgressObjectType());
    host=APRG_CrewProdCanonical(UnitGetType(producer));
    if (kind=="TechLab") {
        if (host!="Barracks" && host!="Factory" && host!="Starport") { return true; }
    }
    else if (kind=="PlanetaryFortress") {
        if (host!="CommandCenter" && host!="PlanetaryFortress") { return true; }
    }
    else { return true; }
    tag=UnitGetTag(producer);
    if (DataTableGetInt(true,"APRG_CrewSpecialClaim_"+IntToString(tag))>0) { return true; }
    APRG_CrewProdDiagnostic("SpecialStart",APRG_CrewNativeTypeCode(kind));
    number=APRG_CrewProdClaim(kind);
    if (number<=0) {
        // Unpaid specialization cannot complete. Reset progress in the fast tick.
        DataTableSetString(true,"APRG_CrewSpecialBlocked_"+IntToString(tag),kind);
        return true;
    }
    DataTableSetInt(true,"APRG_CrewSpecialClaim_"+IntToString(tag),number);
    DataTableSetString(true,"APRG_CrewSpecialKind_"+IntToString(tag),kind);
    DataTableSetString(true,"APRG_CrewSpecialBlocked_"+IntToString(tag),"");
    APRG_CrewProdDiagnostic("SpecialClaim",number);
    APRG_CrewProdAdvanceSpecialization(producer,kind);
    return true;
}

// Some campaign add-on recipes never fire SpecializeProgress. Their producer
// still exposes the Build Tech Lab ability in its real native order queue.
// Observe that order as a *separate* recovery source; this cannot match an
// ordinary Marine train order and never advances an unpurchased recipe.
string APRG_CrewProdOrderedSpecialization(unit producer) {
    int index;
    string source;
    string ability;
    string produced;
    int command;
    order ord;
    if (producer==null || !UnitIsValid(producer)) { return ""; }
    source=APRG_CrewProdCanonical(UnitGetType(producer));
    if (source!="Barracks" && source!="Factory" && source!="Starport" &&
        source!="CommandCenter") { return ""; }
    for (index=0;index<UnitOrderCount(producer) && index<4;index+=1) {
        ord=UnitOrder(producer,index);
        if (ord==null) { continue; }
        ability=AbilityCommandGetAbility(OrderGetAbilityCommand(ord));
        command=AbilityCommandGetCommand(OrderGetAbilityCommand(ord));
        if (source!="CommandCenter" &&
            StringContains(ability,"TechLab",c_stringAnywhere,c_stringNoCase)) { return "TechLab"; }
        if (source=="CommandCenter" &&
            StringContains(ability,"Planetary",c_stringAnywhere,c_stringNoCase)) { return "PlanetaryFortress"; }
        // Barracks/Factory/Starport may use one shared AddOns ability with
        // different command indexes for Reactor versus Tech Lab. Match the
        // selected CAbil InfoArray output, not the parent ability's name.
        if (CatalogEntryIsValid(c_gameCatalogAbil,ability) &&
            command>=0 && command<64) {
            produced=CatalogFieldValueGet(c_gameCatalogAbil,ability,
                "InfoArray["+IntToString(command)+"].Unit",UnitGetOwner(producer));
            if (produced=="") {
                produced=CatalogFieldValueGet(c_gameCatalogAbil,ability,
                    "InfoArray["+IntToString(command)+"].Unit[0]",UnitGetOwner(producer));
            }
            if (source!="CommandCenter" &&
                APRG_CrewProdCanonical(produced)=="TechLab") { return "TechLab"; }
            if (source=="CommandCenter" &&
                APRG_CrewProdCanonical(produced)=="PlanetaryFortress") {
                return "PlanetaryFortress";
            }
        }
    }
    return "";
}

void APRG_CrewProdRecoverSpecialOrder(unit producer) {
    int tag;
    int number;
    string kind;
    if (producer==null || !UnitIsValid(producer)) { return; }
    tag=UnitGetTag(producer);
    kind=APRG_CrewProdOrderedSpecialization(producer);
    if (kind=="") { return; }
    number=DataTableGetInt(true,"APRG_CrewSpecialClaim_"+IntToString(tag));
    if (number<=0) {
        number=APRG_CrewProdClaim(kind);
        if (number<=0) {
            DataTableSetString(true,"APRG_CrewSpecialBlocked_"+IntToString(tag),kind);
            UnitSetProgressComplete(producer,1,0);
            return;
        }
        DataTableSetInt(true,"APRG_CrewSpecialClaim_"+IntToString(tag),number);
        DataTableSetString(true,"APRG_CrewSpecialKind_"+IntToString(tag),kind);
        DataTableSetString(true,"APRG_CrewSpecialBlocked_"+IntToString(tag),"");
        APRG_CrewProdDiagnostic("SpecialOrderClaim",number);
    }
    // Progress Stage(Complete) is important for specialized recipes whose
    // addon uses no ordinary actor construction progress slot.
    APRG_CrewProdAdvanceSpecialization(producer,kind);
}

// The completion callback is not sufficient for every campaign addon;
// the fast tick independently recovers once the exact completed actor exists.
void APRG_CrewProdRecoverSpecialization(unit producer) {
    int tag;
    int number;
    string kind;
    unit addon;
    if (producer==null || !UnitIsValid(producer)) { return; }
    tag=UnitGetTag(producer);
    number=DataTableGetInt(true,"APRG_CrewSpecialClaim_"+IntToString(tag));
    if (number<=0) { return; }
    kind=DataTableGetString(true,"APRG_CrewSpecialKind_"+IntToString(tag));
    if (kind=="PlanetaryFortress" &&
        APRG_CrewProdCanonical(UnitGetType(producer))=="PlanetaryFortress" &&
        !libNtve_gf_UnitIsUnderConstruction(producer)) {
        APRG_CrewProdReceiptTag(producer,tag,number,false);
        DataTableSetInt(true,"APRG_CrewSpecialClaim_"+IntToString(tag),0);
        APRG_CrewProdDiagnostic("SpecialComplete",number);
    }
    else if (kind=="TechLab") {
        addon=APRG_CrewProdCompletedAddonNear(producer);
        if (addon!=null) {
            APRG_CrewProdReceiptTag(addon,tag,number,false);
            DataTableSetBool(true,"APRG_CrewProdBuilt_"+IntToString(UnitGetTag(addon)),true);
            DataTableSetInt(true,"APRG_CrewSpecialClaim_"+IntToString(tag),0);
            APRG_CrewProdDiagnostic("SpecialComplete",number);
        }
        else if (APRG_CrewProdOrderedSpecialization(producer)=="TechLab") {
            // Never accelerate a later Marine order using a stale paid
            // Tech Lab claim if its addon order has already disappeared.
            APRG_CrewProdAdvanceSpecialization(producer,kind);
        }
    }
}

bool APRG_CrewProdSpecialComplete_Func(bool testConds,bool runActions) {
    if (runActions && g_aprgCrewProdReady) {
        APRG_CrewProdRecoverSpecialization(EventUnit());
    }
    return true;
}

bool APRG_CrewProdSpecialCancel_Func(bool testConds,bool runActions) {
    unit producer;
    int tag;
    int number;
    if (!runActions || !g_aprgCrewProdReady) { return true; }
    producer=EventUnit();
    if (producer==null) { return true; }
    tag=UnitGetTag(producer);
    number=DataTableGetInt(true,"APRG_CrewSpecialClaim_"+IntToString(tag));
    if (number>0) {
        APRG_CrewProdReturn(number);
        DataTableSetInt(true,"APRG_CrewSpecialClaim_"+IntToString(tag),0);
    }
    DataTableSetString(true,"APRG_CrewSpecialBlocked_"+IntToString(tag),"");
    return true;
}

// A worker starts a native SC2 construction. The actor remains in place; its
// exact tag is later banked after completion. No copy => no fast completion.
bool APRG_CrewProdBuildStart_Func(bool testConds,bool runActions) {
    unit built;
    unit worker;
    int player;
    int number;
    int producerTag=0;
    string key;
    string nativeType;
    if (!runActions || (g_aprgMissionFlags & APRG_MISSION_FLAG_CREW_CHALLENGE)==0) { return true; }
    player=APRG_GetPrimaryPlayer();
    built=EventUnitProgressUnit();
    worker=EventUnit();
    if (built==null || !UnitIsValid(built) || UnitGetOwner(built)!=player) { return true; }
    // The creator can be unavailable at the first progress frame. Keep a
    // blocked foundation, then recover an exact builder through the order scan.
    if (worker!=null && UnitGetOwner(worker)!=player) { return true; }
    nativeType=APRG_CrewProdCanonical(UnitGetType(built));
    if (!APRG_CrewProdUnitType(nativeType)) { return true; }
    APRG_CrewProdDiagnostic("BuildStart",APRG_CrewNativeTypeCode(nativeType));
    key="APRG_CrewProdBuild_"+IntToString(UnitGetTag(built));
    if (DataTableGetInt(true,key)>0) { return true; }
    // Native map-provided workers can build purchased Crew structures even
    // before the worker has been independently bound to a Crew copy. Receipt
    // processing still verifies player, builder type and purchased actor.
    if (worker!=null && APRG_CrewProdCanonical(UnitGetType(worker))!="SCV" &&
        APRG_CrewProdCanonical(UnitGetType(worker))!="Drone" &&
        APRG_CrewProdCanonical(UnitGetType(worker))!="Probe" &&
        !(nativeType=="TechLab" &&
          (APRG_CrewProdCanonical(UnitGetType(worker))=="Barracks" ||
           APRG_CrewProdCanonical(UnitGetType(worker))=="Factory" ||
           APRG_CrewProdCanonical(UnitGetType(worker))=="Starport"))) { return true; }
    if (worker!=null) { producerTag=UnitGetTag(worker); }
    // Tech Labs can emit both Construct and Specialize events. One paid copy
    // must never be claimed twice for those two views of the same addon.
    if (nativeType=="TechLab" && worker!=null) {
        number=DataTableGetInt(true,"APRG_CrewSpecialClaim_"+IntToString(producerTag));
        if (number>0) {
            DataTableSetInt(true,"APRG_CrewProdBuild_"+IntToString(UnitGetTag(built)),number);
            DataTableSetInt(true,"APRG_CrewSpecialClaim_"+IntToString(producerTag),0);
            DataTableSetInt(true,"APRG_CrewProdBuilder_"+IntToString(UnitGetTag(built)),producerTag);
            DataTableSetUnit(true,"APRG_CrewProdBuilderUnit_"+IntToString(UnitGetTag(built)),worker);
            if (g_aprgCrewPendingConstructs==null) { g_aprgCrewPendingConstructs=UnitGroupEmpty(); }
            if (!UnitGroupHasUnit(g_aprgCrewPendingConstructs,built)) {
                UnitGroupAdd(g_aprgCrewPendingConstructs,built);
            }
            APRG_CrewProdAdvanceConstruction(built);
            return true;
        }
    }
    // Preserve the real producer even if the stock bank message arrives later.
    // A completed building without its producer tag cannot pass receipt checks.
    DataTableSetInt(true,"APRG_CrewProdBuilder_"+IntToString(UnitGetTag(built)),producerTag);
    // Needed only for an addon whose progress belongs to its Barracks/Factory.
    DataTableSetUnit(true,"APRG_CrewProdBuilderUnit_"+IntToString(UnitGetTag(built)),worker);
    if (g_aprgCrewPendingConstructs==null) { g_aprgCrewPendingConstructs=UnitGroupEmpty(); }
    if (!UnitGroupHasUnit(g_aprgCrewPendingConstructs,built)) {
        UnitGroupAdd(g_aprgCrewPendingConstructs,built);
    }
    number=0;
    if (worker!=null) { number=APRG_CrewProdClaim(nativeType); }
    if (number<=0) {
        DataTableSetBool(true,"APRG_CrewProdBlockedBuild_"+IntToString(UnitGetTag(built)),true);
        DataTableSetInt(true,"APRG_CrewProdBlockedBuilder_"+IntToString(UnitGetTag(built)),producerTag);
        return true;
    }
    APRG_CrewProdDiagnostic("BuildClaim",number);
    DataTableSetInt(true,key,number);
    DataTableSetInt(true,"APRG_CrewProdBuilder_"+IntToString(UnitGetTag(built)),producerTag);
    DataTableSetBool(true,"APRG_CrewProdBlockedBuild_"+IntToString(UnitGetTag(built)),false);
    Wait(0.25,c_timeGame);
    if (DataTableGetInt(true,key)==number && UnitIsValid(built) &&
        UnitGetOwner(built)==player) {
        APRG_CrewProdAdvanceConstruction(built);
        APRG_CrewProdDiagnostic("BuildAdvance",number);
        // BuildStart is the last point where the verified foundation is
        // guaranteed to be reachable from the event itself. Native SCV
        // construction has repeatedly ignored 100% progress writes, and
        // periodic actor scans do not always revisit the foundation. Try a
        // guarded exact-type completed replacement HERE, without waiting
        // for a later scan. It must pass owner/type/completed/tag checks
        // before the incomplete foundation can be removed.
        if (UnitIsValid(built) && libNtve_gf_UnitIsUnderConstruction(built) &&
            APRG_CrewProdCanReplaceConstruction(UnitGetType(built)) &&
            APRG_CrewProdReplaceStalledFoundation(built)) {
            APRG_CrewProdDiagnostic("BuildStartReplica",number);
        }
    }
    return true;
}

// A UnitCreated event can run before its native construction flags are set.
// It is only a fallback when the construction-start event was not seen, and
// requires the actual player-controlled builder or addon producer.
bool APRG_CrewProdBuildCreated_Func(bool testConds,bool runActions) {
    unit built;
    unit creator;
    int player;
    int tag;
    int specialNumber;
    string kind;
    string producerType;
    if (!runActions || !g_aprgCrewProdReady ||
        (g_aprgMissionFlags & APRG_MISSION_FLAG_CREW_CHALLENGE)==0) { return true; }
    built=EventUnitCreatedUnit();
    creator=EventUnit();
    player=APRG_GetPrimaryPlayer();
    if (built==null || creator==null || !UnitIsValid(built) ||
        UnitGetOwner(built)!=player || UnitGetOwner(creator)!=player) { return true; }
    kind=APRG_CrewProdCanonical(UnitGetType(built));
    producerType=APRG_CrewProdCanonical(UnitGetType(creator));
    if (!UnitTypeTestAttribute(UnitGetType(built),c_unitAttributeStructure) ||
        !APRG_CrewProdUnitType(kind) || kind=="Reactor" ||
        (producerType!="SCV" && producerType!="Drone" && producerType!="Probe" &&
        !(kind=="TechLab" && (producerType=="Barracks" ||
          producerType=="Factory" || producerType=="Starport")))) { return true; }
    tag=UnitGetTag(built);
    if (DataTableGetInt(true,"APRG_CrewProdBuild_"+IntToString(tag))>0 ||
        DataTableGetBool(true,"APRG_CrewProdBlockedBuild_"+IntToString(tag)) ||
        DataTableGetBool(true,"APRG_CrewProdBuilt_"+IntToString(tag))) { return true; }
    // The created event is not proof of a finished structure; the actual
    // ConstructProgress event or later clamp must still confirm completion.
    // A Tech Lab was previously claimed on its producer's Specialize event:
    // transfer the SAME claim to the resulting addon instead of spending a
    // second purchased copy through the normal construction hook.
    if (kind=="TechLab") {
        specialNumber=DataTableGetInt(true,
            "APRG_CrewSpecialClaim_"+IntToString(UnitGetTag(creator)));
        if (specialNumber>0 && DataTableGetString(true,
            "APRG_CrewSpecialKind_"+IntToString(UnitGetTag(creator)))=="TechLab") {
            DataTableSetInt(true,"APRG_CrewProdBuild_"+IntToString(tag),specialNumber);
            DataTableSetInt(true,"APRG_CrewSpecialClaim_"+IntToString(UnitGetTag(creator)),0);
            DataTableSetInt(true,"APRG_CrewProdBuilder_"+IntToString(tag),UnitGetTag(creator));
            DataTableSetUnit(true,"APRG_CrewProdBuilderUnit_"+IntToString(tag),creator);
            if (!libNtve_gf_UnitIsUnderConstruction(built)) {
                APRG_CrewProdReceiptTag(built,UnitGetTag(creator),specialNumber,false);
                DataTableSetInt(true,"APRG_CrewProdBuild_"+IntToString(tag),0);
                DataTableSetBool(true,"APRG_CrewProdBuilt_"+IntToString(tag),true);
            }
            return true;
        }
    }
    DataTableSetInt(true,"APRG_CrewProdBuilder_"+IntToString(tag),UnitGetTag(creator));
    DataTableSetUnit(true,"APRG_CrewProdBuilderUnit_"+IntToString(tag),creator);
    if (g_aprgCrewPendingConstructs==null) { g_aprgCrewPendingConstructs=UnitGroupEmpty(); }
    if (!UnitGroupHasUnit(g_aprgCrewPendingConstructs,built)) {
        UnitGroupAdd(g_aprgCrewPendingConstructs,built);
    }
    DataTableSetBool(true,"APRG_CrewProdBlockedBuild_"+IntToString(tag),true);
    DataTableSetInt(true,"APRG_CrewProdBlockedBuilder_"+IntToString(tag),UnitGetTag(creator));
    APRG_CrewProdDiagnostic("BuildStart",APRG_CrewNativeTypeCode(kind));
    return true;
}

bool APRG_CrewProdBuildComplete_Func(bool testConds,bool runActions) {
    unit built;
    unit worker;
    int number;
    if (!runActions || !g_aprgCrewProdReady) { return true; }
    built=EventUnitProgressUnit();
    worker=EventUnit();
    if (built==null) { return true; }
    if (g_aprgCrewPendingConstructs!=null) {
        UnitGroupRemove(g_aprgCrewPendingConstructs,built);
    }
    number=DataTableGetInt(true,"APRG_CrewProdBuild_"+IntToString(UnitGetTag(built)));
    if (number>0) {
        APRG_CrewProdReceiptTag(built,
            DataTableGetInt(true,"APRG_CrewProdBuilder_"+IntToString(UnitGetTag(built))),
            number,false);
        // The building has completed: cancellation cannot refund this copy.
        DataTableSetInt(true,"APRG_CrewProdBuild_"+IntToString(UnitGetTag(built)),0);
        DataTableSetBool(true,"APRG_CrewProdBuilt_"+IntToString(UnitGetTag(built)),true);
        APRG_CrewProdDiagnostic("BuildComplete",number);
    }
    return true;
}

bool APRG_CrewProdBuildCancel_Func(bool testConds,bool runActions) {
    unit built;
    int number;
    if (!runActions || (g_aprgMissionFlags & APRG_MISSION_FLAG_CREW_CHALLENGE)==0) { return true; }
    built=EventUnitProgressUnit();
    if (built==null) { return true; }
    if (g_aprgCrewPendingConstructs!=null) {
        UnitGroupRemove(g_aprgCrewPendingConstructs,built);
    }
    number=DataTableGetInt(true,"APRG_CrewProdBuild_"+IntToString(UnitGetTag(built)));
    if (number>0 && !DataTableGetBool(true,"APRG_CrewProdBuilt_"+IntToString(UnitGetTag(built)))) {
        APRG_CrewProdReturn(number);
        DataTableSetInt(true,"APRG_CrewProdBuild_"+IntToString(UnitGetTag(built)),0);
        DataTableSetInt(true,"APRG_CrewProdBuilder_"+IntToString(UnitGetTag(built)),0);
    }
    DataTableSetBool(true,"APRG_CrewProdBlockedBuild_"+IntToString(UnitGetTag(built)),false);
    return true;
}

bool APRG_CrewProdTrainStart_Func(bool testConds,bool runActions) {
    unit producer;
    int number;
    int player;
    string nativeType;
    string key;
    if (!runActions || (g_aprgMissionFlags & APRG_MISSION_FLAG_CREW_CHALLENGE)==0) { return true; }
    producer=EventUnit();
    player=APRG_GetPrimaryPlayer();
    if (producer==null || EventPlayer()!=player || UnitGetOwner(producer)!=player ||
        !UnitTypeTestAttribute(UnitGetType(producer),c_unitAttributeStructure)) { return true; }
    // Start orders can be queued while starting structures are being
    // reconciled. Until End, these simply remain blocked; bank receipts
    // later verify the purchased producer independently.
    nativeType=APRG_CrewProdCanonical(libNtve_gf_TriggeringProgressUnitType());
    if (!APRG_CrewProdUnitType(nativeType)) { return true; }
    DataTableSetString(true,"APRG_CrewProdTrainObserved_"+IntToString(UnitGetTag(producer)),nativeType);
    APRG_CrewProdDiagnostic("TrainStart",APRG_CrewNativeTypeCode(nativeType));
    key="APRG_CrewProdTrain_"+IntToString(UnitGetTag(producer));
    if (DataTableGetInt(true,key)>0) { return true; }
    number=APRG_CrewProdClaim(nativeType);
    if (number<=0) {
        DataTableSetBool(true,"APRG_CrewProdBlockedTrain_"+IntToString(UnitGetTag(producer)),true);
        DataTableSetString(true,"APRG_CrewProdBlockedTrainType_"+IntToString(UnitGetTag(producer)),nativeType);
        return true;
    }
    APRG_CrewProdDiagnostic("TrainClaim",number);
    DataTableSetInt(true,key,number);
    DataTableSetString(true,"APRG_CrewProdTrainType_"+IntToString(UnitGetTag(producer)),nativeType);
    DataTableSetBool(true,"APRG_CrewProdBlockedTrain_"+IntToString(UnitGetTag(producer)),false);
    Wait(0.25,c_timeGame);
    if (DataTableGetInt(true,key)==number && UnitIsAlive(producer) &&
        UnitGetOwner(producer)==player) {
        // One authoritative native advance: repeated progress writes could
        // complete a second queued Marine using a single paid copy.
        APRG_CrewProdAdvanceTraining(producer,nativeType);
        APRG_CrewProdDiagnostic("TrainAdvance",number);
    }
    return true;
}

bool APRG_CrewProdTrainComplete_Func(bool testConds,bool runActions) {
    unit producer;
    unit trained;
    int number;
    if (!runActions || !g_aprgCrewProdReady) { return true; }
    producer=EventUnit();
    trained=EventUnitProgressUnit();
    if (producer==null || trained==null) { return true; }
    number=DataTableGetInt(true,"APRG_CrewProdTrain_"+IntToString(UnitGetTag(producer)));
    if (number>0) {
        // Never bind the receipt of a different queued unit to this paid copy.
        if (APRG_CrewProdCanonical(UnitGetType(trained))==DataTableGetString(true,
                "APRG_CrewProdTrainType_"+IntToString(UnitGetTag(producer)))) {
            APRG_CrewProdReceiptTag(trained,UnitGetTag(producer),number,
                APRG_CrewProdCanonical(UnitGetType(trained))!="TechLab");
            DataTableSetInt(true,"APRG_CrewProdTrain_"+IntToString(UnitGetTag(producer)),0);
            APRG_CrewProdDiagnostic("TrainComplete",number);
        }
    }
    return true;
}

bool APRG_CrewProdTrainCancel_Func(bool testConds,bool runActions) {
    unit producer;
    int number;
    if (!runActions || (g_aprgMissionFlags & APRG_MISSION_FLAG_CREW_CHALLENGE)==0) { return true; }
    producer=EventUnit();
    if (producer==null) { return true; }
    number=DataTableGetInt(true,"APRG_CrewProdTrain_"+IntToString(UnitGetTag(producer)));
    if (number>0 && APRG_CrewProdCanonical(libNtve_gf_TriggeringProgressUnitType())==
            DataTableGetString(true,"APRG_CrewProdTrainType_"+IntToString(UnitGetTag(producer)))) {
        APRG_CrewProdReturn(number);
        DataTableSetInt(true,"APRG_CrewProdTrain_"+IntToString(UnitGetTag(producer)),0);
    }
    if (DataTableGetString(true,"APRG_CrewProdBlockedTrainType_"+IntToString(UnitGetTag(producer)))==
            APRG_CrewProdCanonical(libNtve_gf_TriggeringProgressUnitType())) {
        DataTableSetBool(true,"APRG_CrewProdBlockedTrain_"+IntToString(UnitGetTag(producer)),false);
    }
    return true;
}

// SC2's active progress bar and training queue are independent.  Several AP
// producers show an active training progress bar while QueueItemCount(slot)=0.
// Never require a populated queue to advance an already-reserved purchase.
// Probe up to four native progress slots: Reactor and campaign command cards
// need not occupy the default slot.  Do not advance unrelated research.
// Crew Dev63: a single native producer can finish on each paid-advance beat.
// Two simultaneous barracks cannot cascade a second completion on one
// purchase before Galaxy delivers the first completion receipt.
bool APRG_CrewProdAdvanceTraining(unit producer,string expectedType) {
    int slot;
    int explicitSlot=0;
    int anonymousSlot=0;
    int anonymousCount=0;
    string queued;
    if (producer==null || !UnitIsAlive(producer) || expectedType=="") { return false; }
    if (GameGetMissionTime()<g_aprgCrewNextPaidTrainBeat) { return false; }
    // Prefer a slot whose exposed queue object exactly matches the paid type.
    // A queue can be empty even while its active train progress is running.
    for (slot=1;slot<=4;slot+=1) {
        if (!UnitCheckProgressState(producer,slot,c_unitProgressStateActive)) { continue; }
        queued="";
        if (UnitQueueItemCount(producer,slot)>0) {
            queued=UnitQueueItemGet(producer,1,slot);
        }
        if (queued!="" && APRG_CrewProdCanonical(queued)==expectedType) {
            explicitSlot=slot;
            break;
        }
        if (queued=="") {
            anonymousSlot=slot;
            anonymousCount+=1;
        }
    }
    if (explicitSlot>0) {
        g_aprgCrewNextPaidTrainBeat=GameGetMissionTime()+0.30;
        UnitSetProgressComplete(producer,explicitSlot,100);
        return true;
    }
    // Do not accelerate unrelated research/addon progress if two anonymous
    // slots are active and SC2 provides no type information to distinguish.
    if (anonymousCount==1) {
        g_aprgCrewNextPaidTrainBeat=GameGetMissionTime()+0.30;
        UnitSetProgressComplete(producer,anonymousSlot,100);
        return true;
    }
    // Dev56's unconditional slot-1 fallback was essential for AP producers
    // that expose no active queue/progress state even while training. Retain
    // it, but only here and once per global completion beat.
    if (anonymousCount==0) {
        g_aprgCrewNextPaidTrainBeat=GameGetMissionTime()+0.30;
        UnitSetProgressComplete(producer,1,100);
        return true;
    }
    return false;
}

// Dev60: some native SC2 construction actors do not finalize when their
// progress is set to 100%, even after the stock claim and native event have
// been banked (observed in CrewLive(10).log).  A finished, independently
// observed replacement is a guarded last resort for ordinary placed
// structures, never an unowned/bare unit spawn or addon/morph.
bool APRG_CrewProdCanReplaceConstruction(string nativeType) {
    string canonical=APRG_CrewProdCanonical(nativeType);
    if (canonical=="TechLab" || canonical=="Reactor" ||
        canonical=="PlanetaryFortress" || canonical=="OrbitalCommand") { return false; }
    // Only normal Crew purchasable structures; never units, larvae or morphs.
    if (canonical=="SupplyDepot" || canonical=="Barracks" || canonical=="Factory" ||
        canonical=="Starport" || canonical=="EngineeringBay" || canonical=="Armory" ||
        canonical=="Bunker" || canonical=="MissileTurret" || canonical=="SensorTower" ||
        canonical=="CommandCenter" || canonical=="Refinery" ||
        canonical=="Hatchery" || canonical=="SpawningPool" ||
        canonical=="RoachWarren" || canonical=="Extractor" ||
        canonical=="EvolutionChamber" || canonical=="BanelingNest" ||
        canonical=="HydraliskDen" || canonical=="InfestationPit" ||
        canonical=="Spire" || canonical=="UltraliskCavern" ||
        canonical=="SpineCrawler" || canonical=="SporeCrawler" ||
        canonical=="Nexus" || canonical=="Pylon" || canonical=="Gateway" ||
        canonical=="Assimilator" || canonical=="CyberneticsCore" ||
        canonical=="Forge" || canonical=="RoboticsFacility" ||
        canonical=="Stargate" || canonical=="TwilightCouncil" ||
        canonical=="RoboticsBay" || canonical=="TemplarArchives" ||
        canonical=="FleetBeacon" || canonical=="PhotonCannon" ||
        canonical=="DevastatorTurret" || canonical=="PerditionTurret") { return true; }
    return false;
}

// Do NOT spend a second copy, or mark one complete, unless the new actor
// really exists, is finished, is owned, and has the exact AP/native type.
// Create before removing the foundation so failure leaves the player's
// existing structure intact.  The bank receipt always names the new actor.
bool APRG_CrewProdReplaceStalledFoundation(unit built) {
    int oldTag;
    int player;
    int number;
    int workerTag;
    string unitType;
    string key;
    unitgroup created;
    unit finished;
    if (built==null || !UnitIsValid(built) ||
        !libNtve_gf_UnitIsUnderConstruction(built)) { return false; }
    oldTag=UnitGetTag(built);
    key="APRG_CrewProdBuild_"+IntToString(oldTag);
    number=DataTableGetInt(true,key);
    workerTag=DataTableGetInt(true,"APRG_CrewProdBuilder_"+IntToString(oldTag));
    player=APRG_GetPrimaryPlayer();
    unitType=UnitGetType(built);
    if (number<=0 || workerTag<=0 || g_aprgCrewDeathBank==null ||
        UnitGetOwner(built)!=player ||
        DataTableGetBool(true,"APRG_CrewProdBuilt_"+IntToString(oldTag)) ||
        !APRG_CrewProdCanReplaceConstruction(unitType)) { return false; }
    if (GameGetMissionTime()<DataTableGetFixed(true,
            "APRG_CrewProdLastReplicaAttempt_"+IntToString(oldTag))+3.0) { return false; }
    DataTableSetFixed(true,"APRG_CrewProdLastReplicaAttempt_"+IntToString(oldTag),
        GameGetMissionTime());
    created=UnitCreate(1,unitType,c_unitCreateIgnorePlacement,player,
                       UnitGetPosition(built),UnitGetFacing(built));
    if (created==null || UnitGroupCount(created,c_unitCountAll)!=1) {
        APRG_CrewProdDiagnostic("BuildReplicaFailed",APRG_CrewNativeTypeCode(
            APRG_CrewProdCanonical(unitType)));
        return false;
    }
    finished=UnitGroupUnitFromEnd(created,1);
    if (finished==null || !UnitIsValid(finished) || !UnitIsAlive(finished) ||
        UnitGetOwner(finished)!=player || UnitGetType(finished)!=unitType ||
        UnitGetTag(finished)<=0 || UnitGetTag(finished)==oldTag ||
        libNtve_gf_UnitIsUnderConstruction(finished)) {
        if (finished!=null && UnitIsValid(finished)) { UnitRemove(finished); }
        APRG_CrewProdDiagnostic("BuildReplicaFailed",APRG_CrewNativeTypeCode(
            APRG_CrewProdCanonical(unitType)));
        return false;
    }
    // Clear old authorization before removing foundation: a late cancel
    // callback must never return this spent copy to Reserves.
    DataTableSetBool(true,"APRG_CrewProdBuilt_"+IntToString(oldTag),true);
    DataTableSetInt(true,key,0);
    DataTableSetBool(true,"APRG_CrewProdBlockedBuild_"+IntToString(oldTag),false);
    if (g_aprgCrewPendingConstructs!=null) {
        UnitGroupRemove(g_aprgCrewPendingConstructs,built);
    }
    UnitRemove(built);
    APRG_CrewProdReceiptTag(finished,workerTag,number,false);
    APRG_CrewProdDiagnostic("BuildReplicaComplete",number);
    return true;
}

// Construction progress is owned by the constructed SC2 actor. Campaign
// examples call UnitSetProgressComplete on the unfinished building itself.
// Addons can also expose construction progress on their production building.
// Never advance an arbitrary SCV or another order on a Barracks.
bool APRG_CrewProdAdvanceConstruction(unit built) {
    int slot;
    int nativeTag;
    unit producer;
    bool advanced=false;
    if (built==null || !UnitIsValid(built)) { return false; }
    nativeTag=UnitGetTag(built);
    if (DataTableGetInt(true,"APRG_CrewProdBuild_"+IntToString(nativeTag))<=0 ||
        DataTableGetBool(true,"APRG_CrewProdBuilt_"+IntToString(nativeTag))) { return false; }
    // Record the first before/after progress observation for each actor.
    // If SC2 ignores the command, CrewLive diagnostics will show the actual
    // building percentage rather than falsely reporting completion.
    if (!DataTableGetBool(true,"APRG_CrewProdProgressProbed_"+IntToString(nativeTag))) {
        DataTableSetBool(true,"APRG_CrewProdProgressProbed_"+IntToString(nativeTag),true);
        APRG_CrewProdDiagnostic("BuildPercentBefore",1+FixedToInt(UnitGetProgressComplete(built,1)));
        UnitSetProgressComplete(built,1,100);
        APRG_CrewProdDiagnostic("BuildPercentAfter",1+FixedToInt(UnitGetProgressComplete(built,1)));
    }
    else { UnitSetProgressComplete(built,1,100); }
    advanced=true;
    for (slot=2;slot<=4;slot+=1) {
        if (UnitCheckProgressState(built,slot,c_unitProgressStateActive)) {
            UnitSetProgressComplete(built,slot,100);
        }
    }
    // A native 100% progress write does not always complete SCV-built
    // structures. Record elapsed *game* time, not a number of fast tick calls.
    // The fallback is never attempted until 3 seconds after an actual paid
    // claim; this gives the engine multiple native completion opportunities.
    if (DataTableGetFixed(true,"APRG_CrewProdFirstAdvance_"+IntToString(nativeTag))<=0.0) {
        DataTableSetFixed(true,"APRG_CrewProdFirstAdvance_"+IntToString(nativeTag),
                          GameGetMissionTime()+0.01);
    }
    if (GameGetMissionTime() -
        DataTableGetFixed(true,"APRG_CrewProdFirstAdvance_"+IntToString(nativeTag))>=3.0) {
        if (!APRG_CrewAddonStillBuilding(built) &&
            g_aprgCrewDeathBank!=null &&
            DataTableGetInt(true,"APRG_CrewProdBuilder_"+IntToString(nativeTag))>0) {
            // A native completion may have occurred without its progress
            // callback.  The original purchased, player-owned structure is
            // actually finished: bank this existing actor, not a replacement.
            APRG_CrewProdReceiptTag(built,DataTableGetInt(true,
                "APRG_CrewProdBuilder_"+IntToString(nativeTag)),
                DataTableGetInt(true,"APRG_CrewProdBuild_"+IntToString(nativeTag)),false);
            DataTableSetBool(true,"APRG_CrewProdBuilt_"+IntToString(nativeTag),true);
            DataTableSetInt(true,"APRG_CrewProdBuild_"+IntToString(nativeTag),0);
            if (g_aprgCrewPendingConstructs!=null) {
                UnitGroupRemove(g_aprgCrewPendingConstructs,built);
            }
            APRG_CrewProdDiagnostic("BuildCompleteRecovered",nativeTag);
            return true;
        }
        // If native completion ignored progress writes, replace only an
        // already-authorized placed foundation.  A failed replacement leaves
        // the original foundation and purchased claim unchanged.
        if (APRG_CrewProdReplaceStalledFoundation(built)) { return true; }
    }
    if (APRG_CrewProdCanonical(UnitGetType(built))=="TechLab") {
        // An addon may have a specialization progress stage instead of an
        // ordinary Build stage. Attempt explicit completion of the authorized
        // addon actor; never issue this for a Reactor or unpaid Tech Lab.
        for (slot=1;slot<=4;slot+=1) {
            if (UnitCheckProgressState(built,slot,c_unitProgressStateActive)) {
                UnitSetProgressStage(built,slot,c_unitProgressStageComplete);
            }
        }
        producer=DataTableGetUnit(true,"APRG_CrewProdBuilderUnit_"+IntToString(nativeTag));
        if (APRG_CrewProdCanonical(UnitGetType(built))=="TechLab" &&
            producer!=null && UnitIsValid(producer) &&
            UnitGetOwner(producer)==UnitGetOwner(built) &&
            APRG_CrewProdOrderedSpecialization(producer)=="TechLab") {
            // Never complete a Marine or another producer slot as a side
            // effect of a purchased Tech Lab foundation.
            APRG_CrewProdAdvanceSpecialization(producer,"TechLab");
        }
    }
    return advanced;
}

// SC2 construction events can precede the foundation's progress flag. Also
// discover purchased/unpurchased foundations from the live player-unit view.
// A new actor alone is not enough evidence for a paid receipt: its builder
// must be explicitly observed on a matching active order or creation event.
unit APRG_CrewFindBuilder(unit built,unitgroup owned) {
    int i;
    int j;
    unit candidate;
    unit found=null;
    string workerType;
    order current;
    point target;
    string ability;
    if (built==null) { return null; }
    for (i=UnitGroupCount(owned,c_unitCountAlive);i>0;i-=1) {
        candidate=UnitGroupUnitFromEnd(owned,i);
        if (candidate==null || UnitGetOwner(candidate)!=UnitGetOwner(built)) { continue; }
        workerType=APRG_CrewProdCanonical(UnitGetType(candidate));
        if (workerType!="SCV" && workerType!="Drone" && workerType!="Probe" &&
            !(APRG_CrewProdCanonical(UnitGetType(built))=="TechLab" &&
              (workerType=="Barracks" || workerType=="Factory" || workerType=="Starport"))) { continue; }
        for (j=0;j<UnitOrderCount(candidate) && j<4;j+=1) {
            current=UnitOrder(candidate,j);
            ability=AbilityCommandGetAbility(OrderGetAbilityCommand(current));
            target=OrderGetTargetPoint(current);
            if (OrderGetTargetUnit(current)==built ||
                (target!=null && (StringContains(ability,"Build",c_stringAnywhere,c_stringNoCase) ||
                 StringContains(ability,"TechLab",c_stringAnywhere,c_stringNoCase)) &&
                 DistanceBetweenPoints(target,UnitGetPosition(built))<=2.5)) {
                if (found!=null && found!=candidate) { return null; }
                found=candidate;
                break;
            }
        }
    }
    return found;
}

void APRG_CrewObserveFoundations(unitgroup owned,int player) {
    int i;
    int tag;
    unit built;
    unit builder;
    string kind;
    string key;
    if (!g_aprgCrewProdReady) { return; }
    for (i=UnitGroupCount(owned,c_unitCountAlive);i>0;i-=1) {
        built=UnitGroupUnitFromEnd(owned,i);
        if (built==null || UnitGetOwner(built)!=player ||
            !UnitTypeTestAttribute(UnitGetType(built),c_unitAttributeStructure) ||
            !libNtve_gf_UnitIsUnderConstruction(built)) { continue; }
        tag=UnitGetTag(built);
        if (tag<=0 || DataTableGetBool(true,
            "APRG_CrewNativeStart_"+IntToString(g_aprgCrewDeathToken)+"_"+IntToString(tag))) { continue; }
        kind=APRG_CrewProdCanonical(UnitGetType(built));
        if (kind=="Reactor" || !APRG_CrewProdUnitType(kind)) { continue; }
        key="APRG_CrewProdBuild_"+IntToString(tag);
        if (!DataTableGetBool(true,"APRG_CrewProdBlockedBuild_"+IntToString(tag)) &&
            DataTableGetInt(true,key)==0 &&
            !DataTableGetBool(true,"APRG_CrewProdBuilt_"+IntToString(tag))) {
            DataTableSetBool(true,"APRG_CrewProdBlockedBuild_"+IntToString(tag),true);
            if (g_aprgCrewPendingConstructs==null) { g_aprgCrewPendingConstructs=UnitGroupEmpty(); }
            if (!UnitGroupHasUnit(g_aprgCrewPendingConstructs,built)) { UnitGroupAdd(g_aprgCrewPendingConstructs,built); }
            APRG_CrewProdDiagnostic("FoundationFound",APRG_CrewNativeTypeCode(kind));
        }
        if (DataTableGetInt(true,"APRG_CrewProdBuilder_"+IntToString(tag))<=0) {
            builder=APRG_CrewFindBuilder(built,owned);
            if (builder!=null) {
                DataTableSetInt(true,"APRG_CrewProdBuilder_"+IntToString(tag),UnitGetTag(builder));
                DataTableSetUnit(true,"APRG_CrewProdBuilderUnit_"+IntToString(tag),builder);
                APRG_CrewProdDiagnostic("BuilderFound",APRG_CrewNativeTypeCode(kind));
            }
        }
    }
}

// Independently identify the real addon producer. A hidden campaign addon
// can be present without a ConstructProgress creator or any active build
// order. Prefer the exact claimed specialization, then its verified order,
// then a unique nearby Terran production building. Reject ambiguous hosts.
unit APRG_CrewFindAddonProducer(unit addon,unitgroup owned) {
    unit candidate;
    unit chosen=null;
    string hostType;
    int i;
    int rank;
    int bestRank=0;
    bool ambiguous=false;
    if (addon==null || !UnitIsValid(addon)) { return null; }
    for (i=UnitGroupCount(owned,c_unitCountAlive);i>0;i-=1) {
        candidate=UnitGroupUnitFromEnd(owned,i);
        if (candidate==null || !UnitIsValid(candidate) ||
            UnitGetOwner(candidate)!=UnitGetOwner(addon)) { continue; }
        hostType=APRG_CrewProdCanonical(UnitGetType(candidate));
        if (hostType!="Barracks" && hostType!="Factory" && hostType!="Starport") { continue; }
        if (DistanceBetweenPoints(UnitGetPosition(candidate),UnitGetPosition(addon))>5.0) { continue; }
        rank=1;
        if (APRG_CrewProdOrderedSpecialization(candidate)=="TechLab") { rank=2; }
        if (DataTableGetInt(true,"APRG_CrewSpecialClaim_"+IntToString(UnitGetTag(candidate)))>0 &&
            DataTableGetString(true,"APRG_CrewSpecialKind_"+IntToString(UnitGetTag(candidate)))=="TechLab") {
            rank=3;
        }
        if (rank>bestRank) { chosen=candidate; bestRank=rank; ambiguous=false; }
        else if (rank==bestRank) { ambiguous=true; }
    }
    if (ambiguous) { return null; }
    return chosen;
}

// Tech Lab construction is an independent structure actor, even when its
// parent producer does not emit an addon/specialize event. The stock-claimed
// addon is accelerated by its OWN progress, not its Barracks order.
// Scan the owner's units without excluding c_targetFilterHidden: an
// unfinished native/AP addon can be hidden from APRG_PlayerAllUnits.
void APRG_CrewObserveAddonFoundations(unitgroup owned,int player) {
    unitgroup candidates;
    unit addon;
    unit producer;
    int i;
    int tag;
    int number;
    int producerTag;
    int slot;
    bool active;
    bool unfinished;
    string key;
    string unitType;
    string scanKey;
    fixed now;
    if (!g_aprgCrewProdReady) { return; }
    // Do not enumerate all units every simulation tick on large missions.
    now=GameGetMissionTime();
    scanKey="APRG_CrewAddonScanAt_"+IntToString(g_aprgCrewDeathToken);
    if (now<DataTableGetFixed(true,scanKey)) { return; }
    DataTableSetFixed(true,scanKey,now+0.20);
    // An addon can be attached/hidden or omit ordinary construction flags.
    // Use the same unrestricted native actor enumeration that works for
    // mission-supplied units, not the map-region/visibility scan.
    candidates=UnitGroup(null,player,null,UnitFilter(0,0,0,0),0);
    for (i=UnitGroupCount(candidates,c_unitCountAll);i>0;i-=1) {
        addon=UnitGroupUnitFromEnd(candidates,i);
        if (addon==null || !UnitIsValid(addon) || UnitGetOwner(addon)!=player) { continue; }
        unitType=APRG_CrewProdCanonical(UnitGetType(addon));
        // Include AP/campaign addon unit links whose names contain TechLab;
        // they do not all share the standard BuildProgress trigger or type.
        if (unitType!="TechLab" &&
            !StringContains(unitType,"TechLab",c_stringAnywhere,c_stringNoCase)) { continue; }
        tag=UnitGetTag(addon);
        if (tag<=0 || DataTableGetBool(true,"APRG_CrewNativeStart_"+
            IntToString(g_aprgCrewDeathToken)+"_"+IntToString(tag))) { continue; }
        if (!DataTableGetBool(true,"APRG_CrewAddonTypeSeen_"+IntToString(tag))) {
            DataTableSetBool(true,"APRG_CrewAddonTypeSeen_"+IntToString(tag),true);
            APRG_CrewProdDiagnostic("AddonTypeSeen",56);
        }
        active=false;
        for (slot=0;slot<4;slot+=1) {
            if (UnitCheckProgressState(addon,slot,c_unitProgressStateActive)) { active=true; }
        }
        unfinished=libNtve_gf_UnitIsUnderConstruction(addon) || active;
        // Never claim a complete free mission addon just because it exists.
        if (!unfinished) { continue; }
        if (!DataTableGetBool(true,"APRG_CrewAddonSeen_"+IntToString(tag))) {
            DataTableSetBool(true,"APRG_CrewAddonSeen_"+IntToString(tag),true);
            APRG_CrewProdDiagnostic("AddonFoundationSeen",56);
        }
        key="APRG_CrewProdBuild_"+IntToString(tag);
        number=DataTableGetInt(true,key);
        // An earlier Specialize/Created event can already own this claim.
        // If not, claim exactly one purchased Tech Lab copy. Do not depend
        // on identifying a nearby producer to decide whether to fast-forward.
        if (number<=0 && !DataTableGetBool(true,"APRG_CrewProdBuilt_"+IntToString(tag))) {
            producer=APRG_CrewFindAddonProducer(addon,owned);
            if (producer==null) {
                if (!DataTableGetBool(true,"APRG_CrewAddonMissingHost_"+IntToString(tag))) {
                    DataTableSetBool(true,"APRG_CrewAddonMissingHost_"+IntToString(tag),true);
                    APRG_CrewProdDiagnostic("AddonHostMissing",56);
                }
            }
            else {
                producerTag=UnitGetTag(producer);
                number=DataTableGetInt(true,"APRG_CrewSpecialClaim_"+IntToString(producerTag));
                if (number>0 && DataTableGetString(true,
                    "APRG_CrewSpecialKind_"+IntToString(producerTag))=="TechLab") {
                    // ConstructProgress and SpecializeProgress can describe
                    // the SAME copy. Transfer the claim, never buy twice.
                    DataTableSetInt(true,"APRG_CrewSpecialClaim_"+IntToString(producerTag),0);
                    APRG_CrewProdDiagnostic("AddonClaimTransfer",number);
                }
                else { number=APRG_CrewProdClaim("TechLab"); }
                if (number>0) {
                    DataTableSetInt(true,key,number);
                    DataTableSetInt(true,"APRG_CrewProdBuilder_"+IntToString(tag),producerTag);
                    DataTableSetUnit(true,"APRG_CrewProdBuilderUnit_"+IntToString(tag),producer);
                    DataTableSetBool(true,"APRG_CrewProdBlockedBuild_"+IntToString(tag),false);
                    APRG_CrewProdDiagnostic("AddonFound",number);
                }
            }
        }
        if (number>0) {
            if (g_aprgCrewPendingConstructs==null) { g_aprgCrewPendingConstructs=UnitGroupEmpty(); }
            if (!UnitGroupHasUnit(g_aprgCrewPendingConstructs,addon)) {
                UnitGroupAdd(g_aprgCrewPendingConstructs,addon);
            }
            APRG_CrewProdAdvanceConstruction(addon);
            // Addon construction can occupy a different active progress slot
            // than the ordinary worker building slot 1.
            for (slot=0;slot<4;slot+=1) {
                if (UnitCheckProgressState(addon,slot,c_unitProgressStateActive)) {
                    UnitSetProgressComplete(addon,slot,100);
                    UnitSetProgressStage(addon,slot,c_unitProgressStageComplete);
                }
            }
        }
        else {
            // Unpaid addons are held at zero on their actual active slot.
            for (slot=0;slot<4;slot+=1) {
                if (UnitCheckProgressState(addon,slot,c_unitProgressStateActive)) {
                    UnitSetProgressComplete(addon,slot,0);
                }
            }
        }
    }
}

// Unauthorized orders retain their long 1000-second fallback.  Only a real
// purchased-copy claim is allowed to trigger native progress advancement.
void APRG_CrewProdClamp(unitgroup owned,int player) {
    int i;
    unit u;
    int tag;
    int number;
    string expectedType;
    if (!g_aprgCrewProdReady) { return; }
    APRG_CrewObserveFoundations(owned,player);
    APRG_CrewObserveAddonFoundations(owned,player);
    for (i=UnitGroupCount(owned,c_unitCountAlive);i>0;i-=1) {
        u=UnitGroupUnitFromEnd(owned,i);
        if (u==null || UnitGetOwner(u)!=player) { continue; }
        tag=UnitGetTag(u);
        // Campaign addons may expose only native orders; keep this before
        // the paid special claim retry, without touching normal train orders.
        APRG_CrewProdRecoverSpecialOrder(u);
        // This is distinct from ordinary training/building; Tech Lab and
        // Planetary Fortress can use Specialize instead of Construct events.
        if (DataTableGetInt(true,"APRG_CrewSpecialClaim_"+IntToString(tag))>0) {
            APRG_CrewProdRecoverSpecialization(u);
        }
        else if (DataTableGetString(true,"APRG_CrewSpecialBlocked_"+IntToString(tag))!="") {
            UnitSetProgressComplete(u,1,0);
        }
        // A unit under construction may have a valid tag but no finished
        // order yet. Continue trying after its engine progress initializes.
        if (DataTableGetInt(true,"APRG_CrewProdBuild_"+IntToString(tag))>0 &&
            !DataTableGetBool(true,"APRG_CrewProdBuilt_"+IntToString(tag))) {
            APRG_CrewProdAdvanceConstruction(u);
            if (!UnitIsValid(u)) { continue; }
        }
        number=DataTableGetInt(true,"APRG_CrewProdTrain_"+IntToString(tag));
        if (number>0) {
            expectedType=DataTableGetString(true,"APRG_CrewProdTrainType_"+IntToString(tag));
            // Preserve the original Dev47b fast-forward on slot 1, even if
            // an AP producer reports its active train progress separately
            // from the queue state. Retry only for an exact paid claim.
            APRG_CrewProdAdvanceTraining(u,expectedType);
        }
        // A purchase can arrive while an order already runs.  Preserve
        // the blocked state until a matching Cancel/Complete event or an
        // actual reserve claim; queue length zero is NOT proof of cancellation.
        if (DataTableGetBool(true,"APRG_CrewProdBlockedTrain_"+IntToString(tag))) {
            expectedType=DataTableGetString(true,"APRG_CrewProdBlockedTrainType_"+IntToString(tag));
            number=APRG_CrewProdClaim(expectedType);
            if (number>0) {
                DataTableSetInt(true,"APRG_CrewProdTrain_"+IntToString(tag),number);
                DataTableSetString(true,"APRG_CrewProdTrainType_"+IntToString(tag),expectedType);
                DataTableSetBool(true,"APRG_CrewProdBlockedTrain_"+IntToString(tag),false);
                // Dev47b used slot-1 unconditionally on a newly paid claim.
                // Its later replacement gated this on SC2's progress-state
                // report and could strand an already-running order at 1000s.
                // This branch is only entered after an individually banked,
                // unspent purchase has been claimed for the observed train type.
                APRG_CrewProdAdvanceTraining(u,expectedType);
                APRG_CrewProdDiagnostic("TrainAdvance",number);
            }
            else {
                // An unpaid order never accumulates progress. Keep a
                // 1000-second build time and rewind to 0% every Crew tick.
                // Only producers with a tracked TrainStart enter here.
                UnitSetProgressComplete(u,1,0);
            }
        }
        if (DataTableGetBool(true,"APRG_CrewProdBlockedBuild_"+IntToString(tag)) &&
            !DataTableGetBool(true,"APRG_CrewProdBuilt_"+IntToString(tag))) {
            number=0;
            if (DataTableGetInt(true,"APRG_CrewProdBuilder_"+IntToString(tag))>0) {
                number=APRG_CrewProdClaim(APRG_CrewProdCanonical(UnitGetType(u)));
            }
            if (number>0) {
                DataTableSetInt(true,"APRG_CrewProdBuild_"+IntToString(tag),number);
                DataTableSetBool(true,"APRG_CrewProdBlockedBuild_"+IntToString(tag),false);
                // Use the real worker captured at Start (not a zero fallback).
                if (DataTableGetInt(true,"APRG_CrewProdBuilder_"+IntToString(tag))<=0) {
                    DataTableSetInt(true,"APRG_CrewProdBuilder_"+IntToString(tag),
                        DataTableGetInt(true,"APRG_CrewProdBlockedBuilder_"+IntToString(tag)));
                }
                APRG_CrewProdAdvanceConstruction(u);
                APRG_CrewProdDiagnostic("BuildAdvance",number);
            }
            else if (libNtve_gf_UnitIsUnderConstruction(u)) {
                // Only a tracked unpaid foundation is reset, never a base
                // structure or a separate active order on the SCV.
                UnitSetProgressComplete(u,1,0);
            }
        }
    }
    if (g_aprgCrewPendingConstructs!=null) {
        for (i=UnitGroupCount(g_aprgCrewPendingConstructs,c_unitCountAll);i>0;i-=1) {
            u=UnitGroupUnitFromEnd(g_aprgCrewPendingConstructs,i);
            if (u==null || !UnitIsValid(u)) { continue; }
            tag=UnitGetTag(u);
            if (UnitGetOwner(u)!=player) { continue; }
            if (DataTableGetInt(true,"APRG_CrewProdBuild_"+IntToString(tag))>0 &&
                !DataTableGetBool(true,"APRG_CrewProdBuilt_"+IntToString(tag))) {
                APRG_CrewProdAdvanceConstruction(u);
            }
            else if (DataTableGetBool(true,"APRG_CrewProdBlockedBuild_"+IntToString(tag)) &&
                     libNtve_gf_UnitIsUnderConstruction(u)) {
                number=0;
                if (DataTableGetInt(true,"APRG_CrewProdBuilder_"+IntToString(tag))>0) {
                    number=APRG_CrewProdClaim(APRG_CrewProdCanonical(UnitGetType(u)));
                }
                if (number>0) {
                    DataTableSetInt(true,"APRG_CrewProdBuild_"+IntToString(tag),number);
                    DataTableSetBool(true,"APRG_CrewProdBlockedBuild_"+IntToString(tag),false);
                    APRG_CrewProdAdvanceConstruction(u);
                    APRG_CrewProdDiagnostic("BuildAdvance",number);
                }
                else {
                    // Unpaid foundations remain at zero progress, so their
                    // displayed 1000-second native build time never expires.
                    if (!DataTableGetBool(true,"APRG_CrewProdResetProbed_"+IntToString(tag))) {
                        DataTableSetBool(true,"APRG_CrewProdResetProbed_"+IntToString(tag),true);
                        APRG_CrewProdDiagnostic("BuildResetSeen",APRG_CrewNativeTypeCode(
                            APRG_CrewProdCanonical(UnitGetType(u))));
                    }
                    UnitSetProgressComplete(u,1,0);
                }
            }
        }
    }
}

// Dev50b: inert compatibility shim for any surviving legacy callers.
void APRG_CrewDisableProductionForUnit(unit u, int player) {
    // Crew command cards are always available.
}

// A lifted Terran production building is still the SAME paid/free physical
// actor. Charge its grounded catalog type on death; never let morphing into
// a flight CUnit erase the individual tag-based debit or exemption.
string APRG_CrewLossBuildingType(string nativeType) {
    string t=APRG_CrewEconomyType(nativeType);
    if (t=="CommandCenterFlying" || t=="OrbitalCommand" ||
        t=="OrbitalCommandFlying") { return "CommandCenter"; }
    if (t=="BarracksFlying") { return "Barracks"; }
    if (t=="FactoryFlying") { return "Factory"; }
    if (t=="StarportFlying") { return "Starport"; }
    return APRG_CrewProdCanonical(nativeType);
}

bool APRG_CrewChargeableBuilding(string nativeType) {
    string t=APRG_CrewLossBuildingType(nativeType);
    // Whitelist actual cataloged Crew *structures* rather than the broad
    // receipt codes (which also contain Marines, heroes, etc.).
    return (t=="CommandCenter" || t=="Barracks" || t=="Factory" ||
        t=="Starport" || t=="SupplyDepot" || t=="Refinery" ||
        t=="EngineeringBay" || t=="Armory" || t=="Bunker" ||
        t=="MissileTurret" || t=="SensorTower" || t=="TechLab" ||
        t=="PlanetaryFortress" || t=="DevastatorTurret" ||
        t=="PerditionTurret" || t=="Hatchery" || t=="Extractor" || t=="SpawningPool" ||
        t=="EvolutionChamber" || t=="RoachWarren" ||
        t=="BanelingNest" || t=="HydraliskDen" ||
        t=="InfestationPit" || t=="Spire" ||
        t=="UltraliskCavern" || t=="SpineCrawler" ||
        t=="SporeCrawler" || t=="Nexus" || t=="Pylon" ||
        t=="Gateway" || t=="Assimilator" || t=="CyberneticsCore" ||
        t=="Forge" || t=="RoboticsFacility" || t=="Stargate" ||
        t=="TwilightCouncil" || t=="RoboticsBay" ||
        t=="TemplarArchives" || t=="FleetBeacon" || t=="PhotonCannon");
}

// Only units that were explicitly created or claimed by this Crew session
// enter the death ledger. Ordinary campaign/story actors are never counted.
bool APRG_CrewDeath_Func(bool testConds, bool runActions) {
    unit dead;
    int nativeTag;
    string key;
    bool paidFoundation;
    if (!runActions || g_aprgCrewDeathToken <= 0 ||
        g_aprgCrewDeathBank == null ||
        (g_aprgMissionFlags & APRG_MISSION_FLAG_CREW_CHALLENGE) == 0) { return true; }
    dead = EventUnit();
    if (dead == null || UnitGetOwner(dead) != APRG_GetPrimaryPlayer()) { return true; }
    nativeTag = UnitGetTag(dead);
    if (nativeTag <= 0) { return true; }
    if (g_aprgCrewPendingConstructs!=null && UnitGroupHasUnit(g_aprgCrewPendingConstructs,dead)) {
        UnitGroupRemove(g_aprgCrewPendingConstructs,dead);
    }
    paidFoundation = (DataTableGetInt(true,"APRG_CrewProdBuild_"+IntToString(nativeTag))>0 ||
        DataTableGetInt(true,"APRG_CrewSpecialClaim_"+IntToString(nativeTag))>0);
    // A producer destroyed while training, or a building destroyed before
    // construction completes, must not strand an otherwise unused purchase.
    // Neither case has a completed receipt, so the claim can be reused.
    if (DataTableGetInt(true,"APRG_CrewProdTrain_"+IntToString(nativeTag))>0) {
        APRG_CrewProdReturn(DataTableGetInt(true,"APRG_CrewProdTrain_"+IntToString(nativeTag)));
        DataTableSetInt(true,"APRG_CrewProdTrain_"+IntToString(nativeTag),0);
    }
    if (DataTableGetInt(true,"APRG_CrewProdBuild_"+IntToString(nativeTag))>0 &&
        !DataTableGetBool(true,"APRG_CrewProdBuilt_"+IntToString(nativeTag))) {
        APRG_CrewProdReturn(DataTableGetInt(true,"APRG_CrewProdBuild_"+IntToString(nativeTag)));
        DataTableSetInt(true,"APRG_CrewProdBuild_"+IntToString(nativeTag),0);
    }
    if (DataTableGetInt(true,"APRG_CrewSpecialClaim_"+IntToString(nativeTag))>0) {
        APRG_CrewProdReturn(DataTableGetInt(true,"APRG_CrewSpecialClaim_"+IntToString(nativeTag)));
        DataTableSetInt(true,"APRG_CrewSpecialClaim_"+IntToString(nativeTag),0);
    }
    DataTableSetBool(true,"APRG_CrewProdBlockedTrain_"+IntToString(nativeTag),false);
    DataTableSetBool(true,"APRG_CrewProdBlockedBuild_"+IntToString(nativeTag),false);
    if (!DataTableGetBool(true, "APRG_CrewTracked_" + IntToString(g_aprgCrewDeathToken) + "_" + IntToString(nativeTag)) &&
        !DataTableGetBool(true, "APRG_CrewDeployed_" + IntToString(g_aprgCrewDeathToken) + "_" + IntToString(nativeTag))) {
        // Free campaign starting / scripted buildings are not Crew purchases.
        // Bank only independently observed real structure deaths. The Python
        // ledger prices the type and debits once using session+tag.
        if (APRG_CrewChargeableBuilding(UnitGetType(dead)) &&
            // Purchased-but-unfinished buildings are already paid for, even
            // before their final completion receipt; do not charge twice.
            !paidFoundation &&
            // A paid construction could already have completed and cleared
            // its claim. The per-instance deployed marker is still retained.
            DataTableGetBool(true,"APRG_CrewEverReady_"+
                IntToString(g_aprgCrewDeathToken)+"_"+IntToString(nativeTag)) &&
            // A canceled/destroyed foundation is not a completed building.
            // Explicit native flag is checked at death, and Python separately
            // requires a previously observed READY actor before debiting.
            !libNtve_gf_UnitIsUnderConstruction(dead)) {
            key = "FreeBuildDeath" + IntToString(nativeTag);
            BankValueSetFromInt(g_aprgCrewDeathBank,
                "Session" + IntToString(g_aprgCrewDeathToken), key,
                APRG_CrewNativeTypeCode(APRG_CrewLossBuildingType(UnitGetType(dead))));
            BankSave(g_aprgCrewDeathBank);
        }
        return true;
    }
    key = "DeathTag" + IntToString(nativeTag);
    BankValueSetFromInt(g_aprgCrewDeathBank,
        "Session" + IntToString(g_aprgCrewDeathToken), key, g_aprgCrewDeathToken);
    BankSave(g_aprgCrewDeathBank);
    DataTableSetBool(true, "APRG_CrewTracked_" + IntToString(g_aprgCrewDeathToken) + "_" + IntToString(nativeTag), false);
    return true;
}

void APRG_CrewReleaseSelectionLock() {
    int i;
    unit u;
    if (g_aprgCrewLockedSelection != null) {
        for (i = UnitGroupCount(g_aprgCrewLockedSelection, c_unitCountAlive); i > 0; i -= 1) {
            u = UnitGroupUnitFromEnd(g_aprgCrewLockedSelection, i);
            if (u != null && UnitIsAlive(u)) {
                UnitSetState(u, c_unitStateSelectable, true);
            }
        }
    }
    g_aprgCrewLockedSelection = UnitGroupEmpty();
    g_aprgCrewDeploymentComplete = true;
}

void APRG_CrewTickSelectionLock(int player) {
    // Legacy entry point deliberately inert: never block player input.
}

// Crew production now NEVER hides or disables any native ability. Workers,
// production buildings and add-ons keep their original command cards from
// the first frame of the mission. The ticker only applies production costs,
// fallback time, AP variants, and (after verified End) entitlement accounting.
void APRG_CrewTickProductionRestrictions(int player) {
    unitgroup all;
    int i;
    unit u;
    if ((g_aprgMissionFlags & APRG_MISSION_FLAG_CREW_CHALLENGE)==0 || player<=0) { return; }
    if (g_aprgCrewRestrictedActors==null ||
        GameGetMissionTime()>=g_aprgCrewNextProductionRescan) {
        g_aprgCrewRestrictedActors=UnitGroupEmpty();
        g_aprgCrewNextProductionRescan=GameGetMissionTime()+10.0;
    }
    all=APRG_PlayerAllUnits(player);
    for (i=UnitGroupCount(all,c_unitCountAlive);i>0;i-=1) {
        u=UnitGroupUnitFromEnd(all,i);
        if (u==null || UnitGetOwner(u)!=player) { continue; }
        // A bank death charge can be emitted only for a single actor seen
        // finished *while alive* in this session, never a raw foundation.
        if (g_aprgCrewProdReady && UnitIsAlive(u) &&
            APRG_CrewChargeableBuilding(UnitGetType(u)) &&
            !libNtve_gf_UnitIsUnderConstruction(u)) {
            DataTableSetBool(true,"APRG_CrewEverReady_"+
                IntToString(g_aprgCrewDeathToken)+"_"+IntToString(UnitGetTag(u)),true);
        }
        if (!APRG_CrewProductionHostType(UnitGetType(u))) { continue; }
        if (UnitGroupHasUnit(g_aprgCrewRestrictedActors,u)) { continue; }
        APRG_CrewProdConfigure(u,player);
        UnitGroupAdd(g_aprgCrewRestrictedActors,u);
    }
    if (g_aprgCrewProdReady) { APRG_CrewProdClamp(all,player); }
}

// Crew Challenge: automatic deployment only, with a banked per-copy SC2
// tag receipt. No new train, morph, or command-card abilities are added.
// This path activates ONLY for missions carrying the Crew Challenge flag;
// live Crew mission launching remains gated until the client is integrated.
// Preserve AP campaign upgrades: spawn the Archipelago CUnit variant when
// the active mod actually contains one; never invent a missing catalog ID.
// Receipt type codes retain the canonical requested native type.
string APRG_CrewDeploymentUnitType(string unitType) {
    string apType = "AP_" + unitType;
    if (CatalogEntryIsValid(c_gameCatalogUnit, apType)) { return apType; }
    return unitType;
}

