    if (APRG_HasExtension4(APRG_EXT4_BOON_IMMORTAL_IMMORTALS)) {
        if (result != "") { result = result + ", "; }
        result = result + "Immortal immortals";
    }
    if (APRG_HasExtension4(APRG_EXT4_BOON_KILL_STREAK)) {
        if (result != "") { result = result + ", "; }
        result = result + "Kill Streak";
    }
    if (APRG_HasExtension4(APRG_EXT4_BOON_HIT_AND_RUN)) {
        if (result != "") { result = result + ", "; }
        result = result + "Hit and Run!";
    }
    if (APRG_HasExtension4(APRG_EXT4_BOON_MEAT_GRINDER)) {
        if (result != "") { result = result + ", "; }
        result = result + "Meat Grinder";
    }
    if (APRG_HasExtension4(APRG_EXT4_BOON_REAPER_BLITZ)) {
        if (result != "") { result = result + ", "; }
        result = result + "Reaper Blitz";
    }
    if (APRG_HasExtension4(APRG_EXT4_BOON_PURIFIER_ALLIANCE)) {
        if (result != "") { result = result + ", "; }
        result = result + "Purifier Alliance";
    }
    if (APRG_HasExtension4(APRG_EXT4_BLESS_RESOURCE_PICKUPS)) {
        if (result != "") { result = result + ", "; }
        result = result + "Resource Pickups";
    }
    if (result == "") { return "None"; }
    return result;
}

void APRG_DisplayActiveEffects(int player) {
    UIDisplayMessage(
        PlayerGroupSingle(player),
        c_messageAreaChat,
        StringToText("[Slay] Mutations: " + APRG_MutationSummary())
    );
    UIDisplayMessage(
        PlayerGroupSingle(player),
        c_messageAreaChat,
        StringToText("[Slay] Blessings: " + APRG_BlessingSummary())
    );
}

int APRG_GetPrimaryPlayer() {
    int p = -1;
    p = PlayerGroupNextPlayer(lib5BD4895D_gv_aP_Core_affectedPlayers, p);
    if (p < 0) {
        return 1;
    }
    return p;
}

bool APRG_IsTownHallType(string unitType) {
    if (unitType == "" || StringContains(unitType, "HiveMindEmulator", c_stringAnywhere, c_stringNoCase)) {
        return false;
    }
    return (
        StringContains(unitType, "CommandCenter", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "OrbitalCommand", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "PlanetaryFortress", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Nexus", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Hatchery", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Lair", c_stringAnywhere, c_stringNoCase) ||
        unitType == "Hive" || unitType == "AP_Hive" ||
        StringContains(unitType, "HiveTownHall", c_stringAnywhere, c_stringNoCase)
    );
}

bool APRG_IsCreepTumorType(string unitType) {
    return unitType != "" && StringContains(unitType, "CreepTumor", c_stringAnywhere, c_stringNoCase);
}

bool APRG_IsScriptedPurifier(unit u) {
    string unitType;
    if (u == null) { return false; }
    // The Slay mutation has its own tracked Purifier. It is an ordinary
    // hostile target, not the invulnerable Safe Haven scripted boss.
    if (u == g_aprgPurifier) { return false; }
    unitType = UnitGetType(u);
    return unitType == "Purifier" || unitType == "AP_Purifier";
}

unitgroup APRG_PlayerStructures(int player) {
    unitgroup result;
    int i;
    unit u;
    result = UnitGroup(
        null,
        player,
        RegionPlayableMap(),
        UnitFilter(
            (1 << c_targetFilterStructure),
            0,
            (1 << c_targetFilterMissile),
            (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))
        ),
        0
    );
    for (i = UnitGroupCount(result, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(result, i);
        if (u != null && APRG_IsCreepTumorType(UnitGetType(u))) { UnitGroupRemove(result, u); }
    }
    return result;
}

unitgroup APRG_EnemyStructures(int player) {
    unitgroup result;
    int i;
    unit u;
    result = UnitGroupAlliance(
        player,
        c_unitAllianceEnemy,
        RegionPlayableMap(),
        UnitFilter(
            (1 << c_targetFilterStructure),
            0,
            (1 << c_targetFilterMissile),
            (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))
        ),
        0
    );
    for (i = UnitGroupCount(result, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(result, i);
        if (u != null && APRG_IsCreepTumorType(UnitGetType(u))) { UnitGroupRemove(result, u); }
    }
    return result;
}

bool APRG_RakShirDuelActive() {
    unitgroup units;
    int i;
    unit u;
    string unitType;
    units = UnitGroup(
        null, c_playerAny, RegionPlayableMap(),
        UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32))), 0
    );
    for (i = UnitGroupCount(units, c_unitCountAll); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null) { continue; }
        unitType = UnitGetType(u);
        if (
            unitType == "DuelBubbleUnit" ||
            StringContains(unitType, "Malash", c_stringAnywhere, c_stringNoCase)
        ) { return true; }
    }
    return false;
}

bool APRG_IsRakShirObjectiveUnit(unit u) {
    string unitType;
    if (u == null) { return false; }
    unitType = UnitGetType(u);
    if (unitType == "DuelBubbleUnit" || StringContains(unitType, "Malash", c_stringAnywhere, c_stringNoCase)) {
        return true;
    }
    if (!StringContains(unitType, "Alarak", c_stringAnywhere, c_stringNoCase)) { return false; }
    if (UnitGetOwner(u) == APRG_GetPrimaryPlayer()) { return true; }
    return APRG_RakShirDuelActive();
}

bool APRG_PointNearRakShirDuel(point p, fixed radius) {
    unitgroup nearby;
    int i;
    unit u;
    string unitType;
    if (p == null) { return false; }
    nearby = UnitGroup(
        null, c_playerAny, RegionCircle(p, radius),
        UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32))), 0
    );
    for (i = UnitGroupCount(nearby, c_unitCountAll); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(nearby, i);
        if (u == null) { continue; }
        unitType = UnitGetType(u);
        if (
            unitType == "DuelBubbleUnit" ||
            StringContains(unitType, "Malash", c_stringAnywhere, c_stringNoCase)
        ) { return true; }
    }
    return false;
}

unit APRG_RandomHostileBaseAnchor(int player) {
    unitgroup hostileStructures;
    unitgroup hostileTownHalls;
    int i;
    unit candidate;
    hostileStructures = APRG_EnemyStructures(player);
    if (UnitGroupCount(hostileStructures, c_unitCountAlive) <= 0) {
        hostileStructures = UnitGroupAlliance(
            player, c_unitAllianceEnemy, RegionPlayableMap(),
            UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0
        );
        if (UnitGroupCount(hostileStructures, c_unitCountAlive) <= 0) { return null; }
    }

    hostileTownHalls = UnitGroupEmpty();
    for (i = UnitGroupCount(hostileStructures, c_unitCountAlive); i > 0; i -= 1) {
        candidate = UnitGroupUnitFromEnd(hostileStructures, i);
        if (candidate != null && APRG_IsTownHallType(UnitGetType(candidate))) {
            UnitGroupAdd(hostileTownHalls, candidate);
        }
    }
    if (UnitGroupCount(hostileTownHalls, c_unitCountAlive) > 0) {
        return UnitGroupRandomUnit(hostileTownHalls, c_unitCountAlive);
    }
    return UnitGroupRandomUnit(hostileStructures, c_unitCountAlive);
}

unitgroup APRG_EnemyMobileUnits(int player) {
    unitgroup result;
    int i;
    unit u;
    string key;
    result = UnitGroupAlliance(
        player,
        c_unitAllianceEnemy,
        RegionPlayableMap(),
        UnitFilter(
            0,
            0,
            (1 << c_targetFilterStructure) | (1 << c_targetFilterMissile),
            (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)) | (1 << (c_targetFilterInvulnerable - 32))
        ),
        0
    );
    for (i = UnitGroupCount(result, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(result, i);
        if (u == null) { continue; }
        if (UnitTestState(u, c_unitStateInvulnerable)) { UnitGroupRemove(result, u); continue; }
        key = "APRG_MineralThief_" + IntToString(UnitGetTag(u));
        if (DataTableGetBool(true, key)) { UnitGroupRemove(result, u); continue; }
        key = "APRG_RaynorRepair_" + IntToString(UnitGetTag(u));
        if (DataTableGetBool(true, key)) { UnitGroupRemove(result, u); continue; }
        if (APRG_IsScriptedPurifier(u)) { UnitGroupRemove(result, u); continue; }
        if (APRG_IsRakShirObjectiveUnit(u)) { UnitGroupRemove(result, u); }
    }
    return result;
}

unitgroup APRG_PlayerWorkers(int player) {
    return UnitGroup(
        null,
        player,
        RegionPlayableMap(),
        UnitFilter(
            (1 << c_targetFilterWorker),
            0,
            (1 << c_targetFilterMissile),
            (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))
        ),
        0
    );
}

int APRG_CountCompletedNonTownHallSupplyProviders(int player) {
    unitgroup owned;
    int i;
    int count = 0;
    unit u;
    string unitType;
    owned = UnitGroup(
        null,
        player,
        RegionPlayableMap(),
        UnitFilter(
            0,
            0,
            (1 << c_targetFilterMissile),
            (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))
        ),
        0
    );
    for (i = UnitGroupCount(owned, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(owned, i);
        if (u == null || !UnitIsAlive(u)) { continue; }
        unitType = UnitGetType(u);
        if (APRG_IsTownHallType(unitType)) { continue; }
        if (UnitTypeGetProperty(unitType, c_unitPropSuppliesMade) <= 0.0) { continue; }
        if (libNtve_gf_UnitIsUnderConstruction(u)) { continue; }
        count += 1;
    }
    return count;
}

void APRG_UpdateMacroBaseReady(int player) {
    unitgroup workers;
    unitgroup structures;
    int mineralsCollected;
    int completedSupplyProviders;
    fixed now;
    if (g_aprgMacroBaseReady && g_aprgMacroPlayer == player) {
        return;
    }

    // Lab Rat begins inside a deliberately tiny gated-off play area.  Do not
    // unlock Slay spawn placement merely because a supply provider has started
    // construction.  Require a NEW, fully completed non-town-hall supply
    // provider, then leave seven additional seconds for the opening area to
    // finish expanding before macro-base effects may choose spawn positions.
    if ((g_aprgMissionFlags & APRG_MISSION_FLAG_LAB_RAT_OPENING) != 0) {
        mineralsCollected = PlayerGetPropertyInt(player, c_playerPropMineralsCollected);
        completedSupplyProviders = APRG_CountCompletedNonTownHallSupplyProviders(player);
        now = GameGetMissionTime();
        if (g_aprgLabRatMineralsCollectedStart < 0) {
            g_aprgLabRatMineralsCollectedStart = mineralsCollected;
            g_aprgLabRatCompletedSupplyProvidersStart = completedSupplyProviders;
            g_aprgLabRatSupplyCompletedTime = -1.0;
            g_aprgMacroReadyTicks = 0;
            return;
        }
        if (completedSupplyProviders <= g_aprgLabRatCompletedSupplyProvidersStart) {
            g_aprgLabRatSupplyCompletedTime = -1.0;
            g_aprgMacroReadyTicks = 0;
            return;
        }
        if (g_aprgLabRatSupplyCompletedTime < 0.0) {
            g_aprgLabRatSupplyCompletedTime = now;
        }
        if (
            mineralsCollected - g_aprgLabRatMineralsCollectedStart < 300 ||
            now < g_aprgLabRatSupplyCompletedTime + 7.0
        ) {
            g_aprgMacroReadyTicks = 0;
            return;
        }
        // The seven-second Lab Rat gate already supplies the stability delay.
        // Prime the shared two-tick gate so the normal worker/structure sanity
        // check can mark the base ready immediately on this update.
        g_aprgMacroReadyTicks = 1;
    }

    workers = APRG_PlayerWorkers(player);
    structures = APRG_PlayerStructures(player);
    if (
        UnitGroupCount(workers, c_unitCountAlive) > 0 &&
        UnitGroupCount(structures, c_unitCountAlive) > 0
    ) {
        g_aprgMacroReadyTicks += 1;
        if (g_aprgMacroReadyTicks >= 2) {
            g_aprgMacroBaseReady = true;
            g_aprgMacroPlayer = player;
            g_aprgMacroReadyTime = GameGetMissionTime();
        }
    }
    else {
        g_aprgMacroReadyTicks = 0;
    }
}

bool APRG_PlayerMacroBaseReady(int player) {
    return g_aprgMacroBaseReady && g_aprgMacroPlayer == player;
}

unit APRG_FindPlayerHomeStructure(int player) {
    unitgroup workers = APRG_PlayerWorkers(player);
    unitgroup structures = APRG_PlayerStructures(player);
    point workerCenter;
    int i;
    unit candidate;
    unit bestTownHall = null;
    fixed distance;
    fixed bestDistance = 999999.0;

    if (UnitGroupCount(structures, c_unitCountAlive) <= 0) { return null; }

    if (UnitGroupCount(workers, c_unitCountAlive) > 0) {
        workerCenter = UnitGroupCenterOfGroup(workers);
    }
    else {
        workerCenter = UnitGetPosition(UnitGroupUnitFromEnd(structures, 1));
    }

    i = UnitGroupCount(structures, c_unitCountAlive);
    for (; i > 0; i -= 1) {
        candidate = UnitGroupUnitFromEnd(structures, i);
        if (candidate == null) { break; }
        if (!APRG_IsTownHallType(UnitGetType(candidate))) { continue; }
        distance = DistanceBetweenPoints(workerCenter, UnitGetPosition(candidate));
        if (bestTownHall == null || distance < bestDistance) {
            bestTownHall = candidate;
            bestDistance = distance;
        }
    }
    if (bestTownHall != null) { return bestTownHall; }
    return UnitGroupClosestToPoint(structures, workerCenter);
}

bool APRG_GroundSpawnsNeedPlayerPathing() {
    return ((g_aprgMissionFlags & APRG_MISSION_FLAG_UNRESTRICTED_GROUND_SPAWNS) == 0);
}

bool APRG_AirSpawnPointAllowed(point candidate) {
    point lo;
    point hi;
    fixed minX;
    fixed minY;
    fixed maxX;
    fixed maxY;
    fixed xCut;
    fixed yCut;
    if (candidate == null) { return false; }
    if ((g_aprgMissionFlags & APRG_MISSION_FLAG_PHANTOMS_AIR_EXCLUSION) == 0) { return true; }
    lo = RegionGetBoundsMin(RegionPlayableMap());
    hi = RegionGetBoundsMax(RegionPlayableMap());
    minX = PointGetX(lo);
    minY = PointGetY(lo);
    maxX = PointGetX(hi);
    maxY = PointGetY(hi);
    xCut = minX + ((maxX - minX) * 0.70);
    yCut = minY + ((maxY - minY) * 0.70);
    return !(PointGetX(candidate) >= xCut && PointGetY(candidate) >= yCut);
}

bool APRG_HostileGroundAnchorConnectedToPlayer(unit anchor, int player) {
    unit home;
    if (anchor == null || !UnitIsAlive(anchor)) { return false; }
    if (!APRG_GroundSpawnsNeedPlayerPathing()) { return true; }
    home = APRG_FindPlayerHomeStructure(player);
    if (home == null || !UnitIsAlive(home)) { return false; }
    return PointPathingIsConnected(UnitGetPosition(anchor), UnitGetPosition(home));
}

unit APRG_RandomPathableHostileBaseAnchor(int player) {
    unitgroup hostileStructures;
    unitgroup connectedTownHalls;
    unitgroup connectedStructures;
    int i;
    unit candidate;
    hostileStructures = APRG_EnemyStructures(player);
    if (UnitGroupCount(hostileStructures, c_unitCountAlive) <= 0) { return null; }
    connectedTownHalls = UnitGroupEmpty();
    connectedStructures = UnitGroupEmpty();
    for (i = UnitGroupCount(hostileStructures, c_unitCountAlive); i > 0; i -= 1) {
        candidate = UnitGroupUnitFromEnd(hostileStructures, i);
        if (candidate == null || !APRG_HostileGroundAnchorConnectedToPlayer(candidate, player)) { continue; }
        UnitGroupAdd(connectedStructures, candidate);
        if (APRG_IsTownHallType(UnitGetType(candidate))) { UnitGroupAdd(connectedTownHalls, candidate); }
    }
    if (UnitGroupCount(connectedTownHalls, c_unitCountAlive) > 0) {
        return UnitGroupRandomUnit(connectedTownHalls, c_unitCountAlive);
    }
    if (UnitGroupCount(connectedStructures, c_unitCountAlive) > 0) {
        return UnitGroupRandomUnit(connectedStructures, c_unitCountAlive);
    }
    return null;
}

void APRG_RegisterAlwaysVisibleUnit(unit u, int player) {
    int i;
    region r;
    revealer rv;
    if (u == null || !UnitIsAlive(u)) { return; }
    for (i = 0; i < g_aprgAlwaysVisibleCount; i += 1) {
        if (g_aprgAlwaysVisibleUnits[i] == u) { return; }
    }
    if (g_aprgAlwaysVisibleCount >= APRG_MAX_ALWAYS_VISIBLE) { return; }
    r = RegionCircle(UnitGetPosition(u), 4.0);
    rv = VisRevealerCreate(player, r);
    g_aprgAlwaysVisibleUnits[g_aprgAlwaysVisibleCount] = u;
    g_aprgAlwaysVisibleRegions[g_aprgAlwaysVisibleCount] = r;
    g_aprgAlwaysVisibleRevealers[g_aprgAlwaysVisibleCount] = rv;
    g_aprgAlwaysVisibleCount += 1;
}

void APRG_RegisterAlwaysVisibleGroup(unitgroup units, int player) {
    int i;
    unit u;
    if (units == null) { return; }
    for (i = UnitGroupCount(units, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u != null) { APRG_RegisterAlwaysVisibleUnit(u, player); }
    }
}

void APRG_TickAlwaysVisibleUnits() {
    int i;
    unit u;
    region r;
    revealer rv;
    for (i = 0; i < g_aprgAlwaysVisibleCount; i += 1) {
        u = g_aprgAlwaysVisibleUnits[i];
        r = g_aprgAlwaysVisibleRegions[i];
        rv = g_aprgAlwaysVisibleRevealers[i];
        if (u == null || !UnitIsAlive(u) || r == null || rv == null) { continue; }
        RegionSetCenter(r, UnitGetPosition(u));
        VisRevealerUpdate(rv);
    }
}

unit APRG_NearestPlayerStructure(point fromPoint, int player) {
    unitgroup structures = APRG_PlayerStructures(player);
    if (UnitGroupCount(structures, c_unitCountAlive) <= 0) {
        return null;
    }
    return UnitGroupClosestToPoint(structures, fromPoint);
}

point APRG_FindGroundPointNear(point anchor, fixed minRadius, fixed maxRadius) {
    int attempt;
    point candidate;

    for (attempt = 0; attempt < APRG_MAX_POINT_ATTEMPTS; attempt += 1) {
        candidate = PointWithOffsetPolar(anchor, RandomFixed(minRadius, maxRadius), libNtve_gf_RandomAngle());
        if (
            RegionContainsPoint(RegionPlayableMap(), candidate) &&
            PointPathingPassable(candidate) &&
            !APRG_PointNearRakShirDuel(candidate, 24.0)
        ) {
            return candidate;
        }
    }
    return null;
}

bool APRG_PointNearMineralField(point p, fixed radius) {
    unitgroup nearby;
    int i;
    unit u;
    string unitType;
    string resourceType;
    if (p == null) { return false; }
    nearby = UnitGroup(
        null, c_playerAny, RegionCircle(p, radius),
        UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0
    );
    for (i = UnitGroupCount(nearby, c_unitCountAll); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(nearby, i);
        if (u == null) { continue; }
        unitType = UnitGetType(u);
        resourceType = CatalogFieldValueGet(c_gameCatalogUnit, unitType, "ResourceType", c_playerAny);
        if (resourceType == "Minerals" || StringContains(unitType, "Mineral", c_stringAnywhere, c_stringNoCase)) { return true; }
    }
    return false;
}

bool APRG_PointNearResourceField(point p, fixed radius) {
    unitgroup nearby;
    int i;
    unit u;
    string unitType;
    string resourceType;
    if (p == null) { return false; }
    nearby = UnitGroup(
        null, c_playerAny, RegionCircle(p, radius),
        UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0
    );
    for (i = UnitGroupCount(nearby, c_unitCountAll); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(nearby, i);
        if (u == null) { continue; }
        unitType = UnitGetType(u);
        resourceType = CatalogFieldValueGet(c_gameCatalogUnit, unitType, "ResourceType", c_playerAny);
        if (
            resourceType == "Minerals" || resourceType == "Vespene" ||
            StringContains(unitType, "Mineral", c_stringAnywhere, c_stringNoCase) ||
            StringContains(unitType, "Vespene", c_stringAnywhere, c_stringNoCase) ||
            StringContains(unitType, "Geyser", c_stringAnywhere, c_stringNoCase) ||
            StringContains(unitType, "Refinery", c_stringAnywhere, c_stringNoCase) ||
            StringContains(unitType, "Assimilator", c_stringAnywhere, c_stringNoCase) ||
            StringContains(unitType, "Extractor", c_stringAnywhere, c_stringNoCase)
        ) { return true; }
    }
    return false;
}

point APRG_PlayerBuildingSpawnPoint(int player, point preferred, fixed minRadius, fixed maxRadius) {
    int attempt;
    point candidate;
    point bestPoint = null;
    unit nearestStructure;
    fixed score;
    fixed bestScore = 999999.0;
    if (preferred == null) { return null; }

    // Do not accept the first legal tile. Sample the whole bounded search and
    // prefer a spot embedded in the player's base while strongly avoiding the
    // mineral/gas footprint. This is shared by Slay-created player buildings.
    for (attempt = 0; attempt < APRG_MAX_POINT_ATTEMPTS; attempt += 1) {
        candidate = PointWithOffsetPolar(preferred, RandomFixed(minRadius, maxRadius), libNtve_gf_RandomAngle());
        if (candidate == null || !RegionContainsPoint(RegionPlayableMap(), candidate)) { continue; }
        if (!PointPathingPassable(candidate)) { continue; }
        if (APRG_PointNearResourceField(candidate, 7.0)) { continue; }

        nearestStructure = APRG_NearestPlayerStructure(candidate, player);
        if (nearestStructure != null) {
            score = DistanceBetweenPoints(candidate, UnitGetPosition(nearestStructure));
        }
        else {
            score = DistanceBetweenPoints(candidate, preferred);
        }
        // A candidate just outside the hard exclusion is legal but undesirable.
        // Keep it as a last resort instead of failing to spawn on cramped maps.
        if (APRG_PointNearResourceField(candidate, 12.0)) { score += 100.0; }
        score += DistanceBetweenPoints(candidate, preferred) * 0.10;
        if (bestPoint == null || score < bestScore) {
            bestPoint = candidate;
            bestScore = score;
        }
    }
    return bestPoint;
}

point APRG_PlayerSafeSpawnPoint(int player, point preferred) {
    int attempt;
    point candidate;
    point bestPoint;
    unitgroup playerStructures;
    unitgroup playerUnits;
    unit nearestStructure;
    unit nearestUnit;
    fixed nearestFriendlyDistance;
    fixed candidateDistance;
    fixed score;
    fixed bestScore;
    if (preferred == null) { return null; }
    if (RegionContainsPoint(RegionPlayableMap(), preferred) && PointPathingPassable(preferred) && !APRG_PointNearMineralField(preferred, 4.0)) {
        return preferred;
    }

    playerStructures = APRG_PlayerStructures(player);
    playerUnits = UnitGroup(
        null,
        player,
        RegionPlayableMap(),
        UnitFilter(
            0,
            0,
            (1 << c_targetFilterStructure) | (1 << c_targetFilterMissile),
            (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))
        ),
        0
    );
    bestPoint = null;
    bestScore = 999999.0;
    for (attempt = 0; attempt < 64; attempt += 1) {
        candidate = PointWithOffsetPolar(preferred, RandomFixed(3.0, 12.0), libNtve_gf_RandomAngle());
        if (candidate == null || !RegionContainsPoint(RegionPlayableMap(), candidate) || !PointPathingPassable(candidate)) { continue; }
        if (APRG_PointNearMineralField(candidate, 4.0)) { continue; }

        nearestFriendlyDistance = 999999.0;
        nearestStructure = UnitGroupClosestToPoint(playerStructures, candidate);
        if (nearestStructure != null) {
            nearestFriendlyDistance = DistanceBetweenPoints(candidate, UnitGetPosition(nearestStructure));
        }
        nearestUnit = UnitGroupClosestToPoint(playerUnits, candidate);
        if (nearestUnit != null) {
            candidateDistance = DistanceBetweenPoints(candidate, UnitGetPosition(nearestUnit));
            if (candidateDistance < nearestFriendlyDistance) { nearestFriendlyDistance = candidateDistance; }
        }
        score = nearestFriendlyDistance + 0.25 * DistanceBetweenPoints(candidate, preferred);
        if (score < bestScore) {
            bestScore = score;
            bestPoint = candidate;
        }
    }
    if (bestPoint != null) { return bestPoint; }
    return preferred;
}

fixed APRG_PlayerSpawnLifeMax(string unitType) {
    if (unitType == "" || !CatalogEntryIsValid(c_gameCatalogUnit, unitType)) { return 0.0; }
    return UnitTypeGetProperty(unitType, c_unitPropLifeMax);
}

bool APRG_PlayerSpawnCandidateHealthy(int player, string unitType, bool requireAllowed) {
    if (unitType == "" || !CatalogEntryIsValid(c_gameCatalogUnit, unitType)) { return false; }
    if (APRG_PlayerSpawnLifeMax(unitType) <= 3.0) { return false; }
    if (requireAllowed && !TechTreeUnitIsAllowed(player, unitType)) { return false; }
    return true;
}

bool APRG_PlayerSpawnSameCatalogIdentity(int player, string nativeType, string candidateType) {
    string directType;
    if (nativeType == "" || candidateType == "") { return false; }
    if (StringFind(candidateType, "AP_", c_stringCase) != 1) { return false; }

    directType = "AP_" + nativeType;
    return candidateType == directType || StringFind(candidateType, directType, c_stringCase) == 1;
}

bool APRG_PlayerSpawnStateTokenMatches(string nativeType, string candidateType, string token) {
    return (
        StringContains(nativeType, token, c_stringAnywhere, c_stringNoCase) ==
        StringContains(candidateType, token, c_stringAnywhere, c_stringNoCase)
    );
}

bool APRG_PlayerSpawnSamePosture(int player, string nativeType, string candidateType) {
    fixed nativeSpeed;
    fixed candidateSpeed;
    if (nativeType == "" || candidateType == "") { return false; }

    if (!APRG_PlayerSpawnStateTokenMatches(nativeType, candidateType, "Burrowed")) { return false; }
    if (!APRG_PlayerSpawnStateTokenMatches(nativeType, candidateType, "Phasing")) { return false; }
    if (!APRG_PlayerSpawnStateTokenMatches(nativeType, candidateType, "Phased")) { return false; }
    if (!APRG_PlayerSpawnStateTokenMatches(nativeType, candidateType, "Sieged")) { return false; }
    if (!APRG_PlayerSpawnStateTokenMatches(nativeType, candidateType, "Rooted")) { return false; }
    if (!APRG_PlayerSpawnStateTokenMatches(nativeType, candidateType, "Uprooted")) { return false; }
    if (!APRG_PlayerSpawnStateTokenMatches(nativeType, candidateType, "Wreckage")) { return false; }
    if (!APRG_PlayerSpawnStateTokenMatches(nativeType, candidateType, "Cocoon")) { return false; }
    if (!APRG_PlayerSpawnStateTokenMatches(nativeType, candidateType, "Egg")) { return false; }
    if (!APRG_PlayerSpawnStateTokenMatches(nativeType, candidateType, "Chrysalis")) { return false; }
    if (!APRG_PlayerSpawnStateTokenMatches(nativeType, candidateType, "Placement")) { return false; }
    if (!APRG_PlayerSpawnStateTokenMatches(nativeType, candidateType, "Wreck")) { return false; }

    nativeSpeed = UnitTypeGetProperty(nativeType, c_unitPropMovementSpeed);
    candidateSpeed = UnitTypeGetProperty(candidateType, c_unitPropMovementSpeed);
    if (nativeSpeed > 0.05 && candidateSpeed <= 0.05) { return false; }
    return true;
}

bool APRG_PlayerSpawnProductionAbility(string abilityType) {
    string scope;
    if (abilityType == "" || !CatalogEntryIsValid(c_gameCatalogAbil, abilityType)) { return false; }
    scope = CatalogEntryScope(c_gameCatalogAbil, abilityType);
    return (
        StringContains(scope, "CAbilTrain", c_stringAnywhere, c_stringNoCase) ||
        StringContains(scope, "CAbilWarpTrain", c_stringAnywhere, c_stringNoCase) ||
        StringContains(scope, "CAbilMorph", c_stringAnywhere, c_stringNoCase)
    );
}

int APRG_PlayerSpawnProductionPriority(string abilityType) {
    string scope;
    if (abilityType == "" || !CatalogEntryIsValid(c_gameCatalogAbil, abilityType)) { return 0; }
    scope = CatalogEntryScope(c_gameCatalogAbil, abilityType);
    if (
        StringContains(scope, "CAbilTrain", c_stringAnywhere, c_stringNoCase) ||
        StringContains(scope, "CAbilWarpTrain", c_stringAnywhere, c_stringNoCase)
    ) { return 30; }
    if (StringContains(scope, "CAbilMorph", c_stringAnywhere, c_stringNoCase)) { return 5; }
    return 0;
}

bool APRG_PlayerSpawnSameUnitShape(int player, string nativeType, string candidateType) {
    bool nativeStructure;
    bool candidateStructure;
    string nativeRace;
    string candidateRace;
    string nativeAir;
    string candidateAir;
    if (
        nativeType == "" || candidateType == "" ||
        !CatalogEntryIsValid(c_gameCatalogUnit, nativeType) ||
        !CatalogEntryIsValid(c_gameCatalogUnit, candidateType)
    ) { return false; }

    nativeStructure = UnitTypeTestAttribute(nativeType, c_unitAttributeStructure);
    candidateStructure = UnitTypeTestAttribute(candidateType, c_unitAttributeStructure);
    if (nativeStructure != candidateStructure) { return false; }

    nativeRace = CatalogFieldValueGet(c_gameCatalogUnit, nativeType, "Race", player);
    candidateRace = CatalogFieldValueGet(c_gameCatalogUnit, candidateType, "Race", player);
    if (nativeRace != "" && candidateRace != "" && nativeRace != candidateRace) { return false; }

    nativeAir = CatalogFieldValueGet(c_gameCatalogUnit, nativeType, "PlaneArray[Air]", player);
    candidateAir = CatalogFieldValueGet(c_gameCatalogUnit, candidateType, "PlaneArray[Air]", player);
    if (nativeAir != "" && candidateAir != "" && nativeAir != candidateAir) { return false; }
    return true;
}

int APRG_PlayerSpawnFamilyScore(int player, string nativeType, string candidateType) {
    string directType;
    int score;
    if (nativeType == "" || candidateType == "") { return 0; }
    if (!APRG_PlayerSpawnSameUnitShape(player, nativeType, candidateType)) { return 0; }
    if (!APRG_PlayerSpawnSameCatalogIdentity(player, nativeType, candidateType)) { return 0; }
    if (!APRG_PlayerSpawnSamePosture(player, nativeType, candidateType)) { return 0; }

    directType = "AP_" + nativeType;
    if (candidateType == directType) { return 200; }

    score = 100;
    if (StringContains(candidateType, "Aiur", c_stringAnywhere, c_stringNoCase)) { score += 25; }
    return score;
}

string APRG_FindPlayerAPProductionVariant(int player, string nativeType) {
    int abilityCount;
    int abilityIndex;
    int infoCount;
    int infoIndex;
    int unitCount;
    int unitIndex;
    int score;
    int bestScore;
    string abilityType;
    string basePath;
    string candidateType;
    string bestType;
    string cacheKey;
    string cached;
    if (nativeType == "" || player <= 0) { return ""; }

    cacheKey = "APRG_APSpawnVariant_" + IntToString(player) + "_" + nativeType;
    cached = DataTableGetString(true, cacheKey);
    if (
        cached != "" &&
        APRG_PlayerSpawnCandidateHealthy(player, cached, true) &&
        APRG_PlayerSpawnFamilyScore(player, nativeType, cached) > 0
    ) { return cached; }

    bestType = "";
    bestScore = 0;
    abilityCount = CatalogEntryCount(c_gameCatalogAbil);
    for (abilityIndex = 1; abilityIndex <= abilityCount; abilityIndex += 1) {
        abilityType = CatalogEntryGet(c_gameCatalogAbil, abilityIndex);
        if (!APRG_PlayerSpawnProductionAbility(abilityType)) { continue; }
        infoCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, "InfoArray", player);
        for (infoIndex = 0; infoIndex < infoCount; infoIndex += 1) {
            basePath = "InfoArray[" + IntToString(infoIndex) + "]";

            candidateType = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, basePath + ".Unit", player);
            if (APRG_PlayerSpawnCandidateHealthy(player, candidateType, true)) {
                score = APRG_PlayerSpawnFamilyScore(player, nativeType, candidateType);
                if (score > 0) { score += APRG_PlayerSpawnProductionPriority(abilityType); }
                if (score > bestScore) { bestScore = score; bestType = candidateType; }
            }
            unitCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, basePath + ".Unit", player);
            for (unitIndex = 0; unitIndex < unitCount; unitIndex += 1) {
                candidateType = CatalogFieldValueGet(
                    c_gameCatalogAbil,
                    abilityType,
                    basePath + ".Unit[" + IntToString(unitIndex) + "]",
                    player
                );
                if (!APRG_PlayerSpawnCandidateHealthy(player, candidateType, true)) { continue; }
                score = APRG_PlayerSpawnFamilyScore(player, nativeType, candidateType);
                if (score > 0) { score += APRG_PlayerSpawnProductionPriority(abilityType); }
                if (score > bestScore) { bestScore = score; bestType = candidateType; }
            }
        }
    }
    if (bestType != "") { DataTableSetString(true, cacheKey, bestType); }
    return bestType;
}

string APRG_PlayerSpawnCatalogTypeForPlayer(string unitType, int player) {
    string apType;
    if (unitType == "") { return unitType; }

    if (
        StringContains(unitType, "AP_", c_stringAnywhere, c_stringCase) &&
        APRG_PlayerSpawnCandidateHealthy(player, unitType, false)
    ) { return unitType; }

    apType = APRG_FindPlayerAPProductionVariant(player, unitType);
    if (apType != "") { return apType; }

    return unitType;
}

string APRG_PlayerSpawnCatalogType(string unitType) {
    return APRG_PlayerSpawnCatalogTypeForPlayer(unitType, APRG_GetPrimaryPlayer());
}

unitgroup APRG_CreatePlayerUnitsAtPoint(int count, string unitType, int player, point p, fixed facing) {
    string spawnType;
    unitgroup created;
    unit probe;
    int i;
    if (p == null) { return UnitGroupEmpty(); }
    spawnType = APRG_PlayerSpawnCatalogTypeForPlayer(unitType, player);
    created = UnitCreate(count, spawnType, c_unitCreateIgnorePlacement, player, p, facing);

    if (spawnType != unitType) {
        probe = UnitGroupUnitFromEnd(created, 1);
        if (
            probe == null ||
            UnitGetPropertyFixed(probe, c_unitPropLifeMax, c_unitPropCurrent) <= 3.0
        ) {
            for (i = UnitGroupCount(created, c_unitCountAll); i > 0; i -= 1) {
                probe = UnitGroupUnitFromEnd(created, i);
                if (probe != null) { UnitRemove(probe); }
            }
            created = UnitCreate(count, unitType, c_unitCreateIgnorePlacement, player, p, facing);
        }
    }
    return created;
}

unitgroup APRG_CreatePlayerUnitsSafe(int count, string unitType, int player, point preferred, fixed facing) {
    point safePoint;
    safePoint = APRG_PlayerSafeSpawnPoint(player, preferred);
    return APRG_CreatePlayerUnitsAtPoint(count, unitType, player, safePoint, facing);
}

unitgroup APRG_CreatePlayerUnitsVanillaSafe(int count, string unitType, int player, point preferred, fixed facing) {
    point safePoint;
    safePoint = APRG_PlayerSafeSpawnPoint(player, preferred);
    return UnitCreate(count, unitType, c_unitCreateIgnorePlacement, player, safePoint, facing);
}

unitgroup APRG_CreatePreferredPlayerUnitsSafe(int count, string preferredType, string nativeFallback, int player, point preferred, fixed facing) {
    point safePoint;
    unitgroup created;
    unit probe;
    int i;
    string spawnType;
    spawnType = nativeFallback;
    if (APRG_PlayerSpawnCandidateHealthy(player, preferredType, false)) {
        spawnType = preferredType;
    }
    safePoint = APRG_PlayerSafeSpawnPoint(player, preferred);
    if (safePoint == null) { return UnitGroupEmpty(); }
    created = UnitCreate(count, spawnType, c_unitCreateIgnorePlacement, player, safePoint, facing);
    if (spawnType != nativeFallback) {
        probe = UnitGroupUnitFromEnd(created, 1);
        if (probe == null || UnitGetPropertyFixed(probe, c_unitPropLifeMax, c_unitPropCurrent) <= 3.0) {
            for (i = UnitGroupCount(created, c_unitCountAll); i > 0; i -= 1) {
                probe = UnitGroupUnitFromEnd(created, i);
                if (probe != null) { UnitRemove(probe); }
            }
            created = UnitCreate(count, nativeFallback, c_unitCreateIgnorePlacement, player, safePoint, facing);
        }
    }
    return created;
}

point APRG_FindRaidOriginAirPoint(int player) {
    unitgroup hostileStructures = APRG_EnemyStructures(player);
    int hostileCount = UnitGroupCount(hostileStructures, c_unitCountAlive);
    int attempt;
    unit anchor;
    unit nearestPlayerStructure;
    point candidate;

    for (attempt = 0; attempt < APRG_MAX_POINT_ATTEMPTS; attempt += 1) {
        anchor = APRG_RandomHostileBaseAnchor(player);
        if (anchor == null) { break; }
        candidate = PointWithOffsetPolar(UnitGetPosition(anchor), RandomFixed(8.0, 18.0), libNtve_gf_RandomAngle());
        if (!RegionContainsPoint(RegionPlayableMap(), candidate) || !APRG_AirSpawnPointAllowed(candidate) || APRG_PointNearRakShirDuel(candidate, 24.0)) {
            continue;
        }
        nearestPlayerStructure = APRG_NearestPlayerStructure(candidate, player);
        if (nearestPlayerStructure == null || DistanceBetweenPoints(candidate, UnitGetPosition(nearestPlayerStructure)) >= 30.0) {
            return candidate;
        }
    }
    for (attempt = 0; attempt < APRG_MAX_POINT_ATTEMPTS; attempt += 1) {
        candidate = RegionRandomPoint(RegionPlayableMap());
        if (candidate == null || !APRG_AirSpawnPointAllowed(candidate) || APRG_PointNearRakShirDuel(candidate, 24.0)) { continue; }
        nearestPlayerStructure = APRG_NearestPlayerStructure(candidate, player);
        if (nearestPlayerStructure == null || DistanceBetweenPoints(candidate, UnitGetPosition(nearestPlayerStructure)) >= 20.0) { return candidate; }
    }
    return null;
}

point APRG_FindRaidOriginGroundPoint(int player) {
    int attempt;
    unit anchor;
    unit home;
    unit nearestPlayerStructure;
    point candidate;
    home = APRG_FindPlayerHomeStructure(player);
    if (home == null) { return null; }

    for (attempt = 0; attempt < APRG_MAX_POINT_ATTEMPTS; attempt += 1) {
        anchor = APRG_RandomPathableHostileBaseAnchor(player);
        if (anchor == null) { break; }
        candidate = PointWithOffsetPolar(UnitGetPosition(anchor), RandomFixed(8.0, 18.0), libNtve_gf_RandomAngle());
        if (!RegionContainsPoint(RegionPlayableMap(), candidate) || !PointPathingPassable(candidate)) { continue; }
        if (APRG_GroundSpawnsNeedPlayerPathing() && !PointPathingIsConnected(candidate, UnitGetPosition(home))) { continue; }
        nearestPlayerStructure = APRG_NearestPlayerStructure(candidate, player);
        if (nearestPlayerStructure == null || DistanceBetweenPoints(candidate, UnitGetPosition(nearestPlayerStructure)) >= 30.0) {
            return candidate;
        }
    }
    for (attempt = 0; attempt < APRG_MAX_POINT_ATTEMPTS; attempt += 1) {
        candidate = RegionRandomPoint(RegionPlayableMap());
        if (candidate == null || !PointPathingPassable(candidate)) { continue; }
        if (APRG_GroundSpawnsNeedPlayerPathing() && !PointPathingIsConnected(candidate, UnitGetPosition(home))) { continue; }
        nearestPlayerStructure = APRG_NearestPlayerStructure(candidate, player);
        if (nearestPlayerStructure == null || DistanceBetweenPoints(candidate, UnitGetPosition(nearestPlayerStructure)) >= 20.0) { return candidate; }
    }
    return null;
}


point APRG_FindHeroPatrolOrigin(int player) {
    unitgroup hostileStructures = APRG_EnemyStructures(player);
    int hostileCount = UnitGroupCount(hostileStructures, c_unitCountAlive);
    int attempt;
    unit anchor;
    unit home;
    unit nearestPlayerStructure;
    point candidate;
    home = APRG_FindPlayerHomeStructure(player);
    if (home == null) { return null; }

    if (hostileCount > 0) {
        for (attempt = 0; attempt < APRG_MAX_POINT_ATTEMPTS; attempt += 1) {
            anchor = APRG_RandomHostileBaseAnchor(player);
            if (anchor == null) { break; }
            candidate = PointWithOffsetPolar(UnitGetPosition(anchor), RandomFixed(4.0, 22.0), libNtve_gf_RandomAngle());
            if (!RegionContainsPoint(RegionPlayableMap(), candidate) || !PointPathingPassable(candidate)) { continue; }
            if (APRG_GroundSpawnsNeedPlayerPathing() && !PointPathingIsConnected(candidate, UnitGetPosition(home))) { continue; }
            nearestPlayerStructure = APRG_NearestPlayerStructure(candidate, player);
            if (nearestPlayerStructure == null || DistanceBetweenPoints(candidate, UnitGetPosition(nearestPlayerStructure)) >= 14.0) {
                return candidate;
            }
        }
    }
    for (attempt = 0; attempt < APRG_MAX_POINT_ATTEMPTS; attempt += 1) {
        candidate = RegionRandomPoint(RegionPlayableMap());
        if (candidate == null || !PointPathingPassable(candidate)) { continue; }
        if (APRG_GroundSpawnsNeedPlayerPathing() && !PointPathingIsConnected(candidate, UnitGetPosition(home))) { continue; }
        nearestPlayerStructure = APRG_NearestPlayerStructure(candidate, player);
        if (nearestPlayerStructure == null || DistanceBetweenPoints(candidate, UnitGetPosition(nearestPlayerStructure)) >= 14.0) { return candidate; }
    }
    return null;
}

point APRG_FindStaticPatrolAirPoint(int player) {
    int attempt;
    unit nearestPlayerStructure;
    point candidate;
    for (attempt = 0; attempt < APRG_MAX_POINT_ATTEMPTS; attempt += 1) {
        candidate = RegionRandomPoint(RegionPlayableMap());
        if (candidate == null || !APRG_AirSpawnPointAllowed(candidate) || APRG_PointNearRakShirDuel(candidate, 24.0)) { continue; }
        nearestPlayerStructure = APRG_NearestPlayerStructure(candidate, player);
        if (nearestPlayerStructure == null || DistanceBetweenPoints(candidate, UnitGetPosition(nearestPlayerStructure)) >= 8.0) {
            return candidate;
        }
    }
    return null;
}

point APRG_FindStaticPatrolGroundPoint(int player);

bool APRG_PatrolPointFarEnough(point candidate, fixed minDistance) {
    int i;
    if (candidate == null) { return false; }
    for (i = 0; i < g_aprgFixedPatrolPointCount; i += 1) {
        if (g_aprgFixedPatrolPoints[i] != null && DistanceBetweenPoints(candidate, g_aprgFixedPatrolPoints[i]) < minDistance) {
            return false;
        }
    }
    return true;
}

void APRG_CacheFixedPatrolPoints(int player) {
    unitgroup hostileStructures;
    int i;
    int attempt;
    unit anchor;
    point candidate;
    unit nearestPlayerStructure;
    g_aprgFixedPatrolPointCount = 0;
    hostileStructures = APRG_EnemyStructures(player);

    for (i = UnitGroupCount(hostileStructures, c_unitCountAlive); i > 0 && g_aprgFixedPatrolPointCount < 6; i -= 1) {
        anchor = UnitGroupUnitFromEnd(hostileStructures, i);
        if (anchor == null) { continue; }
        candidate = PointWithOffsetPolar(UnitGetPosition(anchor), RandomFixed(7.0, 15.0), libNtve_gf_RandomAngle());
        if (candidate == null || !RegionContainsPoint(RegionPlayableMap(), candidate) || !PointPathingPassable(candidate)) { continue; }
        if (!APRG_PatrolPointFarEnough(candidate, 12.0)) { continue; }
        g_aprgFixedPatrolPoints[g_aprgFixedPatrolPointCount] = candidate;
        g_aprgFixedPatrolPointCount += 1;
    }

    for (attempt = 0; attempt < APRG_MAX_POINT_ATTEMPTS && g_aprgFixedPatrolPointCount < 6; attempt += 1) {
        candidate = RegionRandomPoint(RegionPlayableMap());
        if (candidate == null || !PointPathingPassable(candidate) || APRG_PointNearRakShirDuel(candidate, 24.0)) { continue; }
        nearestPlayerStructure = APRG_NearestPlayerStructure(candidate, player);
        if (nearestPlayerStructure != null && DistanceBetweenPoints(candidate, UnitGetPosition(nearestPlayerStructure)) < 12.0) { continue; }
        if (!APRG_PatrolPointFarEnough(candidate, 12.0)) { continue; }
        g_aprgFixedPatrolPoints[g_aprgFixedPatrolPointCount] = candidate;
        g_aprgFixedPatrolPointCount += 1;
    }
}

point APRG_RandomFixedPatrolPoint(int player, bool requireGround) {
    int attempt;
    point candidate;
    if (g_aprgFixedPatrolPointCount <= 0) {
        if (requireGround) { return APRG_FindStaticPatrolGroundPoint(player); }
        return APRG_FindStaticPatrolAirPoint(player);
    }
    for (attempt = 0; attempt < g_aprgFixedPatrolPointCount; attempt += 1) {
        candidate = g_aprgFixedPatrolPoints[RandomInt(0, g_aprgFixedPatrolPointCount - 1)];
        if (candidate != null && (!requireGround || PointPathingPassable(candidate))) { return candidate; }
    }
    if (requireGround) { return APRG_FindStaticPatrolGroundPoint(player); }
    return APRG_FindStaticPatrolAirPoint(player);
}

point APRG_RandomFixedPatrolPointForUnit(unit u, int player, bool requireGround) {
    int attempt;
    point origin;
    point candidate;
    unit nearestPlayerStructure;
    if (u == null) { return APRG_RandomFixedPatrolPoint(player, requireGround); }
    origin = UnitGetPosition(u);
    if (!requireGround || origin == null || !PointPathingPassable(origin)) {
        return APRG_RandomFixedPatrolPoint(player, requireGround);
    }
    for (attempt = 0; attempt < g_aprgFixedPatrolPointCount * 2; attempt += 1) {
        candidate = g_aprgFixedPatrolPoints[RandomInt(0, g_aprgFixedPatrolPointCount - 1)];
        if (candidate == null || !PointPathingPassable(candidate)) { continue; }
        if (PointPathingIsConnected(origin, candidate)) { return candidate; }
    }
    for (attempt = 0; attempt < APRG_MAX_POINT_ATTEMPTS; attempt += 1) {
        candidate = RegionRandomPoint(RegionPlayableMap());
        if (candidate == null || !PointPathingPassable(candidate) || APRG_PointNearRakShirDuel(candidate, 24.0)) { continue; }
        if (!PointPathingIsConnected(origin, candidate)) { continue; }
        nearestPlayerStructure = APRG_NearestPlayerStructure(candidate, player);
        if (nearestPlayerStructure != null && DistanceBetweenPoints(candidate, UnitGetPosition(nearestPlayerStructure)) < 8.0) { continue; }
        return candidate;
    }
    return null;
}

int APRG_FindFallbackHostilePlayer(int player) {
    int candidate;
    for (candidate = 1; candidate <= 16; candidate += 1) {
        if (candidate != player && libNtve_gf_PlayerIsEnemy(candidate, player, libNtve_ge_PlayerRelation_Enemy)) {
            return candidate;
        }
    }
    return -1;
}

int APRG_FindHostileOwnerNearPoint(int player, point p) {
    unitgroup hostiles;
    unit anchor;
    hostiles = APRG_EnemyStructures(player);
    if (UnitGroupCount(hostiles, c_unitCountAlive) <= 0) {
        hostiles = UnitGroupAlliance(
            player, c_unitAllianceEnemy, RegionPlayableMap(),
            UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0
        );
    }
    if (UnitGroupCount(hostiles, c_unitCountAlive) <= 0) { return APRG_FindFallbackHostilePlayer(player); }
    anchor = UnitGroupClosestToPoint(hostiles, p);
    if (anchor == null) { return APRG_FindFallbackHostilePlayer(player); }
    return UnitGetOwner(anchor);
}

unit APRG_NearestPathablePlayerStructure(unit mover, int player);
unit APRG_NearestPathablePlayerStructureFromGroup(unit mover, int player, unitgroup structures);
unit APRG_NearestPathableEnemyStructure(unit mover, int player);
unit APRG_NearestPathableEnemyStructureFromGroup(unit mover, int player, unitgroup structures);
unit APRG_RandomPlayerStructure(int player);
void APRG_StripVoidEntityGroup(unitgroup group);
void APRG_RegisterMutationEnemyGroup(unitgroup group);

bool APRG_OrderStandardMove(unit mover, point destination) {
    order moveOrder;
    if (mover == null || !UnitIsAlive(mover) || destination == null) { return false; }
    moveOrder = OrderTargetingPoint(AbilityCommand("move", 0), destination);
    if (!UnitOrderIsValid(mover, moveOrder)) { return false; }
    UnitIssueOrder(mover, moveOrder, c_orderQueueReplace);
    return true;
}

bool APRG_OrderAttackMove(unit mover, point destination) {
    order attackOrder;
    if (mover == null || !UnitIsAlive(mover) || destination == null) { return false; }
    attackOrder = OrderTargetingPoint(AbilityCommand("attack", 0), destination);
    if (UnitOrderIsValid(mover, attackOrder)) {
        UnitIssueOrder(mover, attackOrder, c_orderQueueReplace);
        return true;
    }
    // Healers and other weaponless support units still travel with the combat group.
    return APRG_OrderStandardMove(mover, destination);
}

bool APRG_OrderAttackPlayer(unit mover, int player) {
    unit target;
    if (mover == null || !UnitIsAlive(mover)) { return false; }
    target = APRG_NearestPathablePlayerStructure(mover, player);
    if (target == null) { target = APRG_RandomPlayerStructure(player); }
    if (target == null) { return false; }
    return APRG_OrderAttackMove(mover, UnitGetPosition(target));
}

bool APRG_OrderPatrolMap(unit mover, int player, bool requireGround) {
    point destination;
    if (mover == null || !UnitIsAlive(mover)) { return false; }
    destination = APRG_RandomFixedPatrolPointForUnit(mover, player, requireGround);
    if (destination == null) { return false; }
    return APRG_OrderAttackMove(mover, destination);
}

void APRG_OrderGroupTowardNearestPlayerStructure(unitgroup group, point fromPoint, int player) {
    int i;
    unit mover;
    unit target;
    if (group == null || UnitGroupCount(group, c_unitCountAlive) <= 0) { return; }
    for (i = UnitGroupCount(group, c_unitCountAlive); i > 0; i -= 1) {
        mover = UnitGroupUnitFromEnd(group, i);
        if (mover == null || !UnitIsAlive(mover)) { continue; }
        APRG_OrderAttackPlayer(mover, player);
    }
}

void APRG_ApplyLowQualityMinerals() {
    unitgroup resources;
    int i;
    unit u;
    int amount;

    if (g_aprgLowQualityApplied) {
        return;
    }
    g_aprgLowQualityApplied = true;

    resources = UnitGroup(
        null,
        c_playerAny,
        RegionPlayableMap(),
        UnitFilter(
            (1 << c_targetFilterHarvestableResource),
            0,
            (1 << c_targetFilterMissile),
            (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))
        ),
        0
    );

    i = UnitGroupCount(resources, c_unitCountAlive);
    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(resources, i);
        if (u == null) {
            break;
        }
        if (CatalogFieldValueGet(c_gameCatalogUnit, UnitGetType(u), "ResourceType", c_playerAny) == "Minerals") {
            amount = UnitGetPropertyInt(u, c_unitPropResources, c_unitPropCurrent);
            if (amount > 0) {
                UnitSetPropertyInt(u, c_unitPropResources, amount / 2);
            }
        }
    }
}

fixed APRG_CongaRatePerMinute(fixed missionTime) {
    fixed accelerationMinutes = (missionTime - 120.0) / 60.0;
    if (accelerationMinutes < 0.0) {
        accelerationMinutes = 0.0;
    }
    return 2.0 + (2.0 * accelerationMinutes);
}

fixed APRG_CongaNextInterval(fixed missionTime) {
    fixed interval = 60.0 / APRG_CongaRatePerMinute(missionTime);
    interval *= RandomFixed(0.8, 1.2);
    if (interval < 0.25) {
        interval = 0.25;
    }
    return interval;
}

int APRG_FindCongaSource(unit base) {
    int i;
    for (i = 0; i < APRG_MAX_CONGA_SOURCES; i += 1) {
        if (g_aprgCongaSources[i] == base) {
            return i;
        }
    }
    return -1;
}

int APRG_FindFreeCongaSource() {
    int i;
    for (i = 0; i < APRG_MAX_CONGA_SOURCES; i += 1) {
        if (g_aprgCongaSources[i] == null) {
            return i;
        }
    }
    return -1;
}

void APRG_RegisterCongaSources(int player, unitgroup hostileStructures, fixed now) {
    unitgroup preferred;
    unit base;
    int i;
    int slot = 0;

    if (g_aprgCongaSourcesInitialized || hostileStructures == null) { return; }
    if (UnitGroupCount(hostileStructures, c_unitCountAlive) < 3) { return; }
    preferred = UnitGroupEmpty();
    for (i = UnitGroupCount(hostileStructures, c_unitCountAlive); i > 0; i -= 1) {
        base = UnitGroupUnitFromEnd(hostileStructures, i);
        if (base != null && APRG_HostileGroundAnchorConnectedToPlayer(base, player)) {
            UnitGroupAdd(preferred, base);
        }
    }
    while (slot < 3 && UnitGroupCount(preferred, c_unitCountAlive) > 0) {
        base = UnitGroupRandomUnit(preferred, c_unitCountAlive);
        if (base == null) { break; }
        g_aprgCongaSources[slot] = base;
        g_aprgCongaNextTime[slot] = now + APRG_CongaNextInterval(now);
        APRG_RegisterAlwaysVisibleUnit(base, player);
        UnitGroupRemove(preferred, base);
        UnitGroupRemove(hostileStructures, base);
        slot += 1;
    }
    while (slot < 3 && UnitGroupCount(hostileStructures, c_unitCountAlive) > 0) {
        base = UnitGroupRandomUnit(hostileStructures, c_unitCountAlive);
        if (base == null) { break; }
        g_aprgCongaSources[slot] = base;
        g_aprgCongaNextTime[slot] = now + APRG_CongaNextInterval(now);
        APRG_RegisterAlwaysVisibleUnit(base, player);
        UnitGroupRemove(hostileStructures, base);
        slot += 1;
    }
    if (slot >= 3) { g_aprgCongaSourcesInitialized = true; }
}

void APRG_CongaSpawnFromBase(unit base, int player) {
    string baseType = UnitGetType(base);
    string race = CatalogFieldValueGet(c_gameCatalogUnit, baseType, "Race", UnitGetOwner(base));
    string spawnType = "Marine";
    int spawnCount = 1;
    point spawnPoint;
    unitgroup spawned;

    if (StringContains(race, "Protoss", c_stringAnywhere, c_stringNoCase)) {
        spawnType = "Zealot";
    }
    else if (StringContains(race, "Zerg", c_stringAnywhere, c_stringNoCase)) {
        spawnType = "Zergling";
        spawnCount = 2;
    }

    spawnPoint = APRG_FindGroundPointNear(UnitGetPosition(base), 3.0, 8.0);
    if (spawnPoint == null) { return; }
    spawned = UnitCreate(spawnCount, spawnType, 0, UnitGetOwner(base), spawnPoint, libNtve_gf_RandomAngle());
    APRG_RegisterMutationEnemyGroup(spawned);
    UnitGroupAddUnitGroup(g_aprgHostileRaiders, spawned);
    APRG_OrderGroupTowardNearestPlayerStructure(spawned, spawnPoint, player);
}

void APRG_TickConga(int player) {
    fixed now = GameGetMissionTime();
    unitgroup hostileStructures;
    int i;
    int events;
    unit base;
    if (!APRG_PlayerMacroBaseReady(player)) { return; }
    hostileStructures = APRG_EnemyStructures(player);

    APRG_RegisterCongaSources(player, hostileStructures, now);
    hostileStructures = APRG_EnemyStructures(player);

    for (i = 0; i < 3; i += 1) {
        base = g_aprgCongaSources[i];
        if (base == null) { continue; }
        if (!UnitIsAlive(base) || !UnitGroupHasUnit(hostileStructures, base)) {
            g_aprgCongaSources[i] = null;
            g_aprgCongaNextTime[i] = 0.0;
            continue;
        }
        for (events = 0;
             events < APRG_MAX_CONGA_EVENTS_PER_SOURCE_TICK && now >= g_aprgCongaNextTime[i];
             events += 1) {
            APRG_CongaSpawnFromBase(base, player);
            g_aprgCongaNextTime[i] += APRG_CongaNextInterval(g_aprgCongaNextTime[i]);
        }
        if (events >= APRG_MAX_CONGA_EVENTS_PER_SOURCE_TICK && now >= g_aprgCongaNextTime[i]) {
            g_aprgCongaNextTime[i] = now + APRG_CongaNextInterval(now);
        }
    }
}

bool APRG_IsAutonomousCloakAbility(string abilityType);
bool APRG_AutonomousCloakReady(unit caster);
bool APRG_TryCategorizedAutonomousAbility(unit caster, int player, bool friendlyToPlayer);
unit APRG_TryAutonomousOffensiveOrder(unit caster, unitgroup candidates, string abilityType, int commandIndex);
bool APRG_TrySwannFlamingBetty(unit swann, int player);
void APRG_QueuePriorAutonomousOrder(unit caster, order priorOrder, bool hadPriorOrder);
bool APRG_TryGeneratedHeroAbility(unit hero, int player);

bool APRG_IsEnvironmentalVoidFogUnit(unit u) {
    string unitType;
    if (u == null) { return false; }
    unitType = UnitGetType(u);
    if (unitType == "") { return false; }
    if (StringContains(unitType, "VoidRift", c_stringAnywhere, c_stringNoCase)) { return true; }
    if (StringContains(unitType, "VoidFog", c_stringAnywhere, c_stringNoCase)) { return true; }
    if (StringContains(unitType, "Fog", c_stringAnywhere, c_stringNoCase) &&
        (StringContains(unitType, "Void", c_stringAnywhere, c_stringNoCase) ||
         StringContains(unitType, "Epilogue", c_stringAnywhere, c_stringNoCase))) { return true; }
    if (StringContains(unitType, "Epilogue02VoidRift", c_stringAnywhere, c_stringNoCase)) { return true; }
    return false;
}

void APRG_DestructionPulse(int player) {
    unitgroup enemies = APRG_EnemyMobileUnits(player);
    int i = UnitGroupCount(enemies, c_unitCountAlive);
    unit enemy;
    unit target;

    for (; i > 0; i -= 1) {
        enemy = UnitGroupUnitFromEnd(enemies, i);
        if (enemy == null) { break; }
        if (APRG_IsScriptedPurifier(enemy) || APRG_IsRakShirObjectiveUnit(enemy) || APRG_IsEnvironmentalVoidFogUnit(enemy)) { continue; }
        if (g_aprgDestructionStarted && UnitOrderCount(enemy) > 0) { continue; }
        target = APRG_NearestPlayerStructure(UnitGetPosition(enemy), player);
        if (target != null) {
            UnitIssueOrder(
                enemy,
                OrderTargetingPoint(AbilityCommand("attack", 0), UnitGetPosition(target)),
                c_orderQueueReplace
            );
        }
    }
    g_aprgDestructionStarted = true;
}

void APRG_GiveInvestorsIfReady(int player) {
    if (g_aprgInvestorsGiven || !APRG_PlayerMacroBaseReady(player)) {
        return;
    }
    PlayerModifyPropertyInt(
        player,
        c_playerPropMinerals,
        c_playerPropOperSetTo,
        PlayerGetPropertyInt(player, c_playerPropMinerals) + 1000
    );
    g_aprgInvestorsGiven = true;
}

void APRG_GiveMultiClassIfReady(int player) {
    unit base;
    point spawnPoint;

    if (g_aprgMultiClassGiven || GameGetMissionTime() < 30.0 || !APRG_PlayerMacroBaseReady(player)) {
        return;
    }
    base = APRG_FindPlayerHomeStructure(player);
    if (base == null) {
        return;
    }
    spawnPoint = APRG_FindGroundPointNear(UnitGetPosition(base), 4.0, 9.0);
    if (spawnPoint == null) {
        return;
    }

    if (
        !CatalogEntryIsValid(c_gameCatalogUnit, "AP_SCV") ||
        !CatalogEntryIsValid(c_gameCatalogUnit, "AP_Probe") ||
        !CatalogEntryIsValid(c_gameCatalogUnit, "AP_Drone")
    ) {
        g_aprgMultiClassGiven = true;
        return;
    }
    APRG_CreatePlayerUnitsSafe(1, "SCV", player, spawnPoint, libNtve_gf_RandomAngle());
    APRG_CreatePlayerUnitsSafe(1, "Probe", player, spawnPoint, libNtve_gf_RandomAngle());
    APRG_CreatePlayerUnitsSafe(1, "Drone", player, spawnPoint, libNtve_gf_RandomAngle());
    g_aprgMultiClassGiven = true;
}

bool APRG_PointNearPlayerOrAlliedBuilding(point candidate, int player, fixed radius);

unit APRG_FirstLivingUnitInGroup(unitgroup units) {
    int i;
    unit u;
    if (units == null) { return null; }
    for (i = UnitGroupCount(units, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u != null && UnitIsAlive(u)) { return u; }
    }
    return null;
}

void APRG_SetGroupMovementSpeed(unitgroup units, fixed speed) {
    int i;
    unit u;
    if (units == null || speed <= 0.0) { return; }
    for (i = UnitGroupCount(units, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u != null && UnitIsAlive(u)) {
            UnitSetPropertyFixed(u, c_unitPropMovementSpeed, speed);
        }
    }
}

bool APRG_GoldenPatrolRouteSafe(point start, point destination, int player, fixed clearance) {
    fixed distance;
    fixed fraction;
    point sample;
    int steps;
    int i;
    if (start == null || destination == null) { return false; }
    distance = DistanceBetweenPoints(start, destination);
    steps = MaxI(1, MinI(160, FixedToInt(distance / 3.0) + 1));
    for (i = 0; i <= steps; i += 1) {
        fraction = IntToFixed(i) / IntToFixed(steps);
        sample = Point(
            PointGetX(start) + (PointGetX(destination) - PointGetX(start)) * fraction,
            PointGetY(start) + (PointGetY(destination) - PointGetY(start)) * fraction
        );
        // Account for carrier / phoenix formation width and unit acquisition radius.
        if (APRG_PointNearPlayerOrAlliedBuilding(sample, player, clearance)) { return false; }
    }
    return true;
}

point APRG_FindGoldenSafeAirPoint(int player, fixed spawnClearance) {
    int attempt;
    point candidate;
    unitgroup hostileBuildings;
    unit anchor;
    hostileBuildings = APRG_EnemyStructures(player);
    for (attempt = 0; attempt < APRG_MAX_POINT_ATTEMPTS; attempt += 1) {
        // Prefer actual hostile territory instead of a random position that
        // happens to be outside the allied-building exclusion.
        if (UnitGroupCount(hostileBuildings, c_unitCountAlive) > 0 && attempt < APRG_MAX_POINT_ATTEMPTS * 3 / 4) {
            anchor = UnitGroupRandomUnit(hostileBuildings, c_unitCountAlive);
            if (anchor == null) { continue; }
            candidate = PointWithOffsetPolar(UnitGetPosition(anchor), RandomFixed(16.0, 28.0), libNtve_gf_RandomAngle());
        }
        else {
            candidate = RegionRandomPoint(RegionPlayableMap());
        }
        if (candidate == null || !RegionContainsPoint(RegionPlayableMap(), candidate) || !APRG_AirSpawnPointAllowed(candidate) || APRG_PointNearRakShirDuel(candidate, 24.0)) { continue; }
        // Keep the initial fleet in enemy territory and outside allied bases.
        if (APRG_PointNearPlayerOrAlliedBuilding(candidate, player, spawnClearance)) { continue; }
        return candidate;
    }
    return null;
}

point APRG_GoldenSafePatrolDestination(point origin, int player, int startIndex, fixed patrolClearance) {
    int offset;
    int index;
    int attempt;
    point candidate;
    if (origin == null) { return null; }

    if (g_aprgFixedPatrolPointCount > 0) {
        for (offset = 0; offset < g_aprgFixedPatrolPointCount; offset += 1) {
            index = (startIndex + offset) % g_aprgFixedPatrolPointCount;
            candidate = g_aprgFixedPatrolPoints[index];
            if (candidate == null) { continue; }
            if (APRG_PointNearPlayerOrAlliedBuilding(candidate, player, patrolClearance)) { continue; }
            if (APRG_GoldenPatrolRouteSafe(origin, candidate, player, patrolClearance)) { return candidate; }
        }
    }

    // If the shared patrol cache has no safe route, find a temporary air patrol
    // point instead of sending the fleet through the player's base.
    for (attempt = 0; attempt < APRG_MAX_POINT_ATTEMPTS; attempt += 1) {
        candidate = RegionRandomPoint(RegionPlayableMap());
        if (candidate == null || !APRG_AirSpawnPointAllowed(candidate) || APRG_PointNearRakShirDuel(candidate, 24.0)) { continue; }
        if (APRG_PointNearPlayerOrAlliedBuilding(candidate, player, patrolClearance)) { continue; }
        if (APRG_GoldenPatrolRouteSafe(origin, candidate, player, patrolClearance)) { return candidate; }
    }
    return null;
}

void APRG_RetargetGoldenArmada(int player) {
    point destination;
    unit anchor;
    if (!g_aprgGoldenSpawned || UnitGroupCount(g_aprgGoldenFleet, c_unitCountAlive) <= 0) { return; }
    anchor = APRG_FirstLivingUnitInGroup(g_aprgGoldenFleet);
    if (anchor == null) { return; }

    if (GameGetMissionTime() < 240.0) {
        // The normal fleet spreads a few range from its path center: leave a 4-range
        // formation margin so individual aircraft remain about 20 range away.
        destination = APRG_GoldenSafePatrolDestination(UnitGetPosition(anchor), player, g_aprgGoldenPatrolIndex, 24.0);
        if (destination == null) { return; }
    }
    else {
        if (g_aprgFixedPatrolPointCount <= 0) { return; }
        if (g_aprgGoldenPatrolIndex < 0 || g_aprgGoldenPatrolIndex >= g_aprgFixedPatrolPointCount) { g_aprgGoldenPatrolIndex = 0; }
        destination = g_aprgFixedPatrolPoints[g_aprgGoldenPatrolIndex];
        if (destination == null) { return; }
    }

    if (GameGetMissionTime() < 240.0) {
        UnitGroupIssueOrder(g_aprgGoldenFleet, OrderTargetingPoint(AbilityCommand("move", 0), destination), c_orderQueueReplace);
    }
    else {
        UnitGroupIssueOrder(g_aprgGoldenFleet, OrderTargetingPoint(AbilityCommand("attack", 0), destination), c_orderQueueReplace);
    }
    if (g_aprgFixedPatrolPointCount > 0) {
        g_aprgGoldenPatrolIndex = (g_aprgGoldenPatrolIndex + 1) % g_aprgFixedPatrolPointCount;
    }
}

bool APRG_EnsureAirReachableToPlayer(unit flyer, int player);
unitgroup APRG_PlayerAllUnits(int player);

void APRG_TrySpawnGoldenArmada(int player) {
    point spawnPoint;
    point formationPoint;
    int hostileOwner;
    int i;
    unitgroup created;
    unit u;

    if (!APRG_PlayerMacroBaseReady(player) || g_aprgGoldenSpawned || g_aprgGoldenRetries >= APRG_GOLDEN_MAX_RETRIES) {
        return;
    }
    g_aprgGoldenRetries += 1;

    spawnPoint = APRG_FindGoldenSafeAirPoint(player, 40.0);
    if (spawnPoint == null) {
        return;
    }
    hostileOwner = APRG_FindHostileOwnerNearPoint(player, spawnPoint);
    if (hostileOwner < 0) {
        return;
    }

    created = UnitCreate(2, "Carrier", c_unitCreateIgnorePlacement, hostileOwner, spawnPoint, libNtve_gf_RandomAngle());
    UnitGroupAddUnitGroup(g_aprgGoldenFleet, created);
    UnitGroupAddUnitGroup(g_aprgAirSupportCarriers, created);
    APRG_RegisterAlwaysVisibleGroup(created, player);
    created = UnitCreate(4, "VoidRay", c_unitCreateIgnorePlacement, hostileOwner, spawnPoint, libNtve_gf_RandomAngle());
    UnitGroupAddUnitGroup(g_aprgGoldenFleet, created);
    APRG_RegisterAlwaysVisibleGroup(created, player);
    created = UnitCreate(6, "Scout", c_unitCreateIgnorePlacement, hostileOwner, spawnPoint, libNtve_gf_RandomAngle());
    UnitGroupAddUnitGroup(g_aprgGoldenFleet, created);
    APRG_RegisterAlwaysVisibleGroup(created, player);

    // Do not call APRG_EnsureAirReachableToPlayer here: it deliberately relocates
    // aircraft toward the player's base and invalidates our safe spawn point.
    for (i = UnitGroupCount(g_aprgGoldenFleet, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(g_aprgGoldenFleet, i);
        if (u != null && UnitIsAlive(u)) {
            formationPoint = PointWithOffsetPolar(spawnPoint, RandomFixed(1.0, 4.0), libNtve_gf_RandomAngle());
            if (formationPoint == null || APRG_PointNearPlayerOrAlliedBuilding(formationPoint, player, 40.0)) { formationPoint = spawnPoint; }
            UnitSetPosition(u, formationPoint, true);
        }
    }
    APRG_SetGroupMovementSpeed(g_aprgGoldenFleet, 1.9);

    g_aprgGoldenSpawned = true;
    g_aprgGoldenPatrolIndex = 0;
    g_aprgGoldenSafetyRetreatCooldown = GameGetMissionTime();
    g_aprgNextGoldenRetargetTime = GameGetMissionTime();
    APRG_RetargetGoldenArmada(player);
}

void APRG_OrderTrueGoldenAtPlayerBase(int player) {
    unit target;
    point targetPoint;
    unit anchor;
    if (!g_aprgTrueGoldenSpawned) { return; }
    anchor = UnitGroupUnitFromEnd(g_aprgTrueGoldenFleet, 1);
    if (anchor == null || !UnitIsAlive(anchor)) { anchor = UnitGroupUnitFromEnd(g_aprgTrueGoldenPhoenixes, 1); }
    if (anchor == null || !UnitIsAlive(anchor)) { return; }
    target = APRG_NearestPlayerStructure(UnitGetPosition(anchor), player);
    if (target == null) { return; }
    targetPoint = UnitGetPosition(target);
    UnitGroupIssueOrder(g_aprgTrueGoldenFleet, OrderTargetingPoint(AbilityCommand("attack", 0), targetPoint), c_orderQueueReplace);
    UnitGroupIssueOrder(g_aprgTrueGoldenPhoenixes, OrderTargetingPoint(AbilityCommand("attack", 0), targetPoint), c_orderQueueReplace);
}

void APRG_RetargetTrueGoldenArmada(int player) {
    point destination;
    unit anchor;
    if (!g_aprgTrueGoldenSpawned || UnitGroupCount(g_aprgTrueGoldenFleet, c_unitCountAlive) <= 0) { return; }
    if (g_aprgTrueGoldenMothership == null || !UnitIsAlive(g_aprgTrueGoldenMothership)) {
        if (GameGetMissionTime() >= 240.0) {
            g_aprgTrueGoldenAttackingBase = true;
            APRG_OrderTrueGoldenAtPlayerBase(player);
            return;
        }
        anchor = APRG_FirstLivingUnitInGroup(g_aprgTrueGoldenFleet);
        if (anchor == null) { anchor = APRG_FirstLivingUnitInGroup(g_aprgTrueGoldenPhoenixes); }
        if (anchor == null) { return; }
    }
    else { anchor = g_aprgTrueGoldenMothership; }

    if (GameGetMissionTime() < 600.0) {
        destination = APRG_GoldenSafePatrolDestination(UnitGetPosition(anchor), player, g_aprgTrueGoldenPatrolIndex, 40.0);
        if (destination == null) { return; }
    }
    else {
        // After ten minutes the Armada is no longer constrained to enemy-side
        // patrol anchors. Pick anywhere in the playable map and attack-move there;
        // this deliberately allows routes through the player's base.
        destination = RegionRandomPoint(RegionPlayableMap());
        if (destination == null) { return; }
    }

    if (GameGetMissionTime() < 600.0) {
        UnitGroupIssueOrder(g_aprgTrueGoldenFleet, OrderTargetingPoint(AbilityCommand("move", 0), destination), c_orderQueueReplace);
    }
    else {
        UnitGroupIssueOrder(g_aprgTrueGoldenFleet, OrderTargetingPoint(AbilityCommand("attack", 0), destination), c_orderQueueReplace);
    }
    if (GameGetMissionTime() < 600.0 && g_aprgFixedPatrolPointCount > 0) {
        g_aprgTrueGoldenPatrolIndex = (g_aprgTrueGoldenPatrolIndex + 1) % g_aprgFixedPatrolPointCount;
    }
}


unit APRG_TrueGoldenAnchorUnit() {
    unit u;
    if (g_aprgTrueGoldenMothership != null && UnitIsAlive(g_aprgTrueGoldenMothership)) { return g_aprgTrueGoldenMothership; }
    u = UnitGroupUnitFromEnd(g_aprgTrueGoldenFleet, 1);
    if (u != null && UnitIsAlive(u)) { return u; }
    return null;
}

void APRG_TickTrueGoldenPhoenixes(int player, fixed now) {
    unit anchor;
    point center;
    point destination;
    unit phoenix;
    int count;
    int i;
    fixed angle;
    if (now < g_aprgNextTrueGoldenPhoenixOrbitTime) { return; }
    g_aprgNextTrueGoldenPhoenixOrbitTime = now + 1.5;
    if (g_aprgTrueGoldenAttackingBase) { return; }
    anchor = APRG_TrueGoldenAnchorUnit();
    if (anchor == null) { return; }
    center = UnitGetPosition(anchor);
    count = UnitGroupCount(g_aprgTrueGoldenPhoenixes, c_unitCountAlive);
    if (count <= 0) { return; }
    for (i = count; i > 0; i -= 1) {
        phoenix = UnitGroupUnitFromEnd(g_aprgTrueGoldenPhoenixes, i);
        if (phoenix == null || !UnitIsAlive(phoenix)) { continue; }
        angle = IntToFixed((i * 360 / count)) + now * 18.0;
        destination = PointWithOffsetPolar(center, 10.0 + IntToFixed(i % 3) * 2.0, angle);
        if (destination != null && RegionContainsPoint(RegionPlayableMap(), destination)) {
            if (now < 600.0 && !APRG_GoldenPatrolRouteSafe(UnitGetPosition(phoenix), destination, player, 40.0)) { continue; }
            UnitIssueOrder(phoenix, OrderTargetingPoint(AbilityCommand("move", 0), destination), c_orderQueueReplace);
        }
    }
}

unit APRG_TrueGoldenNearestCloakedPlayerUnit(unit oracle, int player) {
    unitgroup units;
    unit u;
    unit best = null;
    int i;
    fixed distance;
    fixed bestDistance = 99999.0;
    point origin;
    if (oracle == null) { return null; }
    origin = UnitGetPosition(oracle);
    units = APRG_PlayerAllUnits(player);
    for (i = UnitGroupCount(units, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null || !UnitIsAlive(u) || !UnitTestState(u, c_unitStateCloaked)) { continue; }
        distance = DistanceBetweenPoints(origin, UnitGetPosition(u));
        if (distance < bestDistance) {
            best = u;
            bestDistance = distance;
        }
    }
    return best;
}

bool APRG_TryTrueGoldenOracleRevelation(unit oracle, int player) {
    unit target;
    string abilityType;
    int abilityIndex;
    int abilityCount;
    int commandIndex;
    order castOrder;
    if (oracle == null || !UnitIsAlive(oracle)) { return false; }
    target = APRG_TrueGoldenNearestCloakedPlayerUnit(oracle, player);
    if (target == null) { return false; }
    abilityCount = MinI(64, UnitAbilityCount(oracle));
    for (abilityIndex = 1; abilityIndex <= abilityCount; abilityIndex += 1) {
        abilityType = UnitAbilityGet(oracle, abilityIndex);
        if (!StringContains(abilityType, "Revelation", c_stringAnywhere, c_stringNoCase)) { continue; }
        for (commandIndex = 0; commandIndex < 4; commandIndex += 1) {
            castOrder = OrderTargetingUnit(AbilityCommand(abilityType, commandIndex), target);
            if (UnitOrderIsValid(oracle, castOrder)) {
                UnitIssueOrder(oracle, castOrder, c_orderQueueReplace);
                return true;
            }
            castOrder = OrderTargetingPoint(AbilityCommand(abilityType, commandIndex), UnitGetPosition(target));
            if (UnitOrderIsValid(oracle, castOrder)) {
                UnitIssueOrder(oracle, castOrder, c_orderQueueReplace);
                return true;
            }
        }
    }
    return false;
}

void APRG_TickTrueGoldenOracles(int player, fixed now) {
    unit oracle;
    int i;
    // Revelation orders can cause Oracles to follow a player unit across an
    // otherwise safe patrol route; disable proactive casting until the Armada
    // finishes its special 10-minute enemy-territory patrol phase.
    if (now < 600.0 || now < g_aprgNextTrueGoldenOracleTime) { return; }
    g_aprgNextTrueGoldenOracleTime = now + 2.0;
    for (i = UnitGroupCount(g_aprgTrueGoldenOracles, c_unitCountAlive); i > 0; i -= 1) {
        oracle = UnitGroupUnitFromEnd(g_aprgTrueGoldenOracles, i);
        if (oracle != null && UnitIsAlive(oracle)) { APRG_TryTrueGoldenOracleRevelation(oracle, player); }
    }
}

void APRG_TrueGoldenAddCreated(unitgroup created, int player, bool phoenixes, bool oracles) {
    if (created == null) { return; }
    APRG_RegisterMutationEnemyGroup(created);
    APRG_RegisterAlwaysVisibleGroup(created, player);
    if (phoenixes) {
        UnitGroupAddUnitGroup(g_aprgTrueGoldenPhoenixes, created);
    }
    else {
        UnitGroupAddUnitGroup(g_aprgTrueGoldenFleet, created);
    }
    if (oracles) { UnitGroupAddUnitGroup(g_aprgTrueGoldenOracles, created); }
}

void APRG_TrySpawnTrueGoldenArmada(int player) {
    point spawnPoint;
    point formationPoint;
    int hostileOwner;
    int i;
    unitgroup created;
    unit u;
    if (!APRG_PlayerMacroBaseReady(player) || g_aprgTrueGoldenSpawned || g_aprgTrueGoldenRetries >= APRG_GOLDEN_MAX_RETRIES) { return; }
    g_aprgTrueGoldenRetries += 1;
    spawnPoint = APRG_FindGoldenSafeAirPoint(player, 55.0);
    if (spawnPoint == null) { return; }
    hostileOwner = APRG_FindHostileOwnerNearPoint(player, spawnPoint);
    if (hostileOwner < 0) { return; }

    if (CatalogEntryIsValid(c_gameCatalogUnit, "Carrier")) {
        created = UnitCreate(10, "Carrier", c_unitCreateIgnorePlacement, hostileOwner, spawnPoint, libNtve_gf_RandomAngle());
        APRG_TrueGoldenAddCreated(created, player, false, false);
    }
    if (!CatalogEntryIsValid(c_gameCatalogUnit, "Mothership")) { return; }
    created = UnitCreate(1, "Mothership", c_unitCreateIgnorePlacement, hostileOwner, spawnPoint, libNtve_gf_RandomAngle());
    APRG_TrueGoldenAddCreated(created, player, false, false);
    g_aprgTrueGoldenMothership = UnitGroupUnitFromEnd(created, 1);
    if (g_aprgTrueGoldenMothership == null) { return; }
    UnitSetPropertyFixed(g_aprgTrueGoldenMothership, c_unitPropLifeMax, 1000.0);
    UnitSetPropertyFixed(g_aprgTrueGoldenMothership, c_unitPropLife, 1000.0);
    UnitSetPropertyFixed(g_aprgTrueGoldenMothership, c_unitPropShieldsMax, 1000.0);
    UnitSetPropertyFixed(g_aprgTrueGoldenMothership, c_unitPropShields, 1000.0);
    APRG_RegisterAlwaysVisibleUnit(g_aprgTrueGoldenMothership, player);

    if (CatalogEntryIsValid(c_gameCatalogUnit, "VoidRay")) {
        created = UnitCreate(15, "VoidRay", c_unitCreateIgnorePlacement, hostileOwner, spawnPoint, libNtve_gf_RandomAngle());
        APRG_TrueGoldenAddCreated(created, player, false, false);
    }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "Tempest")) {
        created = UnitCreate(10, "Tempest", c_unitCreateIgnorePlacement, hostileOwner, spawnPoint, libNtve_gf_RandomAngle());
        APRG_TrueGoldenAddCreated(created, player, false, false);
    }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "Phoenix")) {
        created = UnitCreate(20, "Phoenix", c_unitCreateIgnorePlacement, hostileOwner, spawnPoint, libNtve_gf_RandomAngle());
        APRG_TrueGoldenAddCreated(created, player, true, false);
    }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "Oracle")) {
        created = UnitCreate(3, "Oracle", c_unitCreateIgnorePlacement, hostileOwner, spawnPoint, libNtve_gf_RandomAngle());
        APRG_TrueGoldenAddCreated(created, player, false, true);
    }

    // Preserve the originally validated safe fleet anchor. Never move the
    // mothership toward the player's base for artificial air reachability.
    for (i = UnitGroupCount(g_aprgTrueGoldenFleet, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(g_aprgTrueGoldenFleet, i);
        if (u != null && u != g_aprgTrueGoldenMothership) {
            formationPoint = PointWithOffsetPolar(spawnPoint, RandomFixed(1.0, 7.0), libNtve_gf_RandomAngle());
            if (formationPoint == null || APRG_PointNearPlayerOrAlliedBuilding(formationPoint, player, 40.0)) { formationPoint = spawnPoint; }
            UnitSetPosition(u, formationPoint, true);
        }
    }
    APRG_SetGroupMovementSpeed(g_aprgTrueGoldenFleet, 1.9);
    for (i = UnitGroupCount(g_aprgTrueGoldenPhoenixes, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(g_aprgTrueGoldenPhoenixes, i);
        if (u != null) {
            formationPoint = PointWithOffsetPolar(spawnPoint, RandomFixed(7.0, 13.0), libNtve_gf_RandomAngle());
            if (formationPoint == null || APRG_PointNearPlayerOrAlliedBuilding(formationPoint, player, 40.0)) { formationPoint = spawnPoint; }
            UnitSetPosition(u, formationPoint, true);
        }
    }

    g_aprgTrueGoldenSpawned = true;
    g_aprgTrueGoldenAttackingBase = false;
    g_aprgTrueGoldenPatrolIndex = 0;
    g_aprgTrueGoldenSafetyRetreatCooldown = GameGetMissionTime();
    g_aprgNextTrueGoldenRetargetTime = GameGetMissionTime();
    g_aprgNextTrueGoldenPhoenixOrbitTime = GameGetMissionTime();
    g_aprgNextTrueGoldenOracleTime = GameGetMissionTime();
    APRG_RetargetTrueGoldenArmada(player);
}

void APRG_TickTrueGoldenArmada(int player, fixed now) {
    if (!APRG_PlayerMacroBaseReady(player)) { return; }
    if (!g_aprgTrueGoldenSpawned) {
        APRG_TrySpawnTrueGoldenArmada(player);
        return;
    }
    if ((g_aprgTrueGoldenMothership == null || !UnitIsAlive(g_aprgTrueGoldenMothership)) && now >= 240.0) {
        if (!g_aprgTrueGoldenAttackingBase || now >= g_aprgNextTrueGoldenRetargetTime) {
            g_aprgTrueGoldenAttackingBase = true;
            APRG_OrderTrueGoldenAtPlayerBase(player);
            g_aprgNextTrueGoldenRetargetTime = now + 10.0;
        }
    }
    else {
        if (now >= g_aprgNextTrueGoldenRetargetTime) {
            APRG_RetargetTrueGoldenArmada(player);
            g_aprgNextTrueGoldenRetargetTime = now + 20.0;
        }
    }
    APRG_TickTrueGoldenPhoenixes(player, now);
    APRG_TickTrueGoldenOracles(player, now);
}


unitgroup APRG_PlayerMobileUnits(int player) {
    unitgroup result;
    int i;
    unit u;
    result = UnitGroup(
        null,
        player,
        RegionPlayableMap(),
        UnitFilter(
            0,
            0,
            (1 << c_targetFilterStructure) | (1 << c_targetFilterMissile),
            (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))
        ),
        0
    );
    for (i = UnitGroupCount(result, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(result, i);
        if (u != null && (u == g_aprgPotionTargetCaster || APRG_IsRakShirObjectiveUnit(u))) { UnitGroupRemove(result, u); }
    }
    return result;
}

unitgroup APRG_PlayerAllUnits(int player) {
    unitgroup result;
    int i;
    unit u;
    result = UnitGroup(
        null, player, RegionPlayableMap(),
        UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0
    );
    for (i = UnitGroupCount(result, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(result, i);
        if (u != null && (u == g_aprgPotionTargetCaster || APRG_IsCreepTumorType(UnitGetType(u)) || APRG_IsRakShirObjectiveUnit(u))) { UnitGroupRemove(result, u); }
    }
    return result;
}

unitgroup APRG_EnemyAllUnits(int player) {
    unitgroup result;
    int i;
    unit u;
    result = UnitGroupAlliance(
        player, c_unitAllianceEnemy, RegionPlayableMap(),
        UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0
    );
    for (i = UnitGroupCount(result, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(result, i);
        if (u != null && (APRG_IsCreepTumorType(UnitGetType(u)) || APRG_IsRakShirObjectiveUnit(u))) { UnitGroupRemove(result, u); }
    }
    return result;
}

unit APRG_NearestEnemyStructure(point fromPoint, int player) {
    unitgroup structures = APRG_EnemyStructures(player);
    int i;
    unit u;
    for (i = UnitGroupCount(structures, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(structures, i);
        if (u != null && UnitTestState(u, c_unitStateInvulnerable)) { UnitGroupRemove(structures, u); }
    }
    if (UnitGroupCount(structures, c_unitCountAlive) <= 0) { return null; }
    return UnitGroupClosestToPoint(structures, fromPoint);
}

unit APRG_NearestEnemyMobileUnit(point fromPoint, int player) {
    unitgroup units = APRG_EnemyMobileUnits(player);
    if (UnitGroupCount(units, c_unitCountAlive) <= 0) {
        return null;
    }
    return UnitGroupClosestToPoint(units, fromPoint);
}

unitgroup APRG_EnemyTargetableStructures(int player) {
    unitgroup result;
    int i;
    unit u;
    result = UnitGroupAlliance(
        player, c_unitAllianceEnemy, RegionPlayableMap(),
        UnitFilter(
            (1 << c_targetFilterStructure), 0,
            (1 << c_targetFilterMissile) | (1 << c_targetFilterCloaked),
            (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)) | (1 << (c_targetFilterInvulnerable - 32))
        ), 0
    );
    for (i = UnitGroupCount(result, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(result, i);
        if (u != null && APRG_IsCreepTumorType(UnitGetType(u))) { UnitGroupRemove(result, u); }
    }
    return result;
}

unit APRG_NearestEligibleAlliedStructureTarget(unitgroup candidates, point fromPoint) {
    int i;
    int count;
    unit u;
    unit best;
    fixed distance;
    fixed bestDistance;
    fixed now;
    fixed blockedUntil;
    string cooldownKey;

    count = UnitGroupCount(candidates, c_unitCountAlive);
    best = null;
    bestDistance = 999999.0;
    now = GameGetMissionTime();

    for (i = count; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(candidates, i);
        if (u == null) { break; }
        cooldownKey = "APRG_AlliedBuildingTargetUntil_" + IntToString(UnitGetTag(u));
        blockedUntil = DataTableGetFixed(true, cooldownKey);
        if (blockedUntil > now) { continue; }
        distance = DistanceBetweenPoints(fromPoint, UnitGetPosition(u));
        if (best == null || distance < bestDistance) {
            best = u;
            bestDistance = distance;
        }
    }

    if (best == null && count > 0) {
        best = UnitGroupClosestToPoint(candidates, fromPoint);
    }
    if (best != null) {
        cooldownKey = "APRG_AlliedBuildingTargetUntil_" + IntToString(UnitGetTag(best));
        DataTableSetFixed(true, cooldownKey, now + 180.0);
    }
    return best;
}

unit APRG_NearestEligibleEnemyStructure(point fromPoint, int player) {
    unitgroup structures = APRG_EnemyTargetableStructures(player);
    return APRG_NearestEligibleAlliedStructureTarget(structures, fromPoint);
}

unitgroup APRG_EnemyTargetableGroundStructures(int player) {
    unitgroup structures;
    int i;
    unit u;
    structures = UnitGroupAlliance(
        player, c_unitAllianceEnemy, RegionPlayableMap(),
        UnitFilter(
            (1 << c_targetFilterStructure) | (1 << c_targetFilterGround), 0,
            (1 << c_targetFilterMissile) | (1 << c_targetFilterCloaked),
            (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)) | (1 << (c_targetFilterInvulnerable - 32))
        ), 0
    );
    for (i = UnitGroupCount(structures, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(structures, i);
        if (u != null && APRG_IsCreepTumorType(UnitGetType(u))) { UnitGroupRemove(structures, u); }
    }
    return structures;
}

unit APRG_NearestEligibleEnemyGroundStructureFromGroup(unitgroup structures, point fromPoint) {
    if (structures == null || UnitGroupCount(structures, c_unitCountAlive) <= 0) { return null; }
    return APRG_NearestEligibleAlliedStructureTarget(structures, fromPoint);
}

unit APRG_NearestEligibleEnemyGroundStructure(point fromPoint, int player) {
    return APRG_NearestEligibleEnemyGroundStructureFromGroup(APRG_EnemyTargetableGroundStructures(player), fromPoint);
}

unit APRG_NearestEligibleEnemyMobileUnit(point fromPoint, int player) {
    unitgroup units = APRG_EnemyMobileUnits(player);
    if (UnitGroupCount(units, c_unitCountAlive) <= 0) { return null; }
    return UnitGroupClosestToPoint(units, fromPoint);
}

void APRG_RotateAlliedTargetBlacklist() {
    g_aprgAlliedTargetBlacklist = UnitGroupEmpty();
    g_aprgAlliedTargetsThisMinute = UnitGroupEmpty();
}

bool APRG_PointNearPlayerOrAlliedBuilding(point candidate, int player, fixed radius) {
    unit nearestPlayerStructure;
    unitgroup alliedStructures;
    if (candidate == null) { return true; }
    nearestPlayerStructure = APRG_NearestPlayerStructure(candidate, player);
    if (nearestPlayerStructure != null && DistanceBetweenPoints(candidate, UnitGetPosition(nearestPlayerStructure)) <= radius) { return true; }
    alliedStructures = UnitGroupAlliance(
        player,
        c_unitAllianceAlly,
        RegionCircle(candidate, radius),
        UnitFilter((1 << c_targetFilterStructure), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32))),
        0
    );
    return UnitGroupCount(alliedStructures, c_unitCountAlive) > 0;
}

point APRG_FindStaticPatrolGroundPointWithBuildingClearance(int player, fixed clearance) {
    int attempt;
    point candidate;
    for (attempt = 0; attempt < APRG_MAX_POINT_ATTEMPTS; attempt += 1) {
        candidate = RegionRandomPoint(RegionPlayableMap());
        if (candidate == null || !PointPathingPassable(candidate)) { continue; }
        if (APRG_PointNearPlayerOrAlliedBuilding(candidate, player, clearance)) { continue; }
        return candidate;
    }
    return null;
}

point APRG_FindStaticPatrolGroundPoint(int player) {
    return APRG_FindStaticPatrolGroundPointWithBuildingClearance(player, 8.0);
}

point APRG_FindRandomGroundPoint() {
    int attempt;
    point candidate;
    for (attempt = 0; attempt < APRG_MAX_POINT_ATTEMPTS; attempt += 1) {
        candidate = RegionRandomPoint(RegionPlayableMap());
        if (candidate != null && PointPathingPassable(candidate) && !APRG_PointNearRakShirDuel(candidate, 24.0)) {
            return candidate;
        }
    }
    return null;
}

point APRG_FindAlliedRaidOriginGroundPoint(int player) {
    int attempt;
    int i;
    point candidate;
    unit target;
    unit fallbackTarget = null;
    unitgroup structures = APRG_EnemyTargetableStructures(player);
    if (UnitGroupCount(structures, c_unitCountAlive) <= 0) { return null; }

    for (attempt = 0; attempt < APRG_MAX_POINT_ATTEMPTS; attempt += 1) {
        candidate = RegionRandomPoint(RegionPlayableMap());
        if (candidate == null || !PointPathingPassable(candidate) || APRG_PointNearRakShirDuel(candidate, 24.0)) { continue; }
        for (i = UnitGroupCount(structures, c_unitCountAlive); i > 0; i -= 1) {
            target = UnitGroupUnitFromEnd(structures, i);
            if (target == null || !UnitIsAlive(target)) { continue; }
            fallbackTarget = target;
            if (PointPathingIsConnected(candidate, UnitGetPosition(target))) { return candidate; }
        }
    }

    if (fallbackTarget != null) {
        candidate = APRG_FindGroundPointNear(UnitGetPosition(fallbackTarget), 4.0, 12.0);
        if (candidate != null && PointPathingPassable(candidate) && !APRG_PointNearRakShirDuel(candidate, 24.0)) { return candidate; }
    }
    return null;
}

point APRG_FindInvasionFleetDropPoint(int player) {
    // On island missions, drop-pod effects are intentionally allowed anywhere
    // on playable ground. On ordinary missions, keep them on ground that can
    // actually reach the player's base.
    if (!APRG_GroundSpawnsNeedPlayerPathing()) { return APRG_FindRandomGroundPoint(); }
    return APRG_FindRaidOriginGroundPoint(player);
}

point APRG_FindRandomMapEdgePoint() {
    point lo = RegionGetBoundsMin(RegionPlayableMap());
    point hi = RegionGetBoundsMax(RegionPlayableMap());
    fixed minX = PointGetX(lo);
    fixed minY = PointGetY(lo);
    fixed maxX = PointGetX(hi);
    fixed maxY = PointGetY(hi);
    point candidate;
    int side;
    int attempt;
    for (attempt = 0; attempt < 16; attempt += 1) {
        side = RandomInt(0, 3);
        if (side == 0) { candidate = Point(minX + 1.5, RandomFixed(minY + 1.5, maxY - 1.5)); }
        else if (side == 1) { candidate = Point(maxX - 1.5, RandomFixed(minY + 1.5, maxY - 1.5)); }
        else if (side == 2) { candidate = Point(RandomFixed(minX + 1.5, maxX - 1.5), minY + 1.5); }
        else { candidate = Point(RandomFixed(minX + 1.5, maxX - 1.5), maxY - 1.5); }
        if (APRG_AirSpawnPointAllowed(candidate)) { return candidate; }
    }
    return Point(minX + 1.5, minY + 1.5);
}

void APRG_OrderGroupTowardNearestEnemyStructure(unitgroup group, point fromPoint, int player) {
    int i;
    unit mover;
    unit target;
    if (group == null || UnitGroupCount(group, c_unitCountAlive) <= 0) { return; }
    for (i = UnitGroupCount(group, c_unitCountAlive); i > 0; i -= 1) {
        mover = UnitGroupUnitFromEnd(group, i);
        if (mover == null || !UnitIsAlive(mover)) { continue; }
        target = APRG_NearestPathableEnemyStructure(mover, player);
        if (target == null) { target = APRG_NearestEligibleEnemyMobileUnit(UnitGetPosition(mover), player); }
        if (target != null) { APRG_OrderAttackMove(mover, UnitGetPosition(target)); }
    }
}

void APRG_MakeGroupUncommandable(unitgroup group) {
    int i = UnitGroupCount(group, c_unitCountAlive);
    unit u;
    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(group, i);
        if (u == null) {
            break;
        }
        libNtve_gf_MakeUnitUncommandable(u, true);
        UnitSetState(u, c_unitStateSelectable, false);
        UnitSelect(u, UnitGetOwner(u), false);
        DataTableSetBool(true, "APRG_Uncommandable_" + IntToString(UnitGetTag(u)), true);
        UnitSetState(u, c_unitStateUsingSupply, false);
    }
}

void APRG_StripVoidEntityBehavior(unit u) {
    int i;
    string behavior;
    string behaviorNameLink;
    string behaviorName;
    bool voidEntityBehavior;
    if (u == null) { return; }
    for (i = UnitBehaviorCountAll(u); i >= 1; i -= 1) {
        behavior = UnitBehaviorGet(u, i);
        behaviorName = "";
        if (behavior != "" && CatalogEntryIsValid(c_gameCatalogBehavior, behavior)) {
            behaviorNameLink = CatalogFieldValueGet(c_gameCatalogBehavior, behavior, "Name", c_playerAny);
            if (behaviorNameLink != "") { behaviorName = TextToString(StringExternal(behaviorNameLink)); }
        }
        voidEntityBehavior = (
            StringContains(behavior, "VoidEntity", c_stringAnywhere, c_stringNoCase) ||
            StringContains(behavior, "Void Entity", c_stringAnywhere, c_stringNoCase) ||
            StringContains(behaviorName, "Void Entity", c_stringAnywhere, c_stringNoCase) ||
            ((StringContains(behavior, "Void", c_stringAnywhere, c_stringNoCase) ||
              StringContains(behavior, "Epilogue", c_stringAnywhere, c_stringNoCase)) &&
             (StringContains(behavior, "Vulner", c_stringAnywhere, c_stringNoCase) ||
              StringContains(behavior, "Weak", c_stringAnywhere, c_stringNoCase) ||
              StringContains(behavior, "Entity", c_stringAnywhere, c_stringNoCase) ||
              StringContains(behavior, "DamageTaken", c_stringAnywhere, c_stringNoCase)))
        );
        if (voidEntityBehavior) {
            UnitBehaviorRemove(u, behavior, c_unitBehaviorCountAll);
        }
    }
}

void APRG_StripVoidEntityGroup(unitgroup group) {
    int i;
    unit u;
    if (group == null) { return; }
    for (i = UnitGroupCount(group, c_unitCountAll); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(group, i);
        if (u != null) { APRG_StripVoidEntityBehavior(u); }
    }
}

void APRG_RegisterMutationEnemyGroup(unitgroup group) {
    if (group == null || UnitGroupCount(group, c_unitCountAll) <= 0) { return; }
    APRG_StripVoidEntityGroup(group);
    UnitGroupAddUnitGroup(g_aprgSlaySpawnedEnemies, group);
}

void APRG_ReconcileMutationEnemyVoidEntity() {
    APRG_StripVoidEntityGroup(g_aprgSlaySpawnedEnemies);
    APRG_StripVoidEntityGroup(g_aprgGoldenFleet);
    APRG_StripVoidEntityGroup(g_aprgHostileRaiders);
    APRG_StripVoidEntityGroup(g_aprgHostilePatrollers);
    APRG_StripVoidEntityGroup(g_aprgDarkTemplarRaiders);
    APRG_StripVoidEntityGroup(g_aprgVoidThrashers);
    APRG_StripVoidEntityGroup(g_aprgBanelingStreamUnits);
    APRG_StripVoidEntityGroup(g_aprgTaldarimRaiders);
    APRG_StripVoidEntityGroup(g_aprgMiraMercenaries);
    APRG_StripVoidEntityGroup(g_aprgZagaraBanelingUnits);
    APRG_StripVoidEntityGroup(g_aprgDehakaPackUnits);
    APRG_StripVoidEntityGroup(g_aprgMarauderKillTeamUnits);
    APRG_StripVoidEntityGroup(g_aprgBurrowedZerglings);
    APRG_StripVoidEntityBehavior(g_aprgNexusShieldNexus);
    APRG_StripVoidEntityBehavior(g_aprgTorrasque);
    APRG_StripVoidEntityBehavior(g_aprgRaynorHyperion);
    APRG_StripVoidEntityGroup(g_aprgPurifierEscort);
    APRG_StripVoidEntityBehavior(g_aprgPurifier);
}

void APRG_AddHostileRaiders(unitgroup created, point spawnPoint, int player) {
    if (created == null || UnitGroupCount(created, c_unitCountAlive) <= 0) {
        return;
    }
    APRG_RegisterMutationEnemyGroup(created);
    UnitGroupAddUnitGroup(g_aprgHostileRaiders, created);
    APRG_OrderGroupTowardNearestPlayerStructure(created, spawnPoint, player);
}

void APRG_AddAlliedSupport(unitgroup created, point spawnPoint, int player, bool uncommandable) {
    if (created == null || UnitGroupCount(created, c_unitCountAlive) <= 0) {
        return;
    }
    if (uncommandable) {
        APRG_MakeGroupUncommandable(created);
    }
    UnitGroupAddUnitGroup(g_aprgAlliedSupport, created);
    APRG_OrderGroupTowardNearestEnemyStructure(created, spawnPoint, player);
}

void APRG_OrderAlliedZombie(unit u, int player) {
    point fromPoint;
    unit target;
    if (u == null) { return; }
    fromPoint = UnitGetPosition(u);
    target = APRG_NearestEligibleEnemyGroundStructure(fromPoint, player);
    if (target != null) { APRG_OrderAttackMove(u, UnitGetPosition(target)); }
}

void APRG_AddAlliedZombies(unitgroup created, int player) {
    int i;
    unit u;
    if (created == null || UnitGroupCount(created, c_unitCountAlive) <= 0) { return; }
    APRG_MakeGroupUncommandable(created);
    UnitGroupAddUnitGroup(g_aprgAlliedZombies, created);
    i = UnitGroupCount(created, c_unitCountAlive);
    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(created, i);
        if (u == null) { break; }
        UnitSetState(u, c_unitStateSelectable, false);
        APRG_OrderAlliedZombie(u, player);
    }
}

void APRG_RetargetAlliedZombies(int player) {
    int i = UnitGroupCount(g_aprgAlliedZombies, c_unitCountAlive);
    unitgroup structures = APRG_EnemyTargetableGroundStructures(player);
    unit u;
    unit target;
    point fromPoint;
    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(g_aprgAlliedZombies, i);
        if (u == null) { break; }
        fromPoint = UnitGetPosition(u);
        target = APRG_NearestEligibleEnemyGroundStructureFromGroup(structures, fromPoint);
        if (target != null) { APRG_OrderAttackMove(u, UnitGetPosition(target)); }
    }
}

void APRG_RetargetAlliedSupport(int player) {
    int i;
    unit u;
    unit target;
    point fromPoint;
    unitgroup structures = APRG_EnemyTargetableStructures(player);
    for (i = UnitGroupCount(g_aprgAlliedSupport, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(g_aprgAlliedSupport, i);
        if (u == null || !UnitIsAlive(u)) { continue; }
        if (!DataTableGetBool(true, "APRG_Uncommandable_" + IntToString(UnitGetTag(u)))) { continue; }
        if (UnitOrderCount(u) > 0) { continue; }
        fromPoint = UnitGetPosition(u);
        target = APRG_NearestPathableEnemyStructureFromGroup(u, player, structures);
        if (target == null) { target = APRG_NearestEligibleEnemyMobileUnit(fromPoint, player); }
        if (target != null) { APRG_OrderAttackMove(u, UnitGetPosition(target)); }
    }
}

void APRG_RetargetPurifierAllianceReinforcements(int player) {
    int i;
    unit u;
    unit target;
    for (i = UnitGroupCount(g_aprgPurifierAllianceReinforcements, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(g_aprgPurifierAllianceReinforcements, i);
        if (u == null || !UnitIsAlive(u)) { continue; }
        target = APRG_NearestPathableEnemyStructure(u, player);
        if (target == null) { target = APRG_NearestEligibleEnemyMobileUnit(UnitGetPosition(u), player); }
        if (target != null) { APRG_OrderAttackMove(u, UnitGetPosition(target)); }
    }
}

void APRG_RetargetHostilePatrollers() {
    int i = UnitGroupCount(g_aprgHostilePatrollers, c_unitCountAlive);
    unit u;
    point destination;
    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(g_aprgHostilePatrollers, i);
        if (u == null) { break; }
        if (g_aprgHeroesOfStormUnits != null && UnitGroupHasUnit(g_aprgHeroesOfStormUnits, u)) { continue; }
        APRG_OrderPatrolMap(u, APRG_GetPrimaryPlayer(), true);
    }
}

point APRG_RandomHeroesOfStormPatrolPoint(unit hero) {
    int attempt;
    int segment;
    int segments;
    int player;
    fixed t;
    bool protectedPeriod;
    bool crossesProtectedArea;
    point current;
    point candidate;
    point sample;
    if (hero == null || !UnitIsAlive(hero)) { return null; }
    player = APRG_GetPrimaryPlayer();
    protectedPeriod = GameGetMissionTime() < 240.0;
    current = UnitGetPosition(hero);
    for (attempt = 0; attempt < 32; attempt += 1) {
        candidate = RegionRandomPoint(RegionPlayableMap());
        if (candidate == null) { continue; }
        if (DistanceBetweenPoints(current, candidate) < 12.0) { continue; }
        if (!UnitPathableToPoint(hero, candidate, 3.0, 100000.0)) { continue; }
        if (protectedPeriod) {
            // Protect the whole proposed path, not just its destination. Sample
            // at most 20% of 20 range per step so a shortcut cannot cross a base.
            if (APRG_PointNearPlayerOrAlliedBuilding(candidate, player, 20.0)) { continue; }
            crossesProtectedArea = false;
            segments = MinI(80, MaxI(1, FixedToInt(DistanceBetweenPoints(current, candidate) / 3.0) + 1));
            for (segment = 0; segment <= segments; segment += 1) {
                t = IntToFixed(segment) / IntToFixed(segments);
                sample = Point(PointGetX(current) + (PointGetX(candidate) - PointGetX(current)) * t,
                               PointGetY(current) + (PointGetY(candidate) - PointGetY(current)) * t);
                if (APRG_PointNearPlayerOrAlliedBuilding(sample, player, 20.0)) {
                    crossesProtectedArea = true;
                    break;
                }
            }
            if (crossesProtectedArea) { continue; }
        }
        return candidate;
    }
    return null;
}

bool APRG_OrderHeroesOfStormRandomPatrol(unit hero) {
    point destination;
    if (hero == null || !UnitIsAlive(hero)) { return false; }
    destination = APRG_RandomHeroesOfStormPatrolPoint(hero);
    if (destination == null) { return false; }
    AISetUnitScriptControlled(hero, false);
    UnitIssueOrder(hero, OrderTargetingPoint(AbilityCommand("attack", 0), destination), c_orderQueueReplace);
    return true;
}

bool APRG_RepathRandomHeroesOfStormHero() {
    unit hero;
    if (g_aprgHeroesOfStormUnits == null || UnitGroupCount(g_aprgHeroesOfStormUnits, c_unitCountAlive) <= 0) { return false; }
    hero = UnitGroupRandomUnit(g_aprgHeroesOfStormUnits, c_unitCountAlive);
    return APRG_OrderHeroesOfStormRandomPatrol(hero);
}

bool APRG_SendRandomHeroesOfStormHeroToPlayerBase(int player) {
    unit hero;
    unit home;
    if (g_aprgHeroesOfStormUnits == null || UnitGroupCount(g_aprgHeroesOfStormUnits, c_unitCountAlive) <= 0) { return false; }
    home = APRG_FindPlayerHomeStructure(player);
    if (home == null || !UnitIsAlive(home)) { return false; }
    hero = UnitGroupRandomUnit(g_aprgHeroesOfStormUnits, c_unitCountAlive);
    if (hero == null || !UnitIsAlive(hero)) { return false; }
    AISetUnitScriptControlled(hero, false);
    UnitIssueOrder(hero, OrderTargetingPoint(AbilityCommand("attack", 0), UnitGetPosition(home)), c_orderQueueReplace);
    return true;
}

string APRG_WarfieldSoundId(string suffix) {
    string cacheKey;
    string cached;
    string token;
    string entry;
    string assetFile;
    int count;
    int i;

    cacheKey = "APRG_WarfieldSound_" + suffix;
    cached = DataTableGetString(true, cacheKey);
    if (cached != "" && CatalogEntryIsValid(c_gameCatalogSound, cached)) { return cached; }

    token = "zmission_char02_generalwarfield_" + suffix + ".ogg";
    count = CatalogEntryCount(c_gameCatalogSound);
    for (i = 1; i <= count; i += 1) {
        entry = CatalogEntryGet(c_gameCatalogSound, i);
        if (entry == "" || !CatalogEntryIsValid(c_gameCatalogSound, entry)) { continue; }
        assetFile = CatalogFieldValueGet(c_gameCatalogSound, entry, "AssetArray[0].File", c_playerAny);
        if (StringContains(assetFile, token, c_stringEnd, c_stringNoCase)) {
            DataTableSetString(true, cacheKey, entry);
            return entry;
        }
    }
    return "";
}

string APRG_WarfieldPortraitModel(soundlink line) {
    string portraitModel;
    string fallbackId;
    soundlink fallbackLine;

    portraitModel = SoundPortraitModel(line);
    if (portraitModel != null && portraitModel != "") { return portraitModel; }

    fallbackId = APRG_WarfieldSoundId("054");
    if (fallbackId == "") { return ""; }
    fallbackLine = SoundLink(fallbackId, c_soundIndexAny);
    portraitModel = SoundPortraitModel(fallbackLine);
    if (portraitModel == null) { return ""; }
    return portraitModel;
}

void APRG_QueueWarfieldVO(string suffix) {
    if (suffix == "" || g_aprgWarfieldVOCount >= APRG_MAX_WARFIELD_VO_QUEUE) { return; }
    g_aprgWarfieldVOQueue[g_aprgWarfieldVOTail] = suffix;
    g_aprgWarfieldVOTail += 1;
    if (g_aprgWarfieldVOTail >= APRG_MAX_WARFIELD_VO_QUEUE) { g_aprgWarfieldVOTail = 0; }
    g_aprgWarfieldVOCount += 1;
}

void APRG_PlayWarfieldVOImmediate(string suffix, fixed now) {
    int portrait;
    string soundId;
    string portraitModel;
    fixed duration;
    soundlink line;
    transmissionsource source;

    soundId = APRG_WarfieldSoundId(suffix);
    if (soundId == "") {
        g_aprgWarfieldVONextTime = now + 0.25;
        return;
    }
    line = SoundLink(soundId, c_soundIndexAny);
    portraitModel = APRG_WarfieldPortraitModel(line);

    if (portraitModel != null && portraitModel != "") {
        source = TransmissionSourceFromModel(portraitModel);
        portrait = libNtve_gf_CinematicPortrait(libNtve_ge_CinematicPortraitPosition_CenterLeft);
        libNtve_gf_SendTransmissionSimple(
            source,
            portrait,
            line,
            0.0,
            c_transmissionDurationAdd,
            false
        );
    }
    else {
        SoundPlay(line, PlayerGroupAll(), 100.0, 0.0);
    }

    SoundLengthQuery(line);
    duration = SoundLengthSync(line);
    if (duration <= 0.0) { duration = 6.0; }
    g_aprgWarfieldVONextTime = now + duration + 0.35;
}

void APRG_PlayWarfieldVO(string suffix) {
    APRG_QueueWarfieldVO(suffix);
}

void APRG_TickWarfieldVOQueue(fixed now) {
    string suffix;
    if (g_aprgWarfieldVOCount <= 0 || now < g_aprgWarfieldVONextTime) { return; }
    suffix = g_aprgWarfieldVOQueue[g_aprgWarfieldVOHead];
    g_aprgWarfieldVOQueue[g_aprgWarfieldVOHead] = "";
    g_aprgWarfieldVOHead += 1;
    if (g_aprgWarfieldVOHead >= APRG_MAX_WARFIELD_VO_QUEUE) { g_aprgWarfieldVOHead = 0; }
    g_aprgWarfieldVOCount -= 1;
    APRG_PlayWarfieldVOImmediate(suffix, now);
}

void APRG_PlayRandomWarfieldGorgonCall() {
    int roll;
    roll = RandomInt(1, 3);
    if (roll == 1) { APRG_PlayWarfieldVO("016"); }
    else if (roll == 2) { APRG_PlayWarfieldVO("017"); }
    else { APRG_PlayWarfieldVO("018"); }
}

void APRG_PlayRandomWarfieldGorgonDeath() {
    if (RandomInt(0, 1) == 0) { APRG_PlayWarfieldVO("014"); }
    else { APRG_PlayWarfieldVO("028"); }
}

bool APRG_QueueRealDropPod(int kind, int owner, point landingPoint, unit payloadTarget) {
    int i = 0;
    string podType = "";
    unitgroup visualGroup;
    unit visual;
    if (landingPoint == null || owner < 0) { return false; }
    for (; i < APRG_MAX_PENDING_DROP_PODS; i += 1) {
        if (g_aprgPendingDropState[i] == 0) { break; }
    }
    if (i >= APRG_MAX_PENDING_DROP_PODS) { return false; }

    if (kind == APRG_DROP_KIND_ZERG_HOSTILE || kind == APRG_DROP_KIND_LEVIATHAN_HOSTILE || kind == APRG_DROP_KIND_ACIDIC_LANDING || kind == APRG_DROP_KIND_INVASION_FLEET) {
        if (CatalogEntryIsValid(c_gameCatalogUnit, "ZergDropPod")) {
            podType = "ZergDropPod";
        }
        else if (CatalogEntryIsValid(c_gameCatalogUnit, "ZergDropPodLarge")) {
            podType = "ZergDropPodLarge";
        }
    }
    else if (CatalogEntryIsValid(c_gameCatalogUnit, "TerranDropPod")) {
        podType = "TerranDropPod";
    }
    if (podType == "") { return false; }

    visualGroup = UnitCreate(1, podType, c_unitCreateIgnorePlacement, owner, landingPoint, libNtve_gf_RandomAngle());
    visual = UnitGroupUnitFromEnd(visualGroup, 1);
    if (visual == null) { return false; }
    UnitSetState(visual, c_unitStateUsingSupply, false);
    UnitSetState(visual, c_unitStateInvulnerable, true);

    g_aprgPendingDropState[i] = 1;
    g_aprgPendingDropKind[i] = kind;
    g_aprgPendingDropOwner[i] = owner;
    g_aprgPendingDropPoint[i] = landingPoint;
    g_aprgPendingDropImpactTime[i] = GameGetMissionTime() + 2.6;
    g_aprgPendingDropCleanupTime[i] = 0.0;
    g_aprgPendingDropVisual[i] = visual;
    g_aprgPendingDropTarget[i] = payloadTarget;
    return true;
}

void APRG_ResolveTerranHostileDrop(int player, int owner, point p) {
    unitgroup created;
    int marines = RandomInt(3, 5);
    int medics = RandomInt(0, 2);
    int branch = RandomInt(0, 1);
    int extra;
    created = UnitCreate(marines, "Marine", c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
    APRG_AddHostileRaiders(created, p, player);
    if (branch == 0) {
        extra = RandomInt(0, 2);
        if (extra > 0) { created = UnitCreate(extra, "Marauder", c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle()); APRG_AddHostileRaiders(created, p, player); }
    } else {
        extra = RandomInt(0, 3);
        if (extra > 0) { created = UnitCreate(extra, "Firebat", c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle()); APRG_AddHostileRaiders(created, p, player); }
    }
    if (medics > 0) { created = UnitCreate(medics, "Medic", c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle()); APRG_AddHostileRaiders(created, p, player); }
}

void APRG_ResolveWarfieldDrop(int player, point p) {
    unitgroup created;
    int marines = RandomInt(1, 4);
    int extra;
    created = APRG_CreatePlayerUnitsSafe(marines, "Marine", player, p, libNtve_gf_RandomAngle());
    APRG_AddAlliedSupport(created, p, player, true);
    if (RandomInt(0, 1) == 1) { created = APRG_CreatePlayerUnitsSafe(1, "Medic", player, p, libNtve_gf_RandomAngle()); APRG_AddAlliedSupport(created, p, player, true); }
    if (RandomInt(0, 1) == 0) {
        extra = RandomInt(0, 1);
        if (extra > 0) { created = APRG_CreatePlayerUnitsSafe(extra, "Marauder", player, p, libNtve_gf_RandomAngle()); APRG_AddAlliedSupport(created, p, player, true); }
    } else {
        extra = RandomInt(0, 3);
        if (extra > 0) { created = APRG_CreatePlayerUnitsSafe(extra, "Firebat", player, p, libNtve_gf_RandomAngle()); APRG_AddAlliedSupport(created, p, player, true); }
    }
}

void APRG_ResolveWarfieldOmegaDrop(int player, point p) {
    unitgroup created;
    APRG_ResolveWarfieldDrop(player, p);
    if (CatalogEntryIsValid(c_gameCatalogUnit, "Ghost")) {
        created = APRG_CreatePlayerUnitsSafe(1, "Ghost", player, p, libNtve_gf_RandomAngle());
        APRG_AddAlliedSupport(created, p, player, true);
    }
}

void APRG_ResolveZergHostileDrop(int player, int owner, point p) {
    unitgroup created;
    int count = RandomInt(2, 6);
    int branch;
    created = UnitCreate(count, "Zergling", c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
    APRG_AddHostileRaiders(created, p, player);
    branch = RandomInt(0, 1);
    count = RandomInt(0, 2);
    if (count > 0) {
        if (branch == 0) { created = UnitCreate(count, "Roach", c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle()); }
        else { created = UnitCreate(count, "Hydralisk", c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle()); }
        APRG_AddHostileRaiders(created, p, player);
    }
    branch = RandomInt(0, 1);
    count = RandomInt(0, 1);
    if (count > 0) {
        if (branch == 0) { created = UnitCreate(count, "Baneling", c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle()); }
        else { created = UnitCreate(count, "Queen", c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle()); }
        APRG_AddHostileRaiders(created, p, player);
    }
}

void APRG_ResolveLeviathanHostileDrop(int player, int owner, point p) {
    unitgroup created;
    int count = RandomInt(2, 6);
    int branch;
    created = UnitCreate(count, "Zergling", c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
    APRG_AddHostileRaiders(created, p, player);

    branch = RandomInt(0, 1);
    count = RandomInt(0, 2);
    if (count > 0) {
        if (branch == 0) { created = UnitCreate(count, "Roach", c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle()); }
        else { created = UnitCreate(count, "Hydralisk", c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle()); }
        APRG_AddHostileRaiders(created, p, player);
    }

    // Leviathan in Orbit no longer drops banelings. One Queen is present on
    // exactly 25% of pods; the remaining pods contain only the normal attackers.
    if (RandomInt(1, 4) == 1 && CatalogEntryIsValid(c_gameCatalogUnit, "Queen")) {
        created = UnitCreate(1, "Queen", c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
        APRG_AddHostileRaiders(created, p, player);
    }
}

void APRG_SetGroupNoSupply(unitgroup created) {
    int i;
    unit u;
    if (created == null) { return; }
    for (i = UnitGroupCount(created, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(created, i);
        if (u == null) { continue; }
        UnitSetState(u, c_unitStateUsingSupply, false);
    }
}

void APRG_ResolveInfantryReinforcementDrop(int player, point p) {
    unitgroup created;
    int marines;
    if (p == null) { return; }
    marines = RandomInt(1, 4);
    created = APRG_CreatePlayerUnitsSafe(marines, "Marine", player, p, libNtve_gf_RandomAngle());
    APRG_SetGroupNoSupply(created);
    APRG_AddAlliedSupport(created, p, player, false);
    if (RandomInt(0, 1) == 1 && CatalogEntryIsValid(c_gameCatalogUnit, "Marauder")) {
        created = APRG_CreatePlayerUnitsSafe(1, "Marauder", player, p, libNtve_gf_RandomAngle());
        APRG_SetGroupNoSupply(created);
        APRG_AddAlliedSupport(created, p, player, false);
    }
    if (RandomInt(0, 1) == 1 && CatalogEntryIsValid(c_gameCatalogUnit, "Medic")) {
        created = APRG_CreatePlayerUnitsSafe(1, "Medic", player, p, libNtve_gf_RandomAngle());
        APRG_SetGroupNoSupply(created);
        APRG_AddAlliedSupport(created, p, player, false);
    }
    if (RandomInt(0, 1) == 1 && CatalogEntryIsValid(c_gameCatalogUnit, "Firebat")) {
        created = APRG_CreatePlayerUnitsSafe(1, "Firebat", player, p, libNtve_gf_RandomAngle());
        APRG_SetGroupNoSupply(created);
        APRG_AddAlliedSupport(created, p, player, false);
    }
}

void APRG_ResolvePlayerZergDrop(int player, point p, bool uncommandable) {
    unitgroup created;
    int count;
    int choice;
    if (p == null) { return; }
    count = RandomInt(1, 4);
    if (CatalogEntryIsValid(c_gameCatalogUnit, "Zergling")) {
        created = APRG_CreatePlayerUnitsSafe(count, "Zergling", player, p, libNtve_gf_RandomAngle());
        if (uncommandable) { APRG_SetGroupNoSupply(created); }
        APRG_AddAlliedSupport(created, p, player, uncommandable);
    }
    if (RandomInt(0, 1) == 1) {
        choice = RandomInt(0, 1);
        if (choice == 0 && CatalogEntryIsValid(c_gameCatalogUnit, "Roach")) {
            created = APRG_CreatePlayerUnitsSafe(1, "Roach", player, p, libNtve_gf_RandomAngle());
            if (uncommandable) { APRG_SetGroupNoSupply(created); }
            APRG_AddAlliedSupport(created, p, player, uncommandable);
        }
        else if (CatalogEntryIsValid(c_gameCatalogUnit, "Hydralisk")) {
            created = APRG_CreatePlayerUnitsSafe(1, "Hydralisk", player, p, libNtve_gf_RandomAngle());
            if (uncommandable) { APRG_SetGroupNoSupply(created); }
            APRG_AddAlliedSupport(created, p, player, uncommandable);
        }
    }
    if (RandomInt(0, 1) == 1) {
        choice = RandomInt(0, 1);
        if (choice == 0 && CatalogEntryIsValid(c_gameCatalogUnit, "Baneling")) {
            created = APRG_CreatePlayerUnitsSafe(1, "Baneling", player, p, libNtve_gf_RandomAngle());
            if (uncommandable) { APRG_SetGroupNoSupply(created); }
            APRG_AddAlliedSupport(created, p, player, uncommandable);
        }
        else if (CatalogEntryIsValid(c_gameCatalogUnit, "Queen")) {
            created = APRG_CreatePlayerUnitsSafe(1, "Queen", player, p, libNtve_gf_RandomAngle());
            if (uncommandable) { APRG_SetGroupNoSupply(created); }
            APRG_AddAlliedSupport(created, p, player, uncommandable);
        }
    }
}

void APRG_ResolveMineralThiefDrop(int owner, point p, unit target) {
    unitgroup created;
    unit thief;
    if (owner < 0 || p == null || !CatalogEntryIsValid(c_gameCatalogUnit, "MULE")) { return; }
    created = UnitCreate(1, "MULE", c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
    thief = UnitGroupUnitFromEnd(created, 1);
    if (thief == null) { return; }
    DataTableSetBool(true, "APRG_MineralThief_" + IntToString(UnitGetTag(thief)), true);
    AISetUnitScriptControlled(thief, true);
    if (target != null && UnitIsAlive(target)) {
        UnitIssueOrder(thief, OrderTargetingUnit(AbilityCommand("Smart", 0), target), c_orderQueueReplace);
    }
}


