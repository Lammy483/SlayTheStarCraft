// Double durability only for a newly created, explicitly owned Crew copy.
// Direct property changes are per actor, not global catalog modifications;
// two calls to this function would incorrectly quadruple, so call once at
// successful UnitCreate and never in the general unit-update tick.
void APRG_CrewDoubleSpawnDurability(unit target) {
    fixed lifeMax;
    fixed life;
    fixed shieldsMax;
    fixed shields;
    int tag;
    string key;
    if (target == null || !UnitIsAlive(target) || g_aprgCrewDeathToken<=0) { return; }
    // Instance flag: a second Barracks of the same type is NOT exempt.
    // This also makes a retried adoption/receipt unable to quadruple HP.
    tag=UnitGetTag(target);
    if (tag<=0) { return; }
    key="APRG_CrewDurability_"+IntToString(g_aprgCrewDeathToken)+"_"+IntToString(tag);
    if (DataTableGetBool(true,key)) { return; }
    DataTableSetBool(true,key,true);
    DataTableSetBool(true,"APRG_CrewDeployed_"+IntToString(g_aprgCrewDeathToken)+"_"+
        IntToString(tag),true);
    lifeMax = UnitGetPropertyFixed(target, c_unitPropLifeMax, c_unitPropCurrent);
    life = UnitGetPropertyFixed(target, c_unitPropLife, c_unitPropCurrent);
    if (lifeMax > 0.0) {
        UnitSetPropertyFixed(target, c_unitPropLifeMax, lifeMax * 2.0);
        UnitSetPropertyFixed(target, c_unitPropLife, life * 2.0);
    }
    shieldsMax = UnitGetPropertyFixed(target, c_unitPropShieldsMax, c_unitPropCurrent);
    shields = UnitGetPropertyFixed(target, c_unitPropShields, c_unitPropCurrent);
    if (shieldsMax > 0.0) {
        UnitSetPropertyFixed(target, c_unitPropShieldsMax, shieldsMax * 2.0);
        UnitSetPropertyFixed(target, c_unitPropShields, shields * 2.0);
    }
}

// One SC2-created unit/structure per requested roster copy. The home-tag
// is a placement origin and independently verifiable parent, NOT a producer.
void APRG_CrewSaveAutoReceipt(int player, int sequence, string nativeType, int homeTag, int spawnedTag) {
    string section = "Session" + IntToString(g_aprgCrewSessionToken);
    string prefix = "Click" + IntToString(sequence);
    if (g_aprgCrewReceiptBank == null) { return; }
    BankValueSetFromInt(g_aprgCrewReceiptBank, section, prefix + "Tag", spawnedTag);
    BankValueSetFromInt(g_aprgCrewReceiptBank, section, prefix + "Producer", homeTag);
    BankValueSetFromInt(g_aprgCrewReceiptBank, section, prefix + "Type", APRG_CrewNativeTypeCode(nativeType));
    BankValueSetFromInt(g_aprgCrewReceiptBank, section, prefix + "Owner", player);
    BankValueSetFromInt(g_aprgCrewReceiptBank, section, prefix + "Commit", g_aprgCrewSessionToken);
    BankSave(g_aprgCrewReceiptBank);
}

bool APRG_CrewAutoAck_Func(bool testConds, bool runActions) {
    if (!runActions || !g_aprgCrewSessionActive || !g_aprgCrewAwaitingReceiptAck ||
        EventPlayer() != APRG_GetPrimaryPlayer() ||
        StringToInt(StringWord(EventChatMessage(false), 2)) != g_aprgCrewSessionToken ||
        StringToInt(StringWord(EventChatMessage(false), 3)) != g_aprgCrewLastSequence ||
        StringToInt(StringWord(EventChatMessage(false), 4)) != g_aprgCrewLastSpawnTag) { return true; }
    // Python ACKs only after an authenticated bank + live SC2 observation
    // have been atomically bound to the exact Crew roster copy.
    g_aprgCrewAwaitingReceiptAck = false;
    BankValueSetFromInt(g_aprgCrewReceiptBank,
        "Session" + IntToString(g_aprgCrewSessionToken),
        "Ack" + IntToString(g_aprgCrewLastSequence), g_aprgCrewSessionToken);
    BankSave(g_aprgCrewReceiptBank);
    return true;
}

// Controlled manual recovery only; never report a successful Crew deployment
// or bank receipt. This releases selection if a live test stalls.
bool APRG_CrewUnlockInput_Func(bool testConds, bool runActions) {
    if (!runActions ||
        (g_aprgMissionFlags & APRG_MISSION_FLAG_CREW_CHALLENGE) == 0 ||
        EventPlayer() != APRG_GetPrimaryPlayer()) { return true; }
    APRG_CrewReleaseSelectionLock();
    return true;
}

bool APRG_CrewSession_Func(bool testConds, bool runActions) {
    int player;
    int token;
    unit startHome;
    string section;
    if (!runActions || !g_aprgStarted || g_aprgCrewSessionActive ||
        (g_aprgMissionFlags & APRG_MISSION_FLAG_CREW_CHALLENGE) == 0) { return true; }
    player = APRG_GetPrimaryPlayer();
    if (EventPlayer() != player) { return true; }
    token = StringToInt(StringWord(EventChatMessage(false), 2));
    if (token <= 0) { return true; }
    // Dev62 direct mode: no macro-base gate, native cleanup, starting-unit
    // removal, automatic spawning, or setup End event. The campaign's free
    // actors remain in play and have no persistent Crew ownership.
    g_aprgCrewReceiptBank = BankLoad("SlayTheStarCraftCrew", player);
    if (g_aprgCrewReceiptBank == null) { return true; }
    g_aprgCrewDeathBank = g_aprgCrewReceiptBank;
    g_aprgCrewDeathToken = token;
    g_aprgCrewNextPaidTrainBeat = 0.0;
    g_aprgCrewSessionToken = token;
    g_aprgCrewSessionActive = true;
    g_aprgCrewNativeDone = true;
    g_aprgCrewNativeAwaitAck = false;
    g_aprgCrewAwaitingReceiptAck = false;
    g_aprgCrewProdReady = true;
    g_aprgCrewPendingConstructs = UnitGroupEmpty();
    if (g_aprgCrewDeathTrigger == null) {
        g_aprgCrewDeathTrigger = TriggerCreate("APRG_CrewDeath_Func");
        TriggerAddEventUnitDied(g_aprgCrewDeathTrigger, null);
    }
    startHome = APRG_FindPlayerHomeStructure(player);
    g_aprgCrewOriginPoint = null;
    g_aprgCrewOriginTag = 0;
    if (startHome != null) {
        g_aprgCrewOriginPoint = UnitGetPosition(startHome);
        g_aprgCrewOriginTag = UnitGetTag(startHome);
    }
    section = "Session" + IntToString(token);
    BankValueSetFromInt(g_aprgCrewReceiptBank, section, "Ready", token);
    BankValueSetFromInt(g_aprgCrewReceiptBank, section, "Direct", token);
    BankSave(g_aprgCrewReceiptBank);
    // The native build/train fallback becomes active immediately; player
    // command cards are never locked, and map assets remain untouched.
    APRG_CrewTickProductionRestrictions(player);
    return true;
}

// A native building is either consumed as one matching purchased roster copy
// (action=1) or removed (action=2). This path uses the immutable starting-tag
// plan built in Python; Galaxy also checks current player ownership and the
// structure group. Each sequence executes once and is banked before ACK.
bool APRG_CrewNative_Func(bool testConds, bool runActions) {
    int player;
    int token;
    int sequence;
    int nativeTag;
    int action;
    unitgroup structures;
    unit candidate = null;
    unit u;
    int i;
    string section;
    string keyPrefix;
    if (!runActions || !g_aprgStarted || !g_aprgCrewSessionActive ||
        g_aprgCrewNativeDone || g_aprgCrewNativeAwaitAck ||
        g_aprgCrewAwaitingReceiptAck || g_aprgCrewReceiptBank == null) { return true; }
    player = APRG_GetPrimaryPlayer();
    if (EventPlayer() != player || !APRG_PlayerMacroBaseReady(player)) { return true; }
    token = StringToInt(StringWord(EventChatMessage(false), 2));
    sequence = StringToInt(StringWord(EventChatMessage(false), 3));
    nativeTag = StringToInt(StringWord(EventChatMessage(false), 4));
    action = StringToInt(StringWord(EventChatMessage(false), 5));
    if (token != g_aprgCrewSessionToken ||
        sequence != g_aprgCrewNativeSequence + 1 || nativeTag <= 0 ||
        (action != 1 && action != 2)) { return true; }
    if (!DataTableGetBool(true, "APRG_CrewNativeStart_" + IntToString(token) + "_" + IntToString(nativeTag))) { return true; }
    structures = APRG_PlayerAllUnits(player);
    for (i = UnitGroupCount(structures, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(structures, i);
        if (u != null && UnitIsAlive(u) && UnitGetOwner(u) == player &&
            UnitGetTag(u) == nativeTag) { candidate = u; break; }
    }
    // A mission trigger may destroy a native starting structure between
    // freezing the Python reconciliation plan and processing its chat command.
    // A KEEP is never acknowledged for an absent actor. For REMOVE only,
    // absence already satisfies the requested end state; write the same
    // banked receipt so that the deployment queue cannot stall forever.
    // Python independently verifies that this was a known native starting
    // tag and that no player-owned observation still contains the actor.
    if (candidate == null && action == 1) { return true; }
    if (candidate != null) {
        if (action == 1) {
            APRG_CrewDoubleSpawnDurability(candidate);
            DataTableSetBool(true,
                "APRG_CrewTracked_" + IntToString(g_aprgCrewDeathToken) + "_" + IntToString(nativeTag), true);
        }
        else {
            UnitRemove(candidate);
        }
    }
    section = "Session" + IntToString(token);
    keyPrefix = "Native" + IntToString(sequence);
    BankValueSetFromInt(g_aprgCrewReceiptBank, section, keyPrefix + "Tag", nativeTag);
    BankValueSetFromInt(g_aprgCrewReceiptBank, section, keyPrefix + "Action", action);
    BankValueSetFromInt(g_aprgCrewReceiptBank, section, keyPrefix + "Owner", player);
    BankValueSetFromInt(g_aprgCrewReceiptBank, section, keyPrefix + "Commit", token);
    // The durable Native receipt and sequence ACK are committed together.
    // Python independently validates the observed owner/tag/type before it
    // advances the roster. This removes a redundant extra chat + bank-save
    // round-trip for every starting building without dropping crash recovery.
    BankValueSetFromInt(g_aprgCrewReceiptBank, section,
        "NativeAck" + IntToString(sequence), token);
    BankSave(g_aprgCrewReceiptBank);
    g_aprgCrewNativeSequence = sequence;
    g_aprgCrewNativeTag = nativeTag;
    g_aprgCrewNativeAwaitAck = false;
    return true;
}

bool APRG_CrewNativeAck_Func(bool testConds, bool runActions) {
    if (!runActions || !g_aprgCrewSessionActive || !g_aprgCrewNativeAwaitAck ||
        EventPlayer() != APRG_GetPrimaryPlayer() ||
        StringToInt(StringWord(EventChatMessage(false), 2)) != g_aprgCrewSessionToken ||
        StringToInt(StringWord(EventChatMessage(false), 3)) != g_aprgCrewNativeSequence ||
        StringToInt(StringWord(EventChatMessage(false), 4)) != g_aprgCrewNativeTag) { return true; }
    g_aprgCrewNativeAwaitAck = false;
    BankValueSetFromInt(g_aprgCrewReceiptBank, "Session" + IntToString(g_aprgCrewSessionToken),
        "NativeAck" + IntToString(g_aprgCrewNativeSequence), g_aprgCrewSessionToken);
    BankSave(g_aprgCrewReceiptBank);
    return true;
}

bool APRG_CrewNativeEnd_Func(bool testConds, bool runActions) {
    if (!runActions || !g_aprgCrewSessionActive || g_aprgCrewNativeAwaitAck ||
        EventPlayer() != APRG_GetPrimaryPlayer() ||
        StringToInt(StringWord(EventChatMessage(false), 2)) != g_aprgCrewSessionToken) { return true; }
    g_aprgCrewNativeDone = true;
    BankValueSetFromInt(g_aprgCrewReceiptBank, "Session" + IntToString(g_aprgCrewSessionToken),
        "NativeDone", g_aprgCrewSessionToken);
    BankSave(g_aprgCrewReceiptBank);
    return true;
}

// Failed placements are acknowledged by SC2 without inventing a unit tag.
// The purchased copy remains in the deployment zone; Python excludes it
// only from further attempts in this same mission. No fake success receipt.
void APRG_CrewSavePlacementFailure(int sequence) {
    if (g_aprgCrewReceiptBank == null) { return; }
    BankValueSetFromInt(g_aprgCrewReceiptBank,
        "Session" + IntToString(g_aprgCrewSessionToken),
        "Skip" + IntToString(sequence), g_aprgCrewSessionToken);
    BankSave(g_aprgCrewReceiptBank);
    g_aprgCrewLastSequence = sequence;
    g_aprgCrewLastSpawnTag = 0;
    g_aprgCrewAwaitingReceiptAck = true;
}

bool APRG_CrewSpawn_Func(bool testConds, bool runActions) {
    int player;
    int token;
    int sequence;
    string unitType;
    string spawnUnitType;
    unit home;
    point origin;
    int originTag;
    point target;
    unitgroup group;
    unit spawned;
    if (!runActions || !g_aprgStarted || !g_aprgCrewSessionActive ||
        !g_aprgCrewNativeDone || g_aprgCrewNativeAwaitAck ||
        g_aprgCrewAwaitingReceiptAck || g_aprgCrewReceiptBank == null) { return true; }
    player = APRG_GetPrimaryPlayer();
    if (EventPlayer() != player || !APRG_PlayerMacroBaseReady(player)) { return true; }
    token = StringToInt(StringWord(EventChatMessage(false), 2));
    sequence = StringToInt(StringWord(EventChatMessage(false), 3));
    unitType = StringWord(EventChatMessage(false), 4);
    if (token != g_aprgCrewSessionToken || sequence != g_aprgCrewLastSequence + 1 ||
        !APRG_CrewSpawnTypeAllowed(unitType)) { return true; }
    if (!CatalogEntryIsValid(c_gameCatalogUnit, APRG_CrewDeploymentUnitType(unitType))) {
        APRG_CrewSavePlacementFailure(sequence);
        return true;
    }
    home = APRG_FindPlayerHomeStructure(player);
    if (home != null && UnitIsAlive(home)) {
        origin = UnitGetPosition(home);
        originTag = UnitGetTag(home);
    }
    else {
        origin = g_aprgCrewOriginPoint;
        originTag = g_aprgCrewOriginTag;
    }
    if (origin == null || originTag <= 0) {
        APRG_CrewSavePlacementFailure(sequence);
        return true;
    }
    // Avoid spawning on top of the town hall. Structures need a building-safe
    // footprint; mobile units use ordinary pathable ground beside the base.
    if (unitType == "CommandCenter" || unitType == "SupplyDepot" ||
        unitType == "Barracks" || unitType == "Factory" || unitType == "Starport" ||
        unitType == "Hatchery" || unitType == "SpawningPool" ||
        unitType == "RoachWarren" ||
        unitType == "Nexus" || unitType == "Pylon" || unitType == "Gateway" ||
        unitType == "DevastatorTurret" || unitType == "PerditionTurret") {
        target = APRG_PlayerBuildingSpawnPoint(player, origin, 5.0, 13.0);
    }
    else {
        target = APRG_PlayerSafeSpawnPoint(player,
            PointWithOffsetPolar(origin, 7.0, libNtve_gf_RandomAngle()));
    }
    if (target == null) {
        APRG_CrewSavePlacementFailure(sequence);
        return true;
    }
    // Only a single unit per command. Never fabricate an SC2 receipt.
    spawnUnitType = APRG_CrewDeploymentUnitType(unitType);
    if (!CatalogEntryIsValid(c_gameCatalogUnit, spawnUnitType)) {
        APRG_CrewSavePlacementFailure(sequence);
        return true;
    }
    group = UnitCreate(1, spawnUnitType, 0, player, target, libNtve_gf_RandomAngle());
    spawned = UnitGroupUnitFromEnd(group, 1);
    if (spawned == null || !UnitIsAlive(spawned) || UnitGetOwner(spawned) != player ||
        UnitGetType(spawned) != spawnUnitType) {
        if (spawned != null) { UnitRemove(spawned); }
        APRG_CrewSavePlacementFailure(sequence);
        return true;
    }
    APRG_CrewDoubleSpawnDurability(spawned);
    DataTableSetBool(true,
        "APRG_CrewTracked_" + IntToString(g_aprgCrewDeathToken) + "_" + IntToString(UnitGetTag(spawned)), true);
    g_aprgCrewLastSequence = sequence;
    g_aprgCrewLastSpawnTag = UnitGetTag(spawned);
    APRG_CrewSaveAutoReceipt(player, sequence, unitType,
                             originTag, g_aprgCrewLastSpawnTag);
    g_aprgCrewAwaitingReceiptAck = true;
    return true;
}

// Crew bulk operations: each chat message is one independent stage, with
// a single BankSave for up to ten native actor decisions or twelve spawns.
// These triggers are *only* registered and executed in Crew Challenge.
bool APRG_CrewFastNative_Func(bool testConds, bool runActions) {
    int player;
    int token;
    int first;
    int count;
    int finalBatch;
    int i;
    int j;
    int k;
    int action;
    int nativeTag;
    unit candidate;
    unit u;
    unitgroup structures;
    string message;
    string section;
    string keyPrefix;
    if (!runActions || !g_aprgStarted || !g_aprgCrewSessionActive ||
        g_aprgCrewNativeDone || g_aprgCrewReceiptBank == null ||
        g_aprgCrewAwaitingReceiptAck || g_aprgCrewNativeAwaitAck ||
        (g_aprgMissionFlags & APRG_MISSION_FLAG_CREW_CHALLENGE) == 0) { return true; }
    player = APRG_GetPrimaryPlayer();
    if (EventPlayer() != player || !APRG_PlayerMacroBaseReady(player)) { return true; }
    message = EventChatMessage(false);
    token = StringToInt(StringWord(message, 2));
    first = StringToInt(StringWord(message, 3));
    count = StringToInt(StringWord(message, 4));
    finalBatch = StringToInt(StringWord(message, 5));
    if (token != g_aprgCrewSessionToken || count < 0 || count > 10 ||
        first != g_aprgCrewNativeSequence + 1 ||
        (finalBatch != 0 && finalBatch != 1)) { return true; }
    structures = APRG_PlayerAllUnits(player);
    // Prevalidate the ENTIRE request before touching a single building.
    for (i = 0; i < count; i += 1) {
        action = StringToInt(StringWord(message, 6 + 2 * i));
        nativeTag = StringToInt(StringWord(message, 7 + 2 * i));
        if ((action != 1 && action != 2) || nativeTag <= 0 ||
            !DataTableGetBool(true, "APRG_CrewNativeStart_" + IntToString(token) + "_" + IntToString(nativeTag))) { return true; }
        // A malformed repeated tag in the same message must fail atomically.
        for (j = 0; j < i; j += 1) {
            if (StringToInt(StringWord(message, 7 + 2 * j)) == nativeTag) { return true; }
        }
        // The same native building cannot be consumed or removed twice.
        if (DataTableGetBool(true, "APRG_CrewNativeHandled_" + IntToString(token) + "_" + IntToString(nativeTag))) { return true; }
        candidate = null;
        for (j = UnitGroupCount(structures, c_unitCountAlive); j > 0; j -= 1) {
            u = UnitGroupUnitFromEnd(structures, j);
            if (u != null && UnitIsAlive(u) && UnitGetOwner(u) == player &&
                UnitGetTag(u) == nativeTag) { candidate = u; break; }
        }
        if (action == 1 && candidate == null) { return true; }
    }
    section = "Session" + IntToString(token);
    for (i = 0; i < count; i += 1) {
        action = StringToInt(StringWord(message, 6 + 2 * i));
        nativeTag = StringToInt(StringWord(message, 7 + 2 * i));
        candidate = null;
        for (k = UnitGroupCount(structures, c_unitCountAlive); k > 0; k -= 1) {
            u = UnitGroupUnitFromEnd(structures, k);
            if (u != null && UnitIsAlive(u) && UnitGetOwner(u) == player &&
                UnitGetTag(u) == nativeTag) { candidate = u; break; }
        }
        if (candidate != null && action == 1) {
            APRG_CrewDoubleSpawnDurability(candidate);
            APRG_CrewDisableProductionForUnit(candidate, player);
            DataTableSetBool(true, "APRG_CrewTracked_" + IntToString(g_aprgCrewDeathToken) + "_" + IntToString(nativeTag), true);
        }
        else if (candidate != null && action == 2) { UnitRemove(candidate); }
        DataTableSetBool(true, "APRG_CrewNativeHandled_" + IntToString(token) + "_" + IntToString(nativeTag), true);
        keyPrefix = "Native" + IntToString(first + i);
        BankValueSetFromInt(g_aprgCrewReceiptBank, section, keyPrefix + "Tag", nativeTag);
        BankValueSetFromInt(g_aprgCrewReceiptBank, section, keyPrefix + "Action", action);
        BankValueSetFromInt(g_aprgCrewReceiptBank, section, keyPrefix + "Owner", player);
        BankValueSetFromInt(g_aprgCrewReceiptBank, section, keyPrefix + "Commit", token);
        BankValueSetFromInt(g_aprgCrewReceiptBank, section, "NativeAck" + IntToString(first + i), token);
    }
    g_aprgCrewNativeSequence += count;
    if (finalBatch == 1) {
        g_aprgCrewNativeDone = true;
        BankValueSetFromInt(g_aprgCrewReceiptBank, section, "NativeDone", token);
    }
    BankSave(g_aprgCrewReceiptBank);
    return true;
}

// Each combat unit originates at its own appropriate production facility,
// not at a random location around the town hall. No AP native production is
// enabled; these are ONLY paid, explicitly authorized Crew batch spawns.
unit APRG_CrewFastProducer(int player, string unitType, point home) {
    string wanted = "";
    unitgroup structures;
    unit producer;
    unit chosen = null;
    int i;
    fixed distance;
    fixed best = 999999.0;
    if (unitType == "Marine" || unitType == "Marauder" ||
        unitType == "Reaper" || unitType == "Firebat") { wanted = "Barracks"; }
    else if (unitType == "Hellion" || unitType == "SiegeTank") { wanted = "Factory"; }
    else if (unitType == "VikingFighter" || unitType == "Medivac" ||
        unitType == "Banshee" || unitType == "Battlecruiser") { wanted = "Starport"; }
    else if (unitType == "SCV") { wanted = "CommandCenter"; }
    else if (unitType == "Zergling" || unitType == "Roach" ||
        unitType == "Drone" || unitType == "Overlord") { wanted = "Hatchery"; }
    else if (unitType == "Zealot" || unitType == "Stalker") { wanted = "Gateway"; }
    else if (unitType == "Probe") { wanted = "Nexus"; }
    if (wanted == "") { return null; }
    structures = APRG_PlayerStructures(player);
    for (i = UnitGroupCount(structures, c_unitCountAlive); i > 0; i -= 1) {
        producer = UnitGroupUnitFromEnd(structures, i);
        if (producer == null || !UnitIsAlive(producer) || UnitGetOwner(producer) != player) { continue; }
        if (APRG_CrewEconomyType(UnitGetType(producer)) != wanted) { continue; }
        if (home == null) { distance = 0.0; }
        else { distance = DistanceBetweenPoints(UnitGetPosition(producer), home); }
        if (chosen == null || distance < best) { chosen = producer; best = distance; }
    }
    return chosen;
}

bool APRG_CrewFastSpawn_Func(bool testConds, bool runActions) {
    int player;
    int token;
    int first;
    int count;
    int i;
    string unitType;
    string spawnUnitType;
    string message;
    string section;
    string prefix;
    point origin;
    point target;
    unit home;
    unit producer;
    unit spawned;
    unitgroup group;
    int originTag;
    int tag;
    bool isStructure;
    if (!runActions || !g_aprgStarted || !g_aprgCrewSessionActive ||
        !g_aprgCrewNativeDone || g_aprgCrewReceiptBank == null ||
        g_aprgCrewAwaitingReceiptAck ||
        (g_aprgMissionFlags & APRG_MISSION_FLAG_CREW_CHALLENGE) == 0) { return true; }
    player = APRG_GetPrimaryPlayer();
    if (EventPlayer() != player || !APRG_PlayerMacroBaseReady(player)) { return true; }
    message = EventChatMessage(false);
    token = StringToInt(StringWord(message, 2));
    first = StringToInt(StringWord(message, 3));
    count = StringToInt(StringWord(message, 4));
    if (token != g_aprgCrewSessionToken || count < 1 || count > 12 ||
        first != g_aprgCrewLastSequence + 1) { return true; }
    for (i = 0; i < count; i += 1) {
        unitType = StringWord(message, 5 + i);
        if (!APRG_CrewSpawnTypeAllowed(unitType)) { return true; }
    }
    section = "Session" + IntToString(token);
    for (i = 0; i < count; i += 1) {
        unitType = StringWord(message, 5 + i);
        home = APRG_FindPlayerHomeStructure(player);
        origin = g_aprgCrewOriginPoint;
        originTag = g_aprgCrewOriginTag;
        if (home != null && UnitIsAlive(home)) {
            origin = UnitGetPosition(home);
            originTag = UnitGetTag(home);
        }
        producer = APRG_CrewFastProducer(player, unitType, origin);
        spawnUnitType = APRG_CrewDeploymentUnitType(unitType);
        isStructure = CatalogEntryIsValid(c_gameCatalogUnit, spawnUnitType) &&
            UnitTypeTestAttribute(spawnUnitType, c_unitAttributeStructure);
        if (isStructure) { target = APRG_PlayerBuildingSpawnPoint(player, origin, 5.0, 13.0); }
        else if (producer != null) {
            target = APRG_PlayerSafeSpawnPoint(player,
                PointWithOffsetPolar(UnitGetPosition(producer), 3.0, libNtve_gf_RandomAngle()));
        }
        else { target = APRG_PlayerSafeSpawnPoint(player,
            PointWithOffsetPolar(origin, 7.0, libNtve_gf_RandomAngle())); }
        tag = 0;
        spawnUnitType = APRG_CrewDeploymentUnitType(unitType);
        if (target != null && CatalogEntryIsValid(c_gameCatalogUnit, spawnUnitType)) {
            group = UnitCreate(1, spawnUnitType, 0, player, target, libNtve_gf_RandomAngle());
            spawned = UnitGroupUnitFromEnd(group, 1);
            if (spawned != null && UnitIsAlive(spawned) &&
                UnitGetOwner(spawned) == player && UnitGetType(spawned) == spawnUnitType) {
                tag = UnitGetTag(spawned);
                APRG_CrewDoubleSpawnDurability(spawned);
                            DataTableSetBool(true, "APRG_CrewTracked_" + IntToString(g_aprgCrewDeathToken) + "_" + IntToString(tag), true);
            }
            else if (spawned != null) { UnitRemove(spawned); }
        }
        prefix = "Click" + IntToString(first + i);
        if (tag > 0) {
            BankValueSetFromInt(g_aprgCrewReceiptBank, section, prefix + "Tag", tag);
            BankValueSetFromInt(g_aprgCrewReceiptBank, section, prefix + "Producer", originTag);
            BankValueSetFromInt(g_aprgCrewReceiptBank, section, prefix + "Type", APRG_CrewNativeTypeCode(unitType));
            BankValueSetFromInt(g_aprgCrewReceiptBank, section, prefix + "Owner", player);
            BankValueSetFromInt(g_aprgCrewReceiptBank, section, prefix + "Commit", token);
        }
        else { BankValueSetFromInt(g_aprgCrewReceiptBank, section, "Skip" + IntToString(first + i), token); }
        BankValueSetFromInt(g_aprgCrewReceiptBank, section, "Ack" + IntToString(first + i), token);
    }
    g_aprgCrewLastSequence += count;
    BankSave(g_aprgCrewReceiptBank);
    return true;
}

bool APRG_CrewEnd_Func(bool testConds, bool runActions) {
    if (!runActions || !g_aprgCrewSessionActive || g_aprgCrewAwaitingReceiptAck ||
        !g_aprgCrewNativeDone || g_aprgCrewNativeAwaitAck ||
        EventPlayer() != APRG_GetPrimaryPlayer() ||
        StringToInt(StringWord(EventChatMessage(false), 2)) != g_aprgCrewSessionToken) { return true; }
    // Only SC2's durable completion proof may release the Python victory
    // barrier. A lost chat End command is retried with the same token.
    BankValueSetFromInt(g_aprgCrewReceiptBank,
        "Session" + IntToString(g_aprgCrewSessionToken), "Ended", g_aprgCrewSessionToken);
    BankSave(g_aprgCrewReceiptBank);
    g_aprgCrewProdReady = true;
    UIDisplayMessage(PlayerGroupSingle(APRG_GetPrimaryPlayer()), c_messageAreaChat,
        StringToText("[Slay] Crew setup complete. Build and train your purchased units normally."));
    g_aprgCrewRestrictedActors = UnitGroupEmpty();
    APRG_CrewTickProductionRestrictions(APRG_GetPrimaryPlayer());
    g_aprgCrewSessionActive = false;
    g_aprgCrewSessionToken = 0;
    g_aprgCrewReceiptBank = null;
    g_aprgCrewAwaitingReceiptAck = false;
    APRG_CrewReleaseSelectionLock();
    return true;
}

bool APRG_Config_Func(bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    g_aprgMaskA = StringToInt(StringWord(EventChatMessage(false), 2));
    g_aprgMaskB = StringToInt(StringWord(EventChatMessage(false), 3));
    g_aprgMaskC = StringToInt(StringWord(EventChatMessage(false), 4));
    g_aprgMaskD = StringToInt(StringWord(EventChatMessage(false), 5));
    g_aprgMaskE = StringToInt(StringWord(EventChatMessage(false), 6));
    g_aprgMaskF = StringToInt(StringWord(EventChatMessage(false), 7));
    g_aprgAutoRepairStacks = StringToInt(StringWord(EventChatMessage(false), 8));
    g_aprgProgressionFlags = StringToInt(StringWord(EventChatMessage(false), 9));
    g_aprgSpearEnergyRegenStacks = StringToInt(StringWord(EventChatMessage(false), 10));
    g_aprgMercenaryUpgradePacked = StringToInt(StringWord(EventChatMessage(false), 11));
    g_aprgSpearCooldownReductionStacks = StringToInt(StringWord(EventChatMessage(false), 12));
    g_aprgKerriganUpgradeFlags = StringToInt(StringWord(EventChatMessage(false), 13));
    g_aprgDeadlyWeaponsStacks = StringToInt(StringWord(EventChatMessage(false), 14));
    g_aprgCommanderHeroIndex = StringToInt(StringWord(EventChatMessage(false), 15));
    g_aprgGodMode = StringToInt(StringWord(EventChatMessage(false), 16)) > 0;
    g_aprgMissionLayer = StringToInt(StringWord(EventChatMessage(false), 17));
    g_aprgMissionFlags = StringToInt(StringWord(EventChatMessage(false), 18));
    // Configure Crew production at mission start without ever disabling
    // the player's ordinary build, train, or add-on command-card buttons.
    if ((g_aprgMissionFlags & APRG_MISSION_FLAG_CREW_CHALLENGE) != 0) {
        APRG_CrewTickProductionRestrictions(APRG_GetPrimaryPlayer());
    }
    g_aprgMercenaryUpgradePacked2 = StringToInt(StringWord(EventChatMessage(false), 19));
    g_aprgTestPotionRunToken = StringToInt(StringWord(EventChatMessage(false), 20));
    g_aprgPotionType[0] = StringToInt(StringWord(EventChatMessage(false), 21));
    g_aprgPotionSerial[0] = StringToInt(StringWord(EventChatMessage(false), 22));
    g_aprgPotionType[1] = StringToInt(StringWord(EventChatMessage(false), 23));
    g_aprgPotionSerial[1] = StringToInt(StringWord(EventChatMessage(false), 24));
    g_aprgPotionMercMask = StringToInt(StringWord(EventChatMessage(false), 25));
    g_aprgMaskG = StringToInt(StringWord(EventChatMessage(false), 26));

    g_aprgGodModeCatalogApplied = false;
    if (g_aprgAutoRepairStacks < 0) { g_aprgAutoRepairStacks = 0; }
    if (g_aprgDeadlyWeaponsStacks < 0) { g_aprgDeadlyWeaponsStacks = 0; }
    if (g_aprgCommanderHeroIndex < -1 || g_aprgCommanderHeroIndex >= APRG_HERO_CANDIDATE_COUNT) { g_aprgCommanderHeroIndex = -1; }
    if (g_aprgProgressionFlags < 0) { g_aprgProgressionFlags = 0; }
    if (g_aprgSpearEnergyRegenStacks < 0) { g_aprgSpearEnergyRegenStacks = 0; }
    if (g_aprgMercenaryUpgradePacked < 0) { g_aprgMercenaryUpgradePacked = 0; }
    if (g_aprgSpearCooldownReductionStacks < 0) { g_aprgSpearCooldownReductionStacks = 0; }
    if (g_aprgKerriganUpgradeFlags < 0) { g_aprgKerriganUpgradeFlags = 0; }
    if (g_aprgMissionLayer < 1) { g_aprgMissionLayer = 1; }
    if (g_aprgMissionFlags < 0) { g_aprgMissionFlags = 0; }
    if (g_aprgMercenaryUpgradePacked2 < 0) { g_aprgMercenaryUpgradePacked2 = 0; }
    if (g_aprgTestPotionRunToken < 0) { g_aprgTestPotionRunToken = 0; }
    if (g_aprgMaskG < 0) { g_aprgMaskG = 0; }
    return true;
}

