bool APRG_HasMutation(int flag) {
    return ((g_aprgMaskA & flag) != 0);
}

bool APRG_HasBlessing(int flag) {
    return ((g_aprgMaskB & flag) != 0);
}

bool APRG_HasExtension(int flag) {
    return ((g_aprgMaskC & flag) != 0);
}

bool APRG_HasExtension2(int flag) {
    return ((g_aprgMaskD & flag) != 0);
}

bool APRG_HasExtension3(int flag) {
    return ((g_aprgMaskE & flag) != 0);
}

bool APRG_HasExtension4(int flag) {
    return ((g_aprgMaskF & flag) != 0);
}

bool APRG_HasProgression(int flag) {
    return ((g_aprgProgressionFlags & flag) != 0);
}

string APRG_MutationSummary() {
    string result = "";
    if (APRG_HasMutation(APRG_MUT_LOW_QUALITY_MINERALS)) {
        if (result != "") { result = result + ", "; }
        result = result + "Low-Quality Minerals";
    }
    if (APRG_HasMutation(APRG_MUT_CONGA_LINE)) {
        if (result != "") { result = result + ", "; }
        result = result + "Conga Line";
    }
    if (APRG_HasMutation(APRG_MUT_DESTRUCTION)) {
        if (result != "") { result = result + ", "; }
        result = result + "10 Minutes Until Destruction";
    }
    if (APRG_HasMutation(APRG_MUT_GOLDEN_ARMADA)) {
        if (result != "") { result = result + ", "; }
        result = result + "Golden Armada";
    }
    if ((g_aprgMissionFlags & APRG_MISSION_FLAG_TRUE_GOLDEN_ARMADA) != 0) {
        if (result != "") { result = result + ", "; }
        result = result + "True Golden Armada";
    }
    if ((g_aprgMissionFlags & APRG_MISSION_FLAG_TOSH_AND_HIS_BOYS) != 0) { if (result != "") { result = result + ", "; } result = result + "Tosh and his Boys"; }
    if ((g_aprgMissionFlags & APRG_MISSION_FLAG_IMMORTAL_ZERGLING) != 0) {
        if (result != "") { result = result + ", "; }
        result = result + "Immortal Zergling";
    }
    if (APRG_HasExtension4(APRG_EXT4_MUT_SIEGE_MODE_X5)) {
        if (result != "") { result = result + ", "; }
        result = result + "Siege Mode x5";
    }
    else if (APRG_HasMutation(APRG_MUT_SIEGE_MODE)) {
        if (result != "") { result = result + ", "; }
        result = result + "Siege Mode";
