bool APRG_IsWidowMineType(string unitType) {
    return unitType != "" && StringContains(unitType, "WidowMine", c_stringAnywhere, c_stringNoCase);
}

void APRG_ApplyBuildingOvercharge(int player) {
    unitgroup structures;
    unitgroup created;
    int i;
    int slot;
    unit u;
    unit proxy;
    point p;
    string proxyType = "";

    if (CatalogEntryIsValid(c_gameCatalogUnit, "PylonOvercharged")) { proxyType = "PylonOvercharged"; }
    else if (CatalogEntryIsValid(c_gameCatalogUnit, "Battlecruiser")) { proxyType = "Battlecruiser"; }
    if (proxyType == "") { return; }
    for (slot = 0; slot < g_aprgBuildingOverchargeCount; slot += 1) {
        u = g_aprgBuildingOverchargeSource[slot];
        proxy = g_aprgBuildingOverchargeProxy[slot];
        if (u != null && UnitIsAlive(u) && APRG_IsWidowMineType(UnitGetType(u))) {
            if (proxy != null && UnitIsAlive(proxy)) { UnitRemove(proxy); }
            UnitGroupRemove(g_aprgBuildingOverchargeProcessed, u);
            g_aprgBuildingOverchargeSource[slot] = null;
            g_aprgBuildingOverchargeProxy[slot] = null;
            continue;
        }
        if (u != null && UnitIsAlive(u) && proxy != null && UnitIsAlive(proxy)) {
            UnitSetPosition(proxy, UnitGetPosition(u), true);
            if (UnitGetType(proxy) == "Battlecruiser") {
                UnitSetHeight(proxy, UnitGetHeight(u) + 0.25, 0.0);
            }
            UnitSetState(proxy, c_unitStateInvulnerable, true);
            UnitSetState(proxy, c_unitStateTargetable, false);
            UnitSetState(proxy, c_unitStateSelectable, false);
            UnitSelect(proxy, player, false);
        }
        else if ((u == null || !UnitIsAlive(u)) && proxy != null && UnitIsAlive(proxy)) {
            UnitRemove(proxy);
            g_aprgBuildingOverchargeProxy[slot] = null;
        }
        else if (u != null && UnitIsAlive(u) && (proxy == null || !UnitIsAlive(proxy))) {
            UnitGroupRemove(g_aprgBuildingOverchargeProcessed, u);
            g_aprgBuildingOverchargeSource[slot] = null;
            g_aprgBuildingOverchargeProxy[slot] = null;
        }
    }
    structures = APRG_PlayerStructures(player);
    i = UnitGroupCount(structures, c_unitCountAlive);
    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(structures, i);
        if (u == null) { break; }
        if (APRG_IsWidowMineType(UnitGetType(u))) { continue; }
        if (UnitGroupHasUnit(g_aprgBuildingOverchargeProcessed, u)) { continue; }
        if (g_aprgBuildingOverchargeCount >= 256) { return; }
        p = UnitGetPosition(u);
        created = UnitCreate(1, proxyType, c_unitCreateIgnorePlacement, player, p, 270.0);
        if (created == null || UnitGroupCount(created, c_unitCountAlive) <= 0) { continue; }
        proxy = UnitGroupUnitFromEnd(created, 1);
        if (proxy == null) { continue; }
        UnitSetState(proxy, c_unitStateUsingSupply, false);
        UnitSetState(proxy, c_unitStateInvulnerable, true);
        UnitSetState(proxy, c_unitStateTargetable, false);
        UnitSetState(proxy, c_unitStateSelectable, false);
        libNtve_gf_MakeUnitUncommandable(proxy, true);
        UnitSelect(proxy, player, false);
        UnitSetPropertyFixed(proxy, c_unitPropMovementSpeed, 0.0);
        UnitSetPropertyFixed(proxy, c_unitPropEnergyMax, 0.0);
        UnitSetPropertyFixed(proxy, c_unitPropEnergy, 0.0);
        UnitSetPropertyFixed(proxy, c_unitPropEnergyRegen, 0.0);
        UnitSetScale(proxy, 0.05, 0.05, 0.05);
        if (UnitGetType(proxy) == "Battlecruiser") {
            UnitSetHeight(proxy, UnitGetHeight(u) + 0.25, 0.0);
        }
        g_aprgBuildingOverchargeSource[g_aprgBuildingOverchargeCount] = u;
        g_aprgBuildingOverchargeProxy[g_aprgBuildingOverchargeCount] = proxy;
        g_aprgBuildingOverchargeCount += 1;
        UnitGroupAdd(g_aprgBuildingOverchargeProcessed, u);
    }
}

void APRG_GiveGhostReportingIfReady(int player) {
    unit home;
    point p;
    point academyPoint;
    unitgroup created;
    unitgroup ghosts;
    unit ghost;
    int i;
    if (g_aprgGhostReportingGiven || !APRG_PlayerMacroBaseReady(player)) { return; }
    if (!CatalogEntryIsValid(c_gameCatalogUnit, "Ghost") || !CatalogEntryIsValid(c_gameCatalogUnit, "GhostAcademy")) { return; }
    home = APRG_FindPlayerHomeStructure(player);
    if (home == null) { return; }
    p = APRG_FindGroundPointNear(UnitGetPosition(home), 4.0, 10.0);
    academyPoint = APRG_PlayerBuildingSpawnPoint(player, UnitGetPosition(home), 7.0, 14.0);
    if (p == null || academyPoint == null) { return; }
    ghosts = APRG_CreatePlayerUnitsVanillaSafe(3, "Ghost", player, p, libNtve_gf_RandomAngle());
    if (CatalogEntryIsValid(c_gameCatalogAbil, "GhostCloak")) {
        TechTreeAbilityAllow(player, AbilityCommand("GhostCloak", 0), true);
        for (i = UnitGroupCount(ghosts, c_unitCountAlive); i > 0; i -= 1) {
            ghost = UnitGroupUnitFromEnd(ghosts, i);
            if (ghost == null) { break; }
            UnitAbilityAdd(ghost, "GhostCloak");
            UnitAbilityShow(ghost, "GhostCloak", true);
            UnitAbilityEnable(ghost, "GhostCloak", true);
        }
    }
    created = APRG_CreatePlayerUnitsVanillaSafe(1, "GhostAcademy", player, academyPoint, libNtve_gf_RandomAngle());
    g_aprgGhostReportingAcademy = UnitGroupUnitFromEnd(created, 1);
    if (g_aprgGhostReportingAcademy != null) {
        UnitMagazineArm(g_aprgGhostReportingAcademy, AbilityCommand("ArmSiloWithNuke", 0), 1);
        g_aprgGhostReportingGiven = true;
    }
}

void APRG_TickGhostReporting(int player) {
    int count;
    if (!g_aprgGhostReportingGiven) { APRG_GiveGhostReportingIfReady(player); }
    if (g_aprgGhostReportingAcademy == null || !UnitIsAlive(g_aprgGhostReportingAcademy)) { return; }
    count = UnitMagazineCount(g_aprgGhostReportingAcademy, "ArmSiloWithNuke");
    if (count < 1) {
        UnitMagazineArm(g_aprgGhostReportingAcademy, AbilityCommand("ArmSiloWithNuke", 0), 1);
    }
}

string APRG_TaldarimMothershipType() {
    if (CatalogEntryIsValid(c_gameCatalogUnit, "Flagship")) { return "Flagship"; }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "SOAMothershipv4")) { return "SOAMothershipv4"; }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "TalDarimMothership")) { return "TalDarimMothership"; }
    return "";
}

unit APRG_RandomTaldarimTarget(int player) {
    unitgroup structures;
    int count;
    structures = APRG_PlayerStructures(player);
    count = UnitGroupCount(structures, c_unitCountAlive);
    if (count <= 0) { return null; }
    return UnitGroupUnitFromEnd(structures, RandomInt(1, count));
}

void APRG_OrderTaldarimUnit(unit u, int player) {
    unit target;
    if (u == null || !UnitIsAlive(u)) { return; }
    target = APRG_RandomTaldarimTarget(player);
    if (target == null) { return; }
    APRG_OrderAttackMove(u, UnitGetPosition(target));
}

void APRG_RegisterTaldarimGroup(unitgroup created, int player) {
    int i;
    unit u;
    if (created == null) { return; }
    for (i = UnitGroupCount(created, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(created, i);
        if (u == null) { continue; }
        UnitGroupAdd(g_aprgTaldarimRaiders, u);
        APRG_OrderTaldarimUnit(u, player);
    }
}

void APRG_AddTaldarimGroup(int player, string unitType, int minimumCount, int maximumCount, bool air, bool halfWave) {
    int count;
    int owner;
    point p;
    unitgroup created;
    if (unitType == "" || !CatalogEntryIsValid(c_gameCatalogUnit, unitType)) { return; }
    if (air) { p = APRG_FindRaidOriginAirPoint(player); }
    else { p = APRG_FindRaidOriginGroundPoint(player); }
    if (p == null) { return; }
    owner = APRG_FindHostileOwnerNearPoint(player, p);
    if (owner < 0) { return; }
    count = RandomInt(minimumCount, maximumCount);
    if (halfWave) { count = MaxI(1, (count + 1) / 2); }
    created = UnitCreate(count, unitType, c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
    APRG_RegisterTaldarimGroup(created, player);
}

void APRG_SpawnTaldarimWave(int player, bool halfWave) {
    point alarakPoint;
    int alarakOwner;
    string mothershipType;
    string alarakType;
    unitgroup alarakGroup;
    mothershipType = APRG_TaldarimMothershipType();
    APRG_AddTaldarimGroup(player, mothershipType, 1, 4, true, halfWave);
    APRG_AddTaldarimGroup(player, "AP_Supplicant", 25, 35, false, halfWave);
    APRG_AddTaldarimGroup(player, "StalkerTaldarim", 15, 20, false, halfWave);
    APRG_AddTaldarimGroup(player, "DarkTemplarTaldarim", 2, 10, false, halfWave);
    APRG_AddTaldarimGroup(player, "HighTemplarTaldarim", 2, 10, false, halfWave);
    APRG_AddTaldarimGroup(player, "Monitor", 5, 15, false, halfWave);
    APRG_AddTaldarimGroup(player, "ImmortalTaldarim", 5, 10, false, halfWave);
    APRG_AddTaldarimGroup(player, "ColossusTaldarim", 3, 8, false, halfWave);
    APRG_AddTaldarimGroup(player, "VoidRayTaldarim", 5, 10, true, halfWave);
    alarakType = APRG_AlarakHeroType();
    if (!g_aprgTaldarimAlarakSpawned && alarakType != "") {
        alarakPoint = APRG_FindRaidOriginGroundPoint(player);
        if (alarakPoint != null) {
            alarakOwner = APRG_FindHostileOwnerNearPoint(player, alarakPoint);
            if (alarakOwner >= 0) {
                alarakGroup = UnitCreate(1, alarakType, c_unitCreateIgnorePlacement, alarakOwner, alarakPoint, libNtve_gf_RandomAngle());
                APRG_RegisterGeneratedHeroGroup(alarakGroup);
                APRG_RegisterTaldarimGroup(alarakGroup, player);
                g_aprgTaldarimAlarakSpawned = true;
            }
        }
    }
}

void APRG_RetargetTaldarimRaiders(int player, fixed now) {
    int i;
    unit u;
    if (g_aprgTaldarimRaiders == null || now < g_aprgNextTaldarimRetargetTime) { return; }
    g_aprgNextTaldarimRetargetTime = now + 30.0;
    for (i = UnitGroupCount(g_aprgTaldarimRaiders, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(g_aprgTaldarimRaiders, i);
        APRG_OrderTaldarimUnit(u, player);
    }
}

void APRG_TickTaldarimReinforcements(int player, fixed now) {
    if (!APRG_PlayerMacroBaseReady(player) || now < 1200.0) { return; }
    if (!g_aprgTaldarimAnnounced) {
        UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaChat, StringToText("[Slay] The Tal'Darim have arrived"));
        g_aprgTaldarimAnnounced = true;
        g_aprgNextTaldarimWaveTime = now;
        g_aprgNextTaldarimRetargetTime = now + 30.0;
    }
    if (now >= g_aprgNextTaldarimWaveTime) {
        APRG_SpawnTaldarimWave(player, g_aprgTaldarimWaveIndex > 0);
        g_aprgTaldarimWaveIndex += 1;
        g_aprgNextTaldarimWaveTime = now + 60.0;
    }
    APRG_RetargetTaldarimRaiders(player, now);
}


void APRG_ApplyGloriousMartyrs(point deathPoint, int player) {
    unitgroup nearby;
    int i;
    unit u;
    if (deathPoint == null || !CatalogEntryIsValid(c_gameCatalogBehavior, "APRogueGloriousMartyrStack")) { return; }
    nearby = UnitGroupAlliance(
        player,
        c_unitAllianceAlly,
        RegionCircle(deathPoint, 4.0),
        UnitFilter(
            0,
            0,
            (1 << c_targetFilterStructure) | (1 << c_targetFilterMissile),
            (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))
        ),
        0
    );
    for (i = UnitGroupCount(nearby, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(nearby, i);
        if (u == null || UnitGetOwner(u) != player) { continue; }
        UnitBehaviorAdd(u, "APRogueGloriousMartyrStack", u, 1);
    }
}

void APRG_TickGloriousMartyrs() {
    return;
}

int APRG_FindInflatableSlot(unit u) {
    int i;
    int freeSlot = -1;
    if (u == null) { return -1; }
    for (i = 0; i < APRG_MAX_INFLATABLE_UNITS; i += 1) {
        if (g_aprgInflatableUnits[i] == u) { return i; }
        if (freeSlot < 0 && g_aprgInflatableUnits[i] == null) { freeSlot = i; }
    }
    if (freeSlot >= 0) {
        g_aprgInflatableUnits[freeSlot] = u;
        g_aprgInflatableStacks[freeSlot] = 0;
        g_aprgInflatableBaseSpeed[freeSlot] = UnitGetPropertyFixed(u, c_unitPropMovementSpeed, c_unitPropCurrent);
    }
    return freeSlot;
}

void APRG_InflatableApplyWeaponStack(unit u, int stack, int player) {
    int wi;
    int j;
    int weaponCount;
    string weaponType;
    string effectType;
    string key;
    fixed damageBonus = 0.25;
    fixed previousBonus = 0.0;
    fixed stepBonus;
    fixed currentAmount;
    fixed baseAmount;
    if (stack > 10) {
        for (wi = 10; wi < stack; wi += 1) { damageBonus *= 0.5; }
    }
    for (j = 1; j < stack; j += 1) {
        stepBonus = 0.25;
        if (j > 10) {
            for (wi = 10; wi < j; wi += 1) { stepBonus *= 0.5; }
        }
        previousBonus += stepBonus;
    }
    weaponCount = UnitWeaponCount(u);
    for (wi = 1; wi <= weaponCount; wi += 1) {
        weaponType = UnitWeaponGet(u, wi);
        if (weaponType == "" || !CatalogEntryIsValid(c_gameCatalogWeapon, weaponType)) { continue; }
        key = "APRG_InflatableRange_" + IntToString(player) + "_" + weaponType + "_" + IntToString(stack);
        if (!DataTableGetBool(true, key)) {
            CatalogFieldValueModify(c_gameCatalogWeapon, weaponType, "Range", player, "0.1", c_upgradeOperationAdd);
            effectType = CatalogFieldValueGet(c_gameCatalogWeapon, weaponType, "DisplayEffect", player);
            if (effectType != "" && CatalogEntryIsValid(c_gameCatalogEffect, effectType)) {
                currentAmount = StringToFixed(CatalogFieldValueGet(c_gameCatalogEffect, effectType, "Amount", player));
                if (currentAmount > 0.0) {
                    baseAmount = currentAmount / (1.0 + previousBonus);
                    CatalogFieldValueSet(c_gameCatalogEffect, effectType, "Amount", player, FixedToString(currentAmount + baseAmount * damageBonus, c_fixedPrecisionAny));
                }
            }
            DataTableSetBool(true, key, true);
        }
    }
}

void APRG_ApplyInflatableStack(unit u, int slot, int player) {
    int stack;
    fixed oldMax;
    fixed life;
    fixed ratio;
    fixed oldShieldMax;
    fixed shields;
    fixed shieldRatio;
    fixed speed;
    fixed minimumSpeed;
    fixed visualScale;
    if (u == null || !UnitIsAlive(u) || slot < 0) { return; }
    stack = g_aprgInflatableStacks[slot] + 1;
    if (stack > 300) { return; }
    g_aprgInflatableStacks[slot] = stack;

    oldMax = UnitGetPropertyFixed(u, c_unitPropLifeMax, c_unitPropCurrent);
    life = UnitGetPropertyFixed(u, c_unitPropLife, c_unitPropCurrent);
    if (oldMax > 0.0) {
        ratio = life / oldMax;
        oldMax = oldMax / (1.0 + 0.15 * IntToFixed(stack - 1));
        UnitSetPropertyFixed(u, c_unitPropLifeMax, oldMax * (1.0 + 0.15 * IntToFixed(stack)));
        UnitSetPropertyFixed(u, c_unitPropLife, oldMax * (1.0 + 0.15 * IntToFixed(stack)) * ratio);
    }
    oldShieldMax = UnitGetPropertyFixed(u, c_unitPropShieldsMax, c_unitPropCurrent);
    shields = UnitGetPropertyFixed(u, c_unitPropShields, c_unitPropCurrent);
    if (oldShieldMax > 0.0) {
        shieldRatio = shields / oldShieldMax;
        oldShieldMax = oldShieldMax / (1.0 + 0.15 * IntToFixed(stack - 1));
        UnitSetPropertyFixed(u, c_unitPropShieldsMax, oldShieldMax * (1.0 + 0.15 * IntToFixed(stack)));
        UnitSetPropertyFixed(u, c_unitPropShields, oldShieldMax * (1.0 + 0.15 * IntToFixed(stack)) * shieldRatio);
    }

    APRG_InflatableApplyWeaponStack(u, stack, player);

    speed = UnitGetPropertyFixed(u, c_unitPropMovementSpeed, c_unitPropCurrent);
    minimumSpeed = g_aprgInflatableBaseSpeed[slot] * 0.05;
    if (stack < 20 && speed > minimumSpeed) {
        speed = speed * 0.955;
        if (speed < minimumSpeed) { speed = minimumSpeed; }
        UnitSetPropertyFixed(u, c_unitPropMovementSpeed, speed);
    }
    else if (stack >= 20 && minimumSpeed > 0.0) {
        UnitSetPropertyFixed(u, c_unitPropMovementSpeed, minimumSpeed);
    }
    if (APRG_HasExtension(APRG_EXT_BLESS_HORDE_MODE)) {
        visualScale = MinF(300.0, 50.0 + IntToFixed(stack) * 2.5);
    }
    else {
        visualScale = MinF(300.0, 100.0 + IntToFixed(stack) * 5.0);
    }
    UnitSetScale(u, visualScale, visualScale, visualScale);
}

void APRG_TickInflatableSoldiers(int player, fixed now) {
    unitgroup units;
    int i;
    unit u;
    int slot;
    if (now < g_aprgNextInflatableTime) { return; }
    g_aprgNextInflatableTime = now + 12.0;
    units = APRG_PlayerMobileUnits(player);
    for (i = UnitGroupCount(units, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null || UnitGetOwner(u) != player || APRG_IsWorkerTypeForDeath(UnitGetType(u))) { continue; }
        slot = APRG_FindInflatableSlot(u);
        if (slot >= 0) { APRG_ApplyInflatableStack(u, slot, player); }
    }
}

void APRG_ApplyDoubleTimeGroup(unitgroup units) {
    int i;
    int owner;
    int weaponIndex;
    int weaponCount;
    unit u;
    string unitType;
    string unitKey;
    string weaponType;
    string weaponKey;
    fixed speed;
    fixed period;
    for (i = UnitGroupCount(units, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null) { continue; }
        owner = UnitGetOwner(u);
        if (owner < 0) { continue; }
        unitType = UnitGetType(u);
        unitKey = "APRG_DoubleTimeCatalog_" + IntToString(owner) + "_" + unitType;
        if (!DataTableGetBool(true, unitKey)) {
            speed = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "Speed", owner));
            if (speed > 0.0) {
                CatalogFieldValueSet(c_gameCatalogUnit, unitType, "Speed", owner, FixedToString(speed * 2.0, c_fixedPrecisionAny));
            }
            DataTableSetBool(true, unitKey, true);
        }
        weaponCount = UnitWeaponCount(u);
        for (weaponIndex = 1; weaponIndex <= weaponCount; weaponIndex += 1) {
            weaponType = UnitWeaponGet(u, weaponIndex);
            if (weaponType == "") { continue; }
            weaponKey = "APRG_DoubleTimeWeapon_" + IntToString(owner) + "_" + weaponType;
            if (DataTableGetBool(true, weaponKey)) { continue; }
            period = StringToFixed(CatalogFieldValueGet(c_gameCatalogWeapon, weaponType, "Period", owner));
            if (period > 0.0) {
                CatalogFieldValueSet(c_gameCatalogWeapon, weaponType, "Period", owner, FixedToString(period * 0.5, c_fixedPrecisionAny));
            }
            DataTableSetBool(true, weaponKey, true);
        }
    }
}

void APRG_ApplyDoubleTime(int player) {
    APRG_ApplyDoubleTimeGroup(APRG_PlayerAllUnits(player));
    APRG_ApplyDoubleTimeGroup(APRG_EnemyAllUnits(player));
}

fixed APRG_ShrinkageFactor(int stacks) {
    if (stacks <= 0) { return 1.0; }
    if (stacks >= 50) { return 0.5; }
    return 1.0 - 0.01 * IntToFixed(stacks);
}

int APRG_FindShrinkageSlot(unit u, fixed now) {
    int i;
    int freeSlot = -1;
    unit existing;
    if (u == null) { return -1; }
    for (i = 0; i < APRG_MAX_SHRINKAGE_UNITS; i += 1) {
        existing = g_aprgShrinkageUnits[i];
        if (existing == u) { return i; }
        if (existing != null && !UnitIsAlive(existing)) {
            g_aprgShrinkageUnits[i] = null;
            g_aprgShrinkageUnitStacks[i] = 0;
            g_aprgShrinkageNextStackTime[i] = 0.0;
            existing = null;
        }
        if (freeSlot < 0 && existing == null) { freeSlot = i; }
    }
    if (freeSlot >= 0) {
        g_aprgShrinkageUnits[freeSlot] = u;
        g_aprgShrinkageUnitStacks[freeSlot] = 0;
        g_aprgShrinkageNextStackTime[freeSlot] = now + 6.0;
        UnitSetScale(u, 100.0, 100.0, 100.0);
    }
    return freeSlot;
}

void APRG_ApplyShrinkageUnitStack(unit u, int slot) {
    int oldStacks;
    int newStacks;
    fixed oldFactor;
    fixed newFactor;
    fixed stepFactor;
    fixed oldMax;
    fixed newMax;
    fixed life;
    fixed lifeRatio;
    fixed speed;
    fixed visualScale;
    if (u == null || !UnitIsAlive(u) || slot < 0 || g_aprgShrinkageUnitStacks[slot] >= 50) { return; }
    oldStacks = g_aprgShrinkageUnitStacks[slot];
    newStacks = oldStacks + 1;
    oldFactor = APRG_ShrinkageFactor(oldStacks);
    newFactor = APRG_ShrinkageFactor(newStacks);
    stepFactor = newFactor / oldFactor;

    oldMax = UnitGetPropertyFixed(u, c_unitPropLifeMax, c_unitPropCurrent);
    life = UnitGetPropertyFixed(u, c_unitPropLife, c_unitPropCurrent);
    if (oldMax > 0.0) {
        lifeRatio = life / oldMax;
        newMax = MaxF(1.0, oldMax * stepFactor);
        UnitSetPropertyFixed(u, c_unitPropLifeMax, newMax);
        UnitSetPropertyFixed(u, c_unitPropLife, MaxF(1.0, newMax * lifeRatio));
    }
    APRG_ScaleUnitShields(u, stepFactor);
    speed = UnitGetPropertyFixed(u, c_unitPropMovementSpeed, c_unitPropCurrent);
    if (speed > 0.0) { UnitSetPropertyFixed(u, c_unitPropMovementSpeed, speed * stepFactor); }
    if (CatalogEntryIsValid(c_gameCatalogBehavior, "APRogueShrinkageCombatStack")) {
        UnitBehaviorAdd(u, "APRogueShrinkageCombatStack", u, 1);
    }
    g_aprgShrinkageUnitStacks[slot] = newStacks;
    visualScale = 100.0 * newFactor;
    UnitSetScale(u, visualScale, visualScale, visualScale);
}

void APRG_TickShrinkage(int player, fixed now) {
    unitgroup units;
    int i;
    int slot;
    unit u;
    units = UnitGroup(
        null,
        player,
        RegionPlayableMap(),
        UnitFilter(
            0,
            0,
            (1 << c_targetFilterStructure) | (1 << c_targetFilterWorker) | (1 << c_targetFilterMissile),
            (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))
        ),
        0
    );
    for (i = UnitGroupCount(units, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null || UnitGetOwner(u) != player) { continue; }
        slot = APRG_FindShrinkageSlot(u, now);
        if (slot < 0) { continue; }
        while (g_aprgShrinkageUnitStacks[slot] < 50 && now >= g_aprgShrinkageNextStackTime[slot]) {
            APRG_ApplyShrinkageUnitStack(u, slot);
            g_aprgShrinkageNextStackTime[slot] += 6.0;
        }
    }
}

unit APRG_FindMineralThiefTarget(int player) {
    unitgroup resources;
    unitgroup candidates = UnitGroupEmpty();
    unitgroup workers = APRG_PlayerWorkers(player);
    unitgroup structures = APRG_PlayerStructures(player);
    int i;
    unit u;
    unit nearest;
    point p;
    resources = UnitGroup(
        null,
        c_playerAny,
        RegionPlayableMap(),
        UnitFilter(
            (1 << c_targetFilterHarvestableResource),
            0,
            (1 << c_targetFilterMissile),
            (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))
        ),
        0
    );
    for (i = UnitGroupCount(resources, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(resources, i);
        if (u == null) { continue; }
        if (CatalogFieldValueGet(c_gameCatalogUnit, UnitGetType(u), "ResourceType", c_playerAny) != "Minerals") { continue; }
        p = UnitGetPosition(u);
        nearest = UnitGroupClosestToPoint(workers, p);
        if (nearest != null && DistanceBetweenPoints(p, UnitGetPosition(nearest)) <= 12.0) {
            UnitGroupAdd(candidates, u);
            continue;
        }
        nearest = UnitGroupClosestToPoint(structures, p);
        if (nearest != null && DistanceBetweenPoints(p, UnitGetPosition(nearest)) <= 18.0) {
            UnitGroupAdd(candidates, u);
        }
    }
    if (UnitGroupCount(candidates, c_unitCountAlive) <= 0) { return null; }
    return UnitGroupRandomUnit(candidates, c_unitCountAlive);
}

fixed APRG_MineralThiefMaxCooldown(fixed now) {
    fixed maximum = 30.0 - 3.0 * IntToFixed(FixedToInt(now / 60.0));
    return MaxF(2.0, maximum);
}

void APRG_TickMineralThieves(int player, fixed now) {
    unit target;
    point targetPoint;
    point spawnPoint;
    int owner;
    int amount;
    fixed maximum;
    if (now < g_aprgNextMineralThiefTime || !APRG_PlayerMacroBaseReady(player)) { return; }
    target = APRG_FindMineralThiefTarget(player);
    maximum = APRG_MineralThiefMaxCooldown(now);
    g_aprgNextMineralThiefTime = now + RandomFixed(1.0, maximum);
    if (target == null || !CatalogEntryIsValid(c_gameCatalogUnit, "MULE")) { return; }
    targetPoint = UnitGetPosition(target);
    spawnPoint = APRG_FindGroundPointNear(targetPoint, 1.0, 3.0);
    if (spawnPoint == null) { spawnPoint = targetPoint; }
    owner = APRG_FindHostileOwnerNearPoint(player, targetPoint);
    if (owner < 0) { return; }
    if (!APRG_QueueRealDropPod(APRG_DROP_KIND_MINERAL_THIEF, owner, spawnPoint, target)
        && CatalogEntryIsValid(c_gameCatalogEffect, "AP_CalldownMULECreateUnit")) {
        PlayerCreateEffectUnit(owner, "AP_CalldownMULECreateUnit", target);
    }
    amount = UnitGetPropertyInt(target, c_unitPropResources, c_unitPropCurrent);
    if (amount > 0) { UnitSetPropertyInt(target, c_unitPropResources, MaxI(0, amount - 30)); }
}

int APRG_FindActiveEnemySlot(unit u, fixed now) {
    int i;
    int freeSlot = -1;
    unit existing;
    if (u == null) { return -1; }
    for (i = 0; i < APRG_MAX_ACTIVE_ENEMIES; i += 1) {
        existing = g_aprgActiveEnemyUnits[i];
        if (existing == u) { return i; }
        if (existing != null && !UnitIsAlive(existing)) {
            g_aprgActiveEnemyUnits[i] = null;
            g_aprgActiveEnemyNextTime[i] = 0.0;
            existing = null;
        }
        if (freeSlot < 0 && existing == null) { freeSlot = i; }
    }
    if (freeSlot >= 0) {
        g_aprgActiveEnemyUnits[freeSlot] = u;
        g_aprgActiveEnemyNextTime[freeSlot] = 0.0;
    }
    return freeSlot;
}

void APRG_AssignActiveEnemyPatrol(unit u) {
    point destination;
    point origin;
    if (u == null || !UnitIsAlive(u)) { return; }
    AISetUnitScriptControlled(u, false);
    destination = APRG_FindRandomGroundPoint();
    if (destination == null) { return; }
    origin = UnitGetPosition(u);
    UnitIssueOrder(u, OrderTargetingPoint(AbilityCommand("attack", 0), destination), c_orderQueueReplace);
    UnitIssueOrder(u, OrderTargetingPoint(AbilityCommand("attack", 0), origin), c_orderQueueAddToEnd);
    UnitIssueOrder(u, OrderTargetingPoint(AbilityCommand("attack", 0), destination), c_orderQueueAddToEnd);
    UnitIssueOrder(u, OrderTargetingPoint(AbilityCommand("attack", 0), origin), c_orderQueueAddToEnd);
}

void APRG_TickActiveEnemies(int player, fixed now) {
    unitgroup enemies;
    int i;
    int scanned;
    int slot;
    int chosenSlot = -1;
    unit u;
    fixed speed;
    if (!APRG_PlayerMacroBaseReady(player) || now < g_aprgMacroReadyTime + 120.0) { return; }

    if (now >= g_aprgNextActiveEnemyScanTime) {
        g_aprgNextActiveEnemyScanTime = now + 5.0;
        enemies = APRG_EnemyMobileUnits(player);
        for (i = UnitGroupCount(enemies, c_unitCountAlive); i > 0; i -= 1) {
            u = UnitGroupUnitFromEnd(enemies, i);
            if (u == null || APRG_IsScriptedPurifier(u)) { continue; }
            speed = UnitGetPropertyFixed(u, c_unitPropMovementSpeed, c_unitPropCurrent);
            if (speed <= 0.0) { continue; }
            APRG_FindActiveEnemySlot(u, now);
        }
    }

    if (now < g_aprgNextActiveEnemyOrderTime) { return; }
    g_aprgNextActiveEnemyOrderTime = now + 1.0;

    for (scanned = 0; scanned < APRG_MAX_ACTIVE_ENEMIES; scanned += 1) {
        slot = (g_aprgActiveEnemyCursor + scanned) % APRG_MAX_ACTIVE_ENEMIES;
        u = g_aprgActiveEnemyUnits[slot];
        if (u == null || !UnitIsAlive(u) || APRG_IsScriptedPurifier(u) || g_aprgActiveEnemyNextTime[slot] > 0.0) { continue; }
        speed = UnitGetPropertyFixed(u, c_unitPropMovementSpeed, c_unitPropCurrent);
        if (speed <= 0.0 || UnitOrderCount(u) > 0) { continue; }
        chosenSlot = slot;
        break;
    }

    if (chosenSlot < 0) {
        for (scanned = 0; scanned < APRG_MAX_ACTIVE_ENEMIES; scanned += 1) {
            slot = (g_aprgActiveEnemyCursor + scanned) % APRG_MAX_ACTIVE_ENEMIES;
            u = g_aprgActiveEnemyUnits[slot];
            if (u == null || !UnitIsAlive(u) || APRG_IsScriptedPurifier(u) || g_aprgActiveEnemyNextTime[slot] <= 0.0) { continue; }
            speed = UnitGetPropertyFixed(u, c_unitPropMovementSpeed, c_unitPropCurrent);
            if (speed <= 0.0 || UnitOrderCount(u) > 0) { continue; }
            chosenSlot = slot;
            break;
        }
    }

    if (chosenSlot < 0) { return; }
    u = g_aprgActiveEnemyUnits[chosenSlot];
    if (!APRG_TryGeneratedHeroAbility(u, player)) {
        APRG_AssignActiveEnemyPatrol(u);
    }
    g_aprgActiveEnemyNextTime[chosenSlot] = now;
    g_aprgActiveEnemyCursor = (chosenSlot + 1) % APRG_MAX_ACTIVE_ENEMIES;
}

bool APRG_IsZergTownHallType(string unitType) {
    if (StringContains(unitType, "HiveMindEmulator", c_stringAnywhere, c_stringNoCase)) { return false; }
    return StringContains(unitType, "Hatchery", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Lair", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Hive", c_stringAnywhere, c_stringNoCase);
}

void APRG_TickInfiniteLarva(int player, fixed now) {
    unitgroup bases;
    int i;
    unit base;
    int localLarva;
    if (!APRG_PlayerMacroBaseReady(player) || now < g_aprgNextInfiniteLarvaTime) { return; }
    g_aprgNextInfiniteLarvaTime = now + 1.0;
    bases = APRG_PlayerStructures(player);
    for (i = UnitGroupCount(bases, c_unitCountAlive); i > 0; i -= 1) {
        base = UnitGroupUnitFromEnd(bases, i);
        if (base == null || UnitGetOwner(base) != player || !APRG_IsZergTownHallType(UnitGetType(base))) { continue; }
        localLarva = APRG_CountNearbyLarva(base, player, 8.0);
        if (localLarva >= 19) { continue; }

        APRG_TriggerNativeLarvaInjection(base);
    }
}

point APRG_FindMiraCampPoint(int player) {
    int attempt;
    point candidate;
    unit home;
    unit nearestEnemy;
    unitgroup enemies = APRG_EnemyAllUnits(player);
    home = APRG_FindPlayerHomeStructure(player);
    if (home == null) { return null; }

    for (attempt = 0; attempt < APRG_MAX_POINT_ATTEMPTS; attempt += 1) {
        candidate = RegionRandomPoint(RegionPlayableMap());
        if (candidate == null || !PointPathingPassable(candidate)) { continue; }
        // These groups contain many mercenaries. Keep a generous camp-center
        // buffer so their placement footprint remains >20 from *every*
        // player-owned or player-allied building, not just the home base.
        if (APRG_PointNearPlayerOrAlliedBuilding(candidate, player, 40.0)) { continue; }
        if (APRG_GroundSpawnsNeedPlayerPathing() && !PointPathingIsConnected(candidate, UnitGetPosition(home))) { continue; }
        nearestEnemy = UnitGroupClosestToPoint(enemies, candidate);
        if (nearestEnemy != null && DistanceBetweenPoints(candidate, UnitGetPosition(nearestEnemy)) < 18.0) { continue; }
        return candidate;
    }
    // No unsafe fallback near the player base; retry on the next tick.
    return null;
}

void APRG_AddMiraMercenaryType(int owner, string unitType, int count, point p, int player) {
    unitgroup created;
    int i;
    unit u;
    if (count <= 0 || p == null || !CatalogEntryIsValid(c_gameCatalogUnit, unitType)) { return; }
    created = UnitCreate(count, unitType, c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
    UnitGroupAddUnitGroup(g_aprgMiraMercenaries, created);
    for (i = UnitGroupCount(created, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(created, i);
        if (u == null) { break; }
        AISetUnitScriptControlled(u, true);
    }
}

void APRG_SpawnMiraMercenaries(int player) {
    int owner;
    point campPoint;
    if (g_aprgMiraMercenariesSpawned || !APRG_PlayerMacroBaseReady(player)) { return; }
    campPoint = APRG_FindMiraCampPoint(player);
    if (campPoint == null) { return; }
    owner = APRG_FindHostileOwnerNearPoint(player, campPoint);
    if (owner < 0) { return; }

    APRG_AddMiraMercenaryType(owner, "SiegeBreaker", 6, campPoint, player);
    APRG_AddMiraMercenaryType(owner, "SpartanCompany", 10, campPoint, player);
    APRG_AddMiraMercenaryType(owner, "WarPig", 20, campPoint, player);
    APRG_AddMiraMercenaryType(owner, "HammerSecurity", 10, campPoint, player);
    APRG_AddMiraMercenaryType(owner, "HelsAngelFighter", 5, campPoint, player);
    APRG_AddMiraMercenaryType(owner, "DevilDog", 5, campPoint, player);
    APRG_AddMiraMercenaryType(owner, "DuskWing", 2, campPoint, player);
    g_aprgMiraMercenariesSpawned = true;
    g_aprgNextMiraAttackTime = GameGetMissionTime() + 60.0;
}

void APRG_TickMiraMercenaries(int player) {
    int i;
    int attempt;
    unit u;
    unit first;
    unit second;
    unit target;
    int minerals;
    fixed now;
    if (!g_aprgMiraMercenariesSpawned) { APRG_SpawnMiraMercenaries(player); }
    if (!g_aprgMiraMercenariesSpawned || g_aprgMiraMercenariesPurchased) { return; }
    now = GameGetMissionTime();
    if (g_aprgNextMiraAttackTime >= 0.0 && now >= g_aprgNextMiraAttackTime) {
        first = UnitGroupRandomUnit(g_aprgMiraMercenaries, c_unitCountAlive);
        second = null;
        for (attempt = 0; attempt < 8; attempt += 1) {
            u = UnitGroupRandomUnit(g_aprgMiraMercenaries, c_unitCountAlive);
            if (u != null && u != first) { second = u; break; }
        }
        target = APRG_RandomPlayerStructure(player);
        if (first != null && target != null) {
            UnitIssueOrder(first, OrderTargetingPoint(AbilityCommand("attack", 0), UnitGetPosition(target)), c_orderQueueReplace);
        }
        target = APRG_RandomPlayerStructure(player);
        if (second != null && target != null) {
            UnitIssueOrder(second, OrderTargetingPoint(AbilityCommand("attack", 0), UnitGetPosition(target)), c_orderQueueReplace);
        }
        g_aprgNextMiraAttackTime = now + 60.0;
    }
    minerals = PlayerGetPropertyInt(player, c_playerPropMinerals);
    if (minerals < 6000) { return; }
    PlayerModifyPropertyInt(player, c_playerPropMinerals, c_playerPropOperSetTo, minerals - 6000);
    for (i = UnitGroupCount(g_aprgMiraMercenaries, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(g_aprgMiraMercenaries, i);
        if (u == null) { break; }
        UnitSetOwner(u, player, true);
        AISetUnitScriptControlled(u, false);
    }
    g_aprgMiraMercenariesPurchased = true;
    UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaChat, StringToText("[Slay] Mira's mercenaries purchased for 6000 minerals."));
}

void APRG_ApplyTacticalBinoculars(int player) {
    unitgroup enemies;
    unit u;
    int i;
    int owner;
    int weaponIndex;
    int weaponCount;
    string weaponType;
    string key;
    enemies = APRG_EnemyAllUnits(player);
    i = UnitGroupCount(enemies, c_unitCountAlive);
    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(enemies, i);
        if (u == null) { break; }
        owner = UnitGetOwner(u);
        weaponCount = UnitWeaponCount(u);
        for (weaponIndex = 1; weaponIndex <= weaponCount; weaponIndex += 1) {
            weaponType = UnitWeaponGet(u, weaponIndex);
            if (weaponType == "") { continue; }
            key = "APRG_Binoculars_" + IntToString(owner) + "_" + weaponType;
            if (DataTableGetBool(true, key)) { continue; }
            CatalogFieldValueModify(c_gameCatalogWeapon, weaponType, "Range", owner, "2.0", c_upgradeOperationMultiply);
            DataTableSetBool(true, key, true);
        }
    }
}

void APRG_TickEnemyRespawns(fixed now) {
    int i;
    unitgroup created;
    for (i = 0; i < APRG_MAX_RESPAWN_QUEUE; i += 1) {
        if (g_aprgRespawnState[i] == 0 || now < g_aprgRespawnTime[i]) { continue; }
        if (g_aprgRespawnPoint[i] != null && CatalogEntryIsValid(c_gameCatalogUnit, g_aprgRespawnType[i])) {
            created = UnitCreate(1, g_aprgRespawnType[i], c_unitCreateIgnorePlacement, g_aprgRespawnOwner[i], g_aprgRespawnPoint[i], libNtve_gf_RandomAngle());
            APRG_RegisterMutationEnemyGroup(created);
        }
        g_aprgRespawnState[i] = 0;
        g_aprgRespawnType[i] = "";
        g_aprgRespawnOwner[i] = -1;
        g_aprgRespawnPoint[i] = null;
        g_aprgRespawnTime[i] = 0.0;
    }
}


unit APRG_RandomPlayerStructure(int player) {
    unitgroup structures = APRG_PlayerStructures(player);
    int i;
    unit u;
    for (i = UnitGroupCount(structures, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(structures, i);
        if (u != null && UnitTestState(u, c_unitStateInvulnerable)) { UnitGroupRemove(structures, u); }
    }
    if (UnitGroupCount(structures, c_unitCountAlive) <= 0) { return null; }
    return UnitGroupRandomUnit(structures, c_unitCountAlive);
}

string APRG_DehakaPackType(int kind) {
    if (kind == 0) {
        if (CatalogEntryIsValid(c_gameCatalogUnit, "PrimalZergling")) { return "PrimalZergling"; }
        if (CatalogEntryIsValid(c_gameCatalogUnit, "DehakaZerglingLevel2")) { return "DehakaZerglingLevel2"; }
        if (CatalogEntryIsValid(c_gameCatalogUnit, "DehakaZergling")) { return "DehakaZergling"; }
    }
    else if (kind == 1) {
        if (CatalogEntryIsValid(c_gameCatalogUnit, "PrimalHydralisk")) { return "PrimalHydralisk"; }
        if (CatalogEntryIsValid(c_gameCatalogUnit, "DehakaHydraliskLevel2")) { return "DehakaHydraliskLevel2"; }
        if (CatalogEntryIsValid(c_gameCatalogUnit, "DehakaHydralisk")) { return "DehakaHydralisk"; }
    }
    else if (kind == 2) {
        if (CatalogEntryIsValid(c_gameCatalogUnit, "PrimalRoach")) { return "PrimalRoach"; }
        if (CatalogEntryIsValid(c_gameCatalogUnit, "DehakaRoachLevel2")) { return "DehakaRoachLevel2"; }
        if (CatalogEntryIsValid(c_gameCatalogUnit, "DehakaRoach")) { return "DehakaRoach"; }
    }
    else if (kind == 3) {
        if (CatalogEntryIsValid(c_gameCatalogUnit, "PrimalMutalisk")) { return "PrimalMutalisk"; }
        if (CatalogEntryIsValid(c_gameCatalogUnit, "DehakaMutaliskLevel3")) { return "DehakaMutaliskLevel3"; }
        if (CatalogEntryIsValid(c_gameCatalogUnit, "DehakaMutalisk")) { return "DehakaMutalisk"; }
    }
    else if (kind == 4) {
        if (CatalogEntryIsValid(c_gameCatalogUnit, "PrimalUltralisk")) { return "PrimalUltralisk"; }
        if (CatalogEntryIsValid(c_gameCatalogUnit, "DehakaUltraliskLevel2")) { return "DehakaUltraliskLevel2"; }
        if (CatalogEntryIsValid(c_gameCatalogUnit, "DehakaUltralisk")) { return "DehakaUltralisk"; }
    }
    return "";
}

void APRG_OrderDehakaPackUnit(unit u, int player) {
    unit target;
    if (u == null || !UnitIsAlive(u)) { return; }
    target = APRG_RandomPlayerStructure(player);
    if (target == null) { return; }
    APRG_OrderAttackMove(u, UnitGetPosition(target));
}

void APRG_SpawnDehakaPackUnit(int player, string unitType) {
    unit anchor;
    point p;
    int owner;
    unitgroup created;
    unit u;
    if (unitType == "" || !CatalogEntryIsValid(c_gameCatalogUnit, unitType)) { return; }
    anchor = APRG_RandomPathableHostileBaseAnchor(player);
    if (anchor == null) { return; }
    p = APRG_FindGroundPointNear(UnitGetPosition(anchor), 2.0, 12.0);
    if (p == null) { p = UnitGetPosition(anchor); }
    owner = UnitGetOwner(anchor);
    created = UnitCreate(1, unitType, c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
    u = UnitGroupUnitFromEnd(created, 1);
    if (u == null) { return; }
    UnitGroupAdd(g_aprgDehakaPackUnits, u);
    APRG_OrderDehakaPackUnit(u, player);
}

void APRG_SpawnDehakaPackWave(int player) {
    int i;
    int count;
    string unitType;
    unitType = APRG_DehakaPackType(0);
    count = RandomInt(0, 8);
    for (i = 0; i < count; i += 1) { APRG_SpawnDehakaPackUnit(player, unitType); }
    unitType = APRG_DehakaPackType(1);
    count = RandomInt(0, 2);
    for (i = 0; i < count; i += 1) { APRG_SpawnDehakaPackUnit(player, unitType); }
    unitType = APRG_DehakaPackType(2);
    count = RandomInt(0, 2);
    for (i = 0; i < count; i += 1) { APRG_SpawnDehakaPackUnit(player, unitType); }
    unitType = APRG_DehakaPackType(3);
    count = RandomInt(0, 2);
    for (i = 0; i < count; i += 1) { APRG_SpawnDehakaPackUnit(player, unitType); }
    unitType = APRG_DehakaPackType(4);
    count = 0;
    if (RandomInt(1, 100) > 75) { count = 1; }
    for (i = 0; i < count; i += 1) { APRG_SpawnDehakaPackUnit(player, unitType); }
}

void APRG_EnableDehakaPackHeroAbilities(unit hero) {
    int owner;
    int commandIndex;
    if (hero == null) { return; }
    owner = UnitGetOwner(hero);

    if (CatalogEntryIsValid(c_gameCatalogAbil, "Drag")) {
        if (!UnitAbilityExists(hero, "Drag")) { UnitAbilityAdd(hero, "Drag"); }
        UnitAbilityEnable(hero, "Drag", true);
        for (commandIndex = 0; commandIndex < 4; commandIndex += 1) {
            TechTreeAbilityAllow(owner, AbilityCommand("Drag", commandIndex), true);
        }
    }
    if (CatalogEntryIsValid(c_gameCatalogAbil, "DehakaHeal")) {
        if (!UnitAbilityExists(hero, "DehakaHeal")) { UnitAbilityAdd(hero, "DehakaHeal"); }
        UnitAbilityEnable(hero, "DehakaHeal", true);
        for (commandIndex = 0; commandIndex < 4; commandIndex += 1) {
            TechTreeAbilityAllow(owner, AbilityCommand("DehakaHeal", commandIndex), true);
        }
    }
    if (CatalogEntryIsValid(c_gameCatalogAbil, "DehakaMirrorImage")) {
        if (!UnitAbilityExists(hero, "DehakaMirrorImage")) { UnitAbilityAdd(hero, "DehakaMirrorImage"); }
        UnitAbilityEnable(hero, "DehakaMirrorImage", true);
        for (commandIndex = 0; commandIndex < 4; commandIndex += 1) {
            TechTreeAbilityAllow(owner, AbilityCommand("DehakaMirrorImage", commandIndex), true);
        }
    }
}

void APRG_SpawnDehakaPackHero(int player) {
    unit anchor;
    point p;
    int owner;
    unitgroup created;
    if (!CatalogEntryIsValid(c_gameCatalogUnit, "Dehaka")) { return; }
    anchor = APRG_RandomPathableHostileBaseAnchor(player);
    if (anchor == null) { return; }
    p = APRG_FindGroundPointNear(UnitGetPosition(anchor), 2.0, 12.0);
    if (p == null) { p = UnitGetPosition(anchor); }
    owner = UnitGetOwner(anchor);
    created = UnitCreate(1, "Dehaka", c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
    g_aprgDehakaPackHero = UnitGroupUnitFromEnd(created, 1);
    if (g_aprgDehakaPackHero == null) { return; }
    APRG_RegisterAlwaysVisibleUnit(g_aprgDehakaPackHero, player);
    APRG_EnableDehakaPackHeroAbilities(g_aprgDehakaPackHero);
    UnitGroupAdd(g_aprgDehakaPackUnits, g_aprgDehakaPackHero);
    APRG_OrderDehakaPackUnit(g_aprgDehakaPackHero, player);
}

fixed APRG_DehakaPackInterval(fixed elapsed) {
    if (elapsed >= 720.0) { return 6.0; }
    if (elapsed >= 540.0) { return 8.0; }
    if (elapsed >= 360.0) { return 12.0; }
    return 20.0;
}

void APRG_RetargetDehakaPack(int player) {
    int i;
    unit u;
    for (i = UnitGroupCount(g_aprgDehakaPackUnits, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(g_aprgDehakaPackUnits, i);
        if (u != null && UnitIsAlive(u)) { APRG_OrderDehakaPackUnit(u, player); }
    }
}

void APRG_TickDehakasPack(int player, fixed now) {
    fixed elapsed;
    fixed interval;
    if (!APRG_PlayerMacroBaseReady(player) || g_aprgMacroReadyTime < 0.0) { return; }
    elapsed = now - g_aprgMacroReadyTime;
    if (g_aprgNextDehakaPackTime < 0.0) { g_aprgNextDehakaPackTime = g_aprgMacroReadyTime + 180.0; }
    if (g_aprgNextDehakaRetargetTime < 0.0) { g_aprgNextDehakaRetargetTime = g_aprgMacroReadyTime + 180.0; }
    if (g_aprgNextDehakaHeroCheckTime < 0.0) { g_aprgNextDehakaHeroCheckTime = g_aprgMacroReadyTime + 300.0; }
    if (now >= g_aprgNextDehakaPackTime) {
        APRG_SpawnDehakaPackWave(player);
        interval = APRG_DehakaPackInterval(elapsed);
        g_aprgNextDehakaPackTime = now + interval;
    }
    if (now >= g_aprgNextDehakaRetargetTime) {
        APRG_RetargetDehakaPack(player);
        g_aprgNextDehakaRetargetTime = now + 30.0;
    }
    if (now >= g_aprgNextDehakaHeroCheckTime) {
        if (g_aprgDehakaPackHero == null || !UnitIsAlive(g_aprgDehakaPackHero)) { APRG_SpawnDehakaPackHero(player); }
        g_aprgNextDehakaHeroCheckTime = now + 180.0;
    }
}

point APRG_FindDeepEnemyAirPoint(int player) {
    unitgroup structures;
    unit home;
    unit u;
    unit chosen;
    int i;
    int eligible = 0;
    int tries = 0;
    fixed distance;
    fixed maxDistance = -1.0;
    fixed threshold;
    point candidate;
    structures = APRG_EnemyStructures(player);
    home = APRG_FindPlayerHomeStructure(player);
    if (UnitGroupCount(structures, c_unitCountAlive) <= 0) { return null; }
    if (home == null) {
        chosen = UnitGroupRandomUnit(structures, c_unitCountAlive);
        if (chosen == null) { return null; }
    }
    else {
        for (i = UnitGroupCount(structures, c_unitCountAlive); i > 0; i -= 1) {
            u = UnitGroupUnitFromEnd(structures, i);
            if (u == null) { continue; }
            distance = DistanceBetweenPoints(UnitGetPosition(u), UnitGetPosition(home));
            if (distance > maxDistance) { maxDistance = distance; }
        }
        if (maxDistance < 0.0) { return null; }
        threshold = maxDistance * 0.70;
        for (i = UnitGroupCount(structures, c_unitCountAlive); i > 0; i -= 1) {
            u = UnitGroupUnitFromEnd(structures, i);
            if (u == null) { continue; }
            distance = DistanceBetweenPoints(UnitGetPosition(u), UnitGetPosition(home));
            if (distance < threshold) { continue; }
            eligible += 1;
            if (RandomInt(1, eligible) == 1) { chosen = u; }
        }
        if (chosen == null) { return null; }
    }
    candidate = PointWithOffsetPolar(UnitGetPosition(chosen), RandomFixed(5.0, 18.0), libNtve_gf_RandomAngle());
    for (tries = 0; tries < 8; tries += 1) {
        if (
            candidate != null &&
            APRG_AirSpawnPointAllowed(candidate) &&
            !APRG_PointNearRakShirDuel(candidate, 24.0) &&
            (g_aprgRaynorSafePoint == null || DistanceBetweenPoints(candidate, g_aprgRaynorSafePoint) >= 10.0)
        ) { return candidate; }
        candidate = PointWithOffsetPolar(UnitGetPosition(chosen), RandomFixed(5.0, 18.0), libNtve_gf_RandomAngle());
    }
    return null;
}

void APRG_TickRaynorRepairSCVs(unit target) {
    unit scv;
    int i;
    fixed life;
    fixed maximum;
    fixed distance;
    bool repairerNear = false;
    bool normalRepairObserved = false;
    if (target == null || !UnitIsAlive(target)) { return; }
    life = UnitGetPropertyFixed(target, c_unitPropLife, c_unitPropCurrent);
    maximum = UnitGetPropertyFixed(target, c_unitPropLifeMax, c_unitPropCurrent);
    if (g_aprgRaynorLastObservedLife >= 0.0 && life > g_aprgRaynorLastObservedLife + 0.05) { normalRepairObserved = true; }
    for (i = UnitGroupCount(g_aprgRaynorRepairSCVs, c_unitCountAlive); i > 0; i -= 1) {
        scv = UnitGroupUnitFromEnd(g_aprgRaynorRepairSCVs, i);
        if (scv == null || !UnitIsAlive(scv)) { continue; }
        AISetUnitScriptControlled(scv, true);
        distance = DistanceBetweenPoints(UnitGetPosition(scv), UnitGetPosition(target));
        if (UnitOrderCount(scv) <= 0) {
            UnitIssueOrder(scv, OrderTargetingUnit(AbilityCommand("Repair", 0), target), c_orderQueueReplace);
        }
        if (distance <= 6.0) { repairerNear = true; }
    }
    if (life >= maximum || normalRepairObserved) {
        g_aprgRaynorRepairStallTicks = 0;
    }
    else if (repairerNear && g_aprgRaynorFlybyState == 0) {
        g_aprgRaynorRepairStallTicks += 1;
        if (g_aprgRaynorRepairStallTicks >= 3) {
            life = MinF(maximum, life + 7.5);
            UnitSetPropertyFixed(target, c_unitPropLife, life);
            g_aprgRaynorRepairStallTicks = 2;
        }
    }
    else {
        g_aprgRaynorRepairStallTicks = 0;
    }
    g_aprgRaynorLastObservedLife = UnitGetPropertyFixed(target, c_unitPropLife, c_unitPropCurrent);
}

void APRG_NormalizeRaynorHyperionDurability(unit hyperion, int owner) {
    int i;
    string behavior;
    if (hyperion == null) { return; }

    for (i = UnitBehaviorCountAll(hyperion); i >= 1; i -= 1) {
        behavior = UnitBehaviorGet(hyperion, i);
        if (
            StringContains(behavior, "DamageResponse", c_stringAnywhere, c_stringNoCase) ||
            StringContains(behavior, "DamageReduction", c_stringAnywhere, c_stringNoCase) ||
            StringContains(behavior, "DamageRedux", c_stringAnywhere, c_stringNoCase) ||
            StringContains(behavior, "DivineArmor", c_stringAnywhere, c_stringNoCase) ||
            StringContains(behavior, "Hardened", c_stringAnywhere, c_stringNoCase) ||
            StringContains(behavior, "Invulner", c_stringAnywhere, c_stringNoCase) ||
            StringContains(behavior, "Regener", c_stringAnywhere, c_stringNoCase) ||
            StringContains(behavior, "LifeRegen", c_stringAnywhere, c_stringNoCase)
        ) {
            UnitBehaviorRemove(hyperion, behavior, c_unitBehaviorCountAll);
        }
    }
    CatalogFieldValueSet(c_gameCatalogUnit, UnitGetType(hyperion), "LifeArmor", owner, "3");
    if (!DataTableGetBool(true, "APRG_RaynorHyperionRepairTime_" + IntToString(owner))) {
        CatalogFieldValueModify(c_gameCatalogUnit, UnitGetType(hyperion), "RepairTime", owner, "2.0", c_upgradeOperationMultiply);
        DataTableSetBool(true, "APRG_RaynorHyperionRepairTime_" + IntToString(owner), true);
    }
    UnitSetPropertyFixed(hyperion, c_unitPropLifeMax, 3000.0);
    UnitSetPropertyFixed(hyperion, c_unitPropLife, 3000.0);
    UnitSetPropertyFixed(hyperion, c_unitPropLifeRegen, 0.0);
    if (UnitGetPropertyFixed(hyperion, c_unitPropMovementSpeed, c_unitPropCurrent) < 0.2) {
        UnitSetPropertyFixed(hyperion, c_unitPropMovementSpeed, 1.875);
    }
}

void APRG_ApplyRaynorHyperionStructureDamage(unit hyperion, int owner) {
    int wi;
    int wc;
    string weaponType;
    string effectType;
    string key;
    fixed amount;
    fixed structureBonus;
    fixed desiredBonus;
    if (hyperion == null || UnitGetType(hyperion) != "Hyperion") { return; }
    wc = UnitWeaponCount(hyperion);
    for (wi = 1; wi <= wc; wi += 1) {
        weaponType = UnitWeaponGet(hyperion, wi);
        if (weaponType == "") { continue; }
        effectType = CatalogFieldValueGet(c_gameCatalogWeapon, weaponType, "DisplayEffect", owner);
        if (effectType == "" || !CatalogEntryIsValid(c_gameCatalogEffect, effectType)) { continue; }
        key = "APRG_RaynorHyperionStructureDamage_" + IntToString(owner) + "_" + effectType;
        if (DataTableGetBool(true, key)) { continue; }
        amount = StringToFixed(CatalogFieldValueGet(c_gameCatalogEffect, effectType, "Amount", owner));
        structureBonus = StringToFixed(CatalogFieldValueGet(c_gameCatalogEffect, effectType, "AttributeBonus[Structure]", owner));
        if (amount > 0.0) {
            desiredBonus = ((amount + structureBonus) * 0.5) - amount;
            CatalogFieldValueSet(c_gameCatalogEffect, effectType, "AttributeBonus[Structure]", owner, FixedToString(desiredBonus, c_fixedPrecisionAny));
        }
        DataTableSetBool(true, key, true);
    }
}

unit APRG_RaynorFlybyTarget(int player) {
    unit target;
    if (g_aprgRaynorHyperion == null) { return null; }

    target = APRG_FindPlayerHomeStructure(player);
    if (target != null && UnitIsAlive(target)) { return target; }

    return APRG_RandomPlayerStructure(player);
}

// Raynor's Raiders Hyperion must fly using the ordinary SC2 move order. Do
// not teleport/nudge it when progress is slow: Time Stop legitimately freezes
// the unit, and a movement watchdog would move it despite being frozen.
void APRG_RaynorMoveToward(point destination, fixed now) {
    if (g_aprgRaynorHyperion == null || destination == null || !UnitIsAlive(g_aprgRaynorHyperion)) { return; }
    if (now >= g_aprgRaynorNextMoveRefreshTime) {
        UnitIssueOrder(g_aprgRaynorHyperion, OrderTargetingPoint(AbilityCommand("move", 0), destination), c_orderQueueReplace);
        g_aprgRaynorNextMoveRefreshTime = now + 3.0;
    }
}
void APRG_RaynorBeginMove(point destination, fixed now) {
    if (destination == null || g_aprgRaynorHyperion == null) { return; }
    g_aprgRaynorNextMoveRefreshTime = now;
    APRG_RaynorMoveToward(destination, now);
}

void APRG_TickRaynorsRaiders(int player, fixed now) {
    unit anchor;
    unit target;
    unitgroup created;
    point p;
    point dropPoint;
    int owner;
    int i;
    string hyperionType;
    fixed raynorLife;
    fixed raynorMax;
    if (!APRG_PlayerMacroBaseReady(player) || g_aprgRaynorDestroyed) { return; }

    if (!g_aprgRaynorStarted) {
        anchor = APRG_RandomHostileBaseAnchor(player);
        if (anchor == null) { return; }
        hyperionType = "";
        if (CatalogEntryIsValid(c_gameCatalogUnit, "Hyperion")) { hyperionType = "Hyperion"; }
        else if (CatalogEntryIsValid(c_gameCatalogUnit, "Battlecruiser")) { hyperionType = "Battlecruiser"; }
        if (hyperionType == "") { return; }
        owner = UnitGetOwner(anchor);
        p = APRG_FindDeepEnemyAirPoint(player);
        if (p == null) { p = UnitGetPosition(anchor); }
        created = UnitCreate(1, hyperionType, c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
        g_aprgRaynorHyperion = UnitGroupUnitFromEnd(created, 1);
        if (g_aprgRaynorHyperion == null) { return; }
        APRG_StripVoidEntityBehavior(g_aprgRaynorHyperion);
        if (hyperionType == "Hyperion") {
            APRG_NormalizeRaynorHyperionDurability(g_aprgRaynorHyperion, owner);
            APRG_ApplyRaynorHyperionStructureDamage(g_aprgRaynorHyperion, owner);
        }
        APRG_RegisterAlwaysVisibleUnit(g_aprgRaynorHyperion, player);
        AISetUnitScriptControlled(g_aprgRaynorHyperion, true);
        g_aprgRaynorHomePoint = p;
        g_aprgRaynorSafePoint = p;
        g_aprgRaynorNextFlybyTime = now + 300.0;
        g_aprgRaynorEarliestNextFlybyTime = g_aprgRaynorNextFlybyTime;
        g_aprgRaynorNextRepairDropTime = -1.0;
        g_aprgRaynorSafeArriveTime = now;
        g_aprgRaynorNeedsRepair = false;
        g_aprgRaynorFlybyState = 0;
        g_aprgRaynorLastObservedLife = UnitGetPropertyFixed(g_aprgRaynorHyperion, c_unitPropLife, c_unitPropCurrent);
        g_aprgRaynorRepairStallTicks = 0;
        g_aprgRaynorStarted = true;
    }

    if (g_aprgRaynorHyperion == null || !UnitIsAlive(g_aprgRaynorHyperion)) {
        g_aprgRaynorDestroyed = true;
        g_aprgRaynorFlybyState = 0;
        return;
    }

    APRG_RegisterAlwaysVisibleUnit(g_aprgRaynorHyperion, player);
    owner = UnitGetOwner(g_aprgRaynorHyperion);
    APRG_TickRaynorRepairSCVs(g_aprgRaynorHyperion);

    raynorLife = UnitGetPropertyFixed(g_aprgRaynorHyperion, c_unitPropLife, c_unitPropCurrent);
    raynorMax = UnitGetPropertyFixed(g_aprgRaynorHyperion, c_unitPropLifeMax, c_unitPropCurrent);
    if (g_aprgRaynorFlybyState == 1 && g_aprgRaynorFlybyStartLife > 0.0 && raynorLife <= g_aprgRaynorFlybyStartLife * 0.5) {
        g_aprgRaynorEarliestNextFlybyTime = now + 90.0;
        g_aprgRaynorSafePoint = APRG_FindDeepEnemyAirPoint(player);
        if (g_aprgRaynorSafePoint == null) { g_aprgRaynorSafePoint = g_aprgRaynorHomePoint; }
        if (g_aprgRaynorSafePoint != null) { APRG_RaynorBeginMove(g_aprgRaynorSafePoint, now); }
        g_aprgRaynorFlybyDeadline = now + 90.0;
        g_aprgRaynorFlybyState = 3;
        return;
    }

    if (g_aprgRaynorFlybyState == 1) {
        APRG_RaynorMoveToward(g_aprgRaynorTargetPoint, now);
        if (DistanceBetweenPoints(UnitGetPosition(g_aprgRaynorHyperion), g_aprgRaynorTargetPoint) <= 15.0 || now >= g_aprgRaynorFlybyDeadline) {
            for (i = 0; i < 5; i += 1) {
                dropPoint = APRG_FindGroundPointNear(UnitGetPosition(g_aprgRaynorHyperion), 3.0, 10.0);
                if (dropPoint == null) { dropPoint = UnitGetPosition(g_aprgRaynorHyperion); }
                APRG_QueueRealDropPod(APRG_DROP_KIND_RAYNOR_ASSAULT, owner, dropPoint, null);
            }
            g_aprgRaynorEarliestNextFlybyTime = now + 90.0;
            g_aprgRaynorSafePoint = APRG_FindDeepEnemyAirPoint(player);
            if (g_aprgRaynorSafePoint == null) { g_aprgRaynorSafePoint = g_aprgRaynorHomePoint; }
            if (g_aprgRaynorSafePoint != null) { APRG_RaynorBeginMove(g_aprgRaynorSafePoint, now); }
            g_aprgRaynorFlybyDeadline = now + 90.0;
            g_aprgRaynorFlybyState = 3;
        }
        return;
    }

    if (g_aprgRaynorFlybyState == 3) {
        APRG_RaynorMoveToward(g_aprgRaynorSafePoint, now);
        if (g_aprgRaynorSafePoint == null || DistanceBetweenPoints(UnitGetPosition(g_aprgRaynorHyperion), g_aprgRaynorSafePoint) <= 12.0 || now >= g_aprgRaynorFlybyDeadline) {
            raynorLife = UnitGetPropertyFixed(g_aprgRaynorHyperion, c_unitPropLife, c_unitPropCurrent);
            raynorMax = UnitGetPropertyFixed(g_aprgRaynorHyperion, c_unitPropLifeMax, c_unitPropCurrent);
            g_aprgRaynorFlybyState = 0;
            g_aprgRaynorSafeArriveTime = now;
            g_aprgRaynorNextFlybyTime = now + 180.0;
            g_aprgRaynorNeedsRepair = raynorMax > 0.0 && raynorLife < raynorMax * 0.995;
            if (g_aprgRaynorNeedsRepair) { g_aprgRaynorNextRepairDropTime = now + 90.0; }
            else { g_aprgRaynorNextRepairDropTime = -1.0; }
        }
        return;
    }

    if (g_aprgRaynorFlybyState == 0) {
        raynorLife = UnitGetPropertyFixed(g_aprgRaynorHyperion, c_unitPropLife, c_unitPropCurrent);
        raynorMax = UnitGetPropertyFixed(g_aprgRaynorHyperion, c_unitPropLifeMax, c_unitPropCurrent);
        if (raynorMax > 0.0 && raynorLife < raynorMax * 0.995) { g_aprgRaynorNeedsRepair = true; }
        if (g_aprgRaynorNeedsRepair && raynorMax > 0.0 && raynorLife >= raynorMax * 0.995 && now >= g_aprgRaynorSafeArriveTime + 90.0) {
            g_aprgRaynorNeedsRepair = false;
            if (now >= g_aprgRaynorEarliestNextFlybyTime) { g_aprgRaynorNextFlybyTime = now; }
            else { g_aprgRaynorNextFlybyTime = g_aprgRaynorEarliestNextFlybyTime; }
            g_aprgRaynorNextRepairDropTime = -1.0;
        }
    }

    if (g_aprgRaynorNeedsRepair && g_aprgRaynorNextRepairDropTime >= 0.0 && now >= g_aprgRaynorNextRepairDropTime) {
        dropPoint = APRG_FindGroundPointNear(UnitGetPosition(g_aprgRaynorHyperion), 2.0, 7.0);
        if (dropPoint == null) { dropPoint = UnitGetPosition(g_aprgRaynorHyperion); }
        APRG_QueueRealDropPod(APRG_DROP_KIND_RAYNOR_REPAIR, owner, dropPoint, g_aprgRaynorHyperion);
        g_aprgRaynorNextRepairDropTime = now + 120.0;
    }

    if (now >= g_aprgRaynorNextFlybyTime) {
        target = APRG_RaynorFlybyTarget(player);
        if (target == null) { return; }
        g_aprgRaynorTargetPoint = UnitGetPosition(target);
        UIDisplayMessage(
            PlayerGroupSingle(player), c_messageAreaChat,
            StringToText("[Slay] The Hyperion is approaching your base!")
        );
        g_aprgRaynorFlybyStartLife = UnitGetPropertyFixed(g_aprgRaynorHyperion, c_unitPropLife, c_unitPropCurrent);
        APRG_RaynorBeginMove(g_aprgRaynorTargetPoint, now);
        g_aprgRaynorFlybyState = 1;
        g_aprgRaynorFlybyDeadline = now + 90.0;
    }
}



unit APRG_PurifierFarthestEnemyBuilding(int player) {
    unit home;
    point homePoint;
    unitgroup buildings;
    unit candidate;
    unit best;
    fixed distance;
    fixed bestDistance;
    int i;
    home = APRG_FindPlayerHomeStructure(player);
    if (home == null) { return null; }
    homePoint = UnitGetPosition(home);
    buildings = APRG_EnemyStructures(player);
    best = null;
    bestDistance = -1.0;
    for (i = UnitGroupCount(buildings, c_unitCountAlive); i > 0; i -= 1) {
        candidate = UnitGroupUnitFromEnd(buildings, i);
        if (candidate == null || !UnitIsAlive(candidate)) { continue; }
        distance = DistanceBetweenPoints(UnitGetPosition(candidate), homePoint);
        if (distance > bestDistance) {
            bestDistance = distance;
            best = candidate;
        }
    }
    return best;
}

void APRG_PurifierWarpVisual(unit u) {
    if (u == null) { return; }
}

string APRG_PurifierEscortType() {
    int roll;
    roll = RandomInt(0, 3);
    if (roll == 0) { return "Scout"; }
    if (roll == 1) { return "Phoenix"; }
    if (roll == 2) { return "VoidRay"; }
    return "Carrier";
}

bool APRG_QueuePurifierEscortWarp(string unitType, int owner, point center, fixed when) {
    int i;
    if (unitType == "" || center == null || owner < 0) { return false; }
    for (i = 0; i < 32; i += 1) {
        if (g_aprgPurifierWarpState[i] != 0) { continue; }
        g_aprgPurifierWarpState[i] = 1;
        g_aprgPurifierWarpOwner[i] = owner;
        g_aprgPurifierWarpType[i] = unitType;
        g_aprgPurifierWarpPoint[i] = center;
        g_aprgPurifierWarpTime[i] = when;
        g_aprgPurifierWarpActor[i] = null;
        g_aprgPurifierWarpUnit[i] = null;
        g_aprgPurifierWarpEscort[i] = true;
        return true;
    }
    return false;
}

void APRG_PurifierSpawnEscort(int player) {
    string unitType;
    int owner;
    point p;
    if (g_aprgPurifier == null || !UnitIsAlive(g_aprgPurifier)) { return; }
    owner = UnitGetOwner(g_aprgPurifier);
    p = PointWithOffsetPolar(UnitGetPosition(g_aprgPurifier), RandomFixed(3.0, 7.0), libNtve_gf_RandomAngle());
    unitType = APRG_PurifierEscortType();
    if (!CatalogEntryIsValid(c_gameCatalogUnit, unitType)) { unitType = "Scout"; }
    if (!CatalogEntryIsValid(c_gameCatalogUnit, unitType)) { return; }
    APRG_QueuePurifierEscortWarp(unitType, owner, p, GameGetMissionTime());
}

bool APRG_QueuePurifierHostileWarp(string unitType, int owner, point center, fixed when) {
    int i;
    if (unitType == "" || center == null || owner < 0) { return false; }
    for (i = 0; i < 32; i += 1) {
        if (g_aprgPurifierWarpState[i] != 0) { continue; }
        g_aprgPurifierWarpState[i] = 1;
        g_aprgPurifierWarpOwner[i] = owner;
        g_aprgPurifierWarpType[i] = unitType;
        g_aprgPurifierWarpPoint[i] = center;
        g_aprgPurifierWarpTime[i] = when;
        g_aprgPurifierWarpActor[i] = null;
        g_aprgPurifierWarpUnit[i] = null;
        g_aprgPurifierWarpEscort[i] = false;
        return true;
    }
    return false;
}

void APRG_ProcessPurifierHostileWarpQueue(int player, fixed now) {
    int i;
    int best = -1;
    fixed bestTime = 99999999.0;
    point spawnPoint;
    unitgroup created;
    unitgroup ready;
    unit u;
    actor mainActor;
    for (i = 0; i < 32; i += 1) {
        if (g_aprgPurifierWarpState[i] == 0 || g_aprgPurifierWarpTime[i] > now) { continue; }
        if (best < 0 || g_aprgPurifierWarpTime[i] < bestTime) { best = i; bestTime = g_aprgPurifierWarpTime[i]; }
    }
    if (best < 0) { return; }

    if (g_aprgPurifierWarpState[best] == 1) {
        spawnPoint = APRG_FindGroundPointNear(g_aprgPurifierWarpPoint[best], 1.0, 7.0);
        if (spawnPoint == null) { spawnPoint = g_aprgPurifierWarpPoint[best]; }
        g_aprgPurifierWarpPoint[best] = spawnPoint;
        if (!CatalogEntryIsValid(c_gameCatalogUnit, g_aprgPurifierWarpType[best])) {
            g_aprgPurifierWarpState[best] = 0;
            g_aprgPurifierWarpOwner[best] = -1;
            g_aprgPurifierWarpType[best] = "";
            g_aprgPurifierWarpPoint[best] = null;
            g_aprgPurifierWarpTime[best] = 0.0;
            g_aprgPurifierWarpActor[best] = null;
            g_aprgPurifierWarpUnit[best] = null;
            g_aprgPurifierWarpEscort[best] = false;
            return;
        }
        created = UnitCreate(1, g_aprgPurifierWarpType[best], c_unitCreateIgnorePlacement, g_aprgPurifierWarpOwner[best], spawnPoint, libNtve_gf_RandomAngle());
        if (created == null || UnitGroupCount(created, c_unitCountAlive) <= 0) {
            g_aprgPurifierWarpState[best] = 0;
            g_aprgPurifierWarpEscort[best] = false;
            return;
        }
        u = UnitGroupUnitFromEnd(created, 1);
        if (u == null) {
            g_aprgPurifierWarpState[best] = 0;
            g_aprgPurifierWarpEscort[best] = false;
            return;
        }
        g_aprgPurifierWarpUnit[best] = u;
        if (g_aprgPurifierWarpEscort[best]) {
            UnitGroupAdd(g_aprgPurifierEscort, u);
            if (g_aprgPurifierWarpType[best] == "Carrier") {
                UnitGroupIssueOrder(created, OrderSetAutoCast(AbilityCommand("CarrierHangar", 0), true), c_orderQueueReplace);
                UnitGroupAdd(g_aprgAirSupportCarriers, u);
            }
        }
        else {
            APRG_AddHostileRaiders(created, spawnPoint, player);
        }

        // Match Blizzard's campaign warp presentation: the real unit exists during the warp,
        // is paused, fades in, and has ProtossGenericWarpInOut attached at Ref_Origin.
        libNtve_gf_PauseUnit(u, true);
        mainActor = libNtve_gf_MainActorofUnit(u);
        if (mainActor != null) {
            ActorSend(mainActor, libNtve_gf_SetOpacity(0.0, 0.0));
            ActorSend(mainActor, libNtve_gf_SetOpacity(1.0, 5.0));
        }
        g_aprgPurifierWarpActor[best] = APRG_CreateWarpVisual(u, spawnPoint);
        if (CatalogEntryIsValid(c_gameCatalogBehavior, "ProtossGenericWarpInOut")) {
            UnitBehaviorAdd(u, "ProtossGenericWarpInOut", u, 1);
        }
        g_aprgPurifierWarpState[best] = 2;
        g_aprgPurifierWarpTime[best] = now + 5.0;
        return;
    }

    u = g_aprgPurifierWarpUnit[best];
    if (u != null && UnitIsAlive(u)) {
        if (CatalogEntryIsValid(c_gameCatalogBehavior, "ProtossGenericWarpInOut")) {
            UnitBehaviorRemove(u, "ProtossGenericWarpInOut", 1);
        }
        mainActor = libNtve_gf_MainActorofUnit(u);
        if (mainActor != null) { ActorSend(mainActor, libNtve_gf_SetOpacity(1.0, 0.0)); }
        libNtve_gf_PauseUnit(u, false);
        ready = UnitGroupEmpty();
        UnitGroupAdd(ready, u);
        if (g_aprgPurifierWarpEscort[best]) {
            // Escort flyers used to receive no attack order at all after unpausing.
            APRG_AddHostileRaiders(ready, UnitGetPosition(u), player);
        }
        else {
            APRG_OrderGroupTowardNearestPlayerStructure(ready, UnitGetPosition(u), player);
        }
    }
    if (g_aprgPurifierWarpActor[best] != null) { ActorSend(g_aprgPurifierWarpActor[best], "Destroy"); }
    g_aprgPurifierWarpState[best] = 0;
    g_aprgPurifierWarpOwner[best] = -1;
    g_aprgPurifierWarpType[best] = "";
    g_aprgPurifierWarpPoint[best] = null;
    g_aprgPurifierWarpTime[best] = 0.0;
    g_aprgPurifierWarpActor[best] = null;
    g_aprgPurifierWarpUnit[best] = null;
    g_aprgPurifierWarpEscort[best] = false;
}

void APRG_PurifierSpawnGroundWave(int player) {
    int owner;
    point center;
    int i;
    int queued = 0;
    fixed now;
    if (g_aprgPurifier == null || !UnitIsAlive(g_aprgPurifier)) { return; }
    owner = UnitGetOwner(g_aprgPurifier);
    center = UnitGetPosition(g_aprgPurifier);
    now = GameGetMissionTime();
    for (i = 0; i < 5; i += 1) {
        if (APRG_QueuePurifierHostileWarp("Zealot", owner, center, now + 0.2 * IntToFixed(queued))) { queued += 1; }
    }
    for (i = 0; i < 5; i += 1) {
        if (APRG_QueuePurifierHostileWarp("Stalker", owner, center, now + 0.2 * IntToFixed(queued))) { queued += 1; }
    }
}

void APRG_PurifierKeepEscortClose() {
    int i;
    unit u;
    fixed distance;
    point purifierPoint;
    if (g_aprgPurifier == null || !UnitIsAlive(g_aprgPurifier)) { return; }
    purifierPoint = UnitGetPosition(g_aprgPurifier);
    for (i = UnitGroupCount(g_aprgPurifierEscort, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(g_aprgPurifierEscort, i);
        if (u == null) { continue; }
        distance = DistanceBetweenPoints(UnitGetPosition(u), purifierPoint);
        if (distance > 10.0) {
            UnitIssueOrder(u, OrderTargetingPoint(AbilityCommand("move", 0), purifierPoint), c_orderQueueReplace);
        }
    }
}

void APRG_ForceEndPurifierPlanetCracker(unit purifier) {
    int i;
    string behavior;
    bool restoreAbility = false;
    if (purifier == null || !UnitIsAlive(purifier)) { return; }

    UnitIssueOrder(purifier, Order(AbilityCommand("move", 2)), c_orderQueueReplace);

    for (i = UnitBehaviorCountAll(purifier); i >= 1; i -= 1) {
        behavior = UnitBehaviorGet(purifier, i);
        if (
            StringContains(behavior, "PlanetCracker", c_stringAnywhere, c_stringNoCase) ||
            StringContains(behavior, "PurifierPlanet", c_stringAnywhere, c_stringNoCase)
        ) {
            UnitBehaviorRemove(purifier, behavior, c_unitBehaviorCountAll);
        }
    }
    if (UnitAbilityExists(purifier, "PurifierPlanetCracker")) {
        UnitAbilityRemove(purifier, "PurifierPlanetCracker");
        restoreAbility = true;
    }
    if (restoreAbility) { UnitAbilityAdd(purifier, "PurifierPlanetCracker"); }
}

bool APRG_PurifierNearPlayerStructure(unit purifier, int player, fixed radius) {
    unit nearest;
    if (purifier == null || !UnitIsAlive(purifier)) { return false; }
    nearest = APRG_NearestPlayerStructure(UnitGetPosition(purifier), player);
    if (nearest == null) { return false; }
    return DistanceBetweenPoints(UnitGetPosition(purifier), UnitGetPosition(nearest)) <= radius;
}

// WoL Purifier has InvulnerabilityShield in its base CUnit BehaviorArray.
// Safe Haven removes it from the scripted boss during its encounter, but
// Slay's separately spawned mutation Purifier never receives that mission event.
// Never touch the map's own gv_purifier or the allied Purifier Alliance boon.
void APRG_RemoveMutationPurifierInvulnerability(unit purifier) {
    if (purifier == null || !UnitIsAlive(purifier)) { return; }
    if (UnitBehaviorCount(purifier, "InvulnerabilityShield") > 0) {
        UnitBehaviorRemove(purifier, "InvulnerabilityShield", c_unitBehaviorCountAll);
    }
    // Keep our mutation unit vulnerable if another campaign effect sets the unit state.
    UnitSetState(purifier, c_unitStateInvulnerable, false);
}

void APRG_TickPurifier(int player, fixed now) {
    point spawnPoint;
    unit spawnAnchor;
    int owner;
    unitgroup created;
    unit home;
    fixed distance;
    fixed speed;
    fixed life;
    fixed maxLife;
    int i;
    if (!APRG_PlayerMacroBaseReady(player)) { return; }

    if (!g_aprgPurifierSpawned) {
        if (!CatalogEntryIsValid(c_gameCatalogUnit, "Purifier")) { return; }
        spawnAnchor = APRG_PurifierFarthestEnemyBuilding(player);
        if (spawnAnchor == null) { spawnAnchor = APRG_RandomHostileBaseAnchor(player); }
        if (spawnAnchor == null) { return; }
        spawnPoint = UnitGetPosition(spawnAnchor);
        owner = UnitGetOwner(spawnAnchor);
        if (owner < 0) { owner = APRG_FindHostileOwnerNearPoint(player, spawnPoint); }
        if (owner < 0) { return; }
        created = UnitCreate(1, "Purifier", c_unitCreateIgnorePlacement, owner, spawnPoint, libNtve_gf_RandomAngle());
        if (created == null || UnitGroupCount(created, c_unitCountAlive) <= 0) { return; }
        g_aprgPurifier = UnitGroupUnitFromEnd(created, 1);
        if (g_aprgPurifier == null) { return; }
        APRG_StripVoidEntityBehavior(g_aprgPurifier);
        APRG_RemoveMutationPurifierInvulnerability(g_aprgPurifier);
        AISetUnitScriptControlled(g_aprgPurifier, true);
        speed = UnitGetPropertyFixed(g_aprgPurifier, c_unitPropMovementSpeed, c_unitPropCurrent);
        if (speed != 0.25) { UnitSetPropertyFixed(g_aprgPurifier, c_unitPropMovementSpeed, 0.25); }
        g_aprgPurifierRevealRegion = RegionCircle(UnitGetPosition(g_aprgPurifier), 6.0);
        g_aprgPurifierRevealer = VisRevealerCreate(player, g_aprgPurifierRevealRegion);
        g_aprgPurifierSpawned = true;
        g_aprgPurifierCrackerIssued = false;
        g_aprgPurifierHalfHealthWarped = false;
        g_aprgPurifierBeamStopTime = -1.0;
        g_aprgNextPurifierEscortTime = now + 50.0;
        g_aprgNextPurifierGroundWaveTime = now + 120.0;
        g_aprgNextPurifierMoveRefreshTime = now;
        MinimapPing(PlayerGroupSingle(player), UnitGetPosition(g_aprgPurifier), 6.0, Color(100.00, 60.00, 0.00));
        UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaChat, StringToText("[Slay] The Purifier is approaching your base."));
    }

    if (g_aprgPurifier == null || !UnitIsAlive(g_aprgPurifier)) { return; }
    // Safe Haven's regular boss is independent; ensure only our mutation unit
    // remains vulnerable even if a campaign trigger restores its starting buff.
    APRG_RemoveMutationPurifierInvulnerability(g_aprgPurifier);
    UnitSetPropertyFixed(g_aprgPurifier, c_unitPropMovementSpeed, 0.25);
    if (g_aprgPurifierRevealRegion != null && g_aprgPurifierRevealer != null) {
        RegionSetCenter(g_aprgPurifierRevealRegion, UnitGetPosition(g_aprgPurifier));
        VisRevealerUpdate(g_aprgPurifierRevealer);
    }
    APRG_PurifierKeepEscortClose();

    if (!g_aprgPurifierHalfHealthWarped) {
        life = UnitGetPropertyFixed(g_aprgPurifier, c_unitPropLife, c_unitPropCurrent);
        maxLife = UnitGetPropertyFixed(g_aprgPurifier, c_unitPropLifeMax, c_unitPropCurrent);
        if (maxLife > 0.0 && life <= maxLife * 0.5) {
            g_aprgPurifierHalfHealthWarped = true;
            for (i = 0; i < 4; i += 1) {
                APRG_QueuePurifierHostileWarp("VoidRay", UnitGetOwner(g_aprgPurifier), UnitGetPosition(g_aprgPurifier), now + 0.2 * IntToFixed(i));
            }
        }
    }

    if (g_aprgPurifierBeamStopTime > 0.0 && now >= g_aprgPurifierBeamStopTime) {
        APRG_ForceEndPurifierPlanetCracker(g_aprgPurifier);
        g_aprgPurifierBeamStopTime = -1.0;
    }

    if (now >= g_aprgNextPurifierEscortTime) {
        APRG_PurifierSpawnEscort(player);
        g_aprgNextPurifierEscortTime = now + 50.0;
    }
    if (now >= g_aprgNextPurifierGroundWaveTime) {
        APRG_PurifierSpawnGroundWave(player);
        g_aprgNextPurifierGroundWaveTime = now + 120.0;
    }

    home = APRG_FindPlayerHomeStructure(player);
    if (home == null) { return; }
    distance = DistanceBetweenPoints(UnitGetPosition(g_aprgPurifier), UnitGetPosition(home));
    if (!g_aprgPurifierCrackerIssued && distance <= 8.0) {
        if (CatalogEntryIsValid(c_gameCatalogAbil, "PurifierPlanetCracker")) {
            UnitIssueOrder(g_aprgPurifier, Order(AbilityCommand("PurifierPlanetCracker", 0)), c_orderQueueReplace);
            UnitIssueOrder(g_aprgPurifier, Order(AbilityCommand("move", 2)), c_orderQueueAddToEnd);
            g_aprgPurifierCrackerIssued = true;
            g_aprgPurifierBeamStopTime = now + 10.0;
            MinimapPing(PlayerGroupSingle(player), UnitGetPosition(g_aprgPurifier), 8.0, Color(100.00, 0.00, 0.00));
            UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaChat, StringToText("[Slay] PURIFIER PLANET CRACKER FIRING."));
        }
        return;
    }
    if (!g_aprgPurifierCrackerIssued && now >= g_aprgNextPurifierMoveRefreshTime) {
        UnitIssueOrder(g_aprgPurifier, OrderTargetingPoint(AbilityCommand("move", 0), UnitGetPosition(home)), c_orderQueueReplace);
        g_aprgNextPurifierMoveRefreshTime = now + 10.0;
    }
    // The mutation Purifier runs a bespoke approach/Planet Cracker loop.
    // Give it the same visible-unit-only Vortex rule as the allied boon,
    // without interrupting the Planet Cracker channel once it has started.
    if (!g_aprgPurifierCrackerIssued) { APRG_TrySlayPurifierVortex(g_aprgPurifier, player, false); }
}

void APRG_QueuePurifierAllianceEscort(int player, fixed now) {
    string unitType;
    point center;
    int owner;
    if (g_aprgPurifierAlliance == null || !UnitIsAlive(g_aprgPurifierAlliance)) { return; }
    unitType = APRG_PurifierEscortType();
    center = UnitGetPosition(g_aprgPurifierAlliance);
    owner = player;
    APRG_QueueAllyWarp(unitType, owner, center, now);
}

void APRG_QueuePurifierAllianceGroundWave(int player, fixed now) {
    int i;
    int queued = 0;
    point center;
    if (g_aprgPurifierAlliance == null || !UnitIsAlive(g_aprgPurifierAlliance)) { return; }
    center = UnitGetPosition(g_aprgPurifierAlliance);
    for (i = 0; i < 5; i += 1) {
        if (APRG_QueueAllyWarp("Zealot", player, center, now + 0.2 * IntToFixed(queued))) { queued += 1; }
    }
    for (i = 0; i < 5; i += 1) {
        if (APRG_QueueAllyWarp("Stalker", player, center, now + 0.2 * IntToFixed(queued))) { queued += 1; }
    }
}

void APRG_TickPurifierAlliance(int player, fixed now) {
    unit home;
    point spawnPoint;
    point current;
    unit target;
    unitgroup created;
    unitgroup nearbyEnemies;
    fixed speed;
    fixed life;
    fixed maxLife;
    int i;
    if (!APRG_PlayerMacroBaseReady(player) || now < 300.0) { return; }

    if (!g_aprgPurifierAllianceSpawned) {
        if (!CatalogEntryIsValid(c_gameCatalogUnit, "Purifier")) { return; }
        home = APRG_FindPlayerHomeStructure(player);
        if (home == null) { return; }
        spawnPoint = PointWithOffsetPolar(UnitGetPosition(home), 8.0, libNtve_gf_RandomAngle());
        g_aprgPurifierAllianceOwner = player;
        created = UnitCreate(1, "Purifier", c_unitCreateIgnorePlacement, player, spawnPoint, libNtve_gf_RandomAngle());
        if (created == null || UnitGroupCount(created, c_unitCountAlive) <= 0) { return; }
        g_aprgPurifierAlliance = UnitGroupUnitFromEnd(created, 1);
        if (g_aprgPurifierAlliance == null) { return; }
        APRG_MakeGroupUncommandable(created);
        AISetUnitScriptControlled(g_aprgPurifierAlliance, true);
        UnitSetPropertyFixed(g_aprgPurifierAlliance, c_unitPropMovementSpeed, 0.3);
        g_aprgPurifierAllianceSpawned = true;
        g_aprgPurifierAllianceHalfHealthWarped = false;
        g_aprgNextPurifierAllianceEscortTime = now + 60.0;
        g_aprgNextPurifierAllianceGroundWaveTime = now + 120.0;
        g_aprgNextPurifierAllianceMoveTime = now;
        g_aprgNextPurifierAllianceCrackerTime = now;
        g_aprgPurifierAllianceBeamStopTime = -1.0;
        MinimapPing(PlayerGroupSingle(player), UnitGetPosition(g_aprgPurifierAlliance), 6.0, Color(0.00, 80.00, 100.00));
        UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaChat, StringToText("[Slay] The Purifier has arrived"));
    }

    if (g_aprgPurifierAlliance == null || !UnitIsAlive(g_aprgPurifierAlliance)) { return; }
    UnitSetPropertyFixed(g_aprgPurifierAlliance, c_unitPropMovementSpeed, 0.3);
    current = UnitGetPosition(g_aprgPurifierAlliance);

    if (!g_aprgPurifierAllianceHalfHealthWarped) {
        life = UnitGetPropertyFixed(g_aprgPurifierAlliance, c_unitPropLife, c_unitPropCurrent);
        maxLife = UnitGetPropertyFixed(g_aprgPurifierAlliance, c_unitPropLifeMax, c_unitPropCurrent);
        if (maxLife > 0.0 && life <= maxLife * 0.5) {
            g_aprgPurifierAllianceHalfHealthWarped = true;
            for (i = 0; i < 4; i += 1) {
                APRG_QueueAllyWarp("VoidRay", player, current, now + 0.2 * IntToFixed(i));
            }
        }
    }

    if (g_aprgPurifierAllianceBeamStopTime > 0.0) {
        if (now >= g_aprgPurifierAllianceBeamStopTime || APRG_PurifierNearPlayerStructure(g_aprgPurifierAlliance, player, 10.0)) {
            APRG_ForceEndPurifierPlanetCracker(g_aprgPurifierAlliance);
            g_aprgPurifierAllianceBeamStopTime = -1.0;
            g_aprgNextPurifierAllianceMoveTime = now;
        }
        else {
            return;
        }
    }

    if (now >= g_aprgNextPurifierAllianceEscortTime) {
        APRG_QueuePurifierAllianceEscort(player, now);
        g_aprgNextPurifierAllianceEscortTime = now + 60.0;
    }
    if (now >= g_aprgNextPurifierAllianceGroundWaveTime) {
        APRG_QueuePurifierAllianceGroundWave(player, now);
        g_aprgNextPurifierAllianceGroundWaveTime = now + 120.0;
    }

    if (now >= g_aprgNextPurifierAllianceCrackerTime && CatalogEntryIsValid(c_gameCatalogAbil, "PurifierPlanetCracker")) {
        nearbyEnemies = UnitGroupAlliance(
            player,
            c_unitAllianceEnemy,
            RegionCircle(current, 10.0),
            UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32))),
            0
        );
        if (UnitGroupCount(nearbyEnemies, c_unitCountAlive) >= 20 && !APRG_PurifierNearPlayerStructure(g_aprgPurifierAlliance, player, 10.0)) {
            UnitIssueOrder(g_aprgPurifierAlliance, Order(AbilityCommand("PurifierPlanetCracker", 0)), c_orderQueueReplace);
            UnitIssueOrder(g_aprgPurifierAlliance, Order(AbilityCommand("move", 2)), c_orderQueueAddToEnd);
            g_aprgPurifierAllianceBeamStopTime = now + 10.0;
            g_aprgNextPurifierAllianceCrackerTime = now + 30.0;
            return;
        }
    }

    if (now >= g_aprgNextPurifierAllianceMoveTime) {
        target = APRG_NearestEligibleEnemyStructure(current, player);
        if (target == null) { target = APRG_NearestEligibleEnemyMobileUnit(current, player); }
        if (target != null) {
            APRG_OrderAttackMove(g_aprgPurifierAlliance, UnitGetPosition(target));
        }
        g_aprgNextPurifierAllianceMoveTime = now + 10.0;
    }
}



bool APRG_ReflectiveArmor_Func(bool testConds, bool runActions) {
    unit victim;
    unit source;
    int player;
    int owner;
    fixed damage;
    if (!runActions || !g_aprgStarted || !APRG_HasExtension2(APRG_EXT2_BLESS_REFLECTIVE_ARMOR)) { return true; }
    victim = EventUnit();
    source = EventUnitDamageSourceUnit();
    if (victim == null || source == null || victim == source) { return true; }
    player = APRG_GetPrimaryPlayer();
    if (UnitGetOwner(victim) != player) { return true; }
    owner = UnitGetOwner(source);
    if (owner < 0 || !libNtve_gf_PlayerIsEnemy(owner, player, libNtve_ge_PlayerRelation_Enemy)) { return true; }
    damage = EventUnitDamageAmount();
    if (damage > 0.0) { APRG_DealDirectDamage(source, damage * 0.5); }
    return true;
}

void APRG_TickBuddySystem(int player, fixed now) {
    unitgroup units;
    unitgroup nearby;
    unit u;
    int i;
    if (!APRG_PlayerMacroBaseReady(player) || now < g_aprgNextBuddyCheckTime) { return; }
    g_aprgNextBuddyCheckTime = now + 1.0;
    units = APRG_PlayerMobileUnits(player);
    for (i = UnitGroupCount(units, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null) { break; }
        nearby = UnitGroupAlliance(
            player, c_unitAllianceAlly, RegionCircle(UnitGetPosition(u), 7.5),
            UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0
        );
        UnitGroupRemove(nearby, u);
        if (UnitGroupCount(nearby, c_unitCountAlive) <= 0) { APRG_DealDirectDamage(u, 50.0); }
    }
}

bool APRG_TorrasqueDamage_Func(bool testConds, bool runActions) {
    unit victim;
    unit source;
    fixed damage;
    if (!runActions || !g_aprgStarted || !APRG_HasExtension2(APRG_EXT2_MUT_TORRASQUE)) { return true; }
    source = EventUnitDamageSourceUnit();
    if (source == null || source != g_aprgTorrasque || !UnitIsAlive(source)) { return true; }
    victim = EventUnit(); if (victim == null || victim == source || !UnitIsAlive(victim)) { return true; }
    damage = EventUnitDamageAmount();
    if (damage > 0.0) { APRG_DealDirectDamage(victim, damage * (0.25 + 0.02 * IntToFixed(g_aprgTorrasqueDeaths))); }
    return true;
}

bool APRG_TorrasqueSpawnPointClear(point p, int player) {
    unitgroup nearby;
    if (p == null) { return false; }
    nearby = UnitGroup(
        null, player, RegionCircle(p, 20.0),
        UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))),
        0
    );
    return UnitGroupCount(nearby, c_unitCountAlive) <= 0;
}

point APRG_FindTorrasqueSpawnPoint(int player) {
    int attempt;
    unit anchor;
    point p;
    for (attempt = 0; attempt < 24; attempt += 1) {
        anchor = APRG_RandomPathableHostileBaseAnchor(player);
        if (anchor == null) { continue; }
        p = APRG_FindGroundPointNear(UnitGetPosition(anchor), 4.0, 12.0);
        if (p == null) { p = UnitGetPosition(anchor); }
        if (APRG_TorrasqueSpawnPointClear(p, player)) { return p; }
    }
    return null;
}

unit APRG_FindFriendlyBlockingStructure(unit mover, point targetPoint, fixed radius) {
    int owner;
    int i;
    unit candidate;
    unit best = null;
    unitgroup nearby;
    unitgroup allies;
    fixed moverTargetDistance;
    fixed candidateTargetDistance;
    fixed candidateDistance;
    fixed bestDistance = 999999.0;
    if (mover == null || !UnitIsAlive(mover) || targetPoint == null) { return null; }
    owner = UnitGetOwner(mover);
    moverTargetDistance = DistanceBetweenPoints(UnitGetPosition(mover), targetPoint);
    nearby = UnitGroup(
        null, owner, RegionCircle(UnitGetPosition(mover), radius),
        UnitFilter(
            (1 << c_targetFilterStructure), 0, (1 << c_targetFilterMissile),
            (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)) | (1 << (c_targetFilterInvulnerable - 32))
        ), 0
    );
    allies = UnitGroupAlliance(
        owner, c_unitAllianceAlly, RegionCircle(UnitGetPosition(mover), radius),
        UnitFilter(
            (1 << c_targetFilterStructure), 0, (1 << c_targetFilterMissile),
            (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)) | (1 << (c_targetFilterInvulnerable - 32))
        ), 0
    );
    UnitGroupAddUnitGroup(nearby, allies);
    for (i = UnitGroupCount(nearby, c_unitCountAlive); i > 0; i -= 1) {
        candidate = UnitGroupUnitFromEnd(nearby, i);
        if (candidate == null || !UnitIsAlive(candidate) || candidate == mover) { continue; }
        candidateTargetDistance = DistanceBetweenPoints(UnitGetPosition(candidate), targetPoint);
        // Only clear a friendly building that is actually ahead of the stuck unit.
        if (candidateTargetDistance >= moverTargetDistance - 0.5) { continue; }
        candidateDistance = DistanceBetweenPoints(UnitGetPosition(candidate), UnitGetPosition(mover));
        if (candidateDistance < bestDistance) { best = candidate; bestDistance = candidateDistance; }
    }
    return best;
}

bool APRG_ClearFriendlyBlocker(unit mover, point targetPoint, fixed damage) {
    unit blocker;
    order attackOrder;
    if (mover == null || !UnitIsAlive(mover) || targetPoint == null) { return false; }
    blocker = APRG_FindFriendlyBlockingStructure(mover, targetPoint, 10.0);
    if (blocker == null) { return false; }
    attackOrder = OrderTargetingUnit(AbilityCommand("attack", 0), blocker);
    if (UnitOrderIsValid(mover, attackOrder)) { UnitIssueOrder(mover, attackOrder, c_orderQueueReplace); }
    // Allied structures normally cannot be attacked. Apply the attack damage directly
    // so a genuinely trapped scripted boss can carve its way out instead of stalling forever.
    APRG_DealDirectDamage(blocker, damage);
    return true;
}

void APRG_OrderTorrasqueAtPlayerBase(int player) {
    unit target;
    if (g_aprgTorrasque == null || !UnitIsAlive(g_aprgTorrasque)) { return; }
    target = APRG_FindPlayerHomeStructure(player);
    if (target == null || !UnitIsAlive(target)) {
        target = APRG_NearestPlayerStructure(UnitGetPosition(g_aprgTorrasque), player);
    }
    if (target == null || !UnitIsAlive(target)) { return; }
    AISetUnitScriptControlled(g_aprgTorrasque, false);
    UnitIssueOrder(
        g_aprgTorrasque,
        OrderTargetingPoint(AbilityCommand("attack", 0), UnitGetPosition(target)),
        c_orderQueueReplace
    );
}

void APRG_SpawnTorrasque(int player) {
    point p;
    int owner;
    unitgroup created;
    fixed maximum;
    fixed lifeFactor = 2.0 + 0.08 * IntToFixed(g_aprgTorrasqueDeaths);
    fixed scale = 125.0 + IntToFixed(g_aprgTorrasqueDeaths);
    if (!CatalogEntryIsValid(c_gameCatalogUnit, "Ultralisk")) { return; }
    p = APRG_FindTorrasqueSpawnPoint(player);
    if (p == null) {
        g_aprgTorrasqueRespawnTime = GameGetMissionTime() + 5.0;
        return;
    }
    owner = APRG_FindHostileOwnerNearPoint(player, p);
    if (owner < 0) {
        g_aprgTorrasqueRespawnTime = GameGetMissionTime() + 5.0;
        return;
    }
    created = UnitCreate(1, "Ultralisk", c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
    g_aprgTorrasque = UnitGroupUnitFromEnd(created, 1);
    if (g_aprgTorrasque == null) {
        g_aprgTorrasqueRespawnTime = GameGetMissionTime() + 5.0;
        return;
    }
    maximum = UnitGetPropertyFixed(g_aprgTorrasque, c_unitPropLifeMax, c_unitPropCurrent);
    if (maximum > 0.0) {
        UnitSetPropertyFixed(g_aprgTorrasque, c_unitPropLifeMax, maximum * lifeFactor);
        UnitSetPropertyFixed(g_aprgTorrasque, c_unitPropLife, maximum * lifeFactor);
    }
    APRG_RegisterMutationEnemyGroup(created);
    APRG_StripVoidEntityBehavior(g_aprgTorrasque);
    if (CatalogEntryIsValid(c_gameCatalogBehavior, "APRogueTorrasqueArmor")) {
        UnitBehaviorAdd(g_aprgTorrasque, "APRogueTorrasqueArmor", g_aprgTorrasque, 1);
    }
    UnitSetScale(g_aprgTorrasque, scale, scale, scale);
    APRG_OrderTorrasqueAtPlayerBase(player);
    g_aprgTorrasqueNextRetargetTime = GameGetMissionTime() + 10.0;
    g_aprgTorrasqueProgressPoint = UnitGetPosition(g_aprgTorrasque);
    g_aprgTorrasqueProgressTime = GameGetMissionTime();
    g_aprgTorrasqueRespawnTime = -1.0;
}

void APRG_TickTorrasque(int player, fixed now) {
    unit target;
    point currentPoint;
    point targetPoint;
    fixed targetDistance;
    if (!APRG_PlayerMacroBaseReady(player)) { return; }
    if (g_aprgTorrasqueFirstTime < 0.0) { g_aprgTorrasqueFirstTime = g_aprgMacroReadyTime + 180.0; }
    if (g_aprgTorrasque == null) {
        if (now >= g_aprgTorrasqueFirstTime && (g_aprgTorrasqueRespawnTime < 0.0 || now >= g_aprgTorrasqueRespawnTime)) {
            APRG_SpawnTorrasque(player);
        }
        return;
    }
    if (!UnitIsAlive(g_aprgTorrasque)) {
        if (g_aprgTorrasqueRespawnTime < 0.0) {
            g_aprgTorrasqueDeaths += 1;
            g_aprgTorrasqueRespawnTime = now + 5.0;
        }
        if (now >= g_aprgTorrasqueRespawnTime) {
            g_aprgTorrasque = null;
            APRG_SpawnTorrasque(player);
        }
        return;
    }
    if (g_aprgTorrasqueNextRetargetTime < 0.0 || now >= g_aprgTorrasqueNextRetargetTime) {
        APRG_OrderTorrasqueAtPlayerBase(player);
        g_aprgTorrasqueNextRetargetTime = now + 10.0;
    }

    // If the Torrasque has made essentially no progress for 30 seconds while still
    // far from the player, let it break allied buildings that are physically in the way.
    currentPoint = UnitGetPosition(g_aprgTorrasque);
    target = APRG_NearestPlayerStructure(currentPoint, player);
    if (target != null) {
        targetPoint = UnitGetPosition(target);
        targetDistance = DistanceBetweenPoints(currentPoint, targetPoint);
        if (g_aprgTorrasqueProgressPoint == null || DistanceBetweenPoints(currentPoint, g_aprgTorrasqueProgressPoint) >= 2.0 || targetDistance <= 10.0) {
            g_aprgTorrasqueProgressPoint = currentPoint;
            g_aprgTorrasqueProgressTime = now;
        }
        else if (g_aprgTorrasqueProgressTime >= 0.0 && now - g_aprgTorrasqueProgressTime >= 30.0) {
            if (!APRG_ClearFriendlyBlocker(g_aprgTorrasque, targetPoint, 180.0)) {
                g_aprgTorrasqueProgressPoint = currentPoint;
                g_aprgTorrasqueProgressTime = now;
                APRG_OrderTorrasqueAtPlayerBase(player);
            }
        }
    }
}

void APRG_EnsureNormalShieldRegeneration(unit u) {
    int owner;
    string unitType;
    fixed catalogRate;
    fixed delay;
    if (u == null || !UnitIsAlive(u)) { return; }
    owner = UnitGetOwner(u);
    unitType = UnitGetType(u);
    if (unitType == "" || !CatalogEntryIsValid(c_gameCatalogUnit, unitType)) { return; }
    catalogRate = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "ShieldRegenRate", owner));
    if (catalogRate > 0.0) { return; }
    CatalogFieldValueSet(c_gameCatalogUnit, unitType, "ShieldRegenRate", owner, "2.0");
    delay = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "ShieldRegenDelay", owner));
    if (delay <= 0.0) { CatalogFieldValueSet(c_gameCatalogUnit, unitType, "ShieldRegenDelay", owner, "10.0"); }
    UnitSetPropertyFixed(u, c_unitPropShieldsRegen, 2.0);
}

void APRG_ApplyNexusShieldToEnemies(int player) {
    unitgroup enemies;
    unit u;
    int i;
    fixed maximum;
    fixed current;
    if (g_aprgNexusShieldBroken) { return; }
    enemies = APRG_EnemyMobileUnits(player);
    for (i = UnitGroupCount(enemies, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(enemies, i);
        if (u == null) { break; }
        if (UnitGroupHasUnit(g_aprgNexusShieldProcessed, u)) { continue; }
        maximum = UnitGetPropertyFixed(u, c_unitPropShieldsMax, c_unitPropCurrent);
        current = UnitGetPropertyFixed(u, c_unitPropShields, c_unitPropCurrent);
        UnitSetPropertyFixed(u, c_unitPropShieldsMax, maximum + 300.0);
        UnitSetPropertyFixed(u, c_unitPropShields, current + 300.0);
        APRG_EnsureNormalShieldRegeneration(u);
        UnitGroupAdd(g_aprgNexusShieldProcessed, u);
    }
}

void APRG_BreakNexusShield() {
    int i;
    unit u;
    fixed maximum;
    fixed current;
    if (g_aprgNexusShieldBroken) { return; }
    g_aprgNexusShieldBroken = true;
    for (i = UnitGroupCount(g_aprgNexusShieldProcessed, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(g_aprgNexusShieldProcessed, i);
        if (u == null) { break; }
        maximum = UnitGetPropertyFixed(u, c_unitPropShieldsMax, c_unitPropCurrent);
        current = UnitGetPropertyFixed(u, c_unitPropShields, c_unitPropCurrent);
        UnitSetPropertyFixed(u, c_unitPropShieldsMax, MaxF(0.0, maximum - 300.0));
        UnitSetPropertyFixed(u, c_unitPropShields, MinF(current, MaxF(0.0, maximum - 300.0)));
    }
}

void APRG_TickNexusShield(int player) {
    unit anchor;
    unit home;
    point p;
    int owner;
    int attempt;
    unitgroup created;
    fixed shields;
    fixed maxShields;
    fixed now;
    int nexusOwner;
    if (!APRG_PlayerMacroBaseReady(player)) { return; }
    if (!g_aprgNexusShieldSpawned) {
        anchor = APRG_RandomHostileBaseAnchor(player);
        home = APRG_FindPlayerHomeStructure(player);
        if (anchor == null || home == null || !CatalogEntryIsValid(c_gameCatalogUnit, "Nexus")) { return; }
        p = null;
        for (attempt = 0; attempt < APRG_MAX_POINT_ATTEMPTS; attempt += 1) {
            p = PointWithOffsetPolar(UnitGetPosition(home), RandomFixed(30.0, 60.0), libNtve_gf_RandomAngle());
            if (p == null || !RegionContainsPoint(RegionPlayableMap(), p) || !PointPathingPassable(p)) { p = null; continue; }
            if ((APRG_GroundSpawnsNeedPlayerPathing() && !PointPathingIsConnected(p, UnitGetPosition(home))) || APRG_PointNearRakShirDuel(p, 24.0)) { p = null; continue; }
            if (APRG_PointNearPlayerOrAlliedBuilding(p, player, 15.0)) { p = null; continue; }
            break;
        }
        if (p == null) { return; }
        owner = UnitGetOwner(anchor);
        created = UnitCreate(1, "Nexus", c_unitCreateIgnorePlacement, owner, p, libNtve_gf_RandomAngle());
        g_aprgNexusShieldNexus = UnitGroupUnitFromEnd(created, 1);
        APRG_RegisterMutationEnemyGroup(created);
        if (g_aprgNexusShieldNexus != null) {
            APRG_StripVoidEntityBehavior(g_aprgNexusShieldNexus);
            APRG_RegisterAlwaysVisibleUnit(g_aprgNexusShieldNexus, player);
        }
        g_aprgNexusShieldSpawned = true;
    }
    if (g_aprgNexusShieldNexus == null || !UnitIsAlive(g_aprgNexusShieldNexus)) { APRG_BreakNexusShield(); return; }
    shields = UnitGetPropertyFixed(g_aprgNexusShieldNexus, c_unitPropShields, c_unitPropCurrent);
    maxShields = UnitGetPropertyFixed(g_aprgNexusShieldNexus, c_unitPropShieldsMax, c_unitPropCurrent);
    now = GameGetMissionTime();
    nexusOwner = UnitGetOwner(g_aprgNexusShieldNexus);

    if (!g_aprgNexusShieldFirstDamageWarped && maxShields > 0.0 && shields <= maxShields - 10.0) {
        g_aprgNexusShieldFirstDamageWarped = true;
        APRG_QueuePurifierHostileWarp("Zealot", nexusOwner, UnitGetPosition(g_aprgNexusShieldNexus), now);
    }
    if (!g_aprgNexusShieldHalfShieldsWarped && maxShields > 0.0 && shields <= maxShields * 0.5) {
        g_aprgNexusShieldHalfShieldsWarped = true;
        APRG_QueuePurifierHostileWarp("Stalker", nexusOwner, UnitGetPosition(g_aprgNexusShieldNexus), now + 0.2);
    }
    if (!g_aprgNexusShieldDepletedWarped && maxShields > 0.0 && shields <= 0.5) {
        g_aprgNexusShieldDepletedWarped = true;
        for (attempt = 0; attempt < 4; attempt += 1) {
            APRG_QueuePurifierHostileWarp("Zealot", nexusOwner, UnitGetPosition(g_aprgNexusShieldNexus), now + 0.2 * IntToFixed(attempt + 2));
            APRG_QueuePurifierHostileWarp("Stalker", nexusOwner, UnitGetPosition(g_aprgNexusShieldNexus), now + 0.2 * IntToFixed(attempt + 5));
        }
    }
    APRG_ApplyNexusShieldToEnemies(player);
}

void APRG_UpdateGargantuanTypeBonuses(unit u, int owner, string keyPrefix) {
    string unitType = UnitGetType(u);
    string weaponType;
    string effectType;
    string key;
    int wi;
    int wc;
    fixed currentValue;
    fixed priorBonus;
    fixed baseValue;
    fixed desiredBonus;
    fixed delta;
    wc = UnitWeaponCount(u);
    for (wi = 1; wi <= wc; wi += 1) {
        weaponType = UnitWeaponGet(u, wi); if (weaponType == "") { continue; }
        effectType = CatalogFieldValueGet(c_gameCatalogWeapon, weaponType, "DisplayEffect", owner);
        if (effectType != "" && CatalogEntryIsValid(c_gameCatalogEffect, effectType)) {
            key = keyPrefix + "Damage_" + IntToString(owner) + "_" + effectType;
            currentValue = StringToFixed(CatalogFieldValueGet(c_gameCatalogEffect, effectType, "Amount", owner)); priorBonus = DataTableGetFixed(true, key);
            baseValue = currentValue - priorBonus; desiredBonus = baseValue * 0.5; delta = desiredBonus - priorBonus;
            if (delta > 0.001 || delta < -0.001) { CatalogFieldValueModify(c_gameCatalogEffect, effectType, "Amount", owner, FixedToString(delta, c_fixedPrecisionAny), c_upgradeOperationAdd); }
            DataTableSetFixed(true, key, desiredBonus);
        }
        key = keyPrefix + "Range_" + IntToString(owner) + "_" + weaponType;
        currentValue = StringToFixed(CatalogFieldValueGet(c_gameCatalogWeapon, weaponType, "Range", owner)); priorBonus = DataTableGetFixed(true, key);
        baseValue = currentValue - priorBonus; desiredBonus = baseValue * 0.5; delta = desiredBonus - priorBonus;
        if (delta > 0.001 || delta < -0.001) { CatalogFieldValueModify(c_gameCatalogWeapon, weaponType, "Range", owner, FixedToString(delta, c_fixedPrecisionAny), c_upgradeOperationAdd); }
        DataTableSetFixed(true, key, desiredBonus);
    }
}

void APRG_ApplyGargantuanEnemies(int player) {
    unitgroup enemies;
    unit u;
    int i;
    int owner;
    fixed maximum;
    fixed current;
    fixed ratio;
    enemies = APRG_EnemyMobileUnits(player);
    for (i = UnitGroupCount(enemies, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(enemies, i);
        if (u == null) { break; }
        owner = UnitGetOwner(u);
        APRG_UpdateGargantuanTypeBonuses(u, owner, "APRG_GargEnemy_");
        if (UnitGroupHasUnit(g_aprgGargantuanProcessed, u)) { continue; }
        maximum = UnitGetPropertyFixed(u, c_unitPropLifeMax, c_unitPropCurrent);
        current = UnitGetPropertyFixed(u, c_unitPropLife, c_unitPropCurrent);
        if (maximum > 0.0) {
            ratio = current / maximum;
            UnitSetPropertyFixed(u, c_unitPropLifeMax, maximum * 1.5);
            UnitSetPropertyFixed(u, c_unitPropLife, maximum * 1.5 * ratio);
        }
        APRG_ScaleUnitShields(u, 1.5);
        UnitSetScale(u, 150.0, 150.0, 150.0);
        UnitGroupAdd(g_aprgGargantuanProcessed, u);
    }
}


void APRG_ApplyGargantuanToTrainedUnit(unit u, int player) {
    fixed maximum;
    fixed current;
    fixed ratio;
    fixed maxRange = 0.0;
    fixed weaponRange;
    int wi;
    int wc;
    int stacks;
    if (u == null || !UnitIsAlive(u) || UnitGetOwner(u) != player) { return; }
    if (UnitTypeTestAttribute(UnitGetType(u), c_unitAttributeStructure)) { return; }
    if (UnitGroupHasUnit(g_aprgGargantuanPlayerProcessed, u)) { return; }

    if (CatalogEntryIsValid(c_gameCatalogBehavior, "APRogueGargantuanTrainedDamage")) {
        UnitBehaviorAdd(u, "APRogueGargantuanTrainedDamage", u, 1);
    }
    wc = UnitWeaponCount(u);
    for (wi = 1; wi <= wc; wi += 1) {
        weaponRange = UnitWeaponRange(u, wi);
        if (weaponRange > maxRange) { maxRange = weaponRange; }
    }
    if (maxRange > 0.0 && CatalogEntryIsValid(c_gameCatalogBehavior, "APRogueGargantuanRangeQuarter")) {
        stacks = MaxI(1, FixedToInt(RoundI(maxRange * 2.0)));
        UnitBehaviorAdd(u, "APRogueGargantuanRangeQuarter", u, stacks);
    }

    maximum = UnitGetPropertyFixed(u, c_unitPropLifeMax, c_unitPropCurrent);
    current = UnitGetPropertyFixed(u, c_unitPropLife, c_unitPropCurrent);
    if (maximum > 0.0) {
        ratio = current / maximum;
        UnitSetPropertyFixed(u, c_unitPropLifeMax, maximum * 1.5);
        UnitSetPropertyFixed(u, c_unitPropLife, maximum * 1.5 * ratio);
    }
    APRG_ScaleUnitShields(u, 1.5);
    UnitSetScale(u, 150.0, 150.0, 150.0);
    UnitGroupAdd(g_aprgGargantuanPlayerProcessed, u);
}

void APRG_ApplyGargantuanPlayerUnits(int player) {
}


bool APRG_IsDefensiveStructureType(string unitType) {
    return
        StringContains(unitType, "Bunker", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "MissileTurret", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "DevastatorTurret", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "PerditionTurret", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "PlanetaryFortress", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "PsiDisrupter", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "HiveMindEmulator", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "SpineCrawler", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "SporeCrawler", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "BileLauncher", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "PhotonCannon", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "KhaydarinMonolith", c_stringAnywhere, c_stringNoCase);
}

bool APRG_IsFieryUnitType(string unitType) {
    if (unitType == "") { return false; }
    if (StringContains(unitType, "Colossus", c_stringAnywhere, c_stringNoCase)) {
        return unitType == "Colossus" || unitType == "AP_Colossus";
    }
    return
        StringContains(unitType, "Hellion", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Firebat", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "DevilDog", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Hellbat", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Igniter", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Flame", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Fire", c_stringAnywhere, c_stringNoCase);
}

bool APRG_IsInsidePlayerBunker(unit source, int player) {
    unit transport;
    if (source == null) { return false; }
    transport = UnitTransport(source);
    if (transport == null || UnitGetOwner(transport) != player) { return false; }
    return StringContains(UnitGetType(transport), "Bunker", c_stringAnywhere, c_stringNoCase);
}

bool APRG_DefenderDamage_Func(bool testConds, bool runActions) {
    unit victim;
    unit source;
    int player;
    int owner;
    fixed damage;
    fixed bonusMultiplier;
    string sourceType;
    if (!runActions || !g_aprgStarted || g_aprgDefenderBonusDamageBusy) { return true; }
    if (!APRG_HasExtension2(APRG_EXT2_BOON_DEFENDER) && !APRG_HasExtension3(APRG_EXT3_BOON_MISSILE_DEFENSE)) { return true; }
    victim = EventUnit();
    source = EventUnitDamageSourceUnit();
    if (victim == null || source == null || victim == source) { return true; }
    player = APRG_GetPrimaryPlayer();
    if (UnitGetOwner(source) != player) { return true; }
    owner = UnitGetOwner(victim);
    if (owner < 0 || !libNtve_gf_PlayerIsEnemy(owner, player, libNtve_ge_PlayerRelation_Enemy)) { return true; }
    sourceType = UnitGetType(source);
    bonusMultiplier = 0.0;
    if (APRG_HasExtension2(APRG_EXT2_BOON_DEFENDER) && !APRG_IsDefensiveStructureType(sourceType) && APRG_IsInsidePlayerBunker(source, player)) {
        bonusMultiplier += 0.5;
    }
    if (APRG_HasExtension3(APRG_EXT3_BOON_MISSILE_DEFENSE) && StringContains(sourceType, "MissileTurret", c_stringAnywhere, c_stringNoCase)) {
        bonusMultiplier += 0.5;
    }
    if (bonusMultiplier <= 0.0) { return true; }
    damage = EventUnitDamageAmount();
    if (damage <= 0.0) { return true; }
    g_aprgDefenderBonusDamageBusy = true;
    APRG_DealDirectDamage(victim, damage * bonusMultiplier);
    g_aprgDefenderBonusDamageBusy = false;
    return true;
}

void APRG_ApplyFirePower(int player) {
    unitgroup units;
    unit u;
    int i;
    int wi;
    int wc;
    int applied;
    string unitType;
    string weaponType;
    string key;
    fixed oldMultiplier;
    fixed newMultiplier;
    fixed periodMultiplier;
    if (g_aprgFirePowerStacks <= 0) { return; }
    units = APRG_PlayerMobileUnits(player);
    for (i = UnitGroupCount(units, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null) { continue; }
        unitType = UnitGetType(u);
        if (!APRG_IsFieryUnitType(unitType)) { continue; }
        wc = UnitWeaponCount(u);
        for (wi = 1; wi <= wc; wi += 1) {
            weaponType = UnitWeaponGet(u, wi);
            if (weaponType == "") { continue; }
            key = "APRG_FirePowerApplied_" + IntToString(player) + "_" + weaponType;
            applied = DataTableGetInt(true, key);
            while (applied < g_aprgFirePowerStacks) {
                oldMultiplier = 1.0 + 0.1 * IntToFixed(applied);
                newMultiplier = 1.0 + 0.1 * IntToFixed(applied + 1);
                periodMultiplier = oldMultiplier / newMultiplier;
                CatalogFieldValueModify(
                    c_gameCatalogWeapon,
                    weaponType,
                    "Period",
                    player,
                    FixedToString(periodMultiplier, c_fixedPrecisionAny),
                    c_upgradeOperationMultiply
                );
                applied += 1;
            }
            DataTableSetInt(true, key, applied);
        }
    }
}

bool APRG_IsAdamantiumMeleeWeapon(unit u, int weaponIndex) {
    string weaponType;
    string meleeFlag;
    fixed range;
    if (u == null || weaponIndex <= 0 || weaponIndex > UnitWeaponCount(u)) { return false; }
    if (!UnitWeaponIsEnabled(u, weaponIndex)) { return false; }
    weaponType = UnitWeaponGet(u, weaponIndex);
    if (weaponType == "") { return false; }

    meleeFlag = CatalogFieldValueGet(c_gameCatalogWeapon, weaponType, "Options[Melee]", UnitGetOwner(u));
    if (meleeFlag == "1" || meleeFlag == "true" || meleeFlag == "True") { return true; }
    range = UnitWeaponRange(u, weaponIndex);
    return range >= 0.0 && range <= 0.5;
}

void APRG_ReconcileAdamantiumDamageField(string effectType, int player, string fieldPath, string fieldKey) {
    string key;
    string amountText;
    fixed currentAmount;
    fixed priorBonus;
    fixed baseAmount;
    fixed desiredBonus;
    fixed delta;
    if (effectType == "" || !CatalogEntryIsValid(c_gameCatalogEffect, effectType)) { return; }
    amountText = CatalogFieldValueGet(c_gameCatalogEffect, effectType, fieldPath, player);
    if (amountText == "") { return; }
    currentAmount = StringToFixed(amountText);
    if (currentAmount == 0.0) { return; }

    key = "APRG_AdamantiumBonus_" + IntToString(player) + "_" + effectType + "_" + fieldKey;
    priorBonus = DataTableGetFixed(true, key);
    baseAmount = currentAmount - priorBonus;
    if (fieldKey == "Amount") {
        baseAmount -= DataTableGetFixed(true, "APRG_BoonDeadlyBonus_" + IntToString(player) + "_" + effectType);
    }
    desiredBonus = baseAmount;
    delta = desiredBonus - priorBonus;
    if (delta > 0.001 || delta < -0.001) {
        CatalogFieldValueModify(c_gameCatalogEffect, effectType, fieldPath, player, FixedToString(delta, c_fixedPrecisionAny), c_upgradeOperationAdd);
    }
    DataTableSetFixed(true, key, desiredBonus);
}

void APRG_ReconcileAdamantiumDamageEffect(string effectType, int player) {
    if (effectType == "" || !CatalogEntryIsValid(c_gameCatalogEffect, effectType)) { return; }
    APRG_ReconcileAdamantiumDamageField(effectType, player, "Amount", "Amount");
    APRG_ReconcileAdamantiumDamageField(effectType, player, "AttributeBonus[Light]", "Light");
    APRG_ReconcileAdamantiumDamageField(effectType, player, "AttributeBonus[Armored]", "Armored");
    APRG_ReconcileAdamantiumDamageField(effectType, player, "AttributeBonus[Biological]", "Biological");
    APRG_ReconcileAdamantiumDamageField(effectType, player, "AttributeBonus[Mechanical]", "Mechanical");
    APRG_ReconcileAdamantiumDamageField(effectType, player, "AttributeBonus[Massive]", "Massive");
    APRG_ReconcileAdamantiumDamageField(effectType, player, "AttributeBonus[Psionic]", "Psionic");
    APRG_ReconcileAdamantiumDamageField(effectType, player, "AttributeBonus[Structure]", "Structure");
    APRG_ReconcileAdamantiumDamageField(effectType, player, "AttributeBonus[Heroic]", "Heroic");
}

string APRG_AdamantiumChildEffect(string effectType, int player, int childIndex) {
    if (effectType == "" || !CatalogEntryIsValid(c_gameCatalogEffect, effectType)) { return ""; }
    if (childIndex == 0) { return CatalogFieldValueGet(c_gameCatalogEffect, effectType, "Effect", player); }
    if (childIndex == 1) { return CatalogFieldValueGet(c_gameCatalogEffect, effectType, "ImpactEffect", player); }
    if (childIndex == 2) { return CatalogFieldValueGet(c_gameCatalogEffect, effectType, "FinalEffect", player); }
    if (childIndex == 3) { return CatalogFieldValueGet(c_gameCatalogEffect, effectType, "LaunchEffect", player); }
    if (childIndex == 4) { return CatalogFieldValueGet(c_gameCatalogEffect, effectType, "InitialEffect", player); }
    if (childIndex == 5) { return CatalogFieldValueGet(c_gameCatalogEffect, effectType, "PeriodicEffect", player); }
    if (childIndex >= 6 && childIndex < 22) {
        return CatalogFieldValueGet(c_gameCatalogEffect, effectType, "EffectArray[" + IntToString(childIndex - 6) + "]", player);
    }
    return "";
}

void APRG_ReconcileAdamantiumWeapons(unit u, int player) {
    int wi;
    int wc;
    int ci;
    int gi;
    int hi;
    string weaponType;
    string rootEffect;
    string childEffect;
    string grandchildEffect;
    string greatGrandchildEffect;
    if (u == null || !UnitIsAlive(u)) { return; }
    wc = UnitWeaponCount(u);
    for (wi = 1; wi <= wc; wi += 1) {
        if (!APRG_IsAdamantiumMeleeWeapon(u, wi)) { continue; }
        weaponType = UnitWeaponGet(u, wi);
        if (weaponType == "") { continue; }
        rootEffect = CatalogFieldValueGet(c_gameCatalogWeapon, weaponType, "DisplayEffect", player);
        if (rootEffect == "") { rootEffect = CatalogFieldValueGet(c_gameCatalogWeapon, weaponType, "Effect", player); }
        if (rootEffect == "" || !CatalogEntryIsValid(c_gameCatalogEffect, rootEffect)) { continue; }

        APRG_ReconcileAdamantiumDamageEffect(rootEffect, player);
        for (ci = 0; ci < 22; ci += 1) {
            childEffect = APRG_AdamantiumChildEffect(rootEffect, player, ci);
            if (childEffect == "" || childEffect == rootEffect) { continue; }
            APRG_ReconcileAdamantiumDamageEffect(childEffect, player);
            for (gi = 0; gi < 22; gi += 1) {
                grandchildEffect = APRG_AdamantiumChildEffect(childEffect, player, gi);
                if (grandchildEffect == "" || grandchildEffect == childEffect || grandchildEffect == rootEffect) { continue; }
                APRG_ReconcileAdamantiumDamageEffect(grandchildEffect, player);
                for (hi = 0; hi < 22; hi += 1) {
                    greatGrandchildEffect = APRG_AdamantiumChildEffect(grandchildEffect, player, hi);
                    if (greatGrandchildEffect == "" || greatGrandchildEffect == grandchildEffect || greatGrandchildEffect == childEffect || greatGrandchildEffect == rootEffect) { continue; }
                    APRG_ReconcileAdamantiumDamageEffect(greatGrandchildEffect, player);
                }
            }
        }
    }
}


void APRG_ReconcileDeadlyVultureDamageField(string effectType, int player, string fieldPath, string fieldKey) {
    string key;
    string amountText;
    fixed currentAmount;
    fixed priorBonus;
    fixed baseAmount;
    fixed desiredBonus;
    fixed delta;
    if (effectType == "" || !CatalogEntryIsValid(c_gameCatalogEffect, effectType)) { return; }
    amountText = CatalogFieldValueGet(c_gameCatalogEffect, effectType, fieldPath, player);
    if (amountText == "") { return; }
    currentAmount = StringToFixed(amountText);
    if (currentAmount == 0.0) { return; }
    key = "APRG_DeadlyVultureBonus_" + IntToString(player) + "_" + effectType + "_" + fieldKey;
    priorBonus = DataTableGetFixed(true, key);
    baseAmount = currentAmount - priorBonus;
    desiredBonus = baseAmount * 9.0;
    delta = desiredBonus - priorBonus;
    if (delta > 0.001 || delta < -0.001) {
        CatalogFieldValueModify(c_gameCatalogEffect, effectType, fieldPath, player, FixedToString(delta, c_fixedPrecisionAny), c_upgradeOperationAdd);
    }
    DataTableSetFixed(true, key, desiredBonus);
}

void APRG_ReconcileDeadlyVultureDamageEffect(string effectType, int player) {
    if (effectType == "" || !CatalogEntryIsValid(c_gameCatalogEffect, effectType)) { return; }
    APRG_ReconcileDeadlyVultureDamageField(effectType, player, "Amount", "Amount");
    APRG_ReconcileDeadlyVultureDamageField(effectType, player, "AttributeBonus[Light]", "Light");
    APRG_ReconcileDeadlyVultureDamageField(effectType, player, "AttributeBonus[Armored]", "Armored");
    APRG_ReconcileDeadlyVultureDamageField(effectType, player, "AttributeBonus[Biological]", "Biological");
    APRG_ReconcileDeadlyVultureDamageField(effectType, player, "AttributeBonus[Mechanical]", "Mechanical");
    APRG_ReconcileDeadlyVultureDamageField(effectType, player, "AttributeBonus[Massive]", "Massive");
    APRG_ReconcileDeadlyVultureDamageField(effectType, player, "AttributeBonus[Psionic]", "Psionic");
    APRG_ReconcileDeadlyVultureDamageField(effectType, player, "AttributeBonus[Structure]", "Structure");
    APRG_ReconcileDeadlyVultureDamageField(effectType, player, "AttributeBonus[Heroic]", "Heroic");
}

void APRG_ReconcileDeadlyVultureWeapons(unit u, int player) {
    int wi;
    int wc;
    int ci;
    int gi;
    int hi;
    string weaponType;
    string rootEffect;
    string childEffect;
    string grandchildEffect;
    string greatGrandchildEffect;
    if (u == null || !UnitIsAlive(u) || !StringContains(UnitGetType(u), "Vulture", c_stringAnywhere, c_stringNoCase)) { return; }
    wc = UnitWeaponCount(u);
    for (wi = 1; wi <= wc; wi += 1) {
        weaponType = UnitWeaponGet(u, wi);
        if (weaponType == "") { continue; }
        rootEffect = CatalogFieldValueGet(c_gameCatalogWeapon, weaponType, "DisplayEffect", player);
        if (rootEffect == "") { rootEffect = CatalogFieldValueGet(c_gameCatalogWeapon, weaponType, "Effect", player); }
        if (rootEffect == "" || !CatalogEntryIsValid(c_gameCatalogEffect, rootEffect)) { continue; }
        APRG_ReconcileDeadlyVultureDamageEffect(rootEffect, player);
        for (ci = 0; ci < 22; ci += 1) {
            childEffect = APRG_AdamantiumChildEffect(rootEffect, player, ci);
            if (childEffect == "" || childEffect == rootEffect) { continue; }
            APRG_ReconcileDeadlyVultureDamageEffect(childEffect, player);
            for (gi = 0; gi < 22; gi += 1) {
                grandchildEffect = APRG_AdamantiumChildEffect(childEffect, player, gi);
                if (grandchildEffect == "" || grandchildEffect == childEffect || grandchildEffect == rootEffect) { continue; }
                APRG_ReconcileDeadlyVultureDamageEffect(grandchildEffect, player);
                for (hi = 0; hi < 22; hi += 1) {
                    greatGrandchildEffect = APRG_AdamantiumChildEffect(grandchildEffect, player, hi);
                    if (greatGrandchildEffect == "" || greatGrandchildEffect == grandchildEffect || greatGrandchildEffect == childEffect || greatGrandchildEffect == rootEffect) { continue; }
                    APRG_ReconcileDeadlyVultureDamageEffect(greatGrandchildEffect, player);
                }
            }
        }
    }
}

void APRG_ApplyBoonCombatStats(int player) {
    unitgroup units;
    unitgroup mobileUnits;
    unit u;
    int i;
    int wi;
    int wc;
    string unitType;
    string weaponType;
    string effectType;
    string key;
    fixed value;
    fixed priorBonus;
    fixed baseValue;
    fixed desiredBonus;
    fixed delta;
    fixed maximum;
    fixed current;
    units = APRG_PlayerAllUnits(player);
    mobileUnits = APRG_PlayerMobileUnits(player);
    for (i = UnitGroupCount(units, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null) { break; }
        unitType = UnitGetType(u);
        if (APRG_HasExtension3(APRG_EXT3_BOON_MISSILE_DEFENSE) && StringContains(unitType, "MissileTurret", c_stringAnywhere, c_stringNoCase)) {
            key = "APRG_MissileDefenseHP_" + IntToString(UnitGetTag(u));
            if (!DataTableGetBool(true, key)) {
                maximum = UnitGetPropertyFixed(u, c_unitPropLifeMax, c_unitPropCurrent);
                current = UnitGetPropertyFixed(u, c_unitPropLife, c_unitPropCurrent);
                if (maximum > 0.0) {
                    UnitSetPropertyFixed(u, c_unitPropLifeMax, maximum * 1.5);
                    UnitSetPropertyFixed(u, c_unitPropLife, current * 1.5);
                }
                DataTableSetBool(true, key, true);
            }
        }
        if (APRG_HasExtension2(APRG_EXT2_BOON_AUTO_REPAIR) && g_aprgAutoRepairStacks > 0) {
            key = "APRG_BoonRepairStacks_" + IntToString(UnitGetTag(u));
            wi = DataTableGetInt(true, key);
            while (wi < g_aprgAutoRepairStacks) {
                UnitSetPropertyFixed(u, c_unitPropLifeRegen, UnitGetPropertyFixed(u, c_unitPropLifeRegen, c_unitPropCurrent) + 1.0);
                UnitSetPropertyFixed(u, c_unitPropShieldsRegen, UnitGetPropertyFixed(u, c_unitPropShieldsRegen, c_unitPropCurrent) + 1.0);
                wi += 1;
            }
            DataTableSetInt(true, key, wi);
        }
        if (APRG_HasExtension2(APRG_EXT2_BOON_HEAVY_ARMOR) && (
            APRG_IsThorFamilyType(unitType) || APRG_IsUltraliskFamilyType(unitType) ||
            StringContains(unitType,"Archon",c_stringAnywhere,c_stringNoCase))) {
            key = "APRG_BoonHeavy_" + IntToString(player) + "_" + unitType;
            if (!DataTableGetBool(true, key)) {
                CatalogFieldValueModify(c_gameCatalogUnit, unitType, "LifeArmor", player, "5.0", c_upgradeOperationAdd);
                CatalogFieldValueModify(c_gameCatalogUnit, unitType, "ShieldArmor", player, "5.0", c_upgradeOperationAdd);
                DataTableSetBool(true, key, true);
            }
        }
        if (APRG_HasBlessing(APRG_BOON_ADAMANTIUM_BLADES)) {
            APRG_ReconcileAdamantiumWeapons(u, player);
        }
        if (APRG_HasExtension4(APRG_EXT4_BOON_DEADLY_VULTURES) && StringContains(unitType, "Vulture", c_stringAnywhere, c_stringNoCase)) {
            APRG_ReconcileDeadlyVultureWeapons(u, player);
        }
        wc = UnitWeaponCount(u);
        for (wi = 1; wi <= wc; wi += 1) {
            weaponType = UnitWeaponGet(u, wi);
            if (weaponType == "") { continue; }
            if (APRG_HasExtension3(APRG_EXT3_BOON_MISSILE_DEFENSE) && StringContains(unitType, "MissileTurret", c_stringAnywhere, c_stringNoCase)) {
                key = "APRG_MissileDefenseWeapon_" + IntToString(player) + "_" + weaponType;
                if (!DataTableGetBool(true, key)) {
                    CatalogFieldValueModify(c_gameCatalogWeapon, weaponType, "Range", player, "1.5", c_upgradeOperationMultiply);
                    CatalogFieldValueModify(c_gameCatalogWeapon, weaponType, "Period", player, FixedToString(1.0 / 1.5, c_fixedPrecisionAny), c_upgradeOperationMultiply);
                    DataTableSetBool(true, key, true);
                }
            }
            if (APRG_HasExtension2(APRG_EXT2_BOON_DEFENDER) && APRG_IsDefensiveStructureType(unitType)) {
                key = "APRG_BoonDefenderWeapon_" + IntToString(player) + "_" + weaponType;
                if (!DataTableGetBool(true, key)) {
                    CatalogFieldValueModify(c_gameCatalogWeapon, weaponType, "Range", player, "1.5", c_upgradeOperationMultiply);
                    effectType = CatalogFieldValueGet(c_gameCatalogWeapon, weaponType, "DisplayEffect", player);
                    if (effectType != "" && CatalogEntryIsValid(c_gameCatalogEffect, effectType)) {
                        value = StringToFixed(CatalogFieldValueGet(c_gameCatalogEffect, effectType, "Amount", player));
                        if (value > 0.0) {
                            CatalogFieldValueModify(c_gameCatalogEffect, effectType, "Amount", player, "1.5", c_upgradeOperationMultiply);
                        }
                    }
                    DataTableSetBool(true, key, true);
                }
            }
            if (APRG_HasExtension2(APRG_EXT2_BOON_RAPID_FIRE)) {
                key = "APRG_BoonRapid_" + IntToString(player) + "_" + weaponType;
                if (!DataTableGetBool(true, key)) {
                    CatalogFieldValueModify(c_gameCatalogWeapon, weaponType, "Period", player, FixedToString(1.0/1.3,c_fixedPrecisionAny), c_upgradeOperationMultiply);
                    DataTableSetBool(true, key, true);
                }
            }
            if (APRG_HasExtension2(APRG_EXT2_BOON_INTERPLANETARY_FORTRESS) && StringContains(unitType,"PlanetaryFortress",c_stringAnywhere,c_stringNoCase)) {
                key = "APRG_BoonPF_" + IntToString(player) + "_" + weaponType;
                if (!DataTableGetBool(true, key)) {
                    CatalogFieldValueModify(c_gameCatalogWeapon, weaponType, "Range", player, "100.0", c_upgradeOperationAdd);
                    DataTableSetBool(true, key, true);
                }
            }
            if (APRG_HasExtension2(APRG_EXT2_BOON_DEADLY_WEAPONS) && g_aprgDeadlyWeaponsStacks > 0) {
                effectType = CatalogFieldValueGet(c_gameCatalogWeapon, weaponType, "DisplayEffect", player);
                key = "APRG_BoonDeadlyBonus_" + IntToString(player) + "_" + effectType;
                if (effectType != "" && CatalogEntryIsValid(c_gameCatalogEffect,effectType)) {
                    value = StringToFixed(CatalogFieldValueGet(c_gameCatalogEffect, effectType, "Amount", player));
                    priorBonus = DataTableGetFixed(true, key);
                    baseValue = value - priorBonus;
                    desiredBonus = baseValue * 0.3 * IntToFixed(g_aprgDeadlyWeaponsStacks);
                    delta = desiredBonus - priorBonus;
                    if (delta > 0.001 || delta < -0.001) {
                        CatalogFieldValueModify(c_gameCatalogEffect, effectType, "Amount", player, FixedToString(delta, c_fixedPrecisionAny), c_upgradeOperationAdd);
                    }
                    DataTableSetFixed(true, key, desiredBonus);
                }
            }
        }
    }
}

void APRG_ZeroAbilityCooldownPath(int player, string abilityType, string basePath) {
    string field;
    string value;
    if (abilityType == "" || basePath == "" || !CatalogEntryIsValid(c_gameCatalogAbil, abilityType)) { return; }
    field = basePath + ".Cooldown.TimeStart";
    value = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, field, player);
    if (value != "" && StringToFixed(value) != 0.0) { CatalogFieldValueSet(c_gameCatalogAbil, abilityType, field, player, "0"); }
    field = basePath + ".Cooldown.TimeUse";
    value = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, field, player);
    if (value != "" && StringToFixed(value) != 0.0) { CatalogFieldValueSet(c_gameCatalogAbil, abilityType, field, player, "0"); }
    field = basePath + ".Charge.TimeStart";
    value = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, field, player);
    if (value != "" && StringToFixed(value) != 0.0) { CatalogFieldValueSet(c_gameCatalogAbil, abilityType, field, player, "0"); }
    field = basePath + ".Charge.TimeUse";
    value = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, field, player);
    if (value != "" && StringToFixed(value) != 0.0) { CatalogFieldValueSet(c_gameCatalogAbil, abilityType, field, player, "0"); }
}

void APRG_SetAbilityCooldownNearZero(int player, string abilityType) {
    int costCount;
    int costIndex;
    int infoCount;
    int infoIndex;
    int nestedCount;
    int nestedIndex;
    string infoPath;
    if (abilityType == "" || !CatalogEntryIsValid(c_gameCatalogAbil, abilityType)) { return; }
    APRG_ZeroAbilityCooldownPath(player, abilityType, "Cost");
    costCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, "Cost", player);
    for (costIndex = 0; costIndex < costCount; costIndex += 1) {
        APRG_ZeroAbilityCooldownPath(player, abilityType, "Cost[" + IntToString(costIndex) + "]");
    }
    infoCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, "InfoArray", player);
    for (infoIndex = 0; infoIndex < infoCount; infoIndex += 1) {
        infoPath = "InfoArray[" + IntToString(infoIndex) + "]";
        APRG_ZeroAbilityCooldownPath(player, abilityType, infoPath);
        APRG_ZeroAbilityCooldownPath(player, abilityType, infoPath + ".Cost");
        nestedCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, infoPath + ".Cost", player);
        for (nestedIndex = 0; nestedIndex < nestedCount; nestedIndex += 1) {
            APRG_ZeroAbilityCooldownPath(player, abilityType, infoPath + ".Cost[" + IntToString(nestedIndex) + "]");
        }
    }
}

bool APRG_IsUnlimitedBlinkUnitType(string unitType) {
    return unitType != "" && (
        StringContains(unitType, "Stalker", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Slayer", c_stringAnywhere, c_stringNoCase) ||
        StringContains(unitType, "Instigator", c_stringAnywhere, c_stringNoCase)
    );
}

void APRG_ApplyUnlimitedBlink(int player) {
    unitgroup units;
    unit u;
    int i;
    int abilityCount;
    int abilityIndex;
    int infoCount;
    int commandIndex;
    string abilityType;
    string unitType;

    APRG_SetAbilityCooldownNearZero(player, "Blink");
    APRG_SetAbilityCooldownNearZero(player, "AP_Blink");
    APRG_SetAbilityCooldownNearZero(player, "AP_BlinkMultiple");
    APRG_SetAbilityCooldownNearZero(player, "APRogueBlink");

    units = APRG_PlayerMobileUnits(player);
    for (i = UnitGroupCount(units, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null) { continue; }
        unitType = UnitGetType(u);
        if (!APRG_IsUnlimitedBlinkUnitType(unitType)) { continue; }
        abilityCount = UnitAbilityCount(u);
        for (abilityIndex = 1; abilityIndex <= abilityCount; abilityIndex += 1) {
            abilityType = UnitAbilityGet(u, abilityIndex);
            if (abilityType == "" || !StringContains(abilityType, "Blink", c_stringAnywhere, c_stringNoCase)) { continue; }
            APRG_SetAbilityCooldownNearZero(player, abilityType);
            UnitAbilityReset(u, AbilityCommand(abilityType, 0), c_spendLocationAll);
            infoCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, "InfoArray", player);
            for (commandIndex = 1; commandIndex < infoCount; commandIndex += 1) {
                UnitAbilityReset(u, AbilityCommand(abilityType, commandIndex), c_spendLocationAll);
            }
        }
    }
}

bool APRG_RoachInfestationUnitType(string unitType) {
    return unitType != "" &&
        StringContains(unitType, "Roach", c_stringAnywhere, c_stringNoCase) &&
        !StringContains(unitType, "Warren", c_stringAnywhere, c_stringNoCase);
}

void APRG_ZeroRoachProductionInfo(int player, string abilityType, int infoIndex) {
    string basePath;
    if (abilityType == "" || infoIndex < 0) { return; }
    basePath = "InfoArray[" + IntToString(infoIndex) + "]";
    CatalogFieldValueSet(c_gameCatalogAbil, abilityType, basePath + ".Resource[0]", player, "0");
    CatalogFieldValueSet(c_gameCatalogAbil, abilityType, basePath + ".Resource[1]", player, "0");
    CatalogFieldValueSet(c_gameCatalogAbil, abilityType, basePath + ".Cost.Resource[0]", player, "0");
    CatalogFieldValueSet(c_gameCatalogAbil, abilityType, basePath + ".Cost.Resource[1]", player, "0");
}

void APRG_ApplyRoachInfestation(int player) {
    int count;
    int i;
    int infoCount;
    int infoIndex;
    int unitCount;
    int unitIndex;
    bool producesRoach;
    string unitType;
    string abilityType;
    string trainedUnitType;
    string basePath;
    if (g_aprgRoachInfestationApplied) { return; }

    count = CatalogEntryCount(c_gameCatalogUnit);
    for (i = 1; i <= count; i += 1) {
        unitType = CatalogEntryGet(c_gameCatalogUnit, i);
        if (!APRG_RoachInfestationUnitType(unitType)) { continue; }
        CatalogFieldValueSet(c_gameCatalogUnit, unitType, "CostResource[0]", player, "0");
        CatalogFieldValueSet(c_gameCatalogUnit, unitType, "CostResource[1]", player, "0");
    }

    count = CatalogEntryCount(c_gameCatalogAbil);
    for (i = 1; i <= count; i += 1) {
        abilityType = CatalogEntryGet(c_gameCatalogAbil, i);
        if (abilityType == "" || !CatalogEntryIsValid(c_gameCatalogAbil, abilityType)) { continue; }
        infoCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, "InfoArray", player);
        for (infoIndex = 0; infoIndex < infoCount; infoIndex += 1) {
            basePath = "InfoArray[" + IntToString(infoIndex) + "]";
            producesRoach = false;
            trainedUnitType = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, basePath + ".Unit", player);
            if (APRG_RoachInfestationUnitType(trainedUnitType)) { producesRoach = true; }
            unitCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, basePath + ".Unit", player);
            for (unitIndex = 0; unitIndex < unitCount && !producesRoach; unitIndex += 1) {
                trainedUnitType = CatalogFieldValueGet(
                    c_gameCatalogAbil,
                    abilityType,
                    basePath + ".Unit[" + IntToString(unitIndex) + "]",
                    player
                );
                if (APRG_RoachInfestationUnitType(trainedUnitType)) { producesRoach = true; }
            }
            if (producesRoach) { APRG_ZeroRoachProductionInfo(player, abilityType, infoIndex); }
        }
    }
    g_aprgRoachInfestationApplied = true;
}

void APRG_TickToxicObservation(int player, fixed now) {
    unitgroup observers;
    unitgroup enemies;
    unitgroup damaged;
    unit observer;
    unit target;
    int i;
    int j;
    if (now < g_aprgNextToxicObservationTime) { return; }
    g_aprgNextToxicObservationTime = now + 1.0;
    observers = APRG_PlayerMobileUnits(player);
    damaged = UnitGroupEmpty();
    for (i = UnitGroupCount(observers,c_unitCountAlive); i > 0; i -= 1) {
        observer = UnitGroupUnitFromEnd(observers,i);
        if (observer == null || !StringContains(UnitGetType(observer),"Observer",c_stringAnywhere,c_stringNoCase)) { continue; }
        enemies = UnitGroupAlliance(player,c_unitAllianceEnemy,RegionCircle(UnitGetPosition(observer),8.0),UnitFilter(0,0,(1 << c_targetFilterMissile),(1 << (c_targetFilterDead - 32))),0);
        for (j = UnitGroupCount(enemies,c_unitCountAlive); j > 0; j -= 1) {
            target = UnitGroupUnitFromEnd(enemies,j);
            if (target == null || UnitGroupHasUnit(damaged,target)) { continue; }
            if (!libNtve_gf_UnitIsVisibleToPlayer(target, player)) { continue; }
            APRG_DealDirectDamage(target,10.0);
            UnitGroupAdd(damaged,target);
        }
    }
}

bool APRG_ProductionBoonUnitEligible(unit produced, int player) {
    string unitType;
    fixed cost;
    fixed supply;
    if (produced == null || UnitGetOwner(produced) != player || !UnitIsAlive(produced)) { return false; }
    unitType = UnitGetType(produced);
    if (unitType == "" || !CatalogEntryIsValid(c_gameCatalogUnit, unitType)) { return false; }
    if (UnitTypeTestAttribute(unitType, c_unitAttributeStructure) || APRG_IsWorkerTypeForDeath(unitType)) { return false; }
    if (UnitGroupHasUnit(APRG_PlayerWorkers(player), produced)) { return false; }
    if (APRG_HordeProductionIntermediateType(unitType)) { return false; }
    cost = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "CostResource[0]", player)) +
        StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "CostResource[1]", player));
    supply = UnitTypeGetProperty(unitType, c_unitPropSuppliesUsed);
    return cost > 0.0 || supply > 0.0;
}

unit APRG_CloneAttackTarget(unit clone, int player) {
    unitgroup candidates;
    int i;
    unit candidate;
    unit best = null;
    fixed distance;
    fixed bestDistance = 999999.0;
    point clonePoint;
    bool groundClone;
    if (clone == null || !UnitIsAlive(clone)) { return null; }
    clonePoint = UnitGetPosition(clone);
    groundClone = UnitTestPlane(clone, c_planeGround);

    candidates = APRG_EnemyTargetableStructures(player);
    for (i = UnitGroupCount(candidates, c_unitCountAlive); i > 0; i -= 1) {
        candidate = UnitGroupUnitFromEnd(candidates, i);
        if (candidate == null || !UnitIsAlive(candidate)) { continue; }
        if (groundClone && !UnitPathableToPoint(clone, UnitGetPosition(candidate), 3.0, 100000.0)) { continue; }
        distance = DistanceBetweenPoints(clonePoint, UnitGetPosition(candidate));
        if (best == null || distance < bestDistance) { best = candidate; bestDistance = distance; }
    }
    if (best != null) { return best; }

    candidates = APRG_EnemyMobileUnits(player);
    for (i = UnitGroupCount(candidates, c_unitCountAlive); i > 0; i -= 1) {
        candidate = UnitGroupUnitFromEnd(candidates, i);
        if (candidate == null || !UnitIsAlive(candidate)) { continue; }
        if (groundClone && !UnitPathableToPoint(clone, UnitGetPosition(candidate), 3.0, 100000.0)) { continue; }
        distance = DistanceBetweenPoints(clonePoint, UnitGetPosition(candidate));
        if (best == null || distance < bestDistance) { best = candidate; bestDistance = distance; }
    }
    return best;
}

void APRG_OrderCloneTowardValidTarget(unit clone, int player) {
    unit target;
    if (clone == null || !UnitIsAlive(clone)) { return; }
    target = APRG_CloneAttackTarget(clone, player);
    if (target == null) { return; }
    APRG_OrderAttackMove(clone, UnitGetPosition(target));
}

void APRG_TryCloneProducedUnit(unit produced, int player) {
    unitgroup created;
    unit clone;
    string key;
    string unitType;
    point p;
    if (!APRG_HasExtension2(APRG_EXT2_BOON_CLONING_TECHNOLOGY) || !APRG_ProductionBoonUnitEligible(produced, player)) { return; }
    key = "APRG_CloningHandled_" + IntToString(UnitGetTag(produced));
    if (DataTableGetBool(true, key)) { return; }
    DataTableSetBool(true, key, true);
    unitType = UnitGetType(produced);
    p = UnitGetPosition(produced);
    created = APRG_CreatePlayerUnitsAtPoint(1, unitType, player, p, UnitGetFacing(produced));
    clone = UnitGroupUnitFromEnd(created, 1);
    if (clone == null) { return; }
    UnitSetState(clone, c_unitStateUsingSupply, false);
    APRG_MakeGroupUncommandable(created);
    UnitGroupAdd(g_aprgClonedUnits, clone);
    APRG_OrderCloneTowardValidTarget(clone, player);
}

void APRG_TryGoliathsOnlineProducedUnit(unit produced, int player) {
    unitgroup created;
    unit extra;
    string key;
    string unitType;
    if (!APRG_HasExtension4(APRG_EXT4_BOON_GOLIATHS_ONLINE) || produced == null || UnitGetOwner(produced) != player || !UnitIsAlive(produced)) { return; }
    unitType = UnitGetType(produced);
    if (!APRG_IsGoliathFamilyType(unitType) || UnitTypeTestAttribute(unitType, c_unitAttributeStructure)) { return; }
    key = "APRG_GoliathsOnlineHandled_" + IntToString(UnitGetTag(produced));
    if (DataTableGetBool(true, key)) { return; }
    DataTableSetBool(true, key, true);
    created = APRG_CreatePlayerUnitsSafe(1, unitType, player, UnitGetPosition(produced), UnitGetFacing(produced));
    extra = UnitGroupUnitFromEnd(created, 1);
    if (extra != null) { UnitSetState(extra, c_unitStateUsingSupply, false); }
}

void APRG_TryMeatGrinderProducedUnit(unit produced, int player) {
    unitgroup created;
    unit extra;
    string key;
    string unitType;
    point p;
    int i;
    if (!APRG_HasExtension4(APRG_EXT4_BOON_MEAT_GRINDER) || !APRG_ProductionBoonUnitEligible(produced, player)) { return; }
    unitType = UnitGetType(produced);
    if (!APRG_IsMarineBoonType(unitType)) { return; }
    key = "APRG_MeatGrinderHandled_" + IntToString(UnitGetTag(produced));
    if (DataTableGetBool(true, key)) { return; }
    DataTableSetBool(true, key, true);
    p = UnitGetPosition(produced);
    created = APRG_CreatePlayerUnitsAtPoint(5, unitType, player, p, UnitGetFacing(produced));
    if (created == null) { return; }
    APRG_MakeGroupUncommandable(created);
    for (i = UnitGroupCount(created, c_unitCountAlive); i > 0; i -= 1) {
        extra = UnitGroupUnitFromEnd(created, i);
        if (extra != null) {
            UnitSetState(extra, c_unitStateUsingSupply, false);
            UnitGroupAdd(g_aprgClonedUnits, extra);
            DataTableSetBool(true, "APRG_MeatGrinderHandled_" + IntToString(UnitGetTag(extra)), true);
        }
    }
    APRG_OrderGroupTowardNearestEnemyStructure(created, p, player);
}

void APRG_ApplyTrainedUnitShieldBoon(unit produced, int player) {
    string key;
    fixed maximum;
    fixed current;
    if (!APRG_HasExtension2(APRG_EXT2_BOON_SHIELDS_FOR_ALL) || !APRG_ProductionBoonUnitEligible(produced, player)) { return; }
    key = "APRG_BoonShield_" + IntToString(UnitGetTag(produced));
    if (DataTableGetBool(true, key)) { return; }
    maximum = UnitGetPropertyFixed(produced, c_unitPropShieldsMax, c_unitPropCurrent);
    current = UnitGetPropertyFixed(produced, c_unitPropShields, c_unitPropCurrent);
    UnitSetPropertyFixed(produced, c_unitPropShieldsMax, maximum + 50.0);
    UnitSetPropertyFixed(produced, c_unitPropShields, current + 50.0);
    APRG_EnsureNormalShieldRegeneration(produced);
    DataTableSetBool(true, key, true);
}

void APRG_TryProductionBoons(unit produced, int player) {
    if (APRG_HasBlessing(APRG_BLESS_ELITE_SOLDIERS) && APRG_ProductionBoonUnitEligible(produced, player)) {
        DataTableSetBool(true, "APRG_EliteTrained_" + IntToString(UnitGetTag(produced)), true);
    }
    APRG_ApplyTrainedUnitShieldBoon(produced, player);
    if (APRG_HasExtension3(APRG_EXT3_BOON_GARGANTUAN_UNITS)) {
        APRG_ApplyGargantuanToTrainedUnit(produced, player);
    }
    APRG_TryCloneProducedUnit(produced, player);
    APRG_TryGoliathsOnlineProducedUnit(produced, player);
    APRG_TryMeatGrinderProducedUnit(produced, player);
}

bool APRG_Cloning_Func(bool testConds, bool runActions) {
    unit trained;
    int player;
    if (!runActions || !g_aprgStarted) { return true; }
    player = APRG_GetPrimaryPlayer();
    if (EventPlayer() != player) { return true; }
    trained = EventUnitProgressUnit();
    APRG_TryProductionBoons(trained, player);
    return true;
}

bool APRG_ProductionCreated_Func(bool testConds, bool runActions) {
    int player;
    unit creator;
    unit created;
    string createdType;
    string abilityType;
    bool structureSource = false;
    bool mercenarySource = false;
    if (!runActions || !g_aprgStarted) { return true; }
    if (
        !APRG_HasExtension2(APRG_EXT2_BOON_CLONING_TECHNOLOGY) &&
        !APRG_HasExtension2(APRG_EXT2_BOON_SHIELDS_FOR_ALL) &&
        !APRG_HasExtension3(APRG_EXT3_BOON_GARGANTUAN_UNITS) &&
        !APRG_HasExtension4(APRG_EXT4_BOON_GOLIATHS_ONLINE) &&
        !APRG_HasExtension4(APRG_EXT4_BOON_MEAT_GRINDER) &&
        !APRG_HasBlessing(APRG_BLESS_ELITE_SOLDIERS)
    ) { return true; }
    player = APRG_GetPrimaryPlayer();
    created = EventUnitCreatedUnit();
    creator = EventUnit();
    if (created == null || UnitGetOwner(created) != player) { return true; }
    createdType = UnitGetType(created);
    if (createdType == "" || APRG_HordeProductionIntermediateType(createdType)) { return true; }
    abilityType = EventUnitCreatedAbil();
    if (creator != null && UnitGetOwner(creator) == player && UnitTypeTestAttribute(UnitGetType(creator), c_unitAttributeStructure)) {
        structureSource = abilityType == "" || APRG_HordeAbilityInfoProducesUnit(player, abilityType, createdType);
        if (!structureSource && !CatalogEntryIsValid(c_gameCatalogAbil, abilityType)) { structureSource = true; }
    }
    mercenarySource = APRG_IsMercenaryRecruitAbility(abilityType, player);
    if (!structureSource && !mercenarySource) { return true; }
    APRG_TryProductionBoons(created, player);
    return true;
}

void APRG_RetargetClonedUnits(int player, fixed now) {
    int i;
    unit clone;
    if (now < g_aprgNextCloneRetargetTime) { return; }
    g_aprgNextCloneRetargetTime = now + 10.0;
    for (i = UnitGroupCount(g_aprgClonedUnits, c_unitCountAlive); i > 0; i -= 1) {
        clone = UnitGroupUnitFromEnd(g_aprgClonedUnits, i);
        if (clone == null || !UnitIsAlive(clone)) { continue; }
        APRG_OrderCloneTowardValidTarget(clone, player);
    }
}

bool APRG_ArchonCannons_Func(bool testConds, bool runActions) {
    unit victim;
    unit source;
    unit mini;
    unitgroup created;
    int player;
    int owner;
    string sourceType;
    string key;
    point p;
    fixed maximum;
    fixed current;
    fixed ratio;
    if (!runActions || !g_aprgStarted || !APRG_HasExtension3(APRG_EXT3_BOON_ARCHON_CANNONS)) { return true; }
    victim = EventUnit();
    source = EventUnitDamageSourceUnit();
    if (victim == null || source == null || victim == source) { return true; }
    player = APRG_GetPrimaryPlayer();
    if (UnitGetOwner(source) != player) { return true; }
    sourceType = UnitGetType(source);
    if (
        !StringContains(sourceType, "PhotonCannon", c_stringAnywhere, c_stringNoCase) &&
        !StringContains(sourceType, "Dragoon", c_stringAnywhere, c_stringNoCase)
    ) { return true; }
    owner = UnitGetOwner(victim);
    if (owner < 0 || !libNtve_gf_PlayerIsEnemy(owner, player, libNtve_ge_PlayerRelation_Enemy)) { return true; }
    if (UnitGroupCount(g_aprgArchonCannonArchons, c_unitCountAlive) >= 128) { return true; }
    if (!CatalogEntryIsValid(c_gameCatalogUnit, "Archon")) { return true; }

    p = UnitGetPosition(victim);
    created = APRG_CreatePlayerUnitsSafe(1, "Archon", player, p, UnitGetFacing(source));
    mini = UnitGroupUnitFromEnd(created, 1);
    if (mini == null) { return true; }

    UnitSetScale(mini, 50.0, 50.0, 50.0);
    maximum = UnitGetPropertyFixed(mini, c_unitPropLifeMax, c_unitPropCurrent);
    current = UnitGetPropertyFixed(mini, c_unitPropLife, c_unitPropCurrent);
    if (maximum > 0.0) {
        ratio = current / maximum;
        UnitSetPropertyFixed(mini, c_unitPropLifeMax, maximum * 0.25);
        UnitSetPropertyFixed(mini, c_unitPropLife, maximum * 0.25 * ratio);
    }
    maximum = UnitGetPropertyFixed(mini, c_unitPropShieldsMax, c_unitPropCurrent);
    current = UnitGetPropertyFixed(mini, c_unitPropShields, c_unitPropCurrent);
    if (maximum > 0.0) {
        ratio = current / maximum;
        UnitSetPropertyFixed(mini, c_unitPropShieldsMax, maximum * 0.25);
        UnitSetPropertyFixed(mini, c_unitPropShields, maximum * 0.25 * ratio);
    }
    if (CatalogEntryIsValid(c_gameCatalogBehavior, "APRogueMiniArchonDamage")) {
        UnitBehaviorAdd(mini, "APRogueMiniArchonDamage", mini, 1);
    }
    UnitSetState(mini, c_unitStateUsingSupply, false);
    UnitSetState(mini, c_unitStateSelectable, true);
    AISetUnitScriptControlled(mini, false);
    UnitGroupAdd(g_aprgArchonCannonArchons, mini);

    key = "APRG_ArchonCannonExpire_" + IntToString(UnitGetTag(mini));
    DataTableSetFixed(true, key, GameGetMissionTime() + 10.0);
    if (CatalogEntryIsValid(c_gameCatalogBehavior, "AutoTurretTimedLife")) {
        UnitBehaviorAdd(mini, "AutoTurretTimedLife", mini, 1);
        UnitBehaviorSetDuration(mini, "AutoTurretTimedLife", 10.0);
        UnitBehaviorSetDurationRemaining(mini, "AutoTurretTimedLife", 10.0);
    }
    UnitIssueOrder(mini, OrderTargetingUnit(AbilityCommand("attack", 0), victim), c_orderQueueReplace);
    return true;
}

void APRG_TickArchonCannons(fixed now) {
    int i;
    unit mini;
    string key;
    fixed expires;
    if (g_aprgArchonCannonArchons == null) { return; }
    for (i = UnitGroupCount(g_aprgArchonCannonArchons, c_unitCountAll); i > 0; i -= 1) {
        mini = UnitGroupUnitFromEnd(g_aprgArchonCannonArchons, i);
        if (mini == null) { continue; }
        key = "APRG_ArchonCannonExpire_" + IntToString(UnitGetTag(mini));
        if (!UnitIsAlive(mini)) {
            UnitGroupRemove(g_aprgArchonCannonArchons, mini);
            continue;
        }
        expires = DataTableGetFixed(true, key);
        if (expires > 0.0 && expires <= now) {
            UnitGroupRemove(g_aprgArchonCannonArchons, mini);
            UnitRemove(mini);
        }
    }
}


bool APRG_HydraStorms_Func(bool testConds, bool runActions) {
    unit victim;
    unit source;
    int player;
    int owner;
    string sourceType;
    point impactPoint;
    if (!runActions || !g_aprgStarted || !APRG_HasExtension3(APRG_EXT3_BOON_HYRDA_STORMS)) { return true; }
    victim = EventUnit();
    source = EventUnitDamageSourceUnit();
    if (victim == null || source == null || victim == source) { return true; }
    player = APRG_GetPrimaryPlayer();
    if (UnitGetOwner(source) != player) { return true; }
    sourceType = UnitGetType(source);
    if (
        !StringContains(sourceType, "Hydralisk", c_stringAnywhere, c_stringNoCase) &&
        !StringContains(sourceType, "HunterKiller", c_stringAnywhere, c_stringNoCase)
    ) { return true; }
    owner = UnitGetOwner(victim);
    if (owner < 0 || !libNtve_gf_PlayerIsEnemy(owner, player, libNtve_ge_PlayerRelation_Enemy)) { return true; }
    if (!CatalogEntryIsValid(c_gameCatalogEffect, "PsiStormPersistent")) { return true; }
    impactPoint = UnitGetPosition(victim);
    PlayerCreateEffectPoint(player, "PsiStormPersistent", impactPoint);
    return true;
}

bool APRG_CorrosiveClaws_Func(bool testConds, bool runActions) {
    unit victim;
    unit source;
    int player;
    int owner;
    int corrosiveStacks;
    string sourceType;
    if (!runActions || !g_aprgStarted || !APRG_HasExtension3(APRG_EXT3_BOON_CORROSIVE_CLAWS)) { return true; }
    victim = EventUnit();
    source = EventUnitDamageSourceUnit();
    if (victim == null || source == null || victim == source || !UnitIsAlive(victim)) { return true; }
    player = APRG_GetPrimaryPlayer();
    if (UnitGetOwner(source) != player) { return true; }
    sourceType = UnitGetType(source);
    if (!StringContains(sourceType, "Zergling", c_stringAnywhere, c_stringNoCase)) { return true; }
    owner = UnitGetOwner(victim);
    if (owner < 0 || !libNtve_gf_PlayerIsEnemy(owner, player, libNtve_ge_PlayerRelation_Enemy)) { return true; }
    corrosiveStacks = UnitBehaviorCount(victim, "APRogueCorrosiveClaws");
    if (corrosiveStacks < 0) { corrosiveStacks = 0; }
    UnitBehaviorRemove(victim, "APRogueCorrosiveClaws", c_unitBehaviorCountAll);
    UnitBehaviorAdd(victim, "APRogueCorrosiveClaws", source, corrosiveStacks + 1);
    return true;
}

bool APRG_EnhancedControl_Func(bool testConds, bool runActions) {
    unit u;
    int player;
    int oldOwner;
    fixed maximum;
    fixed current;
    fixed ratio;
    string key;
    if (!runActions || !g_aprgStarted || !APRG_HasBlessing(APRG_BOON_ENHANCED_CONTROL)) { return true; }
    u = EventUnit();
    if (u == null || !UnitIsAlive(u)) { return true; }
    player = APRG_GetPrimaryPlayer();
    oldOwner = EventUnitOwnerOld();
    if (UnitGetOwner(u) != player || oldOwner < 0 || !libNtve_gf_PlayerIsEnemy(oldOwner, player, libNtve_ge_PlayerRelation_Enemy)) { return true; }
    key = "APRG_EnhancedControl_" + IntToString(UnitGetTag(u));
    if (DataTableGetBool(true, key)) { return true; }
    maximum = UnitGetPropertyFixed(u, c_unitPropLifeMax, c_unitPropCurrent);
    current = UnitGetPropertyFixed(u, c_unitPropLife, c_unitPropCurrent);
    if (maximum > 0.0) {
        ratio = current / maximum;
        UnitSetPropertyFixed(u, c_unitPropLifeMax, maximum * 3.0);
        UnitSetPropertyFixed(u, c_unitPropLife, maximum * 3.0 * ratio);
    }
    APRG_ScaleUnitShields(u, 3.0);
    UnitBehaviorAdd(u, "APRogueEnhancedControl", u, 1);
    DataTableSetBool(true, key, true);
    return true;
}

void APRG_HalveBansheeDamageForType(unit u, int player) {
    int wi;
    int wc;
    string weapon;
    string effect;
    string key;
    if (u == null) { return; }
    wc = UnitWeaponCount(u);
    for (wi = 1; wi <= wc; wi += 1) {
        weapon = UnitWeaponGet(u, wi);
        if (weapon == "") { continue; }
        effect = CatalogFieldValueGet(c_gameCatalogWeapon, weapon, "DisplayEffect", player);
        if (effect == "" || !CatalogEntryIsValid(c_gameCatalogEffect, effect)) { continue; }
        key = "APRG_MiniBansheeDamage_" + IntToString(player) + "_" + effect;
        if (!DataTableGetBool(true, key)) {
            CatalogFieldValueModify(c_gameCatalogEffect, effect, "Amount", player, "0.5", c_upgradeOperationMultiply);
            DataTableSetBool(true, key, true);
        }
    }
}

bool APRG_BansheeSwarm_Func(bool testConds, bool runActions) {
    unit trained;
    unit mini;
    unitgroup created;
    int player;
    int i;
    string unitType;
    fixed maximum;
    fixed current;
    fixed ratio;
    point p;
    fixed facing;
    if (!runActions || !g_aprgStarted || !APRG_HasBlessing(APRG_BOON_BANSHEE_SWARM)) { return true; }
    player = APRG_GetPrimaryPlayer();
    if (EventPlayer() != player) { return true; }
    trained = EventUnitProgressUnit();
    if (trained == null || !UnitIsAlive(trained)) { return true; }
    unitType = UnitGetType(trained);
    if (!StringContains(unitType, "Banshee", c_stringAnywhere, c_stringNoCase)) { return true; }
    if (DataTableGetBool(true, "APRG_MiniBanshee_" + IntToString(UnitGetTag(trained)))) { return true; }
    p = UnitGetPosition(trained);
    facing = UnitGetFacing(trained);
    APRG_HalveBansheeDamageForType(trained, player);
    UnitRemove(trained);
    created = APRG_CreatePlayerUnitsSafe(6, unitType, player, p, facing);
    for (i = UnitGroupCount(created, c_unitCountAlive); i > 0; i -= 1) {
        mini = UnitGroupUnitFromEnd(created, i);
        if (mini == null) { continue; }
        DataTableSetBool(true, "APRG_MiniBanshee_" + IntToString(UnitGetTag(mini)), true);
        UnitSetScale(mini, 50.0, 50.0, 50.0);
        maximum = UnitGetPropertyFixed(mini, c_unitPropLifeMax, c_unitPropCurrent);
        current = UnitGetPropertyFixed(mini, c_unitPropLife, c_unitPropCurrent);
        if (maximum > 0.0) {
            ratio = current / maximum;
            UnitSetPropertyFixed(mini, c_unitPropLifeMax, maximum * 0.5);
            UnitSetPropertyFixed(mini, c_unitPropLife, maximum * 0.5 * ratio);
        }
        if (i > 1) { UnitSetState(mini, c_unitStateUsingSupply, false); }
    }
    return true;
}

void APRG_MultiplyBanelingRadiusEffect(int player, string effect) {
    string key;
    if (effect == "" || !CatalogEntryIsValid(c_gameCatalogEffect, effect)) { return; }
    key = "APRG_BanelingRadius_" + IntToString(player) + "_" + effect;
    if (DataTableGetBool(true, key)) { return; }
    CatalogFieldValueModify(c_gameCatalogEffect, effect, "AreaArray[0].Radius", player, "3.0", c_upgradeOperationMultiply);
    DataTableSetBool(true, key, true);
}

void APRG_ApplyEnlargedBanelingCatalog(int player) {
    string key = "APRG_EnlargedBanelingCatalog_" + IntToString(player);
    if (DataTableGetBool(true, key)) { return; }

    APRG_MultiplyBanelingRadiusEffect(player, "AP_HotSBanelingExplodeLargeSearch");
    APRG_MultiplyBanelingRadiusEffect(player, "AP_HotSBanelingExplodeLargeSearchAll");
    APRG_MultiplyBanelingRadiusEffect(player, "AP_HotSBanelingExplodeLargeHealSearch");
    APRG_MultiplyBanelingRadiusEffect(player, "AP_HotSBanelingExplodeLargeHealSearchAll");
    APRG_MultiplyBanelingRadiusEffect(player, "AP_HotSBanelingExplodeSmallSearch");
    APRG_MultiplyBanelingRadiusEffect(player, "AP_HotSBanelingExplodeSmallSearchAll");
    APRG_MultiplyBanelingRadiusEffect(player, "AP_HotSBanelingExplodeSmallHealSearch");
    APRG_MultiplyBanelingRadiusEffect(player, "AP_HotSBanelingExplodeSmallHealSearchAll");
    APRG_MultiplyBanelingRadiusEffect(player, "AP_SIVolatileInfestedExplodeDamage");
    APRG_MultiplyBanelingRadiusEffect(player, "AP_SIVolatileInfestedExplodeDamageStructure");
    APRG_MultiplyBanelingRadiusEffect(player, "AP_BanelingLaunchExplodeSearch");
    APRG_MultiplyBanelingRadiusEffect(player, "AP_BanelingLargeHealSearchAll");

    DataTableSetBool(true, key, true);
}

void APRG_ApplyEnlargedBanelings(int player) {
    unitgroup units;
    unit u;
    int i;
    string unitType;
    string key;

    APRG_ApplyEnlargedBanelingCatalog(player);
    units = APRG_PlayerMobileUnits(player);
    for (i = UnitGroupCount(units, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null) { continue; }
        unitType = UnitGetType(u);
        if (!StringContains(unitType, "Baneling", c_stringAnywhere, c_stringNoCase)) { continue; }
        key = "APRG_EnlargedBanelingScale_" + IntToString(UnitGetTag(u));
        if (!DataTableGetBool(true, key)) {
            UnitSetScale(u, 150.0, 150.0, 150.0);
            DataTableSetBool(true, key, true);
        }
    }
}

bool APRG_IsMobileSiegeType(string unitType) {
    return StringContains(unitType, "SiegeTank", c_stringAnywhere, c_stringNoCase)
        || StringContains(unitType, "SiegeBreaker", c_stringAnywhere, c_stringNoCase);
}

void APRG_EnableMobileSiegeType(int player, string unitType) {
    string key;
    string donorType;
    string mover;
    string speed;
    if (!CatalogEntryIsValid(c_gameCatalogUnit, unitType)) { return; }
    if (!StringContains(unitType, "Sieged", c_stringAnywhere, c_stringNoCase)) { return; }
    key = "APRG_MobileSiegeType_" + IntToString(player) + "_" + unitType;
    if (DataTableGetBool(true, key)) { return; }
    donorType = "SiegeTank";
    if (StringContains(unitType, "SiegeBreaker", c_stringAnywhere, c_stringNoCase) && CatalogEntryIsValid(c_gameCatalogUnit, "SiegeBreaker")) {
        donorType = "SiegeBreaker";
    }
    if (!CatalogEntryIsValid(c_gameCatalogUnit, donorType)) { return; }
    mover = CatalogFieldValueGet(c_gameCatalogUnit, donorType, "Mover", player);
    speed = CatalogFieldValueGet(c_gameCatalogUnit, donorType, "Speed", player);
    if (mover != "") { CatalogFieldValueSet(c_gameCatalogUnit, unitType, "Mover", player, mover); }
    if (speed != "") { CatalogFieldValueSet(c_gameCatalogUnit, unitType, "Speed", player, speed); }
    APRG_AddCommandCardButton(player, unitType, "Move", "move,Move", 0, 0);
    APRG_AddCommandCardButton(player, unitType, "Stop", "stop,Stop", 0, 1);
    DataTableSetBool(true, key, true);
}

void APRG_ApplyMobileSiege(int player) {
    unitgroup units;
    int i;
    unit u;
    string unitType;
    units = APRG_PlayerAllUnits(player);
    i = UnitGroupCount(units, c_unitCountAlive);
    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null) { break; }
        unitType = UnitGetType(u);
        if (!APRG_IsMobileSiegeType(unitType) || !StringContains(unitType, "Sieged", c_stringAnywhere, c_stringNoCase)) { continue; }
        APRG_EnableMobileSiegeType(player, unitType);
        if (!UnitAbilityExists(u, "move")) { UnitAbilityAdd(u, "move"); }
        if (!UnitAbilityExists(u, "stop")) { UnitAbilityAdd(u, "stop"); }
        UnitAbilityShow(u, "move", true);
        UnitAbilityEnable(u, "move", true);
        UnitAbilityShow(u, "stop", true);
        UnitAbilityEnable(u, "stop", true);
    }
}

bool APRG_IsVikingAnchorType(string unitType) {
    return StringContains(unitType, "Viking", c_stringAnywhere, c_stringNoCase)
        || StringContains(unitType, "HelsAngel", c_stringAnywhere, c_stringNoCase)
        || StringContains(unitType, "HelAngel", c_stringAnywhere, c_stringNoCase)
        || StringContains(unitType, "Brynhild", c_stringAnywhere, c_stringNoCase);
}

void APRG_ApplyVikingAnchors(int player) {
    unitgroup units = APRG_PlayerMobileUnits(player);
    int i = UnitGroupCount(units, c_unitCountAlive);
    unit u;
    for (; i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null) { break; }
        if (!APRG_IsVikingAnchorType(UnitGetType(u))) { continue; }
        if (UnitTestPlane(u, c_planeGround)) {
            UnitBehaviorAdd(u, "APRogueVikingAnchors", u, 1);
        }
        else {
            UnitBehaviorRemove(u, "APRogueVikingAnchors", c_unitBehaviorCountAll);
        }
    }
}

string APRG_TerranMercenaryStructureType() {
    if (CatalogEntryIsValid(c_gameCatalogUnit, "AP_MercCompound")) { return "AP_MercCompound"; }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "MercCompound")) { return "MercCompound"; }
    return "";
}

string APRG_ZergMercenaryStructureType() {
    if (CatalogEntryIsValid(c_gameCatalogUnit, "AP_PredatorNest")) { return "AP_PredatorNest"; }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "AP_ZergPredatorNest")) { return "AP_ZergPredatorNest"; }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "AP_ZergMercenaryCompound")) { return "AP_ZergMercenaryCompound"; }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "PredatorNest")) { return "PredatorNest"; }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "ZergPredatorNest")) { return "ZergPredatorNest"; }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "ZergMercenaryCompound")) { return "ZergMercenaryCompound"; }
    return "";
}

unit APRG_FindOwnedUnitOfType(int player, string unitType) {
    unitgroup units;
    unit u;
    if (unitType == "" || !CatalogEntryIsValid(c_gameCatalogUnit, unitType)) { return null; }
    units = UnitGroup(unitType, player, RegionPlayableMap(), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0);
    u = UnitGroupUnitFromEnd(units, 1);
    return u;
}

bool APRG_IsTerranContractStructureType(string unitType) {
    if (unitType == "") { return false; }
    return StringContains(unitType, "MercCompound", c_stringAnywhere, c_stringNoCase)
        || StringContains(unitType, "MercenaryCompound", c_stringAnywhere, c_stringNoCase);
}

bool APRG_IsZergContractStructureType(string unitType) {
    if (unitType == "") { return false; }
    return StringContains(unitType, "PredatorNest", c_stringAnywhere, c_stringNoCase)
        || StringContains(unitType, "ZergMercenaryCompound", c_stringAnywhere, c_stringNoCase);
}

unit APRG_FindExistingContractStructure(int player, bool terran) {
    unitgroup units;
    int i;
    unit u;
    string unitType;
    units = APRG_PlayerAllUnits(player);
    for (i = UnitGroupCount(units, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null || !UnitIsAlive(u)) { continue; }
        unitType = UnitGetType(u);
        if (terran && APRG_IsTerranContractStructureType(unitType)) { return u; }
        if (!terran && APRG_IsZergContractStructureType(unitType)) { return u; }
    }
    return null;
}

bool APRG_ContractProducedUnitAllowed(int player, string unitType) {
    string apType;
    string rawType;
    if (unitType == "") { return true; }

    if (TechTreeUnitIsAllowed(player, unitType)) { return true; }
    if (StringFind(unitType, "AP_", c_stringCase) == 1) {
        rawType = StringSub(unitType, 4, StringLength(unitType));
        if (
            rawType != "" && CatalogEntryIsValid(c_gameCatalogUnit, rawType) &&
            TechTreeUnitIsAllowed(player, rawType)
        ) { return true; }
        return false;
    }
    apType = "AP_" + unitType;
    if (
        CatalogEntryIsValid(c_gameCatalogUnit, apType) &&
        TechTreeUnitIsAllowed(player, apType)
    ) { return true; }
    return false;
}

void APRG_FilterContractStructureCommandCard(int player, string unitType) {
    int cardCount;
    int cardIndex;
    int buttonCount;
    int buttonIndex;
    int commandIndex;
    string buttonPath;
    string abilCmdText;
    string abilityType;
    string trainedUnitType;
    abilcmd command;

    if (unitType == "" || !CatalogEntryIsValid(c_gameCatalogUnit, unitType)) { return; }
    cardCount = CatalogFieldValueCount(c_gameCatalogUnit, unitType, "CardLayouts", player);
    if (cardCount > 8) { cardCount = 8; }
    for (cardIndex = 0; cardIndex < cardCount; cardIndex += 1) {
        buttonPath = "CardLayouts[" + IntToString(cardIndex) + "].LayoutButtons";
        buttonCount = CatalogFieldValueCount(c_gameCatalogUnit, unitType, buttonPath, player);
        if (buttonCount > 64) { buttonCount = 64; }
        for (buttonIndex = 0; buttonIndex < buttonCount; buttonIndex += 1) {
            abilCmdText = CatalogFieldValueGet(
                c_gameCatalogUnit, unitType,
                buttonPath + "[" + IntToString(buttonIndex) + "].AbilCmd",
                player
            );
            if (abilCmdText == "") { continue; }
            command = StringToAbilCmd(abilCmdText);
            abilityType = AbilityCommandGetAbility(command);
            commandIndex = AbilityCommandGetCommand(command);
            if (
                abilityType == "" ||
                commandIndex < 0 ||
                !CatalogEntryIsValid(c_gameCatalogAbil, abilityType)
            ) { continue; }

            if (!APRG_MercenaryCommandProducesUnit(abilityType, commandIndex, player)) { continue; }

            trainedUnitType = CatalogFieldValueGet(
                c_gameCatalogAbil, abilityType,
                "InfoArray[" + IntToString(commandIndex) + "].Unit",
                player
            );
            if (trainedUnitType == "" || APRG_ContractProducedUnitAllowed(player, trainedUnitType)) { continue; }

            CatalogFieldValueSet(
                c_gameCatalogUnit, unitType,
                buttonPath + "[" + IntToString(buttonIndex) + "].AbilCmd",
                player, ""
            );
            CatalogFieldValueSet(
                c_gameCatalogUnit, unitType,
                buttonPath + "[" + IntToString(buttonIndex) + "].Face",
                player, ""
            );
        }
    }
}

unit APRG_TransformContractStructureToAP(int player, unit source, bool terran) {
    string targetType;
    unit replacement;
    if (source == null || !UnitIsAlive(source)) { return source; }
    targetType = APRG_TerranMercenaryStructureType();
    if (!terran) { targetType = APRG_ZergMercenaryStructureType(); }
    if (targetType == "" || UnitGetType(source) == targetType) {
        APRG_FilterContractStructureCommandCard(player, UnitGetType(source));
        return source;
    }
    if (!CatalogEntryIsValid(c_gameCatalogUnit, targetType)) {
        APRG_FilterContractStructureCommandCard(player, UnitGetType(source));
        return source;
    }

    libNtve_gf_ReplaceUnit(source, targetType, libNtve_ge_ReplaceUnitOptions_OldUnitsRelative);
    replacement = libNtve_gf_LastReplacedUnit();
    if (replacement != null && UnitIsAlive(replacement)) {
        APRG_FilterContractStructureCommandCard(player, UnitGetType(replacement));
        return replacement;
    }
    APRG_FilterContractStructureCommandCard(player, UnitGetType(source));
    return source;
}

bool APRG_IsContractProductionAnchorType(string unitType) {
    if (unitType == "") { return false; }
    if (APRG_IsTownHallType(unitType)) { return true; }
    return StringContains(unitType, "Barracks", c_stringAnywhere, c_stringNoCase)
        || StringContains(unitType, "Factory", c_stringAnywhere, c_stringNoCase)
        || StringContains(unitType, "Starport", c_stringAnywhere, c_stringNoCase)
        || StringContains(unitType, "Gateway", c_stringAnywhere, c_stringNoCase)
        || StringContains(unitType, "WarpGate", c_stringAnywhere, c_stringNoCase)
        || StringContains(unitType, "Robotics", c_stringAnywhere, c_stringNoCase)
        || StringContains(unitType, "Stargate", c_stringAnywhere, c_stringNoCase)
        || StringContains(unitType, "Hatchery", c_stringAnywhere, c_stringNoCase)
        || StringContains(unitType, "Lair", c_stringAnywhere, c_stringNoCase)
        || StringContains(unitType, "Hive", c_stringAnywhere, c_stringNoCase);
}

unit APRG_FindContractSpawnAnchor(int player) {
    unitgroup structures;
    int i;
    unit candidate;
    unit home;
    string unitType;
    structures = APRG_PlayerStructures(player);
    home = APRG_FindPlayerHomeStructure(player);

    for (i = UnitGroupCount(structures, c_unitCountAlive); i > 0; i -= 1) {
        candidate = UnitGroupUnitFromEnd(structures, i);
        if (candidate == null || !UnitIsAlive(candidate)) { continue; }
        unitType = UnitGetType(candidate);
        if (!APRG_IsTownHallType(unitType) && APRG_IsContractProductionAnchorType(unitType)) { return candidate; }
    }
    if (home != null && UnitIsAlive(home)) { return home; }
    for (i = UnitGroupCount(structures, c_unitCountAlive); i > 0; i -= 1) {
        candidate = UnitGroupUnitFromEnd(structures, i);
        if (candidate != null && UnitIsAlive(candidate)) { return candidate; }
    }
    return null;
}

point APRG_ContractStructureSpawnPoint(int player) {
    unit anchor;
    unit home;
    unit alternate;
    unitgroup structures;
    point p;
    int i;

    home = APRG_FindPlayerHomeStructure(player);
    if (home != null && UnitIsAlive(home)) {
        p = APRG_PlayerBuildingSpawnPoint(player, UnitGetPosition(home), 4.0, 16.0);
        if (p != null) { return p; }
    }

    anchor = APRG_FindContractSpawnAnchor(player);
    if (anchor != null && UnitIsAlive(anchor) && anchor != home) {
        p = APRG_PlayerBuildingSpawnPoint(player, UnitGetPosition(anchor), 4.0, 14.0);
        if (p != null) { return p; }
    }

    structures = APRG_PlayerStructures(player);
    for (i = UnitGroupCount(structures, c_unitCountAlive); i > 0; i -= 1) {
        alternate = UnitGroupUnitFromEnd(structures, i);
        if (alternate == null || !UnitIsAlive(alternate) || alternate == anchor || alternate == home) { continue; }
        p = APRG_PlayerBuildingSpawnPoint(player, UnitGetPosition(alternate), 4.0, 14.0);
        if (p != null) { return p; }
    }
    return null;
}

unit APRG_CreateContractStructure(int player, string unitType) {
    int attempt;
    unit existing;
    point p;
    unitgroup created;
    unit result;

    if (!APRG_PlayerMacroBaseReady(player) || unitType == "") { return null; }
    if (!CatalogEntryIsValid(c_gameCatalogUnit, unitType)) { return null; }

    existing = APRG_FindOwnedUnitOfType(player, unitType);
    if (existing != null && UnitIsAlive(existing)) {
        APRG_FilterContractStructureCommandCard(player, UnitGetType(existing));
        return existing;
    }

    for (attempt = 0; attempt < 4; attempt += 1) {
        p = APRG_ContractStructureSpawnPoint(player);
        if (p == null) { continue; }

        created = UnitCreate(1, unitType, 0, player, p, libNtve_gf_RandomAngle());
        if (created == null || UnitGroupCount(created, c_unitCountAlive) <= 0) {
            created = UnitCreate(1, unitType, c_unitCreateIgnorePlacement, player, p, libNtve_gf_RandomAngle());
        }
        if (created == null || UnitGroupCount(created, c_unitCountAlive) <= 0) { continue; }

        result = UnitGroupUnitFromEnd(created, 1);
        if (result == null) { continue; }

        APRG_FilterContractStructureCommandCard(player, UnitGetType(result));
        return result;
    }
    return null;
}

unit APRG_CreateTerranContractStructure(int player) {
    unit result;
    result = APRG_CreateContractStructure(player, "MercCompound");
    if (result != null) { return APRG_TransformContractStructureToAP(player, result, true); }
    result = APRG_CreateContractStructure(player, "AP_MercCompound");
    if (result != null) { return APRG_TransformContractStructureToAP(player, result, true); }
    return null;
}

unit APRG_CreateZergContractStructure(int player) {
    unit result;
    result = APRG_CreateContractStructure(player, "PredatorNest");
    if (result != null) { return APRG_TransformContractStructureToAP(player, result, false); }
    result = APRG_CreateContractStructure(player, "ZergPredatorNest");
    if (result != null) { return APRG_TransformContractStructureToAP(player, result, false); }
    result = APRG_CreateContractStructure(player, "ZergMercenaryCompound");
    if (result != null) { return APRG_TransformContractStructureToAP(player, result, false); }
    result = APRG_CreateContractStructure(player, "AP_PredatorNest");
    if (result != null) { return APRG_TransformContractStructureToAP(player, result, false); }
    result = APRG_CreateContractStructure(player, "AP_ZergPredatorNest");
    if (result != null) { return APRG_TransformContractStructureToAP(player, result, false); }
    result = APRG_CreateContractStructure(player, "AP_ZergMercenaryCompound");
    if (result != null) { return APRG_TransformContractStructureToAP(player, result, false); }
    return null;
}


void APRG_ApplyPrimalKerriganAppearance(unit u) {
    if (u == null) { return; }
}

bool APRG_IsShopKerriganType(string unitType) {
    if (unitType == "" || !StringContains(unitType, "Kerrigan", c_stringAnywhere, c_stringNoCase)) { return false; }
    if (StringContains(unitType, "Egg", c_stringAnywhere, c_stringNoCase)) { return false; }
    if (StringContains(unitType, "Cocoon", c_stringAnywhere, c_stringNoCase)) { return false; }
    if (StringContains(unitType, "Birth", c_stringAnywhere, c_stringNoCase)) { return false; }
    return true;
}

unit APRG_FindShopKerrigan(int player) {
    unitgroup units;
    int i;
    unit u;
    units = APRG_PlayerAllUnits(player);
    for (i = UnitGroupCount(units, c_unitCountAlive); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u != null && APRG_IsShopKerriganType(UnitGetType(u))) { return u; }
    }
    return null;
}

string APRG_FallbackKerriganType() {
    if (CatalogEntryIsValid(c_gameCatalogUnit, "K5Kerrigan")) { return "K5Kerrigan"; }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "KerriganVoid")) { return "KerriganVoid"; }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "Kerrigan")) { return "Kerrigan"; }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "KerriganInfested")) { return "KerriganInfested"; }
    return "";
}

unit APRG_CreateShopKerriganAtHome(int player, string requestedType) {
    string unitType;
    unit home;
    point p;
    unitgroup created;
    unitType = requestedType;
    if (unitType == "" || !CatalogEntryIsValid(c_gameCatalogUnit, unitType)) { unitType = APRG_FallbackKerriganType(); }
    if (unitType == "") { return null; }
    unitType = APRG_PlayerSpawnCatalogTypeForPlayer(unitType, player);
    if (!CatalogEntryIsValid(c_gameCatalogUnit, unitType)) { return null; }
    home = APRG_FindPlayerHomeStructure(player);
    if (home == null || !UnitIsAlive(home)) { return null; }
    p = APRG_FindGroundPointNear(UnitGetPosition(home), 4.0, 8.0);
    if (p == null) { p = UnitGetPosition(home); }
    created = UnitCreate(1, unitType, c_unitCreateIgnorePlacement, player, p, libNtve_gf_RandomAngle());
    if (created == null || UnitGroupCount(created, c_unitCountAlive) <= 0) { return null; }
    home = UnitGroupUnitFromEnd(created, 1);
    APRG_ApplyPrimalKerriganAppearance(home);
    return home;
}

unit APRG_CreateShopKerriganAtPoint(int player, string requestedType, point p) {
    string unitType;
    unitgroup created;
    unit result;
    unitType = requestedType;
    if (p == null) { return APRG_CreateShopKerriganAtHome(player, requestedType); }
    if (unitType == "" || !CatalogEntryIsValid(c_gameCatalogUnit, unitType)) { unitType = APRG_FallbackKerriganType(); }
    unitType = APRG_PlayerSpawnCatalogTypeForPlayer(unitType, player);
    if (unitType == "" || !CatalogEntryIsValid(c_gameCatalogUnit, unitType)) { return null; }
    created = UnitCreate(1, unitType, c_unitCreateIgnorePlacement, player, p, libNtve_gf_RandomAngle());
    if (created == null || UnitGroupCount(created, c_unitCountAlive) <= 0) {
        // A mission-owned cocoon can disappear on the same frame we cache its
        // position. If direct recreation fails there, retry at the player's base
        // rather than leaving Kerrigan permanently absent.
        return APRG_CreateShopKerriganAtHome(player, requestedType);
    }
    result = UnitGroupUnitFromEnd(created, 1);
    APRG_ApplyPrimalKerriganAppearance(result);
    return result;
}

point APRG_FindKerriganCocoonPoint(int player) {
    unitgroup units;
    int i;
    unit u;
    unit kerriganCocoon = null;
    string unitType;
    units = UnitGroup(null, player, null, UnitFilter(0, 0, 0, 0), 0);
    for (i = UnitGroupCount(units, c_unitCountAll); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null || !UnitIsAlive(u)) { continue; }
        unitType = UnitGetType(u);
        if (unitType == "KerriganReviveCocoon" || unitType == "KerriganXelNagaReviveCocoon") {
            return UnitGetPosition(u);
        }
        if (
            kerriganCocoon == null &&
            StringContains(unitType, "Kerrigan", c_stringAnywhere, c_stringNoCase) &&
            StringContains(unitType, "Cocoon", c_stringAnywhere, c_stringNoCase)
        ) {
            kerriganCocoon = u;
        }
    }
    if (kerriganCocoon != null) { return UnitGetPosition(kerriganCocoon); }
    return null;
}

void APRG_RemoveKerriganReviveCocoons(int player) {
    unitgroup units;
    unit u;
    string unitType;
    int i;
    units = UnitGroup(null, player, null, UnitFilter(0, 0, 0, 0), 0);
    // Only the owning player's Kerrigan revive cocoons, not normal Zerg eggs
    // or cocoons elsewhere on the map. This runs after a successful respawn.
    for (i = UnitGroupCount(units, c_unitCountAll); i > 0; i -= 1) {
        u = UnitGroupUnitFromEnd(units, i);
        if (u == null || !UnitIsAlive(u)) { continue; }
        unitType = UnitGetType(u);
        if (unitType == "KerriganReviveCocoon" || unitType == "KerriganXelNagaReviveCocoon" ||
            (StringContains(unitType, "Kerrigan", c_stringAnywhere, c_stringNoCase) &&
             StringContains(unitType, "Cocoon", c_stringAnywhere, c_stringNoCase))) {
            UnitRemove(u);
        }
    }
}

void APRG_PositionShopKerriganAtHome(int player) {
    unit home;
    point p;
    if (g_aprgShopKerrigan == null || !UnitIsAlive(g_aprgShopKerrigan)) { return; }
    home = APRG_FindPlayerHomeStructure(player);
    if (home == null || !UnitIsAlive(home)) { return; }
    p = APRG_FindGroundPointNear(UnitGetPosition(home), 4.0, 8.0);
    if (p == null) { p = UnitGetPosition(home); }
    UnitSetPosition(g_aprgShopKerrigan, p, true);
}

int APRG_KerriganRecklessPowerStacks() {
    return g_aprgKerriganUpgradeFlags & 255;
}

int APRG_KerriganRecklessSpeedStacks() {
    return (g_aprgKerriganUpgradeFlags >> 8) & 255;
}

bool APRG_HasKerriganShopUpgrade(int flag) {
    if (flag == APRG_KERRIGAN_RECKLESS_POWER) { return APRG_KerriganRecklessPowerStacks() > 0; }
    if (flag == APRG_KERRIGAN_RECKLESS_SPEED) { return APRG_KerriganRecklessSpeedStacks() > 0; }
    return false;
}

fixed APRG_KerriganRespawnDelay() {
    return 60.0 * IntToFixed(1 + APRG_KerriganRecklessPowerStacks() + APRG_KerriganRecklessSpeedStacks());
}

void APRG_ApplyKerriganShopUpgrades(unit u) {
    string tagKey;
    fixed energyMaximum;
    int powerStacks;
    int speedStacks;
    if (u == null || !UnitIsAlive(u)) { return; }
    tagKey = IntToString(UnitGetTag(u));
    powerStacks = APRG_KerriganRecklessPowerStacks();
    speedStacks = APRG_KerriganRecklessSpeedStacks();

    if (powerStacks > 0) {
        if (UnitBehaviorCount(u, "APRogueKerriganRecklessPower") < powerStacks) {
            UnitBehaviorAdd(u, "APRogueKerriganRecklessPower", u, powerStacks - UnitBehaviorCount(u, "APRogueKerriganRecklessPower"));
        }
        if (!DataTableGetBool(true, "APRG_KerriganRecklessEnergy_" + tagKey)) {
            energyMaximum = UnitGetPropertyFixed(u, c_unitPropEnergyMax, c_unitPropCurrent);
            if (energyMaximum > 0.0) {
                UnitSetPropertyFixed(u, c_unitPropEnergyMax, energyMaximum * (1.0 + 0.5 * IntToFixed(powerStacks)));
            }
            DataTableSetBool(true, "APRG_KerriganRecklessEnergy_" + tagKey, true);
        }
    }
    if (speedStacks > 0 && UnitBehaviorCount(u, "APRogueKerriganRecklessSpeed") < speedStacks) {
        UnitBehaviorAdd(u, "APRogueKerriganRecklessSpeed", u, speedStacks - UnitBehaviorCount(u, "APRogueKerriganRecklessSpeed"));
    }
}

void APRG_TickShopKerrigan(int player, fixed now) {
    unit fresh;
    bool replacingTrackedKerrigan;
    fixed respawnDelay;
    fixed respawnElapsed;
    point respawnPoint;
    if (!APRG_HasProgression(APRG_PROGRESSION_KERRIGAN) || !APRG_PlayerMacroBaseReady(player)) { return; }
    respawnDelay = APRG_KerriganRespawnDelay();

    if (g_aprgShopKerriganDeathTime >= 0.0) {
        respawnPoint = APRG_FindKerriganCocoonPoint(player);
        if (respawnPoint != null) { g_aprgShopKerriganRespawnPoint = respawnPoint; }
        fresh = APRG_FindShopKerrigan(player);
        respawnElapsed = now - g_aprgShopKerriganDeathTime;

        if (respawnElapsed < respawnDelay) {
            if (fresh != null && UnitIsAlive(fresh)) {
                // HotS mission logic can start its native 60-second revive at the
                // actual death frame, while Slay records death on its next hero
                // tick. Accept a native replacement that arrives within two
                // seconds of Slay's intended deadline instead of deleting it.
                // A genuinely early native revive is still suppressed, which is
                // required when Reckless upgrades intentionally extend the timer.
                if (respawnElapsed >= respawnDelay - 2.0) {
                    g_aprgShopKerrigan = fresh;
                    g_aprgShopKerriganType = UnitGetType(fresh);
                    g_aprgShopKerriganDeathTime = -1.0;
                    g_aprgShopKerriganDeathPoint = null;
                    g_aprgShopKerriganRespawnPoint = null;
                    g_aprgShopKerriganPositioned = true;
                    APRG_ApplyPrimalKerriganAppearance(g_aprgShopKerrigan);
                    APRG_ApplyKerriganShopUpgrades(g_aprgShopKerrigan);
                    APRG_RemoveKerriganReviveCocoons(player);
                    UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaChat, StringToText("Kerrigan has respawned"));
                    return;
                }
                if (g_aprgShopKerriganType == "") { g_aprgShopKerriganType = UnitGetType(fresh); }
                UnitRemove(fresh);
                if (fresh == g_aprgShopKerrigan) { g_aprgShopKerrigan = null; }
            }
            return;
        }

        respawnPoint = g_aprgShopKerriganRespawnPoint;
        if (respawnPoint == null) { respawnPoint = g_aprgShopKerriganDeathPoint; }
        if (fresh != null && UnitIsAlive(fresh)) {
            g_aprgShopKerrigan = fresh;
            g_aprgShopKerriganType = UnitGetType(fresh);
        }
        else {
            if (g_aprgShopKerrigan != null) { UnitRevive(g_aprgShopKerrigan); }
            if (g_aprgShopKerrigan == null || !UnitIsAlive(g_aprgShopKerrigan)) {
                g_aprgShopKerrigan = APRG_CreateShopKerriganAtPoint(player, g_aprgShopKerriganType, respawnPoint);
            }
        }
        if (g_aprgShopKerrigan != null && UnitIsAlive(g_aprgShopKerrigan)) {
            UnitSetPropertyFixed(g_aprgShopKerrigan, c_unitPropLifePercent, 100.0);
            if (respawnPoint != null) { UnitSetPosition(g_aprgShopKerrigan, respawnPoint, true); }
            g_aprgShopKerriganDeathTime = -1.0;
            g_aprgShopKerriganDeathPoint = null;
            g_aprgShopKerriganRespawnPoint = null;
            g_aprgShopKerriganPositioned = true;
            APRG_ApplyPrimalKerriganAppearance(g_aprgShopKerrigan);
            APRG_ApplyKerriganShopUpgrades(g_aprgShopKerrigan);
            APRG_RemoveKerriganReviveCocoons(player);
            UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaChat, StringToText("Kerrigan has respawned"));
        }
        return;
    }

    fresh = APRG_FindShopKerrigan(player);
    if (fresh != null && fresh != g_aprgShopKerrigan) {
        replacingTrackedKerrigan = (g_aprgShopKerrigan != null);
        g_aprgShopKerrigan = fresh;
        g_aprgShopKerriganType = UnitGetType(fresh);
        g_aprgShopKerriganPositioned = replacingTrackedKerrigan;
        APRG_ApplyPrimalKerriganAppearance(g_aprgShopKerrigan);
        APRG_ApplyKerriganShopUpgrades(g_aprgShopKerrigan);
    }

    if (g_aprgShopKerrigan == null) {
        g_aprgShopKerrigan = APRG_CreateShopKerriganAtHome(player, g_aprgShopKerriganType);
        if (g_aprgShopKerrigan != null) {
            g_aprgShopKerriganType = UnitGetType(g_aprgShopKerrigan);
            g_aprgShopKerriganPositioned = true;
            APRG_ApplyKerriganShopUpgrades(g_aprgShopKerrigan);
        }
        return;
    }

    if (!UnitIsAlive(g_aprgShopKerrigan)) {
        g_aprgShopKerriganDeathTime = now;
        g_aprgShopKerriganDeathPoint = UnitGetPosition(g_aprgShopKerrigan);
        g_aprgShopKerriganRespawnPoint = null;
        UIDisplayMessage(
            PlayerGroupSingle(player), c_messageAreaChat,
            StringToText("[Slay] Kerrigan will respawn in " + IntToString(FixedToInt(respawnDelay)) + " seconds")
        );
        respawnPoint = APRG_FindKerriganCocoonPoint(player);
        if (respawnPoint != null) { g_aprgShopKerriganRespawnPoint = respawnPoint; }
        return;
    }

    if (!g_aprgShopKerriganPositioned) {
        APRG_PositionShopKerriganAtHome(player);
        g_aprgShopKerriganPositioned = true;
    }
    APRG_ApplyPrimalKerriganAppearance(g_aprgShopKerrigan);
    APRG_ApplyKerriganShopUpgrades(g_aprgShopKerrigan);
}

void APRG_TickContractStructures(int player) {
    fixed life;
    fixed maximum;
    unit existing;
    if (!APRG_PlayerMacroBaseReady(player)) { return; }

    if (APRG_HasProgression(APRG_PROGRESSION_TERRAN_CONTRACTS)) {
        // Resolve each contract building only once per mission. A failed initial
        // placement can be retried; a destroyed building must never be recreated.
        if (!g_aprgTerranContractStructureResolved) {
            existing = APRG_FindExistingContractStructure(player, true);
            if (existing != null) {
                g_aprgTerranContractStructure = APRG_TransformContractStructureToAP(player, existing, true);
            }
            else {
                g_aprgTerranContractStructure = APRG_CreateTerranContractStructure(player);
            }
            if (g_aprgTerranContractStructure != null) { g_aprgTerranContractStructureResolved = true; }
        }
    }

    if (g_aprgTerranContractStructure != null && UnitIsAlive(g_aprgTerranContractStructure)) {
        APRG_FilterContractStructureCommandCard(player, UnitGetType(g_aprgTerranContractStructure));
        APRG_SanitizeContractStructureTimers(g_aprgTerranContractStructure, player);
    }

    if (APRG_HasProgression(APRG_PROGRESSION_ZERG_CONTRACTS)) {
        // Predator Nest has the same permanent-on-death behavior as the compound.
        if (!g_aprgZergContractStructureResolved) {
            existing = APRG_FindExistingContractStructure(player, false);
            if (existing != null) {
                g_aprgZergContractStructure = APRG_TransformContractStructureToAP(player, existing, false);
            }
            else {
                g_aprgZergContractStructure = APRG_CreateZergContractStructure(player);
            }
            if (g_aprgZergContractStructure != null) { g_aprgZergContractStructureResolved = true; }
        }
        if (g_aprgZergContractStructure != null && UnitIsAlive(g_aprgZergContractStructure)) {
            APRG_FilterContractStructureCommandCard(player, UnitGetType(g_aprgZergContractStructure));
            APRG_SanitizeContractStructureTimers(g_aprgZergContractStructure, player);
        }
        if (g_aprgZergContractStructure != null && UnitIsAlive(g_aprgZergContractStructure) && !CreepIsPresent(UnitGetPosition(g_aprgZergContractStructure))) {
            life = UnitGetPropertyFixed(g_aprgZergContractStructure, c_unitPropLife, c_unitPropCurrent);
            maximum = UnitGetPropertyFixed(g_aprgZergContractStructure, c_unitPropLifeMax, c_unitPropCurrent);
            if (life < maximum) { UnitSetPropertyFixed(g_aprgZergContractStructure, c_unitPropLife, MinF(maximum, life + 5.0)); }
        }
    }
}

unit APRG_FindSpearCaster(int player) {
    unitgroup candidates;
    unit caster;
    if (CatalogEntryIsValid(c_gameCatalogUnit, "AP_SoACaster")) {
        candidates = UnitGroup("AP_SoACaster", player, null, UnitFilter(0, 0, 0, 0), 0);
        caster = UnitGroupUnitFromEnd(candidates, 1);
        if (caster != null) { return caster; }
    }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "SoACaster")) {
        candidates = UnitGroup("SoACaster", player, null, UnitFilter(0, 0, 0, 0), 0);
        caster = UnitGroupUnitFromEnd(candidates, 1);
        if (caster != null) { return caster; }
    }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "SOACaster")) {
        candidates = UnitGroup("SOACaster", player, null, UnitFilter(0, 0, 0, 0), 0);
        caster = UnitGroupUnitFromEnd(candidates, 1);
        if (caster != null) { return caster; }
    }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "SpearOfAdunCaster")) {
        candidates = UnitGroup("SpearOfAdunCaster", player, null, UnitFilter(0, 0, 0, 0), 0);
        caster = UnitGroupUnitFromEnd(candidates, 1);
        if (caster != null) { return caster; }
    }
    if (CatalogEntryIsValid(c_gameCatalogUnit, "VoidSpearofAdun")) {
        candidates = UnitGroup("VoidSpearofAdun", player, null, UnitFilter(0, 0, 0, 0), 0);
        caster = UnitGroupUnitFromEnd(candidates, 1);
        if (caster != null) { return caster; }
    }
    return null;
}

unit APRG_FindSpearAutonomousCaster(int player) {
    unitgroup candidates;
    unit caster;
    if (!CatalogEntryIsValid(c_gameCatalogUnit, "AP_SoAAutonomousCaster")) { return null; }
    candidates = UnitGroup("AP_SoAAutonomousCaster", player, null, UnitFilter(0, 0, 0, 0), 0);
    caster = UnitGroupUnitFromEnd(candidates, 1);
    return caster;
}

fixed APRG_SpearCooldownFactor() {
    fixed factor = 1.0;
    int i;
    for (i = 0; i < g_aprgSpearCooldownReductionStacks; i += 1) { factor *= 0.8; }
    return factor;
}

fixed APRG_SpearCooldownDuration(string abilityType, int costIndex, int player) {
    fixed useTime;
    fixed startTime;
    string prefix;
    prefix = "Cost[" + IntToString(costIndex) + "].Cooldown.";
    useTime = StringToFixed(CatalogFieldValueGet(c_gameCatalogAbil, abilityType, prefix + "TimeUse", player));
    startTime = StringToFixed(CatalogFieldValueGet(c_gameCatalogAbil, abilityType, prefix + "TimeStart", player));
    return MaxF(useTime, startTime);
}

void APRG_SetSpearCooldownLink(unit caster, int player, string link, fixed duration) {
    if (link == "" || duration <= 0.0) { return; }
    UnitModifyCooldown(caster, link, duration, c_cooldownOperationSet);
    libNtve_gf_PlayerRemoveCooldown(player, link);
    PlayerAddCooldown(player, link, duration);
}

void APRG_SaveSpearBaseRegen(unit caster) {
    string baseKey;
    string savedKey;
    fixed originalRegen;
    fixed savedRegen;
    if (caster == null) { return; }
    baseKey = IntToString(UnitGetTag(caster));
    savedKey = "APRG_SpearBaseRegenSaved_" + baseKey;
    originalRegen = UnitGetPropertyFixed(caster, c_unitPropEnergyRegen, c_unitPropCurrent);
    savedRegen = DataTableGetFixed(true, "APRG_SpearBaseRegen_" + baseKey);
    if (!DataTableGetBool(true, "APRG_SpearBaseUnlocked_" + baseKey)) {
        if (!DataTableGetBool(true, savedKey) || originalRegen > savedRegen) {
            DataTableSetFixed(true, "APRG_SpearBaseRegen_" + baseKey, originalRegen);
            DataTableSetBool(true, savedKey, true);
        }
    }
}

fixed APRG_SpearBonusRegen() {
    fixed bonus = 0.0;
    int i;
    for (i = 0; i < g_aprgSpearEnergyRegenStacks; i += 1) { bonus += 0.5; }
    return bonus;
}

fixed APRG_SpearDesiredRegen(unit caster) {
    string baseKey;
    fixed desired;
    if (caster == null) { return 0.0; }
    baseKey = IntToString(UnitGetTag(caster));
    desired = DataTableGetFixed(true, "APRG_SpearBaseRegen_" + baseKey) + APRG_SpearBonusRegen();
    return desired;
}

void APRG_PinSpearPreBase(unit caster, int player) {
    int abilityIndex;
    int abilityCount;
    int costIndex;
    string abilityType;
    string link;
    fixed duration;
    if (caster == null) { return; }
    APRG_SaveSpearBaseRegen(caster);
    UnitSetPropertyFixed(caster, c_unitPropEnergy, 0.0);
    UnitSetPropertyFixed(caster, c_unitPropEnergyRegen, 0.0);
    abilityCount = MinI(64, UnitAbilityCount(caster));
    for (abilityIndex = 1; abilityIndex <= abilityCount; abilityIndex += 1) {
        abilityType = UnitAbilityGet(caster, abilityIndex);
        if (abilityType == "" || !CatalogEntryIsValid(c_gameCatalogAbil, abilityType)) { continue; }
        UnitAbilityEnable(caster, abilityType, false);
        for (costIndex = 0; costIndex < 4; costIndex += 1) {
            link = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, "Cost[" + IntToString(costIndex) + "].Cooldown.Link", player);
            duration = APRG_SpearCooldownDuration(abilityType, costIndex, player);
            APRG_SetSpearCooldownLink(caster, player, link, duration);
        }
    }
}

void APRG_ApplySpearCooldownCatalog(int player, unit caster) {
    int abilityIndex;
    int abilityCount;
    int costIndex;
    string abilityType;
    string field;
    string key;
    fixed value;
    fixed factor;
    factor = APRG_SpearCooldownFactor();
    abilityCount = MinI(64, UnitAbilityCount(caster));
    for (abilityIndex = 1; abilityIndex <= abilityCount; abilityIndex += 1) {
        abilityType = UnitAbilityGet(caster, abilityIndex);
        if (abilityType == "" || !CatalogEntryIsValid(c_gameCatalogAbil, abilityType)) { continue; }
        key = "APRG_SpearCooldownCatalog_" + IntToString(player) + "_" + abilityType;
        if (DataTableGetBool(true, key)) { continue; }
        for (costIndex = 0; costIndex < 4; costIndex += 1) {
            field = "Cost[" + IntToString(costIndex) + "].Cooldown.TimeUse";
            value = StringToFixed(CatalogFieldValueGet(c_gameCatalogAbil, abilityType, field, player));
            if (value > 0.0 && factor != 1.0) { CatalogFieldValueSet(c_gameCatalogAbil, abilityType, field, player, FixedToString(value * factor, c_fixedPrecisionAny)); }
            field = "Cost[" + IntToString(costIndex) + "].Cooldown.TimeStart";
            value = StringToFixed(CatalogFieldValueGet(c_gameCatalogAbil, abilityType, field, player));
            if (value > 0.0 && factor != 1.0) { CatalogFieldValueSet(c_gameCatalogAbil, abilityType, field, player, FixedToString(value * factor, c_fixedPrecisionAny)); }
        }
        DataTableSetBool(true, key, true);
    }
}

void APRG_ReleaseSpearCooldownsAtBase(unit caster, int player) {
    int abilityIndex;
    int abilityCount;
    int costIndex;
    string abilityType;
    string link;
    fixed duration;
    string key;
    if (caster == null) { return; }
    key = "APRG_SpearCooldownReleased_" + IntToString(UnitGetTag(caster));
    APRG_ApplySpearCooldownCatalog(player, caster);
    abilityCount = MinI(64, UnitAbilityCount(caster));
    for (abilityIndex = 1; abilityIndex <= abilityCount; abilityIndex += 1) {
        abilityType = UnitAbilityGet(caster, abilityIndex);
        if (abilityType == "" || !CatalogEntryIsValid(c_gameCatalogAbil, abilityType)) { continue; }
        UnitAbilityEnable(caster, abilityType, true);
        if (DataTableGetBool(true, key)) { continue; }
        for (costIndex = 0; costIndex < 4; costIndex += 1) {
            link = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, "Cost[" + IntToString(costIndex) + "].Cooldown.Link", player);
            duration = APRG_SpearCooldownDuration(abilityType, costIndex, player);
            APRG_SetSpearCooldownLink(caster, player, link, duration);
        }
    }
    DataTableSetBool(true, key, true);
}
void APRG_ReleaseSpearEnergyAtBase(unit caster) {
    string baseKey;
    string unlockedKey;
    if (caster == null) { return; }
    APRG_SaveSpearBaseRegen(caster);
    baseKey = IntToString(UnitGetTag(caster));
    unlockedKey = "APRG_SpearBaseUnlocked_" + baseKey;
    if (!DataTableGetBool(true, unlockedKey)) {
        UnitSetPropertyFixed(caster, c_unitPropEnergy, 0.0);
        DataTableSetBool(true, unlockedKey, true);
    }
    UnitSetPropertyFixed(caster, c_unitPropEnergyRegen, APRG_SpearDesiredRegen(caster));
}

void APRG_TickSpearEnergyBonus(unit caster, fixed now) {
    if (caster == null) { return; }
    UnitSetPropertyFixed(caster, c_unitPropEnergyRegen, APRG_SpearDesiredRegen(caster));
    g_aprgSpearLastEnergyBonusTime = now;
}

void APRG_TickSpearBaseGate(int player) {
    unit caster;
    unit autonomousCaster;
    fixed now;
    if (!APRG_HasProgression(APRG_PROGRESSION_SPEAR)) { return; }
    caster = APRG_FindSpearCaster(player);
    autonomousCaster = APRG_FindSpearAutonomousCaster(player);
    if (caster == null && autonomousCaster == null) { return; }
    now = GameGetMissionTime();

    if (!APRG_PlayerMacroBaseReady(player)) {
        APRG_PinSpearPreBase(caster, player);
        APRG_PinSpearPreBase(autonomousCaster, player);
        g_aprgSpearLastEnergyBonusTime = now;
        return;
    }

    APRG_ReleaseSpearEnergyAtBase(caster);
    APRG_ReleaseSpearEnergyAtBase(autonomousCaster);
    APRG_TickSpearEnergyBonus(caster, now);
    APRG_TickSpearEnergyBonus(autonomousCaster, now);

    APRG_ReleaseSpearCooldownsAtBase(caster, player);
}

bool APRG_SpearGate_Func(bool testConds, bool runActions) {
    if (!runActions) { return true; }
    APRG_TickSpearBaseGate(APRG_GetPrimaryPlayer());
    return true;
}

bool APRG_ArgumentUnitEligible(unit u, int player) {
    if (u == null || !UnitIsAlive(u) || UnitGetOwner(u) != player) { return false; }
    if (DataTableGetBool(true, "APRG_Uncommandable_" + IntToString(UnitGetTag(u)))) { return false; }
    return true;
}

void APRG_TickArguments(int player, fixed now) {
    unitgroup units;
    unit attacker;
    unit target;
    unit candidate;
    int attempt;
    if (!APRG_PlayerMacroBaseReady(player)) { return; }
    if (g_aprgNextArgumentsTime < 0.0) { g_aprgNextArgumentsTime = now + RandomFixed(20.0, 60.0); return; }
    if (now < g_aprgNextArgumentsTime) { return; }
    units = APRG_PlayerMobileUnits(player);
    attacker = null;
    target = null;
    for (attempt = 0; attempt < 16; attempt += 1) {
        candidate = UnitGroupRandomUnit(units, c_unitCountAlive);
        if (APRG_ArgumentUnitEligible(candidate, player)) { attacker = candidate; break; }
    }
    if (attacker != null) {
        for (attempt = 0; attempt < 24; attempt += 1) {
            candidate = UnitGroupRandomUnit(units, c_unitCountAlive);
            if (candidate != attacker && APRG_ArgumentUnitEligible(candidate, player)) { target = candidate; break; }
        }
    }
    if (attacker != null && target != null) {
        UnitIssueOrder(attacker, OrderTargetingUnit(AbilityCommand("attack", 0), target), c_orderQueueReplace);
    }
    g_aprgNextArgumentsTime = now + RandomFixed(20.0, 60.0);
}

void APRG_ApplyGodModeCatalog(int player) {
    int count;
    int i;
    int infoCount;
    int infoIndex;
    string unitType;
    string abilityType;
    string basePath;
    string producedUnit;
    fixed buildTime;
    fixed entryTime;
    if (!g_aprgGodMode || g_aprgGodModeCatalogApplied || player <= 0) { return; }

    count = CatalogEntryCount(c_gameCatalogUnit);
    for (i = 1; i <= count; i += 1) {
        unitType = CatalogEntryGet(c_gameCatalogUnit, i);
        if (unitType == "" || !CatalogEntryIsValid(c_gameCatalogUnit, unitType)) { continue; }
        buildTime = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, unitType, "BuildTime", player));
        if (buildTime > 0.1) { CatalogFieldValueSet(c_gameCatalogUnit, unitType, "BuildTime", player, "0.1"); }
    }
    count = CatalogEntryCount(c_gameCatalogAbil);
    for (i = 1; i <= count; i += 1) {
        abilityType = CatalogEntryGet(c_gameCatalogAbil, i);
        if (abilityType == "" || !CatalogEntryIsValid(c_gameCatalogAbil, abilityType)) { continue; }
        infoCount = CatalogFieldValueCount(c_gameCatalogAbil, abilityType, "InfoArray", player);
        for (infoIndex = 0; infoIndex < infoCount; infoIndex += 1) {
            basePath = "InfoArray[" + IntToString(infoIndex) + "]";
            producedUnit = CatalogFieldValueGet(c_gameCatalogAbil, abilityType, basePath + ".Unit", player);
            if (producedUnit == "" && CatalogFieldValueCount(c_gameCatalogAbil, abilityType, basePath + ".Unit", player) <= 0) { continue; }
            entryTime = StringToFixed(CatalogFieldValueGet(c_gameCatalogAbil, abilityType, basePath + ".Time", player));
            if (entryTime > 0.1) { CatalogFieldValueSet(c_gameCatalogAbil, abilityType, basePath + ".Time", player, "0.1"); }
        }
    }
    g_aprgGodModeCatalogApplied = true;
}

void APRG_TickGodMode(int player) {
    if (!g_aprgGodMode || player <= 0) { return; }
    APRG_ApplyGodModeCatalog(player);
    if (PlayerGetPropertyInt(player, c_playerPropMinerals) < 1000000) {
        PlayerModifyPropertyInt(player, c_playerPropMinerals, c_playerPropOperSetTo, 1000000);
    }
    if (PlayerGetPropertyInt(player, c_playerPropVespene) < 1000000) {
        PlayerModifyPropertyInt(player, c_playerPropVespene, c_playerPropOperSetTo, 1000000);
    }
}

bool APRG_Config_Func(bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    g_aprgMaskA = StringToInt(StringWord(EventChatMessage(false), 2));
    g_aprgMaskB = StringToInt(StringWord(EventChatMessage(false), 3));
    g_aprgMaskC = StringToInt(StringWord(EventChatMessage(false), 4));
    g_aprgMaskD = StringToInt(StringWord(EventChatMessage(false), 5));
    g_aprgMaskE = StringToInt(StringWord(EventChatMessage(false), 6));
    g_aprgMaskF = StringToInt(StringWord(EventChatMessage(false), 7));
    g_aprgAutoRepairStacks = StringToInt(StringWord(EventChatMessage(false), 8));
    g_aprgProgressionFlags = StringToInt(StringWord(EventChatMessage(false), 9));
    g_aprgSpearEnergyRegenStacks = StringToInt(StringWord(EventChatMessage(false), 10));
    g_aprgMercenaryUpgradePacked = StringToInt(StringWord(EventChatMessage(false), 11));
    g_aprgSpearCooldownReductionStacks = StringToInt(StringWord(EventChatMessage(false), 12));
    g_aprgKerriganUpgradeFlags = StringToInt(StringWord(EventChatMessage(false), 13));
    g_aprgDeadlyWeaponsStacks = StringToInt(StringWord(EventChatMessage(false), 14));
    g_aprgCommanderHeroIndex = StringToInt(StringWord(EventChatMessage(false), 15));
    g_aprgGodMode = StringToInt(StringWord(EventChatMessage(false), 16)) > 0;
    g_aprgMissionLayer = StringToInt(StringWord(EventChatMessage(false), 17));
    g_aprgMissionFlags = StringToInt(StringWord(EventChatMessage(false), 18));
    g_aprgMercenaryUpgradePacked2 = StringToInt(StringWord(EventChatMessage(false), 19));
    g_aprgTestPotionRunToken = StringToInt(StringWord(EventChatMessage(false), 20));
    g_aprgPotionType[0] = StringToInt(StringWord(EventChatMessage(false), 21));
    g_aprgPotionSerial[0] = StringToInt(StringWord(EventChatMessage(false), 22));
    g_aprgPotionType[1] = StringToInt(StringWord(EventChatMessage(false), 23));
    g_aprgPotionSerial[1] = StringToInt(StringWord(EventChatMessage(false), 24));
    g_aprgPotionMercMask = StringToInt(StringWord(EventChatMessage(false), 25));

    g_aprgGodModeCatalogApplied = false;
    if (g_aprgAutoRepairStacks < 0) { g_aprgAutoRepairStacks = 0; }
    if (g_aprgDeadlyWeaponsStacks < 0) { g_aprgDeadlyWeaponsStacks = 0; }
    if (g_aprgCommanderHeroIndex < -1 || g_aprgCommanderHeroIndex >= APRG_HERO_CANDIDATE_COUNT) { g_aprgCommanderHeroIndex = -1; }
    if (g_aprgProgressionFlags < 0) { g_aprgProgressionFlags = 0; }
    if (g_aprgSpearEnergyRegenStacks < 0) { g_aprgSpearEnergyRegenStacks = 0; }
    if (g_aprgMercenaryUpgradePacked < 0) { g_aprgMercenaryUpgradePacked = 0; }
    if (g_aprgSpearCooldownReductionStacks < 0) { g_aprgSpearCooldownReductionStacks = 0; }
    if (g_aprgKerriganUpgradeFlags < 0) { g_aprgKerriganUpgradeFlags = 0; }
    if (g_aprgMissionLayer < 1) { g_aprgMissionLayer = 1; }
    if (g_aprgMissionFlags < 0) { g_aprgMissionFlags = 0; }
    if (g_aprgMercenaryUpgradePacked2 < 0) { g_aprgMercenaryUpgradePacked2 = 0; }
    if (g_aprgTestPotionRunToken < 0) { g_aprgTestPotionRunToken = 0; }
    return true;
}

